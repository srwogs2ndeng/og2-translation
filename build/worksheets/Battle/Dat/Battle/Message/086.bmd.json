{
"0x0020EC": {
"jp": "「物事はスマートに、な」",
"en": "「Keep it smart, huh.」",
"slot": 36
},
"0x002111": {
"jp": "「なるようにしかならんか」",
"en": "「What will be, will be.」",
"slot": 39
},
"0x002139": {
"jp": "「運が悪かったな」",
"en": "「Bad luck for you.」",
"slot": 27
},
"0x002155": {
"jp": "「仕留める！」",
"en": "「I'll finish it!」",
"slot": 21
},
"0x00216B": {
"jp": "「観念するんだな」",
"en": "「Give it up now.」",
"slot": 27
},
"0x002187": {
"jp": "「もらう！」",
"en": "「You're mine!」",
"slot": 18
},
"0x00219A": {
"jp": "「諦めるんだな」",
