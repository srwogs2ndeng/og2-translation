"slot": 45
},
"0x002200": {
"jp": "「時間をかける気はない……！」",
"en": "「I've no time to waste...!」",
"slot": 45
},
"0x00222E": {
"jp": "「おれの前に立ったか」",
"en": "「So you stand before me.」",
"slot": 33
},
"0x002250": {
"jp": "「手加減などせんぞ」",
"en": "「I won't hold back.」",
"slot": 30
},
"0x00226F": {
"jp": "「おれの相手をしてもらおうか」",
"en": "「You'll face me now.」",
"slot": 45
},
"0x00229D": {
"jp": "「やるぞ、ソウルゲイン！」",
"en": "「Let's go, Soulgain!」",
"slot": 39
},
"0x0022C5": {
"jp": "「行くぞ、ドゥバン・オーグ」",
"en": "「Here we go, Duvan Org.」",
"slot": 42
},
"0x0022F0": {
"jp": "「当たり負けはせん、これがな」",
"en": "「I won't lose the clash, that's how.」",
"slot": 45
},
"0x00231E": {
"jp": "「ドゥバン……/　紛い物では、所詮無理な話だ」",
"en": "「Duvan.../　A fake could never manage it.」",
"slot": 67
},
"0x002362": {
"jp": "「知らぬ間に/　地球は異星人に支配されるということか。/　巧妙だが、気の長い話だな」",
"en": "「So Earth gets ruled by aliens/　without anyone noticing./　Clever, but a long game indeed.」",
"slot": 122
},
"0x0023DD": {
"jp": "「行くぞ、メリオルエッセ！」",
"en": "「Here I come, Meiroluss!」",
"slot": 42
},
"0x002408": {
"jp": "「恐怖を味わうことになるのは、お前達の方だ」",
"en": "「It's you who'll taste fear.」",
"slot": 66
},
"0x00244B": {
"jp": "「お前達が言う絶望は温い、これがな」",
"en": "「Your despair is nothing. This is despair.」",
"slot": 54
},
"0x002482": {
"jp": "「ペルフェクティオ……/　『こちら側』へ来るとただでは済まんぞ。/　……経験済みだ」",
"en": "「Perfectio.../　Come to 'this side' and you won't get off easy./　...I know from experience.」",
"slot": 122
},
"0x0024FD": {
"jp": "「お前達と馴れ合うつもりはない！」",
"en": "「I've no intention of playing nice with you!」",
"slot": 51
},
"0x002531": {
"jp": "「お前達はかつての俺達と同じ……/　招かれざる客だ、これがな」",
"en": "「You're just like we once were.../　Uninvited guests. That's what.」",
"slot": 91
},
"0x00258D": {
"jp": "「どのみち、お前では無理だったということだ、/　ゼゼーナン」",
"en": "「Either way, it was beyond you,/　Zezernan.」",
"slot": 88
},
"0x0025E6": {
"jp": "「桃源郷などという腑抜けた世界に興味はない」",
"en": "「I've no interest in some spineless utopia.」",
"slot": 66
},
"0x002629": {
"jp": "「甘言には裏がある……お前達の真意は何だ？」",
"en": "「Sweet words hide something... What's your true aim?」",
"slot": 66
},
"0x00266C": {
"jp": "「その物言い、その超機人……/　どこまでもふざけた奴だ」",
"en": "「That tongue, that Choukijin.../　A joke of a man to the end.」",
"slot": 82
},
"0x0026BF": {
"jp": "「覚悟してもらうぞ、孫光龍」",
"en": "「Brace yourself, Sun Guang Long.」",
"slot": 42
},
"0x0026EA": {
"jp": "「鋼龍戦隊を危険視する気持ちは/　わからんでもないがな」",
"en": "「I can't say I don't get why the/　Steel Dragons are wary of you.」",
"slot": 82
},
"0x00273D": {
"jp": "「ガイアセイバーズ……/　おれの邪魔をするのなら、容赦はせん」",
"en": "「Gaia Savers.../　Get in my way and I'll show no mercy.」",
"slot": 91
},
"0x002799": {
"jp": "「あの黒い翼……気に入らんな」",
"en": "「Those black wings... I don't like them.」",
"slot": 45
},
"0x0027C7": {
"jp": "「ルイーナの雑魚どもが……！」",
"en": "「You Ruina small fry...!」",
"slot": 45
},
"0x0027F5": {
"jp": "「目障りな雑魚から片付けてやる！」",
"en": "「I'll clear out the eyesore small fry first!」",
"slot": 51
},
"0x002829": {
"jp": "「ＡＩ１……お前の行く末などに興味はない」",
"en": "「AI1... I've no interest in your fate.」",
"slot": 63
},
"0x002869": {
"jp": "「なかなかいい面構えだ、これがな」",
"en": "「A fine face you've got. That's what.」",
"slot": 51
},
"0x00289D": {
"jp": "「龍虎王や虎龍王とは一味違うようだな」",
"en": "「Seems you differ from RyuKoOh and KoRyuOh.」",
"slot": 57
},
"0x0028D7": {
"jp": "「ガンエデン……/　おれは、籠中の鳥になる気はない」",
"en": "「Gan Eden.../　I've no mind to be a caged bird.」",
"slot": 76
},
"0x002924": {
"jp": "「檻の中でおれ達のような存在を/　朽ち果てさせる……/　それが真意じゃないのか、ガンエデン」",
"en": "「Letting beings like us rot away/　inside a cage.../　That's your true aim, isn't it, Gan Eden?」",
"slot": 134
},
"0x0029AB": {
"jp": "「皮肉だな。/　世界の有り様を変えようとしたおれが、/　貴様を止める側に回るとは」",
"en": "「Ironic./　I who tried to change the world's shape,/　now stand to stop you.」",
"slot": 119
},
"0x002A23": {
"jp": "「起死回生……そう簡単には成し遂げられんぞ、/　これがな！」",
