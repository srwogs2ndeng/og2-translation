  "en": "(Riana, can you see that?)",
  "slot": 42
 },
 "0x0053F0": {
  "en": "「Yeah, here we go!」",
  "slot": 30
 },
 "0x00540F": {
  "en": "「With this Dea Blanche Neige!」",
  "slot": 57
 },
 "0x005449": {
  "en": "「Don't underestimate the Dea Blanche Neige!」",
  "slot": 66
 },
 "0x00548C": {
  "en": "「Please, Dea Blanche Neige!」",
  "slot": 60
 },
 "0x0054C9": {
  "en": "「I won't let the Gaia Sabers have their way!」",
  "slot": 63
 },
 "0x005509": {
  "en": "「It won't end with me framed for this!」",
  "slot": 69
 },
 "0x00554F": {
  "en": "「Gaia Sabers, I won't lose to you!」",
  "slot": 66
 },
 "0x005592": {
  "en": "「We've got our own say in this!」",
  "slot": 48
 },
 "0x0055C3": {
  "en": "「All right, that's enough out of you!」",
  "slot": 54
 },
 "0x0055FA": {
  "en": "「I won't be your stepping stone!」",
  "slot": 63
 },
 "0x00563A": {
  "en": "「This should be faster than the Alles Geist!」",
  "slot": 69
 },
 "0x005680": {
  "en": "「Here we go, Duvan!」",
  "slot": 36
 },
 "0x0056A5": {
  "en": "「I won't let you, Duvan!」",
  "slot": 45
 },
 "0x0056D3": {
  "en": "「Duvan, I'll stop you!」",
  "slot": 54
 },
 "0x00570A": {
  "en": "「Ruling the world all on your own...!」",
  "slot": 63
 },
 "0x00574A": {
  "en": "「Alteur, I won't give this child to you!」",
  "slot": 66
 },
 "0x00578D": {
  "en": "「Alteur, what is your true goal!?」",
  "slot": 69
 },
 "0x0057D3": {
  "en": "「D-don't get inside me!」",
  "slot": 54
 },
 "0x00580A": {
  "en": "「Ventos!/ Say any more and I'll...!」",
  "slot": 88
 },
 "0x005863": {
  "en": "「This feeling... Ventos, you're...!」",
  "slot": 63
 },
 "0x0058A3": {
  "en": "（Th-this feeling, what is it!?）",
  "slot": 42
 },
 "0x0058CE": {
  "en": "「I'm being pulled in...!? Ngh!」",
  "slot": 51
 },
 "0x005902": {
  "en": "（Ventos... I...）",
  "slot": 39
 },
 "0x00592A": {
  "en": "「No, Chris! We're being drawn in!」",
  "slot": 54
 },
 "0x005961": {
  "en": "（Ventos is pulling us...）",
  "slot": 39
 },
 "0x005989": {
  "en": "「Chris, don't let him distract you!」",
  "slot": 57
 },
 "0x0059C3": {
  "en": "「Why are you and Bro...!」",
  "slot": 45
 },
 "0x0059F1": {
  "en": "「This kid's not affected/ as badly as Bro's machine...!」",
  "slot": 85
 },
 "0x005A47": {
  "en": "「Glacies... why do this to Bro...!」",
  "slot": 63
 },
 "0x005A87": {
  "en": "「Glacies,/ we'll bring back the sunlight!」",
  "slot": 76
 },
 "0x005AD4": {
  "en": "「Glacies, if anything happens to Bro...!」",
  "slot": 66
 },
 "0x005B17": {
  "en": "「This feeling... it's different from Ventos...!」",
  "slot": 60
 },
 "0x005B54": {
  "en": "「Here we go, Ignis!」",
  "slot": 36
 },
 "0x005B79": {
  "en": "「Ignis! Don't underestimate me!」",
  "slot": 60
 },
 "0x005BB6": {
  "en": "「Even against a Melior Esse!」",
  "slot": 45
 },
 "0x005BE4": {
  "en": "「You say you're going to bring ruin!」",
  "slot": 63
 },
 "0x005C24": {
  "en": "「I won't be fodder for the King of Ruin!」",
  "slot": 63
 },
 "0x005C64": {
  "en": "（It's a Melior Esse! Be careful!）",
  "slot": 63
 },
 "0x005CA4": {
  "en": "「I know!」",
  "slot": 24
 },
 "0x005CBD": {
  "en": "(Ugh... that looks so hot!)",
  "slot": 45
 },
 "0x005CEB": {
  "en": "「I don't plan on getting burned!」",
  "slot": 45
 },
 "0x005D19": {
  "en": "「Chris... I'll fight./ To stop this ruin!」",
  "slot": 85
 },
 "0x005D6F": {
  "en": "「Don't think you'll be laughing forever!」",
  "slot": 60
 },
 "0x005DAC": {
  "en": "「Contagio, whatever you're plotting...!」",
  "slot": 66
 },
 "0x005DEF": {
  "en": "(Contagio noticed us!)",
  "slot": 54
 },
 "0x005E26": {
  "en": "「I'll strike first!」",
  "slot": 30
 },
 "0x005E45": {
  "en": "「Here I come, Aquila!」",
  "slot": 36
 },
 "0x005E6A": {
  "en": "「I won't let you, Aquila!」",
  "slot": 45
 },
 "0x005E98": {
  "en": "「Umbra!/ You won't get your way!」",
  "slot": 73
 },
 "0x005EE2": {
  "en": "「Umbra, get out of my way!」",
  "slot": 57
 },
 "0x005F1C": {
  "en": "「I have to stop Septemplum...!」",
  "slot": 60
 },
 "0x005F59": {
  "en": "(Is that person a guy or a girl?)",
  "slot": 45
 },
 "0x005F87": {
  "en": "「Who cares which!」",
  "slot": 36
 },
 "0x005FAC": {
  "en": "「Whoever I am,/ until Chris comes back,/ I can't disappear!」",
  "slot": 125
 },
 "0x00602A": {
  "en": "「Dad... I'm sorry!」",
  "slot": 33
 },
 "0x00604C": {
  "en": "「Perfectio...!/ This kid and I will take you down!」",
  "slot": 97
 },
 "0x0060AE": {
  "en": "「Guests! Get off Earth!」",
  "slot": 54
