  "slot": 45
 },
 "0x00513C": {
  "en": "「At this range, I've got this!」",
  "slot": 42
 },
 "0x005167": {
  "en": "「With the Blanche Neige, I can do this!」",
  "slot": 57
 },
 "0x0051A1": {
  "en": "「I'm counting on you, Blanche Neige!」",
