"0x005008": {
"jp": "「あたしを甘く見ないで！」",
"en": "「Don't underestimate me!」",
"slot": 39
},
"0x005030": {
"jp": "「あたしだって！」",
"en": "「I can do it too!」",
"slot": 27
},
"0x00504C": {
"jp": "「ここはあたしが！」",
"en": "「Leave this to me!」",
"slot": 30
},
"0x00506B": {
"jp": "「やるしかない……なら！」",
"en": "「If I have no choice... then!」",
"slot": 39
},
"0x005093": {
"jp": "「負けられない！」",
"en": "「I can't lose!」",
"slot": 27
},
"0x0050AF": {
"jp": "「甘く見てると後悔するわよ！」",
"en": "「Underestimate me and you'll regret it!」",
"slot": 45
},
"0x0050DD": {
"jp": "「あたしだって、やってみせる！」",
"en": "「I'll show you I can do it too!」",
"slot": 48
},
"0x00510E": {
"jp": "「こっちに気づいたわね……！」",
"en": "「So you've noticed me...!」",
"slot": 45
},
"0x00513C": {
"jp": "「この距離なら、行けるわ！」",
"en": "「At this range, I can do it!」",
"slot": 42
},
"0x005167": {
"jp": "「ブランシュネージュなら、やれるわ！」",
"en": "「With the Blanche Neige, I can do this!」",
"slot": 57
},
"0x0051A1": {
"jp": "「頼むわね、ブランシュネージュ！」",
"en": "「I'm counting on you, Blanche Neige!」",
"slot": 51
},
"0x0051D5": {
"jp": "「お願いね、ブランシュネージュ！」",
"en": "「Please, Blanche Neige!」",
"slot": 51
},
"0x005209": {
"jp": "「行くわよ、クリス！」",
"en": "「Here we go, Chris!」",
"slot": 33
},
"0x00522B": {
"jp": "（うん！）",
"en": "（Yeah!）",
"slot": 15
},
"0x00523B": {
"jp": "（リアナ、敵、敵！）",
"en": "（Liana, enemies, enemies!）",
"slot": 30
},
"0x00525A": {
"jp": "「大丈夫、任せて！」",
"en": "「It's okay, I've got it!」",
"slot": 30
},
"0x005279": {
"jp": "「このっ、やらせないんだから！」",
"en": "「I won't let you do that!」",
"slot": 48
},
"0x0052AA": {
"jp": "（リアナ、頑張って！）",
"en": "（Do your best, Liana!）",
"slot": 33
},
"0x0052CC": {
"jp": "（うぅ～、来た、来たよ！）",
"en": "（Uu~, it's coming, it's coming!）",
"slot": 39
},
"0x0052F4": {
"jp": "「わかってるわよ！　ここはやってみせる！」",
"en": "「I know that! I'll pull this off!」",
"slot": 63
},
"0x005334": {
"jp": "（リ、リアナ、あそこ、あそこ！）",
"en": "（L-Liana, over there, over there!）",
"slot": 48
},
"0x005365": {
"jp": "「ちょっと黙ってて！」",
"en": "「Be quiet a second!」",
"slot": 33
},
"0x005387": {
"jp": "（前、前から来る！）",
"en": "（Ahead, it's from ahead!）",
"slot": 30
},
"0x0053A6": {
"jp": "「やってみせるわ！」",
"en": "「I'll show you!」",
"slot": 30
},
"0x0053C5": {
"jp": "（リアナ、あれ、見えてる？）",
"en": "（Liana, can you see that?）",
"slot": 42
},
"0x0053F0": {
"jp": "「ええ、行くわよ！」",
"en": "「Yeah, here we go!」",
"slot": 30
},
"0x00540F": {
"jp": "「このデア・ブランシュネージュなら！」",
"en": "「With this Dea Blanche Neige!」",
"slot": 57
},
"0x005449": {
"jp": "「デア・ブランシュネージュを甘く見ないで！」",
"en": "「Don't underestimate the Dea Blanche Neige!」",
"slot": 66
},
"0x00548C": {
"jp": "「お願いね、デア・ブランシュネージュ！」",
"en": "「Please, Dea Blanche Neige!」",
"slot": 60
},
"0x0054C9": {
"jp": "「ガイアセイバーズの好きにはやらせない！」",
"en": "「I won't let the Gaia Saviours have their way!」",
"slot": 63
},
"0x005509": {
"jp": "「濡れ衣を着せられたままで終わりはしないわ！」",
"en": "「It won't end with me framed for this!」",
"slot": 69
},
"0x00554F": {
"jp": "「ガイアセイバーズ、あんた達には負けない！」",
"en": "「Gaia Saviours, I won't lose to you!」",
"slot": 66
},
"0x005592": {
"jp": "「こっちにも言い分があるのよ！」",
"en": "「We've got our own say in this!」",
"slot": 48
},
"0x0055C3": {
"jp": "「あんた達、いい加減にしなさいよ！」",
"en": "「You people, that's enough already!」",
"slot": 54
},
"0x0055FA": {
"jp": "「あんた達の踏み台なんかにならないから！」",
"en": "「I won't be your stepping stone!」",
"slot": 63
},
"0x00563A": {
"jp": "「アレス・ガイストよりこっちの方が速いはず！」",
"en": "「This should be faster than the Ares Geist!」",
"slot": 69
},
"0x005680": {
"jp": "「行くわよ、ドゥバン！」",
"en": "「Here we go, Duvan!」",
"slot": 36
},
"0x0056A5": {
"jp": "「やらせないわよ、ドゥバン！」",
"en": "「I won't let you, Duvan!」",
"slot": 45
},
"0x0056D3": {
"jp": "「ドゥバン、あんたを止めてみせる！」",
"en": "「Duvan, I'll stop you!」",
"slot": 54
},
"0x00570A": {
"jp": "「たった一人で全てを支配するなんて……！」",
"en": "「Ruling everything all alone...!」",
"slot": 63
},
"0x00574A": {
"jp": "「アルテウル、あんたにこの子は渡さないわ！」",
"en": "「Alteur, I won't give this child to you!」",
"slot": 66
},
"0x00578D": {
"jp": "「アルテウル、あんたの本当の目的は何なの！？」",
"en": "「Alteur, what is your true goal!?」",
"slot": 69
},
"0x0057D3": {
"jp": "「あ、あたしの中に入ってこないで！」",
"en": "「D-don't get inside me!」",
"slot": 54
},
"0x00580A": {
"jp": "「ウェントス！/　それ以上喋るなら、あたしはあんたを……！」",
"en": "「Ventos!/ Say any more and I'll...!」",
"slot": 88
},
"0x005863": {
"jp": "「この感じ……ウェントス、あんたは……！」",
"en": "「This feeling... Ventos, you're...!」",
"slot": 63
},
"0x0058A3": {
"jp": "（こ、この感じ、何なの！？）",
"en": "（Th-this feeling, what is it!?）",
"slot": 42
},
"0x0058CE": {
"jp": "「引き寄せられる……！？　くっ！」",
"en": "「I'm being pulled in...!? Ngh!」",
"slot": 51
},
"0x005902": {
"jp": "（ウェントス……私は……）",
"en": "（Ventos... I...）",
"slot": 39
},
"0x00592A": {
"jp": "「駄目よ、クリス！　引き込まれる！」",
"en": "「No, Chris! We're being drawn in!」",
"slot": 54
},
"0x005961": {
"jp": "（ウェントスが私達を……）",
"en": "（Ventos is pulling us...）",
"slot": 39
},
"0x005989": {
"jp": "「クリス、あいつに気を取られないで！」",
"en": "「Chris, don't let him distract you!」",
"slot": 57
},
"0x0059C3": {
"jp": "「何であんたとアニキが……！」",
"en": "「Why are you and Bro...!」",
"slot": 45
},
"0x0059F1": {
"jp": "「この子は、/　アニキの機体ほど影響を受けていない……！」",
"en": "「This child isn't affected/ as much as Bro's machine...!」",
"slot": 85
},
"0x005A47": {
"jp": "「グラキエース……どうしてアニキに……！」",
"en": "「Glacies... why, to Bro...!」",
"slot": 63
},
"0x005A87": {
"jp": "「グラキエース、/　あたし達は太陽の光を取り戻す！」",
"en": "「Glacies,/ we'll bring back the sunlight!」",
"slot": 76
},
"0x005AD4": {
"jp": "「グラキエース、アニキに何かあったら……！」",
"en": "「Glacies, if anything happens to Bro...!」",
"slot": 66
},
"0x005B17": {
"jp": "「この感じ……ウェントスとは違う……！」",
"en": "「This feeling... different from Ventos...!」",
"slot": 60
},
"0x005B54": {
"jp": "「行くわよ、イグニス！」",
"en": "「Here we go, Ignis!」",
"slot": 36
},
"0x005B79": {
"jp": "「イグニス！　あたしを甘く見ないでよ！」",
"en": "「Ignis! Don't underestimate me!」",
"slot": 60
},
"0x005BB6": {
"jp": "「メリオルエッセが相手でも！」",
"en": "「Even against a Meliolesse!」",
"slot": 45
},
"0x005BE4": {
"jp": "「あんた達が破滅をもたらすと言うのなら！」",
"en": "「If you say you'll bring ruin!」",
"slot": 63
},
"0x005C24": {
"jp": "「“破滅の王”の糧になんかならないわよ！」",
"en": "「I won't be fodder for the King of Ruin!」",
"slot": 63
},
"0x005C64": {
"jp": "（相手はメリオルエッセよ！　気をつけて！）",
"en": "（It's a Meliolesse! Be careful!）",
"slot": 63
},
"0x005CA4": {
"jp": "「わかってる！」",
"en": "「I know!」",
"slot": 24
},
"0x005CBD": {
"jp": "（うぅ～、熱そうだよぉ、あれ）",
"en": "(Ugh... that looks so hot!)",
"slot": 45
},
"0x005CEB": {
"jp": "「火傷する気なんてないから！」",
"en": "「I don't plan on getting burned!」",
"slot": 45
},
"0x005D19": {
"jp": "「クリス……あたしは戦うよ。/　破滅を食い止めるために！」",
"en": "「Chris... I'll fight./ To stop the ruin!」",
"slot": 85
},
"0x005D6F": {
"jp": "「いつまでも笑ってられると思わないで！」",
"en": "「Don't think you'll be laughing forever!」",
"slot": 60
},
"0x005DAC": {
"jp": "「コンターギオ、あんたが何を企もうと……！」",
"en": "「Contagio, whatever you're plotting...!」",
"slot": 66
},
"0x005DEF": {
"jp": "（コンターギオがこっちに気づいた！）",
"en": "(Contagio noticed us!)",
"slot": 54
},
"0x005E26": {
"jp": "「先に仕掛けるわ！」",
"en": "「I'll strike first!」",
"slot": 30
},
"0x005E45": {
"jp": "「行くわよ、アクイラ！」",
"en": "「Here I come, Aquila!」",
"slot": 36
},
"0x005E6A": {
"jp": "「やらせないわよ、アクイラ！」",
"en": "「I won't let you, Aquila!」",
"slot": 45
},
"0x005E98": {
"jp": "「ウンブラ！/　あんたの思い通りにはいかないわ！」",
"en": "「Umbra!/ You won't get your way!」",
"slot": 73
},
"0x005EE2": {
"jp": "「ウンブラ、そこをどいてもらうわよ！」",
"en": "「Umbra, get out of my way!」",
"slot": 57
},
"0x005F1C": {
"jp": "「セプテンプルムを何とかしなきゃ……！」",
"en": "「I have to stop Septemplum...!」",
"slot": 60
},
"0x005F59": {
"jp": "（あの人、男なの？　女なの？）",
"en": "(Is that person a man? A woman?)",
"slot": 45
},
"0x005F87": {
"jp": "「どっちでもいいわよ！」",
"en": "「Who cares which!」",
"slot": 36
},
"0x005FAC": {
"jp": "「あたしが何者であっても、/　クリスが戻って来るまで/　消えるわけにはいかないのよ！」",
"en": "「Whoever I am,/ until Chris comes back,/ I can't disappear!」",
"slot": 125
},
"0x00602A": {
"jp": "「父さん……ごめん！」",
"en": "「Dad... I'm sorry!」",
"slot": 33
},
"0x00604C": {
"jp": "「ペルフェクティオ……！/　あたしとこの子の力で、あんたを倒す！」",
"en": "「Perfectio...!/ This kid and I will take you down!」",
"slot": 97
},
"0x0060AE": {
"jp": "「ゲスト！　地球から出て行ってよ！」",
"en": "「Guests! Get off of Earth!」",
"slot": 54
},
"0x0060E5": {
"jp": "「あたし達の星に干渉しないでよ！」",
"en": "「Stop meddling with our planet!」",
"slot": 51
},
"0x006119": {
"jp": "「地球をあんた達に渡しはしないわ！」",
"en": "「I won't hand Earth over to you!」",
"slot": 54
},
"0x006150": {
"jp": "「行くわよ、ゲスト！」",
"en": "「Here I come, Guests!」",
"slot": 33
},
"0x006172": {
"jp": "「何の権利があって、あたし達の地球を……！」",
"en": "「What right do you have to our Earth...!」",
"slot": 66
