  "en": "「Please, Blanche Neige!」",
  "slot": 51
 },
 "0x005209": {
  "en": "「Here we go, Chris!」",
  "slot": 33
 },
 "0x00522B": {
  "en": "（Yeah!）",
  "slot": 15
 },
 "0x00523B": {
  "en": "(Riana, enemies, enemies!)",
  "slot": 30
 },
 "0x00525A": {
  "en": "「It's okay, I've got it!」",
  "slot": 30
 },
 "0x005279": {
  "en": "「I won't let you do that!」",
  "slot": 48
 },
 "0x0052AA": {
  "en": "(Do your best, Riana!)",
  "slot": 33
 },
 "0x0052CC": {
  "en": "（Uu~, it's coming, it's coming!）",
  "slot": 39
 },
 "0x0052F4": {
  "en": "「I know that! I'll pull this off!」",
  "slot": 63
 },
 "0x005334": {
  "en": "(L-Riana, over there, over there!)",
  "slot": 48
 },
 "0x005365": {
  "en": "「Be quiet a second!」",
