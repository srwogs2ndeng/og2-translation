 "0x005344": {
  "en": "「It's simple. For us both.」",
  "slot": 51
 },
 "0x005378": {
  "en": "「Laugh while you still can...!」",
  "slot": 60
 },
 "0x0053B5": {
  "en": "「Umbra, I've no interest in your speeches.」",
  "slot": 54
 },
 "0x0053EC": {
  "en": "「Son Ganglong... I've no interest in your show.」",
  "slot": 57
 },
 "0x005426": {
  "en": "「Mei Long, I won't be your time-killer.」",
  "slot": 60
 },
 "0x005463": {
  "en": "「A dragon? I'll shatter it, scales and all...!」",
