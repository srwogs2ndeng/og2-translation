 "0x006208": {
  "en": "「No matter how many of you swarm out......!」",
  "slot": 57
 },
 "0x006242": {
  "en": "「Ruina...../ there's no place for you in this world.」",
  "slot": 73
 },
 "0x00628C": {
  "en": "「You and all the fear you spread/ are getting wiped out......!」",
  "slot": 76
 },
 "0x0062D9": {
  "en": "「Guest or Inspector....../ what I do stays the same.」",
  "slot": 103
 },
 "0x006341": {
