 },
 "0x005521": {
  "en": "「Here I go, Ranshao...!」",
  "slot": 33
 },
 "0x005543": {
  "en": "「Let's end this, Taihoku...!」",
  "slot": 33
 },
 "0x005565": {
  "en": "「A head-on fight, is it, Roff?/　Fine by me...!」",
