 },
 "0x005923": {
  "en": "「You'll pay a price for it,/　if you want to see my hand.」",
  "slot": 91
 },
 "0x00597F": {
  "en": "「First, I'll stop him...!」",
  "slot": 39
 },
 "0x0059A7": {
  "en": "「The Joker of the/　Zentral Project, huh...!」",
