 },
 "0x0056ED": {
  "en": "「You'll blunder on the final move...!」",
  "slot": 57
 },
 "0x005727": {
  "en": "「Con artists posing as guardians...!」",
  "slot": 48
 },
 "0x005758": {
  "en": "「Don't think your slogans/　will work forever.」",
  "slot": 73
 },
 "0x0057A2": {
  "en": "「I don't want glory. Or infamy, for that matter...!」",
  "slot": 60
 },
 "0x0057DF": {
  "en": "「Now I see your real intentions./　Then there's only one thing left to do.」",
  "slot": 82
 },
 "0x005832": {
  "en": "「Gaia Sabers... don't think you'll get off easy.」",
  "slot": 66
