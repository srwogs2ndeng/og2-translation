 "0x004F94": {
  "en": "「Arado's old comrade or not,/　if you're the enemy, no mercy...!」",
  "slot": 94
 },
 "0x004FF3": {
  "en": "「If you won't straighten yourself out...!」",
  "slot": 54
 },
 "0x00502A": {
  "en": "「Let's settle this, Duvan Org...!」",
