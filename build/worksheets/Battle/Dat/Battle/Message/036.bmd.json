 },
 "0x0060BA": {
  "en": "「Euzeth, betting it all too./ But I'm betting even more!」",
  "slot": 103
 },
 "0x006122": {
  "en": "「Euzeth,/ you'll play along with my gamble!」",
  "slot": 73
 },
 "0x00616C": {
  "en": "「Seems I'm truly tied to monsters......!」",
