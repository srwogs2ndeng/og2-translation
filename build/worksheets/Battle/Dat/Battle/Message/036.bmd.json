 "0x005A4D": {
  "en": "「Same result... you'll be cut down.」",
  "slot": 54
 },
 "0x005A84": {
  "en": "「The third Double G.../　a worthy opponent.」",
  "slot": 73
 },
 "0x005ACE": {
  "en": "「Double G or not,/　up close I won't lose...!」",
  "slot": 73
 },
 "0x005B18": {
  "en": "「That special unit... showy as a Double G.」",
  "slot": 60
 },
 "0x005B55": {
  "en": "「I won't fall behind mere grunts...!」",
