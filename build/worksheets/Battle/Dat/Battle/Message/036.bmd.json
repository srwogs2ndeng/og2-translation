 },
 "0x00563F": {
  "en": "「'King of Ruin'? A simple enough title.」",
  "slot": 60
 },
 "0x00567C": {
  "en": "「If you're Ruina's head... I'll crush you!」",
  "slot": 57
 },
 "0x0056B6": {
  "en": "「Zezernan... you misjudged when to quit.」",
