 "0x005298": {
  "en": "「Spout all the speeches you like./　I'll do just one thing.」",
  "slot": 88
 },
 "0x0052F1": {
  "en": "「Learn firsthand what happens/　to those who meddle in this world.」",
  "slot": 82
