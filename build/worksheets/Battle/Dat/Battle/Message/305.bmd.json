"0x001E74": {
"jp": "「くらえ！」",
"en": "「Take this!」",
"slot": 18
},
"0x001E87": {
"jp": "「これなら！」",
"en": "「How's this!」",
"slot": 21
},
"0x001E9D": {
"jp": "「受けてみろ！」",
"en": "「Try this on!」",
"slot": 24
},
"0x001EB6": {
"jp": "「もらった！」",
"en": "「You're mine!」",
"slot": 21
},
"0x001ECC": {
"jp": "「そこだ！」",
"en": "「Right there!」",
"slot": 18
},
"0x001EDF": {
"jp": "「次は俺の番だ！」",
"en": "「My turn now!」",
"slot": 27
},
"0x001EFB": {
"jp": "「ただでは帰さん！」",
"en": "「You won't get off easy!」",
"slot": 30
},
"0x001F1A": {
"jp": "「お返しだ！」",
"en": "「Payback time!」",
"slot": 21
},
"0x001F30": {
"jp": "「離脱などさせるか！」",
"en": "「You won't escape!」",
"slot": 33
},
"0x001F52": {
"jp": "「反撃を！」",
"en": "「Counter!」",
"slot": 18
},
"0x001F65": {
"jp": "「仕切り直しだ！」",
"en": "「Let's start over!」",
"slot": 27
},
"0x001F81": {
"jp": "「このまま引き下がるつもりはない！」",
"en": "「I'm not backing down!」",
"slot": 54
},
"0x001FB8": {
"jp": "「今度はこちらからだ！」",
"en": "「Now it's our turn!」",
"slot": 36
},
"0x001FDD": {
"jp": "「反撃開始！」",
"en": "「Counterattack!」",
"slot": 21
},
"0x001FF3": {
"jp": "「ただで済むと思うな！」",
"en": "「You won't get away with this!」",
"slot": 36
},
"0x002018": {
"jp": "「こ、ここまでか！！」",
"en": "「Is this the end?!」",
"slot": 33
},
"0x00203A": {
"jp": "「うあああっ！！」",
"en": "「Uwaaah!!」",
"slot": 27
},
"0x002056": {
"jp": "「駄目だ、脱出を！！」",
"en": "「No good, eject!!」",
"slot": 33
},
"0x002078": {
"jp": "「そんな馬鹿な！！」",
"en": "「Impossible!!」",
"slot": 30
},
"0x002097": {
"jp": "「し、しまった！！」",
"en": "「D-damn it!!」",
"slot": 30
},
"0x0020B6": {
"jp": "「こんな結果、認めるわけには……！！」",
"en": "「I won't accept this result...!!」",
"slot": 57
},
"0x0020F0": {
"jp": "「ぐああっ！　機体が！！」",
"en": "「Gaah! My unit!!」",
"slot": 39
},
"0x002118": {
"jp": "「お、おのれ！　よくも！！」",
"en": "「D-damn you! How dare you!!」",
"slot": 42
},
"0x002143": {
"jp": "「馬鹿な、この俺が！！」",
"en": "「Impossible, me, defeated?!」",
"slot": 36
},
"0x002168": {
"jp": "「こ、これ以上は！！」",
"en": "「N-no more of this!!」",
"slot": 33
},
"0x00218A": {
"jp": "「ぐあああっ！！」",
"en": "「Guaaah!!」",
"slot": 27
},
"0x0021A6": {
"jp": "「いかん！　これ以上はまずいぞ！」",
"en": "「No good! This is bad!」",
"slot": 51
},
"0x0021DA": {
"jp": "「こ、ここまで押し込まれるとは！」",
"en": "「T-to be pushed this far!」",
"slot": 51
},
"0x00220E": {
"jp": "「まだだ！　まだ決着はついていない！」",
"en": "「Not yet! It's not over!」",
"slot": 57
},
"0x002248": {
"jp": "「許さん！　許さんぞ、貴様！」",
"en": "「Unforgivable! Damn you!」",
"slot": 45
