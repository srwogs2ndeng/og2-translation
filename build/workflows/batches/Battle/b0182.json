{"Battle/Dat/Battle/Message/102.bmd|0x0077F6": "「少佐、後は私が！」", "Battle/Dat/Battle/Message/102.bmd|0x007815": "「あの伝説の教導隊メンバーと/　連係を組めるなんて、名誉だわ……！」", "Battle/Dat/Battle/Message/102.bmd|0x00787A": "「ラミア少尉、援護します！」", "Battle/Dat/Battle/Message/102.bmd|0x0078A5": "「ラーダさん、後は任せて下さい！」", "Battle/Dat/Battle/Message/102.bmd|0x0078D9": "「ラトゥーニ、援護するわ！」", "Battle/Dat/Battle/Message/102.bmd|0x007904": "「アラド、後は任せて！」", "Battle/Dat/Battle/Message/102.bmd|0x007929": "「援護するわよ、ゼオラ！」", "Battle/Dat/Battle/Message/102.bmd|0x007951": "「ジョッシュ、後は任せて！」", "Battle/Dat/Battle/Message/102.bmd|0x00797C": "「手伝うわよ、リム！」", "Battle/Dat/Battle/Message/102.bmd|0x00799E": "「援護するわよ、アリエイル！」", "Battle/Dat/Battle/Message/102.bmd|0x0079CC": "「イング、援護するわ！」", "Battle/Dat/Battle/Message/102.bmd|0x0079F1": "「キョウスケ中尉、後は私が！」", "Battle/Dat/Battle/Message/102.bmd|0x007A1F": "「ＡＴＸチーム！　援護します！」", "Battle/Dat/Battle/Message/102.bmd|0x007A50": "「ＡＴＸチームと連係を組めるなんて、/　光栄だわ……！」", "Battle/Dat/Battle/Message/102.bmd|0x007AA3": "「ＳＲＸチーム！　援護します！」", "Battle/Dat/Battle/Message/102.bmd|0x007AD4": "「ＳＲＸチームと/　連係を組める日が来るなんて……！」", "Battle/Dat/Battle/Message/102.bmd|0x007B24": "「オクト小隊と一緒に戦えるなんて……！」", "Battle/Dat/Battle/Message/102.bmd|0x007B61": "「こちらからも行けるぞ！」", "Battle/Dat/Battle/Message/102.bmd|0x007B89": "「ええ、これで決めるわ！」", "Battle/Dat/Battle/Message/102.bmd|0x007BB1": "「危ないっ！！」", "Battle/Dat/Battle/Message/102.bmd|0x007BCA": "「私の機体なら、受け止められる！」", "Battle/Dat/Battle/Message/102.bmd|0x007BFE": "「そう上手くいくと思わないで！」", "Battle/Dat/Battle/Message/102.bmd|0x007C2F": "「カイ少佐、離脱して下さい！」", "Battle/Dat/Battle/Message/102.bmd|0x007C5D": "「カイ少佐、危ないっ！」", "Battle/Dat/Battle/Message/102.bmd|0x007C82": "「私の憧れの人をやらせるもんですか！」", "Battle/Dat/Battle/Message/102.bmd|0x007CBC": "「少佐、後退して下さい！」", "Battle/Dat/Battle/Message/102.bmd|0x007CE4": "「ラミア少尉、離脱を！」", "Battle/Dat/Battle/Message/102.bmd|0x007D09": "「ラーダさん、ここは私が！」", "Battle/Dat/Battle/Message/102.bmd|0x007D34": "「後退して、ラトゥーニ！」", "Battle/Dat/Battle/Message/102.bmd|0x007D5C": "「アラド、無茶は駄目よ！」", "Battle/Dat/Battle/Message/102.bmd|0x007D84": "「ゼオラ、下がって！」", "Battle/Dat/Battle/Message/102.bmd|0x007DA6": "「逃げて、ジョッシュ！」", "Battle/Dat/Battle/Message/102.bmd|0x007DCB": "「リム、ここは私に任せて！」", "Battle/Dat/Battle/Message/102.bmd|0x007DF6": "「アリエイル、後退して！」", "Battle/Dat/Battle/Message/102.bmd|0x007E1E": "「逃げて、イング！」", "Battle/Dat/Battle/Message/102.bmd|0x007E3D": "「今だ、割り込め！！」", "Battle/Dat/Battle/Message/102.bmd|0x007E5F": "「ええ！　守ってみせるっ！！」", "Battle/Dat/Battle/Message/102.bmd|0x007E8D": "「まだいける！」", "Battle/Dat/Battle/Message/102.bmd|0x007EA6": "「もう一撃！」", "Battle/Dat/Battle/Message/102.bmd|0x007EBC": "「これで駄目押しよ！」", "Battle/Dat/Battle/Message/102.bmd|0x007EDE": "「もらったわよ！」", "Battle/Dat/Battle/Message/102.bmd|0x007EFA": "「受けなさい！」", "Battle/Dat/Battle/Message/102.bmd|0x007F13": "「そこよっ！」", "Battle/Dat/Battle/Message/102.bmd|0x007F29": "「ポッド・アウト！　攻撃開始！」", "Battle/Dat/Battle/Message/102.bmd|0x007F5A": "「マシンガン・ポッド、展開！/　いっけぇぇっ！！」", "Battle/Dat/Battle/Message/102.bmd|0x007FA4": "「ターゲット・ロック！　攻撃開始！」", "Battle/Dat/Battle/Message/102.bmd|0x007FDB": "「当ててみせるっ！」", "Battle/Dat/Battle/Message/102.bmd|0x007FFA": "「落ちなさいっ！」", "Battle/Dat/Battle/Message/102.bmd|0x008016": "「射程内！　撃つわよっ！」", "Battle/Dat/Battle/Message/102.bmd|0x00803E": "「ＴＥＣシーケンス、開始！」", "Battle/Dat/Battle/Message/102.bmd|0x008069": "「エネルギー・バイパス、解放！」", "Battle/Dat/Battle/Message/102.bmd|0x00809A": "「バレル、展開！」", "Battle/Dat/Battle/Message/102.bmd|0x0080B6": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/102.bmd|0x0080DB": "「ターミナス・キャノン、ディスチャージ！！」", "Battle/Dat/Battle/Message/102.bmd|0x00811E": "「ブラッディ・レイ！！」", "Battle/Dat/Battle/Message/102.bmd|0x008143": "「ブラッディ・レイ、発射っ！！」", "Battle/Dat/Battle/Message/102.bmd|0x008174": "「ブラッディ！　レェェェイ！！」", "Battle/Dat/Battle/Message/102.bmd|0x0081A5": "「ファング・ナックル！！」", "Battle/Dat/Battle/Message/102.bmd|0x0081CD": "「受けてみなさい！/　ファング・ナックル！！」", "Battle/Dat/Battle/Message/102.bmd|0x008211": "「ファング・ナックル！　行っけぇぇっ！！」", "Battle/Dat/Battle/Message/102.bmd|0x008251": "「サンダー・スピンエッジ！！」", "Battle/Dat/Battle/Message/102.bmd|0x00827F": "「ええーいっ！！」", "Battle/Dat/Battle/Message/102.bmd|0x00829B": "「ファング・グリル開放！」", "Battle/Dat/Battle/Message/102.bmd|0x0082C3": "「イグニション！！」", "Battle/Dat/Battle/Message/102.bmd|0x0082E2": "「はあああっ！！」", "Battle/Dat/Battle/Message/102.bmd|0x0082FE": "「バーニング・ブレイカァァァァッ！！」", "Battle/Dat/Battle/Message/102.bmd|0x008338": "「レイガン・ポッド、展開！　行けっ！！」", "Battle/Dat/Battle/Message/102.bmd|0x008375": "「チャージ、完了！」", "Battle/Dat/Battle/Message/102.bmd|0x008394": "「ターミナス・スマッシャー、発射！！」", "Battle/Dat/Battle/Message/102.bmd|0x0083CE": "「ターミナス・スマッシャー！　行けぇっ！！」", "Battle/Dat/Battle/Message/102.bmd|0x008411": "「バレル、ライト、レフト！」", "Battle/Dat/Battle/Message/102.bmd|0x00843C": "「トップ、セット！」", "Battle/Dat/Battle/Message/102.bmd|0x00845B": "「ロック！」", "Battle/Dat/Battle/Message/102.bmd|0x00846E": "「展開！」", "Battle/Dat/Battle/Message/102.bmd|0x00847E": "「ターゲット・ロックオン！」", "Battle/Dat/Battle/Message/102.bmd|0x0084A9": "「ＴＥエンジン、オーバー・ブルー！」", "Battle/Dat/Battle/Message/102.bmd|0x0084E0": "「撃て、アクア！」", "Battle/Dat/Battle/Message/102.bmd|0x0084FC": "「ケルベレイド・バスタァァァァッ！！」", "Battle/Dat/Battle/Message/102.bmd|0x008536": "「今だ、アクア！」", "Battle/Dat/Battle/Message/102.bmd|0x008552": "「了解！」", "Battle/Dat/Battle/Message/102.bmd|0x008562": "「ケルベレイド・バスター、発射っ！！」", "Battle/Dat/Battle/Message/102.bmd|0x00859C": "「ＴＥスフィア……」", "Battle/Dat/Battle/Message/102.bmd|0x0085BB": "「リディエイト！」", "Battle/Dat/Battle/Message/102.bmd|0x0085D7": "「はああっ！」", "Battle/Dat/Battle/Message/102.bmd|0x0085ED": "「ターミナス・ショット！！」", "Battle/Dat/Battle/Message/102.bmd|0x008618": "「ＭＡパーツ、パージ！」", "Battle/Dat/Battle/Message/102.bmd|0x00863D": "「行きなさい、ヒオウ！」", "Battle/Dat/Battle/Message/102.bmd|0x008662": "「ロウガ！」", "Battle/Dat/Battle/Message/102.bmd|0x008675": "「今よ！　スピン・レイド！」", "Battle/Dat/Battle/Message/102.bmd|0x0086A0": "「スピン・レイド！　アタック！！」", "Battle/Dat/Battle/Message/102.bmd|0x0086D4": "「ＴＥスフィア、リディエイト！」", "Battle/Dat/Battle/Message/102.bmd|0x008705": "「これで決める！」", "Battle/Dat/Battle/Message/102.bmd|0x008721": "「トリニティ・デッドエンドォォォ！！」", "Battle/Dat/Battle/Message/102.bmd|0x00875B": "「さあ、覚悟なさいっ！！」", "Battle/Dat/Battle/Message/102.bmd|0x008783": "「トリニティ・デッドエンド！！」", "Battle/Dat/Battle/Message/103.bmd|0x0025FA": "「迂闊な奴め！」", "Battle/Dat/Battle/Message/103.bmd|0x002613": "「レンジ内に入ったな……！」", "Battle/Dat/Battle/Message/103.bmd|0x00263E": "「容赦はせん！」", "Battle/Dat/Battle/Message/103.bmd|0x002657": "「獲物が来たか……！」", "Battle/Dat/Battle/Message/103.bmd|0x002679": "「後手に回るつもりはない！」", "Battle/Dat/Battle/Message/103.bmd|0x0026A4": "「そこか！」", "Battle/Dat/Battle/Message/103.bmd|0x0026B7": "「遅い！　もらったぞ！」", "Battle/Dat/Battle/Message/103.bmd|0x0026DC": "「消えてもらうぞ！」", "Battle/Dat/Battle/Message/103.bmd|0x0026FB": "「撃破あるのみ！」", "Battle/Dat/Battle/Message/103.bmd|0x002717": "「さあ、覚悟を決めろ！/　己の運命を受け入れる覚悟を！」", "Battle/Dat/Battle/Message/103.bmd|0x00276A": "「出力、安定しています」", "Battle/Dat/Battle/Message/103.bmd|0x00278F": "「了解した。仕掛ける！」", "Battle/Dat/Battle/Message/103.bmd|0x0027B4": "「敵機行動予測データ、送ります」", "Battle/Dat/Battle/Message/103.bmd|0x0027E5": "「了解。攻撃を開始する！」", "Battle/Dat/Battle/Message/103.bmd|0x00280D": "「ここは俺の判断でいく！」", "Battle/Dat/Battle/Message/103.bmd|0x002835": "「わかりました。お任せします」", "Battle/Dat/Battle/Message/103.bmd|0x002863": "「データの収集を開始します。/　後はよろしく」", "Battle/Dat/Battle/Message/103.bmd|0x0028A7": "「ああ、任せろ」", "Battle/Dat/Battle/Message/103.bmd|0x0028C0": "「ＡＩ１が敵機のＷＰデータを表示しました」", "Battle/Dat/Battle/Message/103.bmd|0x002900": "「フン……参考程度にさせてもらおう」", "Battle/Dat/Battle/Message/103.bmd|0x002937": "「ＡＩ１に余計な真似をさせるなよ」", "Battle/Dat/Battle/Message/103.bmd|0x00296B": "「それはあなた次第ですわ」", "Battle/Dat/Battle/Message/103.bmd|0x002993": "「エルデ、ＡＩ１の補助は不要だ」", "Battle/Dat/Battle/Message/103.bmd|0x0029C4": "「……わかりました」", "Battle/Dat/Battle/Message/103.bmd|0x0029E3": "「ＡＩ１、ターゲット・ロック。後は……」"}