{"Battle/Dat/Battle/Message/159.bmd|0x0031B5": "「ちっ、見失ったか！」", "Battle/Dat/Battle/Message/159.bmd|0x0031D7": "「くっ、この間合いでは！」", "Battle/Dat/Battle/Message/159.bmd|0x0031FF": "「援護に入る！」", "Battle/Dat/Battle/Message/159.bmd|0x003218": "「後は任せておけっ！」", "Battle/Dat/Battle/Message/159.bmd|0x00323A": "「殿下、援護致します！」", "Battle/Dat/Battle/Message/159.bmd|0x00325F": "「もう一撃！」", "Battle/Dat/Battle/Message/159.bmd|0x003275": "「こちらで引き受ける！」", "Battle/Dat/Battle/Message/159.bmd|0x00329A": "「やらせるものか！」", "Battle/Dat/Battle/Message/159.bmd|0x0032B9": "「殿下、お下がりください！」", "Battle/Dat/Battle/Message/159.bmd|0x0032E4": "「体勢を崩したな！」", "Battle/Dat/Battle/Message/159.bmd|0x003303": "「隙あり！」", "Battle/Dat/Battle/Message/159.bmd|0x003316": "「こいつで！」", "Battle/Dat/Battle/Message/159.bmd|0x00332C": "「くらえっ！」", "Battle/Dat/Battle/Message/159.bmd|0x003342": "「もらう！」", "Battle/Dat/Battle/Message/159.bmd|0x003355": "「やあっ！」", "Battle/Dat/Battle/Message/159.bmd|0x003368": "「むんっ！」", "Battle/Dat/Battle/Message/159.bmd|0x00337B": "「はあっ！」", "Battle/Dat/Battle/Message/159.bmd|0x00338E": "「たあっ！」", "Battle/Dat/Battle/Message/159.bmd|0x0033A1": "「受けろ！」", "Battle/Dat/Battle/Message/159.bmd|0x0033B4": "「そこだ！」", "Battle/Dat/Battle/Message/159.bmd|0x0033C7": "「当ててやる！」", "Battle/Dat/Battle/Message/159.bmd|0x0033E0": "「機銃座、撃ち方始め！」", "Battle/Dat/Battle/Message/159.bmd|0x003405": "「対空機銃、撃て！」", "Battle/Dat/Battle/Message/159.bmd|0x003424": "「高射砲、発射用意！　撃て！」", "Battle/Dat/Battle/Message/159.bmd|0x003452": "「高射砲、１番、２番！　撃て！」", "Battle/Dat/Battle/Message/159.bmd|0x003483": "「前部全砲塔、発射用意！　撃て！」", "Battle/Dat/Battle/Message/159.bmd|0x0034B7": "「前部砲塔、一斉射撃！　撃て！」", "Battle/Dat/Battle/Message/159.bmd|0x0034E8": "「バリオン・ビーム砲、発射用意！」", "Battle/Dat/Battle/Message/159.bmd|0x00351C": "「撃て！」", "Battle/Dat/Battle/Message/159.bmd|0x00352C": "「主砲、発射用意！」", "Battle/Dat/Battle/Message/160.bmd|0x002340": "「やってみせる！」", "Battle/Dat/Battle/Message/160.bmd|0x00235C": "「よし、狙いはついた！」", "Battle/Dat/Battle/Message/160.bmd|0x002381": "「仕掛ける！」", "Battle/Dat/Battle/Message/160.bmd|0x002397": "「行くぞ、地上人！」", "Battle/Dat/Battle/Message/160.bmd|0x0023B6": "「ラングランに与する地上人め！」", "Battle/Dat/Battle/Message/160.bmd|0x0023E7": "「地上人の好きにはやらせん！」", "Battle/Dat/Battle/Message/160.bmd|0x002415": "「地上のメカなどに！」", "Battle/Dat/Battle/Message/160.bmd|0x002437": "「行くぞ、サイバスター！」", "Battle/Dat/Battle/Message/160.bmd|0x00245F": "「サイバスターを落とせば、/　最上の手柄になる！」", "Battle/Dat/Battle/Message/160.bmd|0x0024A9": "「魔装機神が相手でも！」", "Battle/Dat/Battle/Message/160.bmd|0x0024CE": "「魔装機神を仕留めれば、大手柄だ！」", "Battle/Dat/Battle/Message/160.bmd|0x002505": "「魔装機神……数でかかれば何とかなる！」", "Battle/Dat/Battle/Message/160.bmd|0x002542": "「グランヴェール……仕留めてやるさ！」", "Battle/Dat/Battle/Message/160.bmd|0x00257C": "「ガッデス……落としてみせる！」", "Battle/Dat/Battle/Message/160.bmd|0x0025AD": "「ラングランの魔装機など！」", "Battle/Dat/Battle/Message/160.bmd|0x0025D8": "「ラングランめ、好きにはやらせんぞ！」", "Battle/Dat/Battle/Message/160.bmd|0x002612": "「打倒ラングラン！　行くぞ！」", "Battle/Dat/Battle/Message/160.bmd|0x002640": "「こっちからも行くぞ！」", "Battle/Dat/Battle/Message/160.bmd|0x002665": "「反撃開始！」", "Battle/Dat/Battle/Message/160.bmd|0x00267B": "「今度はこっちの番だ！」", "Battle/Dat/Battle/Message/160.bmd|0x0026A0": "「ただでは帰さん！」", "Battle/Dat/Battle/Message/160.bmd|0x0026BF": "「次はこちらから行くぞ！」", "Battle/Dat/Battle/Message/160.bmd|0x0026E7": "「まだここからだ！」", "Battle/Dat/Battle/Message/160.bmd|0x002706": "「うわああっ！！」", "Battle/Dat/Battle/Message/160.bmd|0x002722": "「こ、ここまでか！」", "Battle/Dat/Battle/Message/160.bmd|0x002741": "「だ、脱出を！」", "Battle/Dat/Battle/Message/160.bmd|0x00275A": "「おのれ、おのれぇっ！！」", "Battle/Dat/Battle/Message/160.bmd|0x002782": "「し、しまった！！」", "Battle/Dat/Battle/Message/160.bmd|0x0027A1": "「こ、これ以上は！！」", "Battle/Dat/Battle/Message/160.bmd|0x0027C3": "「ぐああっ！　何だ、これは！？」", "Battle/Dat/Battle/Message/160.bmd|0x0027F4": "「ま、まずい！　このままでは！」", "Battle/Dat/Battle/Message/160.bmd|0x002825": "「ええい、まだ退けんのだ！！」", "Battle/Dat/Battle/Message/160.bmd|0x002853": "「いかん、シールドのパワーが低下している！」", "Battle/Dat/Battle/Message/160.bmd|0x002896": "「ぐううっ！　こ、これではもたん！」", "Battle/Dat/Battle/Message/160.bmd|0x0028CD": "「うぐっ！　奴め、何というパワーなんだ！」", "Battle/Dat/Battle/Message/160.bmd|0x00290D": "「くうっ！　祖国のためにも、/　ここで退くわけには！」", "Battle/Dat/Battle/Message/160.bmd|0x00295D": "「うぐっ！/　まだ決着はついていないぞ、地上人！」", "Battle/Dat/Battle/Message/160.bmd|0x0029A7": "「あ、あの地上人には敵わないのか……！？」", "Battle/Dat/Battle/Message/160.bmd|0x0029E7": "「何なんだ、あの地上のメカは！！」", "Battle/Dat/Battle/Message/160.bmd|0x002A1B": "「ス、スピードもパワーも/　サイバスターには敵わない！」", "Battle/Dat/Battle/Message/160.bmd|0x002A6E": "「お、おのれ、サイバスターめ！！」", "Battle/Dat/Battle/Message/160.bmd|0x002AA2": "「こ、これが魔装機神の力なのか！！」", "Battle/Dat/Battle/Message/160.bmd|0x002AD9": "「ま、魔装機神……やはり、あれは危険だ！」", "Battle/Dat/Battle/Message/160.bmd|0x002B19": "「駄目だ、グランヴェールを止められん！！」", "Battle/Dat/Battle/Message/160.bmd|0x002B59": "「ほ、炎の魔装機神……/　その名は伊達ではないな……！」", "Battle/Dat/Battle/Message/160.bmd|0x002BAC": "「ガ、ガッデス……強過ぎる！」", "Battle/Dat/Battle/Message/160.bmd|0x002BDA": "「な、何としてもここでガッデスを……！！」", "Battle/Dat/Battle/Message/160.bmd|0x002C1A": "「ぐっ！　直撃か！」", "Battle/Dat/Battle/Message/160.bmd|0x002C39": "「ま、まともに当てられた！？」", "Battle/Dat/Battle/Message/160.bmd|0x002C67": "「まだだ、まだやられてはいない！」", "Battle/Dat/Battle/Message/160.bmd|0x002C9B": "「ぐうっ！　よくも！！」", "Battle/Dat/Battle/Message/160.bmd|0x002CC0": "「う、動きが読まれているのか！？」", "Battle/Dat/Battle/Message/160.bmd|0x002CF4": "「ううっ、油断したか……！」", "Battle/Dat/Battle/Message/160.bmd|0x002D1F": "「何っ！？　パワー負けしているのか！？」", "Battle/Dat/Battle/Message/160.bmd|0x002D5C": "「やってくれたな、地上人！！」", "Battle/Dat/Battle/Message/160.bmd|0x002D8A": "「うぐっ！　地上人め、よくも！」", "Battle/Dat/Battle/Message/160.bmd|0x002DBB": "「地上人に後れを取るとは……！」", "Battle/Dat/Battle/Message/160.bmd|0x002DEC": "「サイバスターめ、何てスピードなんだ！」", "Battle/Dat/Battle/Message/160.bmd|0x002E29": "「な、何としてもサイバスターを……！！」", "Battle/Dat/Battle/Message/160.bmd|0x002E66": "「さ、さすがだな、魔装機神！」", "Battle/Dat/Battle/Message/160.bmd|0x002E94": "「魔装機神相手に油断したつもりは……！」", "Battle/Dat/Battle/Message/160.bmd|0x002ED1": "「グ、グランヴェール……奴の火力は！」", "Battle/Dat/Battle/Message/160.bmd|0x002F0B": "「せめて、/　グランヴェールの足止めだけでも……！」", "Battle/Dat/Battle/Message/160.bmd|0x002F58": "「ガ、ガッデスめ、やってくれる！」", "Battle/Dat/Battle/Message/160.bmd|0x002F8C": "「ガッデスを止められんとは……！」", "Battle/Dat/Battle/Message/160.bmd|0x002FC0": "「チッ、回避し損なったか！」", "Battle/Dat/Battle/Message/160.bmd|0x002FEB": "「当たっただけだ！」", "Battle/Dat/Battle/Message/160.bmd|0x00300A": "「こんなもの、ダメージの内に入らん！」", "Battle/Dat/Battle/Message/160.bmd|0x003044": "「ふん、それがどうしたと言うのだ！」", "Battle/Dat/Battle/Message/160.bmd|0x00307B": "「何の、かすっただけだ！」", "Battle/Dat/Battle/Message/160.bmd|0x0030A3": "「それで我らを止める気か！」", "Battle/Dat/Battle/Message/160.bmd|0x0030CE": "「我らシュテドニアスを/　甘く見てもらっては困る！」", "Battle/Dat/Battle/Message/160.bmd|0x00311B": "「地上人め、やるな！」", "Battle/Dat/Battle/Message/160.bmd|0x00313D": "「調子に乗るなよ、地上人！」", "Battle/Dat/Battle/Message/160.bmd|0x003168": "「ふん、地上では/　それで通用していたのかも知れんが……」", "Battle/Dat/Battle/Message/160.bmd|0x0031BE": "「ハッ！　スピードだけか、サイバスター！」", "Battle/Dat/Battle/Message/160.bmd|0x0031FE": "「サイバスター……噂ほどではないな」", "Battle/Dat/Battle/Message/160.bmd|0x003235": "「大したことはないな、魔装機神も」", "Battle/Dat/Battle/Message/160.bmd|0x003269": "「いける！　これなら魔装機神と戦えるぞ！」", "Battle/Dat/Battle/Message/160.bmd|0x0032A9": "「グランヴェール……そんなものか」", "Battle/Dat/Battle/Message/160.bmd|0x0032DD": "「グランヴェール、思っていたほどではないな」", "Battle/Dat/Battle/Message/160.bmd|0x003320": "「その程度か、ガッデスは！」", "Battle/Dat/Battle/Message/160.bmd|0x00334B": "「ふん、ガッデスは非力だな！」", "Battle/Dat/Battle/Message/160.bmd|0x003379": "「なんのっ！」", "Battle/Dat/Battle/Message/160.bmd|0x00338F": "「当たるか！」", "Battle/Dat/Battle/Message/160.bmd|0x0033A5": "「遅い！」", "Battle/Dat/Battle/Message/160.bmd|0x0033B5": "「甘いな！」", "Battle/Dat/Battle/Message/160.bmd|0x0033C8": "「そんなものか、地上人！」", "Battle/Dat/Battle/Message/160.bmd|0x0033F0": "「魔装機神と言っても、大したことはないな」", "Battle/Dat/Battle/Message/160.bmd|0x003430": "「無駄だっ！」"}