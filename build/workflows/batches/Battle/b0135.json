{"Battle/Dat/Battle/Message/066.bmd|0x0089BF": "「続くぞ、ククル！」", "Battle/Dat/Battle/Message/066.bmd|0x0089DE": "「手を貸すぞ、アリエイル！」", "Battle/Dat/Battle/Message/066.bmd|0x008A09": "「イング、助太刀するぞ！」", "Battle/Dat/Battle/Message/066.bmd|0x008A31": "「打ち込みが足らんぞ、トウマ！」", "Battle/Dat/Battle/Message/066.bmd|0x008A62": "「詰めが甘いぞ、ミチル！」", "Battle/Dat/Battle/Message/066.bmd|0x008A8A": "「この戦い、まだ終わりはせん！！」", "Battle/Dat/Battle/Message/066.bmd|0x008ABE": "「この勝負、俺が預かる！！」", "Battle/Dat/Battle/Message/066.bmd|0x008AE9": "「我が身を盾に！！」", "Battle/Dat/Battle/Message/066.bmd|0x008B08": "「迂闊だぞ、キョウスケ！」", "Battle/Dat/Battle/Message/066.bmd|0x008B30": "「エクセレン！　そこをどけ！」", "Battle/Dat/Battle/Message/066.bmd|0x008B5E": "「下がれ、ブルックリン！」", "Battle/Dat/Battle/Message/066.bmd|0x008B86": "「離脱するのだ、ギリアム！」", "Battle/Dat/Battle/Message/066.bmd|0x008BB1": "「カイ少佐、すぐに後退を！」", "Battle/Dat/Battle/Message/066.bmd|0x008BDC": "「レーツェル、この場は俺が預かる！」", "Battle/Dat/Battle/Message/066.bmd|0x008C13": "「下がれ、レーツェル！」", "Battle/Dat/Battle/Message/066.bmd|0x008C38": "「アラド！　お前では無理だ！」", "Battle/Dat/Battle/Message/066.bmd|0x008C66": "「先生、ここはお任せを！」", "Battle/Dat/Battle/Message/066.bmd|0x008C8E": "「下がれ、ユウキ！」", "Battle/Dat/Battle/Message/066.bmd|0x008CAD": "「気を抜くな、リルカーラ！」", "Battle/Dat/Battle/Message/066.bmd|0x008CD8": "「離脱しろ、ラウル！」", "Battle/Dat/Battle/Message/066.bmd|0x008CFA": "「下がれ、フィオナ！」", "Battle/Dat/Battle/Message/066.bmd|0x008D1C": "「油断するな、ファイター・ロア！」", "Battle/Dat/Battle/Message/066.bmd|0x008D50": "「下がれ、トウマ！」", "Battle/Dat/Battle/Message/066.bmd|0x008D6F": "「迂闊だぞ、ミチル！」", "Battle/Dat/Battle/Message/066.bmd|0x008D91": "「退くのだ、ククル！」", "Battle/Dat/Battle/Message/066.bmd|0x008DB3": "「三殺を以て、貴様を討つ！」", "Battle/Dat/Battle/Message/066.bmd|0x008DDE": "「勝機は逃さん！」", "Battle/Dat/Battle/Message/066.bmd|0x008DFA": "「俺の剣はまだ届く！」", "Battle/Dat/Battle/Message/066.bmd|0x008E1C": "「くらえ！！」", "Battle/Dat/Battle/Message/066.bmd|0x008E32": "「そこだっ！！」", "Battle/Dat/Battle/Message/066.bmd|0x008E4B": "「ブーストナックル！！」", "Battle/Dat/Battle/Message/066.bmd|0x008E70": "「ゆけ！　ブーストナックル！！」", "Battle/Dat/Battle/Message/066.bmd|0x008EA1": "「ハイパー・ブラスタァァァッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x008ED5": "「ハイパー・ブラスター！　焼き尽くせ！！」", "Battle/Dat/Battle/Message/066.bmd|0x008F15": "「ハイパー・ブラスター、発射ッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x008F4C": "「ゼンガー・ゾンボルト、推して参るッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x008F8C": "「零式斬艦刀！　疾風迅雷！」", "Battle/Dat/Battle/Message/066.bmd|0x008FB7": "「ぬおおおおお！！」", "Battle/Dat/Battle/Message/066.bmd|0x008FD6": "「チェストォォォォォッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009001": "「我に断てぬものなし！！」", "Battle/Dat/Battle/Message/066.bmd|0x009029": "「零式斬艦刀に、断てぬものなし！！」", "Battle/Dat/Battle/Message/066.bmd|0x009060": "「我はゼンガー・ゾンボルト！/　悪を断つ剣なり！！」", "Battle/Dat/Battle/Message/066.bmd|0x0090AD": "「刮目せよ！　これが我が太刀筋なり！！」", "Battle/Dat/Battle/Message/066.bmd|0x0090EA": "「零式斬艦刀！　疾風怒濤！」", "Battle/Dat/Battle/Message/066.bmd|0x009115": "「はあああああ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009134": "「我が斬艦刀に、断てぬものなし！！」", "Battle/Dat/Battle/Message/066.bmd|0x00916B": "「一刀！　両断ッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x00918D": "「アイソリッド・レーザー！！」", "Battle/Dat/Battle/Message/066.bmd|0x0091BB": "「砕け！　ドリル・ブーストナックル！！」", "Battle/Dat/Battle/Message/066.bmd|0x0091F8": "「貫け！　ドリル・ブーストナックル！！」", "Battle/Dat/Battle/Message/066.bmd|0x009235": "「必殺！　オメガ・ブラスタァァァッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009272": "「オメガ・ブラスター、発射！！」", "Battle/Dat/Battle/Message/066.bmd|0x0092A3": "「我が豪腕を受けよ！！」", "Battle/Dat/Battle/Message/066.bmd|0x0092C8": "「ダイナミック・ナックル！！」", "Battle/Dat/Battle/Message/066.bmd|0x0092F6": "「一撃粉砕！」", "Battle/Dat/Battle/Message/066.bmd|0x00930C": "「ゼネラル・ブラスタァァァァッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009343": "「焼滅せよ！」", "Battle/Dat/Battle/Message/066.bmd|0x009359": "「ゼネラル・ブラスター！！」", "Battle/Dat/Battle/Message/066.bmd|0x009384": "「舞えッ！　斬艦刀ッ！」", "Battle/Dat/Battle/Message/066.bmd|0x0093A9": "「大！」", "Battle/Dat/Battle/Message/066.bmd|0x0093B6": "「車！」", "Battle/Dat/Battle/Message/066.bmd|0x0093C3": "「りぃぃぃぃん！！」", "Battle/Dat/Battle/Message/066.bmd|0x0093E2": "「飛べ、飛燕のごとく！」", "Battle/Dat/Battle/Message/066.bmd|0x009407": "「斬艦刀ォォ……！」", "Battle/Dat/Battle/Message/066.bmd|0x009426": "「推して……参るッ！」", "Battle/Dat/Battle/Message/066.bmd|0x009448": "「はあっ！」", "Battle/Dat/Battle/Message/066.bmd|0x00945B": "「我が一刀は、雷のきらめき！」", "Battle/Dat/Battle/Message/066.bmd|0x009489": "「推して参るッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x0094A8": "「我が一刀は、雷のきらめきなり！」", "Battle/Dat/Battle/Message/066.bmd|0x0094DC": "「斬艦刀・雷光斬りッ！」", "Battle/Dat/Battle/Message/066.bmd|0x009501": "「斬艦刀・疾風迅雷ッ！」", "Battle/Dat/Battle/Message/066.bmd|0x009526": "「斬艦刀・雷光斬りィッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009551": "「我に断てぬものなしッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x00957C": "「雲燿の太刀、その身でしかと受け止めよ！」", "Battle/Dat/Battle/Message/066.bmd|0x0095BC": "「吠えろッ！　ダイゼンガー！」", "Battle/Dat/Battle/Message/066.bmd|0x0095EA": "「でやああっ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009606": "「はあああああっ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009628": "「チェェストォォォォォッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009656": "「この切っ先に、/　一擲を成して乾坤を賭せん！！」", "Battle/Dat/Battle/Message/066.bmd|0x0096A0": "「刮目せよっ！　これが我が太刀筋なり！」", "Battle/Dat/Battle/Message/066.bmd|0x0096DD": "「届けっ！　雲燿の速さまでッ！」", "Battle/Dat/Battle/Message/066.bmd|0x00970E": "「はああっ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009727": "「この切っ先に、/　一擲を成して乾坤を賭せん…！」", "Battle/Dat/Battle/Message/066.bmd|0x009771": "「我が斬艦刀に断てぬものなしッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x0097A8": "「友よ、今こそ我らの力を見せる時！」", "Battle/Dat/Battle/Message/066.bmd|0x0097DF": "「承知！！」", "Battle/Dat/Battle/Message/066.bmd|0x0097F2": "「仕掛ける！」", "Battle/Dat/Battle/Message/066.bmd|0x009808": "「友よ、今が駆け抜ける時！」", "Battle/Dat/Battle/Message/066.bmd|0x009833": "「応！！」", "Battle/Dat/Battle/Message/066.bmd|0x009843": "「刃・馬・一・体！」", "Battle/Dat/Battle/Message/066.bmd|0x009862": "「参るッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009878": "「吠えろ、ダイゼンガー！/　武神のごとく！！」", "Battle/Dat/Battle/Message/066.bmd|0x0098BC": "「駆けろ、トロンベ！　その名の如く！」", "Battle/Dat/Battle/Message/066.bmd|0x0098F6": "「刃馬！　一体ッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009918": "「刮目せよッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009934": "「これぞ我らの！！」", "Battle/Dat/Battle/Message/066.bmd|0x009953": "「乾坤一擲の一撃なり！」", "Battle/Dat/Battle/Message/066.bmd|0x009978": "「でえええいっ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009997": "「奥義ッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x0099AD": "「斬艦刀！　逸騎刀閃ッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x0099D8": "「切り裂く！」", "Battle/Dat/Battle/Message/066.bmd|0x0099EE": "「フッ、我らに……」", "Battle/Dat/Battle/Message/066.bmd|0x009A0D": "「断てぬものなし……！」", "Battle/Dat/Battle/Message/066.bmd|0x009A32": "「断てぬものなしッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009A57": "「ドリル・アタック！　貫けぃ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009A8B": "「一撃粉砕！　ダイナミック・ナックル！！」", "Battle/Dat/Battle/Message/066.bmd|0x009ACB": "「ゼネラル・ブラスター、発射ッ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009B02": "「焼滅せよ！　ゼネラル・ブラスター！！」", "Battle/Dat/Battle/Message/066.bmd|0x009B3F": "「斬艦刀！　牙壊！」", "Battle/Dat/Battle/Message/066.bmd|0x009B5E": "「牙壊！　駿即斬断！」", "Battle/Dat/Battle/Message/066.bmd|0x009B80": "「牙壊！　迅即両断！」", "Battle/Dat/Battle/Message/066.bmd|0x009BA2": "「はああああっ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009BC1": "「打剣！」", "Battle/Dat/Battle/Message/066.bmd|0x009BD1": "「ぬうんっ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009BEA": "「もう一撃！！」", "Battle/Dat/Battle/Message/066.bmd|0x009C03": "「ハイパー・ブーストナックル！」", "Battle/Dat/Battle/Message/066.bmd|0x009C34": "「砕けぇぇっ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009C50": "「貫けぇぇっ！！」", "Battle/Dat/Battle/Message/066.bmd|0x009C6C": "「ビーム・キャノン、連動！」", "Battle/Dat/Battle/Message/066.bmd|0x009C97": "「アルティメット・ビィィィィム！！」"}