{"Battle/Dat/Battle/Message/091.bmd|0x003157": "「とどめッ！！」", "Battle/Dat/Battle/Message/091.bmd|0x003170": "「ぬおおおおっ！！」", "Battle/Dat/Battle/Message/091.bmd|0x00318F": "「散れいっ！！」", "Battle/Dat/Battle/Message/091.bmd|0x0031A8": "「我が太刀を受けよ！」", "Battle/Dat/Battle/Message/091.bmd|0x0031CA": "「ガーリオン“無明”、推参！」", "Battle/Dat/Battle/Message/091.bmd|0x0031F8": "「チェストォォォオッ！！」", "Battle/Dat/Battle/Message/091.bmd|0x003220": "「一刀両断！！」", "Battle/Dat/Battle/Message/091.bmd|0x003239": "「でぇぇぇいっ！！」", "Battle/Dat/Battle/Message/092.bmd|0x000F6F": "「ガイアセイバーズの力を知らしめるのだ」", "Battle/Dat/Battle/Message/092.bmd|0x000FAC": "「大義は我らにあり。総員、奮闘せよ！」", "Battle/Dat/Battle/Message/092.bmd|0x000FE6": "「エア・クリスマスの力、思い知るがいい」", "Battle/Dat/Battle/Message/092.bmd|0x001023": "「テツヤ……私は新たな立場と力を得た」", "Battle/Dat/Battle/Message/092.bmd|0x00105D": "「テツヤ・オノデラ……/　お前との因縁を終わらせる」", "Battle/Dat/Battle/Message/092.bmd|0x0010AA": "「お前達を倒し、過去を清算する……！」", "Battle/Dat/Battle/Message/092.bmd|0x0010E4": "「アルテウル……/　アルテウル・シュタインベック……！」", "Battle/Dat/Battle/Message/092.bmd|0x001137": "「鋼龍戦隊、お前達の役目は終わったのだ」", "Battle/Dat/Battle/Message/092.bmd|0x001174": "「鋼龍戦隊を撃破する」", "Battle/Dat/Battle/Message/092.bmd|0x001196": "「反乱分子を処分せよ」", "Battle/Dat/Battle/Message/092.bmd|0x0011B8": "「彼らは反逆者だ。容赦するな」", "Battle/Dat/Battle/Message/092.bmd|0x0011E6": "「攻撃目標、スティール２」", "Battle/Dat/Battle/Message/092.bmd|0x00120E": "「攻撃目標、ドラゴン２」", "Battle/Dat/Battle/Message/092.bmd|0x001233": "「攻撃目標、アイアン３」", "Battle/Dat/Battle/Message/092.bmd|0x001258": "「総員、対艦戦闘用意！」", "Battle/Dat/Battle/Message/092.bmd|0x00127D": "「前方の敵艦を沈める！」", "Battle/Dat/Battle/Message/092.bmd|0x0012A2": "「前方のルイーナ機を撃破せよ」", "Battle/Dat/Battle/Message/092.bmd|0x0012D0": "「攻撃目標、ルイーナ機」", "Battle/Dat/Battle/Message/092.bmd|0x0012F5": "「前方のゲスト機を撃破せよ」", "Battle/Dat/Battle/Message/092.bmd|0x001320": "「地球圏よりゲストを排除するのだ」", "Battle/Dat/Battle/Message/092.bmd|0x001354": "「この身に代えても貴様を！」", "Battle/Dat/Battle/Message/092.bmd|0x00137F": "「貴様を討つ！」", "Battle/Dat/Battle/Message/092.bmd|0x001398": "「ＦＴＢシーケンス！」", "Battle/Dat/Battle/Message/092.bmd|0x0013BA": "「フィールド・ブレード、ＯＮ！」", "Battle/Dat/Battle/Message/092.bmd|0x0013EB": "「うおおおお！！」", "Battle/Dat/Battle/Message/092.bmd|0x001407": "「直ちに反撃を！」", "Battle/Dat/Battle/Message/092.bmd|0x001423": "「目標を逃がすな！」", "Battle/Dat/Battle/Message/092.bmd|0x001442": "「反撃開始！」", "Battle/Dat/Battle/Message/092.bmd|0x001458": "「目標を追尾せよ！」", "Battle/Dat/Battle/Message/092.bmd|0x001477": "「おのれ、このようなことが！！」", "Battle/Dat/Battle/Message/092.bmd|0x0014A8": "「こ、ここまでか！　総員退艦せよ！」", "Battle/Dat/Battle/Message/092.bmd|0x0014DF": "「くっ！　被弾箇所、報告！/　ダメコン、急げ！」", "Battle/Dat/Battle/Message/092.bmd|0x001526": "「ちっ、悪あがきを……！」", "Battle/Dat/Battle/Message/092.bmd|0x00154E": "「旗艦が沈むことは許されん！　立て直せ！」", "Battle/Dat/Battle/Message/092.bmd|0x00158E": "「ぬうっ、直撃か！」", "Battle/Dat/Battle/Message/092.bmd|0x0015AD": "「ええい、弾幕を厚くしろ！/　敵を接近させるな！」", "Battle/Dat/Battle/Message/092.bmd|0x0015F7": "「ガイアセイバーズに敗北は許されん！/　奮闘せよ！」", "Battle/Dat/Battle/Message/092.bmd|0x001644": "「くっ！/　鋼龍戦隊に敗れるわけにはいかんのだ！」", "Battle/Dat/Battle/Message/092.bmd|0x00168E": "「被弾箇所の報告を急げ」", "Battle/Dat/Battle/Message/092.bmd|0x0016B3": "「ちっ、本艦に食いついたか……」", "Battle/Dat/Battle/Message/092.bmd|0x0016E4": "「想定範囲内の損害だ。うろたえるな」", "Battle/Dat/Battle/Message/092.bmd|0x00171B": "「その程度で、本艦は沈まん」", "Battle/Dat/Battle/Message/092.bmd|0x001746": "「ふん、本艦に狙いを定めてきたか」", "Battle/Dat/Battle/Message/092.bmd|0x00177A": "「やるな、テツヤ・オノデラ。/　だが、お前では無理だ」", "Battle/Dat/Battle/Message/092.bmd|0x0017CA": "「この程度か」", "Battle/Dat/Battle/Message/092.bmd|0x0017E0": "「ふん……思いの外、非力だな」", "Battle/Dat/Battle/Message/092.bmd|0x00180E": "「各員、冷静に対処せよ」", "Battle/Dat/Battle/Message/092.bmd|0x001833": "「損傷は軽微だな」", "Battle/Dat/Battle/Message/092.bmd|0x00184F": "「各砲座、敵の接近を許すな」", "Battle/Dat/Battle/Message/092.bmd|0x00187A": "「甘いな、テツヤ・オノデラ」", "Battle/Dat/Battle/Message/092.bmd|0x0018A5": "「スペースノア級で/　本艦を沈めることは出来んぞ」", "Battle/Dat/Battle/Message/092.bmd|0x0018EF": "「戦いでは常に先手を読むことが肝要だ」", "Battle/Dat/Battle/Message/092.bmd|0x001929": "「エア・クリスマスを甘く見るな」", "Battle/Dat/Battle/Message/092.bmd|0x00195A": "「いいぞ、操舵手。私の読み通りだ」", "Battle/Dat/Battle/Message/092.bmd|0x00198E": "「よし、このまま反撃に移る」", "Battle/Dat/Battle/Message/092.bmd|0x0019B9": "「油断するな。次の攻撃に備えろ」", "Battle/Dat/Battle/Message/092.bmd|0x0019EA": "「………」", "Battle/Dat/Battle/Message/092.bmd|0x0019FA": "「効きはせん」", "Battle/Dat/Battle/Message/092.bmd|0x001A10": "「無意味だな」", "Battle/Dat/Battle/Message/092.bmd|0x001A26": "「ふん、無駄なあがきを」", "Battle/Dat/Battle/Message/092.bmd|0x001A4B": "「その手は通用せんぞ」", "Battle/Dat/Battle/Message/092.bmd|0x001A6D": "「ＥＰ展開！」", "Battle/Dat/Battle/Message/092.bmd|0x001A83": "「敵に時間を与えるな！」", "Battle/Dat/Battle/Message/092.bmd|0x001AA8": "「弾薬の再装填を急げ！」", "Battle/Dat/Battle/Message/092.bmd|0x001ACD": "「敵に時間を与えるな！　弾薬の再装填を！」", "Battle/Dat/Battle/Message/092.bmd|0x001B0D": "「ふん、死角に入ったか」", "Battle/Dat/Battle/Message/092.bmd|0x001B32": "「目標の再捕捉を！」", "Battle/Dat/Battle/Message/092.bmd|0x001B51": "「味方機を援護せよ！」", "Battle/Dat/Battle/Message/092.bmd|0x001B73": "「続けて攻撃を！」", "Battle/Dat/Battle/Message/092.bmd|0x001B8F": "「最大戦速で突進せよ！」", "Battle/Dat/Battle/Message/092.bmd|0x001BB4": "「本艦で受け止める！」", "Battle/Dat/Battle/Message/092.bmd|0x001BD6": "「目標を再度攻撃！」", "Battle/Dat/Battle/Message/092.bmd|0x001BF5": "「これで仕留めてみせろ！」", "Battle/Dat/Battle/Message/092.bmd|0x001C1D": "「ＥＡＡＭランチャー、攻撃用意！　撃て！」", "Battle/Dat/Battle/Message/092.bmd|0x001C5D": "「ＥＡＡＭランチャー、撃て！」", "Battle/Dat/Battle/Message/092.bmd|0x001C8B": "「副砲、１番から４番！　攻撃用意！」", "Battle/Dat/Battle/Message/092.bmd|0x001CC2": "「撃て！」", "Battle/Dat/Battle/Message/092.bmd|0x001CD2": "「前部副砲、攻撃用意！」", "Battle/Dat/Battle/Message/092.bmd|0x001CF7": "「前部副砲、攻撃用意！」　", "Battle/Dat/Battle/Message/092.bmd|0x001D1F": "「１番から４番！　撃て！」", "Battle/Dat/Battle/Message/092.bmd|0x001D47": "「上部全主砲、攻撃用意！」", "Battle/Dat/Battle/Message/092.bmd|0x001D6F": "「撃て！！」", "Battle/Dat/Battle/Message/092.bmd|0x001D82": "「主砲、攻撃用意！」", "Battle/Dat/Battle/Message/092.bmd|0x001DA1": "「１番から５番！　撃て！！」", "Battle/Dat/Battle/Message/092.bmd|0x001DCC": "「主砲、１番から５番！　攻撃用意！」", "Battle/Dat/Battle/Message/092.bmd|0x001E03": "「これより/　ファー・ツリー・ブレードを使用する」", "Battle/Dat/Battle/Message/092.bmd|0x001E4D": "「突入コース確認！」", "Battle/Dat/Battle/Message/092.bmd|0x001E6C": "「ＦＴＢシーケンスへ移行！」", "Battle/Dat/Battle/Message/092.bmd|0x001E97": "「突撃せよ！！」", "Battle/Dat/Battle/Message/093.bmd|0x00194B": "「ここで奴らの数を減らす！」", "Battle/Dat/Battle/Message/093.bmd|0x001976": "「貴様らを見逃すわけにはいかん！」", "Battle/Dat/Battle/Message/093.bmd|0x0019AA": "「ユウキ・ジェグナン……この裏切り者が！」", "Battle/Dat/Battle/Message/093.bmd|0x0019EA": "「ユウキ……/　見所のある奴だと思っていたがな！」", "Battle/Dat/Battle/Message/093.bmd|0x001A34": "「裏切り者にかける情けはない！」", "Battle/Dat/Battle/Message/093.bmd|0x001A65": "「貴様、バン大佐の恩義を忘れたか！」", "Battle/Dat/Battle/Message/093.bmd|0x001A9C": "「ビアン総帥の娘と言えど、/　敵対するのであれば！」", "Battle/Dat/Battle/Message/093.bmd|0x001AE9": "「ＤＣ再興に協力しないのなら、/　死んでもらう！」", "Battle/Dat/Battle/Message/093.bmd|0x001B33": "「邪魔をするのであれば、総帥の娘と言えど！」", "Battle/Dat/Battle/Message/093.bmd|0x001B76": "「エルザム少佐……/　我ら側について然るべきではないのか！」", "Battle/Dat/Battle/Message/093.bmd|0x001BCF": "「エルザム少佐……/　何故、父親の遺志を継いで立ち上がらんのだ？」", "Battle/Dat/Battle/Message/093.bmd|0x001C31": "「トロイエ隊の生き残りが、/　鋼龍戦隊にいるとはな……！」", "Battle/Dat/Battle/Message/093.bmd|0x001C87": "「貴様も裏切り者だな……！」", "Battle/Dat/Battle/Message/093.bmd|0x001CB2": "「ゼンガー・ゾンボルト……/　ＤＣを混乱させた罪、許すわけにはいかん！」", "Battle/Dat/Battle/Message/093.bmd|0x001D1D": "「ゼンガー……/　貴様はＤＣの理念を理解していたはずだ！」", "Battle/Dat/Battle/Message/093.bmd|0x001D73": "「行くぞ、鋼龍戦隊！」", "Battle/Dat/Battle/Message/093.bmd|0x001D95": "「鋼龍戦隊……貴様らとの因縁を断つ！」", "Battle/Dat/Battle/Message/093.bmd|0x001DCF": "「連邦の力の象徴……鋼龍戦隊を討つ！」", "Battle/Dat/Battle/Message/093.bmd|0x001E09": "「今度は貴様らが煮え湯を飲む番だ！」", "Battle/Dat/Battle/Message/093.bmd|0x001E40": "「相手が貴様らなら、戦う理由がある！」", "Battle/Dat/Battle/Message/093.bmd|0x001E7A": "「どこであろうと、連邦に与する者は死ね！」", "Battle/Dat/Battle/Message/093.bmd|0x001EBA": "「この異界の地で果てるがいい！」", "Battle/Dat/Battle/Message/093.bmd|0x001EEB": "「死ね、アインスト！」"}