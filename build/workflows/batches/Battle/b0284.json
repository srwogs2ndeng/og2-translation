d|0x002097": "「し、しまった！！」", "Battle/Dat/Battle/Message/305.bmd|0x0020B6": "「こんな結果、認めるわけには……！！」", "Battle/Dat/Battle/Message/305.bmd|0x0020F0": "「ぐああっ！　機体が！！」", "Battle/Dat/Battle/Message/305.bmd|0x002118": "「お、おのれ！　よくも！！」", "Battle/Dat/Battle/Message/305.bmd|0x002143": "「馬鹿な、この俺が！！」", "Battle/Dat/Battle/Message/305.bmd|0x002168": "「こ、これ以上は！！」", "Battle/Dat/Battle/Message/305.bmd|0x00218A": "「ぐあああっ！！」", "Battle/Dat/Battle/Message/305.bmd|0x0021A6": "「いかん！　これ以上はまずいぞ！」", "Battle/Dat/Battle/Message/305.bmd|0x0021DA": "「こ、ここまで押し込まれるとは！」", "Battle/Dat/Battle/Message/305.bmd|0x00220E": "「まだだ！　まだ決着はついていない！」", "Battle/Dat/Battle/Message/305.bmd|0x002248": "「許さん！　許さんぞ、貴様！」", "Battle/Dat/Battle/Message/305.bmd|0x002276": "「ええい、コントロールが！！」", "Battle/Dat/Battle/Message/305.bmd|0x0022A4": "「うぐうっ！　貴様ぁ！！」"}