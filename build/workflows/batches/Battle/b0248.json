{"Battle/Dat/Battle/Message/163.bmd|0x0016FB": "「そらよっ！」", "Battle/Dat/Battle/Message/163.bmd|0x001711": "「これでもくらえ！」", "Battle/Dat/Battle/Message/163.bmd|0x001730": "「仕留めてやらぁ！」", "Battle/Dat/Battle/Message/163.bmd|0x00174F": "「やってやらあ！」", "Battle/Dat/Battle/Message/163.bmd|0x00176B": "「くらいやがれ！」", "Battle/Dat/Battle/Message/163.bmd|0x001787": "「おらぁ！」", "Battle/Dat/Battle/Message/163.bmd|0x00179A": "「でえい！」", "Battle/Dat/Battle/Message/163.bmd|0x0017AD": "「うりゃあ！」", "Battle/Dat/Battle/Message/164.bmd|0x000D78": "「俺に会ったのが運の尽きよ！」", "Battle/Dat/Battle/Message/164.bmd|0x000DA6": "「狙った獲物は逃がさねえ！」", "Battle/Dat/Battle/Message/164.bmd|0x000DD1": "「さくっと狩ってやるぜ！」", "Battle/Dat/Battle/Message/164.bmd|0x000DF9": "「地上人め、覚悟しやがれ！」", "Battle/Dat/Battle/Message/164.bmd|0x000E24": "「もらったぜ、地上人！」", "Battle/Dat/Battle/Message/164.bmd|0x000E49": "「地上のメカなんぞに！」", "Battle/Dat/Battle/Message/164.bmd|0x000E6E": "「こいつはお宝だぜ！　この俺がもらった！」", "Battle/Dat/Battle/Message/164.bmd|0x000EAE": "「ハハッ、極上の獲物じゃねえか！」", "Battle/Dat/Battle/Message/164.bmd|0x000EE2": "「やりやがったな！」", "Battle/Dat/Battle/Message/164.bmd|0x000F01": "「お返しだぜ！」", "Battle/Dat/Battle/Message/164.bmd|0x000F1A": "「ただで帰すかよ！」", "Battle/Dat/Battle/Message/164.bmd|0x000F39": "「今度は俺の番だ！」", "Battle/Dat/Battle/Message/164.bmd|0x000F58": "「や、やられちまった！」", "Battle/Dat/Battle/Message/164.bmd|0x000F7D": "「お、覚えてろよ！！」", "Battle/Dat/Battle/Message/164.bmd|0x000F9F": "「くそっ！　ここまでかよ！！」", "Battle/Dat/Battle/Message/164.bmd|0x000FCD": "「これ以上は無理だ！　ずらかるぜ！！」", "Battle/Dat/Battle/Message/164.bmd|0x001007": "「お、俺の出番はここまでか！？」", "Battle/Dat/Battle/Message/164.bmd|0x001038": "「ま、待て！　ちょっと待ってくれ！！」", "Battle/Dat/Battle/Message/164.bmd|0x001072": "「うわああっ！　な、何て奴だ！！」", "Battle/Dat/Battle/Message/164.bmd|0x0010A6": "「は、半端じゃねえ……こいつぁヤバいぜ！」", "Battle/Dat/Battle/Message/164.bmd|0x0010E6": "「ち、地上人ってのはこんなに強いのかよ！」", "Battle/Dat/Battle/Message/164.bmd|0x001126": "「うぐっ！　地上人め、やりたい放題かよ！」", "Battle/Dat/Battle/Message/164.bmd|0x001166": "「ううっ……魔装機神に喧嘩を売ったのが/　間違いだったか……！」", "Battle/Dat/Battle/Message/164.bmd|0x0011C5": "「つ、強い！　強過ぎるぜ、魔装機神！」", "Battle/Dat/Battle/Message/164.bmd|0x0011FF": "「や、やってくれるぜ、このっ！」", "Battle/Dat/Battle/Message/164.bmd|0x001230": "「へ、へへへ……それなりに手強いじゃねえか」", "Battle/Dat/Battle/Message/164.bmd|0x001273": "「うおっ！　何だ、こりゃ！？」", "Battle/Dat/Battle/Message/164.bmd|0x0012A1": "「地上人め、やってくれたな！」", "Battle/Dat/Battle/Message/164.bmd|0x0012CF": "「あ、あの地上人、やりやがるぜ！」", "Battle/Dat/Battle/Message/164.bmd|0x001303": "「や、やるじゃねえか、魔装機神め！」", "Battle/Dat/Battle/Message/164.bmd|0x00133A": "「ま、魔装機神……強いな、くそっ！」", "Battle/Dat/Battle/Message/164.bmd|0x001371": "「何だ、そりゃ！？　笑わせんじゃねえよ！」", "Battle/Dat/Battle/Message/164.bmd|0x0013B1": "「何しやがる、この雑魚がっ！」", "Battle/Dat/Battle/Message/164.bmd|0x0013DF": "「おおっと、当ててきやがったか！」", "Battle/Dat/Battle/Message/164.bmd|0x001413": "「地上人め、遊んでるつもりか？」", "Battle/Dat/Battle/Message/164.bmd|0x001444": "「効かねえよ、地上人！」", "Battle/Dat/Battle/Message/164.bmd|0x001469": "「魔装機神ってのも、大したことねえな！」", "Battle/Dat/Battle/Message/164.bmd|0x0014A6": "「魔装機神はそんなもんかよ！/　話になんねえな！」", "Battle/Dat/Battle/Message/164.bmd|0x0014F0": "「当たらねえよ！」", "Battle/Dat/Battle/Message/164.bmd|0x00150C": "「あ、危ねえな……！」", "Battle/Dat/Battle/Message/164.bmd|0x00152E": "「ハッ！　何やってんだ！」", "Battle/Dat/Battle/Message/164.bmd|0x001556": "「………」", "Battle/Dat/Battle/Message/164.bmd|0x001566": "「反撃できねえ！」", "Battle/Dat/Battle/Message/164.bmd|0x001582": "「な、何も出来ねえのかよ！」", "Battle/Dat/Battle/Message/164.bmd|0x0015AD": "「ええい、あいつの方が一枚上手か！」", "Battle/Dat/Battle/Message/164.bmd|0x0015E4": "「やり返せねえってのかよ！」", "Battle/Dat/Battle/Message/164.bmd|0x00160F": "「ついでだ、俺も！」", "Battle/Dat/Battle/Message/164.bmd|0x00162E": "「そいつは俺の獲物だ！」", "Battle/Dat/Battle/Message/164.bmd|0x001653": "「助けてやるぜ！」", "Battle/Dat/Battle/Message/164.bmd|0x00166F": "「させるかよっ！」", "Battle/Dat/Battle/Message/164.bmd|0x00168B": "「ほらよ！　こいつはサービスだ！」", "Battle/Dat/Battle/Message/164.bmd|0x0016BF": "「そこだ！」", "Battle/Dat/Battle/Message/164.bmd|0x0016D2": "「行けっ！」", "Battle/Dat/Battle/Message/164.bmd|0x0016E5": "「当たれよ！」", "Battle/Dat/Battle/Message/164.bmd|0x0016FB": "「そらよっ！」", "Battle/Dat/Battle/Message/164.bmd|0x001711": "「これでもくらえ！」", "Battle/Dat/Battle/Message/164.bmd|0x001730": "「仕留めてやらぁ！」", "Battle/Dat/Battle/Message/164.bmd|0x00174F": "「やってやらあ！」", "Battle/Dat/Battle/Message/164.bmd|0x00176B": "「くらいやがれ！」", "Battle/Dat/Battle/Message/164.bmd|0x001787": "「おらぁ！」", "Battle/Dat/Battle/Message/164.bmd|0x00179A": "「でえい！」", "Battle/Dat/Battle/Message/164.bmd|0x0017AD": "「うりゃあ！」", "Battle/Dat/Battle/Message/165.bmd|0x00066C": "「グォォォン！」", "Battle/Dat/Battle/Message/165.bmd|0x000685": "「ガッ！　ガオウゥッ！」", "Battle/Dat/Battle/Message/165.bmd|0x0006AA": "「グッ……グルルル！」", "Battle/Dat/Battle/Message/165.bmd|0x0006CC": "「ギャオアァァッ！！」", "Battle/Dat/Battle/Message/165.bmd|0x0006EE": "「グゴオォォッ！！」", "Battle/Dat/Battle/Message/165.bmd|0x00070D": "「ウオォォォ……」", "Battle/Dat/Battle/Message/165.bmd|0x000729": "「グウオォォォォ！」", "Battle/Dat/Battle/Message/165.bmd|0x000748": "「ギウゥゥッ！」", "Battle/Dat/Battle/Message/165.bmd|0x000761": "「ガァァァッ！」", "Battle/Dat/Battle/Message/165.bmd|0x00077A": "「ゲハアァァァッ！！」", "Battle/Dat/Battle/Message/165.bmd|0x00079C": "「グシュウゥゥゥッ！！」", "Battle/Dat/Battle/Message/165.bmd|0x0007C1": "「グオアァァァァァッ！！」", "Battle/Dat/Battle/Message/165.bmd|0x0007E9": "「グバアァァッ！！」", "Battle/Dat/Battle/Message/165.bmd|0x000808": "「ギャガアァァッ！！」", "Battle/Dat/Battle/Message/165.bmd|0x00082A": "「グ……グギアァァァァッ！？」", "Battle/Dat/Battle/Message/165.bmd|0x000858": "「ギャオゥゥゥゥッ！？」", "Battle/Dat/Battle/Message/165.bmd|0x00087D": "「ヴォォォォッ！」", "Battle/Dat/Battle/Message/165.bmd|0x000899": "「グエアァァッ！」", "Battle/Dat/Battle/Message/165.bmd|0x0008B5": "「ウゥゥオォォ……」", "Battle/Dat/Battle/Message/165.bmd|0x0008D4": "「ガフウゥゥッ！！」", "Battle/Dat/Battle/Message/165.bmd|0x0008F3": "「グエアァァッ！！」", "Battle/Dat/Battle/Message/165.bmd|0x000912": "「ギャオウッ！」", "Battle/Dat/Battle/Message/165.bmd|0x00092B": "「ガウウゥッ！」", "Battle/Dat/Battle/Message/165.bmd|0x000944": "「………」", "Battle/Dat/Battle/Message/165.bmd|0x000954": "「ググウゥゥ……」", "Battle/Dat/Battle/Message/165.bmd|0x000970": "「ガウゥゥ……」", "Battle/Dat/Battle/Message/165.bmd|0x000989": "「ギッ！」", "Battle/Dat/Battle/Message/166.bmd|0x00234B": "「照準セット。ターゲット、ロックオン！」", "Battle/Dat/Battle/Message/166.bmd|0x002388": "「目標、目視で確認！」", "Battle/Dat/Battle/Message/166.bmd|0x0023AA": "「殿下のためならば！」", "Battle/Dat/Battle/Message/166.bmd|0x0023CC": "「やってみせる！」", "Battle/Dat/Battle/Message/166.bmd|0x0023E8": "「攻撃開始！」", "Battle/Dat/Battle/Message/166.bmd|0x0023FE": "「逆賊に容赦はせん！」", "Battle/Dat/Battle/Message/166.bmd|0x002420": "「大義は我らにあり！」", "Battle/Dat/Battle/Message/166.bmd|0x002442": "「殿下に抗うのであれば！」", "Battle/Dat/Battle/Message/166.bmd|0x00246A": "「行くぞ、地上人！」", "Battle/Dat/Battle/Message/166.bmd|0x002489": "「地上人の好きにはやらせん！」", "Battle/Dat/Battle/Message/166.bmd|0x0024B7": "「我らに与せぬのであれば、/　地上人とて容赦はせん！」", "Battle/Dat/Battle/Message/166.bmd|0x002507": "「サイバスター……食い止めてみせる！」", "Battle/Dat/Battle/Message/166.bmd|0x002541": "「サイバスター相手でも怯むわけには！」", "Battle/Dat/Battle/Message/166.bmd|0x00257B": "「魔装機神が相手でも！」", "Battle/Dat/Battle/Message/166.bmd|0x0025A0": "「魔装機神でも、隙はどこかにあるはずだ！」", "Battle/Dat/Battle/Message/166.bmd|0x0025E0": "「グランヴェールの足を止める！」", "Battle/Dat/Battle/Message/166.bmd|0x002611": "「ガッデスを食い止めてみせる！」", "Battle/Dat/Battle/Message/166.bmd|0x002642": "「ザムジード……何としても！」", "Battle/Dat/Battle/Message/166.bmd|0x002670": "「やらせんっ！」", "Battle/Dat/Battle/Message/166.bmd|0x002689": "「反撃する！」", "Battle/Dat/Battle/Message/166.bmd|0x00269F": "「次はこちらの番だ！」", "Battle/Dat/Battle/Message/166.bmd|0x0026C1": "「まだここからだ！」", "Battle/Dat/Battle/Message/166.bmd|0x0026E0": "「うあああっ！！」"}