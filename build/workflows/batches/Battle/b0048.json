{"Battle/Dat/Battle/Message/037.bmd|0x010A21": "「ん～、確かにインパクトはあるわよね」", "Battle/Dat/Battle/Message/037.bmd|0x010A5B": "「貫く……！　止めてみる？」", "Battle/Dat/Battle/Message/037.bmd|0x010A86": "「ステルス、捨てるッス！」", "Battle/Dat/Battle/Message/037.bmd|0x010AAE": "「って、捨てちゃイヤ～ン」", "Battle/Dat/Battle/Message/037.bmd|0x010AD6": "「はぁ～い！　ハンマァ～！」", "Battle/Dat/Battle/Message/037.bmd|0x010B01": "「誰が考えたのかしらね、これって」", "Battle/Dat/Battle/Message/037.bmd|0x010B35": "「我が名はエクセレン・ブロウニング！/　悪を断っちゃう剣なの！」", "Battle/Dat/Battle/Message/037.bmd|0x010B94": "「私に断てないものはないわよん！」", "Battle/Dat/Battle/Message/037.bmd|0x010BC8": "「射撃はおまかせ！/　んふふ～、どこを狙って欲しい？」", "Battle/Dat/Battle/Message/037.bmd|0x010C18": "「寄らば斬る！　……とか言ったりしてね」", "Battle/Dat/Battle/Message/037.bmd|0x010C55": "「あんま接近戦はやりたくないんだけど！」", "Battle/Dat/Battle/Message/037.bmd|0x010C92": "「んふふ～、/　そんなに固まってちゃダメダメよん！」", "Battle/Dat/Battle/Message/038.bmd|0x00606C": "「さあ、観念しろ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00608E": "「隙あり！」", "Battle/Dat/Battle/Message/038.bmd|0x0060A1": "「アタック！」", "Battle/Dat/Battle/Message/038.bmd|0x0060B7": "「ＧＯ！」", "Battle/Dat/Battle/Message/038.bmd|0x0060C7": "「くらえっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x0060E0": "「落ちろっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x0060F9": "「もう逃げ場はないぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x00611E": "「よし、今だ！」", "Battle/Dat/Battle/Message/038.bmd|0x006137": "「負けるものかよ！」", "Battle/Dat/Battle/Message/038.bmd|0x006156": "「受けてみろ！」　", "Battle/Dat/Battle/Message/038.bmd|0x006172": "「さあ、行くぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x00618E": "「突撃するっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x0061AA": "「いざ勝負！」", "Battle/Dat/Battle/Message/038.bmd|0x0061C0": "「俺に任せろ！」", "Battle/Dat/Battle/Message/038.bmd|0x0061D9": "「うん！」", "Battle/Dat/Battle/Message/038.bmd|0x0061E9": "「行くぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x0061FC": "「お願い！」", "Battle/Dat/Battle/Message/038.bmd|0x00620F": "「接近戦なら任せろ！」", "Battle/Dat/Battle/Message/038.bmd|0x006231": "「ええ！」", "Battle/Dat/Battle/Message/038.bmd|0x006241": "「行くぞ、クスハ！」", "Battle/Dat/Battle/Message/038.bmd|0x006260": "「接近戦は俺に任せろ！」", "Battle/Dat/Battle/Message/038.bmd|0x006285": "「奴の相手は俺がする！」", "Battle/Dat/Battle/Message/038.bmd|0x0062AA": "「ここは俺に任せてくれ！」", "Battle/Dat/Battle/Message/038.bmd|0x0062D2": "「先手を取る！　行くぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x0062FA": "「わかったわ！」", "Battle/Dat/Battle/Message/038.bmd|0x006313": "「超機人の力、見せてやる！」", "Battle/Dat/Battle/Message/038.bmd|0x00633E": "「行くぞ、虎龍王！」", "Battle/Dat/Battle/Message/038.bmd|0x00635D": "「虎龍王、見参！」", "Battle/Dat/Battle/Message/038.bmd|0x006379": "「虎龍王が相手だ！」", "Battle/Dat/Battle/Message/038.bmd|0x006398": "「俺達の出番だ、虎龍王！」", "Battle/Dat/Battle/Message/038.bmd|0x0063C0": "「顕現！　最強白虎、虎龍王！」", "Battle/Dat/Battle/Message/038.bmd|0x0063EE": "「行くぞ、Ｍｋ‐Ⅱ！」", "Battle/Dat/Battle/Message/038.bmd|0x006410": "「このＭｋ‐Ⅱなら！」", "Battle/Dat/Battle/Message/038.bmd|0x006432": "「ヒュッケバインのパワーを見せてやる！」", "Battle/Dat/Battle/Message/038.bmd|0x00646F": "「グルンガストの力を、見せてやる！」", "Battle/Dat/Battle/Message/038.bmd|0x0064A6": "「行くぞ、参式！」", "Battle/Dat/Battle/Message/038.bmd|0x0064C2": "「この参式なら！」", "Battle/Dat/Battle/Message/038.bmd|0x0064DE": "「ブーステッド・チルドレンか……！」", "Battle/Dat/Battle/Message/038.bmd|0x006515": "「行くぞ、ドゥバン・オーグ！」", "Battle/Dat/Battle/Message/038.bmd|0x006543": "「あの図体なら、/　スピードはこちらの方が上だ！」", "Battle/Dat/Battle/Message/038.bmd|0x00658D": "「この世界を、お前一人で支配するなどと！」", "Battle/Dat/Battle/Message/038.bmd|0x0065CD": "「お前の暴走は、俺達の手で止めてやる！」", "Battle/Dat/Battle/Message/038.bmd|0x00660A": "「お前のせいで、俺達は濡れ衣を！」", "Battle/Dat/Battle/Message/038.bmd|0x00663E": "「アルテウル！/　お前を倒し、汚名を返上する！」", "Battle/Dat/Battle/Message/038.bmd|0x006685": "「行くぞ、ジョグ！」", "Battle/Dat/Battle/Message/038.bmd|0x0066A4": "「コンピューターの疑似人格か……！」", "Battle/Dat/Battle/Message/038.bmd|0x0066DB": "「カークス将軍！　その野心は危険だ！」", "Battle/Dat/Battle/Message/038.bmd|0x006715": "「行くぞ、アーマラ！」", "Battle/Dat/Battle/Message/038.bmd|0x006737": "「メリオルエッセ！　先手はもらうぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x006771": "「相手がメリオルエッセなら、/　退くわけにはいかない！」", "Battle/Dat/Battle/Message/038.bmd|0x0067C4": "「行くぞ、アクイラ！」", "Battle/Dat/Battle/Message/038.bmd|0x0067E6": "「勝負だ、イグニス！」", "Battle/Dat/Battle/Message/038.bmd|0x006808": "「あいつは他の/　メリオルエッセとは違う……！？」", "Battle/Dat/Battle/Message/038.bmd|0x006852": "「あのメリオルエッセは……！」", "Battle/Dat/Battle/Message/038.bmd|0x006880": "「コンターギオ！/　お前の好きにはやらせない！」", "Battle/Dat/Battle/Message/038.bmd|0x0068C7": "「ウンブラ、お前が何を言おうと！」", "Battle/Dat/Battle/Message/038.bmd|0x0068FB": "「遺跡へ還れ、ペルフェクティオ！」", "Battle/Dat/Battle/Message/038.bmd|0x00692F": "「お前を倒し、門を閉じる！」", "Battle/Dat/Battle/Message/038.bmd|0x00695A": "「ゲストの指揮官機か……！」", "Battle/Dat/Battle/Message/038.bmd|0x006985": "「指揮官機を落とせば！」", "Battle/Dat/Battle/Message/038.bmd|0x0069AA": "「ゼゼーナン！　お前の企みを打ち砕く！」", "Battle/Dat/Battle/Message/038.bmd|0x0069E7": "「超機人は、人界を守る存在じゃないのか！」", "Battle/Dat/Battle/Message/038.bmd|0x006A27": "「夏喃、お前の導きなど不要だ！」", "Battle/Dat/Battle/Message/038.bmd|0x006A58": "「夏喃、クスハに手出しはさせない！」", "Battle/Dat/Battle/Message/038.bmd|0x006A8F": "「行くぞ、夏喃！」", "Battle/Dat/Battle/Message/038.bmd|0x006AAB": "「勝負だ、泰北！！」", "Battle/Dat/Battle/Message/038.bmd|0x006ACA": "「行くぞ、ククル！」", "Battle/Dat/Battle/Message/038.bmd|0x006AE9": "「マガルガの動きに惑わされるものか！」", "Battle/Dat/Battle/Message/038.bmd|0x006B23": "「こんな所にまであいつらが……/　いや、お互い様か」", "Battle/Dat/Battle/Message/038.bmd|0x006B70": "「ノイエＤＣの残党……こうなると腐れ縁だな」", "Battle/Dat/Battle/Message/038.bmd|0x006BB3": "「ガイアセイバーズ！/　お前達に屈するものか！」", "Battle/Dat/Battle/Message/038.bmd|0x006BFA": "「汚名は必ず返上してみせる！」", "Battle/Dat/Battle/Message/038.bmd|0x006C28": "「行くぞ、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/038.bmd|0x006C56": "「お前達が地球の守護者などと！」", "Battle/Dat/Battle/Message/038.bmd|0x006C87": "「コックピットは狙えない…！」", "Battle/Dat/Battle/Message/038.bmd|0x006CB5": "「コックピットは外さなければ…！」", "Battle/Dat/Battle/Message/038.bmd|0x006CE9": "「相手はダブルＧの新型か！」", "Battle/Dat/Battle/Message/038.bmd|0x006D14": "「行くぞ、ジンライ！」", "Battle/Dat/Battle/Message/038.bmd|0x006D36": "「ジンライより先に踏み込まなければ……！」", "Battle/Dat/Battle/Message/038.bmd|0x006D76": "「量産型のジンライか！」", "Battle/Dat/Battle/Message/038.bmd|0x006D9B": "「行くぞ、メディウス・ロクス！」", "Battle/Dat/Battle/Message/038.bmd|0x006DCC": "「目的が何だろうと、正攻法で仕掛ける！」", "Battle/Dat/Battle/Message/038.bmd|0x006E09": "「どこへ行き着くつもりなんだ、あの機体は！」", "Battle/Dat/Battle/Message/038.bmd|0x006E4C": "「メディウスがどう進化しようと！」", "Battle/Dat/Battle/Message/038.bmd|0x006E80": "「あいつが指揮官機か！」", "Battle/Dat/Battle/Message/038.bmd|0x006EA5": "「行くぞ、エグレッタ！」", "Battle/Dat/Battle/Message/038.bmd|0x006ECA": "「あいつも凶鳥の眷属だと言うのか……！」", "Battle/Dat/Battle/Message/038.bmd|0x006F07": "「超魔装機……いざ勝負！」", "Battle/Dat/Battle/Message/038.bmd|0x006F2F": "「相手が超魔装機でも！」", "Battle/Dat/Battle/Message/038.bmd|0x006F54": "「あの魔装機は俺が引き受ける！」", "Battle/Dat/Battle/Message/038.bmd|0x006F85": "「魔装機……後手に回るわけにはいかない！」", "Battle/Dat/Battle/Message/038.bmd|0x006FC5": "「デモンゴーレムに手間取るわけには！」", "Battle/Dat/Battle/Message/038.bmd|0x006FFF": "「デモンゴーレム……さっさと退治してやる！」", "Battle/Dat/Battle/Message/038.bmd|0x007042": "「土に還れ、デモンゴーレム！」", "Battle/Dat/Battle/Message/038.bmd|0x007070": "「行くぞ、ヴォルクルス！」", "Battle/Dat/Battle/Message/038.bmd|0x007098": "「あんな怪物を野放しにするわけにいくか！」", "Battle/Dat/Battle/Message/038.bmd|0x0070D8": "「ルイーナ機を排除する！」", "Battle/Dat/Battle/Message/038.bmd|0x007100": "「ルイーナめ、これ以上はやらせない！」", "Battle/Dat/Battle/Message/038.bmd|0x00713A": "「行くぞ、ルイーナ！」", "Battle/Dat/Battle/Message/038.bmd|0x00715C": "「ここでルイーナを食い止める！」", "Battle/Dat/Battle/Message/038.bmd|0x00718D": "「ツェントル・プロジェクトの/　最終機と言えども！」", "Battle/Dat/Battle/Message/038.bmd|0x0071DA": "「奴がＭＯＤＥＬ‐Ｘ……！」", "Battle/Dat/Battle/Message/038.bmd|0x007205": "「あれに取り込まれるわけにはいかない！」", "Battle/Dat/Battle/Message/038.bmd|0x007242": "「エルデ・ミッテ！/　お前の欲望に他人を巻き込むな！」", "Battle/Dat/Battle/Message/038.bmd|0x007292": "「エルデの邪念があの形になったのか……！？」", "Battle/Dat/Battle/Message/038.bmd|0x0072D5": "「お前達が何度地球圏に現れようとも！」", "Battle/Dat/Battle/Message/038.bmd|0x00730F": "「ゲスト機を撃破する！」", "Battle/Dat/Battle/Message/038.bmd|0x007334": "「ゲストの好きにはやらせない！」"}