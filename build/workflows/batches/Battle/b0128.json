{"Battle/Dat/Battle/Message/063.bmd|0x00F4B5": "「ベガリオンとアルテリオンの連携で！」", "Battle/Dat/Battle/Message/063.bmd|0x00F4EF": "「あたしだってカバーぐらいは！」", "Battle/Dat/Battle/Message/063.bmd|0x00F520": "「今の内に下がって！」", "Battle/Dat/Battle/Message/063.bmd|0x00F542": "「大丈夫！　歯を食いしばって耐えてみせる！」", "Battle/Dat/Battle/Message/063.bmd|0x00F585": "「受け止めてみせる！」", "Battle/Dat/Battle/Message/063.bmd|0x00F5A7": "「牽制ぐらいなら、あたしだって！」", "Battle/Dat/Battle/Message/063.bmd|0x00F5DB": "「スレイ！　あんたらしくないよ！」", "Battle/Dat/Battle/Message/063.bmd|0x00F60F": "「スレイはやらせないよ！」", "Battle/Dat/Battle/Message/063.bmd|0x00F637": "「あんたはあたしの目標なんだから……！」", "Battle/Dat/Battle/Message/063.bmd|0x00F674": "「下がって、スレイ！」", "Battle/Dat/Battle/Message/063.bmd|0x00F696": "「下がって、リューネ！」", "Battle/Dat/Battle/Message/063.bmd|0x00F6BB": "「突っ込み過ぎだよ、リューネ！」", "Battle/Dat/Battle/Message/063.bmd|0x00F6EC": "「あたしに任せて、レオナ！」", "Battle/Dat/Battle/Message/063.bmd|0x00F717": "「レオナ！　ここは後退して！」", "Battle/Dat/Battle/Message/063.bmd|0x00F745": "「マサキ！　前方不注意だよ！」", "Battle/Dat/Battle/Message/063.bmd|0x00F773": "「サイバスターのスピードが泣くよ、マサキ！」", "Battle/Dat/Battle/Message/063.bmd|0x00F7B6": "「クスハはやらせないよ！」", "Battle/Dat/Battle/Message/063.bmd|0x00F7DE": "「下がってください、レーツェルさん！」", "Battle/Dat/Battle/Message/063.bmd|0x00F818": "「あたしの陰に入って、ラミアさん！」", "Battle/Dat/Battle/Message/063.bmd|0x00F84F": "「迂闊ですよ、カチーナ中尉！」", "Battle/Dat/Battle/Message/063.bmd|0x00F87D": "「あたしの後ろに入って、アラド！」", "Battle/Dat/Battle/Message/063.bmd|0x00F8B1": "「アラド、危ないっ！」", "Battle/Dat/Battle/Message/063.bmd|0x00F8D3": "「アラド、何やってんの！」", "Battle/Dat/Battle/Message/063.bmd|0x00F8FB": "「ゼオラ、突っ込み過ぎだよ！」", "Battle/Dat/Battle/Message/063.bmd|0x00F929": "「ここは任せて、ゼオラ！」", "Battle/Dat/Battle/Message/063.bmd|0x00F951": "「ラトゥーニはやらせない！」", "Battle/Dat/Battle/Message/063.bmd|0x00F97C": "「急ぎ過ぎだよ、ラトゥーニ！」", "Battle/Dat/Battle/Message/063.bmd|0x00F9AA": "「ヒューゴ、後退して！」", "Battle/Dat/Battle/Message/063.bmd|0x00F9CF": "「下がって、アクア！」", "Battle/Dat/Battle/Message/063.bmd|0x00F9F1": "「ジョッシュ、あんたらしくないね！」", "Battle/Dat/Battle/Message/063.bmd|0x00FA28": "「リム、早く逃げて！」", "Battle/Dat/Battle/Message/063.bmd|0x00FA4A": "「先生、無茶しないでください！」", "Battle/Dat/Battle/Message/063.bmd|0x00FA7B": "「イング、後退して！」", "Battle/Dat/Battle/Message/063.bmd|0x00FA9D": "「テュッティさんをやらせるもんか！」", "Battle/Dat/Battle/Message/063.bmd|0x00FAD4": "「フィリオの造った機体……やらせないよ！」", "Battle/Dat/Battle/Message/063.bmd|0x00FB14": "「エクサランスは落とさせないよ！」", "Battle/Dat/Battle/Message/063.bmd|0x00FB48": "「だから合体するって言ったのに！」", "Battle/Dat/Battle/Message/063.bmd|0x00FB7C": "「もう一度アプローチを！」", "Battle/Dat/Battle/Message/063.bmd|0x00FBA4": "「まだいけるわ！　アイビス！」", "Battle/Dat/Battle/Message/063.bmd|0x00FBD2": "「逃がしはしない！」", "Battle/Dat/Battle/Message/063.bmd|0x00FBF1": "「データ・リロード！　追撃を！」", "Battle/Dat/Battle/Message/063.bmd|0x00FC22": "「今度こそ仕留める！」", "Battle/Dat/Battle/Message/063.bmd|0x00FC44": "「ミサイル！　当たれっ！」", "Battle/Dat/Battle/Message/063.bmd|0x00FC6C": "「これで決める！」", "Battle/Dat/Battle/Message/063.bmd|0x00FC88": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/063.bmd|0x00FCAD": "「当たれーっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x00FCC9": "「ＧＧシステム・セット……ゴーッ！」", "Battle/Dat/Battle/Message/063.bmd|0x00FD00": "「グラビティ・ガイダンス・セットＯＫ！」", "Battle/Dat/Battle/Message/063.bmd|0x00FD3D": "「ＧＧキャノン・ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x00FD68": "「０７スタンバイ！」", "Battle/Dat/Battle/Message/063.bmd|0x00FD87": "「行けーっ！　プロミネンス、ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x00FDC4": "「０７、スタンバイ！」", "Battle/Dat/Battle/Message/063.bmd|0x00FDE6": "「プロミネンス、ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x00FE11": "「ここは０７で！」", "Battle/Dat/Battle/Message/063.bmd|0x00FE2D": "「了解！　当たれーっ！」", "Battle/Dat/Battle/Message/063.bmd|0x00FE52": "「０７、セット！」", "Battle/Dat/Battle/Message/063.bmd|0x00FE6E": "「ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x00FE84": "「相対速度、距離算出！　データ・ロード！」", "Battle/Dat/Battle/Message/063.bmd|0x00FEC4": "「Ｇドライバー、当たれーっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x00FEF5": "「ドライバーで行く！　照準補正を！」", "Battle/Dat/Battle/Message/063.bmd|0x00FF2C": "「今よ、アイビス！」", "Battle/Dat/Battle/Message/063.bmd|0x00FF4B": "「Ｇドライバー、シュートッ！！」", "Battle/Dat/Battle/Message/063.bmd|0x00FF7C": "「ここは弾速の速いドライバーで！」", "Battle/Dat/Battle/Message/063.bmd|0x00FFB0": "「捉えたよっ！」", "Battle/Dat/Battle/Message/063.bmd|0x00FFC9": "「Ｇドライバー！　行けーっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x00FFFA": "「ツグミ、ＧＲａＭＸｓで行く！」", "Battle/Dat/Battle/Message/063.bmd|0x01002B": "「了解！/　テスラ・ドライブ、オールグリーン！」", "Battle/Dat/Battle/Message/063.bmd|0x010072": "「０２、０７！　ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x01009D": "「ツグミ、行くよ！」", "Battle/Dat/Battle/Message/063.bmd|0x0100BC": "「Ｇドライバー！　そこだ！」", "Battle/Dat/Battle/Message/063.bmd|0x0100E7": "「今よ！！」", "Battle/Dat/Battle/Message/063.bmd|0x0100FA": "「フル・ブーストッ！！」", "Battle/Dat/Battle/Message/063.bmd|0x01011F": "「行けぇぇぇぇぇっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010144": "「ブレイクフィールド収束！」", "Battle/Dat/Battle/Message/063.bmd|0x01016F": "「セイバー、ゴーッ！」", "Battle/Dat/Battle/Message/063.bmd|0x010191": "「接近戦に弱気は禁物よ！」", "Battle/Dat/Battle/Message/063.bmd|0x0101B9": "「あたしだって、やってみせる！」", "Battle/Dat/Battle/Message/063.bmd|0x0101EA": "「セイバー、セット！　ゴーッ！」", "Battle/Dat/Battle/Message/063.bmd|0x01021B": "「このぉぉっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010237": "「接近戦に持ち込む！」", "Battle/Dat/Battle/Message/063.bmd|0x010259": "「ソニック・セイバー！！」", "Battle/Dat/Battle/Message/063.bmd|0x010281": "「０２セット……ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x0102AC": "「０２、セット！　ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x0102DA": "「スピキュール、ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x010305": "「スピキュール、セット！　ゴーッ！」", "Battle/Dat/Battle/Message/063.bmd|0x01033C": "「相対速度、距離算出！」", "Battle/Dat/Battle/Message/063.bmd|0x010361": "「ＧＧキャノン、ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x01038C": "「セイバーセット！　ゴーッ！」", "Battle/Dat/Battle/Message/063.bmd|0x0103BA": "「ソニック・セイバーで行く！」", "Battle/Dat/Battle/Message/063.bmd|0x0103E8": "「ブーストのタイミングは任せろ！」", "Battle/Dat/Battle/Message/063.bmd|0x01041C": "「ええーいっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010438": "「プレアディス、ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x010463": "「０５、セット……ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x010491": "「スレイ！　０２よ！」", "Battle/Dat/Battle/Message/063.bmd|0x0104B3": "「お前に言われるまでもない！」", "Battle/Dat/Battle/Message/063.bmd|0x0104E1": "「Ｘコンビネーションで行く！」", "Battle/Dat/Battle/Message/063.bmd|0x01050F": "「敵機は完全に追い込んだ！」", "Battle/Dat/Battle/Message/063.bmd|0x01053A": "「アイビス！」", "Battle/Dat/Battle/Message/063.bmd|0x010550": "「決めろ！」", "Battle/Dat/Battle/Message/063.bmd|0x010563": "「Ｘコンビネーション！　シュートッ！！」", "Battle/Dat/Battle/Message/063.bmd|0x0105A0": "「今だ、セイファートを使え！」", "Battle/Dat/Battle/Message/063.bmd|0x0105CE": "「０９、ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x0105ED": "「サイズに見合うだけの威力はある！」", "Battle/Dat/Battle/Message/063.bmd|0x010624": "「セイファート、ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x01064F": "「ツグミ、スレイ！　ＧＲａＭＸｓで行く！」", "Battle/Dat/Battle/Message/063.bmd|0x01068F": "「サイト・オン！」", "Battle/Dat/Battle/Message/063.bmd|0x0106AB": "「ファイヤリング・ロック、オープン！」", "Battle/Dat/Battle/Message/063.bmd|0x0106E5": "「全て叩き込む！」", "Battle/Dat/Battle/Message/063.bmd|0x010701": "「パージ！」", "Battle/Dat/Battle/Message/063.bmd|0x010714": "「ブレイク・フィールド！！」", "Battle/Dat/Battle/Message/063.bmd|0x01073F": "「遅れるな、アイビス！」", "Battle/Dat/Battle/Message/063.bmd|0x010764": "「そっちこそ！」", "Battle/Dat/Battle/Message/063.bmd|0x01077D": "「ツグミ、スレイ！/　あたし達の力を一つにする！」", "Battle/Dat/Battle/Message/063.bmd|0x0107C7": "「アルテリオン、流星となって飛べ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010801": "「もう逃げられんぞ！」", "Battle/Dat/Battle/Message/063.bmd|0x010823": "「タイミングを合わせろ！」", "Battle/Dat/Battle/Message/063.bmd|0x01084B": "「了解！　行けぇぇぇっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010876": "「これで！」", "Battle/Dat/Battle/Message/063.bmd|0x010889": "「決める！」", "Battle/Dat/Battle/Message/063.bmd|0x01089C": "「行けぇっ！」"}