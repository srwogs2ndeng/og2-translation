{"Battle/Dat/Battle/Message/060.bmd|0x00C27E": "「化け物と遊んでる暇はねえ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C2AC": "「妖機人なんぞにやられるかよ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C2DD": "「お前なんかに狩られてたまるかってんだ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C31D": "「ルイーナにやられてたまるか！」", "Battle/Dat/Battle/Message/060.bmd|0x00C34E": "「ルイーナなんざ怖くねえぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C37C": "「さっさと自分の星に帰れってんだ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C3B3": "「よし、上手くいった！」", "Battle/Dat/Battle/Message/060.bmd|0x00C3D8": "「ヘヘッ！/　あさって……もとい、おととい来やがれってんだ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C434": "「このまま振り切ってやる！」", "Battle/Dat/Battle/Message/060.bmd|0x00C45F": "「土壇場でかわせたか……！」", "Battle/Dat/Battle/Message/060.bmd|0x00C48A": "「よし！　今のパターンは使えるぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C4C1": "「いいトコ狙ってきたなぁ……」", "Battle/Dat/Battle/Message/060.bmd|0x00C4EF": "「ヘッ、アルトの爆発力を甘く見るなよ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C52C": "「さっすがファルケン、/　いい回避パターンが入ってるぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C582": "「助かったぜ、ヒュッケバイン！」", "Battle/Dat/Battle/Message/060.bmd|0x00C5B3": "「備えあれば、嬉しいなっと！」", "Battle/Dat/Battle/Message/060.bmd|0x00C5E1": "「防ぎきってくれよっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00C609": "「ミサイルなら無駄だぜっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00C637": "「わわっ！　悪霊退散、ミサイル退散っ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00C677": "「ミサイル、邪魔っ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C699": "「………」", "Battle/Dat/Battle/Message/060.bmd|0x00C6A9": "「し、しまった！/　いつものクセでつい……！」", "Battle/Dat/Battle/Message/060.bmd|0x00C6ED": "「ご、五里夢中って奴か！？/　……なんか違うな」", "Battle/Dat/Battle/Message/060.bmd|0x00C734": "「わわっ！　ちょっとタンマ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00C765": "「出番と敵を逃がしてたまるか！」", "Battle/Dat/Battle/Message/060.bmd|0x00C796": "「呼ばれて飛び出て何とやら！」", "Battle/Dat/Battle/Message/060.bmd|0x00C7C4": "「よし、ピンチだっ！/　もとい、チャンスだっ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C80B": "「頼むから、味方に当たるなよ……！」", "Battle/Dat/Battle/Message/060.bmd|0x00C842": "「ゼオラ、ドンピシャだぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C86D": "「フォーメーションＩだな、ゼオラ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C8A4": "「おれ達のコンビネーション、見せてやるぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C8E7": "「あいつの尻に/　敷かれてるわけじゃねえからなっ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C934": "「分の悪い賭け、おれも乗るッス！」", "Battle/Dat/Battle/Message/060.bmd|0x00C968": "「これでおれもＡＴＸチーム入りだっ！」", "Battle/Dat/Battle/Message/060.bmd|0x00C9A2": "「エクセレン少尉、/　こっちもびっちりばっちりッス！」", "Battle/Dat/Battle/Message/060.bmd|0x00C9F2": "「少尉、おれも突っ込むッス！」", "Battle/Dat/Battle/Message/060.bmd|0x00CA20": "「ラト、後は任せろ！　ちゃんとやるから！」", "Battle/Dat/Battle/Message/060.bmd|0x00CA60": "「ラト、おれを信じて先に行け！」", "Battle/Dat/Battle/Message/060.bmd|0x00CA91": "「ラト、呼ばれてないけど手伝いに来たぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00CAD1": "「ここはおれが締めるぜ、ラト！」", "Battle/Dat/Battle/Message/060.bmd|0x00CB02": "「ユウキ少尉、おれも行きます！」", "Battle/Dat/Battle/Message/060.bmd|0x00CB33": "「待って下さいよ！　リルカーラ少尉！」", "Battle/Dat/Battle/Message/060.bmd|0x00CB6D": "「タスク少尉！　ツッコミ二番手、いきます！」", "Battle/Dat/Battle/Message/060.bmd|0x00CBB0": "「カイ少佐！　おれ、ちゃんとやりますから！」", "Battle/Dat/Battle/Message/060.bmd|0x00CBF3": "「ここは突っ込んでいいんスよね、少佐！」", "Battle/Dat/Battle/Message/060.bmd|0x00CC30": "「援護ッスか！？　よーがす！」", "Battle/Dat/Battle/Message/060.bmd|0x00CC5E": "「ラミア少尉、援護しますです！」", "Battle/Dat/Battle/Message/060.bmd|0x00CC8F": "「ラミア少尉、こっちからも突っ込みます！」", "Battle/Dat/Battle/Message/060.bmd|0x00CCCF": "「王女さん、/　ラトの代わりにおれが手伝うッス！」", "Battle/Dat/Battle/Message/060.bmd|0x00CD19": "「シャイン王女、援護するッス！」", "Battle/Dat/Battle/Message/060.bmd|0x00CD4A": "「マイ、こっちからも行くぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00CD78": "「コウタ！　手伝うって言っただろ！」", "Battle/Dat/Battle/Message/060.bmd|0x00CDAF": "「ラウルさん、続けて行くッス！」", "Battle/Dat/Battle/Message/060.bmd|0x00CDE0": "「フィオナさん、後はお任せッス！」", "Battle/Dat/Battle/Message/060.bmd|0x00CE14": "「ヒューゴ少尉、援護します！」", "Battle/Dat/Battle/Message/060.bmd|0x00CE42": "「ヒューゴ少尉に続くぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00CE6A": "「アクア少尉、後はおれが！」", "Battle/Dat/Battle/Message/060.bmd|0x00CE95": "「援護します、アクア少尉！」", "Battle/Dat/Battle/Message/060.bmd|0x00CEC0": "「ジョッシュさん、援護します！」", "Battle/Dat/Battle/Message/060.bmd|0x00CEF1": "「ジョッシュさん、後はおれが！」", "Battle/Dat/Battle/Message/060.bmd|0x00CF22": "「リム、後は任せろ！」", "Battle/Dat/Battle/Message/060.bmd|0x00CF44": "「リム、手を貸すぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00CF66": "「手伝うぜ、ミオ！」", "Battle/Dat/Battle/Message/060.bmd|0x00CF85": "「アリエイル、援護するぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00CFB0": "「アリエイル、後は引き受けた！」", "Battle/Dat/Battle/Message/060.bmd|0x00CFE1": "「トウマさん、後はおれが！」", "Battle/Dat/Battle/Message/060.bmd|0x00D00C": "「イング、援護するぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D031": "「ショウコ、後は任せろ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D059": "「ミチルさん、手伝うッス！」", "Battle/Dat/Battle/Message/060.bmd|0x00D084": "「アルト譲りの突進力、見せてやるぜっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00D0C4": "「ＡＴＸ計画コンボ、行くぜぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00D0FB": "「出番と味方を失ってたまるか！」", "Battle/Dat/Battle/Message/060.bmd|0x00D12C": "「打たれ強さにゃ、自信があるんだ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D163": "「縦になる！　いや、盾になるっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00D19A": "「守ってみせる！　必ず！！」", "Battle/Dat/Battle/Message/060.bmd|0x00D1C5": "「ゼオラはおれが守る……！」", "Battle/Dat/Battle/Message/060.bmd|0x00D1F0": "「ゼオラ！　お前との約束、守ってみせるっ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D233": "「ゼオラ！　早く下がれっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00D261": "「ゼオラに手を出すな！　後でうるせえぞ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00D2A4": "「キョウスケ中尉、/　装甲はこっちの方が上ッス！　多分！」", "Battle/Dat/Battle/Message/060.bmd|0x00D2FA": "「エクセレン少尉、/　蝶のように逃げちゃって下さい！」", "Battle/Dat/Battle/Message/060.bmd|0x00D34A": "「踏み込み過ぎッスよ、少尉！」", "Battle/Dat/Battle/Message/060.bmd|0x00D378": "「ラト、こういう時は頼ってくれよな！」", "Battle/Dat/Battle/Message/060.bmd|0x00D3B2": "「ラトをやらせはしねえぞ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D3DD": "「ここはおれに任せろ、ラト！」", "Battle/Dat/Battle/Message/060.bmd|0x00D40B": "「ここはおれの出番ッスよ、ユウキ少尉！」", "Battle/Dat/Battle/Message/060.bmd|0x00D448": "「無茶ッスよ、リルカーラ少尉！」", "Battle/Dat/Battle/Message/060.bmd|0x00D479": "「すみません、タスク少尉！/　ツッコミ入れます！」", "Battle/Dat/Battle/Message/060.bmd|0x00D4C3": "「カイ少佐！　頑丈なのが取り柄ッスから！」", "Battle/Dat/Battle/Message/060.bmd|0x00D503": "「ラーダさん、早いとこ逃げて下さい！」", "Battle/Dat/Battle/Message/060.bmd|0x00D53D": "「ラミア少尉！　ここはおれが！」", "Battle/Dat/Battle/Message/060.bmd|0x00D56E": "「シャイン王女、早く逃げるッス！」", "Battle/Dat/Battle/Message/060.bmd|0x00D5A2": "「ロイヤルガードだ！　いっけぇ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D5D6": "「マイ、無理すんな！」", "Battle/Dat/Battle/Message/060.bmd|0x00D5F8": "「コウタ！　おれが言うのも何だが、/　無茶は禁物だぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D64B": "「ラウルさん、危ないっ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D673": "「フィオナさん、早く逃げて！」", "Battle/Dat/Battle/Message/060.bmd|0x00D6A1": "「ヒューゴ少尉、危ない！」", "Battle/Dat/Battle/Message/060.bmd|0x00D6C9": "「アクア少尉、ここはおれが！」", "Battle/Dat/Battle/Message/060.bmd|0x00D6F7": "「ジョッシュさん、今の内に！」", "Battle/Dat/Battle/Message/060.bmd|0x00D725": "「リム、ここはおれが！」", "Battle/Dat/Battle/Message/060.bmd|0x00D74A": "「下がれ、アリエイル！」", "Battle/Dat/Battle/Message/060.bmd|0x00D76F": "「トウマさん、今の内に！」", "Battle/Dat/Battle/Message/060.bmd|0x00D797": "「イング、早く逃げろ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D7BC": "「ショウコ、ここはおれが！」", "Battle/Dat/Battle/Message/060.bmd|0x00D7E7": "「ミチルさん、ヤバいッスよ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D815": "「ラウンド２だ！　行くぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D840": "「こいつも持ってけってんだ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D86E": "「このチャンス、物にするぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D89C": "「このおっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00D8B5": "「いっけぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00D8D1": "「スプリットミサイル！　くらいやがれっ！」", "Battle/Dat/Battle/Message/060.bmd|0x00D911": "「それ行けぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00D930": "「スピードに乗せて……斬るっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00D964": "「アルブレード必殺！」", "Battle/Dat/Battle/Message/060.bmd|0x00D986": "「ブレード・トンファー！！」", "Battle/Dat/Battle/Message/060.bmd|0x00D9B1": "「こいつはおれ向きの機体！」", "Battle/Dat/Battle/Message/060.bmd|0x00D9DC": "「そして、おれ向きの武器！」", "Battle/Dat/Battle/Message/060.bmd|0x00DA07": "「うおおおおっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DA26": "「相性はバッチリだぜぇっ！！」"}