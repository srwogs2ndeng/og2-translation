{"Battle/Dat/Battle/Message/162.bmd|0x002FEB": "「当たっただけだ！」", "Battle/Dat/Battle/Message/162.bmd|0x00300A": "「こんなもの、ダメージの内に入らん！」", "Battle/Dat/Battle/Message/162.bmd|0x003044": "「ふん、それがどうしたと言うのだ！」", "Battle/Dat/Battle/Message/162.bmd|0x00307B": "「何の、かすっただけだ！」", "Battle/Dat/Battle/Message/162.bmd|0x0030A3": "「それで我らを止める気か！」", "Battle/Dat/Battle/Message/162.bmd|0x0030CE": "「我らシュテドニアスを/　甘く見てもらっては困る！」", "Battle/Dat/Battle/Message/162.bmd|0x00311B": "「地上人め、やるな！」", "Battle/Dat/Battle/Message/162.bmd|0x00313D": "「調子に乗るなよ、地上人！」", "Battle/Dat/Battle/Message/162.bmd|0x003168": "「ふん、地上では/　それで通用していたのかも知れんが……」", "Battle/Dat/Battle/Message/162.bmd|0x0031BE": "「ハッ！　スピードだけか、サイバスター！」", "Battle/Dat/Battle/Message/162.bmd|0x0031FE": "「サイバスター……噂ほどではないな」", "Battle/Dat/Battle/Message/162.bmd|0x003235": "「大したことはないな、魔装機神も」", "Battle/Dat/Battle/Message/162.bmd|0x003269": "「いける！　これなら魔装機神と戦えるぞ！」", "Battle/Dat/Battle/Message/162.bmd|0x0032A9": "「グランヴェール……そんなものか」", "Battle/Dat/Battle/Message/162.bmd|0x0032DD": "「グランヴェール、思っていたほどではないな」", "Battle/Dat/Battle/Message/162.bmd|0x003320": "「その程度か、ガッデスは！」", "Battle/Dat/Battle/Message/162.bmd|0x00334B": "「ふん、ガッデスは非力だな！」", "Battle/Dat/Battle/Message/162.bmd|0x003379": "「なんのっ！」", "Battle/Dat/Battle/Message/162.bmd|0x00338F": "「当たるか！」", "Battle/Dat/Battle/Message/162.bmd|0x0033A5": "「遅い！」", "Battle/Dat/Battle/Message/162.bmd|0x0033B5": "「甘いな！」", "Battle/Dat/Battle/Message/162.bmd|0x0033C8": "「そんなものか、地上人！」", "Battle/Dat/Battle/Message/162.bmd|0x0033F0": "「魔装機神と言っても、大したことはないな」", "Battle/Dat/Battle/Message/162.bmd|0x003430": "「無駄だっ！」", "Battle/Dat/Battle/Message/162.bmd|0x003446": "「効くものか！」", "Battle/Dat/Battle/Message/162.bmd|0x00345F": "「そんなもの！」", "Battle/Dat/Battle/Message/162.bmd|0x003478": "「………」", "Battle/Dat/Battle/Message/162.bmd|0x003488": "「弾切れだと！？」", "Battle/Dat/Battle/Message/162.bmd|0x0034A4": "「反撃できんとは！」", "Battle/Dat/Battle/Message/162.bmd|0x0034C3": "「くっ、これでは！」", "Battle/Dat/Battle/Message/162.bmd|0x0034E2": "「いったん後退するしかないか……！」", "Battle/Dat/Battle/Message/162.bmd|0x003519": "「奴め、どこへ行った！？」", "Battle/Dat/Battle/Message/162.bmd|0x003541": "「ちっ、見失うとは！」", "Battle/Dat/Battle/Message/162.bmd|0x003563": "「くっ、逃げ足の速い奴め……！」", "Battle/Dat/Battle/Message/162.bmd|0x003594": "「死角に入られたか！」", "Battle/Dat/Battle/Message/162.bmd|0x0035B6": "「援護する！」", "Battle/Dat/Battle/Message/162.bmd|0x0035CC": "「後に続くぞ！」", "Battle/Dat/Battle/Message/162.bmd|0x0035E5": "「後は任せろ！」", "Battle/Dat/Battle/Message/162.bmd|0x0035FE": "「いける！　もう一撃！」", "Battle/Dat/Battle/Message/162.bmd|0x003623": "「やらせん！」", "Battle/Dat/Battle/Message/162.bmd|0x003639": "「させるかっ！」", "Battle/Dat/Battle/Message/162.bmd|0x003652": "「ここは引き受ける！」", "Battle/Dat/Battle/Message/162.bmd|0x003674": "「覚悟してもらおうか！」", "Battle/Dat/Battle/Message/162.bmd|0x003699": "「まだだ！　もう一撃！」", "Battle/Dat/Battle/Message/162.bmd|0x0036BE": "「まだ終わりじゃないぞ！」", "Battle/Dat/Battle/Message/162.bmd|0x0036E6": "「まだまだっ！」", "Battle/Dat/Battle/Message/162.bmd|0x0036FF": "「もらう！」", "Battle/Dat/Battle/Message/162.bmd|0x003712": "「こいつをくらえ！」", "Battle/Dat/Battle/Message/162.bmd|0x003731": "「くらえ！」", "Battle/Dat/Battle/Message/162.bmd|0x003744": "「受けろ！」", "Battle/Dat/Battle/Message/162.bmd|0x003757": "「そこだ！」", "Battle/Dat/Battle/Message/162.bmd|0x00376A": "「落ちろ！」", "Battle/Dat/Battle/Message/162.bmd|0x00377D": "「はあっ！」", "Battle/Dat/Battle/Message/162.bmd|0x003790": "「おりゃあ！」", "Battle/Dat/Battle/Message/162.bmd|0x0037A6": "「たああっ！」", "Battle/Dat/Battle/Message/162.bmd|0x0037BC": "「むんっ！」", "Battle/Dat/Battle/Message/162.bmd|0x0037CF": "「当ててやる！」", "Battle/Dat/Battle/Message/162.bmd|0x0037E8": "「機銃座、撃ち方始め！」", "Battle/Dat/Battle/Message/162.bmd|0x00380D": "「対空機銃、撃て！」", "Battle/Dat/Battle/Message/162.bmd|0x00382C": "「高射砲、発射用意！　撃て！」", "Battle/Dat/Battle/Message/162.bmd|0x00385A": "「高射砲、１番、２番！　撃て！」", "Battle/Dat/Battle/Message/162.bmd|0x00388B": "「前部全砲塔、発射用意！　撃て！」", "Battle/Dat/Battle/Message/162.bmd|0x0038BF": "「前部砲塔、一斉射撃！　撃て！」", "Battle/Dat/Battle/Message/162.bmd|0x0038F0": "「バリオン・ビーム砲、発射用意！」", "Battle/Dat/Battle/Message/162.bmd|0x003924": "「撃て！」", "Battle/Dat/Battle/Message/162.bmd|0x003934": "「主砲、発射用意！」", "Battle/Dat/Battle/Message/163.bmd|0x000D78": "「俺に会ったのが運の尽きよ！」", "Battle/Dat/Battle/Message/163.bmd|0x000DA6": "「狙った獲物は逃がさねえ！」", "Battle/Dat/Battle/Message/163.bmd|0x000DD1": "「さくっと狩ってやるぜ！」", "Battle/Dat/Battle/Message/163.bmd|0x000DF9": "「地上人め、覚悟しやがれ！」", "Battle/Dat/Battle/Message/163.bmd|0x000E24": "「もらったぜ、地上人！」", "Battle/Dat/Battle/Message/163.bmd|0x000E49": "「地上のメカなんぞに！」", "Battle/Dat/Battle/Message/163.bmd|0x000E6E": "「こいつはお宝だぜ！　この俺がもらった！」", "Battle/Dat/Battle/Message/163.bmd|0x000EAE": "「ハハッ、極上の獲物じゃねえか！」", "Battle/Dat/Battle/Message/163.bmd|0x000EE2": "「やりやがったな！」", "Battle/Dat/Battle/Message/163.bmd|0x000F01": "「お返しだぜ！」", "Battle/Dat/Battle/Message/163.bmd|0x000F1A": "「ただで帰すかよ！」", "Battle/Dat/Battle/Message/163.bmd|0x000F39": "「今度は俺の番だ！」", "Battle/Dat/Battle/Message/163.bmd|0x000F58": "「や、やられちまった！」", "Battle/Dat/Battle/Message/163.bmd|0x000F7D": "「お、覚えてろよ！！」", "Battle/Dat/Battle/Message/163.bmd|0x000F9F": "「くそっ！　ここまでかよ！！」", "Battle/Dat/Battle/Message/163.bmd|0x000FCD": "「これ以上は無理だ！　ずらかるぜ！！」", "Battle/Dat/Battle/Message/163.bmd|0x001007": "「お、俺の出番はここまでか！？」", "Battle/Dat/Battle/Message/163.bmd|0x001038": "「ま、待て！　ちょっと待ってくれ！！」", "Battle/Dat/Battle/Message/163.bmd|0x001072": "「うわああっ！　な、何て奴だ！！」", "Battle/Dat/Battle/Message/163.bmd|0x0010A6": "「は、半端じゃねえ……こいつぁヤバいぜ！」", "Battle/Dat/Battle/Message/163.bmd|0x0010E6": "「ち、地上人ってのはこんなに強いのかよ！」", "Battle/Dat/Battle/Message/163.bmd|0x001126": "「うぐっ！　地上人め、やりたい放題かよ！」", "Battle/Dat/Battle/Message/163.bmd|0x001166": "「ううっ……魔装機神に喧嘩を売ったのが/　間違いだったか……！」", "Battle/Dat/Battle/Message/163.bmd|0x0011C5": "「つ、強い！　強過ぎるぜ、魔装機神！」", "Battle/Dat/Battle/Message/163.bmd|0x0011FF": "「や、やってくれるぜ、このっ！」", "Battle/Dat/Battle/Message/163.bmd|0x001230": "「へ、へへへ……それなりに手強いじゃねえか」", "Battle/Dat/Battle/Message/163.bmd|0x001273": "「うおっ！　何だ、こりゃ！？」", "Battle/Dat/Battle/Message/163.bmd|0x0012A1": "「地上人め、やってくれたな！」", "Battle/Dat/Battle/Message/163.bmd|0x0012CF": "「あ、あの地上人、やりやがるぜ！」", "Battle/Dat/Battle/Message/163.bmd|0x001303": "「や、やるじゃねえか、魔装機神め！」", "Battle/Dat/Battle/Message/163.bmd|0x00133A": "「ま、魔装機神……強いな、くそっ！」", "Battle/Dat/Battle/Message/163.bmd|0x001371": "「何だ、そりゃ！？　笑わせんじゃねえよ！」", "Battle/Dat/Battle/Message/163.bmd|0x0013B1": "「何しやがる、この雑魚がっ！」", "Battle/Dat/Battle/Message/163.bmd|0x0013DF": "「おおっと、当ててきやがったか！」", "Battle/Dat/Battle/Message/163.bmd|0x001413": "「地上人め、遊んでるつもりか？」", "Battle/Dat/Battle/Message/163.bmd|0x001444": "「効かねえよ、地上人！」", "Battle/Dat/Battle/Message/163.bmd|0x001469": "「魔装機神ってのも、大したことねえな！」", "Battle/Dat/Battle/Message/163.bmd|0x0014A6": "「魔装機神はそんなもんかよ！/　話になんねえな！」", "Battle/Dat/Battle/Message/163.bmd|0x0014F0": "「当たらねえよ！」", "Battle/Dat/Battle/Message/163.bmd|0x00150C": "「あ、危ねえな……！」", "Battle/Dat/Battle/Message/163.bmd|0x00152E": "「ハッ！　何やってんだ！」", "Battle/Dat/Battle/Message/163.bmd|0x001556": "「………」", "Battle/Dat/Battle/Message/163.bmd|0x001566": "「反撃できねえ！」", "Battle/Dat/Battle/Message/163.bmd|0x001582": "「な、何も出来ねえのかよ！」", "Battle/Dat/Battle/Message/163.bmd|0x0015AD": "「ええい、あいつの方が一枚上手か！」", "Battle/Dat/Battle/Message/163.bmd|0x0015E4": "「やり返せねえってのかよ！」", "Battle/Dat/Battle/Message/163.bmd|0x00160F": "「ついでだ、俺も！」", "Battle/Dat/Battle/Message/163.bmd|0x00162E": "「そいつは俺の獲物だ！」", "Battle/Dat/Battle/Message/163.bmd|0x001653": "「助けてやるぜ！」", "Battle/Dat/Battle/Message/163.bmd|0x00166F": "「させるかよっ！」", "Battle/Dat/Battle/Message/163.bmd|0x00168B": "「ほらよ！　こいつはサービスだ！」", "Battle/Dat/Battle/Message/163.bmd|0x0016BF": "「そこだ！」", "Battle/Dat/Battle/Message/163.bmd|0x0016D2": "「行けっ！」", "Battle/Dat/Battle/Message/163.bmd|0x0016E5": "「当たれよ！」"}