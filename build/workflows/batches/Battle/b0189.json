age/107.bmd|0x004F8A": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004F91": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004F98": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004F9F": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004FA6": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004FAD": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004FB4": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004FBB": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004FC2": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004FC9": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004FD0": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004FD7": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004FDE": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004FE5": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004FEC": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004FF3": "リム", "Battle/Dat/Battle/Message/107.bmd|0x004FFA": "リム", "Battle/Dat/Battle/Message/107.bmd|0x005001": "リム", "Battle/Dat/Battle/Message/107.bmd|0x005008": "「あたしを甘く見ないで！」", "Battle/Dat/Battle/Message/107.bmd|0x005030": "「あたしだって！」", "Battle/Dat/Battle/Message/107.bmd|0x00504C": "「ここはあたしが！」", "Battle/Dat/Battle/Message/107.bmd|0x00506B": "「やるしかない……なら！」", "Battle/Dat/Battle/Message/107.bmd|0x005093": "「負けられない！」", "Battle/Dat/Battle/Message/107.bmd|0x0050AF": "「甘く見てると後悔するわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x0050DD": "「あたしだって、やってみせる！」", "Battle/Dat/Battle/Message/107.bmd|0x00510E": "「こっちに気づいたわね……！」", "Battle/Dat/Battle/Message/107.bmd|0x00513C": "「この距離なら、行けるわ！」", "Battle/Dat/Battle/Message/107.bmd|0x005167": "「ブランシュネージュなら、やれるわ！」", "Battle/Dat/Battle/Message/107.bmd|0x0051A1": "「頼むわね、ブランシュネージュ！」", "Battle/Dat/Battle/Message/107.bmd|0x0051D5": "「お願いね、ブランシュネージュ！」", "Battle/Dat/Battle/Message/107.bmd|0x005209": "「行くわよ、クリス！」", "Battle/Dat/Battle/Message/107.bmd|0x00522B": "（うん！）", "Battle/Dat/Battle/Message/107.bmd|0x00523B": "（リアナ、敵、敵！）", "Battle/Dat/Battle/Message/107.bmd|0x00525A": "「大丈夫、任せて！」", "Battle/Dat/Battle/Message/107.bmd|0x005279": "「このっ、やらせないんだから！」", "Battle/Dat/Battle/Message/107.bmd|0x0052AA": "（リアナ、頑張って！）", "Battle/Dat/Battle/Message/107.bmd|0x0052CC": "（うぅ～、来た、来たよ！）", "Battle/Dat/Battle/Message/107.bmd|0x0052F4": "「わかってるわよ！　ここはやってみせる！」", "Battle/Dat/Battle/Message/107.bmd|0x005334": "（リ、リアナ、あそこ、あそこ！）", "Battle/Dat/Battle/Message/107.bmd|0x005365": "「ちょっと黙ってて！」", "Battle/Dat/Battle/Message/107.bmd|0x005387": "（前、前から来る！）", "Battle/Dat/Battle/Message/107.bmd|0x0053A6": "「やってみせるわ！」", "Battle/Dat/Battle/Message/107.bmd|0x0053C5": "（リアナ、あれ、見えてる？）", "Battle/Dat/Battle/Message/107.bmd|0x0053F0": "「ええ、行くわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x00540F": "「このデア・ブランシュネージュなら！」", "Battle/Dat/Battle/Message/107.bmd|0x005449": "「デア・ブランシュネージュを甘く見ないで！」", "Battle/Dat/Battle/Message/107.bmd|0x00548C": "「お願いね、デア・ブランシュネージュ！」", "Battle/Dat/Battle/Message/107.bmd|0x0054C9": "「ガイアセイバーズの好きにはやらせない！」", "Battle/Dat/Battle/Message/107.bmd|0x005509": "「濡れ衣を着せられたままで終わりはしないわ！」", "Battle/Dat/Battle/Message/107.bmd|0x00554F": "「ガイアセイバーズ、あんた達には負けない！」", "Battle/Dat/Battle/Message/107.bmd|0x005592": "「こっちにも言い分があるのよ！」", "Battle/Dat/Battle/Message/107.bmd|0x0055C3": "「あんた達、いい加減にしなさいよ！」", "Battle/Dat/Battle/Message/107.bmd|0x0055FA": "「あんた達の踏み台なんかにならないから！」", "Battle/Dat/Battle/Message/107.bmd|0x00563A": "「アレス・ガイストよりこっちの方が速いはず！」", "Battle/Dat/Battle/Message/107.bmd|0x005680": "「行くわよ、ドゥバン！」", "Battle/Dat/Battle/Message/107.bmd|0x0056A5": "「やらせないわよ、ドゥバン！」", "Battle/Dat/Battle/Message/107.bmd|0x0056D3": "「ドゥバン、あんたを止めてみせる！」", "Battle/Dat/Battle/Message/107.bmd|0x00570A": "「たった一人で全てを支配するなんて……！」", "Battle/Dat/Battle/Message/107.bmd|0x00574A": "「アルテウル、あんたにこの子は渡さないわ！」", "Battle/Dat/Battle/Message/107.bmd|0x00578D": "「アルテウル、あんたの本当の目的は何なの！？」", "Battle/Dat/Battle/Message/107.bmd|0x0057D3": "「あ、あたしの中に入ってこないで！」", "Battle/Dat/Battle/Message/107.bmd|0x00580A": "「ウェントス！/　それ以上喋るなら、あたしはあんたを……！」", "Battle/Dat/Battle/Message/107.bmd|0x005863": "「この感じ……ウェントス、あんたは……！」", "Battle/Dat/Battle/Message/107.bmd|0x0058A3": "（こ、この感じ、何なの！？）", "Battle/Dat/Battle/Message/107.bmd|0x0058CE": "「引き寄せられる……！？　くっ！」", "Battle/Dat/Battle/Message/107.bmd|0x005902": "（ウェントス……私は……）", "Battle/Dat/Battle/Message/107.bmd|0x00592A": "「駄目よ、クリス！　引き込まれる！」", "Battle/Dat/Battle/Message/107.bmd|0x005961": "（ウェントスが私達を……）", "Battle/Dat/Battle/Message/107.bmd|0x005989": "「クリス、あいつに気を取られないで！」", "Battle/Dat/Battle/Message/107.bmd|0x0059C3": "「何であんたとアニキが……！」", "Battle/Dat/Battle/Message/107.bmd|0x0059F1": "「この子は、/　アニキの機体ほど影響を受けていない……！」", "Battle/Dat/Battle/Message/107.bmd|0x005A47": "「グラキエース……どうしてアニキに……！」", "Battle/Dat/Battle/Message/107.bmd|0x005A87": "「グラキエース、/　あたし達は太陽の光を取り戻す！」", "Battle/Dat/Battle/Message/107.bmd|0x005AD4": "「グラキエース、アニキに何かあったら……！」", "Battle/Dat/Battle/Message/107.bmd|0x005B17": "「この感じ……ウェントスとは違う……！」", "Battle/Dat/Battle/Message/107.bmd|0x005B54": "「行くわよ、イグニス！」", "Battle/Dat/Battle/Message/107.bmd|0x005B79": "「イグニス！　あたしを甘く見ないでよ！」", "Battle/Dat/Battle/Message/107.bmd|0x005BB6": "「メリオルエッセが相手でも！」", "Battle/Dat/Battle/Message/107.bmd|0x005BE4": "「あんた達が破滅をもたらすと言うのなら！」", "Battle/Dat/Battle/Message/107.bmd|0x005C24": "「“破滅の王”の糧になんかならないわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x005C64": "（相手はメリオルエッセよ！　気をつけて！）", "Battle/Dat/Battle/Message/107.bmd|0x005CA4": "「わかってる！」"}