{"Battle/Dat/Battle/Message/298.bmd|0x003B4F": "「くううっ！　龍虎王を侮ったか！」", "Battle/Dat/Battle/Message/298.bmd|0x003B83": "「身のこなしはさすがじゃな、虎龍王め……！」", "Battle/Dat/Battle/Message/298.bmd|0x003BC6": "「それで妾を屠る気か？」", "Battle/Dat/Battle/Message/298.bmd|0x003BEB": "「妾を捉えたことは、褒めてやろうぞ」", "Battle/Dat/Battle/Message/298.bmd|0x003C22": "「何の真似じゃ、それは？」", "Battle/Dat/Battle/Message/298.bmd|0x003C4A": "「ふふふ、我が衣に触れたか……」", "Battle/Dat/Battle/Message/298.bmd|0x003C7B": "「それがそなたの限界ぞ」", "Battle/Dat/Battle/Message/298.bmd|0x003CA0": "「何と非力な……」", "Battle/Dat/Battle/Message/298.bmd|0x003CBC": "「見えるだろう？　冥府の扉が……」", "Battle/Dat/Battle/Message/298.bmd|0x003CF0": "「無礼者めが……！」", "Battle/Dat/Battle/Message/298.bmd|0x003D0F": "「効かぬな、ゼンガー」", "Battle/Dat/Battle/Message/298.bmd|0x003D31": "「ゼンガー……そなたの技、受け止めたぞ」", "Battle/Dat/Battle/Message/298.bmd|0x003D6E": "「老いぼれが……効かぬわ」", "Battle/Dat/Battle/Message/298.bmd|0x003D96": "「くっ、妾をいたぶる気か……！」", "Battle/Dat/Battle/Message/298.bmd|0x003DC7": "「妾は、言いなりにはならぬと言った……！」", "Battle/Dat/Battle/Message/298.bmd|0x003E07": "「光龍め、遊んでおるつもりか？」", "Battle/Dat/Battle/Message/298.bmd|0x003E38": "「それがそなたの新たな力か、青龍」", "Battle/Dat/Battle/Message/298.bmd|0x003E6C": "「超機人の扱いがなっておらぬな」", "Battle/Dat/Battle/Message/298.bmd|0x003E9D": "「龍虎王の力は、その程度か？」", "Battle/Dat/Battle/Message/298.bmd|0x003ECB": "「速さはそこそこじゃの、虎龍王」", "Battle/Dat/Battle/Message/298.bmd|0x003EFC": "「そなたの剣では、我が命に届かぬわ」", "Battle/Dat/Battle/Message/298.bmd|0x003F33": "「神の僕……さすがに侮れぬ！」", "Battle/Dat/Battle/Message/298.bmd|0x003F61": "「くっ、あの光は……！」", "Battle/Dat/Battle/Message/298.bmd|0x003F86": "「ユーゼスめ、まやかしを……！」", "Battle/Dat/Battle/Message/298.bmd|0x003FB7": "「そなたにマガルガを捉えることは出来ぬ」", "Battle/Dat/Battle/Message/298.bmd|0x003FF4": "「そなたでは相手にならぬ」", "Battle/Dat/Battle/Message/298.bmd|0x00401C": "「見るがいい、我が舞を……/　そなたの命尽きるまで！」", "Battle/Dat/Battle/Message/298.bmd|0x00406C": "「応龍皇でマガルガを捉えることは出来ぬ」", "Battle/Dat/Battle/Message/298.bmd|0x0040A9": "「ふふふ……妾はここにおるぞ」", "Battle/Dat/Battle/Message/298.bmd|0x0040D7": "「どこを見ておるのじゃ？」", "Battle/Dat/Battle/Message/298.bmd|0x0040FF": "「マガルガの舞に惑わされたか」", "Battle/Dat/Battle/Message/298.bmd|0x00412D": "「ふっ、笑止」", "Battle/Dat/Battle/Message/298.bmd|0x004143": "「それで終わりかえ？」", "Battle/Dat/Battle/Message/298.bmd|0x004165": "「ふっ、つまらぬ技じゃ」", "Battle/Dat/Battle/Message/298.bmd|0x00418A": "「そなたの技など、マガルガには届かぬ！」", "Battle/Dat/Battle/Message/298.bmd|0x0041C7": "「ははは！　我が舞に惑わされたか！」", "Battle/Dat/Battle/Message/298.bmd|0x0041FE": "「そなたには/　マガルガの影さえも捉えることは出来まいて」", "Battle/Dat/Battle/Message/298.bmd|0x004254": "「さあ……このまま根の国へ誘ってやろうぞ」", "Battle/Dat/Battle/Message/298.bmd|0x004294": "「ゼンガー、そなたの技など通用せぬ」", "Battle/Dat/Battle/Message/298.bmd|0x0042CB": "「ふふふ……無理をするな、老いぼれが」", "Battle/Dat/Battle/Message/298.bmd|0x004305": "「あれを正面から受けるわけにはいかぬ……！」", "Battle/Dat/Battle/Message/298.bmd|0x004348": "「かわせたとて、油断は出来ぬ……！」", "Battle/Dat/Battle/Message/298.bmd|0x00437F": "「青龍……その様ではのう」", "Battle/Dat/Battle/Message/298.bmd|0x0043A7": "「ふん、四神の名が泣いておるぞ」", "Battle/Dat/Battle/Message/298.bmd|0x0043D8": "「様子見をしておるのか、神の僕は……」", "Battle/Dat/Battle/Message/298.bmd|0x004412": "「もうあれには囚われぬ……！」", "Battle/Dat/Battle/Message/298.bmd|0x004440": "「新人祖の力とは、そんなものか！」", "Battle/Dat/Battle/Message/298.bmd|0x004474": "「効かぬわ！」", "Battle/Dat/Battle/Message/298.bmd|0x00448A": "「無駄じゃ！」", "Battle/Dat/Battle/Message/298.bmd|0x0044A0": "「そのようなもの！」", "Battle/Dat/Battle/Message/298.bmd|0x0044BF": "「衣一枚破れぬようだな」", "Battle/Dat/Battle/Message/298.bmd|0x0044E4": "「マガルガよ、我が身を守れ！」", "Battle/Dat/Battle/Message/298.bmd|0x004512": "「………」", "Battle/Dat/Battle/Message/298.bmd|0x004522": "「しばし耐えるしかないのか……！」", "Battle/Dat/Battle/Message/298.bmd|0x004556": "「うぬっ！　口惜しや……！」", "Battle/Dat/Battle/Message/298.bmd|0x004581": "「舞を舞えぬとは……！」", "Battle/Dat/Battle/Message/298.bmd|0x0045A6": "「どこへ失せた……！？」", "Battle/Dat/Battle/Message/298.bmd|0x0045CB": "「妾の視界から消えるとは……！」", "Battle/Dat/Battle/Message/298.bmd|0x0045FC": "「ふふふ……私に近づくことが出来ぬのか？」", "Battle/Dat/Battle/Message/298.bmd|0x00463C": "「そう怯えることはない……」", "Battle/Dat/Battle/Message/298.bmd|0x004667": "「まだ妾がおる！」", "Battle/Dat/Battle/Message/298.bmd|0x004683": "「続けて行くぞ、マガルガ！」", "Battle/Dat/Battle/Message/298.bmd|0x0046AE": "「我が舞で助けようぞ！」", "Battle/Dat/Battle/Message/298.bmd|0x0046D3": "「我が手で冥府へ送ってやる……！」", "Battle/Dat/Battle/Message/298.bmd|0x004707": "「せめて、そなたの力となろうぞ……！」", "Battle/Dat/Battle/Message/298.bmd|0x004741": "「ゼンガー、後は妾に任せよ！」", "Battle/Dat/Battle/Message/298.bmd|0x00476F": "「夏喃様、助力致します」", "Battle/Dat/Battle/Message/298.bmd|0x004794": "「泰北様、後は妾めが」", "Battle/Dat/Battle/Message/298.bmd|0x0047B6": "「光龍様、助力致します」", "Battle/Dat/Battle/Message/298.bmd|0x0047DB": "「リシュウ、妾が手を貸すぞ！」", "Battle/Dat/Battle/Message/298.bmd|0x004809": "「龍虎王に続くぞ、マガルガ！」", "Battle/Dat/Battle/Message/298.bmd|0x004837": "「マガルガ、虎龍王に続くのじゃ！」", "Battle/Dat/Battle/Message/298.bmd|0x00486B": "「我が衣の一振りで！」", "Battle/Dat/Battle/Message/298.bmd|0x00488D": "「マガルガよ、岩戸の盾となれ！」", "Battle/Dat/Battle/Message/298.bmd|0x0048BE": "「夏喃様、ここは妾めが」", "Battle/Dat/Battle/Message/298.bmd|0x0048E3": "「泰北様、後はお任せを」", "Battle/Dat/Battle/Message/298.bmd|0x004908": "「光龍様、ここは妾めが」", "Battle/Dat/Battle/Message/298.bmd|0x00492D": "「下がるのじゃ、ゼンガー！」", "Battle/Dat/Battle/Message/298.bmd|0x004958": "「退くのじゃ、リシュウ！」", "Battle/Dat/Battle/Message/298.bmd|0x004980": "「マガルガ、龍虎王を守るのじゃ！」", "Battle/Dat/Battle/Message/298.bmd|0x0049B4": "「マガルガ、虎龍王を守るのじゃ！」", "Battle/Dat/Battle/Message/298.bmd|0x0049E8": "「これで仕舞いじゃ！」", "Battle/Dat/Battle/Message/298.bmd|0x004A0A": "「はっ！」", "Battle/Dat/Battle/Message/298.bmd|0x004A1A": "「舞え、マガルガ！」", "Battle/Dat/Battle/Message/298.bmd|0x004A39": "「はあっ！！」", "Battle/Dat/Battle/Message/298.bmd|0x004A4F": "「比咩舞を！！」", "Battle/Dat/Battle/Message/298.bmd|0x004A68": "「行け、死反玉！」", "Battle/Dat/Battle/Message/298.bmd|0x004A84": "「十種の神器……死反玉！」", "Battle/Dat/Battle/Message/298.bmd|0x004AAC": "「死れる者達の世界へ……行くがいい！」", "Battle/Dat/Battle/Message/298.bmd|0x004AE6": "「我が舞で黄泉比良坂へ送ってやろうぞ……！」", "Battle/Dat/Battle/Message/298.bmd|0x004B29": "「ふふふ……千引石は、すぐそこだ……！」", "Battle/Dat/Battle/Message/298.bmd|0x004B66": "「生魂！」", "Battle/Dat/Battle/Message/298.bmd|0x004B76": "「足魂！」", "Battle/Dat/Battle/Message/298.bmd|0x004B86": "「玉留魂！」", "Battle/Dat/Battle/Message/298.bmd|0x004B99": "「布瑠部……由良由良止布瑠部！！」", "Battle/Dat/Battle/Message/298.bmd|0x004BCD": "「死反舞！！」", "Battle/Dat/Battle/Message/298.bmd|0x004BE3": "「一二三四五六七八九十！」", "Battle/Dat/Battle/Message/298.bmd|0x004C0B": "「布留部！　由良由良止布留部！」　", "Battle/Dat/Battle/Message/298.bmd|0x004C3F": "「八握剣！！」", "Battle/Dat/Battle/Message/299.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/299.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/299.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/299.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/299.bmd|0x0003FC": "「………？」", "Battle/Dat/Battle/Message/300.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/301.bmd|0x002723": "「全ては楽園を護るために……」", "Battle/Dat/Battle/Message/301.bmd|0x002751": "「楽園の秩序を乱す者を抹消する……」", "Battle/Dat/Battle/Message/301.bmd|0x002788": "「我が下で使命を果たさぬのであれば……」", "Battle/Dat/Battle/Message/301.bmd|0x0027C5": "「汝らを楽園より追放する……」", "Battle/Dat/Battle/Message/301.bmd|0x0027F3": "「天罰を受けよ」", "Battle/Dat/Battle/Message/301.bmd|0x00280C": "「誰も寄せ付けぬ……誰も外界には出さぬ……」", "Battle/Dat/Battle/Message/301.bmd|0x00284F": "「汝らは、地球の守護者になり得ぬ……」", "Battle/Dat/Battle/Message/301.bmd|0x002889": "「神託は下った……」", "Battle/Dat/Battle/Message/301.bmd|0x0028A8": "「巫女に干渉することは許さぬ……」", "Battle/Dat/Battle/Message/301.bmd|0x0028DC": "「汝らを外界へ出すわけにはいかぬ……」", "Battle/Dat/Battle/Message/301.bmd|0x002916": "「星への翼……/　そのようなものは不要……」", "Battle/Dat/Battle/Message/301.bmd|0x002957": "「汝らは百邪も同然……」", "Battle/Dat/Battle/Message/301.bmd|0x00297C": "「主に逆らう愚か者め……」", "Battle/Dat/Battle/Message/301.bmd|0x0029A4": "「あくまでも我に逆らうか、龍虎王……」", "Battle/Dat/Battle/Message/301.bmd|0x0029DE": "「虎龍王……/　汝は戦う相手を違えている……」"}