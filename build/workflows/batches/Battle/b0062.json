{"Battle/Dat/Battle/Message/040.bmd|0x00F12D": "「スプリット・ビームキャノン！」", "Battle/Dat/Battle/Message/040.bmd|0x00F15E": "「アルブレード・ビィィィムッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F192": "「ブレード・トンファー、セット！」", "Battle/Dat/Battle/Message/040.bmd|0x00F1C6": "「突撃ぃぃぃっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F1E5": "「アルブレード必殺！」", "Battle/Dat/Battle/Message/040.bmd|0x00F207": "「ブレェェェェド・トンファーッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F23E": "「オラオラオラーッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F263": "「ブレード・サイ、セット！」", "Battle/Dat/Battle/Message/040.bmd|0x00F28E": "「オラオラオラオラァッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F2B9": "「とどめだ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F2D2": "「ラプター・ランダム・スラァァッシュ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F312": "「チェンジ！　フライヤー・モード！」", "Battle/Dat/Battle/Message/040.bmd|0x00F349": "「ラスト・シューート！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F371": "「ラプター・ランダム・シューーッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F3AB": "「プラズマ・ステーク、セット！」", "Battle/Dat/Battle/Message/040.bmd|0x00F3DC": "「ジェット・マグナム！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F404": "「スプリットミサイル！」", "Battle/Dat/Battle/Message/040.bmd|0x00F429": "「ロングレンジ・モード！」", "Battle/Dat/Battle/Message/040.bmd|0x00F451": "「行けぇっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F46A": "「メガ・ゲシュペン・バスター！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F49E": "「うおりゃあ！」", "Battle/Dat/Battle/Message/040.bmd|0x00F4B7": "「メガ・ブラスターキャノン！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F4E8": "「ブレスト・ビィィィム！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F513": "「必殺！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F526": "「ジェット・ファントム！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F551": "「ギャラクティカ・アッパー！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F582": "「照準セット！　トリガー！」", "Battle/Dat/Battle/Message/040.bmd|0x00F5AD": "「ツイン・ビームカノン！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F5D8": "「ゲシュペン・ダブル・ビーム！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F60C": "「ダーク・ロック！」", "Battle/Dat/Battle/Message/040.bmd|0x00F62B": "「ガスト手裏剣！」", "Battle/Dat/Battle/Message/040.bmd|0x00F647": "「もういっちょ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F666": "「ハイパー・ブーストナッコォ！」", "Battle/Dat/Battle/Message/040.bmd|0x00F697": "「ハイパー・ガスト・パァァンチ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F6CE": "「ビーム・キャノン！　照準セット！」", "Battle/Dat/Battle/Message/040.bmd|0x00F705": "「アルティメット・ビーム！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F733": "「必殺！　究極重粒子砲！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F75E": "「超闘士の必殺剣、見せてやるぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00F792": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F7AD": "「暗剣殺！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F7C3": "「グルンガスト・ブレード！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F7F1": "「ダーク・ソード・キル！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F81C": "「スラァァァァッシュ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F844": "「爆滅！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F857": "「決めてやるぜ！　超闘士超必殺！」", "Battle/Dat/Battle/Message/040.bmd|0x00F88B": "「五！」", "Battle/Dat/Battle/Message/040.bmd|0x00F898": "「黄！」", "Battle/Dat/Battle/Message/040.bmd|0x00F8A5": "「殺！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F8B5": "「ファイブ！」", "Battle/Dat/Battle/Message/040.bmd|0x00F8CB": "「イエロー！」", "Battle/Dat/Battle/Message/040.bmd|0x00F8E1": "「キル！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F8F4": "「爆壊！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F907": "「Ｖパターン・スラァァッシュ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00F93B": "「ダブル・オメガレーザー！」", "Battle/Dat/Battle/Message/040.bmd|0x00F966": "「ビッグ・ミサイル！」", "Battle/Dat/Battle/Message/040.bmd|0x00F988": "「グルンガスト・ミサァァイル！」", "Battle/Dat/Battle/Message/040.bmd|0x00F9B9": "「ツイン・ビームキャノン、発射！」", "Battle/Dat/Battle/Message/040.bmd|0x00F9ED": "「スパイラル・ブレイカー！」", "Battle/Dat/Battle/Message/040.bmd|0x00FA18": "「必殺！　音速大回転斬り！！」", "Battle/Dat/Battle/Message/040.bmd|0x00FA46": "「オメガ・キャノン！　ファイア！」", "Battle/Dat/Battle/Message/040.bmd|0x00FA7A": "「ドリル・アタァァァック！！」", "Battle/Dat/Battle/Message/040.bmd|0x00FAA8": "「必殺！　ガスト・バースト！」", "Battle/Dat/Battle/Message/040.bmd|0x00FAD6": "「グランド・ダッシュ・アタック！！」", "Battle/Dat/Battle/Message/040.bmd|0x00FB0D": "「Ｇコンビネーション・アタックだ！」", "Battle/Dat/Battle/Message/040.bmd|0x00FB44": "「ドリル・アタッカー！！」", "Battle/Dat/Battle/Message/040.bmd|0x00FB6C": "「ダブル・ドリル・パァァンチ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00FBA0": "「見せてやるぜ、参式の必殺技を！」", "Battle/Dat/Battle/Message/040.bmd|0x00FBD4": "「獅子王刀、歳破！！」", "Battle/Dat/Battle/Message/040.bmd|0x00FBF6": "「そこを動くな！！」", "Battle/Dat/Battle/Message/040.bmd|0x00FC15": "「キング・レオ・ブレード！！」", "Battle/Dat/Battle/Message/040.bmd|0x00FC43": "「斬壊！！」", "Battle/Dat/Battle/Message/040.bmd|0x00FC56": "「超音速ミサイル、発射！！」", "Battle/Dat/Battle/Message/040.bmd|0x00FC81": "「スーパー・ソニック・ミサイル！！」", "Battle/Dat/Battle/Message/040.bmd|0x00FCB8": "「照準セット！　データ・リンク！」", "Battle/Dat/Battle/Message/040.bmd|0x00FCEC": "「フリー・エレクトロン・キャノン！/　ファイア！！」", "Battle/Dat/Battle/Message/040.bmd|0x00FD39": "「サテライト・バスターキャノン！/　行けぇっ！！」", "Battle/Dat/Battle/Message/041.bmd|0x005516": "「貴様を待っているのは……死だ」", "Battle/Dat/Battle/Message/041.bmd|0x005547": "「邪魔だ……消え去れ！」", "Battle/Dat/Battle/Message/041.bmd|0x00556C": "「俺に出会った不幸を呪え！」", "Battle/Dat/Battle/Message/041.bmd|0x005597": "「運がなかったな……沈め！」", "Battle/Dat/Battle/Message/041.bmd|0x0055C2": "「無駄なあがきはやめろ……！」", "Battle/Dat/Battle/Message/041.bmd|0x0055F0": "「覚悟はいいか？　ならば！」", "Battle/Dat/Battle/Message/041.bmd|0x00561B": "「死にたくなければ、そこをどけ！」", "Battle/Dat/Battle/Message/041.bmd|0x00564F": "「もはや貴様に逃げ場はない！」", "Battle/Dat/Battle/Message/041.bmd|0x00567D": "「逃げ回っても無駄だ！」", "Battle/Dat/Battle/Message/041.bmd|0x0056A2": "「沈め……！」", "Battle/Dat/Battle/Message/041.bmd|0x0056B8": "「アレス・ガイスト……好きにはやらせん！」", "Battle/Dat/Battle/Message/041.bmd|0x0056F8": "「行くぞ、ドゥバン・オーグ！」", "Battle/Dat/Battle/Message/041.bmd|0x005726": "「ドゥバン、お前の暴走を止める！」", "Battle/Dat/Battle/Message/041.bmd|0x00575A": "「アルテウル、お前の本当の目的は何だ？」", "Battle/Dat/Battle/Message/041.bmd|0x005797": "「指揮官機狙いで行く」", "Battle/Dat/Battle/Message/041.bmd|0x0057B9": "「頭を抑えれば……！」", "Battle/Dat/Battle/Message/041.bmd|0x0057DB": "「子供と遊んでいる暇はない」", "Battle/Dat/Battle/Message/041.bmd|0x005806": "「ブーステッド・チルドレン……/　行く手を阻むのなら、容赦はしない」", "Battle/Dat/Battle/Message/041.bmd|0x00586B": "「あなたも我が父と同じく、/　敢えて力を行使すると言うのなら……/　俺はそれを止める側に回る！」", "Battle/Dat/Battle/Message/041.bmd|0x0058F8": "「秩序は、力のみで/　作り上げられるべきではない……/　あなたもわかっているはずだ！」", "Battle/Dat/Battle/Message/041.bmd|0x005976": "「過ぎた野望は身を滅ぼすことになる……！」", "Battle/Dat/Battle/Message/041.bmd|0x0059B6": "「イグニス……/　お前の炎でも焼けぬものがある！」", "Battle/Dat/Battle/Message/041.bmd|0x005A00": "「そう簡単に絶望などせんぞ……！」", "Battle/Dat/Battle/Message/041.bmd|0x005A34": "「メリオルエッセ……ここで仕留めてみせる！」", "Battle/Dat/Battle/Message/041.bmd|0x005A77": "「メリオルエッセを捕捉。攻撃を開始する！」", "Battle/Dat/Battle/Message/041.bmd|0x005AB7": "「好きにはやらせんぞ、コンターギオ！」", "Battle/Dat/Battle/Message/041.bmd|0x005AF1": "「ここまでだ、アクイラ！」", "Battle/Dat/Battle/Message/041.bmd|0x005B19": "「ウンブラ、貴様が何を企もうと……！」", "Battle/Dat/Battle/Message/041.bmd|0x005B53": "「氷を操るメリオルエッセか……！」", "Battle/Dat/Battle/Message/041.bmd|0x005B87": "「貴様がもたらす破滅、/　ここで食い止めてみせる！」", "Battle/Dat/Battle/Message/041.bmd|0x005BD4": "「ある意味、わかり易い相手だが……」", "Battle/Dat/Battle/Message/041.bmd|0x005C0B": "「力で押してくる相手は、戦い易い」", "Battle/Dat/Battle/Message/041.bmd|0x005C3F": "「こちらの油断を誘う気なのだろうが……」", "Battle/Dat/Battle/Message/041.bmd|0x005C7C": "「行くぞ、セティ！」", "Battle/Dat/Battle/Message/041.bmd|0x005C9B": "「貴様に勝機はないぞ、ゼゼーナン！」", "Battle/Dat/Battle/Message/041.bmd|0x005CD2": "「引き際を見失ったな、ゼゼーナン！」", "Battle/Dat/Battle/Message/041.bmd|0x005D09": "「お前達の理想郷などに興味はない」", "Battle/Dat/Battle/Message/041.bmd|0x005D3D": "「限られた数の人間しか/　救う気がないのであれば、賛同できんな」", "Battle/Dat/Battle/Message/041.bmd|0x005D9C": "「仙道にすがらねばならぬほど/　困窮しているわけではないのでな」", "Battle/Dat/Battle/Message/041.bmd|0x005DFB": "「孫光龍……/　我が先祖からの因縁、ここで断つ！」", "Battle/Dat/Battle/Message/041.bmd|0x005E45": "「光龍、貴様が何を言おうと！」", "Battle/Dat/Battle/Message/041.bmd|0x005E73": "「マシンナリー・チルドレンか……！」", "Battle/Dat/Battle/Message/041.bmd|0x005EAA": "「何を守るための剣なのだ、お前達は」", "Battle/Dat/Battle/Message/041.bmd|0x005EE1": "「ガイアセイバーズ……お前達には屈しない」"}