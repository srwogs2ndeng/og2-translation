{"Battle/Dat/Battle/Message/151.bmd|0x009ED3": "「スーパー・ソニック・ブレイカー！！」", "Battle/Dat/Battle/Message/151.bmd|0x009F0D": "「キャニスからは逃げられん！」", "Battle/Dat/Battle/Message/151.bmd|0x009F3B": "「ダブル・ガナリー、Ｗモード！」", "Battle/Dat/Battle/Message/151.bmd|0x009F6C": "「追い詰めてやる！」", "Battle/Dat/Battle/Message/151.bmd|0x009F8B": "「Ｗモード、ファイア！！」", "Battle/Dat/Battle/Message/151.bmd|0x009FB3": "「飛べ、キャニス！」", "Battle/Dat/Battle/Message/151.bmd|0x009FD2": "「ダブル・ガナリー！　くらえ！」", "Battle/Dat/Battle/Message/152.bmd|0x0063D0": "「我らこそが外敵を討ち、/　地球を護る剣なのだ！」", "Battle/Dat/Battle/Message/152.bmd|0x00641A": "「地球圏の未来は、我らが切り開く！」", "Battle/Dat/Battle/Message/152.bmd|0x006451": "「前大戦のエースと言えど！」", "Battle/Dat/Battle/Message/152.bmd|0x00647C": "「叛乱分子を排除する！」", "Battle/Dat/Battle/Message/152.bmd|0x0064A1": "「鋼龍戦隊！　お前達の役目は終わった！」", "Battle/Dat/Battle/Message/152.bmd|0x0064DE": "「鋼龍戦隊、貴様らが犯した罪は重い！」", "Battle/Dat/Battle/Message/152.bmd|0x006518": "「鋼龍戦隊など、もはや無用の長物だ！」", "Battle/Dat/Battle/Message/152.bmd|0x006552": "「鋼龍戦隊、貴様らはここで終わりだ！」", "Battle/Dat/Battle/Message/152.bmd|0x00658C": "「我らこそが地球の守護者だ！」", "Battle/Dat/Battle/Message/152.bmd|0x0065BA": "「ガイアセイバーズの名の下に、/　お前達を討つ！」", "Battle/Dat/Battle/Message/152.bmd|0x006604": "「裏切り者は死ね！」", "Battle/Dat/Battle/Message/152.bmd|0x006623": "「離反者を始末する！」", "Battle/Dat/Battle/Message/152.bmd|0x006645": "「ゲストの好きにはやらせん！」", "Battle/Dat/Battle/Message/152.bmd|0x006673": "「ゲスト機を撃破する！」", "Battle/Dat/Battle/Message/152.bmd|0x006698": "「ルイーナめ、我らが相手だ！」", "Battle/Dat/Battle/Message/152.bmd|0x0066C6": "「我らはお前達など恐れはしない！」", "Battle/Dat/Battle/Message/152.bmd|0x0066FA": "「母艦を沈めれば、奴らは終わりだ！」", "Battle/Dat/Battle/Message/152.bmd|0x006731": "「鋼龍戦隊の要はあの艦だ！　沈める！」", "Battle/Dat/Battle/Message/152.bmd|0x00676B": "「スペースノア級と言えども！」", "Battle/Dat/Battle/Message/152.bmd|0x006799": "「反逆者の艦に容赦はせんぞ！」", "Battle/Dat/Battle/Message/152.bmd|0x0067C7": "「合体する前に落とす！」", "Battle/Dat/Battle/Message/152.bmd|0x0067EC": "「１機落とせば、合体できまい！」", "Battle/Dat/Battle/Message/152.bmd|0x00681D": "「ＳＲＸ計画の試作機など！」", "Battle/Dat/Battle/Message/152.bmd|0x006848": "「エンジンに/　直撃させるわけにはいかんが……！」", "Battle/Dat/Battle/Message/152.bmd|0x006892": "「長射程とは言え、穴はあるはずだ！」", "Battle/Dat/Battle/Message/152.bmd|0x0068C9": "「奴の射程にも隙はある！」", "Battle/Dat/Battle/Message/152.bmd|0x0068F1": "「撃たれる前に撃つ！」", "Battle/Dat/Battle/Message/152.bmd|0x006913": "「アルトアイゼンを落とせば、手柄になる！」", "Battle/Dat/Battle/Message/152.bmd|0x006953": "「杭打ち機などにやられるか！」", "Battle/Dat/Battle/Message/152.bmd|0x006981": "「奴のレンジ外から攻撃すれば！」", "Battle/Dat/Battle/Message/152.bmd|0x0069B2": "「ＡＴＸ計画の試作機など！」", "Battle/Dat/Battle/Message/152.bmd|0x0069DD": "「アルトアイゼンもどきめ！」", "Battle/Dat/Battle/Message/152.bmd|0x006A08": "「欠陥機に何が出来る！」", "Battle/Dat/Battle/Message/152.bmd|0x006A2D": "「寄せ集めの機体など！」", "Battle/Dat/Battle/Message/152.bmd|0x006A52": "「無様な姿をさらしおって！」", "Battle/Dat/Battle/Message/152.bmd|0x006A7D": "「見るに忍びん姿だ……完全に破壊してやる！」", "Battle/Dat/Battle/Message/152.bmd|0x006AC0": "「アインストの成れの果てめ！」", "Battle/Dat/Battle/Message/152.bmd|0x006AEE": "「もらったぞ、白騎士！」", "Battle/Dat/Battle/Message/152.bmd|0x006B13": "「フン、ゲシュペンストの改造機など！」", "Battle/Dat/Battle/Message/152.bmd|0x006B4D": "「ゲシュペンストをいくら改造したところで！」", "Battle/Dat/Battle/Message/152.bmd|0x006B90": "「旧型をどう改造しようと！」", "Battle/Dat/Battle/Message/152.bmd|0x006BBB": "「旧型の改造機など、楽勝だ！」", "Battle/Dat/Battle/Message/152.bmd|0x006BE9": "「シリーズ７７が何だと言うのだ！」", "Battle/Dat/Battle/Message/152.bmd|0x006C1D": "「流星は燃え尽きてしまえ！」", "Battle/Dat/Battle/Message/152.bmd|0x006C48": "「プロジェクトＴＤの成果は、/　我らが引き継いでやる！」", "Battle/Dat/Battle/Message/152.bmd|0x006C9B": "「プロジェクトＴＤは、/　我らに利用されて然るべきだ！」", "Battle/Dat/Battle/Message/152.bmd|0x006CEE": "「合体したところで！」", "Battle/Dat/Battle/Message/152.bmd|0x006D10": "「お前達もその機体も、既に用済みだ！」", "Battle/Dat/Battle/Message/152.bmd|0x006D4A": "「お前達の死を以て、/　ＴＤは新たな段階へ進むのだ！」", "Battle/Dat/Battle/Message/152.bmd|0x006D9A": "「零落した凶鳥など！」", "Battle/Dat/Battle/Message/152.bmd|0x006DBC": "「凶鳥の眷属は、消えて然るべきなんだよ！」", "Battle/Dat/Battle/Message/152.bmd|0x006DFC": "「凶鳥の成れの果てに何が出来る！」", "Battle/Dat/Battle/Message/152.bmd|0x006E30": "「呪われた系譜に終止符を打ってやる！」", "Battle/Dat/Battle/Message/152.bmd|0x006E6A": "「凶鳥の宿命に準じ、消え失せろ！」", "Battle/Dat/Battle/Message/152.bmd|0x006E9E": "「フン、図体がでかいだけの機体だ！」", "Battle/Dat/Battle/Message/152.bmd|0x006ED5": "「見かけ倒しめ！」", "Battle/Dat/Battle/Message/152.bmd|0x006EF1": "「所詮は力だけの機体だ！」", "Battle/Dat/Battle/Message/152.bmd|0x006F19": "「その装甲、貫いてやる！」", "Battle/Dat/Battle/Message/152.bmd|0x006F41": "「特機は最優先で落とす！」", "Battle/Dat/Battle/Message/152.bmd|0x006F69": "「ダブルＧが相手でも臆するものか！」", "Battle/Dat/Battle/Message/152.bmd|0x006FA0": "「ダブルＧを仕留めれば、/　奴らの士気は下がる！」", "Battle/Dat/Battle/Message/152.bmd|0x006FEA": "「大仰な剣を振り回したところで！」", "Battle/Dat/Battle/Message/152.bmd|0x00701E": "「ダイゼンガー！　その首、もらい受けるぞ！」", "Battle/Dat/Battle/Message/152.bmd|0x007061": "「穴馬を仕留める！」", "Battle/Dat/Battle/Message/152.bmd|0x007080": "「何が超闘士だ！」", "Battle/Dat/Battle/Message/152.bmd|0x00709C": "「グルンガストを落とせば、手柄になる！」", "Battle/Dat/Battle/Message/152.bmd|0x0070D9": "「行くぞ、グルンガスト！」", "Battle/Dat/Battle/Message/152.bmd|0x007101": "「シャドウミラーの残党が！」", "Battle/Dat/Battle/Message/152.bmd|0x00712C": "「この世界にお前の居場所はない！」", "Battle/Dat/Battle/Message/152.bmd|0x007160": "「ツェントル・プロジェクトの機体か！」", "Battle/Dat/Battle/Message/152.bmd|0x00719A": "「ツェントル・プロジェクトの試作機など！」", "Battle/Dat/Battle/Message/152.bmd|0x0071DA": "「サイバスターは最優先で破壊しなければ！」", "Battle/Dat/Battle/Message/152.bmd|0x00721A": "「サイバスターを落とす！」", "Battle/Dat/Battle/Message/152.bmd|0x007242": "「魔装機神を仕留めるぞ！」", "Battle/Dat/Battle/Message/152.bmd|0x00726A": "「ＭＡＰＷを使われる前に落とす！」", "Battle/Dat/Battle/Message/152.bmd|0x00729E": "「サイバスター以外にも/　魔装機神がいたとはな！」", "Battle/Dat/Battle/Message/152.bmd|0x0072E8": "「まだアインストが残っていたか！」", "Battle/Dat/Battle/Message/152.bmd|0x00731C": "「次は俺の番だ！」", "Battle/Dat/Battle/Message/152.bmd|0x007338": "「ただでは帰さん！」", "Battle/Dat/Battle/Message/152.bmd|0x007357": "「ガイアセイバーズを相手にして、/　ただで済むと思うな！」", "Battle/Dat/Battle/Message/152.bmd|0x0073AD": "「お返しだ！」", "Battle/Dat/Battle/Message/152.bmd|0x0073C3": "「離脱などさせるか！」", "Battle/Dat/Battle/Message/152.bmd|0x0073E5": "「反撃を！」", "Battle/Dat/Battle/Message/152.bmd|0x0073F8": "「仕切り直しだ！」", "Battle/Dat/Battle/Message/152.bmd|0x007414": "「このまま引き下がるつもりはない！」", "Battle/Dat/Battle/Message/152.bmd|0x00744B": "「今度はこちらからだ！」", "Battle/Dat/Battle/Message/152.bmd|0x007470": "「反撃開始！」", "Battle/Dat/Battle/Message/152.bmd|0x007486": "「ただで済むと思うな！」", "Battle/Dat/Battle/Message/152.bmd|0x0074AB": "「こ、ここまでか！！」", "Battle/Dat/Battle/Message/152.bmd|0x0074CD": "「うあああっ！！」", "Battle/Dat/Battle/Message/152.bmd|0x0074E9": "「駄目だ、脱出を！！」", "Battle/Dat/Battle/Message/152.bmd|0x00750B": "「そんな馬鹿な！！」", "Battle/Dat/Battle/Message/152.bmd|0x00752A": "「し、しまった！！」", "Battle/Dat/Battle/Message/152.bmd|0x007549": "「こんな結果、認めるわけには……！！」", "Battle/Dat/Battle/Message/152.bmd|0x007583": "「ぐああっ！　機体が！！」", "Battle/Dat/Battle/Message/152.bmd|0x0075AB": "「お、おのれ！　よくも！！」", "Battle/Dat/Battle/Message/152.bmd|0x0075D6": "「馬鹿な、この俺が！！」", "Battle/Dat/Battle/Message/152.bmd|0x0075FB": "「こ、これ以上は！！」", "Battle/Dat/Battle/Message/152.bmd|0x00761D": "「ぐあああっ！！」", "Battle/Dat/Battle/Message/152.bmd|0x007639": "「いかん！　これ以上はまずいぞ！」", "Battle/Dat/Battle/Message/152.bmd|0x00766D": "「くそ！　この機体では勝てんのか！」", "Battle/Dat/Battle/Message/152.bmd|0x0076A4": "「お、俺はガイアセイバーズだ！/　奴らなどに！」", "Battle/Dat/Battle/Message/152.bmd|0x0076EB": "「ガ、ガイアセイバーズに/　敗北は許されんのだ！」", "Battle/Dat/Battle/Message/152.bmd|0x007735": "「こ、ここまで押し込まれるとは！」", "Battle/Dat/Battle/Message/152.bmd|0x007769": "「まだだ！　まだ決着はついていない！」", "Battle/Dat/Battle/Message/152.bmd|0x0077A3": "「許さん！　許さんぞ、貴様！」", "Battle/Dat/Battle/Message/152.bmd|0x0077D1": "「ぐああっ！　奴め、何をやったんだ！？」", "Battle/Dat/Battle/Message/152.bmd|0x00780E": "「ええい、コントロールが！！」", "Battle/Dat/Battle/Message/152.bmd|0x00783C": "「うぐうっ！　貴様ぁ！！」", "Battle/Dat/Battle/Message/152.bmd|0x007864": "「くうう……！　追い込まれたか！」", "Battle/Dat/Battle/Message/152.bmd|0x007898": "「お、おのれ、ＡＴＸチーム！」", "Battle/Dat/Battle/Message/152.bmd|0x0078C6": "「ぐあっ！　鋼龍戦隊などに！」", "Battle/Dat/Battle/Message/152.bmd|0x0078F4": "「こ、これが鋼龍戦隊の実力か！！」"}