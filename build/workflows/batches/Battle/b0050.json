{"Battle/Dat/Battle/Message/038.bmd|0x008DF5": "「この程度、グルンガストなら！」", "Battle/Dat/Battle/Message/038.bmd|0x008E26": "「参式の装甲を見くびるなよ！」", "Battle/Dat/Battle/Message/038.bmd|0x008E54": "「くっ！　夏喃め！」", "Battle/Dat/Battle/Message/038.bmd|0x008E73": "「ぐっ！　さすがダブルＧ、踏み込みが速い！」", "Battle/Dat/Battle/Message/038.bmd|0x008EB6": "「くっ！　やめろ、虎王機！」", "Battle/Dat/Battle/Message/038.bmd|0x008EE1": "「雀武王の力はその程度か！」", "Battle/Dat/Battle/Message/038.bmd|0x008F0C": "「ううっ！　窮奇王を振り切れなかったか！」", "Battle/Dat/Battle/Message/038.bmd|0x008F4C": "「饕餮王、奴の動きは……！」", "Battle/Dat/Battle/Message/038.bmd|0x008F77": "「うぐっ！　トリッキーな動きを！」", "Battle/Dat/Battle/Message/038.bmd|0x008FAB": "「踏み込みが足りないぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x008FD3": "「専心して、見極めるっ！」", "Battle/Dat/Battle/Message/038.bmd|0x008FFB": "「動きが素直すぎるんだっ！」", "Battle/Dat/Battle/Message/038.bmd|0x009026": "「かわしてみせるっ！」", "Battle/Dat/Battle/Message/038.bmd|0x009048": "「動きを見切ればっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00906D": "「間合いが甘いっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00908F": "「ブリット君……！」", "Battle/Dat/Battle/Message/038.bmd|0x0090AE": "「大丈夫だ。あいつは虎龍王に追いつけない」", "Battle/Dat/Battle/Message/038.bmd|0x0090EE": "「クスハ、この調子で行くぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x00911C": "「ええ、わかったわ！」", "Battle/Dat/Battle/Message/038.bmd|0x00913E": "「読みやすい攻撃だな！」", "Battle/Dat/Battle/Message/038.bmd|0x009163": "「でも、油断しないで！」", "Battle/Dat/Battle/Message/038.bmd|0x009188": "「当たるかよ！」", "Battle/Dat/Battle/Message/038.bmd|0x0091A1": "「次が来るかも知れない、気をつけて！」", "Battle/Dat/Battle/Message/038.bmd|0x0091DB": "「そんなもの！」", "Battle/Dat/Battle/Message/038.bmd|0x0091F4": "「当たりません！」", "Battle/Dat/Battle/Message/038.bmd|0x009210": "「こっちだって四神の超機人なんだ！」", "Battle/Dat/Battle/Message/038.bmd|0x009247": "「動きが鈍くても、/　敵の攻撃を見切ればっ！」", "Battle/Dat/Battle/Message/038.bmd|0x00928B": "「瞬発力はあるんだっ！」", "Battle/Dat/Battle/Message/038.bmd|0x0092B0": "「こいつに当てられるわけには/　いかないんだ！」", "Battle/Dat/Battle/Message/038.bmd|0x0092F7": "「グルンガストだって、これぐらいは！」", "Battle/Dat/Battle/Message/038.bmd|0x009331": "「参式の瞬発力を、甘く見るなよ！」", "Battle/Dat/Battle/Message/038.bmd|0x009365": "「当たらないぞ、ロフ！」", "Battle/Dat/Battle/Message/038.bmd|0x00938A": "「無駄だ、イグニス！」", "Battle/Dat/Battle/Message/038.bmd|0x0093AC": "「それで終わりか、コンターギオ！」", "Battle/Dat/Battle/Message/038.bmd|0x0093E0": "「メリオルエッセと言えど！」", "Battle/Dat/Battle/Message/038.bmd|0x00940B": "「夏喃、俺はここだ！」", "Battle/Dat/Battle/Message/038.bmd|0x00942D": "「当たらないぞ、孫光龍！」", "Battle/Dat/Battle/Message/038.bmd|0x009455": "「その龍は見かけ倒しか！」", "Battle/Dat/Battle/Message/038.bmd|0x00947D": "「無駄だ、ペルフェクティオ！」", "Battle/Dat/Battle/Message/038.bmd|0x0094AB": "「俺を甘く見るなよ、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/038.bmd|0x0094E8": "「無駄だ、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/038.bmd|0x009516": "「ガイアセイバーズなどに！」", "Battle/Dat/Battle/Message/038.bmd|0x009541": "「見切ったぞ、ジンライ！」", "Battle/Dat/Battle/Message/038.bmd|0x009569": "「ルイーナにやられるわけには！」", "Battle/Dat/Battle/Message/038.bmd|0x00959A": "「ルイーナにやられるものか！」", "Battle/Dat/Battle/Message/038.bmd|0x0095C8": "「妖機人相手で後れを取るものか！」", "Battle/Dat/Battle/Message/038.bmd|0x0095FC": "「妖機人なんかに！」", "Battle/Dat/Battle/Message/038.bmd|0x00961B": "「物の怪などに！」", "Battle/Dat/Battle/Message/038.bmd|0x009637": "「虎王機！　俺がわからないのか！」", "Battle/Dat/Battle/Message/038.bmd|0x00966B": "「それが四凶の超機人の力か！」", "Battle/Dat/Battle/Message/038.bmd|0x009699": "「あんなのに取り込まれてたまるか！」", "Battle/Dat/Battle/Message/038.bmd|0x0096D0": "「ガンエデン、お前の光には惑わされん！」", "Battle/Dat/Battle/Message/038.bmd|0x00970D": "「お前が言う因縁、断ち切ってみせる！」", "Battle/Dat/Battle/Message/038.bmd|0x009747": "「どうした、俺はここだっ！」", "Battle/Dat/Battle/Message/038.bmd|0x009772": "「ありがと、ブリット君」", "Battle/Dat/Battle/Message/038.bmd|0x009797": "「いや、ははは……虎龍王のおかげさ」", "Battle/Dat/Battle/Message/038.bmd|0x0097CE": "「ブリット君、すごい！」", "Battle/Dat/Battle/Message/038.bmd|0x0097F3": "「え？　それほどでも……」", "Battle/Dat/Battle/Message/038.bmd|0x00981B": "「よし……！　このまま奴を振り切るぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x009858": "「かわしたぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x009871": "「向こうはまた仕掛けてくるみたい！/　気をつけて！」", "Battle/Dat/Battle/Message/038.bmd|0x0098BE": "「よくやったぞ、虎龍王！」", "Battle/Dat/Battle/Message/038.bmd|0x0098E6": "「よし、この調子で行くぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x009911": "「よし！　いい反応だ、Ｍｋ‐Ⅱ！」", "Battle/Dat/Battle/Message/038.bmd|0x009945": "「インスペクターと/　大差ないということか……！」", "Battle/Dat/Battle/Message/038.bmd|0x00998F": "「それで終わりか、雀武王！」", "Battle/Dat/Battle/Message/038.bmd|0x0099BA": "「窮奇王を振り切ったぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x0099E2": "「正面から受け止めるっ！」", "Battle/Dat/Battle/Message/038.bmd|0x009A0A": "「出直して来いっ！」", "Battle/Dat/Battle/Message/038.bmd|0x009A29": "「念動フィールドッ！」", "Battle/Dat/Battle/Message/038.bmd|0x009A4B": "「Ｇ・ウォール、作動！」", "Battle/Dat/Battle/Message/038.bmd|0x009A70": "「Ｇ・テリトリー、展開！」", "Battle/Dat/Battle/Message/038.bmd|0x009A98": "「そんな攻撃など！」", "Battle/Dat/Battle/Message/038.bmd|0x009AB7": "「ジャマー発動！」", "Battle/Dat/Battle/Message/038.bmd|0x009AD3": "「相手の確認を怠るからこうなるんだ！」", "Battle/Dat/Battle/Message/038.bmd|0x009B0D": "「見切った！」", "Battle/Dat/Battle/Message/038.bmd|0x009B23": "「虎龍王！　身分身！」", "Battle/Dat/Battle/Message/038.bmd|0x009B45": "「身分身の術！」", "Battle/Dat/Battle/Message/038.bmd|0x009B5E": "「………」", "Battle/Dat/Battle/Message/038.bmd|0x009B6E": "「しまった、反撃出来ない！？」", "Battle/Dat/Battle/Message/038.bmd|0x009B9C": "「くっ……！　間合いを読み違えたか！」", "Battle/Dat/Battle/Message/038.bmd|0x009BD6": "「ここでもう一押しだっ！」", "Battle/Dat/Battle/Message/038.bmd|0x009BFE": "「まだ踏み込めるっ！」", "Battle/Dat/Battle/Message/038.bmd|0x009C20": "「その隙は見逃さない！」", "Battle/Dat/Battle/Message/038.bmd|0x009C45": "「続けて行くぞ、虎龍王！」", "Battle/Dat/Battle/Message/038.bmd|0x009C6D": "「キョウスケ中尉、援護します！」", "Battle/Dat/Battle/Message/038.bmd|0x009C9E": "「さすがだ……！/　このタイミングなら、いける！」", "Battle/Dat/Battle/Message/038.bmd|0x009CE8": "「あの人には余計な真似かも知れないけど……/　逃がすわけには！」", "Battle/Dat/Battle/Message/038.bmd|0x009D47": "「エクセレン少尉！　後は任せて下さい！」", "Battle/Dat/Battle/Message/038.bmd|0x009D84": "「続けていきます、エクセレン少尉！」", "Battle/Dat/Battle/Message/038.bmd|0x009DBB": "「手伝います！　エクセレン少尉！」", "Battle/Dat/Battle/Message/038.bmd|0x009DEF": "「少尉！　どこへ行くんですかっ！」", "Battle/Dat/Battle/Message/038.bmd|0x009E23": "「ゼンガー少佐、援護します！」", "Battle/Dat/Battle/Message/038.bmd|0x009E51": "「ゼンガー少佐、連携攻撃で行きます！」", "Battle/Dat/Battle/Message/038.bmd|0x009E8B": "「ここは任せてくれ、クスハ！」", "Battle/Dat/Battle/Message/038.bmd|0x009EB9": "「クスハ、後は俺がやる！」", "Battle/Dat/Battle/Message/038.bmd|0x009EE1": "「先に行ってくれ、クスハ！」", "Battle/Dat/Battle/Message/038.bmd|0x009F0C": "「タスク、詰めが甘いぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x009F34": "「悪いが、タスク……とどめは俺が刺す！」", "Battle/Dat/Battle/Message/038.bmd|0x009F71": "「リョウト、手を貸すぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x009F99": "「リオ！　助太刀する！」", "Battle/Dat/Battle/Message/038.bmd|0x009FBE": "「レオナ、援護するぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x009FE3": "「少佐、後は自分が！」", "Battle/Dat/Battle/Message/038.bmd|0x00A005": "「助太刀するぞ、ユウ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A02A": "「ユウ！　後は任せてくれ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A055": "「一本決めるまで油断するな！　カーラ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A092": "「ラミアさんは次のターゲットを！」", "Battle/Dat/Battle/Message/038.bmd|0x00A0C6": "「ラミアさん、後は引き受けます！」", "Battle/Dat/Battle/Message/038.bmd|0x00A0FA": "「アラド、援護するぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A11F": "「後ろがガラ空きだぞ、アラド！」", "Battle/Dat/Battle/Message/038.bmd|0x00A150": "「リュウセイ、後は任せろ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A17B": "「レーツェルさん、後は任せて下さい！」", "Battle/Dat/Battle/Message/038.bmd|0x00A1B5": "「ヴィレッタ大尉、援護します！」", "Battle/Dat/Battle/Message/038.bmd|0x00A1E6": "「リシュウ先生！　助太刀します！」", "Battle/Dat/Battle/Message/038.bmd|0x00A21A": "「アリエイル、援護する！」", "Battle/Dat/Battle/Message/038.bmd|0x00A242": "「ヒューゴ少尉、援護します！」", "Battle/Dat/Battle/Message/038.bmd|0x00A270": "「アクア少尉、後は自分が！」", "Battle/Dat/Battle/Message/038.bmd|0x00A29B": "「ジョッシュ、援護するぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A2C6": "「後は任せろ、ジョッシュ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A2F1": "「ジョッシュ、/　お前が嫌だと言っても援護する！」"}