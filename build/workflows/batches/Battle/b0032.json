{"Battle/Dat/Battle/Message/025.bmd|0x0014FE": "「迂闊ですな。隙だらけですぞ」", "Battle/Dat/Battle/Message/025.bmd|0x00152C": "「まだ終わりではありませんぞ」", "Battle/Dat/Battle/Message/025.bmd|0x00155A": "「ならば、もう一撃！」", "Battle/Dat/Battle/Message/025.bmd|0x00157C": "「参りますぞ！」", "Battle/Dat/Battle/Message/025.bmd|0x001595": "「いざっ！」", "Battle/Dat/Battle/Message/025.bmd|0x0015A8": "「この一撃で！」", "Battle/Dat/Battle/Message/025.bmd|0x0015C1": "「覚悟っ！」", "Battle/Dat/Battle/Message/025.bmd|0x0015D4": "「せいっ！」", "Battle/Dat/Battle/Message/025.bmd|0x0015E7": "「はっ！」", "Battle/Dat/Battle/Message/025.bmd|0x0015F7": "「うりゃっ！」", "Battle/Dat/Battle/Message/025.bmd|0x00160D": "「ていっ！」", "Battle/Dat/Battle/Message/025.bmd|0x001620": "「とうっ！」", "Battle/Dat/Battle/Message/026.bmd|0x000D30": "「先手さえ取れば、勝率が上がる」", "Battle/Dat/Battle/Message/026.bmd|0x000D61": "「少しでも敵の数を減らす、/　それが兵法の常道だ！」", "Battle/Dat/Battle/Message/026.bmd|0x000DAE": "「敵機を捕捉した。これより攻撃を開始する」", "Battle/Dat/Battle/Message/026.bmd|0x000DEE": "「相手が何者であろうと、/　ここで退くわけにはいかん」", "Battle/Dat/Battle/Message/026.bmd|0x000E3E": "「地上人よ、覚悟してもらおうか！」", "Battle/Dat/Battle/Message/026.bmd|0x000E72": "「地上人……相手にとって不足はないわ！」", "Battle/Dat/Battle/Message/026.bmd|0x000EAF": "「魔装機神、いざ勝負！」", "Battle/Dat/Battle/Message/026.bmd|0x000ED4": "「行くぞ、魔装機神め！」", "Battle/Dat/Battle/Message/026.bmd|0x000EF9": "「逃がさん！」", "Battle/Dat/Battle/Message/026.bmd|0x000F0F": "「返すぞ！」", "Battle/Dat/Battle/Message/026.bmd|0x000F22": "「今度はこちらからだ！」", "Battle/Dat/Battle/Message/026.bmd|0x000F47": "「ぬうっ！　不覚！」", "Battle/Dat/Battle/Message/026.bmd|0x000F66": "「また負け戦か……！！」", "Battle/Dat/Battle/Message/026.bmd|0x000F8B": "「こ、これほどのダメージを受けては！」", "Battle/Dat/Battle/Message/026.bmd|0x000FC5": "「ば、馬鹿な！」", "Battle/Dat/Battle/Message/026.bmd|0x000FDE": "「ぬおっ！　私の読みが浅かったか！」", "Battle/Dat/Battle/Message/026.bmd|0x001015": "「わ、私に驕りはなかった……！/　なのに、ここまでの損害を受けるとは！」", "Battle/Dat/Battle/Message/026.bmd|0x001080": "「ぐうう……ここまで押されては！」", "Battle/Dat/Battle/Message/026.bmd|0x0010B4": "「な、何という力だ、地上人め！」", "Battle/Dat/Battle/Message/026.bmd|0x0010E5": "「ま、魔装機神……恐るべきパワーだ！」", "Battle/Dat/Battle/Message/026.bmd|0x00111F": "「むっ！　想定したよりもダメージが大きいな」", "Battle/Dat/Battle/Message/026.bmd|0x001162": "「ぬう、意外とやるではないか」", "Battle/Dat/Battle/Message/026.bmd|0x001190": "「さすがだ、一筋縄ではいかんな」", "Battle/Dat/Battle/Message/026.bmd|0x0011C1": "「ええい、この程度の攻撃を避けきれんとは！」", "Battle/Dat/Battle/Message/026.bmd|0x001204": "「いかん、まともに受け過ぎたか！」", "Battle/Dat/Battle/Message/026.bmd|0x001238": "「くっ！　地上人の力を侮ったか！」", "Battle/Dat/Battle/Message/026.bmd|0x00126C": "「ぬうう！　やるな、魔装機神！」", "Battle/Dat/Battle/Message/026.bmd|0x00129D": "「戯れ事を！」", "Battle/Dat/Battle/Message/026.bmd|0x0012B3": "「どうした、それで終わりか？」", "Battle/Dat/Battle/Message/026.bmd|0x0012E1": "「その程度の力で、私に挑むか」", "Battle/Dat/Battle/Message/026.bmd|0x00130F": "「ふん、見かけ倒しか」", "Battle/Dat/Battle/Message/026.bmd|0x001331": "「ほう、当たったか。だが、それだけだな」", "Battle/Dat/Battle/Message/026.bmd|0x00136E": "「ふっ……遠慮はいらんぞ、地上人」", "Battle/Dat/Battle/Message/026.bmd|0x0013A2": "「そんなものか、魔装機神の力は」", "Battle/Dat/Battle/Message/026.bmd|0x0013D3": "「当たらんよ！」", "Battle/Dat/Battle/Message/026.bmd|0x0013EC": "「甘いな！」", "Battle/Dat/Battle/Message/026.bmd|0x0013FF": "「ふむ、こちらの推測が的中したな」", "Battle/Dat/Battle/Message/026.bmd|0x001433": "「計算通りだ」", "Battle/Dat/Battle/Message/026.bmd|0x001449": "「………」", "Battle/Dat/Battle/Message/026.bmd|0x001459": "「何たる失態……！」", "Battle/Dat/Battle/Message/026.bmd|0x001478": "「くっ、反撃できんとは……！」", "Battle/Dat/Battle/Message/026.bmd|0x0014A6": "「私に任せてもらおう！」", "Battle/Dat/Battle/Message/026.bmd|0x0014CB": "「やらせんっ！」", "Battle/Dat/Battle/Message/026.bmd|0x0014E4": "「もう一撃！」", "Battle/Dat/Battle/Message/026.bmd|0x0014FA": "「この好機、逃しはせん！」", "Battle/Dat/Battle/Message/026.bmd|0x001522": "「行くぞ！」", "Battle/Dat/Battle/Message/026.bmd|0x001535": "「この一撃で！」", "Battle/Dat/Battle/Message/026.bmd|0x00154E": "「受けてみよ！」", "Battle/Dat/Battle/Message/026.bmd|0x001567": "「好きにはやらせんぞ！」", "Battle/Dat/Battle/Message/026.bmd|0x00158C": "「そこか！」", "Battle/Dat/Battle/Message/026.bmd|0x00159F": "「くらえい！」", "Battle/Dat/Battle/Message/026.bmd|0x0015B5": "「むうん！」", "Battle/Dat/Battle/Message/026.bmd|0x0015C8": "「でえい！」", "Battle/Dat/Battle/Message/026.bmd|0x0015DB": "「おりゃあ！」", "Battle/Dat/Battle/Message/026.bmd|0x0015F1": "「バリオン・ビーム砲、発射用意！」", "Battle/Dat/Battle/Message/026.bmd|0x001625": "「撃てい！！」", "Battle/Dat/Battle/Message/026.bmd|0x00163B": "「主砲、発射用意！」", "Battle/Dat/Battle/Message/027.bmd|0x000FD2": "「先手さえ取ってしまえば！」", "Battle/Dat/Battle/Message/027.bmd|0x000FFD": "「悪く思うな！」", "Battle/Dat/Battle/Message/027.bmd|0x001016": "「ここで手柄を立てれば、昇進も夢ではない！」", "Battle/Dat/Battle/Message/027.bmd|0x001059": "「反応が遅いぞ！」", "Battle/Dat/Battle/Message/027.bmd|0x001075": "「悪く思うな、地上人！」", "Battle/Dat/Battle/Message/027.bmd|0x00109A": "「ただでは帰さないぞ、地上人！」", "Battle/Dat/Battle/Message/027.bmd|0x0010CB": "「地上人め、やらせんぞ！」", "Battle/Dat/Battle/Message/027.bmd|0x0010F3": "「魔装機神と言えど、先手を取れば！」", "Battle/Dat/Battle/Message/027.bmd|0x00112A": "「魔装機神を仕留めれば、いい手柄になる！」", "Battle/Dat/Battle/Message/027.bmd|0x00116A": "「手柄が飛び込んできたとみるべきか、/　虎口に飛び込んでしまったとみるべきか……/　ええい、ままよ！」", "Battle/Dat/Battle/Message/027.bmd|0x001200": "「まだまだっ！」", "Battle/Dat/Battle/Message/027.bmd|0x001219": "「やらせるかっ！」", "Battle/Dat/Battle/Message/027.bmd|0x001235": "「ただでは帰さないっ！」", "Battle/Dat/Battle/Message/027.bmd|0x00125A": "「今度はこっちの番だ！」", "Battle/Dat/Battle/Message/027.bmd|0x00127F": "「反撃する！」", "Battle/Dat/Battle/Message/027.bmd|0x001295": "「くそうっ！　やられたっ！」", "Battle/Dat/Battle/Message/027.bmd|0x0012C0": "「ここまでか！」", "Battle/Dat/Battle/Message/027.bmd|0x0012D9": "「こ、こんなことっ！！」", "Battle/Dat/Battle/Message/027.bmd|0x0012FE": "「手柄を立てずに死ねるかっ！」", "Battle/Dat/Battle/Message/027.bmd|0x00132C": "「な、何だっ！？　何がどうなって……」", "Battle/Dat/Battle/Message/027.bmd|0x001366": "「ぐううっ！！　や、やはり、駄目なのか！？」", "Battle/Dat/Battle/Message/027.bmd|0x0013A9": "「くうっ！！　な、何なんだ、こいつはっ！」", "Battle/Dat/Battle/Message/027.bmd|0x0013E9": "「こ、こんな所で死んでたまるかっ！」", "Battle/Dat/Battle/Message/027.bmd|0x001420": "「地上人め、よくも！」", "Battle/Dat/Battle/Message/027.bmd|0x001442": "「ち、地上のメカがこれほどとは……！！」", "Battle/Dat/Battle/Message/027.bmd|0x00147F": "「ま、魔装機神……化け物か……！？」", "Battle/Dat/Battle/Message/027.bmd|0x0014B6": "「ぐうっ！/　これが……魔装機神の力なのか！」", "Battle/Dat/Battle/Message/027.bmd|0x0014FA": "「まだだっ！　そう簡単にやられるかっ！」", "Battle/Dat/Battle/Message/027.bmd|0x001537": "「くっ、押されているのか！？/　だが、まだっ！」", "Battle/Dat/Battle/Message/027.bmd|0x00157E": "「ちいっ！　思ったよりやるっ！」", "Battle/Dat/Battle/Message/027.bmd|0x0015AF": "「直撃だと！？」", "Battle/Dat/Battle/Message/027.bmd|0x0015C8": "「こ、これはいったい！？」", "Battle/Dat/Battle/Message/027.bmd|0x0015F0": "「くっ！　やってくれたな、地上人！」", "Battle/Dat/Battle/Message/027.bmd|0x001627": "「ちいっ！　やるな、地上人！」", "Battle/Dat/Battle/Message/027.bmd|0x001655": "「ええい、魔装機神め！」", "Battle/Dat/Battle/Message/027.bmd|0x00167A": "「魔装機神め、やってくれる！」", "Battle/Dat/Battle/Message/027.bmd|0x0016A8": "「この程度のダメージなど！」", "Battle/Dat/Battle/Message/027.bmd|0x0016D3": "「かすっただけだ！」", "Battle/Dat/Battle/Message/027.bmd|0x0016F2": "「そんなものか！」", "Battle/Dat/Battle/Message/027.bmd|0x00170E": "「ちっ、かわせなかったか！」", "Battle/Dat/Battle/Message/027.bmd|0x001739": "「回避しきれなかったとは……！」", "Battle/Dat/Battle/Message/027.bmd|0x00176A": "「それで終わりか、地上人！」", "Battle/Dat/Battle/Message/027.bmd|0x001795": "「地上人め、手加減でもしているつもりか？」", "Battle/Dat/Battle/Message/027.bmd|0x0017D5": "「ふん、魔装機神……/　意外と大したことはないな」", "Battle/Dat/Battle/Message/027.bmd|0x00181F": "「魔装機神の力は、その程度か？」", "Battle/Dat/Battle/Message/027.bmd|0x001850": "「なんのっ！」", "Battle/Dat/Battle/Message/027.bmd|0x001866": "「予測通りっ！」", "Battle/Dat/Battle/Message/027.bmd|0x00187F": "「当たるものかっ！」", "Battle/Dat/Battle/Message/027.bmd|0x00189E": "「くっ、間一髪！」", "Battle/Dat/Battle/Message/027.bmd|0x0018BA": "「ふう、かわせたか」", "Battle/Dat/Battle/Message/027.bmd|0x0018D9": "「………」"}