{"Battle/Dat/Battle/Message/046.bmd|0x0087CB": "「たあっ！！」", "Battle/Dat/Battle/Message/046.bmd|0x0087E1": "「ハイパー・ブーストナックル！」", "Battle/Dat/Battle/Message/046.bmd|0x008812": "「ビーム・キャノン、連動！」", "Battle/Dat/Battle/Message/046.bmd|0x00883D": "「アルティメット・ビーム、発射！！」", "Battle/Dat/Battle/Message/046.bmd|0x008874": "「天に二つの禍つ星……！」", "Battle/Dat/Battle/Message/046.bmd|0x00889C": "「その名も計都羅¶剣！！」", "Battle/Dat/Battle/Message/046.bmd|0x0088C3": "「暗剣殺！！」", "Battle/Dat/Battle/Message/046.bmd|0x0088D9": "「斬！！」", "Battle/Dat/Battle/Message/046.bmd|0x0088E9": "「凶星からは逃げられないよ」", "Battle/Dat/Battle/Message/046.bmd|0x008914": "「連なる凶星吉神を破り、土に帰す……！」", "Battle/Dat/Battle/Message/046.bmd|0x008951": "「計都羅¶剣！」", "Battle/Dat/Battle/Message/046.bmd|0x008969": "「五！」", "Battle/Dat/Battle/Message/046.bmd|0x008976": "「黄！」", "Battle/Dat/Battle/Message/046.bmd|0x008983": "「殺！！」", "Battle/Dat/Battle/Message/046.bmd|0x008993": "「大凶方へ去るんだ……！」", "Battle/Dat/Battle/Message/046.bmd|0x0089BB": "「ダブル・オメガレーザー！」", "Battle/Dat/Battle/Message/046.bmd|0x0089E6": "「ビッグ・ミサイル、発射！」", "Battle/Dat/Battle/Message/046.bmd|0x008A11": "「ツイン・ビームキャノン、発射！」", "Battle/Dat/Battle/Message/046.bmd|0x008A45": "「スパイラル・ブレイカー！」", "Battle/Dat/Battle/Message/046.bmd|0x008A70": "「行けぇぇぇっ！！」", "Battle/Dat/Battle/Message/046.bmd|0x008A8F": "「オメガ・キャノン、発射！」", "Battle/Dat/Battle/Message/046.bmd|0x008ABA": "「ロックオン！　一斉発射！」", "Battle/Dat/Battle/Message/046.bmd|0x008AE5": "「これで決める！！」", "Battle/Dat/Battle/Message/046.bmd|0x008B04": "「ラプターとバイソンの連係で！」", "Battle/Dat/Battle/Message/046.bmd|0x008B35": "「ドリル・アタッカー！！」", "Battle/Dat/Battle/Message/046.bmd|0x008B5D": "「グルンガスト参式、ファイナルモード！」", "Battle/Dat/Battle/Message/046.bmd|0x008B9A": "「獅子王刀、歳破！」", "Battle/Dat/Battle/Message/046.bmd|0x008BB9": "「ブースト！！」", "Battle/Dat/Battle/Message/046.bmd|0x008BD2": "「たああああっ！！」", "Battle/Dat/Battle/Message/046.bmd|0x008BF1": "「この斬れ味……さすがだね」", "Battle/Dat/Battle/Message/046.bmd|0x008C1C": "「ＭＴＤ誘導弾、発射！」", "Battle/Dat/Battle/Message/046.bmd|0x008C41": "「これを外したら、/　ホントにただじゃ済まない……！」", "Battle/Dat/Battle/Message/046.bmd|0x008C91": "「イルミネーター・リンク！」", "Battle/Dat/Battle/Message/046.bmd|0x008CBC": "「自由電子砲！　いっけぇぇぇっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x004985": "「私の邪魔は、誰にもさせない！」", "Battle/Dat/Battle/Message/047.bmd|0x0049B6": "「そこのあなた、覚悟はいいわね！？」", "Battle/Dat/Battle/Message/047.bmd|0x0049ED": "「悔い改めるなら、今の内よっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x004A21": "「そこのあなた、後悔しても遅いわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x004A5B": "「必ず当ててみせる！」", "Battle/Dat/Battle/Message/047.bmd|0x004A7D": "「正面から行くわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x004A9F": "「そこのあなた、勝負よ！」", "Battle/Dat/Battle/Message/047.bmd|0x004AC7": "「無駄な抵抗はやめなさい！」", "Battle/Dat/Battle/Message/047.bmd|0x004AF2": "「当ててみせる！」", "Battle/Dat/Battle/Message/047.bmd|0x004B0E": "「もらったわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x004B2A": "「そこよ！」", "Battle/Dat/Battle/Message/047.bmd|0x004B3D": "「やってみせる！」", "Battle/Dat/Battle/Message/047.bmd|0x004B59": "「そこのあなた、正々堂々と勝負よ！」", "Battle/Dat/Battle/Message/047.bmd|0x004B90": "「逃がすもんですか！」", "Battle/Dat/Battle/Message/047.bmd|0x004BB2": "「今よっ！」", "Battle/Dat/Battle/Message/047.bmd|0x004BC5": "「いけるわ！」", "Battle/Dat/Battle/Message/047.bmd|0x004BDB": "「負けるもんですか！」", "Battle/Dat/Battle/Message/047.bmd|0x004BFD": "「ガンナーの力、見せてあげるわ！」", "Battle/Dat/Battle/Message/047.bmd|0x004C31": "「行くわよ、ガンナー！」", "Battle/Dat/Battle/Message/047.bmd|0x004C56": "「ガンナーで狙い撃ちよっ！」", "Battle/Dat/Battle/Message/047.bmd|0x004C81": "「行くわよ、ビルトラプター・シュナーベル！」", "Battle/Dat/Battle/Message/047.bmd|0x004CC4": "「勝負よ、ドゥバン！」", "Battle/Dat/Battle/Message/047.bmd|0x004CE6": "「覚悟なさい、エグレッタ！」", "Battle/Dat/Battle/Message/047.bmd|0x004D11": "「彼らの連係を崩さなきゃ！」", "Battle/Dat/Battle/Message/047.bmd|0x004D3C": "「ラトゥーニ達に手出しはさせない！」", "Battle/Dat/Battle/Message/047.bmd|0x004D73": "「イグニス、あなた達の横暴を私は許さない！」", "Battle/Dat/Battle/Message/047.bmd|0x004DB6": "「勝負よ、イグニス！」", "Battle/Dat/Battle/Message/047.bmd|0x004DD8": "「メリオルエッセ……/　あなた達がまき散らす恐怖、食い止めてみせる！」", "Battle/Dat/Battle/Message/047.bmd|0x004E40": "「メリオルエッセが相手でも、/　引き下がりはしない！」", "Battle/Dat/Battle/Message/047.bmd|0x004E90": "「行くわよ、コンターギオ！」", "Battle/Dat/Battle/Message/047.bmd|0x004EBB": "「コンターギオ、笑ってられるのも今の内よ！」", "Battle/Dat/Battle/Message/047.bmd|0x004EFE": "「覚悟なさい、ウンブラ！」", "Battle/Dat/Battle/Message/047.bmd|0x004F26": "「あのメリオルエッセは……！」", "Battle/Dat/Battle/Message/047.bmd|0x004F54": "「ペルフェクティオ！/　破滅するのは、あなたの方よ！」", "Battle/Dat/Battle/Message/047.bmd|0x004FA4": "「勝負よ、ロフ！」", "Battle/Dat/Battle/Message/047.bmd|0x004FC0": "「行くわよ、セティ！」", "Battle/Dat/Battle/Message/047.bmd|0x004FE2": "「あなた！　しゃきっと喋ったらどうなの！」", "Battle/Dat/Battle/Message/047.bmd|0x005022": "「ゼゼーナン、あなたに正義なんてないわ！」", "Battle/Dat/Battle/Message/047.bmd|0x005062": "「ジョグ！　相手になってあげるわ！」", "Battle/Dat/Battle/Message/047.bmd|0x005099": "「勝負よ、紅蓮のサフィーネ！」", "Battle/Dat/Battle/Message/047.bmd|0x0050C7": "「その仮面、剥がしてやるわ！」", "Battle/Dat/Battle/Message/047.bmd|0x0050F5": "「それが……/　あなたの正義だと言うのなら……！」", "Battle/Dat/Battle/Message/047.bmd|0x00513F": "「勝負よ、夏喃！！」", "Battle/Dat/Battle/Message/047.bmd|0x00515E": "「何が桃源郷よ！　そんなもの、不要だわ！」", "Battle/Dat/Battle/Message/047.bmd|0x00519E": "「孫光龍！　あなたの好きにはさせないわ！」", "Battle/Dat/Battle/Message/047.bmd|0x0051DE": "「孫光龍！　あなたは間違いなく悪よ！」", "Battle/Dat/Battle/Message/047.bmd|0x005218": "「ノイエＤＣ……こんな所にまで！」", "Battle/Dat/Battle/Message/047.bmd|0x00524C": "「召喚された者同士で戦ったって！」", "Battle/Dat/Battle/Message/047.bmd|0x005280": "「あなた達の行動は、/　ラ・ギアスを混乱させるだけじゃないの！？」", "Battle/Dat/Battle/Message/047.bmd|0x0052E2": "「ガイアセイバーズ、/　あなた達には屈しないわ！」", "Battle/Dat/Battle/Message/047.bmd|0x00532C": "「勝負よ、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/047.bmd|0x00535A": "「ガイアセイバーズ、/　あなた達の好きにはやらせない！」", "Battle/Dat/Battle/Message/047.bmd|0x0053AD": "「機体さえ何とかすれば…！」", "Battle/Dat/Battle/Message/047.bmd|0x0053D8": "「メディウス・ロクス……油断は出来ない！」", "Battle/Dat/Battle/Message/047.bmd|0x005418": "「あんなもの、ヒュッケバインじゃない……！」", "Battle/Dat/Battle/Message/047.bmd|0x00545B": "「悪のヒュッケバイン……勝負よ！」", "Battle/Dat/Battle/Message/047.bmd|0x00548F": "「さあ、化け物退治よ！」", "Battle/Dat/Battle/Message/047.bmd|0x0054B4": "「悪霊はさっさと退散なさい！」", "Battle/Dat/Battle/Message/047.bmd|0x0054E2": "「行くわよ、妖機人！」", "Battle/Dat/Battle/Message/047.bmd|0x005504": "「妖機人を放っておくわけには！」", "Battle/Dat/Battle/Message/047.bmd|0x005535": "「勝負よ、ルイーナ！」", "Battle/Dat/Battle/Message/047.bmd|0x005557": "「ルイーナを食い止めなきゃ……！」", "Battle/Dat/Battle/Message/047.bmd|0x00558B": "「ルイーナは私達の手で止めてみせる！」", "Battle/Dat/Battle/Message/047.bmd|0x0055C5": "「ゲストの好きにはやらせない！」", "Battle/Dat/Battle/Message/047.bmd|0x0055F6": "「ゲスト！　地球圏から出て行きなさい！」", "Battle/Dat/Battle/Message/047.bmd|0x005633": "「相手が魔装機でも！」", "Battle/Dat/Battle/Message/047.bmd|0x005655": "「あの魔装機は私に任せて！」", "Battle/Dat/Battle/Message/047.bmd|0x005680": "「虎王機、私達の所へ戻って！」", "Battle/Dat/Battle/Message/047.bmd|0x0056AE": "「あれが四凶の超機人……！」", "Battle/Dat/Battle/Message/047.bmd|0x0056D9": "「雀武王……龍虎王と対をなす存在……！」", "Battle/Dat/Battle/Message/047.bmd|0x005716": "「たとえ相手が四神の超機人でも！」", "Battle/Dat/Battle/Message/047.bmd|0x00574A": "「エルデ・ミッテ！/　あなたの暴走は、私達が食い止めてみせる！」", "Battle/Dat/Battle/Message/047.bmd|0x0057A9": "「イルイ、待ってて！/　必ず助けてあげるから！」", "Battle/Dat/Battle/Message/047.bmd|0x0057F0": "「人造の神なんて、神じゃない！/　ただの機械よ！」", "Battle/Dat/Battle/Message/047.bmd|0x00583A": "「ユーゼス！/　あなたの計画は、私が打ち砕いてやるわ！」", "Battle/Dat/Battle/Message/047.bmd|0x00588D": "「あなたは新人祖になんてなれやしない！/　私達がそんなことさせない！」", "Battle/Dat/Battle/Message/047.bmd|0x0058F5": "「仕切り直しよ！」", "Battle/Dat/Battle/Message/047.bmd|0x005911": "「ここで折り返しなんだから！」", "Battle/Dat/Battle/Message/047.bmd|0x00593F": "「ここからは気合で勝負よ！」", "Battle/Dat/Battle/Message/047.bmd|0x00596A": "「やられっぱなしじゃ終わらない！」", "Battle/Dat/Battle/Message/047.bmd|0x00599E": "「この勝負、受けて立つわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x0059CC": "「気合じゃ負けてないわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x0059F7": "「女だと思って甘く見ないで！」", "Battle/Dat/Battle/Message/047.bmd|0x005A25": "「お礼をさせてもらうわ！」", "Battle/Dat/Battle/Message/047.bmd|0x005A4D": "「きゃああっ！/　こんな所でやられるなんてっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x005A97": "「だ、脱出します！」"}