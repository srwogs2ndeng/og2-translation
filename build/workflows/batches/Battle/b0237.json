{"Battle/Dat/Battle/Message/153.bmd|0x007EA0": "「ちいいっ！/　特機とは言え、やりようはあるはずだ！」", "Battle/Dat/Battle/Message/153.bmd|0x007EF0": "「うぐっ！/　あのパワーに太刀打ち出来んとは！」", "Battle/Dat/Battle/Message/153.bmd|0x007F37": "「す、隙を見つけるんだ！/　あの図体なら、隙があるはず！」", "Battle/Dat/Battle/Message/153.bmd|0x007F8D": "「ぐうっ！　サイバスターめ、これ以上は！」", "Battle/Dat/Battle/Message/153.bmd|0x007FCD": "「ま、魔装機神め、何としてもここで！」", "Battle/Dat/Battle/Message/153.bmd|0x008007": "「ちいいっ！　魔装機神を止められん！」", "Battle/Dat/Battle/Message/153.bmd|0x008041": "「お、おのれ、超機人め！！」", "Battle/Dat/Battle/Message/153.bmd|0x00806C": "「ちょ、超機人を食い止めなければ……！」", "Battle/Dat/Battle/Message/153.bmd|0x0080A9": "「ぐうっ！　直撃だと！」", "Battle/Dat/Battle/Message/153.bmd|0x0080CE": "「ちいっ！　やるな！」", "Battle/Dat/Battle/Message/153.bmd|0x0080F0": "「こちらの装甲では止められんのか！？」", "Battle/Dat/Battle/Message/153.bmd|0x00812A": "「まだガイアセイバーズに楯突く気か！」", "Battle/Dat/Battle/Message/153.bmd|0x008164": "「ちっ！　ここから巻き返す！」", "Battle/Dat/Battle/Message/153.bmd|0x008192": "「くっ！　バランサーの調子が！」", "Battle/Dat/Battle/Message/153.bmd|0x0081C3": "「うぐっ！　この程度で怯むものか！」", "Battle/Dat/Battle/Message/153.bmd|0x0081FA": "「ガイアセイバーズをなめるなよ！」", "Battle/Dat/Battle/Message/153.bmd|0x00822E": "「くっ、良くない流れだな……！」", "Battle/Dat/Battle/Message/153.bmd|0x00825F": "「ぬうっ！　これ以上はやらせんぞ！」", "Battle/Dat/Battle/Message/153.bmd|0x008296": "「ちいっ！　当たり所が悪い！」", "Battle/Dat/Battle/Message/153.bmd|0x0082C4": "「や、やるな、ＡＴＸチーム！」", "Battle/Dat/Battle/Message/153.bmd|0x0082F2": "「調子に乗るなよ、鋼龍戦隊！」", "Battle/Dat/Battle/Message/153.bmd|0x008320": "「鋼龍戦隊……一筋縄ではいかんか」", "Battle/Dat/Battle/Message/153.bmd|0x008354": "「身の程を知れ、鋼龍戦隊！」", "Battle/Dat/Battle/Message/153.bmd|0x00837F": "「ちっ、叛乱分子共め！」", "Battle/Dat/Battle/Message/153.bmd|0x0083A4": "「鋼龍戦隊に後れを取るとは……！」", "Battle/Dat/Battle/Message/153.bmd|0x0083D8": "「ＳＲＸチームめ、やってくれる！」", "Battle/Dat/Battle/Message/153.bmd|0x00840C": "「合体する前に落とさなければ……！」", "Battle/Dat/Battle/Message/153.bmd|0x008443": "「チッ！　Ｒシリーズは厄介だな！」", "Battle/Dat/Battle/Message/153.bmd|0x008477": "「くっ！　アルトアイゼンを止められん！」", "Battle/Dat/Battle/Message/153.bmd|0x0084B4": "「な、何という加速力だ！」", "Battle/Dat/Battle/Message/153.bmd|0x0084DC": "「うぐっ！　その杭、へし折ってやるぞ！」", "Battle/Dat/Battle/Message/153.bmd|0x008519": "「くっ！　アインストもどきめ！」", "Battle/Dat/Battle/Message/153.bmd|0x00854A": "「シリーズ７７……さすがのスピードだ！」", "Battle/Dat/Battle/Message/153.bmd|0x008587": "「ええい、プロジェクトＴＤの試作機などに！」", "Battle/Dat/Battle/Message/153.bmd|0x0085CA": "「くっ！　凶鳥などに！」", "Battle/Dat/Battle/Message/153.bmd|0x0085EF": "「あんな継ぎ接ぎだらけの機体に！」", "Battle/Dat/Battle/Message/153.bmd|0x008623": "「あのパワー、/　ヒュッケバインを超えている！？」", "Battle/Dat/Battle/Message/153.bmd|0x00866D": "「うぐっ！　旧型の改造機などに！」", "Battle/Dat/Battle/Message/153.bmd|0x0086A1": "「ゲシュペンストがここまでやるとは！」", "Battle/Dat/Battle/Message/153.bmd|0x0086DB": "「ぬうっ！　ゲシュペンストごときに！」", "Battle/Dat/Battle/Message/153.bmd|0x008715": "「ダイゼンガー……やはり、油断ならん！」", "Battle/Dat/Battle/Message/153.bmd|0x008752": "「ぐっ！　ダイゼンガーを甘く見たか！」", "Battle/Dat/Battle/Message/153.bmd|0x00878C": "「や、やるな、ダブルＧ！」", "Battle/Dat/Battle/Message/153.bmd|0x0087B4": "「うぬっ！　ダブルＧめ！」", "Battle/Dat/Battle/Message/153.bmd|0x0087DC": "「超闘士の名は伊達ではないか……！」", "Battle/Dat/Battle/Message/153.bmd|0x008813": "「奴め、見た目より速い！」", "Battle/Dat/Battle/Message/153.bmd|0x00883B": "「ただ大きいだけではないらしいな！」", "Battle/Dat/Battle/Message/153.bmd|0x008872": "「あ、あの特機、何というパワーだ！」", "Battle/Dat/Battle/Message/153.bmd|0x0088A9": "「ちっ、サイバスターめ！」", "Battle/Dat/Battle/Message/153.bmd|0x0088D1": "「ま、魔装機神……厄介な相手だ！」", "Battle/Dat/Battle/Message/153.bmd|0x008905": "「これが魔装機神の力か！」", "Battle/Dat/Battle/Message/153.bmd|0x00892D": "「超機人め、やってくれる！」", "Battle/Dat/Battle/Message/153.bmd|0x008958": "「超機人め、好きにはやらせんぞ！」", "Battle/Dat/Battle/Message/153.bmd|0x00898C": "「ふん、大したことはない」", "Battle/Dat/Battle/Message/153.bmd|0x0089B4": "「この程度の抵抗しか出来んのか」", "Battle/Dat/Battle/Message/153.bmd|0x0089E5": "「装甲をかすめた程度だ！」", "Battle/Dat/Battle/Message/153.bmd|0x008A0D": "「フッ、余裕だな」", "Battle/Dat/Battle/Message/153.bmd|0x008A29": "「何だ、もう終わりか？」", "Battle/Dat/Battle/Message/153.bmd|0x008A4E": "「ガイアセイバーズをなめるな！」", "Battle/Dat/Battle/Message/153.bmd|0x008A7F": "「練度が低い連中だな」", "Battle/Dat/Battle/Message/153.bmd|0x008AA1": "「それでガイアセイバーズに/　立ち向かうなどと……」", "Battle/Dat/Battle/Message/153.bmd|0x008AEE": "「つまらん手だな」", "Battle/Dat/Battle/Message/153.bmd|0x008B0A": "「無駄な抵抗はやめろ」", "Battle/Dat/Battle/Message/153.bmd|0x008B2C": "「連邦軍やＤＣなどとは違うのだ！」", "Battle/Dat/Battle/Message/153.bmd|0x008B60": "「ＡＴＸチーム……/　もう少しやると思っていたがな」", "Battle/Dat/Battle/Message/153.bmd|0x008BAD": "「ふん、反逆者の分際で！」", "Battle/Dat/Battle/Message/153.bmd|0x008BD5": "「鋼龍戦隊……噂ほどではないな」", "Battle/Dat/Battle/Message/153.bmd|0x008C06": "「あくまでも抗う気か、鋼龍戦隊」", "Battle/Dat/Battle/Message/153.bmd|0x008C37": "「叛乱分子が何をしようと！」", "Battle/Dat/Battle/Message/153.bmd|0x008C62": "「Ｌ５戦役の英雄も大したことはないな」", "Battle/Dat/Battle/Message/153.bmd|0x008C9C": "「それがＳＲＸチームの実力か？」", "Battle/Dat/Battle/Message/153.bmd|0x008CCD": "「ふん、早く合体した方がいいぞ」", "Battle/Dat/Battle/Message/153.bmd|0x008CFE": "「Ｒシリーズなど相手にならん」", "Battle/Dat/Battle/Message/153.bmd|0x008D2C": "「アルトアイゼン……大したことはないな」", "Battle/Dat/Battle/Message/153.bmd|0x008D69": "「くっ！　あの突進力は……！」", "Battle/Dat/Battle/Message/153.bmd|0x008D97": "「ふん、突っ込むしか能のない機体だな」", "Battle/Dat/Battle/Message/153.bmd|0x008DD1": "「アインストなどにやられるか！」", "Battle/Dat/Battle/Message/153.bmd|0x008E02": "「シリーズ７７……それほど速くはないな」", "Battle/Dat/Battle/Message/153.bmd|0x008E3F": "「それがプロジェクトＴＤの成果か？」", "Battle/Dat/Battle/Message/153.bmd|0x008E76": "「ヒュッケバインも地に墜ちたな」", "Battle/Dat/Battle/Message/153.bmd|0x008EA7": "「見た目通りの欠陥機か」", "Battle/Dat/Battle/Message/153.bmd|0x008ECC": "「最新型のヒュッケバイン・シリーズは、/　そんなものか」", "Battle/Dat/Battle/Message/153.bmd|0x008F1F": "「所詮は旧型ベースの機体だ！」", "Battle/Dat/Battle/Message/153.bmd|0x008F4D": "「時代遅れなんだよ、ゲシュペンストは！」", "Battle/Dat/Battle/Message/153.bmd|0x008F8A": "「いつまでゲシュペンストを使うつもりだ？」", "Battle/Dat/Battle/Message/153.bmd|0x008FCA": "「ふん、何がダイゼンガーだ！」", "Battle/Dat/Battle/Message/153.bmd|0x008FF8": "「その斬艦刀は飾りか！」", "Battle/Dat/Battle/Message/153.bmd|0x00901D": "「それがダブルＧの実力か！」", "Battle/Dat/Battle/Message/153.bmd|0x009048": "「ダブルＧ……意外に非力だな」", "Battle/Dat/Battle/Message/153.bmd|0x009076": "「フッ、超闘士の名が泣くぞ」", "Battle/Dat/Battle/Message/153.bmd|0x0090A1": "「見た目通りの鈍さだな」", "Battle/Dat/Battle/Message/153.bmd|0x0090C6": "「やはり、見かけ倒しか」", "Battle/Dat/Battle/Message/153.bmd|0x0090EB": "「力押しで我らを倒せると思うな」", "Battle/Dat/Battle/Message/153.bmd|0x00911C": "「スピードだけか、サイバスター！」", "Battle/Dat/Battle/Message/153.bmd|0x009150": "「魔装機神……思っていたほどではないな」", "Battle/Dat/Battle/Message/153.bmd|0x00918D": "「魔装機神など、相手にならん！」", "Battle/Dat/Battle/Message/153.bmd|0x0091BE": "「見かけ倒しか、超機人！」", "Battle/Dat/Battle/Message/153.bmd|0x0091E6": "「何が超機人だ！　笑わせるな！」", "Battle/Dat/Battle/Message/153.bmd|0x009217": "「甘い！」", "Battle/Dat/Battle/Message/153.bmd|0x009227": "「当たるか！」", "Battle/Dat/Battle/Message/153.bmd|0x00923D": "「ガイアセイバーズを甘く見るな！」", "Battle/Dat/Battle/Message/153.bmd|0x009271": "「遅い！」", "Battle/Dat/Battle/Message/153.bmd|0x009281": "「どこを見ている！」", "Battle/Dat/Battle/Message/153.bmd|0x0092A0": "「ちゃんと狙え！」", "Battle/Dat/Battle/Message/153.bmd|0x0092BC": "「ガイアセイバーズに刃向かう愚かさを知れ！」", "Battle/Dat/Battle/Message/153.bmd|0x0092FF": "「その程度！」", "Battle/Dat/Battle/Message/153.bmd|0x009315": "「そんなもの！」", "Battle/Dat/Battle/Message/153.bmd|0x00932E": "「残念だったな！」", "Battle/Dat/Battle/Message/153.bmd|0x00934A": "「無駄だ！」", "Battle/Dat/Battle/Message/153.bmd|0x00935D": "「その手は食わんぞ！」", "Battle/Dat/Battle/Message/153.bmd|0x00937F": "「………」", "Battle/Dat/Battle/Message/153.bmd|0x00938F": "「くっ、反撃できん！」", "Battle/Dat/Battle/Message/153.bmd|0x0093B1": "「後退するしかないか！」", "Battle/Dat/Battle/Message/153.bmd|0x0093D6": "「手も足も出せんとは！」", "Battle/Dat/Battle/Message/153.bmd|0x0093FB": "「このままでは的になる！」", "Battle/Dat/Battle/Message/153.bmd|0x009423": "「奴らに乗せられたか！」", "Battle/Dat/Battle/Message/153.bmd|0x009448": "「くっ、補給せねば！」", "Battle/Dat/Battle/Message/153.bmd|0x00946A": "「うぬっ、使える武器は！？」", "Battle/Dat/Battle/Message/153.bmd|0x009495": "「くっ、この間合いでは……！」", "Battle/Dat/Battle/Message/153.bmd|0x0094C3": "「奴め、どこへ行った！？」"}