{"Battle/Dat/Battle/Message/154.bmd|0x008334": "「身の程を知れ、鋼龍戦隊！」", "Battle/Dat/Battle/Message/154.bmd|0x00835F": "「ちっ、叛乱分子共め！」", "Battle/Dat/Battle/Message/154.bmd|0x008384": "「鋼龍戦隊に後れを取るとは……！」", "Battle/Dat/Battle/Message/154.bmd|0x0083B8": "「ＳＲＸチームめ、やってくれる！」", "Battle/Dat/Battle/Message/154.bmd|0x0083EC": "「合体する前に落とさなければ……！」", "Battle/Dat/Battle/Message/154.bmd|0x008423": "「チッ！　Ｒシリーズは厄介だな！」", "Battle/Dat/Battle/Message/154.bmd|0x008457": "「くっ！　アルトアイゼンを止められん！」", "Battle/Dat/Battle/Message/154.bmd|0x008494": "「な、何という加速力だ！」", "Battle/Dat/Battle/Message/154.bmd|0x0084BC": "「うぐっ！　その杭、へし折ってやるぞ！」", "Battle/Dat/Battle/Message/154.bmd|0x0084F9": "「くっ！　アインストもどきめ！」", "Battle/Dat/Battle/Message/154.bmd|0x00852A": "「シリーズ７７……さすがのスピードだ！」", "Battle/Dat/Battle/Message/154.bmd|0x008567": "「ええい、プロジェクトＴＤの試作機などに！」", "Battle/Dat/Battle/Message/154.bmd|0x0085AA": "「くっ！　凶鳥などに！」", "Battle/Dat/Battle/Message/154.bmd|0x0085CF": "「あんな継ぎ接ぎだらけの機体に！」", "Battle/Dat/Battle/Message/154.bmd|0x008603": "「あのパワー、/　ヒュッケバインを超えている！？」", "Battle/Dat/Battle/Message/154.bmd|0x00864D": "「うぐっ！　旧型の改造機などに！」", "Battle/Dat/Battle/Message/154.bmd|0x008681": "「ゲシュペンストがここまでやるとは！」", "Battle/Dat/Battle/Message/154.bmd|0x0086BB": "「ぬうっ！　ゲシュペンストごときに！」", "Battle/Dat/Battle/Message/154.bmd|0x0086F5": "「ダイゼンガー……やはり、油断ならん！」", "Battle/Dat/Battle/Message/154.bmd|0x008732": "「ぐっ！　ダイゼンガーを甘く見たか！」", "Battle/Dat/Battle/Message/154.bmd|0x00876C": "「や、やるな、ダブルＧ！」", "Battle/Dat/Battle/Message/154.bmd|0x008794": "「うぬっ！　ダブルＧめ！」", "Battle/Dat/Battle/Message/154.bmd|0x0087BC": "「超闘士の名は伊達ではないか……！」", "Battle/Dat/Battle/Message/154.bmd|0x0087F3": "「奴め、見た目より速い！」", "Battle/Dat/Battle/Message/154.bmd|0x00881B": "「ただ大きいだけではないらしいな！」", "Battle/Dat/Battle/Message/154.bmd|0x008852": "「あ、あの特機、何というパワーだ！」", "Battle/Dat/Battle/Message/154.bmd|0x008889": "「ちっ、サイバスターめ！」", "Battle/Dat/Battle/Message/154.bmd|0x0088B1": "「ま、魔装機神……厄介な相手だ！」", "Battle/Dat/Battle/Message/154.bmd|0x0088E5": "「これが魔装機神の力か！」", "Battle/Dat/Battle/Message/154.bmd|0x00890D": "「超機人め、やってくれる！」", "Battle/Dat/Battle/Message/154.bmd|0x008938": "「超機人め、好きにはやらせんぞ！」", "Battle/Dat/Battle/Message/154.bmd|0x00896C": "「ふん、大したことはない」", "Battle/Dat/Battle/Message/154.bmd|0x008994": "「この程度の抵抗しか出来んのか」", "Battle/Dat/Battle/Message/154.bmd|0x0089C5": "「装甲をかすめた程度だ！」", "Battle/Dat/Battle/Message/154.bmd|0x0089ED": "「フッ、余裕だな」", "Battle/Dat/Battle/Message/154.bmd|0x008A09": "「何だ、もう終わりか？」", "Battle/Dat/Battle/Message/154.bmd|0x008A2E": "「ガイアセイバーズをなめるな！」", "Battle/Dat/Battle/Message/154.bmd|0x008A5F": "「練度が低い連中だな」", "Battle/Dat/Battle/Message/154.bmd|0x008A81": "「それでガイアセイバーズに/　立ち向かうなどと……」", "Battle/Dat/Battle/Message/154.bmd|0x008ACE": "「つまらん手だな」", "Battle/Dat/Battle/Message/154.bmd|0x008AEA": "「無駄な抵抗はやめろ」", "Battle/Dat/Battle/Message/154.bmd|0x008B0C": "「連邦軍やＤＣなどとは違うのだ！」", "Battle/Dat/Battle/Message/154.bmd|0x008B40": "「ＡＴＸチーム……/　もう少しやると思っていたがな」", "Battle/Dat/Battle/Message/154.bmd|0x008B8D": "「ふん、反逆者の分際で！」", "Battle/Dat/Battle/Message/154.bmd|0x008BB5": "「鋼龍戦隊……噂ほどではないな」", "Battle/Dat/Battle/Message/154.bmd|0x008BE6": "「あくまでも抗う気か、鋼龍戦隊」", "Battle/Dat/Battle/Message/154.bmd|0x008C17": "「叛乱分子が何をしようと！」", "Battle/Dat/Battle/Message/154.bmd|0x008C42": "「Ｌ５戦役の英雄も大したことはないな」", "Battle/Dat/Battle/Message/154.bmd|0x008C7C": "「それがＳＲＸチームの実力か？」", "Battle/Dat/Battle/Message/154.bmd|0x008CAD": "「ふん、早く合体した方がいいぞ」", "Battle/Dat/Battle/Message/154.bmd|0x008CDE": "「Ｒシリーズなど相手にならん」", "Battle/Dat/Battle/Message/154.bmd|0x008D0C": "「アルトアイゼン……大したことはないな」", "Battle/Dat/Battle/Message/154.bmd|0x008D49": "「くっ！　あの突進力は……！」", "Battle/Dat/Battle/Message/154.bmd|0x008D77": "「ふん、突っ込むしか能のない機体だな」", "Battle/Dat/Battle/Message/154.bmd|0x008DB1": "「アインストなどにやられるか！」", "Battle/Dat/Battle/Message/154.bmd|0x008DE2": "「シリーズ７７……それほど速くはないな」", "Battle/Dat/Battle/Message/154.bmd|0x008E1F": "「それがプロジェクトＴＤの成果か？」", "Battle/Dat/Battle/Message/154.bmd|0x008E56": "「ヒュッケバインも地に墜ちたな」", "Battle/Dat/Battle/Message/154.bmd|0x008E87": "「見た目通りの欠陥機か」", "Battle/Dat/Battle/Message/154.bmd|0x008EAC": "「最新型のヒュッケバイン・シリーズは、/　そんなものか」", "Battle/Dat/Battle/Message/154.bmd|0x008EFF": "「所詮は旧型ベースの機体だ！」", "Battle/Dat/Battle/Message/154.bmd|0x008F2D": "「時代遅れなんだよ、ゲシュペンストは！」", "Battle/Dat/Battle/Message/154.bmd|0x008F6A": "「いつまでゲシュペンストを使うつもりだ？」", "Battle/Dat/Battle/Message/154.bmd|0x008FAA": "「ふん、何がダイゼンガーだ！」", "Battle/Dat/Battle/Message/154.bmd|0x008FD8": "「その斬艦刀は飾りか！」", "Battle/Dat/Battle/Message/154.bmd|0x008FFD": "「それがダブルＧの実力か！」", "Battle/Dat/Battle/Message/154.bmd|0x009028": "「ダブルＧ……意外に非力だな」", "Battle/Dat/Battle/Message/154.bmd|0x009056": "「フッ、超闘士の名が泣くぞ」", "Battle/Dat/Battle/Message/154.bmd|0x009081": "「見た目通りの鈍さだな」", "Battle/Dat/Battle/Message/154.bmd|0x0090A6": "「やはり、見かけ倒しか」", "Battle/Dat/Battle/Message/154.bmd|0x0090CB": "「力押しで我らを倒せると思うな」", "Battle/Dat/Battle/Message/154.bmd|0x0090FC": "「スピードだけか、サイバスター！」", "Battle/Dat/Battle/Message/154.bmd|0x009130": "「魔装機神……思っていたほどではないな」", "Battle/Dat/Battle/Message/154.bmd|0x00916D": "「魔装機神など、相手にならん！」", "Battle/Dat/Battle/Message/154.bmd|0x00919E": "「見かけ倒しか、超機人！」", "Battle/Dat/Battle/Message/154.bmd|0x0091C6": "「何が超機人だ！　笑わせるな！」", "Battle/Dat/Battle/Message/154.bmd|0x0091F7": "「甘い！」", "Battle/Dat/Battle/Message/154.bmd|0x009207": "「当たるか！」", "Battle/Dat/Battle/Message/154.bmd|0x00921D": "「ガイアセイバーズを甘く見るな！」", "Battle/Dat/Battle/Message/154.bmd|0x009251": "「遅い！」", "Battle/Dat/Battle/Message/154.bmd|0x009261": "「どこを見ている！」", "Battle/Dat/Battle/Message/154.bmd|0x009280": "「ちゃんと狙え！」", "Battle/Dat/Battle/Message/154.bmd|0x00929C": "「ガイアセイバーズに刃向かう愚かさを知れ！」", "Battle/Dat/Battle/Message/154.bmd|0x0092DF": "「その程度！」", "Battle/Dat/Battle/Message/154.bmd|0x0092F5": "「そんなもの！」", "Battle/Dat/Battle/Message/154.bmd|0x00930E": "「残念だったな！」", "Battle/Dat/Battle/Message/154.bmd|0x00932A": "「無駄だ！」", "Battle/Dat/Battle/Message/154.bmd|0x00933D": "「その手は食わんぞ！」", "Battle/Dat/Battle/Message/154.bmd|0x00935F": "「………」", "Battle/Dat/Battle/Message/154.bmd|0x00936F": "「くっ、反撃できん！」", "Battle/Dat/Battle/Message/154.bmd|0x009391": "「後退するしかないか！」", "Battle/Dat/Battle/Message/154.bmd|0x0093B6": "「手も足も出せんとは！」", "Battle/Dat/Battle/Message/154.bmd|0x0093DB": "「このままでは的になる！」", "Battle/Dat/Battle/Message/154.bmd|0x009403": "「奴らに乗せられたか！」", "Battle/Dat/Battle/Message/154.bmd|0x009428": "「くっ、補給せねば！」", "Battle/Dat/Battle/Message/154.bmd|0x00944A": "「うぬっ、使える武器は！？」", "Battle/Dat/Battle/Message/154.bmd|0x009475": "「くっ、この間合いでは……！」", "Battle/Dat/Battle/Message/154.bmd|0x0094A3": "「奴め、どこへ行った！？」", "Battle/Dat/Battle/Message/154.bmd|0x0094CB": "「くそっ、どこから攻撃して来た！？」", "Battle/Dat/Battle/Message/154.bmd|0x009502": "「チッ、奴はどこにいる！？」", "Battle/Dat/Battle/Message/154.bmd|0x00952D": "「ええい、これでは狙い撃ちされる！」", "Battle/Dat/Battle/Message/154.bmd|0x009564": "「死角に入られたか！」", "Battle/Dat/Battle/Message/154.bmd|0x009586": "「続けて行く！」", "Battle/Dat/Battle/Message/154.bmd|0x00959F": "「まだ俺がいる！」", "Battle/Dat/Battle/Message/154.bmd|0x0095BB": "「逃げ損なったか！」", "Battle/Dat/Battle/Message/154.bmd|0x0095DA": "「まだ終わりじゃない！」", "Battle/Dat/Battle/Message/154.bmd|0x0095FF": "「ねじ込んでやる！」", "Battle/Dat/Battle/Message/154.bmd|0x00961E": "「よし、援護を！」", "Battle/Dat/Battle/Message/154.bmd|0x00963A": "「やらせるものか！」", "Battle/Dat/Battle/Message/154.bmd|0x009659": "「受け止めてみせる！」", "Battle/Dat/Battle/Message/154.bmd|0x00967B": "「やらせん！」", "Battle/Dat/Battle/Message/154.bmd|0x009691": "「お前の相手は俺だ！」", "Battle/Dat/Battle/Message/154.bmd|0x0096B3": "「割り込む！」", "Battle/Dat/Battle/Message/154.bmd|0x0096C9": "「俺が盾になれば！」", "Battle/Dat/Battle/Message/154.bmd|0x0096E8": "「こちらで受け止めれば！」", "Battle/Dat/Battle/Message/154.bmd|0x009710": "「運が悪かったな！」", "Battle/Dat/Battle/Message/154.bmd|0x00972F": "「こういう展開もある！」", "Battle/Dat/Battle/Message/154.bmd|0x009754": "「ふん、油断したな！」", "Battle/Dat/Battle/Message/154.bmd|0x009776": "「いい流れだ！　行ける！」", "Battle/Dat/Battle/Message/154.bmd|0x00979E": "「当たれよ！」"}