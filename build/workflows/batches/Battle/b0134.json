{"Battle/Dat/Battle/Message/066.bmd|0x0074C4": "「奴の剣に血を吸わせるわけには……！」", "Battle/Dat/Battle/Message/066.bmd|0x0074FE": "「くっ！　邪剣に打ち負けるとは！」", "Battle/Dat/Battle/Message/066.bmd|0x007532": "「この俺に当てたか……！」", "Battle/Dat/Battle/Message/066.bmd|0x00755A": "「遠慮はいらん！/　全力でかかって来るのだ！」", "Battle/Dat/Battle/Message/066.bmd|0x00759E": "「そんな甘い踏み込みで、/　俺を倒せると思うな！！」", "Battle/Dat/Battle/Message/066.bmd|0x0075EB": "「情けなど不要！！」", "Battle/Dat/Battle/Message/066.bmd|0x00760A": "「生半可な覚悟で、俺に戦いを挑むなっ！！」", "Battle/Dat/Battle/Message/066.bmd|0x00764A": "「力を出し惜しみする必要などない！！」", "Battle/Dat/Battle/Message/066.bmd|0x007684": "「浅い！　もっと打ち込んでこい！」", "Battle/Dat/Battle/Message/066.bmd|0x0076B8": "「貴様には覚悟が足りん！！」", "Battle/Dat/Battle/Message/066.bmd|0x0076E3": "「笑止！　その程度の腕で俺に挑むか！」", "Battle/Dat/Battle/Message/066.bmd|0x00771D": "「この俺を倒すには程遠い！！」", "Battle/Dat/Battle/Message/066.bmd|0x00774B": "「その程度で零式は落とせんぞ！」", "Battle/Dat/Battle/Message/066.bmd|0x00777C": "「その程度では、/　グルンガストに傷一つつけられんぞ！」", "Battle/Dat/Battle/Message/066.bmd|0x0077CF": "「参式を倒すには気合が足りん！」", "Battle/Dat/Battle/Message/066.bmd|0x007800": "「妖術に惑わされたか……」", "Battle/Dat/Battle/Message/066.bmd|0x007828": "「受け止めたぞ、ドゥバン！」", "Battle/Dat/Battle/Message/066.bmd|0x007853": "「それで俺を屠る気か、エグレッタ！」", "Battle/Dat/Battle/Message/066.bmd|0x00788A": "「エグレッタ、貴様が何をしようと！」", "Battle/Dat/Battle/Message/066.bmd|0x0078C1": "「それで終わりか、イグニス！」", "Battle/Dat/Battle/Message/066.bmd|0x0078EF": "「その炎で俺を焼き尽くすことは出来ん！」", "Battle/Dat/Battle/Message/066.bmd|0x00792C": "「貴様らがいう恐怖、大したことはないな」", "Battle/Dat/Battle/Message/066.bmd|0x007969": "「笑止なり、コンターギオ！」", "Battle/Dat/Battle/Message/066.bmd|0x007994": "「止めてみせたぞ、アクイラ！」", "Battle/Dat/Battle/Message/066.bmd|0x0079C2": "「破滅の運命を受け入れる気はない！」", "Battle/Dat/Battle/Message/066.bmd|0x0079F9": "「ロフ、その意気や良し！」", "Battle/Dat/Battle/Message/066.bmd|0x007A21": "「あの男……攻撃は迅速、正確だな」", "Battle/Dat/Battle/Message/066.bmd|0x007A55": "「効かんぞ、セティ！」", "Battle/Dat/Battle/Message/066.bmd|0x007A77": "「あくまでも抗うか、ゼゼーナン」", "Battle/Dat/Battle/Message/066.bmd|0x007AA8": "「浅いぞ、夏喃！」", "Battle/Dat/Battle/Message/066.bmd|0x007AC4": "「泰北、手加減など無用だ！」", "Battle/Dat/Battle/Message/066.bmd|0x007AEF": "「応龍の一撃、しかと受け止めた！」", "Battle/Dat/Battle/Message/066.bmd|0x007B23": "「光龍……俺の命には届かんぞ！」", "Battle/Dat/Battle/Message/066.bmd|0x007B54": "「それで終わりか、ムラタ！」", "Battle/Dat/Battle/Message/066.bmd|0x007B7F": "「効かんぞ、ジンライ！」", "Battle/Dat/Battle/Message/066.bmd|0x007BA4": "「浅いな、ジンライ！」", "Battle/Dat/Battle/Message/066.bmd|0x007BC6": "「……機忍め、そんなもので俺は倒せんぞ」", "Battle/Dat/Battle/Message/066.bmd|0x007C03": "「あの得物、油断ならんな」", "Battle/Dat/Battle/Message/066.bmd|0x007C2B": "「虎龍王ほどの速さはないな」", "Battle/Dat/Battle/Message/066.bmd|0x007C56": "「龍虎王より力は劣っているようだな」", "Battle/Dat/Battle/Message/066.bmd|0x007C8D": "「魔装機を侮ったわけではないが……」", "Battle/Dat/Battle/Message/066.bmd|0x007CC4": "「地上の兵器と遜色ないようだな」", "Battle/Dat/Battle/Message/066.bmd|0x007CF5": "「邪神よ、遠慮は無用だ！」", "Battle/Dat/Battle/Message/066.bmd|0x007D1D": "「飢えているのなら、己の身でも食らえ！」", "Battle/Dat/Battle/Message/066.bmd|0x007D5A": "「窮奇王……あの速さ、油断ならん」", "Battle/Dat/Battle/Message/066.bmd|0x007D8E": "「クストース……ここは何としても押し通る！」", "Battle/Dat/Battle/Message/066.bmd|0x007DD1": "「あの妄念に飲まれるわけにはいかん……！」", "Battle/Dat/Battle/Message/066.bmd|0x007E11": "「貴様をつなぐ全ての縁、/　ここで断ち切ってやる！」", "Battle/Dat/Battle/Message/066.bmd|0x007E5E": "「邪念に染まった剣など、その程度！」", "Battle/Dat/Battle/Message/066.bmd|0x007E95": "「邪剣でこの俺を屠ることは出来ん！」", "Battle/Dat/Battle/Message/066.bmd|0x007ECC": "「見切った！」", "Battle/Dat/Battle/Message/066.bmd|0x007EE2": "「貴様に俺と戦う資格はない！」", "Battle/Dat/Battle/Message/066.bmd|0x007F10": "「甘い！　甘いぞ！！」", "Battle/Dat/Battle/Message/066.bmd|0x007F32": "「相手にならん！！」", "Battle/Dat/Battle/Message/066.bmd|0x007F51": "「話にならん！」", "Battle/Dat/Battle/Message/066.bmd|0x007F6A": "「失せろ！」", "Battle/Dat/Battle/Message/066.bmd|0x007F7D": "「貴様ではグルンガストに追いつけまい！」", "Battle/Dat/Battle/Message/066.bmd|0x007FBA": "「参式の機動力を甘く見るな！」", "Battle/Dat/Battle/Message/066.bmd|0x007FE8": "「ダイゼンガーの相手ではない！」", "Battle/Dat/Battle/Message/066.bmd|0x008019": "「その妖術は通用せん！」", "Battle/Dat/Battle/Message/066.bmd|0x00803E": "「無駄だ、ゲスト！」", "Battle/Dat/Battle/Message/066.bmd|0x00805D": "「ゲストなどに！」", "Battle/Dat/Battle/Message/066.bmd|0x008079": "「そんなもの、恐れはせんぞ！」", "Battle/Dat/Battle/Message/066.bmd|0x0080A7": "「ガイアセイバーズなどに！」", "Battle/Dat/Battle/Message/066.bmd|0x0080D2": "「見切ったぞ、ムラタ！」", "Battle/Dat/Battle/Message/066.bmd|0x0080F7": "「木偶人形が！」", "Battle/Dat/Battle/Message/066.bmd|0x008110": "「甘いぞ、ルイーナ！」", "Battle/Dat/Battle/Message/066.bmd|0x008132": "「破滅の軍勢など！」", "Battle/Dat/Battle/Message/066.bmd|0x008151": "「力なき者は去れ！」", "Battle/Dat/Battle/Message/066.bmd|0x008170": "「修行が足りん！！」", "Battle/Dat/Battle/Message/066.bmd|0x00818F": "「出直してこい！！」", "Battle/Dat/Battle/Message/066.bmd|0x0081AE": "「物足りん！」", "Battle/Dat/Battle/Message/066.bmd|0x0081C4": "「妖の舞には惑わされん！」", "Battle/Dat/Battle/Message/066.bmd|0x0081EC": "「遅いぞ、ドゥバン！」", "Battle/Dat/Battle/Message/066.bmd|0x00820E": "「甘いぞ、エグレッタ！」", "Battle/Dat/Battle/Message/066.bmd|0x008233": "「ガイアセイバーズは烏合の衆か！」", "Battle/Dat/Battle/Message/066.bmd|0x008267": "「迅雷、我に届かず！」", "Battle/Dat/Battle/Message/066.bmd|0x008289": "「それでもダブルＧか！」", "Battle/Dat/Battle/Message/066.bmd|0x0082AE": "「機忍に後れは取らん！」", "Battle/Dat/Battle/Message/066.bmd|0x0082D3": "「妖機人など相手にならん！」", "Battle/Dat/Battle/Message/066.bmd|0x0082FE": "「それが四神の力か！」", "Battle/Dat/Battle/Message/066.bmd|0x008320": "「四凶とは名ばかりか！」", "Battle/Dat/Battle/Message/066.bmd|0x008345": "「効かんぞ！！」", "Battle/Dat/Battle/Message/066.bmd|0x00835E": "「むうん！！」", "Battle/Dat/Battle/Message/066.bmd|0x008374": "「無駄だ！！」", "Battle/Dat/Battle/Message/066.bmd|0x00838A": "「気合が足りん！！」", "Battle/Dat/Battle/Message/066.bmd|0x0083A9": "「………」", "Battle/Dat/Battle/Message/066.bmd|0x0083B9": "「打つ手なしか……！」", "Battle/Dat/Battle/Message/066.bmd|0x0083DB": "「そんな戦法で俺を倒すことは出来ん！」", "Battle/Dat/Battle/Message/066.bmd|0x008415": "「むっ！　間合いを見切ってきたか」", "Battle/Dat/Battle/Message/066.bmd|0x008449": "「助太刀する！」", "Battle/Dat/Battle/Message/066.bmd|0x008462": "「その隙は見逃さん！！」", "Battle/Dat/Battle/Message/066.bmd|0x008487": "「まだ踏み込める！！」", "Battle/Dat/Battle/Message/066.bmd|0x0084A9": "「俺を呼んだか、キョウスケ・ナンブ！」", "Battle/Dat/Battle/Message/066.bmd|0x0084E3": "「キョウスケ！　トドメは俺が刺す！」", "Battle/Dat/Battle/Message/066.bmd|0x00851A": "「エクセレン！　詰めが甘いぞ！」", "Battle/Dat/Battle/Message/066.bmd|0x00854B": "「下がれ、エクセレン！」", "Battle/Dat/Battle/Message/066.bmd|0x008570": "「いい攻撃だったぞ、ブルックリン！」", "Battle/Dat/Battle/Message/066.bmd|0x0085A7": "「助太刀するぞ、ブルックリン！」", "Battle/Dat/Battle/Message/066.bmd|0x0085D8": "「後は任せてもらおう、ギリアム」", "Battle/Dat/Battle/Message/066.bmd|0x008609": "「成すべきことは承知している！」", "Battle/Dat/Battle/Message/066.bmd|0x00863A": "「カイ少佐！　自分が助太刀を！」", "Battle/Dat/Battle/Message/066.bmd|0x00866B": "「この呼吸……昔のままだな、我が友よ！」", "Battle/Dat/Battle/Message/066.bmd|0x0086A8": "「レーツェル！　後は俺が引き受ける！」", "Battle/Dat/Battle/Message/066.bmd|0x0086E2": "「俺を呼んだか、レーツェル！」", "Battle/Dat/Battle/Message/066.bmd|0x008710": "「アラド！　お前はそのまま突撃するのだ！」", "Battle/Dat/Battle/Message/066.bmd|0x008750": "「先生、助太刀します！」", "Battle/Dat/Battle/Message/066.bmd|0x008775": "「ユウキ、後は任せろ！」", "Battle/Dat/Battle/Message/066.bmd|0x00879A": "「いい手だったぞ、ユウキ！」", "Battle/Dat/Battle/Message/066.bmd|0x0087C5": "「リルカーラ、後は俺が引き受ける！」", "Battle/Dat/Battle/Message/066.bmd|0x0087FC": "「気を散らすな、リルカーラ！」", "Battle/Dat/Battle/Message/066.bmd|0x00882A": "「ラウル、後は俺に任せるのだ！」", "Battle/Dat/Battle/Message/066.bmd|0x00885B": "「ラウル！　お前は先に行け！」", "Battle/Dat/Battle/Message/066.bmd|0x008889": "「フィオナ、後は俺が！」", "Battle/Dat/Battle/Message/066.bmd|0x0088AE": "「助太刀するぞ、ファイター・ロア！」", "Battle/Dat/Battle/Message/066.bmd|0x0088E5": "「その勢い、まさに炎の如し！」", "Battle/Dat/Battle/Message/066.bmd|0x008913": "「ジョシュア、後は任せよ！」", "Battle/Dat/Battle/Message/066.bmd|0x00893E": "「助太刀するぞ、クリアーナ！」", "Battle/Dat/Battle/Message/066.bmd|0x00896C": "「ヒューゴ、後は引き受ける！」", "Battle/Dat/Battle/Message/066.bmd|0x00899A": "「アクア、後は任せよ！」"}