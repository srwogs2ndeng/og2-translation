{"Battle/Dat/Battle/Message/227.bmd|0x000F34": "「消え去れ！」", "Battle/Dat/Battle/Message/227.bmd|0x000F4A": "「調子に乗るな！」", "Battle/Dat/Battle/Message/227.bmd|0x000F66": "「や、やられた！！」", "Battle/Dat/Battle/Message/227.bmd|0x000F85": "「だ、脱出する！」", "Battle/Dat/Battle/Message/227.bmd|0x000FA1": "「ここまでか！　脱出だ！」", "Battle/Dat/Battle/Message/227.bmd|0x000FC9": "「くそっ！　機体を破棄する！」", "Battle/Dat/Battle/Message/227.bmd|0x000FF7": "「ええい！　次はこうはいかんぞ！」", "Battle/Dat/Battle/Message/227.bmd|0x00102B": "「必ず戻ってくるぞ！！」", "Battle/Dat/Battle/Message/227.bmd|0x001050": "「な、何だとぉぉ！？」", "Battle/Dat/Battle/Message/227.bmd|0x001072": "「ぐあああっ！！」", "Battle/Dat/Battle/Message/227.bmd|0x00108E": "「い、いかん！　これ以上くらったら……」", "Battle/Dat/Battle/Message/227.bmd|0x0010CB": "「な、何！？　損傷率７０％だとっ！？」", "Battle/Dat/Battle/Message/227.bmd|0x001105": "「うぬっ！/　ここまでのダメージを受けるとは！」", "Battle/Dat/Battle/Message/227.bmd|0x00114C": "「うおあっ！　ちょ、直撃だと！？」", "Battle/Dat/Battle/Message/227.bmd|0x001180": "「まぐれ当たりで調子に乗るなよ！」", "Battle/Dat/Battle/Message/227.bmd|0x0011B4": "「チ、思った以上に出来るな！」", "Battle/Dat/Battle/Message/227.bmd|0x0011E2": "「おのれ！　やってくれる！」", "Battle/Dat/Battle/Message/227.bmd|0x00120D": "「ぐうっ！/　一発や二発、食らったぐらいで！」", "Battle/Dat/Battle/Message/227.bmd|0x001251": "「ぬうっ！　こちらを甘く見るなよ！！」", "Battle/Dat/Battle/Message/227.bmd|0x00128B": "「ふん！　口ほどでもない！」", "Battle/Dat/Battle/Message/227.bmd|0x0012B6": "「こちらの力をなめているのか！？」", "Battle/Dat/Battle/Message/227.bmd|0x0012EA": "「無駄なあがきだ！」", "Battle/Dat/Battle/Message/227.bmd|0x001309": "「その程度で我々に刃向かうとは！」", "Battle/Dat/Battle/Message/227.bmd|0x00133D": "「無駄な抵抗は見苦しいぞ！」", "Battle/Dat/Battle/Message/227.bmd|0x001368": "「ダメージ軽微……作戦を続行する！」", "Battle/Dat/Battle/Message/227.bmd|0x00139F": "「ふん……チェックの必要もない程度か……」", "Battle/Dat/Battle/Message/227.bmd|0x0013DF": "「かわした！」", "Battle/Dat/Battle/Message/227.bmd|0x0013F5": "「モーションが大きすぎるんだよ！」", "Battle/Dat/Battle/Message/227.bmd|0x001429": "「遅いっ！」", "Battle/Dat/Battle/Message/227.bmd|0x00143C": "「照準がずれているようだな」", "Battle/Dat/Battle/Message/227.bmd|0x001467": "「よし、回避成功だ！」", "Battle/Dat/Battle/Message/227.bmd|0x001489": "「その程度！」", "Battle/Dat/Battle/Message/227.bmd|0x00149F": "「そんなもの！」", "Battle/Dat/Battle/Message/227.bmd|0x0014B8": "「残念だったな！」", "Battle/Dat/Battle/Message/227.bmd|0x0014D4": "「無駄だ！」", "Battle/Dat/Battle/Message/227.bmd|0x0014E7": "「………」", "Battle/Dat/Battle/Message/227.bmd|0x0014F7": "「くっ、補給を！」", "Battle/Dat/Battle/Message/227.bmd|0x001513": "「長期戦では不利か！」", "Battle/Dat/Battle/Message/227.bmd|0x001535": "「反撃できんとはな……！」", "Battle/Dat/Battle/Message/227.bmd|0x00155D": "「手も足も出させんつもりか！」", "Battle/Dat/Battle/Message/227.bmd|0x00158B": "「た、弾切れだと……！？」", "Battle/Dat/Battle/Message/227.bmd|0x0015B3": "「くっ、この間合いでは……！」", "Battle/Dat/Battle/Message/227.bmd|0x0015E1": "「ここからでは反撃できん！」", "Battle/Dat/Battle/Message/227.bmd|0x00160C": "「反撃不可能だと！？」", "Battle/Dat/Battle/Message/227.bmd|0x00162E": "「くそっ！　これじゃ狙い撃ちされる！」", "Battle/Dat/Battle/Message/227.bmd|0x001668": "「いかん！　これではただの標的だ！」", "Battle/Dat/Battle/Message/227.bmd|0x00169F": "「な、何も出来ないのか……！？」", "Battle/Dat/Battle/Message/227.bmd|0x0016D0": "「よし、援護するぞ！」", "Battle/Dat/Battle/Message/227.bmd|0x0016F2": "「よそ見している暇はないぞ！」", "Battle/Dat/Battle/Message/227.bmd|0x001720": "「この連携がかわせるか！」", "Battle/Dat/Battle/Message/227.bmd|0x001748": "「これでとどめだ！」", "Battle/Dat/Battle/Message/227.bmd|0x001767": "「確実に倒しておかねば！」", "Battle/Dat/Battle/Message/227.bmd|0x00178F": "「フン、逃げ損なったな！」", "Battle/Dat/Battle/Message/227.bmd|0x0017B7": "「下がれ！」", "Battle/Dat/Battle/Message/227.bmd|0x0017CA": "「やらせん！」", "Battle/Dat/Battle/Message/227.bmd|0x0017E0": "「思うようにはさせん！」", "Battle/Dat/Battle/Message/227.bmd|0x001805": "「早く後退しろ！」", "Battle/Dat/Battle/Message/227.bmd|0x001821": "「落とさせるか！」", "Battle/Dat/Battle/Message/227.bmd|0x00183D": "「今の内に後退を！」", "Battle/Dat/Battle/Message/227.bmd|0x00185C": "「馬鹿め、油断したな！」", "Battle/Dat/Battle/Message/227.bmd|0x001881": "「一網打尽にしてやる！」", "Battle/Dat/Battle/Message/227.bmd|0x0018A6": "「くらえ！」", "Battle/Dat/Battle/Message/227.bmd|0x0018B9": "「我らの邪魔をするか！」", "Battle/Dat/Battle/Message/227.bmd|0x0018DE": "「やってやる！　やってやるぞ！」", "Battle/Dat/Battle/Message/227.bmd|0x00190F": "「貴様らの好きにはやらせんぞ！」", "Battle/Dat/Battle/Message/227.bmd|0x001940": "「落ちろっ！」", "Battle/Dat/Battle/Message/227.bmd|0x001956": "「何としても落とす！」", "Battle/Dat/Battle/Message/228.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/229.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/230.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/231.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/232.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/233.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/234.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/235.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/235.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/235.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/235.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/235.bmd|0x0003FC": "「………？」", "Battle/Dat/Battle/Message/236.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/237.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/238.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/239.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/240.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/241.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/242.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/243.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/244.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/244.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/244.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/244.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/244.bmd|0x0003FC": "「………？」", "Battle/Dat/Battle/Message/245.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/246.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/247.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/247.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/247.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/247.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/247.bmd|0x0003FC": "「………？」", "Battle