{"Battle/Dat/Battle/Message/051.bmd|0x009F19": "「ブーストハンマー！/　いつもより回っております！」", "Battle/Dat/Battle/Message/051.bmd|0x009F66": "「種明かしはしねえぜ！/　くらえ、リープ・スラッシャー！」", "Battle/Dat/Battle/Message/051.bmd|0x009FBC": "「行ってこい！　リープ・スラッシャー！」", "Battle/Dat/Battle/Message/051.bmd|0x009FF9": "「シシオウブレード！　一刀両断だ！」", "Battle/Dat/Battle/Message/051.bmd|0x00A030": "「と言いつつ、メッタ斬りぃぃぃぃっ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A06D": "「結果オーライ！」", "Battle/Dat/Battle/Message/051.bmd|0x00A089": "「試してみるかい、ロシアン・ルーレット！」", "Battle/Dat/Battle/Message/051.bmd|0x00A0C9": "「ところがどっこい！」", "Battle/Dat/Battle/Message/051.bmd|0x00A0EB": "「外れはねえんだ、こいつが！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A11C": "「ここ一番の大勝負、大博打！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A14D": "「そうれ、フィーバー！」", "Battle/Dat/Battle/Message/051.bmd|0x00A172": "「こいつがアルトの切り札だ！」", "Battle/Dat/Battle/Message/051.bmd|0x00A1A0": "「クレイモア！」", "Battle/Dat/Battle/Message/051.bmd|0x00A1B9": "「打ち止めと見せかけて！」", "Battle/Dat/Battle/Message/051.bmd|0x00A1E1": "「またまたフィーバー！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A209": "「もってけドロボー！　コンチキショー！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A249": "「こいつは本物のクレイモアだぜ。/　え～、リアルなクレイモア、ってね！」", "Battle/Dat/Battle/Message/051.bmd|0x00A2B4": "「プラズマホーン！」", "Battle/Dat/Battle/Message/051.bmd|0x00A2D3": "「まだまだ！」", "Battle/Dat/Battle/Message/051.bmd|0x00A2E9": "「必殺！/　リボルビング・バンカァァァァッ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A330": "「何が飛び出すかは見てのお楽しみ！」", "Battle/Dat/Battle/Message/051.bmd|0x00A367": "「答えはこいつだ！」", "Battle/Dat/Battle/Message/051.bmd|0x00A386": "「だだだだだだっ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A3A8": "「オープン・ザ・ブレード・サイ！」", "Battle/Dat/Battle/Message/051.bmd|0x00A3DC": "「いつもより多く回しております！」", "Battle/Dat/Battle/Message/051.bmd|0x00A410": "「そーれ！　ドビンドビン！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A43E": "「ギャラは同じでい！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A463": "「ブレード・サイ、セット！」", "Battle/Dat/Battle/Message/051.bmd|0x00A48E": "「だだだだだだだっ」", "Battle/Dat/Battle/Message/051.bmd|0x00A4AD": "「チェンジ・ラプター！　スイッチ・ドン！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A4F0": "「打ち止めなんか怖くねえ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A51E": "「つーか、まだ弾あんのかよっ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A552": "「うなれ鉄拳！」", "Battle/Dat/Battle/Message/051.bmd|0x00A56B": "「ジェット・マグナム！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A593": "「あらよっと！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A5AF": "「そうら、ブチ抜けぇぇぇ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A5DD": "「必殺！　音速鉄拳スペシャル！」", "Battle/Dat/Battle/Message/051.bmd|0x00A60E": "「だだだだだだだっ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A633": "「どっせえい！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A64F": "「目が飛び出るだけじゃすまねえぜ！」", "Battle/Dat/Battle/Message/051.bmd|0x00A686": "「そうら！　メガ・ブラスターキャノン！」", "Battle/Dat/Battle/Message/051.bmd|0x00A6C3": "「超必殺、超音幽霊！　意味わかんねえ！」", "Battle/Dat/Battle/Message/051.bmd|0x00A700": "「まだまだまだまだぁっ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A72B": "「フィニッシュ・ブロー！」", "Battle/Dat/Battle/Message/051.bmd|0x00A753": "「ハリケーン・タイフーン！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A781": "「こいつでブッ飛べ、ビームカノン！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A7BB": "「こいつはレアな武器だぜ！」", "Battle/Dat/Battle/Message/051.bmd|0x00A7E6": "「もういっちょ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A805": "「砕け鉄拳！　ハイパー・ブーストナックル！」", "Battle/Dat/Battle/Message/051.bmd|0x00A848": "「あんたの正面、すすけさせてやるぜ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A885": "「アルティメット・ビーム！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A8B3": "「あんたの運命、決まったぜ！」", "Battle/Dat/Battle/Message/051.bmd|0x00A8E1": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A8FC": "「暗殺剣！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A912": "「斬ッ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A925": "「……っと、暗剣殺だったな」", "Battle/Dat/Battle/Message/051.bmd|0x00A950": "「あんたの運命、決まったぜ！/　急転直下でドツボ行き！」", "Battle/Dat/Battle/Message/051.bmd|0x00A9A3": "「五！」", "Battle/Dat/Battle/Message/051.bmd|0x00A9B0": "「黄！」", "Battle/Dat/Battle/Message/051.bmd|0x00A9BD": "「殺！！」", "Battle/Dat/Battle/Message/051.bmd|0x00A9CD": "「アン！」", "Battle/Dat/Battle/Message/051.bmd|0x00A9DD": "「ポン！」", "Battle/Dat/Battle/Message/051.bmd|0x00A9ED": "「タン！！」", "Battle/Dat/Battle/Message/051.bmd|0x00AA00": "「せーの！」", "Battle/Dat/Battle/Message/051.bmd|0x00AA13": "「チャー！」", "Battle/Dat/Battle/Message/051.bmd|0x00AA26": "「シュー！！」", "Battle/Dat/Battle/Message/051.bmd|0x00AA3C": "「……俺もな、決める時は決めるぜ！」", "Battle/Dat/Battle/Message/051.bmd|0x00AA73": "「ガッチョーーン！！」", "Battle/Dat/Battle/Message/051.bmd|0x00AA95": "「……っと、五黄殺だったな」", "Battle/Dat/Battle/Message/051.bmd|0x00AAC0": "「メーーーーン！！」", "Battle/Dat/Battle/Message/051.bmd|0x00AADF": "「餃子と炒飯も持ってこい！」", "Battle/Dat/Battle/Message/051.bmd|0x00AB0A": "「ツイン・ビームキャノン、発射！！」", "Battle/Dat/Battle/Message/051.bmd|0x00AB41": "「スパイラル・ブレイカー！」", "Battle/Dat/Battle/Message/051.bmd|0x00AB6C": "「いつもより多く回ってやるぜぇ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00ABA3": "「オメガ・キャノンだ！」", "Battle/Dat/Battle/Message/051.bmd|0x00ABC8": "「そうら、全部持ってけ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00ABF3": "「ついでに俺も持ってけぇ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00AC21": "「やるぜぇ！/　Ｇコンビネーション・アタック！」", "Battle/Dat/Battle/Message/051.bmd|0x00AC68": "「トリはもらったぁぁぁっ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00AC96": "「参式必殺剣、獅子王刀！　またの名を！」", "Battle/Dat/Battle/Message/051.bmd|0x00ACD3": "「ライオン・キング・ブレード！！」", "Battle/Dat/Battle/Message/051.bmd|0x00AD07": "「そおりゃああああ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00AD2C": "「一刀両断！！」", "Battle/Dat/Battle/Message/051.bmd|0x00AD45": "「さあて、今度は一発で決めるぜ！」", "Battle/Dat/Battle/Message/051.bmd|0x00AD79": "「獅子王刀、歳破！！」", "Battle/Dat/Battle/Message/051.bmd|0x00AD9B": "「そうら、ボヤボヤしてると！！」", "Battle/Dat/Battle/Message/051.bmd|0x00ADCC": "「前からバッサリだぁぁぁぁ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00ADFD": "「いい斬れ味だったぜ！」", "Battle/Dat/Battle/Message/051.bmd|0x00AE22": "「どっちもそっちもあっちもこっちも！」", "Battle/Dat/Battle/Message/051.bmd|0x00AE5C": "「えーい、出血大サービスだ！　くらえっ！！」", "Battle/Dat/Battle/Message/051.bmd|0x00AE9F": "「半端ねえ賭け金なんだからな……/　当たらなきゃ、大損だぜ！」", "Battle/Dat/Battle/Message/051.bmd|0x00AEFB": "「さあて、種も仕掛けもありまくり！」", "Battle/Dat/Battle/Message/051.bmd|0x00AF32": "「気づいた時にゃ、もう遅いぜ！」", "Battle/Dat/Battle/Message/052.bmd|0x0054CD": "「この一撃で！」", "Battle/Dat/Battle/Message/052.bmd|0x0054E6": "「そこよ！」", "Battle/Dat/Battle/Message/052.bmd|0x0054F9": "「私の一撃を受け止めることが出来て？」", "Battle/Dat/Battle/Message/052.bmd|0x005533": "「無駄なあがきはよしなさい！」", "Battle/Dat/Battle/Message/052.bmd|0x005561": "「あなたはここまでよ！」", "Battle/Dat/Battle/Message/052.bmd|0x005586": "「私から逃げられると思って？」", "Battle/Dat/Battle/Message/052.bmd|0x0055B4": "「直撃させる！」", "Battle/Dat/Battle/Message/052.bmd|0x0055CD": "「フッ……遅いわね」", "Battle/Dat/Battle/Message/052.bmd|0x0055EC": "「行くわよ！」", "Battle/Dat/Battle/Message/052.bmd|0x005602": "「沈みなさい！」", "Battle/Dat/Battle/Message/052.bmd|0x00561B": "「あなた、運がなかったわね……！」", "Battle/Dat/Battle/Message/052.bmd|0x00564F": "「邪魔よ！」", "Battle/Dat/Battle/Message/052.bmd|0x005662": "「あなたに逃げ場はないわ！」", "Battle/Dat/Battle/Message/052.bmd|0x00568D": "「覚悟はいいかしら？」", "Battle/Dat/Battle/Message/052.bmd|0x0056AF": "「あなたに私の動きが見切れて？」", "Battle/Dat/Battle/Message/052.bmd|0x0056E0": "「私の前から消え去りなさい！」", "Battle/Dat/Battle/Message/052.bmd|0x00570E": "「駆けなさい、勝者となるために！」", "Battle/Dat/Battle/Message/052.bmd|0x005742": "「私が望む結果は一つよ」", "Battle/Dat/Battle/Message/052.bmd|0x005767": "「追い詰めるわ……あなたを」", "Battle/Dat/Battle/Message/052.bmd|0x005792": "「駆けなさい、Ｍｋ‐Ⅲ！」", "Battle/Dat/Battle/Message/052.bmd|0x0057BA": "「凶鳥の力、見せてあげるわ！」", "Battle/Dat/Battle/Message/052.bmd|0x0057E8": "「新たな使命のために……！/　行きなさい、ジガンスクード！」", "Battle/Dat/Battle/Message/052.bmd|0x005841": "「スレイ、私を捉えられて？」", "Battle/Dat/Battle/Message/052.bmd|0x00586C": "「彗星はどこを目指して飛んでいるのかしら？」", "Battle/Dat/Battle/Message/052.bmd|0x0058AF": "「成すべきことを見失っているようね、スレイ」", "Battle/Dat/Battle/Message/052.bmd|0x0058F2": "「行くわよ、ロフ」", "Battle/Dat/Battle/Message/052.bmd|0x00590E": "「頭を抑える……！」"}