{"Battle/Dat/Battle/Message/039.bmd|0x009E8A": "「スタッグビートル・クラッシャー！」", "Battle/Dat/Battle/Message/039.bmd|0x009EC1": "「身軽になりますっ！」", "Battle/Dat/Battle/Message/039.bmd|0x009EE3": "「飛んで！　ビルガー！」", "Battle/Dat/Battle/Message/039.bmd|0x009F08": "「もっと速く！！」", "Battle/Dat/Battle/Message/039.bmd|0x009F24": "「まだ行きますっ！！」", "Battle/Dat/Battle/Message/039.bmd|0x009F46": "「ええーいっ！！」", "Battle/Dat/Battle/Message/039.bmd|0x009F62": "「これならＥモードの方で……いきますっ！」", "Battle/Dat/Battle/Message/039.bmd|0x009FA2": "「この距離なら……いけるはず！」", "Battle/Dat/Battle/Message/039.bmd|0x009FD3": "「照準内に入った……いきますっ！」", "Battle/Dat/Battle/Message/039.bmd|0x00A007": "「同時に撃ちますっ！！」", "Battle/Dat/Battle/Message/039.bmd|0x00A02C": "「ギガ・サークルブラスター！」", "Battle/Dat/Battle/Message/039.bmd|0x00A05A": "「ギガ・ワイドブラスター！」", "Battle/Dat/Battle/Message/039.bmd|0x00A085": "「守るだけじゃ駄目……！　攻撃しなきゃ！」", "Battle/Dat/Battle/Message/039.bmd|0x00A0C5": "「行きます！　ジガンテ・ウンギア！！」", "Battle/Dat/Battle/Message/039.bmd|0x00A0FF": "「ハルバート・ランチャー！」", "Battle/Dat/Battle/Message/039.bmd|0x00A12A": "「撃ちますっ！！」", "Battle/Dat/Battle/Message/039.bmd|0x00A146": "「狙いはつきました！」", "Battle/Dat/Battle/Message/039.bmd|0x00A168": "「行って！　ソードブレイカー！！」", "Battle/Dat/Battle/Message/039.bmd|0x00A19C": "「ブリット君のようには/　いかないかも知れないけど……！」", "Battle/Dat/Battle/Message/039.bmd|0x00A1F2": "「シシオウブレード！！」", "Battle/Dat/Battle/Message/039.bmd|0x00A217": "「ええええーいっ！」", "Battle/Dat/Battle/Message/039.bmd|0x00A236": "「終わりよっ！」", "Battle/Dat/Battle/Message/039.bmd|0x00A24F": "「行って！」", "Battle/Dat/Battle/Message/039.bmd|0x00A262": "「スラッシュ・リッパー！！」", "Battle/Dat/Battle/Message/039.bmd|0x00A28D": "「お願い！」", "Battle/Dat/Battle/Message/039.bmd|0x00A2A0": "「お願い！　リープ・スラッシャー！！」", "Battle/Dat/Battle/Message/039.bmd|0x00A2DA": "「リープ・スラッシャー！　行って！！」", "Battle/Dat/Battle/Message/039.bmd|0x00A314": "「グラビトン・ランチャー、/　発射しますっ！！」", "Battle/Dat/Battle/Message/039.bmd|0x00A35B": "「ラスタバン・ビーム！！」", "Battle/Dat/Battle/Message/039.bmd|0x00A383": "「破邪の光よ、敵を撃て！！」", "Battle/Dat/Battle/Message/039.bmd|0x00A3AE": "「ファイヤー・ブレス！！」", "Battl