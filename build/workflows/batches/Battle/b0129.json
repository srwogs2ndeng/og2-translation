{"Battle/Dat/Battle/Message/063.bmd|0x0108B2": "「マニューバーＧＲａＭＸｓ！/　フィニッシュ！！」", "Battle/Dat/Battle/Message/063.bmd|0x0108FC": "「ＧＲａＭＸｓ、フィニッシュ！/　フル・シューーートッ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010955": "「タイミングは/　ソニック・ブレイカーと同じ……！」", "Battle/Dat/Battle/Message/063.bmd|0x0109A2": "「ソニック・ブーストキック！/　そこだーっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x0109E9": "「格闘は苦手でも、ぶつかるぐらいなら……！」", "Battle/Dat/Battle/Message/063.bmd|0x010A2C": "「ソニック・ブーストキィィィックッ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010A69": "「同じリオン系なんだ……やってみせる！」", "Battle/Dat/Battle/Message/063.bmd|0x010AA6": "「このスピード……使いこなしてみせる！！」", "Battle/Dat/Battle/Message/063.bmd|0x010AE6": "「ソニック・アクセラレーション！/　ゴーッ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010B2D": "「いけーっ！/　ソニック・アクセラレーション！！」", "Battle/Dat/Battle/Message/063.bmd|0x010B77": "「この距離なら、これで！」", "Battle/Dat/Battle/Message/063.bmd|0x010B9F": "「照準補正！　ロック！！」", "Battle/Dat/Battle/Message/063.bmd|0x010BC7": "「当たればいける！！」", "Battle/Dat/Battle/Message/063.bmd|0x010BE9": "「当たる距離まで詰めれば！」", "Battle/Dat/Battle/Message/063.bmd|0x010C14": "「切り裂け！　ファング・スラッシャー！！」", "Battle/Dat/Battle/Message/063.bmd|0x010C54": "「一気に決めるよ！」", "Battle/Dat/Battle/Message/063.bmd|0x010C73": "「吹っ飛べーっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010C92": "「オメガ・ブラスター！　当たれーっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010CCF": "「一気に間合いに飛び込む！」", "Battle/Dat/Battle/Message/063.bmd|0x010CFA": "「いけーっ！！　コールドメタルソード！！」", "Battle/Dat/Battle/Message/063.bmd|0x010D3A": "「スタッグビートル・クラッシャー、展開！」", "Battle/Dat/Battle/Message/063.bmd|0x010D7A": "「行くよ、ビルガー！」", "Battle/Dat/Battle/Message/063.bmd|0x010D9C": "「フィニッシュ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010DBB": "「高機動モードシフト！」", "Battle/Dat/Battle/Message/063.bmd|0x010DE0": "「ブースト・オン！　距離を詰める！」", "Battle/Dat/Battle/Message/063.bmd|0x010E17": "「ブレイク！」", "Battle/Dat/Battle/Message/063.bmd|0x010E2D": "「ビルガー、いけーっ！」", "Battle/Dat/Battle/Message/063.bmd|0x010E52": "「ターゲット・マルチ・ロック！/　そこだっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010E99": "「これだけ撃てば一発ぐらいは当たる！/　……はずだ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010EEC": "「そこだーっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010F08": "「まとめて相手をする！」", "Battle/Dat/Battle/Message/063.bmd|0x010F2D": "「接近戦に弱気は禁物！」", "Battle/Dat/Battle/Message/063.bmd|0x010F52": "「巨体に見合うパワーがあるんだ！」", "Battle/Dat/Battle/Message/063.bmd|0x010F86": "「ジガンテ・ウンギア！　吹っ飛べーっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x010FC6": "「ターゲット・インサイト！」", "Battle/Dat/Battle/Message/063.bmd|0x010FF1": "「ソードブレイカー！　ゴーッ！！」", "Battle/Dat/Battle/Message/063.bmd|0x011025": "「えい！　えい！　えぇいっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x011056": "「いけっ！　シシオウブレード！！」", "Battle/Dat/Battle/Message/063.bmd|0x01108A": "「ダッシュだ！」", "Battle/Dat/Battle/Message/063.bmd|0x0110A3": "「リボルビング・バンカー！！」", "Battle/Dat/Battle/Message/063.bmd|0x0110D1": "「ブーストッ！」", "Battle/Dat/Battle/Message/063.bmd|0x0110EA": "「今だ！　クレイモア！」", "Battle/Dat/Battle/Message/063.bmd|0x01110F": "「飛んでけっ！」", "Battle/Dat/Battle/Message/063.bmd|0x011128": "「当たれ、当たれっ！」", "Battle/Dat/Battle/Message/063.bmd|0x01114A": "「とどめっ！　リボルビング・バンカー！！」", "Battle/Dat/Battle/Message/063.bmd|0x01118A": "「弱気になってる場合じゃない！」", "Battle/Dat/Battle/Message/063.bmd|0x0111BB": "「トンファー・セット！」", "Battle/Dat/Battle/Message/063.bmd|0x0111E0": "「ブレード・サイ、アクティブ！」", "Battle/Dat/Battle/Message/063.bmd|0x011211": "「セット！」", "Battle/Dat/Battle/Message/063.bmd|0x011224": "「やぁーっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x01123D": "「ラプターなら、あれが出来る……！」", "Battle/Dat/Battle/Message/063.bmd|0x011274": "「まずは足を止める！」", "Battle/Dat/Battle/Message/063.bmd|0x011296": "「行くよ、マニューバーＲａＭＶｓ！/　ＲＴアレンジ！」", "Battle/Dat/Battle/Message/063.bmd|0x0112E6": "「決めるっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x0112FF": "「当たれ！　当たれーっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x01132A": "「プラズマ・ステーク、セット！」", "Battle/Dat/Battle/Message/063.bmd|0x01135B": "「ジェット・マグナム！！」", "Battle/Dat/Battle/Message/063.bmd|0x011383": "「ロングレンジ・モードで！」", "Battle/Dat/Battle/Message/063.bmd|0x0113AE": "「ファイヤッ！！」", "Battle/Dat/Battle/Message/063.bmd|0x0113CA": "「はあああっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x0113E6": "「ええいっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x0113FF": "「メガ・ブラスターキャノン！」", "Battle/Dat/Battle/Message/063.bmd|0x01142D": "「行くよ、ゲシュペンスト！」", "Battle/Dat/Battle/Message/063.bmd|0x011458": "「あたしだって……！」", "Battle/Dat/Battle/Message/063.bmd|0x01147A": "「やってみせるんだ！」", "Battle/Dat/Battle/Message/063.bmd|0x01149C": "「とどめだ！」", "Battle/Dat/Battle/Message/063.bmd|0x0114B2": "「ジェット・ファントム！！」", "Battle/Dat/Battle/Message/063.bmd|0x0114DD": "「ダーク・ロック！」", "Battle/Dat/Battle/Message/063.bmd|0x0114FC": "「まだまだ！！」", "Battle/Dat/Battle/Message/063.bmd|0x011515": "「最後はパンチだっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x01153A": "「ハイパー・ブーストナックル！」", "Battle/Dat/Battle/Message/063.bmd|0x01156B": "「行けぇぇぇっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x01158A": "「行け、アルティメット・ビーム！！」", "Battle/Dat/Battle/Message/063.bmd|0x0115C1": "「やるよ、グルンガスト改！」", "Battle/Dat/Battle/Message/063.bmd|0x0115EC": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/063.bmd|0x011607": "「暗剣殺！！」", "Battle/Dat/Battle/Message/063.bmd|0x01161D": "「たああああああっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x011642": "「やった……！」", "Battle/Dat/Battle/Message/063.bmd|0x01165B": "「グルンガスト改、ファイナルアタック！」", "Battle/Dat/Battle/Message/063.bmd|0x011698": "「五！」", "Battle/Dat/Battle/Message/063.bmd|0x0116A5": "「黄！」", "Battle/Dat/Battle/Message/063.bmd|0x0116B2": "「殺っ！！」", "Battle/Dat/Battle/Message/063.bmd|0x0116C5": "「はあああーーっ！！」", "Battle/Dat/Battle/Message/063.bmd|0x0116E7": "「終わりだよ！」", "Battle/Dat/Battle/Message/063.bmd|0x011700": "「コツはソニック・ブレイカーと同じだ！」", "Battle/Dat/Battle/Message/063.bmd|0x01173D": "「スパイラル！　ゴーーーッ！！」", "Battle/Dat/Battle/Message/063.bmd|0x01176E": "「一斉攻撃！　やってみせる！」", "Battle/Dat/Battle/Message/063.bmd|0x01179C": "「全速でぶつかるっ！」", "Battle/Dat/Battle/Message/063.bmd|0x0117BE": "「ラプターとバイソンのコンビネーションで！」", "Battle/Dat/Battle/Message/063.bmd|0x011801": "「ドリル・アタッカー！！」", "Battle/Dat/Battle/Message/063.bmd|0x011829": "「参式、ファイナルアタック！」", "Battle/Dat/Battle/Message/063.bmd|0x011857": "「獅子王刀、歳破！！」", "Battle/Dat/Battle/Message/063.bmd|0x011879": "「やれたよ、参式！」", "Battle/Dat/Battle/Message/063.bmd|0x011898": "「ＭＴＤ誘導弾、ファイヤ！」", "Battle/Dat/Battle/Message/063.bmd|0x0118C3": "「こいつはテスラ・ドライブそのものだ！/　かわせるものか！！」", "Battle/Dat/Battle/Message/063.bmd|0x01191F": "「イルミネーター・リンク！」", "Battle/Dat/Battle/Message/063.bmd|0x01194A": "「こいつからは逃げられないよ！」", "Battle/Dat/Battle/Message/064.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/065.bmd|0x0041FF": "「私の前に立った不幸を悔いろ！」", "Battle/Dat/Battle/Message/065.bmd|0x004230": "「こちらスレイ・プレスティ、/　攻撃を開始する！」", "Battle/Dat/Battle/Message/065.bmd|0x00427A": "「ナンバー０１は伊達ではない！」", "Battle/Dat/Battle/Message/065.bmd|0x0042AB": "「来るなら来い！/　相手が誰であろうと受けて立つ！」", "Battle/Dat/Battle/Message/065.bmd|0x0042F8": "「見せてやろう。実力の違いというものを！」", "Battle/Dat/Battle/Message/065.bmd|0x004338": "「この距離……もらう！」", "Battle/Dat/Battle/Message/065.bmd|0x00435D": "「私は彗星になる……！」", "Battle/Dat/Battle/Message/065.bmd|0x004382": "「私とベガリオンに敵はいない！」", "Battle/Dat/Battle/Message/065.bmd|0x0043B3": "「ＴＤのエースは誰なのか教えてやる！」", "Battle/Dat/Battle/Message/065.bmd|0x0043ED": "「スピードでベガリオンに勝てると思うな！」", "Battle/Dat/Battle/Message/065.bmd|0x00442D": "「このスピードについてこられるか！」", "Battle/Dat/Battle/Message/065.bmd|0x004464": "「兄様の設計した機体だ。使いこなすさ！」", "Battle/Dat/Battle/Message/065.bmd|0x0044A1": "「見せてやるぞ。/　テスラ・ドライブの使い方というものを！」", "Battle/Dat/Battle/Message/065.bmd|0x0044FA": "「パーソナルトルーパーだろうと/　この私の腕ならば！」", "Battle/Dat/Battle/Message/065.bmd|0x00454A": "「力で押し切るのも、また一興か……！」", "Battle/Dat/Battle/Message/065.bmd|0x004584": "「破壊力は折り紙つきだ！　いくぞ！！」", "Battle/Dat/Battle/Message/065.bmd|0x0045BE": "「お前達が与える絶望などに屈するか！」", "Battle/Dat/Battle/Message/065.bmd|0x0045F8": "「メリオルエッセ！　私が恐怖を与えてやる！」", "Battle/Dat/Battle/Message/065.bmd|0x00463B": "「ペルフェクティオ！/　この世界から消え失せろ！」", "Battle/Dat/Battle/Message/065.bmd|0x004685": "「ゼゼーナン！　その野望と共に果てろ！」", "Battle/Dat/Battle/Message/065.bmd|0x0046C2": "「お前にアルテリオンに乗る資格はない！」", "Battle/Dat/Battle/Message/065.bmd|0x0046FF": "「アイビス！　実力の違いを見せてやる！」"}