{"Battle/Dat/Battle/Message/257.bmd|0x002865": "「ロックオン」", "Battle/Dat/Battle/Message/257.bmd|0x00287B": "「ロックしちゃったしな……」", "Battle/Dat/Battle/Message/257.bmd|0x0028A6": "「こういうモーションだし」", "Battle/Dat/Battle/Message/257.bmd|0x0028CE": "「叫んだりするの、面倒だし」", "Battle/Dat/Battle/Message/257.bmd|0x0028F9": "「これで死んでよね」", "Battle/Dat/Battle/Message/257.bmd|0x002918": "「まずはこれ」", "Battle/Dat/Battle/Message/257.bmd|0x00292E": "「次はこれ」", "Battle/Dat/Battle/Message/257.bmd|0x002941": "「早めに死んでくれると嬉しいな」", "Battle/Dat/Battle/Message/257.bmd|0x002972": "「無駄が多いんだよね、この攻撃」", "Battle/Dat/Battle/Message/257.bmd|0x0029A3": "「フィールド展開」", "Battle/Dat/Battle/Message/257.bmd|0x0029BF": "「こういう動きとか」", "Battle/Dat/Battle/Message/257.bmd|0x0029DE": "「この連撃パターンとかさ」", "Battle/Dat/Battle/Message/257.bmd|0x002A06": "「いちいち面倒」", "Battle/Dat/Battle/Message/257.bmd|0x002A1F": "「まあ、どうでもいいけど」", "Battle/Dat/Battle/Message/257.bmd|0x002A47": "「これで逝っちゃってよ」", "Battle/Dat/Battle/Message/257.bmd|0x002A6C": "「回り込み」", "Battle/Dat/Battle/Message/257.bmd|0x002A7F": "「ここで連続攻撃」", "Battle/Dat/Battle/Message/257.bmd|0x002A9B": "「まだ続くし」", "Battle/Dat/Battle/Message/257.bmd|0x002AB1": "「さて、そろそろ」", "Battle/Dat/Battle/Message/257.bmd|0x002ACD": "「死んじゃってよね」", "Battle/Dat/Battle/Message/257.bmd|0x002AEC": "「あたしら３人で奴を噛み砕くよ！」", "Battle/Dat/Battle/Message/257.bmd|0x002B20": "「おう！」", "Battle/Dat/Battle/Message/257.bmd|0x002B30": "「……僕一人でもいいんだけどな」", "Battle/Dat/Battle/Message/257.bmd|0x002B61": "「ほらほら！！」", "Battle/Dat/Battle/Message/257.bmd|0x002B7A": "「踊れ、踊れ！！」", "Battle/Dat/Battle/Message/257.bmd|0x002B96": "「弾の無駄遣いだよね、これ」", "Battle/Dat/Battle/Message/257.bmd|0x002BC1": "「上昇する！」", "Battle/Dat/Battle/Message/257.bmd|0x002BD7": "「ついてきな、シアン！　シオ！」", "Battle/Dat/Battle/Message/257.bmd|0x002C08": "「二人共、タイミングを合わせな！/　１！」", "Battle/Dat/Battle/Message/257.bmd|0x002C46": "「２！」", "Battle/Dat/Battle/Message/257.bmd|0x002C53": "「３」", "Battle/Dat/Battle/Message/257.bmd|0x002C5D": "「ケルベロス！　ストラァァァァァイク！！」", "Battle/Dat/Battle/Message/258.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/259.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/260.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/261.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/262.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/262.bmd|0x000440": "「！？！？！？」", "Battle/Dat/Battle/Message/262.bmd|0x000459": "「………！！！」", "Battle/Dat/Battle/Message/262.bmd|0x000472": "「………！！」", "Battle/Dat/Battle/Message/262.bmd|0x000488": "「………？」", "Battle/Dat/Battle/Message/263.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/263.bmd|0x000440": "「！？！？！？」", "Battle/Dat/Battle/Message/263.bmd|0x000459": "「………！！！」", "Battle/Dat/Battle/Message/263.bmd|0x000472": "「………！！」", "Battle/Dat/Battle/Message/263.bmd|0x000488": "「………？」", "Battle/Dat/Battle/Message/264.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/264.bmd|0x000440": "「！？！？！？」", "Battle/Dat/Battle/Message/264.bmd|0x000459": "「………！！！」", "Battle/Dat/Battle/Message/264.bmd|0x000472": "「………！！」", "Battle/Dat/Battle/Message/264.bmd|0x000488": "「………？」", "Battle/Dat/Battle/Message/265.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/266.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/267.bmd|0x000E31": "「そこかっ！」", "Battle/Dat/Battle/Message/267.bmd|0x000E47": "「もらった！」", "Battle/Dat/Battle/Message/267.bmd|0x000E5D": "「この距離なら！」", "Battle/Dat/Battle/Message/267.bmd|0x000E79": "「目標捕捉！」", "Battle/Dat/Battle/Message/267.bmd|0x000E8F": "「この国をお前達の好きにはさせん！」", "Battle/Dat/Battle/Message/267.bmd|0x000EC6": "「シュテドニアスの連中め！」", "Battle/Dat/Battle/Message/267.bmd|0x000EF1": "「行くぞ、地上人！」", "Battle/Dat/Battle/Message/267.bmd|0x000F10": "「何者であろうと、敵ならば！」", "Battle/Dat/Battle/Message/267.bmd|0x000F3E": "「こっちから行くぞ！」", "Battle/Dat/Battle/Message/267.bmd|0x000F60": "「逃がすものか！」", "Battle/Dat/Battle/Message/267.bmd|0x000F7C": "「反撃する！」", "Battle/Dat/Battle/Message/267.bmd|0x000F92": "「や、やられた！」", "Battle/Dat/Battle/Message/267.bmd|0x000FAE": "「ここまでかっ！！」", "Battle/Dat/Battle/Message/267.bmd|0x000FCD": "「む、無念！！」", "Battle/Dat/Battle/Message/267.bmd|0x000FE6": "「うぐっ！　動力系にダメージが！」", "Battle/Dat/Battle/Message/267.bmd|0x00101A": "「こ、これ以上はもたんか……！？」", "Battle/Dat/Battle/Message/267.bmd|0x00104E": "「ぐっ！　国境警備隊の意地を見せてやる！」", "Battle/Dat/Battle/Message/267.bmd|0x00108E": "「ぐううっ……！/　中尉達の足を引っ張るわけには……！」", "Battle/Dat/Battle/Message/267.bmd|0x0010E1": "「ちいっ！　やってくれる！」", "Battle/Dat/Battle/Message/267.bmd|0x00110C": "「この程度で我らは怯まんぞ！」", "Battle/Dat/Battle/Message/267.bmd|0x00113A": "「まだだ、まだいける！」", "Battle/Dat/Battle/Message/267.bmd|0x00115F": "「致命傷じゃない、まだ戦える！」", "Battle/Dat/Battle/Message/267.bmd|0x001190": "「避けきれなかったか！」", "Battle/Dat/Battle/Message/267.bmd|0x0011B5": "「奴め、速いな！」", "Battle/Dat/Battle/Message/267.bmd|0x0011D1": "「かすり傷程度で！」", "Battle/Dat/Battle/Message/267.bmd|0x0011F0": "「くっ、対応できなかった！」", "Battle/Dat/Battle/Message/267.bmd|0x00121B": "「当たるものか！」", "Battle/Dat/Battle/Message/267.bmd|0x001237": "「甘い！」", "Battle/Dat/Battle/Message/267.bmd|0x001247": "「遅いぞ！」", "Battle/Dat/Battle/Message/267.bmd|0x00125A": "「そんなもの！」", "Battle/Dat/Battle/Message/267.bmd|0x001273": "「………」", "Battle/Dat/Battle/Message/267.bmd|0x001283": "「くっ、手が出せない！」", "Battle/Dat/Battle/Message/267.bmd|0x0012A8": "「反撃できないとは……！」", "Battle/Dat/Battle/Message/267.bmd|0x0012D0": "「くっ、敵を見失った！」", "Battle/Dat/Battle/Message/267.bmd|0x0012F5": "「奴め、どこへ行った！？」", "Battle/Dat/Battle/Message/267.bmd|0x00131D": "「援護します！」", "Battle/Dat/Battle/Message/267.bmd|0x001336": "「続きます！」", "Battle/Dat/Battle/Message/267.bmd|0x00134C": "「中尉、援護します！」", "Battle/Dat/Battle/Message/267.bmd|0x00136E": "「マサキ殿、援護します！」", "Battle/Dat/Battle/Message/267.bmd|0x001396": "「リューネ殿、後は自分が！」", "Battle/Dat/Battle/Message/267.bmd|0x0013C1": "「ミオ殿、後はお任せを！」", "Battle/Dat/Battle/Message/267.bmd|0x0013E9": "「ヤンロン殿、援護します！」", "Battle/Dat/Battle/Message/267.bmd|0x001414": "「テュッティ殿、後は自分が！」", "Battle/Dat/Battle/Message/267.bmd|0x001442": "「やらせるものか！」", "Battle/Dat/Battle/Message/267.bmd|0x001461": "「ここは自分が！」", "Battle/Dat/Battle/Message/267.bmd|0x00147D": "「中尉、下がってください！」", "Battle/Dat/Battle/Message/267