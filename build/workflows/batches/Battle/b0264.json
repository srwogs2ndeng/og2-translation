{"Battle/Dat/Battle/Message/256.bmd|0x004CF9": "「ピーク・シューター！」", "Battle/Dat/Battle/Message/256.bmd|0x004D1E": "「くらえ！　ピーク・シューター！」", "Battle/Dat/Battle/Message/256.bmd|0x004D52": "「撃ち抜いてやるよ！！」", "Battle/Dat/Battle/Message/256.bmd|0x004D77": "「まずはこいつだ！」", "Battle/Dat/Battle/Message/256.bmd|0x004D96": "「ターネイル、展開！」", "Battle/Dat/Battle/Message/256.bmd|0x004DB8": "「ハハハハ！/　回れ、回れ、回れぇぇぇっ！！」", "Battle/Dat/Battle/Message/256.bmd|0x004DFC": "「こいつをくらいな！」", "Battle/Dat/Battle/Message/256.bmd|0x004E1E": "「ネイル、オープン！」", "Battle/Dat/Battle/Message/256.bmd|0x004E40": "「ターネイル・クラッシャー！！/　死ねぇぇぇぇぇっ！！」", "Battle/Dat/Battle/Message/256.bmd|0x004E93": "「ブレイク・フィールド！！」", "Battle/Dat/Battle/Message/256.bmd|0x004EBE": "「噛み付いてやるよ！！」", "Battle/Dat/Battle/Message/256.bmd|0x004EE3": "「ハハッ！　こっちだ、こっち！」", "Battle/Dat/Battle/Message/256.bmd|0x004F14": "「アハハハ！/　上がれ、上がれ、上がれぇぇぇっ！！」", "Battle/Dat/Battle/Message/256.bmd|0x004F61": "「さあ、仕上げだ！！」", "Battle/Dat/Battle/Message/256.bmd|0x004F83": "「こいつで逝っちまいな！！」", "Battle/Dat/Battle/Message/256.bmd|0x004FAE": "「ソニック・デストロイヤー！！」", "Battle/Dat/Battle/Message/256.bmd|0x004FDF": "「ハハッ！　どこ見てんのさ！！」", "Battle/Dat/Battle/Message/256.bmd|0x005010": "「ターネイル・クラッシャー！！」", "Battle/Dat/Battle/Message/256.bmd|0x005041": "「こいつでとどめだ！！」", "Battle/Dat/Battle/Message/256.bmd|0x005066": "「ブチ抜け！　ソニック・デストロイヤー！！」", "Battle/Dat/Battle/Message/256.bmd|0x0050A9": "「あたしら３人で奴を噛み砕くよ！」", "Battle/Dat/Battle/Message/256.bmd|0x0050DD": "「おう！」", "Battle/Dat/Battle/Message/256.bmd|0x0050ED": "「……僕一人でもいいんだけどな」", "Battle/Dat/Battle/Message/256.bmd|0x00511E": "「ほらほら！！」", "Battle/Dat/Battle/Message/256.bmd|0x005137": "「踊れ、踊れ！！」", "Battle/Dat/Battle/Message/256.bmd|0x005153": "「弾の無駄遣いだよね、これ」", "Battle/Dat/Battle/Message/256.bmd|0x00517E": "「上昇する！」", "Battle/Dat/Battle/Message/256.bmd|0x005194": "「ついてきな、シアン！　シオ！」", "Battle/Dat/Battle/Message/256.bmd|0x0051C5": "「二人共、タイミングを合わせな！/　１！」", "Battle/Dat/Battle/Message/256.bmd|0x005203": "「２！」", "Battle/Dat/Battle/Message/256.bmd|0x005210": "「３」", "Battle/Dat/Battle/Message/256.bmd|0x00521A": "「ケルベロス！　ストラァァァァァイク！！」", "Battle/Dat/Battle/Message/257.bmd|0x001818": "「これで死んでくれると、楽なんだけど」", "Battle/Dat/Battle/Message/257.bmd|0x001852": "「相手が誰だろうと、トリガーを引くだけだし」", "Battle/Dat/Battle/Message/257.bmd|0x001895": "「早めに帰りたいんだ、僕」", "Battle/Dat/Battle/Message/257.bmd|0x0018BD": "「抵抗とかしないでよね」", "Battle/Dat/Battle/Message/257.bmd|0x0018E2": "「別に相手は誰でもいいし」", "Battle/Dat/Battle/Message/257.bmd|0x00190A": "「相手が誰でも、やることは同じだし」", "Battle/Dat/Battle/Message/257.bmd|0x001941": "「さっさとやられちゃってよ」", "Battle/Dat/Battle/Message/257.bmd|0x00196C": "「必要以上に絡みたくないし」", "Battle/Dat/Battle/Message/257.bmd|0x001997": "「まあ、相手は誰でもいいし」", "Battle/Dat/Battle/Message/257.bmd|0x0019C2": "「どんな敵でも、やることは同じだし」", "Battle/Dat/Battle/Message/257.bmd|0x0019F9": "「どういう相手だろうと、あんまり興味ないし」", "Battle/Dat/Battle/Message/257.bmd|0x001A3C": "「どう思われようと、どうでもいいし」", "Battle/Dat/Battle/Message/257.bmd|0x001A73": "「昔がどうとか、興味ないんだ、僕」", "Battle/Dat/Battle/Message/257.bmd|0x001AA7": "「他のクラスとはあまり絡みたくないんだ。/　面倒だし」", "Battle/Dat/Battle/Message/257.bmd|0x001AF7": "「相手がスクールの生き残りだからって、/　やることは同じだし」", "Battle/Dat/Battle/Message/257.bmd|0x001B53": "「昔は同じ所にいたとか、/　そんなのどうでもいいし」", "Battle/Dat/Battle/Message/257.bmd|0x001BA0": "「ああ、面倒だな」", "Battle/Dat/Battle/Message/257.bmd|0x001BBC": "「仕方がないな」", "Battle/Dat/Battle/Message/257.bmd|0x001BD5": "「面倒なのは嫌だけど……」", "Battle/Dat/Battle/Message/257.bmd|0x001BFD": "「まあ、落とせてないから、しょうがないし」", "Battle/Dat/Battle/Message/257.bmd|0x001C3D": "「何もしないと、長引くだけだし」", "Battle/Dat/Battle/Message/257.bmd|0x001C6E": "「反撃とか、面倒なんだけど」", "Battle/Dat/Battle/Message/257.bmd|0x001C99": "「あ～あ、ここまでか」", "Battle/Dat/Battle/Message/257.bmd|0x001CBB": "「ま、しょうがないか……」", "Battle/Dat/Battle/Message/257.bmd|0x001CE3": "「ここで引き揚げといた方がいいし」", "Battle/Dat/Battle/Message/257.bmd|0x001D17": "「に、逃げられないし！　うああああ！！」", "Battle/Dat/Battle/Message/257.bmd|0x001D54": "「一所懸命になったってさぁ……」", "Battle/Dat/Battle/Message/257.bmd|0x001D85": "「……ここで死ぬつもりなんてないし」", "Battle/Dat/Battle/Message/257.bmd|0x001DBC": "「くっ……！　付き合い切れないよ、こんなの」", "Battle/Dat/Battle/Message/257.bmd|0x001DFF": "「ううっ、まずいなあ、これ」", "Battle/Dat/Battle/Message/257.bmd|0x001E2A": "「な、何なの、今の……！」", "Battle/Dat/Battle/Message/257.bmd|0x001E52": "「もう帰ってもいいかなぁ」", "Battle/Dat/Battle/Message/257.bmd|0x001E7A": "「くっ！/　やってられないよ、こういうの……！」", "Battle/Dat/Battle/Message/257.bmd|0x001EC1": "「な、何でこうなるんだよ……！？」", "Battle/Dat/Battle/Message/257.bmd|0x001EF5": "「まあ、まだダメコンで何とかなるし」", "Battle/Dat/Battle/Message/257.bmd|0x001F2C": "「ア、アラド……いい加減にしなよ……！」", "Battle/Dat/Battle/Message/257.bmd|0x001F69": "「な、何であんな奴に……！」", "Battle/Dat/Battle/Message/257.bmd|0x001F94": "「くっ、ブロンゾが……！　生意気だね……！」", "Battle/Dat/Battle/Message/257.bmd|0x001FD7": "「くっ！　ゼオラ、よくも……！」", "Battle/Dat/Battle/Message/257.bmd|0x002008": "「ムカつくんだよ、ラトゥーニ……！」", "Battle/Dat/Battle/Message/257.bmd|0x00203F": "「ラトゥーニ……お前なんかに……！」", "Battle/Dat/Battle/Message/257.bmd|0x002076": "「面倒だなあ、もう」", "Battle/Dat/Battle/Message/257.bmd|0x002095": "「ケルベリオンはまだ大丈夫だし」", "Battle/Dat/Battle/Message/257.bmd|0x0020C6": "「やれやれ、長引きそうだなあ……」", "Battle/Dat/Battle/Message/257.bmd|0x0020FA": "「……まだやるんだよね？」", "Battle/Dat/Battle/Message/257.bmd|0x002122": "「そろそろ決着を付けないと、面倒だし」", "Battle/Dat/Battle/Message/257.bmd|0x00215C": "「あ～、押されちゃったなぁ」", "Battle/Dat/Battle/Message/257.bmd|0x002187": "「どうしてくれるのさ、これ」", "Battle/Dat/Battle/Message/257.bmd|0x0021B2": "「後で修理とか、面倒だし」", "Battle/Dat/Battle/Message/257.bmd|0x0021DA": "「で、どうするの？　アラド」", "Battle/Dat/Battle/Message/257.bmd|0x002205": "「ブロンゾが頑張ったって、無駄だし」", "Battle/Dat/Battle/Message/257.bmd|0x00223C": "「しつこいな、ゼオラ」", "Battle/Dat/Battle/Message/257.bmd|0x00225E": "「ラトゥーニ、絡まないでくれるかな」", "Battle/Dat/Battle/Message/257.bmd|0x002295": "「かわせなかったか。ま、いいや」", "Battle/Dat/Battle/Message/257.bmd|0x0022C6": "「悔しがったりするの、面倒だし」", "Battle/Dat/Battle/Message/257.bmd|0x0022F7": "「当たっちゃったか」", "Battle/Dat/Battle/Message/257.bmd|0x002316": "「ふ～ん、それで？」", "Battle/Dat/Battle/Message/257.bmd|0x002335": "「何か当たったのかな？」", "Battle/Dat/Battle/Message/257.bmd|0x00235A": "「これぐらいなら、気にすることないし」", "Battle/Dat/Battle/Message/257.bmd|0x002394": "「ムキになったりするの、面倒くさいし」", "Battle/Dat/Battle/Message/257.bmd|0x0023CE": "「別にどうってことないし」", "Battle/Dat/Battle/Message/257.bmd|0x0023F6": "「君とは絡みたくないんだ、アラド」", "Battle/Dat/Battle/Message/257.bmd|0x00242A": "「ブロンゾに追いつかれちゃったか。/　ま、いいや」", "Battle/Dat/Battle/Message/257.bmd|0x002474": "「ゼオラ、君とも絡みたくないし」", "Battle/Dat/Battle/Message/257.bmd|0x0024A5": "「ラトゥーニ、それで？」", "Battle/Dat/Battle/Message/257.bmd|0x0024CA": "「当たったら、面倒だし」", "Battle/Dat/Battle/Message/257.bmd|0x0024EF": "「受けるの面倒だし」", "Battle/Dat/Battle/Message/257.bmd|0x00250E": "「まあ、避けるのは楽だから」", "Battle/Dat/Battle/Message/257.bmd|0x002539": "「何だ、その程度か」", "Battle/Dat/Battle/Message/257.bmd|0x002558": "「まあ、勝手にやっといてよ」", "Battle/Dat/Battle/Message/257.bmd|0x002583": "「無駄だよ」", "Battle/Dat/Battle/Message/257.bmd|0x002596": "「諦めてよね」", "Battle/Dat/Battle/Message/257.bmd|0x0025AC": "「楽だね、これ」", "Battle/Dat/Battle/Message/257.bmd|0x0025C5": "「効かないんだ、それ」", "Battle/Dat/Battle/Message/257.bmd|0x0025E7": "「まあ、こういうこともあるよね」", "Battle/Dat/Battle/Message/257.bmd|0x002618": "「いちいち腹を立ててもしょうがないし」", "Battle/Dat/Battle/Message/257.bmd|0x002652": "「さて、どうしようかな」", "Battle/Dat/Battle/Message/257.bmd|0x002677": "「これで落ちてくれたら、楽なんだけど」", "Battle/Dat/Battle/Message/257.bmd|0x0026B1": "「やるよ、早く帰りたいし」", "Battle/Dat/Battle/Message/257.bmd|0x0026D9": "「手伝った方が早く終わるし」", "Battle/Dat/Battle/Message/257.bmd|0x002704": "「早く終わらせようよ、シエンヌ」", "Battle/Dat/Battle/Message/257.bmd|0x002735": "「長引かせたくないんだ、シアン」", "Battle/Dat/Battle/Message/257.bmd|0x002766": "「好きにはやらせないし」", "Battle/Dat/Battle/Message/257.bmd|0x00278B": "「こっちで受け止めとくよ」", "Battle/Dat/Battle/Message/257.bmd|0x0027B3": "「後々面倒なのは嫌だし」", "Battle/Dat/Battle/Message/257.bmd|0x0027D8": "「面倒だけど、終わらせるにはやるしかないし」", "Battle/Dat/Battle/Message/257.bmd|0x00281B": "「これで終わりにしようよ」", "Battle/Dat/Battle/Message/257.bmd|0x002843": "「ターゲット・ロック」"}