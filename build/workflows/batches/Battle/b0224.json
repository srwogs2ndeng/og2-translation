{"Battle/Dat/Battle/Message/140.bmd|0x001C4E": "「データ・リンク。転送」", "Battle/Dat/Battle/Message/140.bmd|0x001C73": "「戦闘を続行する」", "Battle/Dat/Battle/Message/140.bmd|0x001C8F": "「任務遂行に支障なし」", "Battle/Dat/Battle/Message/140.bmd|0x001CB1": "「任務内容に変更なし」", "Battle/Dat/Battle/Message/140.bmd|0x001CD3": "「ダメージ、０」", "Battle/Dat/Battle/Message/140.bmd|0x001CEC": "「損傷なし」", "Battle/Dat/Battle/Message/140.bmd|0x001CFF": "「回避完了」", "Battle/Dat/Battle/Message/140.bmd|0x001D12": "「ネクスト・シーケンス」", "Battle/Dat/Battle/Message/140.bmd|0x001D37": "「反撃不可能」", "Battle/Dat/Battle/Message/140.bmd|0x001D4D": "「ポジション、リセット」", "Battle/Dat/Battle/Message/140.bmd|0x001D72": "「シーケンス、リセット」", "Battle/Dat/Battle/Message/140.bmd|0x001D97": "「射程範囲外」", "Battle/Dat/Battle/Message/140.bmd|0x001DAD": "「攻撃不可能」", "Battle/Dat/Battle/Message/140.bmd|0x001DC3": "「ターゲット、ロスト」", "Battle/Dat/Battle/Message/140.bmd|0x001DE5": "「バックアップ・スタート」", "Battle/Dat/Battle/Message/140.bmd|0x001E0D": "「フォロー・アタック」", "Battle/Dat/Battle/Message/140.bmd|0x001E2F": "「シーケンス続行」", "Battle/Dat/Battle/Message/140.bmd|0x001E4B": "「攻撃阻止」", "Battle/Dat/Battle/Message/140.bmd|0x001E5E": "「友軍機をカバー」", "Battle/Dat/Battle/Message/140.bmd|0x001E7A": "「発射」", "Battle/Dat/Battle/Message/140.bmd|0x001E87": "「ファイア」", "Battle/Dat/Battle/Message/140.bmd|0x001E9A": "「目標捕捉」", "Battle/Dat/Battle/Message/140.bmd|0x001EAD": "「エネルギー・チャージ」", "Battle/Dat/Battle/Message/140.bmd|0x001ED2": "「ターゲット・ロック」", "Battle/Dat/Battle/Message/140.bmd|0x001EF4": "「ターゲット・インサイト」", "Battle/Dat/Battle/Message/140.bmd|0x001F1C": "「バレル、セット」", "Battle/Dat/Battle/Message/140.bmd|0x001F38": "「バレル、アクティブ」", "Battle/Dat/Battle/Message/140.bmd|0x001F5A": "「アタック・シーケンス」", "Battle/Dat/Battle/Message/140.bmd|0x001F7F": "「攻撃開始」", "Battle/Dat/Battle/Message/140.bmd|0x001F92": "「シーケンス推移」", "Battle/Dat/Battle/Message/141.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/141.bmd|0x000440": "「！？！？！？」", "Battle/Dat/Battle/Message/141.bmd|0x000459": "「………！！！」", "Battle/Dat/Battle/Message/141.bmd|0x000472": "「………！！」", "Battle/Dat/Battle/Message/141.bmd|0x000488": "「………？」", "Battle/Dat/Battle/Message/142.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/142.bmd|0x000440": "「！？！？！？」", "Battle/Dat/Battle/Message/142.bmd|0x000459": "「………！！！」", "Battle/Dat/Battle/Message/142.bmd|0x000472": "「………！！」", "Battle/Dat/Battle/Message/142.bmd|0x000488": "「………？」", "Battle/Dat/Battle/Message/143.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/143.bmd|0x000440": "「！？！？！？」", "Battle/Dat/Battle/Message/143.bmd|0x000459": "「………！！！」", "Battle/Dat/Battle/Message/143.bmd|0x000472": "「………！！」", "Battle/Dat/Battle/Message/143.bmd|0x000488": "「………？」", "Battle/Dat/Battle/Message/144.bmd|0x000A6F": "W「攻撃開始！」", "Battle/Dat/Battle/Message/144.bmd|0x000A86": "「直撃させる！」", "Battle/Dat/Battle/Message/144.bmd|0x000A9F": "「目標確認！　攻撃開始！」", "Battle/Dat/Battle/Message/144.bmd|0x000AC7": "「やらせるか！」", "Battle/Dat/Battle/Message/144.bmd|0x000AE0": "「ここから先には行かせんぞ！」", "Battle/Dat/Battle/Message/144.bmd|0x000B0E": "「負けるわけには！」", "Battle/Dat/Battle/Message/144.bmd|0x000B2D": "「だ、脱出します！」", "Battle/Dat/Battle/Message/144.bmd|0x000B4C": "「すみません、ここまでです！」", "Battle/Dat/Battle/Message/144.bmd|0x000B7A": "「き、機体を放棄します！！」", "Battle/Dat/Battle/Message/144.bmd|0x000BA5": "「！！！」", "Battle/Dat/Battle/Message/144.bmd|0x000BB5": "「こ、これ以上はまずい！」", "Battle/Dat/Battle/Message/144.bmd|0x000BDD": "「まだ落ちるわけにはいかん！」", "Battle/Dat/Battle/Message/144.bmd|0x000C0B": "「機体はまだ動く……！　やれるぞ！！」", "Battle/Dat/Battle/Message/144.bmd|0x000C45": "「こんな所で引き下がるつもりはない！！」", "Battle/Dat/Battle/Message/144.bmd|0x000C82": "「ぐあっ！　き、機体の維持を……！！」", "Battle/Dat/Battle/Message/144.bmd|0x000CBC": "「うぐっ！　まだ引き下がれん！！」", "Battle/Dat/Battle/Message/144.bmd|0x000CF0": "「ちょ、直撃かっ！」", "Battle/Dat/Battle/Message/144.bmd|0x000D0F": "「致命傷は免れたが、次は……！」", "Battle/Dat/Battle/Message/144.bmd|0x000D40": "「うわあっ！　え、援護を！」", "Battle/Dat/Battle/Message/144.bmd|0x000D6B": "「そう簡単にやられはしないぞ！」", "Battle/Dat/Battle/Message/144.bmd|0x000D9C": "「この程度なら大丈夫だ！」", "Battle/Dat/Battle/Message/144.bmd|0x000DC4": "「損傷度チェック……ダメージは軽微だ」", "Battle/Dat/Battle/Message/144.bmd|0x000DFE": "「くっ、回避し損なったか！」", "Battle/Dat/Battle/Message/144.bmd|0x000E29": "「これぐらいでひるんでなるものか！」", "Battle/Dat/Battle/Message/144.bmd|0x000E60": "「くそっ、やるな！」", "Battle/Dat/Battle/Message/144.bmd|0x000E7F": "「当たりはしない！」", "Battle/Dat/Battle/Message/144.bmd|0x000E9E": "「残念だったな！」", "Battle/Dat/Battle/Message/144.bmd|0x000EBA": "「よし、かわした！」", "Battle/Dat/Battle/Message/144.bmd|0x000ED9": "「あ、危なかった……」", "Battle/Dat/Battle/Message/144.bmd|0x000EFB": "「まともに食らってたまるか！」", "Battle/Dat/Battle/Message/144.bmd|0x000F29": "「これならば！」", "Battle/Dat/Battle/Message/144.bmd|0x000F42": "「………」", "Battle/Dat/Battle/Message/144.bmd|0x000F52": "「手も足も出ないとは……！！」", "Battle/Dat/Battle/Message/144.bmd|0x000F80": "「こ、攻撃できん！！」", "Battle/Dat/Battle/Message/144.bmd|0x000FA2": "「な、何とかしなければ！」", "Battle/Dat/Battle/Message/144.bmd|0x000FCA": "「どこだ！？　どこにいる！？」", "Battle/Dat/Battle/Message/144.bmd|0x000FF8": "「しまった、見失った！」", "Battle/Dat/Battle/Message/144.bmd|0x00101D": "「あいつはどこへ行ったんだ！？」", "Battle/Dat/Battle/Message/144.bmd|0x00104E": "「援護します！」", "Battle/Dat/Battle/Message/144.bmd|0x001067": "「少しでも手助けを！」", "Battle/Dat/Battle/Message/144.bmd|0x001089": "「こちらからも！」", "Battle/Dat/Battle/Message/144.bmd|0x0010A5": "「危ないっ！」", "Battle/Dat/Battle/Message/144.bmd|0x0010BB": "「やらせるものか！」", "Battle/Dat/Battle/Message/144.bmd|0x0010DA": "「ここは自分が！」", "Battle/Dat/Battle/Message/144.bmd|0x0010F6": "「我々にも意地はある！」", "Battle/Dat/Battle/Message/145.bmd|0x000BBA": "「攻撃開始！」", "Battle/Dat/Battle/Message/145.bmd|0x000BD0": "「懐に飛び込ませるな！」", "Battle/Dat/Battle/Message/145.bmd|0x000BF5": "「か、艦を放棄する！！」", "Battle/Dat/Battle/Message/145.bmd|0x000C1A": "「総員退避ぃぃぃっ！！」", "Battle/Dat/Battle/Message/145.bmd|0x000C3F": "「各員、脱出しろ！」", "Battle/Dat/Battle/Message/145.bmd|0x000C5E": "「消火班、Ｂブロックへ急げ！」", "Battle/Dat/Battle/Message/145.bmd|0x000C8C": "「まだだ！　まだ沈んではならん！/　弾を撃ち尽くすまでは！！」", "Battle/Dat/Battle/Message/145.bmd|0x000CE8": "「沈むにはまだ早い！/　可能な限り反撃せよ！！」", "Battle/Dat/Battle/Message/145.bmd|0x000D2F": "「せ、戦艦の装甲を撃ち抜いただと！？」", "Battle/Dat/Battle/Message/145.bmd|0x000D69": "「うぐっ！　い、いかん！/　すぐに護衛機を呼び戻せ！！」", "Battle/Dat/Battle/Message/145.bmd|0x000DBC": "「ぐっ！　破損箇所を報告せよ！」", "Battle/Dat/Battle/Message/145.bmd|0x000DED": "「フン……その程度で本艦を沈めるつもりか」", "Battle/Dat/Battle/Message/145.bmd|0x000E2D": "「ひるむな！　そう簡単に沈みはせん！」", "Battle/Dat/Battle/Message/145.bmd|0x000E67": "「直撃だと！？　被弾箇所を知らせ！」", "Battle/Dat/Battle/Message/145.bmd|0x000E9E": "「戦艦に挑んでくる勇気は認めてやるが……」", "Battle/Dat/Battle/Message/145.bmd|0x000EDE": "「操舵手！　回避が遅いぞ！」", "Battle/Dat/Battle/Message/145.bmd|0x000F09": "「回避行動を取りつつ、反撃せよ！」", "Battle/Dat/Battle/Message/145.bmd|0x000F3D": "「構わん、攻撃に専念しろ！」", "Battle/Dat/Battle/Message/145.bmd|0x000F68": "「本艦の装甲を甘く見たな……」", "Battle/Dat/Battle/Message/145.bmd|0x000F96": "「各砲座、敵機の接近を許すな！」", "Battle/Dat/Battle/Message/145.bmd|0x000FC7": "「急速回頭！」", "Battle/Dat/Battle/Message/145.bmd|0x000FDD": "「ふん、こんな大きな的を外すとはな！」", "Battle/Dat/Battle/Message/145.bmd|0x001017": "「よし、面舵戻せ！　反撃に移る！」", "Battle/Dat/Battle/Message/145.bmd|0x00104B": "「こちらの操艦技術を甘く見るなよ」", "Battle/Dat/Battle/Message/145.bmd|0x00107F": "「防御装置、作動！」", "Battle/Dat/Battle/Message/145.bmd|0x00109E": "「バリアを展開しろ！」", "Battle/Dat/Battle/Message/145.bmd|0x0010C0": "「よし、バリアが効いているな」", "Battle/Dat/Battle/Message/145.bmd|0x0010EE": "「………」", "Battle/Dat/Battle/Message/145.bmd|0x0010FE": "「反撃不可能だと！？」", "Battle/Dat/Battle/Message/145.bmd|0x001120": "「砲撃手、何をしている！？」"}