{"Battle/Dat/Battle/Message/121.bmd|0x00AB51": "「カイ少佐、援護します」", "Battle/Dat/Battle/Message/121.bmd|0x00AB76": "「ラミア少尉、援護します」", "Battle/Dat/Battle/Message/121.bmd|0x00AB9E": "「ラミア少尉の動き……合わせ易いです」", "Battle/Dat/Battle/Message/121.bmd|0x00ABD8": "「ゼオラ、後は私が」", "Battle/Dat/Battle/Message/121.bmd|0x00ABF7": "「アラド、まだ状況は終わっていませんよ」", "Battle/Dat/Battle/Message/121.bmd|0x00AC34": "「ラトゥーニ、後は私が」", "Battle/Dat/Battle/Message/121.bmd|0x00AC59": "「王女、援護します」", "Battle/Dat/Battle/Message/121.bmd|0x00AC78": "「ジョッシュ、後は私が」", "Battle/Dat/Battle/Message/121.bmd|0x00AC9D": "「リム、援護します」", "Battle/Dat/Battle/Message/121.bmd|0x00ACBC": "「イング、後は任せて」", "Battle/Dat/Battle/Message/121.bmd|0x00ACDE": "「リョウト少尉、援護します」", "Battle/Dat/Battle/Message/121.bmd|0x00AD09": "「リオ少尉、後は任せて下さい」", "Battle/Dat/Battle/Message/121.bmd|0x00AD37": "「アルト同士の連係で……！」", "Battle/Dat/Battle/Message/121.bmd|0x00AD62": "「私が受け止めます！」", "Battle/Dat/Battle/Message/121.bmd|0x00AD84": "「代わりましょう！」", "Battle/Dat/Battle/Message/121.bmd|0x00ADA3": "「止めてみせます！」", "Battle/Dat/Battle/Message/121.bmd|0x00ADC2": "「こちらはまだ保ちます！」", "Battle/Dat/Battle/Message/121.bmd|0x00ADEA": "「その攻撃なら、許容可能……！」", "Battle/Dat/Battle/Message/121.bmd|0x00AE1B": "「キョウスケ中尉、後退を！」", "Battle/Dat/Battle/Message/121.bmd|0x00AE46": "「エクセレン少尉、離脱を！」", "Battle/Dat/Battle/Message/121.bmd|0x00AE71": "「ブルックリン少尉、無理は禁物です！」", "Battle/Dat/Battle/Message/121.bmd|0x00AEAB": "「危険です、クスハ少尉！」", "Battle/Dat/Battle/Message/121.bmd|0x00AED3": "「リュウセイ少尉、後退を！」", "Battle/Dat/Battle/Message/121.bmd|0x00AEFE": "「ゼンガー少佐、離脱を！」", "Battle/Dat/Battle/Message/121.bmd|0x00AF26": "「カイ少佐、後退して下さい！」", "Battle/Dat/Battle/Message/121.bmd|0x00AF54": "「ラミア少尉、私に任せて下さい！」", "Battle/Dat/Battle/Message/121.bmd|0x00AF88": "「あなたと言えど、危険です！」", "Battle/Dat/Battle/Message/121.bmd|0x00AFB6": "「アラド、過信はいけません！」", "Battle/Dat/Battle/Message/121.bmd|0x00AFE4": "「ゼオラ、すぐに離脱を！」", "Battle/Dat/Battle/Message/121.bmd|0x00B00C": "「ラトゥーニ、後退するのです！」", "Battle/Dat/Battle/Message/121.bmd|0x00B03D": "「王女をお守りしなければ……！」", "Battle/Dat/Battle/Message/121.bmd|0x00B06E": "「危険です、ジョッシュ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B096": "「リム、すぐに後退を！」", "Battle/Dat/Battle/Message/121.bmd|0x00B0BB": "「イング、下がって！」", "Battle/Dat/Battle/Message/121.bmd|0x00B0DD": "「リョウト少尉、私が代わります！」", "Battle/Dat/Battle/Message/121.bmd|0x00B111": "「リオ少尉、すぐに離脱を！」", "Battle/Dat/Battle/Message/121.bmd|0x00B13C": "「フリッケライで受け止めます！」", "Battle/Dat/Battle/Message/121.bmd|0x00B16D": "「アルトと言えど、危険です！」", "Battle/Dat/Battle/Message/121.bmd|0x00B19B": "「まとめて撃破します」", "Battle/Dat/Battle/Message/121.bmd|0x00B1BD": "「そのフォーメーションならば……！」", "Battle/Dat/Battle/Message/121.bmd|0x00B1F4": "「複数ターゲット……攻撃可能」", "Battle/Dat/Battle/Message/121.bmd|0x00B222": "「再攻撃開始」", "Battle/Dat/Battle/Message/121.bmd|0x00B238": "「再捕捉完了。アタック」", "Battle/Dat/Battle/Message/121.bmd|0x00B25D": "「パターン、リロード。アクション」", "Battle/Dat/Battle/Message/121.bmd|0x00B291": "「直撃を！」", "Battle/Dat/Battle/Message/121.bmd|0x00B2A4": "「行けっ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B2B7": "「これでとどめ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B2D3": "「そこ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B2E3": "「これで！」", "Battle/Dat/Battle/Message/121.bmd|0x00B2F6": "「当てます！」", "Battle/Dat/Battle/Message/121.bmd|0x00B30C": "「外しません！」", "Battle/Dat/Battle/Message/121.bmd|0x00B325": "「リボルビング・ステーク！」", "Battle/Dat/Battle/Message/121.bmd|0x00B350": "「ファイア！」", "Battle/Dat/Battle/Message/121.bmd|0x00B366": "「まだです！」", "Battle/Dat/Battle/Message/121.bmd|0x00B37C": "「このステークなら！」", "Battle/Dat/Battle/Message/121.bmd|0x00B39E": "「まだ行ける！」", "Battle/Dat/Battle/Message/121.bmd|0x00B3B7": "「落ちなさい！」", "Battle/Dat/Battle/Message/121.bmd|0x00B3D0": "「貫きます！」", "Battle/Dat/Battle/Message/121.bmd|0x00B3E6": "「追撃します！」", "Battle/Dat/Battle/Message/121.bmd|0x00B3FF": "「マシンキャノン！」", "Battle/Dat/Battle/Message/121.bmd|0x00B41E": "「シーケンス、ＭＳ１！」", "Battle/Dat/Battle/Message/121.bmd|0x00B443": "「まずは牽制を！」", "Battle/Dat/Battle/Message/121.bmd|0x00B45F": "「次はステークで！」", "Battle/Dat/Battle/Message/121.bmd|0x00B47E": "「とどめ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B491": "「貫くっ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B4A4": "「ステーク！　行けっ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B4C9": "「マグナム・ステーク！」", "Battle/Dat/Battle/Message/121.bmd|0x00B4EE": "「撃ち抜きます！」", "Battle/Dat/Battle/Message/121.bmd|0x00B50A": "「コードＵ．Ｕ．Ｎ．、発動！」", "Battle/Dat/Battle/Message/121.bmd|0x00B538": "「ハンマー、アクティブ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B560": "「アンキャニー・アルティメイタム・ネイルズ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B5A6": "「ファイア！！」", "Battle/Dat/Battle/Message/121.bmd|0x00B5BF": "「追い詰めます！」", "Battle/Dat/Battle/Message/121.bmd|0x00B5DB": "「ステーク！」", "Battle/Dat/Battle/Message/121.bmd|0x00B5F1": "「スプリットミサイル！」", "Battle/Dat/Battle/Message/121.bmd|0x00B616": "「ファウ・ケルン……」", "Battle/Dat/Battle/Message/121.bmd|0x00B638": "「エネルギー解放！！」", "Battle/Dat/Battle/Message/121.bmd|0x00B65A": "「フォース・レイ、発射！！」", "Battle/Dat/Battle/Message/121.bmd|0x00B685": "「まだここから！」", "Battle/Dat/Battle/Message/121.bmd|0x00B6A1": "「はああっ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B6B7": "「フォース・レイ！　バーストッ！！」", "Battle/Dat/Battle/Message/121.bmd|0x00B6EE": "「仕掛けるぞ、アリエイル」", "Battle/Dat/Battle/Message/121.bmd|0x00B716": "「了解です、キョウスケ中尉。援護します」", "Battle/Dat/Battle/Message/121.bmd|0x00B753": "「エターナリィ・ダーニング・ネイルズ……」", "Battle/Dat/Battle/Message/121.bmd|0x00B793": "「コードＥ．Ｄ．Ｎ．、発動！」", "Battle/Dat/Battle/Message/121.bmd|0x00B7C1": "「バンカー！」", "Battle/Dat/Battle/Message/121.bmd|0x00B7D7": "「撃ち抜くっ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B7F0": "「こちらも！」", "Battle/Dat/Battle/Message/121.bmd|0x00B806": "「いい位置だ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B81F": "「ブースト！！」", "Battle/Dat/Battle/Message/121.bmd|0x00B838": "「仕上げだ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B84E": "「了解！　フォース・レイ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B879": "「ターゲット、撃破」", "Battle/Dat/Battle/Message/121.bmd|0x00B898": "「言わばアルト同士だ、合わせ易い」", "Battle/Dat/Battle/Message/121.bmd|0x00B8CC": "「おれ達の爪は！」", "Battle/Dat/Battle/Message/121.bmd|0x00B8E8": "「鋭いぞ！」", "Battle/Dat/Battle/Message/121.bmd|0x00B8FB": "「このタイミングなら！」", "Battle/Dat/Battle/Message/121.bmd|0x00B920": "「送ります！」", "Battle/Dat/Battle/Message/121.bmd|0x00B936": "「合わせろ、アリエイル！」", "Battle/Dat/Battle/Message/121.bmd|0x00B95E": "「了解！　ステークでっ！！」", "Battle/Dat/Battle/Message/121.bmd|0x00B989": "「とどめだ！　クレイモア！！」", "Battle/Dat/Battle/Message/121.bmd|0x00B9B7": "「フォース・レイ、発射！」", "Battle/Dat/Battle/Message/121.bmd|0x00B9DF": "「エクセレン少尉のようには/　いきませんでしたが……」", "Battle/Dat/Battle/Message/121.bmd|0x00BA2F": "「いや、いい連係だった」", "Battle/Dat/Battle/Message/121.bmd|0x00BA54": "「ＡＴＳ、セット」", "Battle/Dat/Battle/Message/121.bmd|0x00BA70": "「スラッシュ・リッパー！」", "Battle/Dat/Battle/Message/121.bmd|0x00BA98": "「ターゲット・ロック」", "Battle/Dat/Battle/Message/121.bmd|0x00BABA": "「スラッシュ・リッパー、発射！」", "Battle/Dat/Battle/Message/121.bmd|0x00BAEB": "「グラビトン・ランチャー、発射！」", "Battle/Dat/Battle/Message/121.bmd|0x00BB1F": "「このグラビトン・ランチャーならば！」", "Battle/Dat/Battle/Message/121.bmd|0x00BB59": "「リープ・スラッシャー、射出！」", "Battle/Dat/Battle/Message/121.bmd|0x00BB8A": "「行け、リープ・スラッシャー！」", "Battle/Dat/Battle/Message/121.bmd|0x00BBBB": "「ディバイン・アーム！」", "Battle/Dat/Battle/Message/121.bmd|0x00BBE0": "「このディバイン・アームで！」", "Battle/Dat/Battle/Message/121.bmd|0x00BC0E": "「ネオ・チャクラムシューター！」", "Battle/Dat/Battle/Message/121.bmd|0x00BC3F": "「ステルス・ブーメラン！」", "Battle/Dat/Battle/Message/121.bmd|0x00BC67": "「行け、ステルス・ブーメラン！」", "Battle/Dat/Battle/Message/121.bmd|0x00BC98": "「ブーストハンマー！」", "Battle/Dat/Battle/Message/121.bmd|0x00BCBA": "「打ちます！」", "Battle/Dat/Battle/Message/121.bmd|0x00BCD0": "「Ｇ・インパクトステーク！」"}