{"Battle/Dat/Battle/Message/146.bmd|0x0061F5": "「や、やはり、グルンガストが相手では！」", "Battle/Dat/Battle/Message/146.bmd|0x006232": "「こ、この力……/　まさに不幸を呼ぶ機体……！」", "Battle/Dat/Battle/Message/146.bmd|0x006279": "「お、おのれ、サイバスター……！」", "Battle/Dat/Battle/Message/146.bmd|0x0062AD": "「うおあっ！　ちょ、直撃だと！？」", "Battle/Dat/Battle/Message/146.bmd|0x0062E1": "「まぐれ当たりで調子に乗るなよ！」", "Battle/Dat/Battle/Message/146.bmd|0x006315": "「チ、思った以上に出来るな！」", "Battle/Dat/Battle/Message/146.bmd|0x006343": "「おのれ！　やってくれる！」", "Battle/Dat/Battle/Message/146.bmd|0x00636E": "「ぐうっ！/　一発や二発、食らったぐらいで！」", "Battle/Dat/Battle/Message/146.bmd|0x0063B2": "「こちらの装甲では止められんのか！？」", "Battle/Dat/Battle/Message/146.bmd|0x0063EC": "「ぬうっ！　こちらを甘く見るなよ！！」", "Battle/Dat/Battle/Message/146.bmd|0x006426": "「エ、ＡＴＸチーム……噂以上だ……！」", "Battle/Dat/Battle/Message/146.bmd|0x006460": "「パーソナルトルーパーのくせに/　何てパワーだ！」", "Battle/Dat/Battle/Message/146.bmd|0x0064AA": "「くっ！　奴め、特機並の力を！」", "Battle/Dat/Battle/Message/146.bmd|0x0064DB": "「あいつ、どういう改造をしたんだ！？」", "Battle/Dat/Battle/Message/146.bmd|0x006515": "「こ、これが教導隊の実力か……！」", "Battle/Dat/Battle/Message/146.bmd|0x006549": "「ぬうっ！　ただの試作機じゃないらしいな！」", "Battle/Dat/Battle/Message/146.bmd|0x00658C": "「ううう…！　あれがＳＲＸ計画の機体か！」", "Battle/Dat/Battle/Message/146.bmd|0x0065CC": "「が、合体前でこの攻撃力か！？」", "Battle/Dat/Battle/Message/146.bmd|0x0065FD": "「あ、あれがＳＲＸチームか……！」", "Battle/Dat/Battle/Message/146.bmd|0x006631": "「奴らめ、何という機体を作ったんだ！」", "Battle/Dat/Battle/Message/146.bmd|0x00666B": "「し、新型め！　よくも！」", "Battle/Dat/Battle/Message/146.bmd|0x006693": "「お、お前のデータ取りに協力する気はない！」", "Battle/Dat/Battle/Message/146.bmd|0x0066D6": "「駄目だ、奴のスピードにはついていけん！」", "Battle/Dat/Battle/Message/146.bmd|0x006716": "「れ、連邦の試作機ごときに！」", "Battle/Dat/Battle/Message/146.bmd|0x006744": "「こ、このままではこちらが幽霊に……！！」", "Battle/Dat/Battle/Message/146.bmd|0x006784": "「うぐっ！　何で旧型にここまで！？」", "Battle/Dat/Battle/Message/146.bmd|0x0067BB": "「うぐっ！　見かけによらず素早い！」", "Battle/Dat/Battle/Message/146.bmd|0x0067F2": "「くっ！/　ただ大きいわけではないらしいな！」", "Battle/Dat/Battle/Message/146.bmd|0x006836": "「ううっ！/　攻撃力がパーソナルトルーパーとは段違いだ！」", "Battle/Dat/Battle/Message/146.bmd|0x00688C": "「しまった！/　奴の見た目に惑わされた！」", "Battle/Dat/Battle/Message/146.bmd|0x0068CA": "「ぐうう……！/　失敗作の後継機ごときに、なぜだ！？」", "Battle/Dat/Battle/Message/146.bmd|0x00691A": "「ま、魔装機神の名は/　伊達じゃないらしいな……！」", "Battle/Dat/Battle/Message/146.bmd|0x006967": "「ふん！　口ほどでもない！」", "Battle/Dat/Battle/Message/146.bmd|0x006992": "「こちらの力をなめているのか！？」", "Battle/Dat/Battle/Message/146.bmd|0x0069C6": "「無駄なあがきだ！」", "Battle/Dat/Battle/Message/146.bmd|0x0069E5": "「その程度で我々に刃向かうとは！」", "Battle/Dat/Battle/Message/146.bmd|0x006A19": "「無駄な抵抗は見苦しいぞ！」", "Battle/Dat/Battle/Message/146.bmd|0x006A44": "「ダメージ軽微……作戦を続行する！」", "Battle/Dat/Battle/Message/146.bmd|0x006A7B": "「ふん……チェックの必要もない程度か……」", "Battle/Dat/Battle/Message/146.bmd|0x006ABB": "「ＡＴＸチーム……噂ほどじゃないな」", "Battle/Dat/Battle/Message/146.bmd|0x006AF2": "「フン、所詮は旧型の改造機だ！」", "Battle/Dat/Battle/Message/146.bmd|0x006B23": "「おい、どこを改造したんだ？」", "Battle/Dat/Battle/Message/146.bmd|0x006B51": "「くっ！　あの突進力は……！」", "Battle/Dat/Battle/Message/146.bmd|0x006B7F": "「あれが教導隊だと？　笑わせる！」", "Battle/Dat/Battle/Message/146.bmd|0x006BB3": "「それで対異星人用の兵器とは笑わせる！」", "Battle/Dat/Battle/Message/146.bmd|0x006BF0": "「どうした？　派手なのは機体の色だけか？」", "Battle/Dat/Battle/Message/146.bmd|0x006C30": "「さっさと合体したらどうだ！？」", "Battle/Dat/Battle/Message/146.bmd|0x006C61": "「何だ？　それがＳＲＸチームの実力か？」", "Battle/Dat/Battle/Message/146.bmd|0x006C9E": "「新型め、調整が上手くいっていないらしいな」", "Battle/Dat/Battle/Message/146.bmd|0x006CE1": "「どうした、新型！　その程度の性能か？」", "Battle/Dat/Battle/Message/146.bmd|0x006D1E": "「フン…新型機ではなく、欠陥機か？」", "Battle/Dat/Battle/Message/146.bmd|0x006D55": "「ゲシュペンストなど、/　もう時代遅れなんだよ！」", "Battle/Dat/Battle/Message/146.bmd|0x006D9F": "「やはり、見かけ倒しか」", "Battle/Dat/Battle/Message/146.bmd|0x006DC4": "「力だけで我らを倒せると思うな！」", "Battle/Dat/Battle/Message/146.bmd|0x006DF8": "「見た目通り、のろそうな機体だな！」", "Battle/Dat/Battle/Message/146.bmd|0x006E2F": "「直撃さえしなければ、グルンガストなど！」", "Battle/Dat/Battle/Message/146.bmd|0x006E6F": "「それがヒュッケバインの力か？」", "Battle/Dat/Battle/Message/146.bmd|0x006EA0": "「魔装機神などと言っても、その程度か？」", "Battle/Dat/Battle/Message/146.bmd|0x006EDD": "「かわした！」", "Battle/Dat/Battle/Message/146.bmd|0x006EF3": "「モーションが大きすぎるんだよ！」", "Battle/Dat/Battle/Message/146.bmd|0x006F27": "「遅いっ！」", "Battle/Dat/Battle/Message/146.bmd|0x006F3A": "「照準がずれているようだな」", "Battle/Dat/Battle/Message/146.bmd|0x006F65": "「今までの相手が弱すぎたようだな！」", "Battle/Dat/Battle/Message/146.bmd|0x006F9C": "「まぐれ当たりは続かないぞ！」", "Battle/Dat/Battle/Message/146.bmd|0x006FCA": "「よし、回避成功だ！」", "Battle/Dat/Battle/Message/146.bmd|0x006FEC": "「その程度！」", "Battle/Dat/Battle/Message/146.bmd|0x007002": "「そんなもの！」", "Battle/Dat/Battle/Message/146.bmd|0x00701B": "「残念だったな！」", "Battle/Dat/Battle/Message/146.bmd|0x007037": "「無駄だ！」", "Battle/Dat/Battle/Message/146.bmd|0x00704A": "「………」", "Battle/Dat/Battle/Message/146.bmd|0x00705A": "「くっ、補給を！」", "Battle/Dat/Battle/Message/146.bmd|0x007076": "「長期戦では不利か！」", "Battle/Dat/Battle/Message/146.bmd|0x007098": "「反撃できんとはな……！」", "Battle/Dat/Battle/Message/146.bmd|0x0070C0": "「手も足も出させんつもりか！」", "Battle/Dat/Battle/Message/146.bmd|0x0070EE": "「バカな、踊らされているのか！？」", "Battle/Dat/Battle/Message/146.bmd|0x007122": "「た、弾切れだと……！？」", "Battle/Dat/Battle/Message/146.bmd|0x00714A": "「くっ、この間合いでは……！」", "Battle/Dat/Battle/Message/146.bmd|0x007178": "「ここからでは反撃できん！」", "Battle/Dat/Battle/Message/146.bmd|0x0071A3": "「反撃不可能だと！？」", "Battle/Dat/Battle/Message/146.bmd|0x0071C5": "「くそっ！　これじゃ狙い撃ちされる！」", "Battle/Dat/Battle/Message/146.bmd|0x0071FF": "「いかん！　これではただの標的だ！」", "Battle/Dat/Battle/Message/146.bmd|0x007236": "「な、何も出来ないのか……！？」", "Battle/Dat/Battle/Message/146.bmd|0x007267": "「よそ見している暇はないぞ！」", "Battle/Dat/Battle/Message/146.bmd|0x007295": "「この連携がかわせるか！」", "Battle/Dat/Battle/Message/146.bmd|0x0072BD": "「これでとどめだ！」", "Battle/Dat/Battle/Message/146.bmd|0x0072DC": "「確実に倒しておかねば！」", "Battle/Dat/Battle/Message/146.bmd|0x007304": "「フン、逃げ損なったな！」", "Battle/Dat/Battle/Message/146.bmd|0x00732C": "「やらせん！」", "Battle/Dat/Battle/Message/146.bmd|0x007342": "「思うようにはさせん！」", "Battle/Dat/Battle/Message/146.bmd|0x007367": "「今の内に後退を！」", "Battle/Dat/Battle/Message/146.bmd|0x007386": "「馬鹿め、油断したな！」", "Battle/Dat/Battle/Message/146.bmd|0x0073AB": "「一網打尽にしてやる！」", "Battle/Dat/Battle/Message/146.bmd|0x0073D0": "「標的が目白押しだぜ！」", "Battle/Dat/Battle/Message/146.bmd|0x0073F5": "「くらえ！」", "Battle/Dat/Battle/Message/146.bmd|0x007408": "「ソニック・ブレイカー！！」", "Battle/Dat/Battle/Message/146.bmd|0x007433": "「こいつで落とすっ！」", "Battle/Dat/Battle/Message/146.bmd|0x007455": "「うおおおっ！！」", "Battle/Dat/Battle/Message/146.bmd|0x007471": "「さあ、覚悟しろ！」", "Battle/Dat/Battle/Message/146.bmd|0x007490": "「砕け散れ！！」", "Battle/Dat/Battle/Message/146.bmd|0x0074A9": "「こいつで決めてやる！」", "Battle/Dat/Battle/Message/146.bmd|0x0074CE": "「くらえぇぇっ！！」", "Battle/Dat/Battle/Message/146.bmd|0x0074ED": "「落ちろっ！」", "Battle/Dat/Battle/Message/146.bmd|0x007503": "「何としても落とす！」", "Battle/Dat/Battle/Message/147.bmd|0x00502E": "「くらえ！」", "Battle/Dat/Battle/Message/147.bmd|0x005041": "「俺が相手をしてやる！」", "Battle/Dat/Battle/Message/147.bmd|0x005066": "「そこだ！」", "Battle/Dat/Battle/Message/147.bmd|0x005079": "「仕留める！」", "Battle/Dat/Battle/Message/147.bmd|0x00508F": "「確実な攻撃を！」", "Battle/Dat/Battle/Message/147.bmd|0x0050AB": "「ここで食い止める！」", "Battle/Dat/Battle/Message/147.bmd|0x0050CD": "「好きにはやらせん！」", "Battle/Dat/Battle/Message/147.bmd|0x0050EF": "「力の差を教えてやる！」", "Battle/Dat/Battle/Message/147.bmd|0x005114": "「今までの連中と同じにするなよ！」", "Battle/Dat/Battle/Message/147.bmd|0x005148": "「お前達はここで終わりだ！」", "Battle/Dat/Battle/Message/147.bmd|0x005173": "「選ばれた者達の力を見せてやる！」", "Battle/Dat/Battle/Message/147.bmd|0x0051A7": "「母艦さえ落とせば、貴様らも終わりだ！」", "Battle/Dat/Battle/Message/147.bmd|0x0051E4": "「奴らの要はあの艦だ！　沈めてみせる！」", "Battle/Dat/Battle/Message/147.bmd|0x005221": "「スペースノア級と言えども！」", "Battle/Dat/Battle/Message/147.bmd|0x00524F": "「何がＳＲＸ計画だ、笑わせるな！」", "Battle/Dat/Battle/Message/147.bmd|0x005283": "「所詮は試作機！　すぐにボロが出るさ！」", "Battle/Dat/Battle/Message/147.bmd|0x0052C0": "「奴らを合体させるわけには！」"}