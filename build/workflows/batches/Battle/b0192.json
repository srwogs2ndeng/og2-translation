{"Battle/Dat/Battle/Message/107.bmd|0x008D8C": "「そうよ！/　あたしを狙って来なさい、ルイーナ！」", "Battle/Dat/Battle/Message/107.bmd|0x008DD6": "「見切ったわよ、ガリルナガン！」", "Battle/Dat/Battle/Message/107.bmd|0x008E07": "「ゲストなんかに！」", "Battle/Dat/Battle/Message/107.bmd|0x008E26": "「妖機人なんかにやられるもんか！」", "Battle/Dat/Battle/Message/107.bmd|0x008E5A": "「化け物とじゃれ合う趣味はないわ！」", "Battle/Dat/Battle/Message/107.bmd|0x008E91": "「あんなのに食いつかれたら……！」", "Battle/Dat/Battle/Message/107.bmd|0x008EC5": "「あんたなんかと一つになる気はないわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x008F05": "「ガンエデンの加護なんていらないわ！」", "Battle/Dat/Battle/Message/107.bmd|0x008F3F": "「人が造った神様なんて！」", "Battle/Dat/Battle/Message/107.bmd|0x008F67": "「かわせた！」", "Battle/Dat/Battle/Message/107.bmd|0x008F7D": "「当たるわけにはいかないんだから！」", "Battle/Dat/Battle/Message/107.bmd|0x008FB4": "「次も避けてみせる！」", "Battle/Dat/Battle/Message/107.bmd|0x008FD6": "「今のは危なかったぁ……」", "Battle/Dat/Battle/Message/107.bmd|0x008FFE": "（うぅ～、ホントに）", "Battle/Dat/Battle/Message/107.bmd|0x00901D": "「ふう……」", "Battle/Dat/Battle/Message/107.bmd|0x009030": "（うぅ～、危なかったぁ）", "Battle/Dat/Battle/Message/107.bmd|0x009055": "（だ、大丈夫なの？）", "Battle/Dat/Battle/Message/107.bmd|0x009074": "「あたしだって、このぐらいは！」", "Battle/Dat/Battle/Message/107.bmd|0x0090A5": "「当たらないわ、ウェントス！」", "Battle/Dat/Battle/Message/107.bmd|0x0090D3": "「見える、ウェントスの動きが……！」", "Battle/Dat/Battle/Message/107.bmd|0x00910A": "「無駄よ、ルイーナ！」", "Battle/Dat/Battle/Message/107.bmd|0x00912C": "「ジンライを振り切ったわ！」", "Battle/Dat/Battle/Message/107.bmd|0x009157": "「スピードは前と変わってない……！？」", "Battle/Dat/Battle/Message/107.bmd|0x009191": "「ガリルナガンを振り切ったわ！」", "Battle/Dat/Battle/Message/107.bmd|0x0091C2": "「見た目通り、動きは遅いのね」", "Battle/Dat/Battle/Message/107.bmd|0x0091F0": "「見切れるわ、雀武王の動きを！」", "Battle/Dat/Battle/Message/107.bmd|0x009221": "「………」", "Battle/Dat/Battle/Message/107.bmd|0x009231": "「手も足も出ない……！？」", "Battle/Dat/Battle/Message/107.bmd|0x009259": "「くっ、このままじゃ……！」", "Battle/Dat/Battle/Message/107.bmd|0x009284": "（リ、リアナ、どうしよう！？）", "Battle/Dat/Battle/Message/107.bmd|0x0092B2": "「何とかこの場を凌ぐしかないわ……！」", "Battle/Dat/Battle/Message/107.bmd|0x0092EC": "（うぅ～、攻撃できないの！？）", "Battle/Dat/Battle/Message/107.bmd|0x00931A": "「ええ、いったん下がるわ！」", "Battle/Dat/Battle/Message/107.bmd|0x009345": "「いけない、見失った！」", "Battle/Dat/Battle/Message/107.bmd|0x00936A": "「あいつ、どこへ行ったの！？」", "Battle/Dat/Battle/Message/107.bmd|0x009398": "「こっちの死角に入った……！？」", "Battle/Dat/Battle/Message/107.bmd|0x0093C9": "「こっちからも！」", "Battle/Dat/Battle/Message/107.bmd|0x0093E5": "「後はあたしが！」", "Battle/Dat/Battle/Message/107.bmd|0x009401": "「任せて、やってみせるわ！」", "Battle/Dat/Battle/Message/107.bmd|0x00942C": "「まだあたしがいるのよ！」", "Battle/Dat/Battle/Message/107.bmd|0x009454": "「あたしの出番ね！」", "Battle/Dat/Battle/Message/107.bmd|0x009473": "「アニキ、後は任せて！」", "Battle/Dat/Battle/Message/107.bmd|0x009498": "「アニキ、あたしも！」", "Battle/Dat/Battle/Message/107.bmd|0x0094BA": "「援護するわ、アニキ！」", "Battle/Dat/Battle/Message/107.bmd|0x0094DF": "「ウェン、後はあたしが！」", "Battle/Dat/Battle/Message/107.bmd|0x009507": "「こっちからも行くわ、ウェン！」", "Battle/Dat/Battle/Message/107.bmd|0x009538": "「援護するわ、ウェン！」", "Battle/Dat/Battle/Message/107.bmd|0x00955D": "「ラキ、あたしに任せて！」", "Battle/Dat/Battle/Message/107.bmd|0x009585": "「手伝うわ、ラキ！」", "Battle/Dat/Battle/Message/107.bmd|0x0095A4": "「カイ少佐、後はあたしが！」", "Battle/Dat/Battle/Message/107.bmd|0x0095CF": "「アラド、どこへ行くの！？」", "Battle/Dat/Battle/Message/107.bmd|0x0095FA": "「ゼオラ、援護するわ！」", "Battle/Dat/Battle/Message/107.bmd|0x00961F": "「ラトゥーニ、続けて行くわ！」", "Battle/Dat/Battle/Message/107.bmd|0x00964D": "「ラミアさん、後は任せて！」", "Battle/Dat/Battle/Message/107.bmd|0x009678": "「ヒューゴさん、後はあたしが！」", "Battle/Dat/Battle/Message/107.bmd|0x0096A9": "「アクアさん、後は任せて！」", "Battle/Dat/Battle/Message/107.bmd|0x0096D4": "「イング、援護するわ！」", "Battle/Dat/Battle/Message/107.bmd|0x0096F9": "「守ってみせる！」", "Battle/Dat/Battle/Message/107.bmd|0x009715": "「この子なら、受け止められる！」", "Battle/Dat/Battle/Message/107.bmd|0x009746": "「やらせないっ！」", "Battle/Dat/Battle/Message/107.bmd|0x009762": "「こっちで受け止める！」", "Battle/Dat/Battle/Message/107.bmd|0x009787": "「こっちはまだもつから！」", "Battle/Dat/Battle/Message/107.bmd|0x0097AF": "「この子は頑丈だから！」", "Battle/Dat/Battle/Message/107.bmd|0x0097D4": "「アニキ、危ない！」", "Battle/Dat/Battle/Message/107.bmd|0x0097F3": "「アニキ、下がって！」", "Battle/Dat/Battle/Message/107.bmd|0x009815": "「アニキをやらせはしないっ！」", "Battle/Dat/Battle/Message/107.bmd|0x009843": "「ウェン、早く逃げて！」", "Battle/Dat/Battle/Message/107.bmd|0x009868": "「ウェン、無茶しないで！」", "Battle/Dat/Battle/Message/107.bmd|0x009890": "「ウェンはあたしが守る！」", "Battle/Dat/Battle/Message/107.bmd|0x0098B8": "「ラキ、下がって！」", "Battle/Dat/Battle/Message/107.bmd|0x0098D7": "「ラキ、危ない！」", "Battle/Dat/Battle/Message/107.bmd|0x0098F3": "「アラド、早く逃げて！」", "Battle/Dat/Battle/Message/107.bmd|0x009918": "「ゼオラ、ここは任せて！」", "Battle/Dat/Battle/Message/107.bmd|0x009940": "「ラトゥーニ、ここはあたしが！」", "Battle/Dat/Battle/Message/107.bmd|0x009971": "「イング、下がって！」", "Battle/Dat/Battle/Message/107.bmd|0x009993": "「まだ行けるわ！」", "Battle/Dat/Battle/Message/107.bmd|0x0099AF": "「もう一回行くわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x0099D1": "「このチャンス、逃がさない！」", "Battle/Dat/Battle/Message/107.bmd|0x0099FF": "（リアナ、まだあそこに！）", "Battle/Dat/Battle/Message/107.bmd|0x009A27": "「わかってる！　もう一回！」", "Battle/Dat/Battle/Message/107.bmd|0x009A52": "「それっ！」", "Battle/Dat/Battle/Message/107.bmd|0x009A65": "「そこっ！」", "Battle/Dat/Battle/Message/107.bmd|0x009A78": "「このぉ、なめるなっ！」", "Battle/Dat/Battle/Message/107.bmd|0x009A9D": "「これでどう！？」", "Battle/Dat/Battle/Message/107.bmd|0x009AB9": "「当ててみせる！」", "Battle/Dat/Battle/Message/107.bmd|0x009AD5": "「外すもんか！」", "Battle/Dat/Battle/Message/107.bmd|0x009AEE": "「これでっ！」", "Battle/Dat/Battle/Message/107.bmd|0x009B04": "「フォース・バスター！」", "Battle/Dat/Battle/Message/107.bmd|0x009B29": "「このっ、落ちろ！」", "Battle/Dat/Battle/Message/107.bmd|0x009B48": "「バレル展開！」", "Battle/Dat/Battle/Message/107.bmd|0x009B61": "「フォース・バスター、発射！」", "Battle/Dat/Battle/Message/107.bmd|0x009B8F": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/107.bmd|0x009BB4": "「落ちてよ……行けっ！！」", "Battle/Dat/Battle/Message/107.bmd|0x009BDC": "「アルスノーヴァ！」", "Battle/Dat/Battle/Message/107.bmd|0x009BFB": "「ナン・ドゥ、射出！」", "Battle/Dat/Battle/Message/107.bmd|0x009C1D": "「セット！」", "Battle/Dat/Battle/Message/107.bmd|0x009C30": "「ナイト・ディメンション！」", "Battle/Dat/Battle/Message/107.bmd|0x009C5B": "「来て、アルスノーヴァ！」", "Battle/Dat/Battle/Message/107.bmd|0x009C83": "「ナン・ドゥ、パージ！」", "Battle/Dat/Battle/Message/107.bmd|0x009CA8": "「この！　このっ！　このぉぉっ！！」", "Battle/Dat/Battle/Message/107.bmd|0x009CDF": "「これで終わりよ！」", "Battle/Dat/Battle/Message/107.bmd|0x009CFE": "「落ちろっ！！」", "Battle/Dat/Battle/Message/107.bmd|0x009D17": "「ライン・ロック・ランチャー！」", "Battle/Dat/Battle/Message/107.bmd|0x009D48": "「お願い、アルスノーヴァ！」", "Battle/Dat/Battle/Message/107.bmd|0x009D73": "「シュンパティア、ＳＣファンクション！」", "Battle/Dat/Battle/Message/107.bmd|0x009DB0": "「軸合わせ！」", "Battle/Dat/Battle/Message/107.bmd|0x009DC6": "「ドッキング！」", "Battle/Dat/Battle/Message/107.bmd|0x009DDF": "「ナン・ドゥ、トロワ、発射！」", "Battle/Dat/Battle/Message/107.bmd|0x009E0D": "「ドッキングよ、アルスノーヴァ！」", "Battle/Dat/Battle/Message/107.bmd|0x009E41": "「ＳＣファンクション、アクティブ！」", "Battle/Dat/Battle/Message/107.bmd|0x009E78": "「ナン・ドゥ！　ナン・トロワ！」", "Battle/Dat/Battle/Message/107.bmd|0x009EA9": "「ＦＡＳロック！」", "Battle/Dat/Battle/Message/107.bmd|0x009EC5": "「行っけぇぇぇっ！！」", "Battle/Dat/Battle/Message/107.bmd|0x009EE7": "「バレル・オープン！！」", "Battle/Dat/Battle/Message/107.bmd|0x009F0C": "「ライン・ロック・ランチャーーッ！！」", "Battle/Dat/Battle/Message/107.bmd|0x009F46": "「クアドラプル・キャノン！」", "Battle/Dat/Battle/Message/107.bmd|0x009F71": "「このっ！　このっ！」", "Battle/Dat/Battle/Message/107.bmd|0x009F93": "「このぉぉっ！！」", "Battle/Dat/Battle/Message/107.bmd|0x009FAF": "「クアドラプル・キャノンで！」", "Battle/Dat/Battle/Message/107.bmd|0x009FDD": "「当たれ！　当たれ！」"}