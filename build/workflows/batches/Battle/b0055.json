{"Battle/Dat/Battle/Message/039.bmd|0x008B16": "「ヒューゴ少尉、援護します！」", "Battle/Dat/Battle/Message/039.bmd|0x008B44": "「手伝います、アクア少尉！」", "Battle/Dat/Battle/Message/039.bmd|0x008B6F": "「ジョッシュ君、後は私が！」", "Battle/Dat/Battle/Message/039.bmd|0x008B9A": "「リム、援護するわ！」", "Battle/Dat/Battle/Message/039.bmd|0x008BBC": "「トウマ君、後は任せて！」", "Battle/Dat/Battle/Message/039.bmd|0x008BE4": "「イング君、私が援護を！」", "Battle/Dat/Battle/Message/039.bmd|0x008C0C": "「テュッティさん、援護します！」", "Battle/Dat/Battle/Message/039.bmd|0x008C3D": "「ミオ、手伝うわ！」", "Battle/Dat/Battle/Message/039.bmd|0x008C5C": "「後は任せて、プレシア！」", "Battle/Dat/Battle/Message/039.bmd|0x008C84": "「ヤンロンさん、援護します！」", "Battle/Dat/Battle/Message/039.bmd|0x008CB2": "「ミチル君、手伝うわ！」", "Battle/Dat/Battle/Message/039.bmd|0x008CD7": "「守られてるだけじゃ嫌だもの！」", "Battle/Dat/Battle/Message/039.bmd|0x008D08": "「助けますっ！」", "Battle/Dat/Battle/Message/039.bmd|0x008D21": "「この場を何とかしなくちゃ！」", "Battle/Dat/Battle/Message/039.bmd|0x008D4F": "「ここは私が引き受けますっ！」", "Battle/Dat/Battle/Message/039.bmd|0x008D7D": "「下がって、リュウセイ君！」", "Battle/Dat/Battle/Message/039.bmd|0x008DA8": "「リオ、早く下がって！」", "Battle/Dat/Battle/Message/039.bmd|0x008DCD": "「リョウト君、後退して！」", "Battle/Dat/Battle/Message/039.bmd|0x008DF5": "「タスク君、危ない！」", "Battle/Dat/Battle/Message/039.bmd|0x008E17": "「レオナ、ここは任せて！」", "Battle/Dat/Battle/Message/039.bmd|0x008E3F": "「ユウキ君、後退して！」", "Battle/Dat/Battle/Message/039.bmd|0x008E64": "「カーラ、早く逃げて！」", "Battle/Dat/Battle/Message/039.bmd|0x008E89": "「中尉、離脱してください」", "Battle/Dat/Battle/Message/039.bmd|0x008EB1": "「エクセレン少尉、ここは私が！」", "Battle/Dat/Battle/Message/039.bmd|0x008EE2": "「離脱して下さい、ラミアさん！」", "Battle/Dat/Battle/Message/039.bmd|0x008F13": "「マサキ君、無理しないで！」", "Battle/Dat/Battle/Message/039.bmd|0x008F3E": "「リューネ、早く逃げて！」", "Battle/Dat/Battle/Message/039.bmd|0x008F66": "「アラド君、よそ見しちゃダメ！」", "Battle/Dat/Battle/Message/039.bmd|0x008F97": "「アイビスさん、早く離脱して下さい！」", "Battle/Dat/Battle/Message/039.bmd|0x008FD1": "「レーツェルさん、ここは私が！」", "Battle/Dat/Battle/Message/039.bmd|0x009002": "「先生、無理しないで下さい！」", "Battle/Dat/Battle/Message/039.bmd|0x009030": "「ブリット君、無茶しないで！」", "Battle/Dat/Battle/Message/039.bmd|0x00905E": "「コウタ君、早く逃げて！」", "Battle/Dat/Battle/Message/039.bmd|0x009086": "「ラウル君、ここは任せて！」", "Battle/Dat/Battle/Message/039.bmd|0x0090B1": "「フィオナ、下がって！」", "Battle/Dat/Battle/Message/039.bmd|0x0090D6": "「アリエイル、ここは私が！」", "Battle/Dat/Battle/Message/039.bmd|0x009101": "「ヒューゴ少尉、離脱して下さい！」", "Battle/Dat/Battle/Message/039.bmd|0x009135": "「アクア少尉、後退して下さい！」", "Battle/Dat/Battle/Message/039.bmd|0x009166": "「ジョッシュ君、下がって！」", "Battle/Dat/Battle/Message/039.bmd|0x009191": "「リム、危ない！」", "Battle/Dat/Battle/Message/039.bmd|0x0091AD": "「トウマ君、無茶はしないで！」", "Battle/Dat/Battle/Message/039.bmd|0x0091DB": "「イング君、離脱して！」", "Battle/Dat/Battle/Message/039.bmd|0x009200": "「テュッティさん、離脱して下さい！」", "Battle/Dat/Battle/Message/039.bmd|0x009237": "「ミオ、余所見はダメよ！」", "Battle/Dat/Battle/Message/039.bmd|0x00925F": "「プレシア、今行くわ！」", "Battle/Dat/Battle/Message/039.bmd|0x009284": "「ヤンロンさん、ここは任せて下さい！」", "Battle/Dat/Battle/Message/039.bmd|0x0092BE": "「ミチル君、避けないつもりなの！？」", "Battle/Dat/Battle/Message/039.bmd|0x0092F5": "「一気に行きますっ！」", "Battle/Dat/Battle/Message/039.bmd|0x009317": "「相手が多くたって！」", "Battle/Dat/Battle/Message/039.bmd|0x009339": "「チャンスよ！　龍虎王！」", "Battle/Dat/Battle/Message/039.bmd|0x009361": "「まだいけるっ！」", "Battle/Dat/Battle/Message/039.bmd|0x00937D": "「もう一回！　これで！」", "Battle/Dat/Battle/Message/039.bmd|0x0093A2": "「このタイミングなら！」", "Battle/Dat/Battle/Message/039.bmd|0x0093C7": "「これでっ！」", "Battle/Dat/Battle/Message/039.bmd|0x0093DD": "「行きますっ！！」", "Battle/Dat/Battle/Message/039.bmd|0x0093F9": "「標的確認……！」", "Battle/Dat/Battle/Message/039.bmd|0x009415": "「ハイ・ツインランチャー！！」", "Battle/Dat/Battle/Message/039.bmd|0x009443": "「発射しますっ！」", "Battle/Dat/Battle/Message/039.bmd|0x00945F": "「雷声大帝、来たりて我の敵を討て！/　急々如律令！　勅！　勅！　勅！！」", "Battle/Dat/Battle/Message/039.bmd|0x0094CA": "「百邪斬断、万精駆滅！　急々如律令！/　勅！　勅！　勅！　勅！！」", "Battle/Dat/Battle/Message/039.bmd|0x00952C": "「龍王炎符水！！」", "Battle/Dat/Battle/Message/039.bmd|0x009548": "「必殺！　マグマ・ヴァサール！！」", "Battle/Dat/Battle/Message/039.