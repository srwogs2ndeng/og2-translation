{"Battle/Dat/Battle/Message/158.bmd|0x002FA5": "「やはり、そう来たか」", "Battle/Dat/Battle/Message/158.bmd|0x002FC7": "「無駄だっ！」", "Battle/Dat/Battle/Message/158.bmd|0x002FDD": "「効くものか！」", "Battle/Dat/Battle/Message/158.bmd|0x002FF6": "「そんなもの！」", "Battle/Dat/Battle/Message/158.bmd|0x00300F": "「………」", "Battle/Dat/Battle/Message/158.bmd|0x00301F": "「反撃できんとは！」", "Battle/Dat/Battle/Message/158.bmd|0x00303E": "「くっ、これでは！」", "Battle/Dat/Battle/Message/158.bmd|0x00305D": "「手出し出来んとは……！」", "Battle/Dat/Battle/Message/158.bmd|0x003085": "「残弾の確認を怠ったか！」", "Battle/Dat/Battle/Message/158.bmd|0x0030AD": "「ロストしたか……！」", "Battle/Dat/Battle/Message/158.bmd|0x0030CF": "「奴め、どこへ消えた！？」", "Battle/Dat/Battle/Message/158.bmd|0x0030F7": "「ちっ、見失ったか！」", "Battle/Dat/Battle/Message/158.bmd|0x003119": "「くっ、この間合いでは！」", "Battle/Dat/Battle/Message/158.bmd|0x003141": "「援護に入る！」", "Battle/Dat/Battle/Message/158.bmd|0x00315A": "「後は任せておけっ！」", "Battle/Dat/Battle/Message/158.bmd|0x00317C": "「将軍、援護します！」", "Battle/Dat/Battle/Message/158.bmd|0x00319E": "「もう一撃！」", "Battle/Dat/Battle/Message/158.bmd|0x0031B4": "「こちらで引き受ける！」", "Battle/Dat/Battle/Message/158.bmd|0x0031D9": "「やらせるものか！」", "Battle/Dat/Battle/Message/158.bmd|0x0031F8": "「将軍、ここは自分が！」", "Battle/Dat/Battle/Message/158.bmd|0x00321D": "「体勢を崩したな！」", "Battle/Dat/Battle/Message/158.bmd|0x00323C": "「隙あり！」", "Battle/Dat/Battle/Message/158.bmd|0x00324F": "「こいつで！」", "Battle/Dat/Battle/Message/158.bmd|0x003265": "「くらえっ！」", "Battle/Dat/Battle/Message/158.bmd|0x00327B": "「もらう！」", "Battle/Dat/Battle/Message/158.bmd|0x00328E": "「受けろ！」", "Battle/Dat/Battle/Message/158.bmd|0x0032A1": "「やあっ！」", "Battle/Dat/Battle/Message/158.bmd|0x0032B4": "「むんっ！」", "Battle/Dat/Battle/Message/158.bmd|0x0032C7": "「はあっ！」", "Battle/Dat/Battle/Message/158.bmd|0x0032DA": "「たあっ！」", "Battle/Dat/Battle/Message/158.bmd|0x0032ED": "「そこだ！」", "Battle/Dat/Battle/Message/158.bmd|0x003300": "「当ててやる！」", "Battle/Dat/Battle/Message/158.bmd|0x003319": "「機銃座、撃ち方始め！」", "Battle/Dat/Battle/Message/158.bmd|0x00333E": "「対空機銃、撃て！」", "Battle/Dat/Battle/Message/158.bmd|0x00335D": "「高射砲、発射用意！　撃て！」", "Battle/Dat/Battle/Message/158.bmd|0x00338B": "「高射砲、１番、２番！　撃て！」", "Battle/Dat/Battle/Message/158.bmd|0x0033BC": "「前部全砲塔、発射用意！　撃て！」", "Battle/Dat/Battle/Message/158.bmd|0x0033F0": "「前部砲塔、一斉射撃！　撃て！」", "Battle/Dat/Battle/Message/158.bmd|0x003421": "「バリオン・ビーム砲、発射用意！」", "Battle/Dat/Battle/Message/158.bmd|0x003455": "「撃て！」", "Battle/Dat/Battle/Message/158.bmd|0x003465": "「主砲、発射用意！」", "Battle/Dat/Battle/Message/159.bmd|0x00234B": "「照準セット。ターゲット、ロックオン！」", "Battle/Dat/Battle/Message/159.bmd|0x002388": "「目標、目視で確認！」", "Battle/Dat/Battle/Message/159.bmd|0x0023AA": "「殿下のためならば！」", "Battle/Dat/Battle/Message/159.bmd|0x0023CC": "「やってみせる！」", "Battle/Dat/Battle/Message/159.bmd|0x0023E8": "「攻撃開始！」", "Battle/Dat/Battle/Message/159.bmd|0x0023FE": "「逆賊に容赦はせん！」", "Battle/Dat/Battle/Message/159.bmd|0x002420": "「大義は我らにあり！」", "Battle/Dat/Battle/Message/159.bmd|0x002442": "「殿下に抗うのであれば！」", "Battle/Dat/Battle/Message/159.bmd|0x00246A": "「行くぞ、地上人！」", "Battle/Dat/Battle/Message/159.bmd|0x002489": "「地上人の好きにはやらせん！」", "Battle/Dat/Battle/Message/159.bmd|0x0024B7": "「我らに与せぬのであれば、/　地上人とて容赦はせん！」", "Battle/Dat/Battle/Message/159.bmd|0x002507": "「サイバスター……食い止めてみせる！」", "Battle/Dat/Battle/Message/159.bmd|0x002541": "「サイバスター相手でも怯むわけには！」", "Battle/Dat/Battle/Message/159.bmd|0x00257B": "「魔装機神が相手でも！」", "Battle/Dat/Battle/Message/159.bmd|0x0025A0": "「魔装機神でも、隙はどこかにあるはずだ！」", "Battle/Dat/Battle/Message/159.bmd|0x0025E0": "「グランヴェールの足を止める！」", "Battle/Dat/Battle/Message/159.bmd|0x002611": "「ガッデスを食い止めてみせる！」", "Battle/Dat/Battle/Message/159.bmd|0x002642": "「ザムジード……何としても！」", "Battle/Dat/Battle/Message/159.bmd|0x002670": "「やらせんっ！」", "Battle/Dat/Battle/Message/159.bmd|0x002689": "「反撃する！」", "Battle/Dat/Battle/Message/159.bmd|0x00269F": "「次はこちらの番だ！」", "Battle/Dat/Battle/Message/159.bmd|0x0026C1": "「まだここからだ！」", "Battle/Dat/Battle/Message/159.bmd|0x0026E0": "「うあああっ！！」", "Battle/Dat/Battle/Message/159.bmd|0x0026FC": "「こ、ここまでか！」", "Battle/Dat/Battle/Message/159.bmd|0x00271B": "「し、しまった！！」", "Battle/Dat/Battle/Message/159.bmd|0x00273A": "「ぐうっ！/　こちらの見通しが甘かったか……！」", "Battle/Dat/Battle/Message/159.bmd|0x002781": "「殿下のために、ここで退くわけにはいかん！」", "Battle/Dat/Battle/Message/159.bmd|0x0027C4": "「わ、我らには大義が！　意地があるのだ！！」", "Battle/Dat/Battle/Message/159.bmd|0x002807": "「ふ、ふふふ……覚悟はもう出来ている……！」", "Battle/Dat/Battle/Message/159.bmd|0x00284A": "「わ、我らの義を世に示すために……/　そのためには！」", "Battle/Dat/Battle/Message/159.bmd|0x00289A": "「ち、地上人……その力があれば……！」", "Battle/Dat/Battle/Message/159.bmd|0x0028D4": "「ええい、地上人め！/　これ以上はやらせんぞ！」", "Battle/Dat/Battle/Message/159.bmd|0x00291B": "「サ、サイバスター……強過ぎる！」", "Battle/Dat/Battle/Message/159.bmd|0x00294F": "「うぐっ……やはり、魔装機神には……！」", "Battle/Dat/Battle/Message/159.bmd|0x00298C": "「ぐっ！/　覚悟なくして、魔装機神には挑まん！！」", "Battle/Dat/Battle/Message/159.bmd|0x0029D6": "「こ、これが炎の魔装機神の力か！」", "Battle/Dat/Battle/Message/159.bmd|0x002A0A": "「ガッデス……/　せめて、足止めだけでも……！！」", "Battle/Dat/Battle/Message/159.bmd|0x002A54": "「ザムジード……何というパワー……！」", "Battle/Dat/Battle/Message/159.bmd|0x002A8E": "「くっ！　まだ任務は続行可能だ！」", "Battle/Dat/Battle/Message/159.bmd|0x002AC2": "「まともに当たったか……！」", "Battle/Dat/Battle/Message/159.bmd|0x002AED": "「チッ、いい目をしている！」", "Battle/Dat/Battle/Message/159.bmd|0x002B18": "「くっ！　あくまでも抗うか！」", "Battle/Dat/Battle/Message/159.bmd|0x002B46": "「この程度で怯む我らではない！」", "Battle/Dat/Battle/Message/159.bmd|0x002B77": "「地上人め、まだ抵抗するか！」", "Battle/Dat/Battle/Message/159.bmd|0x002BA5": "「やるな、地上人！」", "Battle/Dat/Battle/Message/159.bmd|0x002BC4": "「何としてもサイバスターを止めねば！」", "Battle/Dat/Battle/Message/159.bmd|0x002BFE": "「くっ！　魔装機神……やはり、強い！」", "Battle/Dat/Battle/Message/159.bmd|0x002C38": "「その力、殿下のために使えば……！」", "Battle/Dat/Battle/Message/159.bmd|0x002C6F": "「グランヴェール……一筋縄ではいかんな」", "Battle/Dat/Battle/Message/159.bmd|0x002CAC": "「ガ、ガッデス……さすがだな……！」", "Battle/Dat/Battle/Message/159.bmd|0x002CE3": "「くっ！　ザムジードを止められんのか！？」", "Battle/Dat/Battle/Message/159.bmd|0x002D23": "「損傷軽微。このまま戦闘を続行する」", "Battle/Dat/Battle/Message/159.bmd|0x002D5A": "「そう簡単にやられるか！」", "Battle/Dat/Battle/Message/159.bmd|0x002D82": "「被害微弱。状況続行」", "Battle/Dat/Battle/Message/159.bmd|0x002DA4": "「この程度、気にする必要はない」", "Battle/Dat/Battle/Message/159.bmd|0x002DD5": "「気迫が足りんぞ！」", "Battle/Dat/Battle/Message/159.bmd|0x002DF4": "「甘いぞ、地上人！」", "Battle/Dat/Battle/Message/159.bmd|0x002E13": "「地上人よ、遠慮は無用だ！」", "Battle/Dat/Battle/Message/159.bmd|0x002E3E": "「サイバスターを振り切れなかったか……！」", "Battle/Dat/Battle/Message/159.bmd|0x002E7E": "「魔装機神の力がこの程度だとは思えんが……」", "Battle/Dat/Battle/Message/159.bmd|0x002EC1": "「これならば、魔装機神と戦えるぞ！」", "Battle/Dat/Battle/Message/159.bmd|0x002EF8": "「グランヴェールの力は、/　こんなものではないはずだ」", "Battle/Dat/Battle/Message/159.bmd|0x002F48": "「ガッデス……手加減をしているのか？」", "Battle/Dat/Battle/Message/159.bmd|0x002F82": "「ザムジードの力を/　使いこなせていないようだな！」", "Battle/Dat/Battle/Message/159.bmd|0x002FCF": "「当たるものか！」", "Battle/Dat/Battle/Message/159.bmd|0x002FEB": "「魔装機神と言えど、動きをよく見れば！」", "Battle/Dat/Battle/Message/159.bmd|0x003028": "「よし、回避成功！」", "Battle/Dat/Battle/Message/159.bmd|0x003047": "「ふっ、予測通りだ」", "Battle/Dat/Battle/Message/159.bmd|0x003066": "「やはり、そう来たか」", "Battle/Dat/Battle/Message/159.bmd|0x003088": "「無駄だっ！」", "Battle/Dat/Battle/Message/159.bmd|0x00309E": "「効くものか！」", "Battle/Dat/Battle/Message/159.bmd|0x0030B7": "「そんなもの！」", "Battle/Dat/Battle/Message/159.bmd|0x0030D0": "「………」", "Battle/Dat/Battle/Message/159.bmd|0x0030E0": "「こんな時に弾切れか！」", "Battle/Dat/Battle/Message/159.bmd|0x003105": "「反撃できんとは！」", "Battle/Dat/Battle/Message/159.bmd|0x003124": "「くっ、これでは！」", "Battle/Dat/Battle/Message/159.bmd|0x003143": "「手出し出来んとは……！」", "Battle/Dat/Battle/Message/159.bmd|0x00316B": "「ロストしたか……！」", "Battle/Dat/Battle/Message/159.bmd|0x00318D": "「奴め、どこへ消えた！？」"}