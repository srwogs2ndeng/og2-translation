{"Battle/Dat/Battle/Message/045.bmd|0x00BB78": "「いい位置だな……！」", "Battle/Dat/Battle/Message/045.bmd|0x00BB9A": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/045.bmd|0x00BBBF": "「落ちてもらうっ！」", "Battle/Dat/Battle/Message/045.bmd|0x00BBDE": "「落ちろっ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00BBF7": "「当たれっ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00BC10": "「さて、一発ブチかますとするか！」", "Battle/Dat/Battle/Message/045.bmd|0x00BC44": "「ターゲット・ロックオン！」", "Battle/Dat/Battle/Message/045.bmd|0x00BC6F": "「こいつで決めてやる！！」", "Battle/Dat/Battle/Message/045.bmd|0x00BC97": "「そらっ！」", "Battle/Dat/Battle/Message/045.bmd|0x00BCAA": "「格闘戦にはちょいと自信があるんでな！」", "Battle/Dat/Battle/Message/045.bmd|0x00BCE7": "「吹き飛べぇっ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00BD06": "「無茶な武器だが、/　威力は半端じゃないんでね！」", "Battle/Dat/Battle/Message/045.bmd|0x00BD50": "「チャムラム・シューター！」", "Battle/Dat/Battle/Message/045.bmd|0x00BD7B": "「チャムラム・シューター！　行けっ！」", "Battle/Dat/Battle/Message/045.bmd|0x00BDB5": "「まとめて片付けてやるぜ！」", "Battle/Dat/Battle/Message/045.bmd|0x00BDE0": "「Ｇインパクト・キャノン、発射！！」", "Battle/Dat/Battle/Message/045.bmd|0x00BE17": "「ドリル・ブーストナックル！」", "Battle/Dat/Battle/Message/045.bmd|0x00BE45": "「ドリル・アタック！！」", "Battle/Dat/Battle/Message/045.bmd|0x00BE6A": "「アイソリッド・レーザー、発射！！」", "Battle/Dat/Battle/Message/045.bmd|0x00BEA1": "「くらえっ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00BEBA": "「ブッ飛びな！！」", "Battle/Dat/Battle/Message/045.bmd|0x00BED6": "「こいつでブッ飛ばしてやるぜ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00BF0A": "「ドリル・ブーストナックル！　くらえっ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00BF4D": "「オメガ・ブラスター！！」", "Battle/Dat/Battle/Message/045.bmd|0x00BF75": "「必殺！　オメガ・ブラスター！！」", "Battle/Dat/Battle/Message/045.bmd|0x00BFA9": "「抜けば珠散る氷の刃……」", "Battle/Dat/Battle/Message/045.bmd|0x00BFD1": "「ま、意味は違うけどな！」", "Battle/Dat/Battle/Message/045.bmd|0x00BFF9": "「大仰な武器だねえ、こいつも」", "Battle/Dat/Battle/Message/045.bmd|0x00C027": "「捕まえたぜ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C040": "「砕けろっ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C059": "「ジャケットアーマー、パージ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C08A": "「ウィング展開！」", "Battle/Dat/Battle/Message/045.bmd|0x00C0A6": "「さあ、覚悟を決めな！」", "Battle/Dat/Battle/Message/045.bmd|0x00C0CB": "「ビクティム・ビーク！」", "Battle/Dat/Battle/Message/045.bmd|0x00C0F0": "「一気に叩き落としてやる！」", "Battle/Dat/Battle/Message/045.bmd|0x00C11B": "「Ｗモードでブチかましてやるぜ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C14F": "「そら、行けぇっ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C171": "「ギガント・ナックル！」", "Battle/Dat/Battle/Message/045.bmd|0x00C196": "「ギガ・ワイドブラスター！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C1C4": "「ギガ・サークルブラスター！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C1F5": "「こいつで決めてやるぜ！」　", "Battle/Dat/Battle/Message/045.bmd|0x00C220": "「轟け、雷鳴！」", "Battle/Dat/Battle/Message/045.bmd|0x00C239": "「必殺！　ジガンテ・ウンギア！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C26D": "「ソードブレイカー、セット！」", "Battle/Dat/Battle/Message/045.bmd|0x00C29B": "「そら、行ってこい！」", "Battle/Dat/Battle/Message/045.bmd|0x00C2BD": "「スラッシュ・リッパー、セット！」", "Battle/Dat/Battle/Message/045.bmd|0x00C2F1": "「行ってこい！」", "Battle/Dat/Battle/Message/045.bmd|0x00C30A": "「きっちり追いかけてくれよ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C338": "「スラッシュ・リッパー！」", "Battle/Dat/Battle/Message/045.bmd|0x00C360": "「グラビトン・ランチャー、発射！」", "Battle/Dat/Battle/Message/045.bmd|0x00C394": "「リープ・スラッシャー！」", "Battle/Dat/Battle/Message/045.bmd|0x00C3BC": "「リープ・スラッシャー！　行けっ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C3F3": "「必殺！　シシオウブレード！」", "Battle/Dat/Battle/Message/045.bmd|0x00C421": "「斬ッ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C434": "「懐に飛び込めば、こっちのもんだ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C46B": "「リボルビング・バンカー！」", "Battle/Dat/Battle/Message/045.bmd|0x00C496": "「撃ち抜けぇ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C4B2": "「切り札を使うとするか！」", "Battle/Dat/Battle/Message/045.bmd|0x00C4DA": "「受け取れっ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C4F3": "「あらよっとっ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C50F": "「そろそろ仕上げだ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C531": "「ブレード・サイ、アクティブ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C562": "「決めてやるぜ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C57E": "「このまま押し込んでやる！」", "Battle/Dat/Battle/Message/045.bmd|0x00C5A9": "「フィニッシュ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C5C8": "「メイン・イベントはここからなのさ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C602": "「追い詰めてやるぜ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C624": "「さあ、仕上げだ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C646": "「プラズマステーク、セット！」", "Battle/Dat/Battle/Message/045.bmd|0x00C674": "「くらえ！　ジェット・マグナム！」", "Battle/Dat/Battle/Message/045.bmd|0x00C6A8": "「必殺！　ゲシュペンスト・パンチ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C6E2": "「本命はこっちの方さ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C707": "「そらぁ！　行けえぇっ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C732": "「格闘はＰＴ戦闘の基本だぜ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C760": "「せえいっ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C776": "「とどめ！　ジェット・マグナム！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C7AD": "「プラズマ・ステーク、セット！」", "Battle/Dat/Battle/Message/045.bmd|0x00C7DE": "「メガ・ブラスターキャノン！」", "Battle/Dat/Battle/Message/045.bmd|0x00C80C": "「目にも止まらぬ早業、行ってみようか！」", "Battle/Dat/Battle/Message/045.bmd|0x00C849": "「そぉらあぁぁ！　連打連打！」", "Battle/Dat/Battle/Message/045.bmd|0x00C877": "「まだまだ行くぜ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C896": "「マグナムの次は！」", "Battle/Dat/Battle/Message/045.bmd|0x00C8B5": "「ファントムで決まりなのさ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C8E6": "「ダーク・ロック！」", "Battle/Dat/Battle/Message/045.bmd|0x00C905": "「要は手裏剣なのさ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C927": "「ダーク・ロック！　くらえ！」", "Battle/Dat/Battle/Message/045.bmd|0x00C955": "「おらぁっ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C96E": "「もう一丁！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C987": "「こいつも持っていけ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C9AF": "「こいつで派手にブッ飛びな！」", "Battle/Dat/Battle/Message/045.bmd|0x00C9DD": "「行けぇぇっ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00C9F9": "「改型の鉄拳、受けてもらうぜ！」", "Battle/Dat/Battle/Message/045.bmd|0x00CA2A": "「ビーム・キャノン、連動！」", "Battle/Dat/Battle/Message/045.bmd|0x00CA55": "「アルティメット・ビィィィム！！」", "Battle/Dat/Battle/Message/045.bmd|0x00CA89": "「今度のは３本立てなのさ！」", "Battle/Dat/Battle/Message/045.bmd|0x00CAB4": "「くらえ！　アルティメット・ビーム！！」", "Battle/Dat/Battle/Message/045.bmd|0x00CAF1": "「ファイナルの上はアルティメット、ってね！」", "Battle/Dat/Battle/Message/045.bmd|0x00CB34": "「そらっ！　行けぇぇっ！！」", "Battle/Dat/Battle/Message/045.bmd|0x00CB5F": "「天に二つの禍つ星……！」", "Battle/Dat/Battle/Message/045.bmd|0x00CB87": "「その名も計都羅¶剣！！」", "Battle/Dat/Battle/Message/045.bmd|0x00CBAE": "「暗剣殺！！」", "Battle/Dat/Battle/Message/045.bmd|0x00CBC4": "「空を見ろ、星を見ろ……ってね！」", "Battle/Dat/Battle/Message/045.bmd|0x00CBF8": "「必殺！　計都羅¶剣！」", "Battle/Dat/Battle/Message/045.bmd|0x00CC1C": "「斬！！」", "Battle/Dat/Battle/Message/045.bmd|0x00CC2C": "「大殺神の導きあれ……なんてね」", "Battle/Dat/Battle/Message/045.bmd|0x00CC5D": "「暗殺剣じゃないんで、そこんとこよろしく」", "Battle/Dat/Battle/Message/045.bmd|0x00CC9D": "「連なる凶星吉神を破り、土に帰す……！」", "Battle/Dat/Battle/Message/045.bmd|0x00CCDA": "「五！」", "Battle/Dat/Battle/Message/045.bmd|0x00CCE7": "「黄！」", "Battle/Dat/Battle/Message/045.bmd|0x00CCF4": "「殺！！」", "Battle/Dat/Battle/Message/045.bmd|0x00CD04": "「さーて、今度のも不吉極まりないぜ！」", "Battle/Dat/Battle/Message/045.bmd|0x00CD3E": "「最初からあんたの運は尽きていたのさ」", "Battle/Dat/Battle/Message/045.bmd|0x00CD78": "「……俺も難除けしといた方がいいかな？」", "Battle/Dat/Battle/Message/045.bmd|0x00CDB5": "「ダブル・オメガレーザー！」", "Battle/Dat/Battle/Message/045.bmd|0x00CDE0": "「ビッグ・ミサイル、発射！！」", "Battle/Dat/Battle/Message/045.bmd|0x00CE0E": "「くらえ！　ツイン・ビームキャノン！」", "Battle/Dat/Battle/Message/045.bmd|0x00CE48": "「スパイラル・ブレイカー！」", "Battle/Dat/Battle/Message/045.bmd|0x00CE73": "「アタック！！」", "Battle/Dat/Battle/Message/045.bmd|0x00CE8C": "「オメガ・キャノン！」", "Battle/Dat/Battle/Message/045.bmd|0x00CEAE": "「ここで出し惜しみはしないぜ！」"}