{"Battle/Dat/Battle/Message/150.bmd|0x001C73": "「戦闘を続行する」", "Battle/Dat/Battle/Message/150.bmd|0x001C8F": "「任務遂行に支障なし」", "Battle/Dat/Battle/Message/150.bmd|0x001CB1": "「任務内容に変更なし」", "Battle/Dat/Battle/Message/150.bmd|0x001CD3": "「ダメージ、０」", "Battle/Dat/Battle/Message/150.bmd|0x001CEC": "「損傷なし」", "Battle/Dat/Battle/Message/150.bmd|0x001CFF": "「回避完了」", "Battle/Dat/Battle/Message/150.bmd|0x001D12": "「ネクスト・シーケンス」", "Battle/Dat/Battle/Message/150.bmd|0x001D37": "「反撃不可能」", "Battle/Dat/Battle/Message/150.bmd|0x001D4D": "「ポジション、リセット」", "Battle/Dat/Battle/Message/150.bmd|0x001D72": "「シーケンス、リセット」", "Battle/Dat/Battle/Message/150.bmd|0x001D97": "「射程範囲外」", "Battle/Dat/Battle/Message/150.bmd|0x001DAD": "「攻撃不可能」", "Battle/Dat/Battle/Message/150.bmd|0x001DC3": "「ターゲット、ロスト」", "Battle/Dat/Battle/Message/150.bmd|0x001DE5": "「バックアップ・スタート」", "Battle/Dat/Battle/Message/150.bmd|0x001E0D": "「フォロー・アタック」", "Battle/Dat/Battle/Message/150.bmd|0x001E2F": "「シーケンス続行」", "Battle/Dat/Battle/Message/150.bmd|0x001E4B": "「攻撃阻止」", "Battle/Dat/Battle/Message/150.bmd|0x001E5E": "「友軍機をカバー」", "Battle/Dat/Battle/Message/150.bmd|0x001E7A": "「発射」", "Battle/Dat/Battle/Message/150.bmd|0x001E87": "「ファイア」", "Battle/Dat/Battle/Message/150.bmd|0x001E9A": "「目標捕捉」", "Battle/Dat/Battle/Message/150.bmd|0x001EAD": "「エネルギー・チャージ」", "Battle/Dat/Battle/Message/150.bmd|0x001ED2": "「ターゲット・ロック」", "Battle/Dat/Battle/Message/150.bmd|0x001EF4": "「ターゲット・インサイト」", "Battle/Dat/Battle/Message/150.bmd|0x001F1C": "「バレル、セット」", "Battle/Dat/Battle/Message/150.bmd|0x001F38": "「バレル、アクティブ」", "Battle/Dat/Battle/Message/150.bmd|0x001F5A": "「アタック・シーケンス」", "Battle/Dat/Battle/Message/150.bmd|0x001F7F": "「攻撃開始」", "Battle/Dat/Battle/Message/150.bmd|0x001F92": "「シーケンス推移」", "Battle/Dat/Battle/Message/151.bmd|0x0063F0": "「我らこそが外敵を討ち、/　地球を護る剣なのだ！」", "Battle/Dat/Battle/Message/151.bmd|0x00643A": "「地球圏の未来は、我らが切り開く！」", "Battle/Dat/Battle/Message/151.bmd|0x006471": "「前大戦のエースと言えど！」", "Battle/Dat/Battle/Message/151.bmd|0x00649C": "「叛乱分子を排除する！」", "Battle/Dat/Battle/Message/151.bmd|0x0064C1": "「鋼龍戦隊！　お前達の役目は終わった！」", "Battle/Dat/Battle/Message/151.bmd|0x0064FE": "「鋼龍戦隊、貴様らが犯した罪は重い！」", "Battle/Dat/Battle/Message/151.bmd|0x006538": "「鋼龍戦隊など、もはや無用の長物だ！」", "Battle/Dat/Battle/Message/151.bmd|0x006572": "「鋼龍戦隊、貴様らはここで終わりだ！」", "Battle/Dat/Battle/Message/151.bmd|0x0065AC": "「我らこそが地球の守護者だ！」", "Battle/Dat/Battle/Message/151.bmd|0x0065DA": "「ガイアセイバーズの名の下に、/　お前達を討つ！」", "Battle/Dat/Battle/Message/151.bmd|0x006624": "「裏切り者は死ね！」", "Battle/Dat/Battle/Message/151.bmd|0x006643": "「離反者を始末する！」", "Battle/Dat/Battle/Message/151.bmd|0x006665": "「ゲストの好きにはやらせん！」", "Battle/Dat/Battle/Message/151.bmd|0x006693": "「ゲスト機を撃破する！」", "Battle/Dat/Battle/Message/151.bmd|0x0066B8": "「ルイーナめ、我らが相手だ！」", "Battle/Dat/Battle/Message/151.bmd|0x0066E6": "「我らはお前達など恐れはしない！」", "Battle/Dat/Battle/Message/151.bmd|0x00671A": "「母艦を沈めれば、奴らは終わりだ！」", "Battle/Dat/Battle/Message/151.bmd|0x006751": "「鋼龍戦隊の要はあの艦だ！　沈める！」", "Battle/Dat/Battle/Message/151.bmd|0x00678B": "「スペースノア級と言えども！」", "Battle/Dat/Battle/Message/151.bmd|0x0067B9": "「反逆者の艦に容赦はせんぞ！」", "Battle/Dat/Battle/Message/151.bmd|0x0067E7": "「合体する前に落とす！」", "Battle/Dat/Battle/Message/151.bmd|0x00680C": "「１機落とせば、合体できまい！」", "Battle/Dat/Battle/Message/151.bmd|0x00683D": "「ＳＲＸ計画の試作機など！」", "Battle/Dat/Battle/Message/151.bmd|0x006868": "「エンジンに/　直撃させるわけにはいかんが……！」", "Battle/Dat/Battle/Message/151.bmd|0x0068B2": "「長射程とは言え、穴はあるはずだ！」", "Battle/Dat/Battle/Message/151.bmd|0x0068E9": "「奴の射程にも隙はある！」", "Battle/Dat/Battle/Message/151.bmd|0x006911": "「撃たれる前に撃つ！」", "Battle/Dat/Battle/Message/151.bmd|0x006933": "「アルトアイゼンを落とせば、手柄になる！」", "Battle/Dat/Battle/Message/151.bmd|0x006973": "「杭打ち機などにやられるか！」", "Battle/Dat/Battle/Message/151.bmd|0x0069A1": "「奴のレンジ外から攻撃すれば！」", "Battle/Dat/Battle/Message/151.bmd|0x0069D2": "「ＡＴＸ計画の試作機など！」", "Battle/Dat/Battle/Message/151.bmd|0x0069FD": "「アルトアイゼンもどきめ！」", "Battle/Dat/Battle/Message/151.bmd|0x006A28": "「欠陥機に何が出来る！」", "Battle/Dat/Battle/Message/151.bmd|0x006A4D": "「寄せ集めの機体など！」", "Battle/Dat/Battle/Message/151.bmd|0x006A72": "「無様な姿をさらしおって！」", "Battle/Dat/Battle/Message/151.bmd|0x006A9D": "「見るに忍びん姿だ……完全に破壊してやる！」", "Battle/Dat/Battle/Message/151.bmd|0x006AE0": "「アインストの成れの果てめ！」", "Battle/Dat/Battle/Message/151.bmd|0x006B0E": "「もらったぞ、白騎士！」", "Battle/Dat/Battle/Message/151.bmd|0x006B33": "「フン、ゲシュペンストの改造機など！」", "Battle/Dat/Battle/Message/151.bmd|0x006B6D": "「ゲシュペンストをいくら改造したところで！」", "Battle/Dat/Battle/Message/151.bmd|0x006BB0": "「旧型をどう改造しようと！」", "Battle/Dat/Battle/Message/151.bmd|0x006BDB": "「旧型の改造機など、楽勝だ！」", "Battle/Dat/Battle/Message/151.bmd|0x006C09": "「シリーズ７７が何だと言うのだ！」", "Battle/Dat/Battle/Message/151.bmd|0x006C3D": "「流星は燃え尽きてしまえ！」", "Battle/Dat/Battle/Message/151.bmd|0x006C68": "「プロジェクトＴＤの成果は、/　我らが引き継いでやる！」", "Battle/Dat/Battle/Message/151.bmd|0x006CBB": "「プロジェクトＴＤは、/　我らに利用されて然るべきだ！」", "Battle/Dat/Battle/Message/151.bmd|0x006D0E": "「合体したところで！」", "Battle/Dat/Battle/Message/151.bmd|0x006D30": "「お前達もその機体も、既に用済みだ！」", "Battle/Dat/Battle/Message/151.bmd|0x006D6A": "「お前達の死を以て、/　ＴＤは新たな段階へ進むのだ！」", "Battle/Dat/Battle/Message/151.bmd|0x006DBA": "「零落した凶鳥など！」", "Battle/Dat/Battle/Message/151.bmd|0x006DDC": "「凶鳥の眷属は、消えて然るべきなんだよ！」", "Battle/Dat/Battle/Message/151.bmd|0x006E1C": "「凶鳥の成れの果てに何が出来る！」", "Battle/Dat/Battle/Message/151.bmd|0x006E50": "「呪われた系譜に終止符を打ってやる！」", "Battle/Dat/Battle/Message/151.bmd|0x006E8A": "「凶鳥の宿命に準じ、消え失せろ！」", "Battle/Dat/Battle/Message/151.bmd|0x006EBE": "「フン、図体がでかいだけの機体だ！」", "Battle/Dat/Battle/Message/151.bmd|0x006EF5": "「見かけ倒しめ！」", "Battle/Dat/Battle/Message/151.bmd|0x006F11": "「所詮は力だけの機体だ！」", "Battle/Dat/Battle/Message/151.bmd|0x006F39": "「その装甲、貫いてやる！」", "Battle/Dat/Battle/Message/151.bmd|0x006F61": "「特機は最優先で落とす！」", "Battle/Dat/Battle/Message/151.bmd|0x006F89": "「ダブルＧが相手でも臆するものか！」", "Battle/Dat/Battle/Message/151.bmd|0x006FC0": "「ダブルＧを仕留めれば、/　奴らの士気は下がる！」", "Battle/Dat/Battle/Message/151.bmd|0x00700A": "「大仰な剣を振り回したところで！」", "Battle/Dat/Battle/Message/151.bmd|0x00703E": "「ダイゼンガー！　その首、もらい受けるぞ！」", "Battle/Dat/Battle/Message/151.bmd|0x007081": "「穴馬を仕留める！」", "Battle/Dat/Battle/Message/151.bmd|0x0070A0": "「何が超闘士だ！」", "Battle/Dat/Battle/Message/151.bmd|0x0070BC": "「グルンガストを落とせば、手柄になる！」", "Battle/Dat/Battle/Message/151.bmd|0x0070F9": "「行くぞ、グルンガスト！」", "Battle/Dat/Battle/Message/151.bmd|0x007121": "「シャドウミラーの残党が！」", "Battle/Dat/Battle/Message/151.bmd|0x00714C": "「この世界にお前の居場所はない！」", "Battle/Dat/Battle/Message/151.bmd|0x007180": "「ツェントル・プロジェクトの機体か！」", "Battle/Dat/Battle/Message/151.bmd|0x0071BA": "「ツェントル・プロジェクトの試作機など！」", "Battle/Dat/Battle/Message/151.bmd|0x0071FA": "「サイバスターは最優先で破壊しなければ！」", "Battle/Dat/Battle/Message/151.bmd|0x00723A": "「サイバスターを落とす！」", "Battle/Dat/Battle/Message/151.bmd|0x007262": "「魔装機神を仕留めるぞ！」", "Battle/Dat/Battle/Message/151.bmd|0x00728A": "「ＭＡＰＷを使われる前に落とす！」", "Battle/Dat/Battle/Message/151.bmd|0x0072BE": "「サイバスター以外にも/　魔装機神がいたとはな！」", "Battle/Dat/Battle/Message/151.bmd|0x007308": "「まだアインストが残っていたか！」", "Battle/Dat/Battle/Message/151.bmd|0x00733C": "「次は俺の番だ！」", "Battle/Dat/Battle/Message/151.bmd|0x007358": "「ただでは帰さん！」", "Battle/Dat/Battle/Message/151.bmd|0x007377": "「ガイアセイバーズを相手にして、/　ただで済むと思うな！」", "Battle/Dat/Battle/Message/151.bmd|0x0073CD": "「お返しだ！」", "Battle/Dat/Battle/Message/151.bmd|0x0073E3": "「離脱などさせるか！」", "Battle/Dat/Battle/Message/151.bmd|0x007405": "「反撃を！」", "Battle/Dat/Battle/Message/151.bmd|0x007418": "「仕切り直しだ！」", "Battle/Dat/Battle/Message/151.bmd|0x007434": "「このまま引き下がるつもりはない！」", "Battle/Dat/Battle/Message/151.bmd|0x00746B": "「今度はこちらからだ！」", "Battle/Dat/Battle/Message/151.bmd|0x007490": "「反撃開始！」", "Battle/Dat/Battle/Message/151.bmd|0x0074A6": "「ただで済むと思うな！」", "Battle/Dat/Battle/Message/151.bmd|0x0074CB": "「こ、ここまでか！！」", "Battle/Dat/Battle/Message/151.bmd|0x0074ED": "「うあああっ！！」", "Battle/Dat/Battle/Message/151.bmd|0x007509": "「駄目だ、脱出を！！」"}