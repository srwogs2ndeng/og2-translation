{"Battle/Dat/Battle/Message/151.bmd|0x008DD1": "「アインストなどにやられるか！」", "Battle/Dat/Battle/Message/151.bmd|0x008E02": "「シリーズ７７……それほど速くはないな」", "Battle/Dat/Battle/Message/151.bmd|0x008E3F": "「それがプロジェクトＴＤの成果か？」", "Battle/Dat/Battle/Message/151.bmd|0x008E76": "「ヒュッケバインも地に墜ちたな」", "Battle/Dat/Battle/Message/151.bmd|0x008EA7": "「見た目通りの欠陥機か」", "Battle/Dat/Battle/Message/151.bmd|0x008ECC": "「最新型のヒュッケバイン・シリーズは、/　そんなものか」", "Battle/Dat/Battle/Message/151.bmd|0x008F1F": "「所詮は旧型ベースの機体だ！」", "Battle/Dat/Battle/Message/151.bmd|0x008F4D": "「時代遅れなんだよ、ゲシュペンストは！」", "Battle/Dat/Battle/Message/151.bmd|0x008F8A": "「いつまでゲシュペンストを使うつもりだ？」", "Battle/Dat/Battle/Message/151.bmd|0x008FCA": "「ふん、何がダイゼンガーだ！」", "Battle/Dat/Battle/Message/151.bmd|0x008FF8": "「その斬艦刀は飾りか！」", "Battle/Dat/Battle/Message/151.bmd|0x00901D": "「それがダブルＧの実力か！」", "Battle/Dat/Battle/Message/151.bmd|0x009048": "「ダブルＧ……意外に非力だな」", "Battle/Dat/Battle/Message/151.bmd|0x009076": "「フッ、超闘士の名が泣くぞ」", "Battle/Dat/Battle/Message/151.bmd|0x0090A1": "「見た目通りの鈍さだな」", "Battle/Dat/Battle/Message/151.bmd|0x0090C6": "「やはり、見かけ倒しか」", "Battle/Dat/Battle/Message/151.bmd|0x0090EB": "「力押しで我らを倒せると思うな」", "Battle/Dat/Battle/Message/151.bmd|0x00911C": "「スピードだけか、サイバスター！」", "Battle/Dat/Battle/Message/151.bmd|0x009150": "「魔装機神……思っていたほどではないな」", "Battle/Dat/Battle/Message/151.bmd|0x00918D": "「魔装機神など、相手にならん！」", "Battle/Dat/Battle/Message/151.bmd|0x0091BE": "「見かけ倒しか、超機人！」", "Battle/Dat/Battle/Message/151.bmd|0x0091E6": "「何が超機人だ！　笑わせるな！」", "Battle/Dat/Battle/Message/151.bmd|0x009217": "「甘い！」", "Battle/Dat/Battle/Message/151.bmd|0x009227": "「当たるか！」", "Battle/Dat/Battle/Message/151.bmd|0x00923D": "「ガイアセイバーズを甘く見るな！」", "Battle/Dat/Battle/Message/151.bmd|0x009271": "「遅い！」", "Battle/Dat/Battle/Message/151.bmd|0x009281": "「どこを見ている！」", "Battle/Dat/Battle/Message/151.bmd|0x0092A0": "「ちゃんと狙え！」", "Battle/Dat/Battle/Message/151.bmd|0x0092BC": "「ガイアセイバーズに刃向かう愚かさを知れ！」", "Battle/Dat/Battle/Message/151.bmd|0x0092FF": "「その程度！」", "Battle/Dat/Battle/Message/151.bmd|0x009315": "「そんなもの！」", "Battle/Dat/Battle/Message/151.bmd|0x00932E": "「残念だったな！」", "Battle/Dat/Battle/Message/151.bmd|0x00934A": "「無駄だ！」", "Battle/Dat/Battle/Message/151.bmd|0x00935D": "「その手は食わんぞ！」", "Battle/Dat/Battle/Message/151.bmd|0x00937F": "「………」", "Battle/Dat/Battle/Message/151.bmd|0x00938F": "「くっ、反撃できん！」", "Battle/Dat/Battle/Message/151.bmd|0x0093B1": "「後退するしかないか！」", "Battle/Dat/Battle/Message/151.bmd|0x0093D6": "「手も足も出せんとは！」", "Battle/Dat/Battle/Message/151.bmd|0x0093FB": "「このままでは的になる！」", "Battle/Dat/Battle/Message/151.bmd|0x009423": "「奴らに乗せられたか！」", "Battle/Dat/Battle/Message/151.bmd|0x009448": "「くっ、補給せねば！」", "Battle/Dat/Battle/Message/151.bmd|0x00946A": "「うぬっ、使える武器は！？」", "Battle/Dat/Battle/Message/151.bmd|0x009495": "「くっ、この間合いでは……！」", "Battle/Dat/Battle/Message/151.bmd|0x0094C3": "「奴め、どこへ行った！？」", "Battle/Dat/Battle/Message/151.bmd|0x0094EB": "「くそっ、どこから攻撃して来た！？」", "Battle/Dat/Battle/Message/151.bmd|0x009522": "「チッ、奴はどこにいる！？」", "Battle/Dat/Battle/Message/151.bmd|0x00954D": "「ええい、これでは狙い撃ちされる！」", "Battle/Dat/Battle/Message/151.bmd|0x009584": "「死角に入られたか！」", "Battle/Dat/Battle/Message/151.bmd|0x0095A6": "「続けて行く！」", "Battle/Dat/Battle/Message/151.bmd|0x0095BF": "「まだ俺がいる！」", "Battle/Dat/Battle/Message/151.bmd|0x0095DB": "「逃げ損なったか！」", "Battle/Dat/Battle/Message/151.bmd|0x0095FA": "「まだ終わりじゃない！」", "Battle/Dat/Battle/Message/151.bmd|0x00961F": "「ねじ込んでやる！」", "Battle/Dat/Battle/Message/151.bmd|0x00963E": "「よし、援護を！」", "Battle/Dat/Battle/Message/151.bmd|0x00965A": "「やらせるものか！」", "Battle/Dat/Battle/Message/151.bmd|0x009679": "「受け止めてみせる！」", "Battle/Dat/Battle/Message/151.bmd|0x00969B": "「やらせん！」", "Battle/Dat/Battle/Message/151.bmd|0x0096B1": "「お前の相手は俺だ！」", "Battle/Dat/Battle/Message/151.bmd|0x0096D3": "「割り込む！」", "Battle/Dat/Battle/Message/151.bmd|0x0096E9": "「俺が盾になれば！」", "Battle/Dat/Battle/Message/151.bmd|0x009708": "「こちらで受け止めれば！」", "Battle/Dat/Battle/Message/151.bmd|0x009730": "「運が悪かったな！」", "Battle/Dat/Battle/Message/151.bmd|0x00974F": "「こういう展開もある！」", "Battle/Dat/Battle/Message/151.bmd|0x009774": "「ふん、油断したな！」", "Battle/Dat/Battle/Message/151.bmd|0x009796": "「いい流れだ！　行ける！」", "Battle/Dat/Battle/Message/151.bmd|0x0097BE": "「当たれよ！」", "Battle/Dat/Battle/Message/151.bmd|0x0097D4": "「こいつをくらえ！」", "Battle/Dat/Battle/Message/151.bmd|0x0097F3": "「もらったぞ！」", "Battle/Dat/Battle/Message/151.bmd|0x00980C": "「おりゃあ！」", "Battle/Dat/Battle/Message/151.bmd|0x009822": "「でえいっ！」", "Battle/Dat/Battle/Message/151.bmd|0x009838": "「これなら！」", "Battle/Dat/Battle/Message/151.bmd|0x00984E": "「この距離なら！」", "Battle/Dat/Battle/Message/151.bmd|0x00986A": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/151.bmd|0x00988F": "「落ちろぉっ！！」", "Battle/Dat/Battle/Message/151.bmd|0x0098AB": "「捉えたぞ！」", "Battle/Dat/Battle/Message/151.bmd|0x0098C1": "「照準ＯＫ！」", "Battle/Dat/Battle/Message/151.bmd|0x0098D7": "「行けぇっ！！」", "Battle/Dat/Battle/Message/151.bmd|0x0098F0": "「ターゲット・インサイト！」", "Battle/Dat/Battle/Message/151.bmd|0x00991B": "「ロックオン！」", "Battle/Dat/Battle/Message/151.bmd|0x009934": "「沈めっ！！」", "Battle/Dat/Battle/Message/151.bmd|0x00994A": "「くらえ！」", "Battle/Dat/Battle/Message/151.bmd|0x00995D": "「受けてみろ！」", "Battle/Dat/Battle/Message/151.bmd|0x009976": "「この距離ならば！」", "Battle/Dat/Battle/Message/151.bmd|0x009995": "「この間合いなら！」", "Battle/Dat/Battle/Message/151.bmd|0x0099B4": "「そこだ！」", "Battle/Dat/Battle/Message/151.bmd|0x0099C7": "「当たれ！」", "Battle/Dat/Battle/Message/151.bmd|0x0099DA": "「受けろ！」", "Battle/Dat/Battle/Message/151.bmd|0x0099ED": "「直撃させる！」", "Battle/Dat/Battle/Message/151.bmd|0x009A06": "「もらった！」", "Battle/Dat/Battle/Message/151.bmd|0x009A1C": "「叩き落とす！」", "Battle/Dat/Battle/Message/151.bmd|0x009A35": "「叩き落としてやる！」", "Battle/Dat/Battle/Message/151.bmd|0x009A57": "「キャスク・ミサイル！」", "Battle/Dat/Battle/Message/151.bmd|0x009A7C": "「キャスク・ミサイル、発射！」", "Battle/Dat/Battle/Message/151.bmd|0x009AAA": "「キャスク・ミサイルで！」", "Battle/Dat/Battle/Message/151.bmd|0x009AD2": "「くらえっ！！」", "Battle/Dat/Battle/Message/151.bmd|0x009AEB": "「避けられると思うな！」", "Battle/Dat/Battle/Message/151.bmd|0x009B10": "「コンテナ、セット！　行けっ！！」", "Battle/Dat/Battle/Message/151.bmd|0x009B44": "「こいつからは逃げられん！」", "Battle/Dat/Battle/Message/151.bmd|0x009B6F": "「新型リオンの力を！」", "Battle/Dat/Battle/Message/151.bmd|0x009B91": "「見せてやる！」", "Battle/Dat/Battle/Message/151.bmd|0x009BAA": "「このミサイルは一味違うぞ！」", "Battle/Dat/Battle/Message/151.bmd|0x009BD8": "「行けぇぇっ！！」", "Battle/Dat/Battle/Message/151.bmd|0x009BF4": "「高速で追い詰める！」", "Battle/Dat/Battle/Message/151.bmd|0x009C16": "「ハッチ開放！」", "Battle/Dat/Battle/Message/151.bmd|0x009C2F": "「ＭＴＤ誘導弾、発射！」", "Battle/Dat/Battle/Message/151.bmd|0x009C54": "「このサイリオンで翻弄してやる！」", "Battle/Dat/Battle/Message/151.bmd|0x009C88": "「テスラ・ドライブのミサイルだ！」", "Battle/Dat/Battle/Message/151.bmd|0x009CBC": "「かわすことなど出来ん！！」", "Battle/Dat/Battle/Message/151.bmd|0x009CE7": "「サイリオンからは逃げられんぞ！」", "Battle/Dat/Battle/Message/151.bmd|0x009D1B": "「このミサイルは特別製だ！」", "Battle/Dat/Battle/Message/151.bmd|0x009D46": "「ＭＴＤ誘導弾！　行けぇぇっ！！」", "Battle/Dat/Battle/Message/151.bmd|0x009D7A": "「サイリオンの真価を見せてやる！」", "Battle/Dat/Battle/Message/151.bmd|0x009DAE": "「ＴＤＡノーズ、セット！」", "Battle/Dat/Battle/Message/151.bmd|0x009DD6": "「行くぞ！　ブースト！！」", "Battle/Dat/Battle/Message/151.bmd|0x009DFE": "「ブレイク・フィールド！」", "Battle/Dat/Battle/Message/151.bmd|0x009E26": "「砕け散れぇぇぇっ！！」", "Battle/Dat/Battle/Message/151.bmd|0x009E4B": "「シーケンスＳＳＢ！」", "Battle/Dat/Battle/Message/151.bmd|0x009E6D": "「ロック・オン！」", "Battle/Dat/Battle/Message/151.bmd|0x009E89": "「見切ることなど出来んぞ！」", "Battle/Dat/Battle/Message/151.bmd|0x009EB4": "「フィールド展開！」"}