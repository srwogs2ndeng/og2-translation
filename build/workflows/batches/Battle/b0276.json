{"Battle/Dat/Battle/Message/286.bmd|0x00822A": "「全砲火を集中させる！」", "Battle/Dat/Battle/Message/286.bmd|0x00824F": "「行くぞ、フル・ブースト！！」", "Battle/Dat/Battle/Message/286.bmd|0x00827D": "「天地のコンビネーション、かわせるか！」", "Battle/Dat/Battle/Message/286.bmd|0x0082BA": "「ドリルで貫くっ！！」", "Battle/Dat/Battle/Message/286.bmd|0x0082DC": "「一撃必殺か……面白い！」", "Battle/Dat/Battle/Message/286.bmd|0x008304": "「獅子王刀、歳破！！」", "Battle/Dat/Battle/Message/286.bmd|0x008326": "「その動き、見切った！」", "Battle/Dat/Battle/Message/286.bmd|0x00834B": "「ＭＴＤ誘導弾、ファイヤ！」", "Battle/Dat/Battle/Message/286.bmd|0x008376": "「テスラ・ドライブのミサイルだ、/　どこまでも追い詰める！」", "Battle/Dat/Battle/Message/286.bmd|0x0083CF": "「イルミネーター・リンク！」", "Battle/Dat/Battle/Message/286.bmd|0x0083FA": "「受けろ！　天からの一撃を！」", "Battle/Dat/Battle/Message/287.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/287.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/287.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/287.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/287.bmd|0x0003FC": "「………？」", "Battle/Dat/Battle/Message/288.bmd|0x000BBA": "「攻撃開始！」", "Battle/Dat/Battle/Message/288.bmd|0x000BD0": "「懐に飛び込ませるな！」", "Battle/Dat/Battle/Message/288.bmd|0x000BF5": "「か、艦を放棄する！！」", "Battle/Dat/Battle/Message/288.bmd|0x000C1A": "「総員退避ぃぃぃっ！！」", "Battle/Dat/Battle/Message/288.bmd|0x000C3F": "「各員、脱出しろ！」", "Battle/Dat/Battle/Message/288.bmd|0x000C5E": "「消火班、Ｂブロックへ急げ！」", "Battle/Dat/Battle/Message/288.bmd|0x000C8C": "「まだだ！　まだ沈んではならん！/　弾を撃ち尽くすまでは！！」", "Battle/Dat/Battle/Message/288.bmd|0x000CE8": "「沈むにはまだ早い！/　可能な限り反撃せよ！！」", "Battle/Dat/Battle/Message/288.bmd|0x000D2F": "「せ、戦艦の装甲を撃ち抜いただと！？」", "Battle/Dat/Battle/Message/288.bmd|0x000D69": "「うぐっ！　い、いかん！/　すぐに護衛機を呼び戻せ！！」", "Battle/Dat/Battle/Message/288.bmd|0x000DBC": "「ぐっ！　破損箇所を報告せよ！」", "Battle/Dat/Battle/Message/288.bmd|0x000DED": "「フン……その程度で本艦を沈めるつもりか」", "Battle/Dat/Battle/Message/288.bmd|0x000E2D": "「ひるむな！　そう簡単に沈みはせん！」", "Battle/Dat/Battle/Message/288.bmd|0x000E67": "「直撃だと！？　被弾箇所を知らせ！」", "Battle/Dat/Battle/Message/288.bmd|0x000E9E": "「戦艦に挑んでくる勇気は認めてやるが……」", "Battle/Dat/Battle/Message/288.bmd|0x000EDE": "「操舵手！　回避が遅いぞ！」", "Battle/Dat/Battle/Message/288.bmd|0x000F09": "「回避行動を取りつつ、反撃せよ！」", "Battle/Dat/Battle/Message/288.bmd|0x000F3D": "「構わん、攻撃に専念しろ！」", "Battle/Dat/Battle/Message/288.bmd|0x000F68": "「本艦の装甲を甘く見たな……」", "Battle/Dat/Battle/Message/288.bmd|0x000F96": "「各砲座、敵機の接近を許すな！」", "Battle/Dat/Battle/Message/288.bmd|0x000FC7": "「急速回頭！」", "Battle/Dat/Battle/Message/288.bmd|0x000FDD": "「ふん、こんな大きな的を外すとはな！」", "Battle/Dat/Battle/Message/288.bmd|0x001017": "「よし、面舵戻せ！　反撃に移る！」", "Battle/Dat/Battle/Message/288.bmd|0x00104B": "「こちらの操艦技術を甘く見るなよ」", "Battle/Dat/Battle/Message/288.bmd|0x00107F": "「防御装置、作動！」", "Battle/Dat/Battle/Message/288.bmd|0x00109E": "「バリアを展開しろ！」", "Battle/Dat/Battle/Message/288.bmd|0x0010C0": "「よし、バリアが効いているな」", "Battle/Dat/Battle/Message/288.bmd|0x0010EE": "「………」", "Battle/Dat/Battle/Message/288.bmd|0x0010FE": "「反撃不可能だと！？」", "Battle/Dat/Battle/Message/288.bmd|0x001120": "「砲撃手、何をしている！？」", "Battle/Dat/Battle/Message/288.bmd|0x00114B": "「どこから攻撃してきたというのだ！？」", "Battle/Dat/Battle/Message/288.bmd|0x001185": "「他に反撃可能な武器はないのか！？」", "Battle/Dat/Battle/Message/288.bmd|0x0011BC": "「馬鹿な！/　戦艦の射程を上回る攻撃など……！！」", "Battle/Dat/Battle/Message/288.bmd|0x001206": "「友軍機を援護する！」", "Battle/Dat/Battle/Message/288.bmd|0x001228": "「一斉射撃！　とどめをさすぞ！」", "Battle/Dat/Battle/Message/288.bmd|0x001259": "「援護砲撃！　撃て！！」", "Battle/Dat/Battle/Message/288.bmd|0x00127E": "「本艦を盾にする！」", "Battle/Dat/Battle/Message/288.bmd|0x00129D": "「構わん！　突っ込め！！」", "Battle/Dat/Battle/Message/288.bmd|0x0012C5": "「味方機を巻き込むなよ！　撃てぇっ！！」", "Battle/Dat/Battle/Message/288.bmd|0x001302": "「一斉射撃！」", "Battle/Dat/Battle/Message/288.bmd|0x001318": "「対空機銃、敵機を近づけるな！」", "Battle/Dat/Battle/Message/288.bmd|0x001349": "「艦前方に弾幕を展開しろ！」", "Battle/Dat/Battle/Message/288.bmd|0x001374": "「機銃群、攻撃開始！！」", "Battle/Dat/Battle/Message/288.bmd|0x001399": "「各砲座、一斉射撃！！」", "Battle/Dat/Battle/Message/288.bmd|0x0013BE": "「敵機データ入力！　ミサイル発射！！」", "Battle/Dat/Battle/Message/288.bmd|0x0013F8": "「ミサイル発射！！」", "Battle/Dat/Battle/Message/288.bmd|0x001417": "「魚雷、１番から４番まで発射準備！/　撃て！！」", "Battle/Dat/Battle/Message/288.bmd|0x00145E": "「魚雷、発射！！」", "Battle/Dat/Battle/Message/288.bmd|0x00147A": "「魚雷発射管、開け！/　１番から４番、発射！！」", "Battle/Dat/Battle/Message/288.bmd|0x0014C1": "「構わん！　対艦ミサイルを使え！！」", "Battle/Dat/Battle/Message/288.bmd|0x0014F8": "「２番、３番副砲、撃て！！」", "Battle/Dat/Battle/Message/288.bmd|0x001523": "「３番、４番副砲、砲撃始め！！」", "Battle/Dat/Battle/Message/288.bmd|0x001554": "「目標へ一斉砲撃！！」", "Battle/Dat/Battle/Message/288.bmd|0x001576": "「各砲座、各個に敵を撃破せよ！」", "Battle/Dat/Battle/Message/288.bmd|0x0015A7": "「１番、２番主砲、撃て！！」", "Battle/Dat/Battle/Message/288.bmd|0x0015D2": "「３番、４番主砲、発射！」", "Battle/Dat/Battle/Message/288.bmd|0x0015FA": "「砲撃戦用意！　撃て！！」", "Battle/Dat/Battle/Message/288.bmd|0x001622": "「前部全主砲、斉射！！」", "Battle/Dat/Battle/Message/288.bmd|0x001647": "「各砲、砲撃始め！！」", "Battle/Dat/Battle/Message/288.bmd|0x001669": "「敵機の射程外で撃破せよ！」", "Battle/Dat/Battle/Message/289.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/289.bmd|0x000440": "「！？！？！？」", "Battle/Dat/Battle/Message/289.bmd|0x000459": "「………！！！」", "Battle/Dat/Battle/Message/289.bmd|0x000472": "「………！！」", "Battle/Dat/Battle/Message/289.bmd|0x000488": "「………？」", "Battle/Dat/Battle/Message/290.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/290.bmd|0x000440": "「！？！？！？」", "Battle/Dat/Battle/Message/290.bmd|0x000459": "「………！！！」", "Battle/Dat/Battle/Message/290.bmd|0x000472": "「………！！」", "Battle/Dat/Battle/Message/290.bmd|0x000488": "「………？」", "Battle/Dat/Battle/Message/291.bmd|0x0004B0": "「………」", "Battle/Dat/Battle/Message/291.bmd|0x0004C0": "「！？！？！？」", "Battle/Dat/Battle/Message/291.bmd|0x0004D9": "「！！！」", "Battle/Dat/Battle/Message/291.bmd|0x0004E9": "「………！！！」", "Battle/Dat/Battle/Message/291.bmd|0x000502": "「………！！」", "Battle/Dat/Battle/Message/291.bmd|0x000518": "「………？」", "Battle/Dat/Battle/Message/292.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/292.bmd|0x000440": "「！？！？！？」", "Battle/Dat/Battle/Message/292.bmd|0x000459": "「………！！！」", "Battle/Dat/Battle/Message/292.bmd|0x000472": "「………！！」", "Battle/Dat/Battle/Message/292.bmd|0x000488": "「………？」", "Battle/Dat/Battle/Message/293.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/293.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/293.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/293.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/293.bmd|0x0003FC": "「………？」", "Battle/Dat/Battle/Message/294.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/294.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/294.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/294.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/294.bmd|0x0003FC": "「………？」", "Battle/Dat/Battle/Message/295.bmd|0x0021AF": "「では、参りましょうか」", "Battle/Dat/Battle/Message/295.bmd|0x0021D4": "「さあ、覚悟はいいですか？」", "Battle/Dat/Battle/Message/295.bmd|0x0021FF": "「グランゾンの力……身を以て知りなさい」", "Battle/Dat/Battle/Message/295.bmd|0x00223C": "「あなたにグランゾンの力を/　お見せしましょう」", "Battle/Dat/Battle/Message/295.bmd|0x002283": "「私がお相手致しましょう」", "Battle/Dat/Battle/Message/295.bmd|0x0022AB": "「素直に運命を受け入れなさい」", "Battle/Dat/Battle/Message/295.bmd|0x0022D9": "「何人たりとも、/　私を縛ることなど出来ないのですよ」", "Battle/Dat/Battle/Message/295.bmd|0x002329": "「私の行く手を阻む者には……容赦はしません」", "Battle/Dat/Battle/Message/295.bmd|0x00236C": "「私の前に立ち塞がるとは、いい度胸です」", "Battle/Dat/Battle/Message/295.bmd|0x0023A9": "「ご主人様に歯向かおうなんて、/　身の程知らずですね！」", "Battle/Dat/Battle/Message/295.bmd|0x0023FC": "「ふ……そういうことです」", "Battle/Dat/Battle/Message/295.bmd|0x002424": "「さあ、チートなグランゾンの力を、/　思いっきり見せつけちゃいますよ！」", "Battle/Dat/Battle/Message/295.bmd|0x00248F": "「チカ……/　どこでそんな言葉を覚えてきたんですか？」"}