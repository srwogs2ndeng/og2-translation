{"Battle/Dat/Battle/Message/039.bmd|0x007471": "「これぐらい、平気ですっ！」", "Battle/Dat/Battle/Message/039.bmd|0x00749C": "「良かった……思ったより、ダメージが軽いわ」", "Battle/Dat/Battle/Message/039.bmd|0x0074DF": "「もっとちゃんと操縦しなきゃ……！」", "Battle/Dat/Battle/Message/039.bmd|0x007516": "「こう見えても、少しは鍛えてるんだから」", "Battle/Dat/Battle/Message/039.bmd|0x007553": "「こんなんじゃ、/　ブリット君に笑われちゃう……」", "Battle/Dat/Battle/Message/039.bmd|0x00759D": "「そんなことするもんか！」", "Battle/Dat/Battle/Message/039.bmd|0x0075C5": "「ブリット君、ケガはない！？」", "Battle/Dat/Battle/Message/039.bmd|0x0075F3": "「ああ、気にするな！」", "Battle/Dat/Battle/Message/039.bmd|0x007615": "「いけない、かわせなかった……！」", "Battle/Dat/Battle/Message/039.bmd|0x007649": "「相手の動きをよく見るんだ！」", "Battle/Dat/Battle/Message/039.bmd|0x007677": "「龍虎王……ケガは大丈夫？」", "Battle/Dat/Battle/Message/039.bmd|0x0076A2": "「！　グルンガストに傷がついちゃった……」", "Battle/Dat/Battle/Message/039.bmd|0x0076E2": "「き、機体が重くて、かわせなかった……？」", "Battle/Dat/Battle/Message/039.bmd|0x007722": "「ごめんなさい、弐式……/　私が上手く操縦出来なかったせいで……」", "Battle/Dat/Battle/Message/039.bmd|0x007784": "「これぐらい、弐式だったら大丈夫なはず」", "Battle/Dat/Battle/Message/039.bmd|0x0077C1": "「参式なら、これぐらいは大丈夫！」", "Battle/Dat/Battle/Message/039.bmd|0x0077F5": "「ううっ！/　ヒュッケバインでもかわせなかった……？」", "Battle/Dat/Battle/Message/039.bmd|0x007845": "「ここで/　メリオルエッセを振り切らなきゃ……！」", "Battle/Dat/Battle/Message/039.bmd|0x00788F": "「あの目に魅入られたら、危ない……！」", "Battle/Dat/Battle/Message/039.bmd|0x0078C9": "「ガイアセイバーズにやられるわけには！」", "Battle/Dat/Battle/Message/039.bmd|0x007906": "「くっ！　やめて、虎王機！」", "Battle/Dat/Battle/Message/039.bmd|0x007931": "「雀武王を振り切れない！？」", "Battle/Dat/Battle/Message/039.bmd|0x00795C": "「くっ、/　迂闊に武雀王の間合いに飛び込んだら……！」", "Battle/Dat/Battle/Message/039.bmd|0x0079AC": "「窮奇王……さすがに速い！」", "Battle/Dat/Battle/Message/039.bmd|0x0079D7": "「きゃっ！　何なの、今の動きは！？」", "Battle/Dat/Battle/Message/039.bmd|0x007A0E": "「みんなには迷惑、かけられないもの！」", "Battle/Dat/Battle/Message/039.bmd|0x007A48": "「避けてみせます！」", "Battle/Dat/Battle/Message/039.bmd|0x007A67": "「そんなもの、当たりません！」", "Battle/Dat/Battle/Message/039.bmd|0x007A95": "「見切りましたっ！」", "Battle/Dat/Battle/Message/039.bmd|0x007AB4": "「俺も負けてられないなぁ……」", "Battle/Dat/Battle/Message/039.bmd|0x007AE2": "「かわせた！」", "Battle/Dat/Battle/Message/039.bmd|0x007AF8": "「次が来るぞ！　迎撃を！」", "Battle/Dat/Battle/Message/039.bmd|0x007B20": "「当たりはしません！」", "Battle/Dat/Battle/Message/039.bmd|0x007B42": "「次もその調子で頼む！」", "Battle/Dat/Battle/Message/039.bmd|0x007B67": "「かわした！」", "Battle/Dat/Battle/Message/039.bmd|0x007B7D": "「当たらない！」", "Battle/Dat/Battle/Message/039.bmd|0x007B96": "「油断するな、すぐ次が来る！」", "Battle/Dat/Battle/Message/039.bmd|0x007BC4": "「ああ、向こうはこっちに追いつけない」", "Battle/Dat/Battle/Message/039.bmd|0x007BFE": "「同じ四神に負けるわけには！」", "Battle/Dat/Battle/Message/039.bmd|0x007C2C": "「こっちも四神の超機人だもの、/　互角に戦ってみせます！」", "Battle/Dat/Battle/Message/039.bmd|0x007C82": "「そんなもの、龍人機には当たりません！」", "Battle/Dat/Battle/Message/039.bmd|0x007CBF": "「龍人機には届かない！」", "Battle/Dat/Battle/Message/039.bmd|0x007CE4": "「グルンガストのおかげね」", "Battle/Dat/Battle/Message/039.bmd|0x007D0C": "「ヒュッケバインのおかげね」", "Battle/Dat/Battle/Message/039.bmd|0x007D37": "「カークス将軍、力を急激に行使しても！」", "Battle/Dat/Battle/Message/039.bmd|0x007D74": "「ここでメリオルエッセを/　食い止めなきゃ……！」", "Battle/Dat/Battle/Message/039.bmd|0x007DBE": "「あの人に捕まるわけには……！」", "Battle/Dat/Battle/Message/039.bmd|0x007DEF": "「夏喃、もう私に構わないで下さい！」", "Battle/Dat/Battle/Message/039.bmd|0x007E26": "「夏喃、あなたの思い通りにはいきません！」", "Battle/Dat/Battle/Message/039.bmd|0x007E66": "「破滅の運命なんて、/　受け入れるつもりはありません！」", "Battle/Dat/Battle/Message/039.bmd|0x007EB9": "「ガイアセイバーズには負けられないもの！」", "Battle/Dat/Battle/Message/039.bmd|0x007EF9": "「もうあなた達には騙されない！」", "Battle/Dat/Battle/Message/039.bmd|0x007F2A": "「虎王機、私の声を聞いて！」", "Battle/Dat/Battle/Message/039.bmd|0x007F55": "「あの念と光に囚われるわけには！」", "Battle/Dat/Battle/Message/039.bmd|0x007F89": "「ユーゼス、あなたが私に何を見せようと！」", "Battle/Dat/Battle/Message/039.bmd|0x007FC9": "「ルイーナに捕まるわけには！」", "Battle/Dat/Battle/Message/039.bmd|0x007FF7": "「良かった……外れてくれた」", "Battle/Dat/Battle/Message/039.bmd|0x008022": "「上手くかわせた！」", "Battle/Dat/Battle/Message/039.bmd|0x008041": "「ふう……運が良かったのね」", "Battle/Dat/Battle/Message/039.bmd|0x00806C": "「だって、動きが見えてるもの」", "Battle/Dat/Battle/Message/039.bmd|0x00809A": "「よけられた……！」", "Battle/Dat/Battle/Message/039.bmd|0x0080B9": "「油断するな、次が来る！」", "Battle/Dat/Battle/Message/039.bmd|0x0080E1": "「さすがだな！」", "Battle/Dat/Battle/Message/039.bmd|0x0080FA": "「ううん、ブリット君がいてくれるから……」", "Battle/Dat/Battle/Message/039.bmd|0x00813A": "「この感じなら！」", "Battle/Dat/Battle/Message/039.bmd|0x008156": "「ああ、次もかわせる！」", "Battle/Dat/Battle/Message/039.bmd|0x00817B": "「ブリット君、敵は！？」", "Battle/Dat/Battle/Message/039.bmd|0x0081A0": "「いったん離脱したみたいだ」", "Battle/Dat/Battle/Message/039.bmd|0x0081CB": "「今のはギリギリだった……？」", "Battle/Dat/Battle/Message/039.bmd|0x0081F9": "「もう少し、奴との距離を取った方がいい！」", "Battle/Dat/Battle/Message/039.bmd|0x008239": "「ありがと、龍虎王」", "Battle/Dat/Battle/Message/039.bmd|0x008258": "「さすがね、龍虎王」", "Battle/Dat/Battle/Message/039.bmd|0x008277": "「ありがと、弐式」", "Battle/Dat/Battle/Message/039.bmd|0x008293": "「ありがと、参式」", "Battle/Dat/Battle/Message/039.bmd|0x0082AF": "「ありがと、ヒュッケバイン」", "Battle/Dat/Battle/Message/039.bmd|0x0082DA": "「孫光龍！　私はここですっ！」", "Battle/Dat/Battle/Message/039.bmd|0x008308": "「さすがダブルＧ……危なかったわ」", "Battle/Dat/Battle/Message/039.bmd|0x00833C": "「雀武王を振り切れた！」", "Battle/Dat/Battle/Message/039.bmd|0x008361": "「これなら、四凶とも互角に戦える！」", "Battle/Dat/Battle/Message/039.bmd|0x008398": "「ＡＩ１……/　人の念まで飲み込もうとしてるの……！？」", "Battle/Dat/Battle/Message/039.bmd|0x0083EB": "「妖機人には負けません！」", "Battle/Dat/Battle/Message/039.bmd|0x008413": "「あ、あんまり間近で見たくないな……」", "Battle/Dat/Battle/Message/039.bmd|0x00844D": "「そう簡単にやられませんっ！」", "Battle/Dat/Battle/Message/039.bmd|0x00847B": "「お願い、私を守って！」", "Battle/Dat/Battle/Message/039.bmd|0x0084A0": "「ああっ！　……助かった……？」", "Battle/Dat/Battle/Message/039.bmd|0x0084D1": "「お願い、念動フィールド！」", "Battle/Dat/Battle/Message/039.bmd|0x0084FC": "「ジャマーがあってよかった……」", "Battle/Dat/Battle/Message/039.bmd|0x00852D": "「そんなもの、無駄です！」", "Battle/Dat/Battle/Message/039.bmd|0x008555": "「え？　え！？　何も出来ないの……？」", "Battle/Dat/Battle/Message/039.bmd|0x00858F": "「しまった……！　見失っちゃった……」", "Battle/Dat/Battle/Message/039.bmd|0x0085C9": "「いつも助けられてるばかりじゃありません！」", "Battle/Dat/Battle/Message/039.bmd|0x00860C": "「続けて行きますっ！」", "Battle/Dat/Battle/Message/039.bmd|0x00862E": "「逃がすわけにはいきません！」", "Battle/Dat/Battle/Message/039.bmd|0x00865C": "「リュウセイ君、手伝うわ！」", "Battle/Dat/Battle/Message/039.bmd|0x008687": "「後は任せて、リオ！」", "Battle/Dat/Battle/Message/039.bmd|0x0086A9": "「リオ、頑張ってるのね……！」", "Battle/Dat/Battle/Message/039.bmd|0x0086D7": "「リョウト君が隙を作ってくれた……！」", "Battle/Dat/Battle/Message/039.bmd|0x008711": "「タスク君、後は任せて！」", "Battle/Dat/Battle/Message/039.bmd|0x008739": "「タスク君、どこへ行くの！？」", "Battle/Dat/Battle/Message/039.bmd|0x008767": "「レオナには/　余計なお世話かも知れないけど……」", "Battle/Dat/Battle/Message/039.bmd|0x0087B1": "「レオナ、援護するわ！」", "Battle/Dat/Battle/Message/039.bmd|0x0087D6": "「ユウキ君、後は私が！」", "Battle/Dat/Battle/Message/039.bmd|0x0087FB": "「カーラ、援護するわ！」", "Battle/Dat/Battle/Message/039.bmd|0x008820": "「キョウスケ中尉、援護します！」", "Battle/Dat/Battle/Message/039.bmd|0x008851": "「エクセレン少尉、手伝います！」", "Battle/Dat/Battle/Message/039.bmd|0x008882": "「ラミアさん、援護します！」", "Battle/Dat/Battle/Message/039.bmd|0x0088AD": "「マサキ君、後は私が！」", "Battle/Dat/Battle/Message/039.bmd|0x0088D2": "「リューネ、援護するわ！」", "Battle/Dat/Battle/Message/039.bmd|0x0088FA": "「大尉、続けて行きます！」", "Battle/Dat/Battle/Message/039.bmd|0x008922": "「援護するわ、ラトゥーニ！」", "Battle/Dat/Battle/Message/039.bmd|0x00894D": "「先走っちゃダメよ！　アラド君！」", "Battle/Dat/Battle/Message/039.bmd|0x008981": "「アイビスさん、援護します！」", "Battle/Dat/Battle/Message/039.bmd|0x0089AF": "「レーツェルさん、続きますっ！」", "Battle/Dat/Battle/Message/039.bmd|0x0089E0": "「リシュウ先生、後は任せて下さい！」", "Battle/Dat/Battle/Message/039.bmd|0x008A17": "「ブリット君と力を合わせれば……！」", "Battle/Dat/Battle/Message/039.bmd|0x008A4E": "「ブリット君、後は任せて！」", "Battle/Dat/Battle/Message/039.bmd|0x008A79": "「コウタ君、後は任せて！」", "Battle/Dat/Battle/Message/039.bmd|0x008AA1": "「手伝うわ、ラウル君！」", "Battle/Dat/Battle/Message/039.bmd|0x008AC6": "「フィオナ、後は私が！」", "Battle/Dat/Battle/Message/039.bmd|0x008AEB": "「アリエイル、後は任せて！」"}