{"Battle/Dat/Battle/Message/147.bmd|0x006C4F": "「ゲシュペンストなど、/　もう時代遅れなんだよ！」", "Battle/Dat/Battle/Message/147.bmd|0x006C99": "「やはり、見かけ倒しか」", "Battle/Dat/Battle/Message/147.bmd|0x006CBE": "「力だけで我らを倒せると思うな！」", "Battle/Dat/Battle/Message/147.bmd|0x006CF2": "「見た目通り、のろそうな機体だな！」", "Battle/Dat/Battle/Message/147.bmd|0x006D29": "「直撃さえしなければ、グルンガストなど！」", "Battle/Dat/Battle/Message/147.bmd|0x006D69": "「それがヒュッケバインの力か？」", "Battle/Dat/Battle/Message/147.bmd|0x006D9A": "「魔装機神などと言っても、その程度か？」", "Battle/Dat/Battle/Message/147.bmd|0x006DD7": "「かわした！」", "Battle/Dat/Battle/Message/147.bmd|0x006DED": "「モーションが大きすぎるんだよ！」", "Battle/Dat/Battle/Message/147.bmd|0x006E21": "「遅いっ！」", "Battle/Dat/Battle/Message/147.bmd|0x006E34": "「照準がずれているようだな」", "Battle/Dat/Battle/Message/147.bmd|0x006E5F": "「今までの相手が弱すぎたようだな！」", "Battle/Dat/Battle/Message/147.bmd|0x006E96": "「まぐれ当たりは続かないぞ！」", "Battle/Dat/Battle/Message/147.bmd|0x006EC4": "「よし、回避成功だ！」", "Battle/Dat/Battle/Message/147.bmd|0x006EE6": "「その程度！」", "Battle/Dat/Battle/Message/147.bmd|0x006EFC": "「そんなもの！」", "Battle/Dat/Battle/Message/147.bmd|0x006F15": "「残念だったな！」", "Battle/Dat/Battle/Message/147.bmd|0x006F31": "「無駄だ！」", "Battle/Dat/Battle/Message/147.bmd|0x006F44": "「………」", "Battle/Dat/Battle/Message/147.bmd|0x006F54": "「くっ、補給を！」", "Battle/Dat/Battle/Message/147.bmd|0x006F70": "「長期戦では不利か！」", "Battle/Dat/Battle/Message/147.bmd|0x006F92": "「反撃できんとはな……！」", "Battle/Dat/Battle/Message/147.bmd|0x006FBA": "「手も足も出させんつもりか！」", "Battle/Dat/Battle/Message/147.bmd|0x006FE8": "「バカな、踊らされているのか！？」", "Battle/Dat/Battle/Message/147.bmd|0x00701C": "「た、弾切れだと……！？」", "Battle/Dat/Battle/Message/147.bmd|0x007044": "「くっ、この間合いでは……！」", "Battle/Dat/Battle/Message/147.bmd|0x007072": "「ここからでは反撃できん！」", "Battle/Dat/Battle/Message/147.bmd|0x00709D": "「反撃不可能だと！？」", "Battle/Dat/Battle/Message/147.bmd|0x0070BF": "「くそっ！　これじゃ狙い撃ちされる！」", "Battle/Dat/Battle/Message/147.bmd|0x0070F9": "「いかん！　これではただの標的だ！」", "Battle/Dat/Battle/Message/147.bmd|0x007130": "「くっ！　何も出来ないのか……！？」", "Battle/Dat/Battle/Message/147.bmd|0x007167": "「よそ見している暇はないぞ！」", "Battle/Dat/Battle/Message/147.bmd|0x007195": "「この連携がかわせるか！」", "Battle/Dat/Battle/Message/147.bmd|0x0071BD": "「これでとどめだ！」", "Battle/Dat/Battle/Message/147.bmd|0x0071DC": "「確実に倒しておかねば！」", "Battle/Dat/Battle/Message/147.bmd|0x007204": "「フン、逃げ損なったな！」", "Battle/Dat/Battle/Message/147.bmd|0x00722C": "「やらせん！」", "Battle/Dat/Battle/Message/147.bmd|0x007242": "「思うようにはさせん！」", "Battle/Dat/Battle/Message/147.bmd|0x007267": "「今の内に後退を！」", "Battle/Dat/Battle/Message/147.bmd|0x007286": "「ふん、油断したな！」", "Battle/Dat/Battle/Message/147.bmd|0x0072A8": "「一網打尽にしてやる！」", "Battle/Dat/Battle/Message/147.bmd|0x0072CD": "「まとめて叩き落とす！」", "Battle/Dat/Battle/Message/147.bmd|0x0072F2": "「行くぞ！」", "Battle/Dat/Battle/Message/147.bmd|0x007305": "「ソニック・ブレイカー！！」", "Battle/Dat/Battle/Message/147.bmd|0x007330": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/147.bmd|0x007355": "「これで決める！」", "Battle/Dat/Battle/Message/147.bmd|0x007371": "「さあ、覚悟しろ！」", "Battle/Dat/Battle/Message/147.bmd|0x007390": "「砕け散れ！！」", "Battle/Dat/Battle/Message/147.bmd|0x0073A9": "「落とす！」", "Battle/Dat/Battle/Message/147.bmd|0x0073BC": "「直撃させる！」", "Battle/Dat/Battle/Message/148.bmd|0x0011A4": "「大義は我らにあり！　攻撃開始！」", "Battle/Dat/Battle/Message/148.bmd|0x0011D8": "「懐に飛び込ませるな！」", "Battle/Dat/Battle/Message/148.bmd|0x0011FD": "「全砲門開け！　撃てぇっ！！」", "Battle/Dat/Battle/Message/148.bmd|0x00122B": "「砲撃を開始せよ！」", "Battle/Dat/Battle/Message/148.bmd|0x00124A": "「前方の敵を蹴散らせ！」", "Battle/Dat/Battle/Message/148.bmd|0x00126F": "「味方機を巻き込むなよ！　撃てぇっ！！」", "Battle/Dat/Battle/Message/148.bmd|0x0012AC": "「目標、敵母艦！　撃て！！」", "Battle/Dat/Battle/Message/148.bmd|0x0012D7": "「対艦戦だ！　気を引き締めてかかれ！」", "Battle/Dat/Battle/Message/148.bmd|0x001311": "「スペースノア級と言えども！」", "Battle/Dat/Battle/Message/148.bmd|0x00133F": "「艦首部分は狙うな！　撃てぇっ！！」", "Battle/Dat/Battle/Message/148.bmd|0x001376": "「旧式の改造艦など、ここで沈めてしまえ！！」", "Battle/Dat/Battle/Message/148.bmd|0x0013B9": "「所詮は急造艦だ！　攻撃を開始せよ！！」", "Battle/Dat/Battle/Message/148.bmd|0x0013F6": "「か、艦を放棄する！！」", "Battle/Dat/Battle/Message/148.bmd|0x00141B": "「総員退避ぃぃぃっ！！」", "Battle/Dat/Battle/Message/148.bmd|0x001440": "「各員、脱出しろ！」", "Battle/Dat/Battle/Message/148.bmd|0x00145F": "「ここで沈んでも、我らの大義は……！！」", "Battle/Dat/Battle/Message/148.bmd|0x00149C": "「うぬっ！　奴を艦に取り付かせるな！」", "Battle/Dat/Battle/Message/148.bmd|0x0014D6": "「まだだ！　まだ沈んではならんぞ！」", "Battle/Dat/Battle/Message/148.bmd|0x00150D": "「沈むにはまだ早い！/　可能な限り反撃せよ！！」", "Battle/Dat/Battle/Message/148.bmd|0x001554": "「せ、戦艦の装甲板を撃ち抜いただと！？」", "Battle/Dat/Battle/Message/148.bmd|0x001591": "「い、いかん！　すぐに護衛機を呼び戻せ！！」", "Battle/Dat/Battle/Message/148.bmd|0x0015D4": "「ぬうう……連邦軍に/　あのような手練れがいるとは！」", "Battle/Dat/Battle/Message/148.bmd|0x001624": "「たった数機にここまでやられるとは！！」", "Battle/Dat/Battle/Message/148.bmd|0x001661": "「ぐっ！　破損箇所を報告せよ！」", "Battle/Dat/Battle/Message/148.bmd|0x001692": "「その程度で本艦を沈めるつもりか。笑止」", "Battle/Dat/Battle/Message/148.bmd|0x0016CF": "「ひるむな！　そう簡単に沈みはせん！」", "Battle/Dat/Battle/Message/148.bmd|0x001709": "「直撃だと！？　被弾箇所を知らせ！」", "Battle/Dat/Battle/Message/148.bmd|0x001740": "「戦艦に挑んでくる勇気は認めてやるが……」", "Battle/Dat/Battle/Message/148.bmd|0x001780": "「うぐっ……！/　ただの命知らずではないらしいな！」", "Battle/Dat/Battle/Message/148.bmd|0x0017CD": "「ええい！　奴を何としても叩き落とせ！！」", "Battle/Dat/Battle/Message/148.bmd|0x00180D": "「操舵手！　回避が遅いぞ！」", "Battle/Dat/Battle/Message/148.bmd|0x001838": "「回避行動を取りつつ、反撃せよ！」", "Battle/Dat/Battle/Message/148.bmd|0x00186C": "「構わん、攻撃に専念しろ！」", "Battle/Dat/Battle/Message/148.bmd|0x001897": "「フン、本艦の装甲を甘く見たな……」", "Battle/Dat/Battle/Message/148.bmd|0x0018CE": "「各砲座、敵機の接近を許すな！」", "Battle/Dat/Battle/Message/148.bmd|0x0018FF": "「その程度で我らを止められると思うな！」", "Battle/Dat/Battle/Message/148.bmd|0x00193C": "「我らが大義、/　そう簡単に打ち砕けるものではない！」", "Battle/Dat/Battle/Message/148.bmd|0x00198C": "「急速回頭！」", "Battle/Dat/Battle/Message/148.bmd|0x0019A2": "「こちらの操艦技術を甘く見るなよ」", "Battle/Dat/Battle/Message/148.bmd|0x0019D6": "「ふん、こんな大きな的を外すとはな！」", "Battle/Dat/Battle/Message/148.bmd|0x001A10": "「よし、面舵戻せ！　反撃に移る！」", "Battle/Dat/Battle/Message/148.bmd|0x001A44": "「………」", "Battle/Dat/Battle/Message/148.bmd|0x001A54": "「防御装置、作動！」", "Battle/Dat/Battle/Message/148.bmd|0x001A73": "「バリアを展開しろ！」", "Battle/Dat/Battle/Message/148.bmd|0x001A95": "「よし、バリアが効いているな」", "Battle/Dat/Battle/Message/148.bmd|0x001AC3": "「反撃不可能だと！？」", "Battle/Dat/Battle/Message/148.bmd|0x001AE5": "「砲撃手、何をしている！？」", "Battle/Dat/Battle/Message/148.bmd|0x001B10": "「くっ！　このままではいい的になるだけだ！」", "Battle/Dat/Battle/Message/148.bmd|0x001B53": "「どこから攻撃してきたというのだ！？」", "Battle/Dat/Battle/Message/148.bmd|0x001B8D": "「他に反撃可能な武器はないのか！？」", "Battle/Dat/Battle/Message/148.bmd|0x001BC4": "「馬鹿な！/　戦艦の射程を上回る攻撃など……！！」", "Battle/Dat/Battle/Message/148.bmd|0x001C0E": "「索敵、急げ！」", "Battle/Dat/Battle/Message/148.bmd|0x001C27": "「死角に入られたか……！」", "Battle/Dat/Battle/Message/148.bmd|0x001C4F": "「友軍機を援護する！」", "Battle/Dat/Battle/Message/148.bmd|0x001C71": "「一斉射撃！　とどめをさすぞ！」", "Battle/Dat/Battle/Message/148.bmd|0x001CA2": "「援護砲撃！　撃て！！」", "Battle/Dat/Battle/Message/148.bmd|0x001CC7": "「本艦を盾にする！」", "Battle/Dat/Battle/Message/148.bmd|0x001CE6": "「構わん！　突っ込め！！」", "Battle/Dat/Battle/Message/148.bmd|0x001D0E": "「我らの理想のために！」", "Battle/Dat/Battle/Message/148.bmd|0x001D33": "「対空機銃、敵機を近づけるな！」", "Battle/Dat/Battle/Message/148.bmd|0x001D64": "「艦前方に弾幕を展開しろ！」", "Battle/Dat/Battle/Message/148.bmd|0x001D8F": "「機銃群、攻撃開始！！」", "Battle/Dat/Battle/Message/148.bmd|0x001DB4": "「各砲座、一斉射撃！！」", "Battle/Dat/Battle/Message/148.bmd|0x001DD9": "「敵機データ入力！　ミサイル発射！！」", "Battle/Dat/Battle/Message/148.bmd|0x001E13": "「ミサイル発射！！」", "Battle/Dat/Battle/Message/148.bmd|0x001E32": "「魚雷、１番から４番まで発射準備！/　撃て！！」", "Battle/Dat/Battle/Message/148.bmd|0x001E79": "「魚雷、発射！！」", "Battle/Dat/Battle/Message/148.bmd|0x001E95": "「魚雷発射管、開け！/　１番から４番、発射！！」", "Battle/Dat/Battle/Message/148.bmd|0x001EDC": "「構わん！　対艦ミサイルを使え！！」", "Battle/Dat/Battle/Message/148.bmd|0x001F13": "「２番、３番副砲、撃て！！」"}