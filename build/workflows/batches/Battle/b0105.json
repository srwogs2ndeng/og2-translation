{"Battle/Dat/Battle/Message/058.bmd|0x007BBB": "「トウマ、やめんか！」", "Battle/Dat/Battle/Message/058.bmd|0x007BDD": "「貴様らガイアセイバーズなどに！」", "Battle/Dat/Battle/Message/058.bmd|0x007C11": "「甘いぞ、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/058.bmd|0x007C3F": "「ダブルＧとて負けはせん！」", "Battle/Dat/Battle/Message/058.bmd|0x007C6A": "「お前に狩られるわけにはいかん！」", "Battle/Dat/Battle/Message/058.bmd|0x007C9E": "「無駄だ、アルベロ少佐！」", "Battle/Dat/Battle/Message/058.bmd|0x007CC6": "「アルベロ少佐、その機体は危険だ！」", "Battle/Dat/Battle/Message/058.bmd|0x007CFD": "「四凶の力はそんなものか！」", "Battle/Dat/Battle/Message/058.bmd|0x007D28": "「饕餮、窮奇と名は大層だがな」", "Battle/Dat/Battle/Message/058.bmd|0x007D56": "「あの女の欲望は、もう止まらんな……！」", "Battle/Dat/Battle/Message/058.bmd|0x007D93": "「ふん、とんだ地球の守護者だな！」", "Battle/Dat/Battle/Message/058.bmd|0x007DC7": "「ユーゼス、あの世には一人で往け！」", "Battle/Dat/Battle/Message/058.bmd|0x007DFE": "「ルイーナの雑魚などに！」", "Battle/Dat/Battle/Message/058.bmd|0x007E26": "「化け物とじゃれ合う趣味はない！」", "Battle/Dat/Battle/Message/058.bmd|0x007E5A": "「顔を洗って出直してこい！」", "Battle/Dat/Battle/Message/058.bmd|0x007E85": "「モーションにもっとアレンジを入れろ！」", "Battle/Dat/Battle/Message/058.bmd|0x007EC2": "「いいモーションだ。しかし、/　当てねば意味がない」", "Battle/Dat/Battle/Message/058.bmd|0x007F0F": "「どうした？　俺はここにいるぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x007F43": "「無駄な動きが多いぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x007F68": "「こいつの扱いには慣れているのでな」", "Battle/Dat/Battle/Message/058.bmd|0x007F9F": "「改型の運動性は見ての通りだ！」", "Battle/Dat/Battle/Message/058.bmd|0x007FD0": "「踏み込みの速さは、/　ダイゼンガーの方が上だな」", "Battle/Dat/Battle/Message/058.bmd|0x00801A": "「ゲストなどにやられるか！」", "Battle/Dat/Battle/Message/058.bmd|0x008045": "「ゲスト、お前達の手は通用せんぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x00807C": "「無駄だ！！」", "Battle/Dat/Battle/Message/058.bmd|0x008092": "「気合が足りん！　気合が！！」", "Battle/Dat/Battle/Message/058.bmd|0x0080C0": "「甘い！」", "Battle/Dat/Battle/Message/058.bmd|0x0080D0": "「効きはせん！」", "Battle/Dat/Battle/Message/058.bmd|0x0080E9": "「そんなものが俺に届くと思うなよ」", "Battle/Dat/Battle/Message/058.bmd|0x00811D": "「無駄な攻撃だったな」", "Battle/Dat/Battle/Message/058.bmd|0x00813F": "「ふん、使う武器を選べ」", "Battle/Dat/Battle/Message/058.bmd|0x008164": "「………」", "Battle/Dat/Battle/Message/058.bmd|0x008174": "「チッ……俺がこんなことでどうする」", "Battle/Dat/Battle/Message/058.bmd|0x0081AB": "「もっと狙いを絞らねばならんな」", "Battle/Dat/Battle/Message/058.bmd|0x0081DC": "「……いいように踊らされたか」", "Battle/Dat/Battle/Message/058.bmd|0x00820A": "「ふん、教本通りの戦い方だな」", "Battle/Dat/Battle/Message/058.bmd|0x008238": "「俺の目を眩ませるとはな」", "Battle/Dat/Battle/Message/058.bmd|0x008260": "「ええい、ここでロストするとは！」", "Battle/Dat/Battle/Message/058.bmd|0x008294": "「トドメは確実に刺す！」", "Battle/Dat/Battle/Message/058.bmd|0x0082B9": "「よくやった。後は俺に任せろ」", "Battle/Dat/Battle/Message/058.bmd|0x0082E7": "「その隙を見逃す俺ではない！」", "Battle/Dat/Battle/Message/058.bmd|0x008315": "「まさに阿吽の呼吸だな」", "Battle/Dat/Battle/Message/058.bmd|0x00833A": "「援護だな？　了解した」", "Battle/Dat/Battle/Message/058.bmd|0x00835F": "「見よ、教導隊のコンビネーションを！」", "Battle/Dat/Battle/Message/058.bmd|0x008399": "「教導隊の連携を見せてやる！」", "Battle/Dat/Battle/Message/058.bmd|0x0083C7": "「援護するぞ、ギリアム」", "Battle/Dat/Battle/Message/058.bmd|0x0083EC": "「後は俺に任せると言うことか、ギリアム」", "Battle/Dat/Battle/Message/058.bmd|0x008429": "「手を貸すぞ、ゼンガー！」", "Battle/Dat/Battle/Message/058.bmd|0x008451": "「ゼンガー、後は任せろ！」", "Battle/Dat/Battle/Message/058.bmd|0x008479": "「この呼吸……変わらんな、レーツェル」", "Battle/Dat/Battle/Message/058.bmd|0x0084B3": "「ラトゥーニ、お前は先に行け！」", "Battle/Dat/Battle/Message/058.bmd|0x0084E4": "「フッ、俺の動きも織り込み済みか」", "Battle/Dat/Battle/Message/058.bmd|0x008518": "「援護するぞ、ライ！」", "Battle/Dat/Battle/Message/058.bmd|0x00853A": "「待たんか、アラド！/　どこへ行くつもりだ！？」", "Battle/Dat/Battle/Message/058.bmd|0x008581": "「アラド！　俺に後始末をさせる気か！」", "Battle/Dat/Battle/Message/058.bmd|0x0085BB": "「アラド！　後始末を忘れとるぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x0085EF": "「あいつ、俺の援護を期待しとったのか？」", "Battle/Dat/Battle/Message/058.bmd|0x00862C": "「ゼオラ、援護するぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x008651": "「よくやったぞ、ゼオラ」", "Battle/Dat/Battle/Message/058.bmd|0x008676": "「ラミア、後は任せろ！」", "Battle/Dat/Battle/Message/058.bmd|0x00869B": "「ラーダ、後は俺がやる！」", "Battle/Dat/Battle/Message/058.bmd|0x0086C3": "「キョウスケ、援護する！」", "Battle/Dat/Battle/Message/058.bmd|0x0086EB": "「詰めが甘い！　気を抜くな！」", "Battle/Dat/Battle/Message/058.bmd|0x008719": "「アリエイル、援護する！」", "Battle/Dat/Battle/Message/058.bmd|0x008741": "「ヒューゴ、後は任せろ！」", "Battle/Dat/Battle/Message/058.bmd|0x008769": "「手を貸すぞ、ヒューゴ！」", "Battle/Dat/Battle/Message/058.bmd|0x008791": "「アクア、詰めが甘いぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x0087B9": "「アクア、お前は先に行け！」", "Battle/Dat/Battle/Message/058.bmd|0x0087E4": "「ジョッシュ、援護するぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x00880F": "「リム、後は俺が引き受ける！」", "Battle/Dat/Battle/Message/058.bmd|0x00883D": "「トウマ、周りにもっと気を配れ！」", "Battle/Dat/Battle/Message/058.bmd|0x008871": "「援護するぞ、イング！」", "Battle/Dat/Battle/Message/058.bmd|0x008896": "「コウタ、/　前だけ見ていればいいというものではない！」", "Battle/Dat/Battle/Message/058.bmd|0x0088E9": "「援護するぞ、ＳＲＸチーム！」", "Battle/Dat/Battle/Message/058.bmd|0x008917": "「早く後退しろ！」", "Battle/Dat/Battle/Message/058.bmd|0x008933": "「敵機に気を取られ過ぎだ！」", "Battle/Dat/Battle/Message/058.bmd|0x00895E": "「回避運動がなっとらんぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x008989": "「こちらで受け止めてやる！」", "Battle/Dat/Battle/Message/058.bmd|0x0089B4": "「下がれ、ゼンガー！」", "Battle/Dat/Battle/Message/058.bmd|0x0089D6": "「ギリアム、ここは任せろ！」", "Battle/Dat/Battle/Message/058.bmd|0x008A01": "「下がれ、レーツェル！」", "Battle/Dat/Battle/Message/058.bmd|0x008A26": "「アラド！　後で説教だ！！」", "Battle/Dat/Battle/Message/058.bmd|0x008A51": "「部下の面倒はきっちりと見る！」", "Battle/Dat/Battle/Message/058.bmd|0x008A82": "「俺の部下に手出しはさせんぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x008AB3": "「アラド！　もっと周りに気を配れ！」", "Battle/Dat/Battle/Message/058.bmd|0x008AEA": "「何回言えばわかるんだ、お前は！」", "Battle/Dat/Battle/Message/058.bmd|0x008B1E": "「隙があるから、ここで押し込まれるんだ！」", "Battle/Dat/Battle/Message/058.bmd|0x008B5E": "「必ず助けが入ると思うなよ！」", "Battle/Dat/Battle/Message/058.bmd|0x008B8C": "「下がれ、アリエイル！」", "Battle/Dat/Battle/Message/058.bmd|0x008BB1": "「ヒューゴ、無茶をするな！」", "Battle/Dat/Battle/Message/058.bmd|0x008BDC": "「突出し過ぎるな、ヒューゴ！」", "Battle/Dat/Battle/Message/058.bmd|0x008C0A": "「アクア、油断するな！」", "Battle/Dat/Battle/Message/058.bmd|0x008C2F": "「アクア、見極めが甘いぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x008C5A": "「下がれ、ジョッシュ！」", "Battle/Dat/Battle/Message/058.bmd|0x008C7F": "「リム、ここは俺が引き受ける！」", "Battle/Dat/Battle/Message/058.bmd|0x008CB0": "「イング、離脱しろ！」", "Battle/Dat/Battle/Message/058.bmd|0x008CD2": "「トウマ！　何をやっとるか！」", "Battle/Dat/Battle/Message/058.bmd|0x008D00": "「まとめて落とす！」", "Battle/Dat/Battle/Message/058.bmd|0x008D1F": "「密集するとこういうことになる！」", "Battle/Dat/Battle/Message/058.bmd|0x008D53": "「迂闊な陣形だったな！」", "Battle/Dat/Battle/Message/058.bmd|0x008D78": "「一気にカタをつける！」", "Battle/Dat/Battle/Message/058.bmd|0x008D9D": "「離脱し損なったか！」", "Battle/Dat/Battle/Message/058.bmd|0x008DBF": "「同じ所にいるから、こういうことになる！」", "Battle/Dat/Battle/Message/058.bmd|0x008DFF": "「周りをよく見ていなかったようだな！」", "Battle/Dat/Battle/Message/058.bmd|0x008E39": "「スプリットミサイル！　行けい！」", "Battle/Dat/Battle/Message/058.bmd|0x008E6D": "「沈めっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x008E83": "「こいつでとどめだ！！」", "Battle/Dat/Battle/Message/058.bmd|0x008EA8": "「迂闊な奴め！」", "Battle/Dat/Battle/Message/058.bmd|0x008EC1": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/058.bmd|0x008EE6": "「落ちろ！」", "Battle/Dat/Battle/Message/058.bmd|0x008EF9": "「今頃気づいても、もう遅い！」", "Battle/Dat/Battle/Message/058.bmd|0x008F27": "「直撃させる！！」", "Battle/Dat/Battle/Message/058.bmd|0x008F43": "「さあ、覚悟を決めろ！」", "Battle/Dat/Battle/Message/058.bmd|0x008F68": "「ファイア！！」", "Battle/Dat/Battle/Message/058.bmd|0x008F81": "「俺が引導を渡してやる！」", "Battle/Dat/Battle/Message/058.bmd|0x008FA9": "「行けぃっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x008FC2": "「いい位置だ！」", "Battle/Dat/Battle/Message/058.bmd|0x008FDB": "「くらえい！！」", "Battle/Dat/Battle/Message/058.bmd|0x008FF4": "「せえいっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x00900D": "「ブレイクフィールド、展開！」"}