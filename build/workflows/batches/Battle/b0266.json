{"Battle/Dat/Battle/Message/268.bmd|0x000E8F": "「この国をお前達の好きにはさせん！」", "Battle/Dat/Battle/Message/268.bmd|0x000EC6": "「シュテドニアスの連中め！」", "Battle/Dat/Battle/Message/268.bmd|0x000EF1": "「行くぞ、地上人！」", "Battle/Dat/Battle/Message/268.bmd|0x000F10": "「何者であろうと、敵ならば！」", "Battle/Dat/Battle/Message/268.bmd|0x000F3E": "「こっちから行くぞ！」", "Battle/Dat/Battle/Message/268.bmd|0x000F60": "「逃がすものか！」", "Battle/Dat/Battle/Message/268.bmd|0x000F7C": "「反撃する！」", "Battle/Dat/Battle/Message/268.bmd|0x000F92": "「や、やられた！」", "Battle/Dat/Battle/Message/268.bmd|0x000FAE": "「ここまでかっ！！」", "Battle/Dat/Battle/Message/268.bmd|0x000FCD": "「む、無念！！」", "Battle/Dat/Battle/Message/268.bmd|0x000FE6": "「うぐっ！　動力系にダメージが！」", "Battle/Dat/Battle/Message/268.bmd|0x00101A": "「こ、これ以上はもたんか……！？」", "Battle/Dat/Battle/Message/268.bmd|0x00104E": "「ぐっ！　国境警備隊の意地を見せてやる！」", "Battle/Dat/Battle/Message/268.bmd|0x00108E": "「ぐううっ……！/　中尉達の足を引っ張るわけには……！」", "Battle/Dat/Battle/Message/268.bmd|0x0010E1": "「ちいっ！　やってくれる！」", "Battle/Dat/Battle/Message/268.bmd|0x00110C": "「この程度で我らは怯まんぞ！」", "Battle/Dat/Battle/Message/268.bmd|0x00113A": "「まだだ、まだいける！」", "Battle/Dat/Battle/Message/268.bmd|0x00115F": "「致命傷じゃない、まだ戦える！」", "Battle/Dat/Battle/Message/268.bmd|0x001190": "「避けきれなかったか！」", "Battle/Dat/Battle/Message/268.bmd|0x0011B5": "「奴め、速いな！」", "Battle/Dat/Battle/Message/268.bmd|0x0011D1": "「かすり傷程度で！」", "Battle/Dat/Battle/Message/268.bmd|0x0011F0": "「くっ、対応できなかった！」", "Battle/Dat/Battle/Message/268.bmd|0x00121B": "「当たるものか！」", "Battle/Dat/Battle/Message/268.bmd|0x001237": "「甘い！」", "Battle/Dat/Battle/Message/268.bmd|0x001247": "「遅いぞ！」", "Battle/Dat/Battle/Message/268.bmd|0x00125A": "「そんなもの！」", "Battle/Dat/Battle/Message/268.bmd|0x001273": "「………」", "Battle/Dat/Battle/Message/268.bmd|0x001283": "「くっ、手が出せない！」", "Battle/Dat/Battle/Message/268.bmd|0x0012A8": "「反撃できないとは……！」", "Battle/Dat/Battle/Message/268.bmd|0x0012D0": "「くっ、敵を見失った！」", "Battle/Dat/Battle/Message/268.bmd|0x0012F5": "「奴め、どこへ行った！？」", "Battle/Dat/Battle/Message/268.bmd|0x00131D": "「援護します！」", "Battle/Dat/Battle/Message/268.bmd|0x001336": "「続きます！」", "Battle/Dat/Battle/Message/268.bmd|0x00134C": "「中尉、援護します！」", "Battle/Dat/Battle/Message/268.bmd|0x00136E": "「マサキ殿、援護します！」", "Battle/Dat/Battle/Message/268.bmd|0x001396": "「リューネ殿、後は自分が！」", "Battle/Dat/Battle/Message/268.bmd|0x0013C1": "「ミオ殿、後はお任せを！」", "Battle/Dat/Battle/Message/268.bmd|0x0013E9": "「ヤンロン殿、援護します！」", "Battle/Dat/Battle/Message/268.bmd|0x001414": "「テュッティ殿、後は自分が！」", "Battle/Dat/Battle/Message/268.bmd|0x001442": "「やらせるものか！」", "Battle/Dat/Battle/Message/268.bmd|0x001461": "「ここは自分が！」", "Battle/Dat/Battle/Message/268.bmd|0x00147D": "「中尉、下がってください！」", "Battle/Dat/Battle/Message/268.bmd|0x0014A8": "「マサキ殿、後退を！」", "Battle/Dat/Battle/Message/268.bmd|0x0014CA": "「ミオ殿、ここは自分が！」", "Battle/Dat/Battle/Message/268.bmd|0x0014F2": "「リューネ殿、離脱を！」", "Battle/Dat/Battle/Message/268.bmd|0x001517": "「ヤンロン殿、ここは引き受けます！」", "Battle/Dat/Battle/Message/268.bmd|0x00154E": "「テュッティ殿、下がってください！」", "Battle/Dat/Battle/Message/268.bmd|0x001585": "「もう一撃っ！」", "Battle/Dat/Battle/Message/268.bmd|0x00159E": "「まだ行ける！」", "Battle/Dat/Battle/Message/268.bmd|0x0015B7": "「たあっ！」", "Battle/Dat/Battle/Message/268.bmd|0x0015CA": "「やあっ！」", "Battle/Dat/Battle/Message/268.bmd|0x0015DD": "「とうっ！」", "Battle/Dat/Battle/Message/268.bmd|0x0015F0": "「でえいっ！」", "Battle/Dat/Battle/Message/268.bmd|0x001606": "「パルスレーザー、発射！」", "Battle/Dat/Battle/Message/268.bmd|0x00162E": "「パルスレーザー！」", "Battle/Dat/Battle/Message/268.bmd|0x00164D": "「ミサイル、発射！」", "Battle/Dat/Battle/Message/268.bmd|0x00166C": "「ミサイル！」", "Battle/Dat/Battle/Message/268.bmd|0x001682": "「リニアレールガン！　行けっ！」", "Battle/Dat/Battle/Message/268.bmd|0x0016B3": "「リニアレールガン、発射！」", "Battle/Dat/Battle/Message/269.bmd|0x002D9E": "「僕が、然るべき道を示そう」", "Battle/Dat/Battle/Message/269.bmd|0x002DC9": "「君達に、炎帝の慈悲があらんことを」", "Battle/Dat/Battle/Message/269.bmd|0x002E00": "「君達の目には、苦界しか映っていない」", "Battle/Dat/Battle/Message/269.bmd|0x002E3A": "「朱夏を愛でるが如く、/　君達の命を慈しむとしよう」", "Battle/Dat/Battle/Message/269.bmd|0x002E87": "「幼子には、仕置きが必要か……」", "Battle/Dat/Battle/Message/269.bmd|0x002EB8": "「ここで朱を散らすつもりかい？」", "Battle/Dat/Battle/Message/269.bmd|0x002EE9": "「君達も、あと数百年生きれば/　わかるようになるのだけどね」", "Battle/Dat/Battle/Message/269.bmd|0x002F42": "「自らの朱で紅に染まるか……それも良かろう」", "Battle/Dat/Battle/Message/269.bmd|0x002F85": "「全ては、大千世界のためなのさ」", "Battle/Dat/Battle/Message/269.bmd|0x002FB6": "「君達には、入仙できる可能性があるのにな」", "Battle/Dat/Battle/Message/269.bmd|0x002FF6": "「入仙すれば、苦界での困苦は全て消える」", "Battle/Dat/Battle/Message/269.bmd|0x003033": "「一度、命を終わらせてみるのも手か」", "Battle/Dat/Battle/Message/269.bmd|0x00306A": "「肉の体を捨てれば、/　さらなる力が得られるというのに……」", "Battle/Dat/Battle/Message/269.bmd|0x0030C3": "「僕達も/　三千大千世界を守るつもりなのだけどね」", "Battle/Dat/Battle/Message/269.bmd|0x00310D": "「クスハ、僕の力を君に見せよう」", "Battle/Dat/Battle/Message/269.bmd|0x00313E": "「クスハ、君は僕の下に来るべきなんだよ」", "Battle/Dat/Battle/Message/269.bmd|0x00317B": "「クスハ、君なら上手く尸解出来る」", "Battle/Dat/Battle/Message/269.bmd|0x0031AF": "「ここで死んでも大丈夫だよ、クスハ。/　僕が念入りに尸解を施すから」", "Battle/Dat/Battle/Message/269.bmd|0x003214": "「君を殺せば、クスハも諦めるかな？」", "Battle/Dat/Battle/Message/269.bmd|0x00324B": "「悪いが、クスハは僕の物にするよ」", "Battle/Dat/Battle/Message/269.bmd|0x00327F": "「君はクスハに相応しくないよ」", "Battle/Dat/Battle/Message/269.bmd|0x0032AD": "「凜とした気、ふくよかな体……/　君は僕の好みだよ」", "Battle/Dat/Battle/Message/269.bmd|0x0032FA": "「いいね、君は実にいいよ。好みだ」", "Battle/Dat/Battle/Message/269.bmd|0x00332E": "「僕は、君のような子が好きなのさ」", "Battle/Dat/Battle/Message/269.bmd|0x003362": "「フフフ……僕好みの子だ」", "Battle/Dat/Battle/Message/269.bmd|0x00338A": "「心配はいらない。/　ここで死んでも、僕が尸解させる」", "Battle/Dat/Battle/Message/269.bmd|0x0033DA": "「強念を持ちながら……勿体ないな、君は」", "Battle/Dat/Battle/Message/269.bmd|0x003417": "「尸解すれば、/　さらなる強念を得られるのだけどね」", "Battle/Dat/Battle/Message/269.bmd|0x003464": "「君には、闘仙になれる資格がある」", "Battle/Dat/Battle/Message/269.bmd|0x003498": "「念が強まれば、/　肉体が保たなくなる日が来るのだよ」", "Battle/Dat/Battle/Message/269.bmd|0x0034E8": "「ククル……僕の力はよく知っているだろう？」", "Battle/Dat/Battle/Message/269.bmd|0x00352B": "「主に逆らうか、ククル。愚かだね」", "Battle/Dat/Battle/Message/269.bmd|0x00355F": "「昔から聞き分けが悪いな、青龍は」", "Battle/Dat/Battle/Message/269.bmd|0x003593": "「青龍よ。クスハと共に来るのなら、/　これまでのことは許そう」", "Battle/Dat/Battle/Message/269.bmd|0x0035EF": "「白虎……君には厳しい仕置きが必要だな」", "Battle/Dat/Battle/Message/269.bmd|0x00362C": "「またそちら側に戻るとは……酔狂だね、白虎」", "Battle/Dat/Battle/Message/269.bmd|0x00366F": "「では、こうしよう」", "Battle/Dat/Battle/Message/269.bmd|0x00368E": "「これならどうかな」", "Battle/Dat/Battle/Message/269.bmd|0x0036AD": "「では、返すよ」", "Battle/Dat/Battle/Message/269.bmd|0x0036C6": "「ならば、こちらからも」", "Battle/Dat/Battle/Message/269.bmd|0x0036EB": "「聞き分けのない子だ」", "Battle/Dat/Battle/Message/269.bmd|0x00370D": "「返礼しよう」", "Battle/Dat/Battle/Message/269.bmd|0x003723": "「今日はここまでにしておこうか」", "Battle/Dat/Battle/Message/269.bmd|0x003754": "「まあ、仕方がないな」", "Battle/Dat/Battle/Message/269.bmd|0x003776": "「フフフ……よくやったと言っておこう」", "Battle/Dat/Battle/Message/269.bmd|0x0037B0": "「何！？　雀武王が！！」", "Battle/Dat/Battle/Message/269.bmd|0x0037D5": "「……僕を怒らせると、君のためにならないよ」", "Battle/Dat/Battle/Message/269.bmd|0x003818": "「遊びが過ぎたか……」", "Battle/Dat/Battle/Message/269.bmd|0x00383A": "「僕は泰北ほど我慢強くないんだ」", "Battle/Dat/Battle/Message/269.bmd|0x00386B": "「短命で終わるつもりなのかな？」", "Battle/Dat/Battle/Message/269.bmd|0x00389C": "「あくまでも僕の導きを拒むか……」", "Battle/Dat/Battle/Message/269.bmd|0x0038D0": "「……殺してしまってもいいのだけどね」", "Battle/Dat/Battle/Message/269.bmd|0x00390A": "「やはり、/　幼子にはさらなる力を示さねばならないか」", "Battle/Dat/Battle/Message/269.bmd|0x00395A": "「出来れば、穏便に事を済ませたかったのだが」", "Battle/Dat/Battle/Message/269.bmd|0x00399D": "「クスハ……/　僕に選ばれたことを光栄に思って欲しいな」", "Battle/Dat/Battle/Message/269.bmd|0x0039F0": "「クスハ、その力が/　苦界に埋もれるのは実に勿体ない」", "Battle/Dat/Battle/Message/269.bmd|0x003A40": "「君が死ねば、クスハは……」", "Battle/Dat/Battle/Message/269.bmd|0x003A6B": "「その念の力を、/　もっと効率よく使えばいいものを」", "Battle/Dat/Battle/Message/269.bmd|0x003AB8": "「その強念を/　より良い方向へ導こうと言うのに……」", "Battle/Dat/Battle/Message/269.bmd|0x003B05": "「今のままじゃ、/　君の肉体は念に耐えられず、/　崩壊することになる……」", "Battle/Dat/Battle/Message/269.bmd|0x003B71": "「心配はいらない。/　尸解しても、その美しさは保たれる」"}