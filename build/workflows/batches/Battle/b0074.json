{"Battle/Dat/Battle/Message/044.bmd|0x0086E3": "「ロック解除！」", "Battle/Dat/Battle/Message/044.bmd|0x0086FC": "「行きなさい！　ソードブレイカー！」", "Battle/Dat/Battle/Message/044.bmd|0x008733": "「オート・トレース、スタート！」", "Battle/Dat/Battle/Message/044.bmd|0x008764": "「ソードブレイカー、発射！」", "Battle/Dat/Battle/Message/044.bmd|0x00878F": "「１機たりとも逃しはしない！」", "Battle/Dat/Battle/Message/044.bmd|0x0087BD": "「グラビトン・ランチャー……/　マキシマム・シュート！」", "Battle/Dat/Battle/Message/044.bmd|0x008810": "「グラビトン・ランチャー、発射！」", "Battle/Dat/Battle/Message/044.bmd|0x008844": "「ターゲット、データ入力！」", "Battle/Dat/Battle/Message/044.bmd|0x00886F": "「スラッシュ・リッパー、発射！」", "Battle/Dat/Battle/Message/044.bmd|0x0088A0": "「リープ・スラッシャー、発射！」", "Battle/Dat/Battle/Message/044.bmd|0x0088D1": "「ツイン・マグナライフル、発射！」", "Battle/Dat/Battle/Message/044.bmd|0x008905": "「ライフル、ダブルファイア！」", "Battle/Dat/Battle/Message/044.bmd|0x008933": "「ダブルシュート！」", "Battle/Dat/Battle/Message/044.bmd|0x008952": "「ダブルファイア！」", "Battle/Dat/Battle/Message/044.bmd|0x008971": "「行くわよ！」", "Battle/Dat/Battle/Message/044.bmd|0x008987": "「もらったわ！」", "Battle/Dat/Battle/Message/044.bmd|0x0089A0": "「貫く！」", "Battle/Dat/Battle/Message/044.bmd|0x0089B0": "「この間合いなら！」", "Battle/Dat/Battle/Message/044.bmd|0x0089CF": "「クレイモア！」", "Battle/Dat/Battle/Message/044.bmd|0x0089E8": "「デッド・エンド・ファイア！！」", "Battle/Dat/Battle/Message/044.bmd|0x008A19": "「撃破完了……」", "Battle/Dat/Battle/Message/044.bmd|0x008A32": "「……さすがに弾を使い過ぎたわね」", "Battle/Dat/Battle/Message/044.bmd|0x008A66": "「モーションセレクト！」", "Battle/Dat/Battle/Message/044.bmd|0x008A8B": "「ブレード・トンファー、セット！」", "Battle/Dat/Battle/Message/044.bmd|0x008ABF": "「ブレード・サイ、アクティブ！」", "Battle/Dat/Battle/Message/044.bmd|0x008AF0": "「セット！」", "Battle/Dat/Battle/Message/044.bmd|0x008B03": "「続けて斬り込む！」", "Battle/Dat/Battle/Message/044.bmd|0x008B22": "「フィニッシュ！」", "Battle/Dat/Battle/Message/044.bmd|0x008B3E": "「モード・チェンジ！」", "Battle/Dat/Battle/Message/044.bmd|0x008B60": "「追い詰める！」", "Battle/Dat/Battle/Message/044.bmd|0x008B79": "「プラズマ・ステーク、セット！」", "Battle/Dat/Battle/Message/044.bmd|0x008BAA": "「ジェット・マグナム！！」", "Battle/Dat/Battle/Message/044.bmd|0x008BD2": "「スプリットミサイル！」", "Battle/Dat/Battle/Message/044.bmd|0x008BF7": "「ロングレンジ・モード！」", "Battle/Dat/Battle/Message/044.bmd|0x008C1F": "「マキシマム・シュート！！」", "Battle/Dat/Battle/Message/044.bmd|0x008C4A": "「打点は固定しない！」", "Battle/Dat/Battle/Message/044.bmd|0x008C6C": "「はあっ！！」", "Battle/Dat/Battle/Message/044.bmd|0x008C82": "「メガ・ブラスターキャノン、ファイア！」", "Battle/Dat/Battle/Message/044.bmd|0x008CBF": "「続けて撃ち込む！」", "Battle/Dat/Battle/Message/044.bmd|0x008CDE": "「まだまだ！」", "Battle/Dat/Battle/Message/044.bmd|0x008CF4": "「とどめ！」", "Battle/Dat/Battle/Message/044.bmd|0x008D07": "「ジェット・ファントム！！」", "Battle/Dat/Battle/Message/044.bmd|0x008D32": "「ダーク・ロック！」", "Battle/Dat/Battle/Message/044.bmd|0x008D51": "「ハイパー・ブーストナックル！」", "Battle/Dat/Battle/Message/044.bmd|0x008D82": "「行きなさい！」", "Battle/Dat/Battle/Message/044.bmd|0x008D9B": "「ビーム・キャノン連動！」", "Battle/Dat/Battle/Message/044.bmd|0x008DC3": "「アルティメット・ビーム、ファイア！」", "Battle/Dat/Battle/Message/044.bmd|0x008DFD": "「見るがいい、二凶星の煌めきを」", "Battle/Dat/Battle/Message/044.bmd|0x008E2E": "「計都羅¶剣！」", "Battle/Dat/Battle/Message/044.bmd|0x008E46": "「暗剣殺！」", "Battle/Dat/Battle/Message/044.bmd|0x008E59": "「デッド・エンド・スラッシュ！」", "Battle/Dat/Battle/Message/044.bmd|0x008E8A": "「お別れよ」", "Battle/Dat/Battle/Message/044.bmd|0x008E9D": "「グルンガスト改、ファイナルアタック……！」", "Battle/Dat/Battle/Message/044.bmd|0x008EE0": "「五！」", "Battle/Dat/Battle/Message/044.bmd|0x008EED": "「黄！」", "Battle/Dat/Battle/Message/044.bmd|0x008EFA": "「殺！」", "Battle/Dat/Battle/Message/044.bmd|0x008F07": "「凶方の彼方へ去りなさい……！」", "Battle/Dat/Battle/Message/044.bmd|0x008F38": "「スパイラル・ブレイカー！」", "Battle/Dat/Battle/Message/044.bmd|0x008F63": "「オメガ・キャノン、ファイア！」", "Battle/Dat/Battle/Message/044.bmd|0x008F94": "「ロック・オン！　フル・ファイア！」", "Battle/Dat/Battle/Message/044.bmd|0x008FCB": "「Ｇコンビネーション、アタック！」", "Battle/Dat/Battle/Message/044.bmd|0x008FFF": "「参式、ファイナルアタック！」", "Battle/Dat/Battle/Message/044.bmd|0x00902D": "「獅子王刀、歳破！」", "Battle/Dat/Battle/Message/044.bmd|0x00904C": "「ブースト・オン！」", "Battle/Dat/Battle/Message/044.bmd|0x00906B": "「魅入られたわね、凶方位に」", "Battle/Dat/Battle/Message/044.bmd|0x009096": "「テスラ・ドライブ・ミサイル、ファイア！」", "Battle/Dat/Battle/Message/044.bmd|0x0090D6": "「イルミネーター・リンク！」", "Battle/Dat/Battle/Message/045.bmd|0x007AA5": "「昔取った杵柄って奴さ！」", "Battle/Dat/Battle/Message/045.bmd|0x007ACD": "「さて、行くか！」", "Battle/Dat/Battle/Message/045.bmd|0x007AE9": "「今さら慌てても遅いぜ！」", "Battle/Dat/Battle/Message/045.bmd|0x007B11": "「逃げるなよ……！」", "Battle/Dat/Battle/Message/045.bmd|0x007B30": "「行くぜ、相棒！」", "Battle/Dat/Battle/Message/045.bmd|0x007B4C": "「上には上がいるってな！」", "Battle/Dat/Battle/Message/045.bmd|0x007B74": "「覚悟してもらうぜ！」", "Battle/Dat/Battle/Message/045.bmd|0x007B96": "「そこか！」", "Battle/Dat/Battle/Message/045.bmd|0x007BA9": "「さーて、さくっと行くか！」", "Battle/Dat/Battle/Message/045.bmd|0x007BD4": "「先手はもらった！」", "Battle/Dat/Battle/Message/045.bmd|0x007BF3": "「受け身ってのは性に合わないんでね！」", "Battle/Dat/Battle/Message/045.bmd|0x007C2D": "「先に手を出した方が勝ちなのさ！」", "Battle/Dat/Battle/Message/045.bmd|0x007C61": "「さて、行くか……ゲシュペンストＭＫ‐Ⅱ！」", "Battle/Dat/Battle/Message/045.bmd|0x007CA4": "「ゲシュペンストの扱いにゃ、/　慣れてるんでな！」", "Battle/Dat/Battle/Message/045.bmd|0x007CEE": "「目には目を、特機には特機を！」", "Battle/Dat/Battle/Message/045.bmd|0x007D1F": "「行くぜ、グルンガスト改！」", "Battle/Dat/Battle/Message/045.bmd|0x007D4A": "「改型のパワー、味わってもらおうか！」", "Battle/Dat/Battle/Message/045.bmd|0x007D84": "「リニューアルしたのは、/　見た目だけじゃないんでね！」", "Battle/Dat/Battle/Message/045.bmd|0x007DD7": "「指揮官狙いで行くか！」", "Battle/Dat/Battle/Message/045.bmd|0x007DFC": "「出る杭は打たれるってね！」", "Battle/Dat/Battle/Message/045.bmd|0x007E27": "「目立つ奴から片付ける！」", "Battle/Dat/Battle/Message/045.bmd|0x007E4F": "「余所の星にちょっかい出してる余裕が/　あるのかよ、あんたらは」", "Battle/Dat/Battle/Message/045.bmd|0x007EAE": "「捲土重来ってのはお断りだぜ！」", "Battle/Dat/Battle/Message/045.bmd|0x007EDF": "「相変わらず居丈高な連中だよ、まったく」", "Battle/Dat/Battle/Message/045.bmd|0x007F1C": "「あいつらの指揮官にしちゃ、/　まともな方じゃないの」", "Battle/Dat/Battle/Message/045.bmd|0x007F6C": "「さて、行くぜ！　ロフ！」", "Battle/Dat/Battle/Message/045.bmd|0x007F94": "「ロフ……真っ向勝負ってのも悪くはない！」", "Battle/Dat/Battle/Message/045.bmd|0x007FD4": "「ま、ああいうノリは嫌いじゃないが……」", "Battle/Dat/Battle/Message/045.bmd|0x008011": "「どうも拍子抜けするんだよな、あいつ」", "Battle/Dat/Battle/Message/045.bmd|0x00804B": "「そのノリには誤魔化されんぜ」", "Battle/Dat/Battle/Message/045.bmd|0x008079": "「美女のアプローチは断らない主義なんだがな」", "Battle/Dat/Battle/Message/045.bmd|0x0080BC": "「セティ、地球にもいい男はいるんだぜ？」", "Battle/Dat/Battle/Message/045.bmd|0x0080F9": "「個人的になら、管理されてもいいんだけどな」", "Battle/Dat/Battle/Message/045.bmd|0x00813C": "「さーて、行くぜ！　メリオルエッセ！」", "Battle/Dat/Battle/Message/045.bmd|0x008176": "「男のメリオルエッセに用はないんでね！」", "Battle/Dat/Battle/Message/045.bmd|0x0081B3": "「暑苦しいのは間に合ってるのさ！」", "Battle/Dat/Battle/Message/045.bmd|0x0081E7": "「氷の美女……好みだね」", "Battle/Dat/Battle/Message/045.bmd|0x00820C": "「実は魔女っ子……なんてオチはないか」", "Battle/Dat/Battle/Message/045.bmd|0x008246": "「素顔は美少女……ってなことはなさそうだな」", "Battle/Dat/Battle/Message/045.bmd|0x008289": "「さっさと引っ込んでもらおうか、/　ペルフェクティオ！」", "Battle/Dat/Battle/Message/045.bmd|0x0082DC": "「メキボス……/　またお前とやり合うことになるとはな」", "Battle/Dat/Battle/Message/045.bmd|0x00832C": "「多少は俺達のことを/　理解したと思っていたがな……！」", "Battle/Dat/Battle/Message/045.bmd|0x00837F": "「策士、策に溺れる。/　掴まる所は、もうないぜ？」", "Battle/Dat/Battle/Message/045.bmd|0x0083C9": "「さて……幕引きといこうか、ゼゼーナン！」", "Battle/Dat/Battle/Message/045.bmd|0x008409": "「ま、色々とタイミングが悪かったのさ、/　あんたは！」", "Battle/Dat/Battle/Message/045.bmd|0x008459": "「お前の運命に巻き込まれるなんざ、御免だね」", "Battle/Dat/Battle/Message/045.bmd|0x00849C": "「ふん、黒幕のご登場か。/　歓迎してやらなきゃな」", "Battle/Dat/Battle/Message/045.bmd|0x0084E6": "「あんたの大義はわかり易い。/　だが、それ故にその危険性も然り……なのさ」", "Battle/Dat/Battle/Message/045.bmd|0x008554": "「男装の麗人ってのも悪くはないが……」", "Battle/Dat/Battle/Message/045.bmd|0x00858E": "「悪いが、人間をやめるつもりはないんでね！」", "Battle/Dat/Battle/Message/045.bmd|0x0085D1": "「悪いが、あんたの楽園に興味はないのさ！」", "Battle/Dat/Battle/Message/045.bmd|0x008611": "「おいおい、/　デカけりゃいいってもんじゃないだろうが」", "Battle/Dat/Battle/Message/045.bmd|0x008664": "「ガイアセイバーズ……/　とんだ食わせ者だったな」"}