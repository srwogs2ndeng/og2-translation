{"Battle/Dat/Battle/Message/068.bmd|0x007688": "「俺の前から消え失せろ！！」", "Battle/Dat/Battle/Message/068.bmd|0x0076B3": "「この一撃で決める！」", "Battle/Dat/Battle/Message/068.bmd|0x0076D5": "「狙いは外さん！」", "Battle/Dat/Battle/Message/068.bmd|0x0076F1": "「別れを告げろ、全てのものに！！」", "Battle/Dat/Battle/Message/068.bmd|0x007725": "「集束荷電粒子砲を使う！」", "Battle/Dat/Battle/Message/068.bmd|0x00774D": "「チャージ完了！　トリガー！」", "Battle/Dat/Battle/Message/068.bmd|0x00777B": "「さあ、己の運命を受け入れろ！！」", "Battle/Dat/Battle/Message/068.bmd|0x0077AF": "「はああっ！」", "Battle/Dat/Battle/Message/068.bmd|0x0077C5": "「これで決める！」", "Battle/Dat/Battle/Message/068.bmd|0x0077E1": "「ソニック・ブーストキック！」", "Battle/Dat/Battle/Message/068.bmd|0x00780F": "「ソニック・アクセラレーション！」", "Battle/Dat/Battle/Message/068.bmd|0x007843": "「アタック！！」", "Battle/Dat/Battle/Message/068.bmd|0x00785C": "「行け、Ｍｋ‐Ⅲ！」", "Battle/Dat/Battle/Message/068.bmd|0x00787B": "「切り裂け、ファング・スラッシャー！」", "Battle/Dat/Battle/Message/068.bmd|0x0078B5": "「ファング・スラッシャー、セット！」", "Battle/Dat/Battle/Message/068.bmd|0x0078EC": "「見切れるか、こいつの牙が！」", "Battle/Dat/Battle/Message/068.bmd|0x00791A": "「かわせるか、こいつの牙が！」", "Battle/Dat/Battle/Message/068.bmd|0x007948": "「マキシマムパワー！　シュート！」", "Battle/Dat/Battle/Message/068.bmd|0x00797C": "「闇に沈め！　Ｇインパクト・キャノン！」", "Battle/Dat/Battle/Message/068.bmd|0x0079B9": "「撃ち抜く！」", "Battle/Dat/Battle/Message/068.bmd|0x0079CF": "「ターゲット・ロック！　シュート！」", "Battle/Dat/Battle/Message/068.bmd|0x007A06": "「オメガ・ブラスター！」", "Battle/Dat/Battle/Message/068.bmd|0x007A2B": "「クロス・レンジ！　もらう！」", "Battle/Dat/Battle/Message/068.bmd|0x007A59": "「この一刀、受けてみろ！」", "Battle/Dat/Battle/Message/068.bmd|0x007A81": "「スタッグビートル・クラッシャー、セット！」", "Battle/Dat/Battle/Message/068.bmd|0x007AC4": "「行け、ビルガー！」", "Battle/Dat/Battle/Message/068.bmd|0x007AE3": "「これが本命だ！」", "Battle/Dat/Battle/Message/068.bmd|0x007AFF": "「ジャケットアーマー・パージ！」", "Battle/Dat/Battle/Message/068.bmd|0x007B30": "「このスピードが見切れるか！」", "Battle/Dat/Battle/Message/068.bmd|0x007B5E": "「舞え、ビルガー！」", "Battle/Dat/Battle/Message/068.bmd|0x007B7D": "「ブレイク！」", "Battle/Dat/Battle/Message/068.bmd|0x007B93": "「狙いは外さん……！」", "Battle/Dat/Battle/Message/068.bmd|0x007BB5": "「シュート！」", "Battle/Dat/Battle/Message/068.bmd|0x007BCB": "「連続射撃だ、逃がしはしない！」", "Battle/Dat/Battle/Message/068.bmd|0x007BFC": "「オクスタン・ライフル、シュート！」", "Battle/Dat/Battle/Message/068.bmd|0x007C33": "「ジガンのパワーで押し切る！」", "Battle/Dat/Battle/Message/068.bmd|0x007C61": "「捉えた……完全にな！」", "Battle/Dat/Battle/Message/068.bmd|0x007C86": "「行くぞ！　ジガンテ・ウンギア！！」", "Battle/Dat/Battle/Message/068.bmd|0x007CBD": "「照準セット、誤差修正！」", "Battle/Dat/Battle/Message/068.bmd|0x007CE5": "「撃ち抜く！　ハルバート・ランチャー！」", "Battle/Dat/Battle/Message/068.bmd|0x007D22": "「照準……！　とらえた！」", "Battle/Dat/Battle/Message/068.bmd|0x007D4A": "「ソードブレイカー！　敵を撃て！」", "Battle/Dat/Battle/Message/068.bmd|0x007D7E": "「マトリクス・ミサイル！」", "Battle/Dat/Battle/Message/068.bmd|0x007DA6": "「照準セット！　マトリクス・ミサイル！」", "Battle/Dat/Battle/Message/068.bmd|0x007DE3": "「行け、マトリクス・ミサイル！」", "Battle/Dat/Battle/Message/068.bmd|0x007E14": "「とくと味わえ！」", "Battle/Dat/Battle/Message/068.bmd|0x007E30": "「間合いを詰める！」", "Battle/Dat/Battle/Message/068.bmd|0x007E4F": "「リボルビング・バンカー！」", "Battle/Dat/Battle/Message/068.bmd|0x007E7A": "「撃ち抜いてやる！」", "Battle/Dat/Battle/Message/068.bmd|0x007E99": "「くらえ！！」", "Battle/Dat/Battle/Message/068.bmd|0x007EAF": "「ブースト・アップ！」", "Battle/Dat/Battle/Message/068.bmd|0x007ED1": "「クレイモア！」", "Battle/Dat/Battle/Message/068.bmd|0x007EEA": "「まだまだ！」", "Battle/Dat/Battle/Message/068.bmd|0x007F00": "「撃ち込む！」", "Battle/Dat/Battle/Message/068.bmd|0x007F16": "「バンカー！　とどめだ！！」", "Battle/Dat/Battle/Message/068.bmd|0x007F41": "「クロス・レンジに飛び込む！」", "Battle/Dat/Battle/Message/068.bmd|0x007F6F": "「トンファー、セット！」", "Battle/Dat/Battle/Message/068.bmd|0x007F94": "「おおおっ！」", "Battle/Dat/Battle/Message/068.bmd|0x007FAA": "「ブレード・サイ、アクティブ！」", "Battle/Dat/Battle/Message/068.bmd|0x007FDB": "「行くぞ！」", "Battle/Dat/Battle/Message/068.bmd|0x007FEE": "「とどめだ！！」", "Battle/Dat/Battle/Message/068.bmd|0x008007": "「モード・チェンジ！」", "Battle/Dat/Battle/Message/068.bmd|0x008029": "「この連射から逃げられはせん！」", "Battle/Dat/Battle/Message/068.bmd|0x00805A": "「まだ撃ち込む！！」", "Battle/Dat/Battle/Message/068.bmd|0x008079": "「プラズマ・ステーク、アクティブ！」", "Battle/Dat/Battle/Message/068.bmd|0x0080B0": "「ジェット・マグナム！！」", "Battle/Dat/Battle/Message/068.bmd|0x0080D8": "「バレル展開！」", "Battle/Dat/Battle/Message/068.bmd|0x0080F1": "「連打だ！　打ち込む！！」", "Battle/Dat/Battle/Message/068.bmd|0x008119": "「燃え尽きるがいい！！」", "Battle/Dat/Battle/Message/068.bmd|0x00813E": "「ジェット・ファントム！！」", "Battle/Dat/Battle/Message/068.bmd|0x008169": "「ダーク・ロック！」", "Battle/Dat/Battle/Message/068.bmd|0x008188": "「もう一撃っ！」", "Battle/Dat/Battle/Message/068.bmd|0x0081A1": "「ハイパー・ブーストナックル！」", "Battle/Dat/Battle/Message/068.bmd|0x0081D2": "「行けぇっ！！」", "Battle/Dat/Battle/Message/068.bmd|0x0081EB": "「ビーム・キャノン、連動！」", "Battle/Dat/Battle/Message/068.bmd|0x008216": "「アルティメット・ビーム、発射！！」", "Battle/Dat/Battle/Message/068.bmd|0x00824D": "「見るがいい、超闘士の力を」", "Battle/Dat/Battle/Message/068.bmd|0x008278": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/068.bmd|0x008293": "「暗剣殺！！」", "Battle/Dat/Battle/Message/068.bmd|0x0082A9": "「斬！！」", "Battle/Dat/Battle/Message/068.bmd|0x0082B9": "「凶星から逃れる術はない……！」", "Battle/Dat/Battle/Message/068.bmd|0x0082EA": "「超闘士の奥義、その身で味わえ！」", "Battle/Dat/Battle/Message/068.bmd|0x00831E": "「五！」", "Battle/Dat/Battle/Message/068.bmd|0x00832B": "「黄！」", "Battle/Dat/Battle/Message/068.bmd|0x008338": "「殺！！」", "Battle/Dat/Battle/Message/068.bmd|0x008348": "「凶方の彼方へ去れ……！」", "Battle/Dat/Battle/Message/068.bmd|0x008370": "「ツイン・ビームキャノン、発射！」", "Battle/Dat/Battle/Message/068.bmd|0x0083A4": "「スパイラル・ブレイカー！」", "Battle/Dat/Battle/Message/068.bmd|0x0083CF": "「出し惜しみはせん！」", "Battle/Dat/Battle/Message/068.bmd|0x0083F1": "「これで決める！！」", "Battle/Dat/Battle/Message/068.bmd|0x008410": "「ラプターとバイソンの連係で！」", "Battle/Dat/Battle/Message/068.bmd|0x008441": "「参式の奥義、その身で味わえ！」", "Battle/Dat/Battle/Message/068.bmd|0x008472": "「獅子王刀、歳破！」", "Battle/Dat/Battle/Message/068.bmd|0x008491": "「ブースト！！」", "Battle/Dat/Battle/Message/068.bmd|0x0084AA": "「獅子王の号、伊達ではないな」", "Battle/Dat/Battle/Message/068.bmd|0x0084D8": "「ＭＴＤ誘導弾、発射！」", "Battle/Dat/Battle/Message/068.bmd|0x0084FD": "「テスラ・ドライブのミサイルだ、/　逃げられんぞ！」", "Battle/Dat/Battle/Message/068.bmd|0x00854A": "「イルミネーター・リンク！」", "Battle/Dat/Battle/Message/068.bmd|0x008575": "「天空からの光！　逃れる術はない！」", "Battle/Dat/Battle/Message/069.bmd|0x003F51": "「手加減なんてしてらんないよっ！」", "Battle/Dat/Battle/Message/069.bmd|0x003F85": "「落ちなよっ！」", "Battle/Dat/Battle/Message/069.bmd|0x003F9E": "「こっちから行くよっ！」", "Battle/Dat/Battle/Message/069.bmd|0x003FC3": "「いただき！　桃の木！　山椒の木！」", "Battle/Dat/Battle/Message/069.bmd|0x003FFA": "「恋も標的もロックしたら逃がさない！」", "Battle/Dat/Battle/Message/069.bmd|0x004034": "「リズムはつかんだ！/　８ビートから１６ビート！」", "Battle/Dat/Battle/Message/069.bmd|0x00407E": "「撃墜マーク、ゲットだよ！」", "Battle/Dat/Battle/Message/069.bmd|0x0040A9": "「こう見えても/　修羅場は踏んで来てるんだから！」", "Battle/Dat/Battle/Message/069.bmd|0x0040F3": "「せーのっ！」", "Battle/Dat/Battle/Message/069.bmd|0x004109": "「このチャンス、もらった！」", "Battle/Dat/Battle/Message/069.bmd|0x004134": "「出たとこ勝負でドーン！」", "Battle/Dat/Battle/Message/069.bmd|0x00415C": "「こういうのは、先に手を出した方が勝ち！」", "Battle/Dat/Battle/Message/069.bmd|0x00419C": "「待ってるのは性に合わないからね！」", "Battle/Dat/Battle/Message/069.bmd|0x0041D3": "「頼むわよ、ランドグリーズ！」", "Battle/Dat/Battle/Message/069.bmd|0x004201": "「行くよ、ランドグリーズ！」", "Battle/Dat/Battle/Message/069.bmd|0x00422C": "「行くよ、ドゥバン！」", "Battle/Dat/Battle/Message/069.bmd|0x00424E": "「ドゥバン、あんたの暴走を止めてやる！」", "Battle/Dat/Battle/Message/069.bmd|0x00428B": "「覚悟しなよ、アルテウル！」", "Battle/Dat/Battle/Message/069.bmd|0x0042B6": "「カークス将軍！/　あんたは急ぎ過ぎなんだよ！」", "Battle/Dat/Battle/Message/069.bmd|0x0042FD": "「あたしはあんたを止めるよ！」", "Battle/Dat/Battle/Message/069.bmd|0x00432B": "「行くよ、イグニス！」"}