{"Battle/Dat/Battle/Message/305.bmd|0x0022CC": "「くうう……！　追い込まれたか！」", "Battle/Dat/Battle/Message/305.bmd|0x002300": "「ぐうっ！　直撃だと！」", "Battle/Dat/Battle/Message/305.bmd|0x002325": "「ちいっ！　やるな！」", "Battle/Dat/Battle/Message/305.bmd|0x002347": "「ちっ！　ここから巻き返す！」", "Battle/Dat/Battle/Message/305.bmd|0x002375": "「くっ！　バランサーの調子が！」", "Battle/Dat/Battle/Message/305.bmd|0x0023A6": "「うぐっ！　この程度で怯むものか！」", "Battle/Dat/Battle/Message/305.bmd|0x0023DD": "「くっ、良くない流れだな……！」", "Battle/Dat/Battle/Message/305.bmd|0x00240E": "「ぬうっ！　これ以上はやらせんぞ！」", "Battle/Dat/Battle/Message/305.bmd|0x002445": "「ちいっ！　当たり所が悪い！」", "Battle/Dat/Battle/Message/305.bmd|0x002473": "「ふん、大したことはない」", "Battle/Dat/Battle/Message/305.bmd|0x00249B": "「この程度の抵抗しか出来んのか」", "Battle/Dat/Battle/Message/305.bmd|0x0024CC": "「装甲をかすめた程度だ！」", "Battle/Dat/Battle/Message/305.bmd|0x0024F4": "「フッ、余裕だな」", "Battle/Dat/Battle/Message/305.bmd|0x002510": "「何だ、もう終わりか？」", "Battle/Dat/Battle/Message/305.bmd|0x002535": "「つまらん手だな」", "Battle/Dat/Battle/Message/305.bmd|0x002551": "「無駄な抵抗はやめろ」", "Battle/Dat/Battle/Message/305.bmd|0x002573": "「甘い！」", "Battle/Dat/Battle/Message/305.bmd|0x002583": "「当たるか！」", "Battle/Dat/Battle/Message/305.bmd|0x002599": "「遅い！」", "Battle/Dat/Battle/Message/305.bmd|0x0025A9": "「どこを見ている！」", "Battle/Dat/Battle/Message/305.bmd|0x0025C8": "「その程度！」", "Battle/Dat/Battle/Message/305.bmd|0x0025DE": "「そんなもの！」", "Battle/Dat/Battle/Message/305.bmd|0x0025F7": "「残念だったな！」", "Battle/Dat/Battle/Message/305.bmd|0x002613": "「無駄だ！」", "Battle/Dat/Battle/Message/305.bmd|0x002626": "「その手は食わんぞ！」", "Battle/Dat/Battle/Message/305.bmd|0x002648": "「………」", "Battle/Dat/Battle/Message/305.bmd|0x002658": "「くっ、反撃できん！」", "Battle/Dat/Battle/Message/305.bmd|0x00267A": "「後退するしかないか！」", "Battle/Dat/Battle/Message/305.bmd|0x00269F": "「手も足も出せんとは！」", "Battle/Dat/Battle/Message/305.bmd|0x0026C4": "「このままでは的になる！」", "Battle/Dat/Battle/Message/305.bmd|0x0026EC": "「くっ、補給せねば！」", "Battle/Dat/Battle/Message/305.bmd|0x00270E": "「うぬっ、使える武器は！？」", "Battle/Dat/Battle/Message/305.bmd|0x002739": "「くっ、この間合いでは……！」", "Battle/Dat/Battle/Message/305.bmd|0x002767": "「奴め、どこへ行った！？」", "Battle/Dat/Battle/Message/305.bmd|0x00278F": "「くそっ、どこから攻撃して来た！？」", "Battle/Dat/Battle/Message/305.bmd|0x0027C6": "「チッ、奴はどこにいる！？」", "Battle/Dat/Battle/Message/305.bmd|0x0027F1": "「ええい、これでは狙い撃ちされる！」", "Battle/Dat/Battle/Message/305.bmd|0x002828": "「死角に入られたか！」", "Battle/Dat/Battle/Message/305.bmd|0x00284A": "「続けて行く！」", "Battle/Dat/Battle/Message/305.bmd|0x002863": "「まだ俺がいる！」", "Battle/Dat/Battle/Message/305.bmd|0x00287F": "「逃げ損なったか！」", "Battle/Dat/Battle/Message/305.bmd|0x00289E": "「まだ終わりじゃない！」", "Battle/Dat/Battle/Message/305.bmd|0x0028C3": "「ねじ込んでやる！」", "Battle/Dat/Battle/Message/305.bmd|0x0028E2": "「よし、援護を！」", "Battle/Dat/Battle/Message/305.bmd|0x0028FE": "「やらせるものか！」", "Battle/Dat/Battle/Message/305.bmd|0x00291D": "「受け止めてみせる！」", "Battle/Dat/Battle/Message/305.bmd|0x00293F": "「やらせん！」", "Battle/Dat/Battle/Message/305.bmd|0x002955": "「お前の相手は俺だ！」", "Battle/Dat/Battle/Message/305.bmd|0x002977": "「割り込む！」", "Battle/Dat/Battle/Message/305.bmd|0x00298D": "「俺が盾になれば！」", "Battle/Dat/Battle/Message/305.bmd|0x0029AC": "「こちらで受け止めれば！」", "Battle/Dat/Battle/Message/305.bmd|0x0029D4": "「当たれ！」", "Battle/Dat/Battle/Message/305.bmd|0x0029E7": "「受けろ！」", "Battle/Dat/Battle/Message/305.bmd|0x0029FA": "「直撃させる！」", "Battle/Dat/Battle/Message/305.bmd|0x002A13": "「叩き落とす！」", "Battle/Dat/Battle/Message/305.bmd|0x002A2C": "「運が悪かったな！」", "Battle/Dat/Battle/Message/305.bmd|0x002A4B": "「こういう展開もある！」", "Battle/Dat/Battle/Message/305.bmd|0x002A70": "「ふん、油断したな！」", "Battle/Dat/Battle/Message/305.bmd|0x002A92": "「いい流れだ！　行ける！」", "Battle/Dat/Battle/Message/305.bmd|0x002ABA": "「この距離ならば！」", "Battle/Dat/Battle/Message/305.bmd|0x002AD9": "「この間合いなら！」", "Battle/Dat/Battle/Message/999.bmd|0x002080": "「私だって……やってみせるわ！」", "Battle/Dat/Battle/Message/999.bmd|0x0020B1": "「そこねっ！」", "Battle/Dat/Battle/Message/999.bmd|0x0020C7": "「これ以上は……やらせない！」", "Battle/Dat/Battle/Message/999.bmd|0x0020F5": "「当たって！」", "Battle/Dat/Battle/Message/999.bmd|0x00210B": "「覚悟してください！」", "Battle/Dat/Battle/Message/999.bmd|0x00212D": "「逃げるわけには……いかないもの！」", "Battle/Dat/Battle/Message/999.bmd|0x002164": "「勝負ですっ！」", "Battle/Dat/Battle/Message/999.bmd|0x00217D": "「行きますっ！」", "Battle/Dat/Battle/Message/999.bmd|0x002196": "「受けてもらいますっ！」", "Battle/Dat/Battle/Message/999.bmd|0x0021BB": "「これが……/　避けられない戦いだと言うのなら！」", "Battle/Dat/Battle/Message/999.bmd|0x002205": "「私も……退くわけにはいかないんです！」", "Battle/Dat/Battle/Message/999.bmd|0x002242": "「まだ、これからっ！」", "Battle/Dat/Battle/Message/999.bmd|0x002264": "「受け身になってるだけじゃ駄目！」", "Battle/Dat/Battle/Message/999.bmd|0x002298": "「まだ終わりじゃありません！」", "Battle/Dat/Battle/Message/999.bmd|0x0022C6": "「私だって、やる時はやりますっ！」", "Battle/Dat/Battle/Message/999.bmd|0x0022FA": "「きゃあああっ！！」", "Battle/Dat/Battle/Message/999.bmd|0x002319": "「な、何とかしなきゃ……！」", "Battle/Dat/Battle/Message/999.bmd|0x002344": "「こんなことで……/　くじけちゃいられないもの！」", "Battle/Dat/Battle/Message/999.bmd|0x00238E": "「ど、どうしたらいいの……！？」", "Battle/Dat/Battle/Message/999.bmd|0x0023BF": "「ああっ！　つ、次の攻撃を受けたら……！」", "Battle/Dat/Battle/Message/999.bmd|0x0023FF": "「まだあきらめない！/　みんなだって、戦っているんだもの！」", "Battle/Dat/Battle/Message/999.bmd|0x002458": "「きゃあああっ！/　このままじゃ、やられちゃう！」", "Battle/Dat/Battle/Message/999.bmd|0x0024A2": "「これぐらいなら、まだ平気！」", "Battle/Dat/Battle/Message/999.bmd|0x0024D0": "「ううっ……どこがやられたの！？」", "Battle/Dat/Battle/Message/999.bmd|0x002504": "「大丈夫、この程度ならまだ戦えるはず……」", "Battle/Dat/Battle/Message/999.bmd|0x002544": "「こ、これ以上は……やらせないわ！」", "Battle/Dat/Battle/Message/999.bmd|0x00257B": "「こんなことで……/　泣き言なんて言ってられない！」", "Battle/Dat/Battle/Message/999.bmd|0x0025C8": "「私だって……/　これぐらい何とかしてみせる！」", "Battle/Dat/Battle/Message/999.bmd|0x00260F": "「ああっ！/　ま、まともに当たっちゃった……！」", "Battle/Dat/Battle/Message/999.bmd|0x002656": "「きゃあっ！　当たったの！？」", "Battle/Dat/Battle/Message/999.bmd|0x002684": "「これぐらい、平気ですっ！」", "Battle/Dat/Battle/Message/999.bmd|0x0026AF": "「良かった……思ったより、ダメージが軽いわ」", "Battle/Dat/Battle/Message/999.bmd|0x0026F2": "「いけない、回避できなかった……！？」", "Battle/Dat/Battle/Message/999.bmd|0x00272C": "「各部チェック……/　問題はないみたいね」", "Battle/Dat/Battle/Message/999.bmd|0x00276A": "「もっとちゃんと操縦しなきゃ……！」", "Battle/Dat/Battle/Message/999.bmd|0x0027A1": "「こう見えても、少しは鍛えてるんだから」", "Battle/Dat/Battle/Message/999.bmd|0x0027DE": "「みんなには迷惑、かけられないもの！」", "Battle/Dat/Battle/Message/999.bmd|0x002818": "「避けてみせます！」", "Battle/Dat/Battle/Message/999.bmd|0x002837": "「そんなもの、当たりません！」", "Battle/Dat/Battle/Message/999.bmd|0x002865": "「良かった……外れてくれた」", "Battle/Dat/Battle/Message/999.bmd|0x002890": "「上手くかわせた！」", "Battle/Dat/Battle/Message/999.bmd|0x0028AF": "「ふう……運が良かったのね」", "Battle/Dat/Battle/Message/999.bmd|0x0028DA": "「な、何とかよけられた……！」", "Battle/Dat/Battle/Message/999.bmd|0x002908": "「だって、動きが見えてるもの」", "Battle/Dat/Battle/Message/999.bmd|0x002936": "「そう簡単にやられませんっ！」", "Battle/Dat/Battle/Message/999.bmd|0x002964": "「お願い、私を守って！」", "Battle/Dat/Battle/Message/999.bmd|0x002989": "「ああっ！　……助かった……？」", "Battle/Dat/Battle/Message/999.bmd|0x0029BA": "「お願い、念動フィールド！」", "Battle/Dat/Battle/Message/999.bmd|0x0029E5": "「ジャマーがあってよかった……」", "Battle/Dat/Battle/Message/999.bmd|0x002A16": "「そんなもの、無駄です！」", "Battle/Dat/Battle/Message/999.bmd|0x002A3E": "「え？　え！？　何も出来ないの……？」", "Battle/Dat/Battle/Message/999.bmd|0x002A78": "「ダメ、届かない……！」", "Battle/Dat/Battle/Message/999.bmd|0x002A9D": "「しまった……！　見失っちゃった……」", "Battle/Dat/Battle/Message/999.bmd|0x002AD7": "「いつも助けられてるばかりじゃありません！」", "Battle/Dat/Battle/Message/999.bmd|0x002B1A": "「続けて行きますっ！」", "Battle/Dat/Battle/Message/999.bmd|0x002B3C": "「逃がすわけにはいきません！」", "Battle/Dat/Battle/Message/999.bmd|0x002B6A": "「守られてるだけじゃ嫌だもの！」", "Battle/Dat/Battle/Message/999.bmd|0x002B9B": "「助けますっ！」", "Battle/Dat/Battle/Message/999.bmd|0x002BB4": "「この場を何とかしなくちゃ！」"}