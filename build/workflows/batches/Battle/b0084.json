{"Battle/Dat/Battle/Message/047.bmd|0x008C79": "「このスピードなら、絶対負けない！」", "Battle/Dat/Battle/Message/047.bmd|0x008CB0": "「ビクティム・ビーク！！」", "Battle/Dat/Battle/Message/047.bmd|0x008CD8": "「Ｅモード、発射！！」", "Battle/Dat/Battle/Message/047.bmd|0x008CFA": "「Ｂモード、発射！！」", "Battle/Dat/Battle/Message/047.bmd|0x008D1C": "「今度は両方使うわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x008D41": "「オクスタン・ライフル、Ｗモードッ！！」", "Battle/Dat/Battle/Message/047.bmd|0x008D7E": "「ソニック・ブレイカーで行くわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x008DB5": "「突撃！！」", "Battle/Dat/Battle/Message/047.bmd|0x008DC8": "「ブレイクフィールド、オン！」", "Battle/Dat/Battle/Message/047.bmd|0x008DF6": "「ソニック・ブレイカー！！」", "Battle/Dat/Battle/Message/047.bmd|0x008E21": "「ギガント・ナックル！」", "Battle/Dat/Battle/Message/047.bmd|0x008E46": "「ギガ・ワイドブラスター！！」", "Battle/Dat/Battle/Message/047.bmd|0x008E74": "「ギガ・サークルブラスター！！」", "Battle/Dat/Battle/Message/047.bmd|0x008EA5": "「さあ、行くわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x008EC4": "「逃げられるものなら、逃げてみなさい！」", "Battle/Dat/Battle/Message/047.bmd|0x008F01": "「必殺！　ジガンテ・ウンギア！！」", "Battle/Dat/Battle/Message/047.bmd|0x008F35": "「ロックオン、完了！」", "Battle/Dat/Battle/Message/047.bmd|0x008F57": "「ハルバート・ランチャー、発射！！」", "Battle/Dat/Battle/Message/047.bmd|0x008F8E": "「隠れたって無駄よ！」", "Battle/Dat/Battle/Message/047.bmd|0x008FB0": "「行っけぇ！　ソードブレイカー！」", "Battle/Dat/Battle/Message/047.bmd|0x008FE4": "「ＭＡＰＷを使います！/　味方機は下がってください！」", "Battle/Dat/Battle/Message/047.bmd|0x009034": "「受けなさい！/　グラビトン・ランチャー！！」", "Battle/Dat/Battle/Message/047.bmd|0x009078": "「獅子王の太刀、受けなさい！」", "Battle/Dat/Battle/Message/047.bmd|0x0090A6": "「はあああっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x0090C2": "「たあぁっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x0090DB": "「たあああーーーっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x009100": "「悪・即・断よっ！」", "Battle/Dat/Battle/Message/047.bmd|0x00911F": "「スラッシュ・リッパー、セット！」", "Battle/Dat/Battle/Message/047.bmd|0x009153": "「外さないわよ！！」", "Battle/Dat/Battle/Message/047.bmd|0x009172": "「照準……！　いけるわ！」", "Battle/Dat/Battle/Message/047.bmd|0x00919A": "「スラッシュ・リッパー、発射！」", "Battle/Dat/Battle/Message/047.bmd|0x0091CB": "「ディバイン・アーム！」", "Battle/Dat/Battle/Message/047.bmd|0x0091F0": "「力任せで行くわよっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x009218": "「リープ・スラッシャー、発射！」", "Battle/Dat/Battle/Message/047.bmd|0x009249": "「このまま突っ込む！」", "Battle/Dat/Battle/Message/047.bmd|0x00926B": "「リボルビング・バンカー！！」", "Battle/Dat/Battle/Message/047.bmd|0x009299": "「１発で終わりじゃないのよ！！」", "Battle/Dat/Battle/Message/047.bmd|0x0092CA": "「ブーストッ！」", "Battle/Dat/Battle/Message/047.bmd|0x0092E3": "「クレイモア！　受けなさい！」", "Battle/Dat/Battle/Message/047.bmd|0x009311": "「ええーいっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x00932D": "「そらそらそらそらーっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x009358": "「必殺！　リボルビング・バンカァァァッ！！」", "Battle/Dat/Battle/Message/047.bmd|0x00939B": "「この機体を安く見ない事ね！」", "Battle/Dat/Battle/Message/047.bmd|0x0093C9": "「ブレード・トンファー！　セット！」", "Battle/Dat/Battle/Message/047.bmd|0x009400": "「遠心力がかかってる分、痛いわよっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x00943D": "「ブレード・サイ、セット！」", "Battle/Dat/Battle/Message/047.bmd|0x009468": "「とどめぇっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x009484": "「さあ、ここからよ！！」", "Battle/Dat/Battle/Message/047.bmd|0x0094A9": "「出し惜しみなんて、しないんだから！！」", "Battle/Dat/Battle/Message/047.bmd|0x0094E6": "「まだ追い詰めるっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x00950B": "「ショートレンジ・モード！　受けなさい！」", "Battle/Dat/Battle/Message/047.bmd|0x00954B": "「ここは連射で！」", "Battle/Dat/Battle/Message/047.bmd|0x009567": "「プラズマ・ステーク！」", "Battle/Dat/Battle/Message/047.bmd|0x00958C": "「この拳を受けてみなさい！」", "Battle/Dat/Battle/Message/047.bmd|0x0095B7": "「ジェット・マグナム！　やああっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x0095F1": "「ジェット・マグナム！！」", "Battle/Dat/Battle/Message/047.bmd|0x009619": "「スプリットミサイル、発射！」", "Battle/Dat/Battle/Message/047.bmd|0x009647": "「２ＷＡＹライフル、ロングレンジ・モード！」", "Battle/Dat/Battle/Message/047.bmd|0x00968A": "「行っけぇぇぇぇ！！」", "Battle/Dat/Battle/Message/047.bmd|0x0096AC": "「ダブル・プラズマ・ステーク、セット！」", "Battle/Dat/Battle/Message/047.bmd|0x0096E9": "「ええいっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x009702": "「ジェット・マグナム！　受けなさい！！」", "Battle/Dat/Battle/Message/047.bmd|0x00973F": "「行けぇ！　メガ・ブラスターキャノン！！」", "Battle/Dat/Battle/Message/047.bmd|0x00977F": "「必殺の拳！　受けなさいっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x0097B0": "「ジェット・ファントム！！」", "Battle/Dat/Battle/Message/047.bmd|0x0097DB": "「ツイン・ビームカノン、発射！」", "Battle/Dat/Battle/Message/047.bmd|0x00980C": "「ダーク・ロック！　受けなさい！」", "Battle/Dat/Battle/Message/047.bmd|0x009840": "「もう片方！」", "Battle/Dat/Battle/Message/047.bmd|0x009856": "「まだまだぁっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x009875": "「ハイパー・ブーストナックル！」", "Battle/Dat/Battle/Message/047.bmd|0x0098A6": "「行っけぇぇぇっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x0098C8": "「ビーム・キャノン連動！」", "Battle/Dat/Battle/Message/047.bmd|0x0098F0": "「アルティメット・ビィィィィィム！！」", "Battle/Dat/Battle/Message/047.bmd|0x00992A": "「悪を断つ必殺剣、その名も……！」", "Battle/Dat/Battle/Message/047.bmd|0x00995E": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/047.bmd|0x009979": "「暗剣殺！！」", "Battle/Dat/Battle/Message/047.bmd|0x00998F": "「でやあああっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x0099AE": "「悪は必ず滅びるのよ！」", "Battle/Dat/Battle/Message/047.bmd|0x0099D3": "「これが壱式改の最終奥義よ……！」", "Battle/Dat/Battle/Message/047.bmd|0x009A07": "「五！」", "Battle/Dat/Battle/Message/047.bmd|0x009A14": "「黄！」", "Battle/Dat/Battle/Message/047.bmd|0x009A21": "「殺！！」", "Battle/Dat/Battle/Message/047.bmd|0x009A31": "「ええええーーーいっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x009A59": "「悪は朽ち果てるのみ！」", "Battle/Dat/Battle/Message/047.bmd|0x009A7E": "「ダブル・オメガレーザー、発射！」", "Battle/Dat/Battle/Message/047.bmd|0x009AB2": "「スパイラル・ブレイカー！」", "Battle/Dat/Battle/Message/047.bmd|0x009ADD": "「貫けぇぇっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x009AF9": "「オメガ・キャノン、発射！」", "Battle/Dat/Battle/Message/047.bmd|0x009B24": "「一斉射撃！　行けぇっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x009B4F": "「まだ終わりじゃないわよ！！」", "Battle/Dat/Battle/Message/047.bmd|0x009B7D": "「ＧラプターとＧバイソンのコンビネーション、/　見せてあげるわ！」", "Battle/Dat/Battle/Message/047.bmd|0x009BDF": "「ドリル・アタッカー！　受けなさい！！」", "Battle/Dat/Battle/Message/047.bmd|0x009C1C": "「参式、奥義！」", "Battle/Dat/Battle/Message/047.bmd|0x009C35": "「獅子王刀、歳破！！」", "Battle/Dat/Battle/Message/047.bmd|0x009C57": "「たあああああっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x009C79": "「悪！　即！　断！！」", "Battle/Dat/Battle/Message/047.bmd|0x009C9B": "「マイクロ・テスラ・ドライブ・ミサイル！」", "Battle/Dat/Battle/Message/047.bmd|0x009CDB": "「ＭＴＤ誘導弾、発射！」", "Battle/Dat/Battle/Message/047.bmd|0x009D00": "「何か撃つのが/　もったいないような気がするけど……！」", "Battle/Dat/Battle/Message/047.bmd|0x009D53": "「イルミネーター・リンク！」", "Battle/Dat/Battle/Message/047.bmd|0x009D7E": "「天空からの一撃！　受けなさい！！」", "Battle/Dat/Battle/Message/048.bmd|0x002B08": "「臆するな！　いくぞっ！」", "Battle/Dat/Battle/Message/048.bmd|0x002B30": "「本艦で仕留める！」", "Battle/Dat/Battle/Message/048.bmd|0x002B4F": "「総員、ぬかるなよ！」", "Battle/Dat/Battle/Message/048.bmd|0x002B71": "「あの敵は本艦で撃破する！」", "Battle/Dat/Battle/Message/048.bmd|0x002B9C": "「攻撃目標、メリオルエッセ！」", "Battle/Dat/Battle/Message/048.bmd|0x002BCA": "「メリオルエッセに仕掛けるぞ！」", "Battle/Dat/Battle/Message/048.bmd|0x002BFB": "「リー、お前は……！」", "Battle/Dat/Battle/Message/048.bmd|0x002C1D": "「あなたが力を以て、/　この世界を制するというのであれば……！」", "Battle/Dat/Battle/Message/048.bmd|0x002C7C": "「攻撃目標、ゲスト指揮官機！」", "Battle/Dat/Battle/Message/048.bmd|0x002CAA": "「本艦で指揮官機を撃破する！」", "Battle/Dat/Battle/Message/048.bmd|0x002CD8": "「これ以上、シュテドニアス軍の/　好きにはさせん……！」", "Battle/Dat/Battle/Message/048.bmd|0x002D2B": "「ゼゼーナン……もはやお前に逃げ場はない！」", "Battle/Dat/Battle/Message/048.bmd|0x002D6E": "「ガイアセイバーズの横暴を/　許す気はない……！」", "Battle/Dat/Battle/Message/048.bmd|0x002DB8": "「鋼龍戦隊の意地を見せてやる……！」", "Battle/Dat/Battle/Message/048.bmd|0x002DEF": "「ガイアセイバーズ……/　お前達の好きにさせるものか！」", "Battle/Dat/Battle/Message/048.bmd|0x002E42": "「どこの世界でも/　やることは同じというわけか……！」", "Battle/Dat/Battle/Message/048.bmd|0x002E92": "「この世界で/　再起を図るつもりだとでも言うのか……！」", "Battle/Dat/Battle/Message/048.bmd|0x002EE5": "「攻撃目標、エア・クリスマス！」", "Battle/Dat/Battle/Message/048.bmd|0x002F16": "「攻撃目標、セイバー１！」"}