{"Battle/Dat/Battle/Message/160.bmd|0x003446": "「効くものか！」", "Battle/Dat/Battle/Message/160.bmd|0x00345F": "「そんなもの！」", "Battle/Dat/Battle/Message/160.bmd|0x003478": "「………」", "Battle/Dat/Battle/Message/160.bmd|0x003488": "「弾切れだと！？」", "Battle/Dat/Battle/Message/160.bmd|0x0034A4": "「反撃できんとは！」", "Battle/Dat/Battle/Message/160.bmd|0x0034C3": "「くっ、これでは！」", "Battle/Dat/Battle/Message/160.bmd|0x0034E2": "「いったん後退するしかないか……！」", "Battle/Dat/Battle/Message/160.bmd|0x003519": "「奴め、どこへ行った！？」", "Battle/Dat/Battle/Message/160.bmd|0x003541": "「ちっ、見失うとは！」", "Battle/Dat/Battle/Message/160.bmd|0x003563": "「くっ、逃げ足の速い奴め……！」", "Battle/Dat/Battle/Message/160.bmd|0x003594": "「死角に入られたか！」", "Battle/Dat/Battle/Message/160.bmd|0x0035B6": "「援護する！」", "Battle/Dat/Battle/Message/160.bmd|0x0035CC": "「後に続くぞ！」", "Battle/Dat/Battle/Message/160.bmd|0x0035E5": "「後は任せろ！」", "Battle/Dat/Battle/Message/160.bmd|0x0035FE": "「いける！　もう一撃！」", "Battle/Dat/Battle/Message/160.bmd|0x003623": "「やらせん！」", "Battle/Dat/Battle/Message/160.bmd|0x003639": "「させるかっ！」", "Battle/Dat/Battle/Message/160.bmd|0x003652": "「ここは引き受ける！」", "Battle/Dat/Battle/Message/160.bmd|0x003674": "「覚悟してもらおうか！」", "Battle/Dat/Battle/Message/160.bmd|0x003699": "「まだだ！　もう一撃！」", "Battle/Dat/Battle/Message/160.bmd|0x0036BE": "「まだ終わりじゃないぞ！」", "Battle/Dat/Battle/Message/160.bmd|0x0036E6": "「まだまだっ！」", "Battle/Dat/Battle/Message/160.bmd|0x0036FF": "「もらう！」", "Battle/Dat/Battle/Message/160.bmd|0x003712": "「こいつをくらえ！」", "Battle/Dat/Battle/Message/160.bmd|0x003731": "「くらえ！」", "Battle/Dat/Battle/Message/160.bmd|0x003744": "「受けろ！」", "Battle/Dat/Battle/Message/160.bmd|0x003757": "「そこだ！」", "Battle/Dat/Battle/Message/160.bmd|0x00376A": "「落ちろ！」", "Battle/Dat/Battle/Message/160.bmd|0x00377D": "「はあっ！」", "Battle/Dat/Battle/Message/160.bmd|0x003790": "「おりゃあ！」", "Battle/Dat/Battle/Message/160.bmd|0x0037A6": "「たああっ！」", "Battle/Dat/Battle/Message/160.bmd|0x0037BC": "「むんっ！」", "Battle/Dat/Battle/Message/160.bmd|0x0037CF": "「当ててやる！」", "Battle/Dat/Battle/Message/160.bmd|0x0037E8": "「機銃座、撃ち方始め！」", "Battle/Dat/Battle/Message/160.bmd|0x00380D": "「対空機銃、撃て！」", "Battle/Dat/Battle/Message/160.bmd|0x00382C": "「高射砲、発射用意！　撃て！」", "Battle/Dat/Battle/Message/160.bmd|0x00385A": "「高射砲、１番、２番！　撃て！」", "Battle/Dat/Battle/Message/160.bmd|0x00388B": "「前部全砲塔、発射用意！　撃て！」", "Battle/Dat/Battle/Message/160.bmd|0x0038BF": "「前部砲塔、一斉射撃！　撃て！」", "Battle/Dat/Battle/Message/160.bmd|0x0038F0": "「バリオン・ビーム砲、発射用意！」", "Battle/Dat/Battle/Message/160.bmd|0x003924": "「撃て！」", "Battle/Dat/Battle/Message/160.bmd|0x003934": "「主砲、発射用意！」", "Battle/Dat/Battle/Message/161.bmd|0x002340": "「やってみせる！」", "Battle/Dat/Battle/Message/161.bmd|0x00235C": "「よし、狙いはついた！」", "Battle/Dat/Battle/Message/161.bmd|0x002381": "「仕掛ける！」", "Battle/Dat/Battle/Message/161.bmd|0x002397": "「行くぞ、地上人！」", "Battle/Dat/Battle/Message/161.bmd|0x0023B6": "「ラングランに与する地上人め！」", "Battle/Dat/Battle/Message/161.bmd|0x0023E7": "「地上人の好きにはやらせん！」", "Battle/Dat/Battle/Message/161.bmd|0x002415": "「地上のメカなどに！」", "Battle/Dat/Battle/Message/161.bmd|0x002437": "「行くぞ、サイバスター！」", "Battle/Dat/Battle/Message/161.bmd|0x00245F": "「サイバスターを落とせば、/　最上の手柄になる！」", "Battle/Dat/Battle/Message/161.bmd|0x0024A9": "「魔装機神が相手でも！」", "Battle/Dat/Battle/Message/161.bmd|0x0024CE": "「魔装機神を仕留めれば、大手柄だ！」", "Battle/Dat/Battle/Message/161.bmd|0x002505": "「魔装機神……数でかかれば何とかなる！」", "Battle/Dat/Battle/Message/161.bmd|0x002542": "「グランヴェール……仕留めてやるさ！」", "Battle/Dat/Battle/Message/161.bmd|0x00257C": "「ガッデス……落としてみせる！」", "Battle/Dat/Battle/Message/161.bmd|0x0025AD": "「ラングランの魔装機など！」", "Battle/Dat/Battle/Message/161.bmd|0x0025D8": "「ラングランめ、好きにはやらせんぞ！」", "Battle/Dat/Battle/Message/161.bmd|0x002612": "「打倒ラングラン！　行くぞ！」", "Battle/Dat/Battle/Message/161.bmd|0x002640": "「こっちからも行くぞ！」", "Battle/Dat/Battle/Message/161.bmd|0x002665": "「反撃開始！」", "Battle/Dat/Battle/Message/161.bmd|0x00267B": "「今度はこっちの番だ！」", "Battle/Dat/Battle/Message/161.bmd|0x0026A0": "「ただでは帰さん！」", "Battle/Dat/Battle/Message/161.bmd|0x0026BF": "「次はこちらから行くぞ！」", "Battle/Dat/Battle/Message/161.bmd|0x0026E7": "「まだここからだ！」", "Battle/Dat/Battle/Message/161.bmd|0x002706": "「うわああっ！！」", "Battle/Dat/Battle/Message/161.bmd|0x002722": "「こ、ここまでか！」", "Battle/Dat/Battle/Message/161.bmd|0x002741": "「だ、脱出を！」", "Battle/Dat/Battle/Message/161.bmd|0x00275A": "「おのれ、おのれぇっ！！」", "Battle/Dat/Battle/Message/161.bmd|0x002782": "「し、しまった！！」", "Battle/Dat/Battle/Message/161.bmd|0x0027A1": "「こ、これ以上は！！」", "Battle/Dat/Battle/Message/161.bmd|0x0027C3": "「ぐああっ！　何だ、これは！？」", "Battle/Dat/Battle/Message/161.bmd|0x0027F4": "「ま、まずい！　このままでは！」", "Battle/Dat/Battle/Message/161.bmd|0x002825": "「ええい、まだ退けんのだ！！」", "Battle/Dat/Battle/Message/161.bmd|0x002853": "「いかん、シールドのパワーが低下している！」", "Battle/Dat/Battle/Message/161.bmd|0x002896": "「ぐううっ！　こ、これではもたん！」", "Battle/Dat/Battle/Message/161.bmd|0x0028CD": "「うぐっ！　奴め、何というパワーなんだ！」", "Battle/Dat/Battle/Message/161.bmd|0x00290D": "「くうっ！　祖国のためにも、/　ここで退くわけには！」", "Battle/Dat/Battle/Message/161.bmd|0x00295D": "「うぐっ！/　まだ決着はついていないぞ、地上人！」", "Battle/Dat/Battle/Message/161.bmd|0x0029A7": "「あ、あの地上人には敵わないのか……！？」", "Battle/Dat/Battle/Message/161.bmd|0x0029E7": "「何なんだ、あの地上のメカは！！」", "Battle/Dat/Battle/Message/161.bmd|0x002A1B": "「ス、スピードもパワーも/　サイバスターには敵わない！」", "Battle/Dat/Battle/Message/161.bmd|0x002A6E": "「お、おのれ、サイバスターめ！！」", "Battle/Dat/Battle/Message/161.bmd|0x002AA2": "「こ、これが魔装機神の力なのか！！」", "Battle/Dat/Battle/Message/161.bmd|0x002AD9": "「ま、魔装機神……やはり、あれは危険だ！」", "Battle/Dat/Battle/Message/161.bmd|0x002B19": "「駄目だ、グランヴェールを止められん！！」", "Battle/Dat/Battle/Message/161.bmd|0x002B59": "「ほ、炎の魔装機神……/　その名は伊達ではないな……！」", "Battle/Dat/Battle/Message/161.bmd|0x002BAC": "「ガ、ガッデス……強過ぎる！」", "Battle/Dat/Battle/Message/161.bmd|0x002BDA": "「な、何としてもここでガッデスを……！！」", "Battle/Dat/Battle/Message/161.bmd|0x002C1A": "「ぐっ！　直撃か！」", "Battle/Dat/Battle/Message/161.bmd|0x002C39": "「ま、まともに当てられた！？」", "Battle/Dat/Battle/Message/161.bmd|0x002C67": "「まだだ、まだやられてはいない！」", "Battle/Dat/Battle/Message/161.bmd|0x002C9B": "「ぐうっ！　よくも！！」", "Battle/Dat/Battle/Message/161.bmd|0x002CC0": "「う、動きが読まれているのか！？」", "Battle/Dat/Battle/Message/161.bmd|0x002CF4": "「ううっ、油断したか……！」", "Battle/Dat/Battle/Message/161.bmd|0x002D1F": "「何っ！？　パワー負けしているのか！？」", "Battle/Dat/Battle/Message/161.bmd|0x002D5C": "「やってくれたな、地上人！！」", "Battle/Dat/Battle/Message/161.bmd|0x002D8A": "「うぐっ！　地上人め、よくも！」", "Battle/Dat/Battle/Message/161.bmd|0x002DBB": "「地上人に後れを取るとは……！」", "Battle/Dat/Battle/Message/161.bmd|0x002DEC": "「サイバスターめ、何てスピードなんだ！」", "Battle/Dat/Battle/Message/161.bmd|0x002E29": "「な、何としてもサイバスターを……！！」", "Battle/Dat/Battle/Message/161.bmd|0x002E66": "「さ、さすがだな、魔装機神！」", "Battle/Dat/Battle/Message/161.bmd|0x002E94": "「魔装機神相手に油断したつもりは……！」", "Battle/Dat/Battle/Message/161.bmd|0x002ED1": "「グ、グランヴェール……奴の火力は！」", "Battle/Dat/Battle/Message/161.bmd|0x002F0B": "「せめて、/　グランヴェールの足止めだけでも……！」", "Battle/Dat/Battle/Message/161.bmd|0x002F58": "「ガ、ガッデスめ、やってくれる！」", "Battle/Dat/Battle/Message/161.bmd|0x002F8C": "「ガッデスを止められんとは……！」", "Battle/Dat/Battle/Message/161.bmd|0x002FC0": "「チッ、回避し損なったか！」", "Battle/Dat/Battle/Message/161.bmd|0x002FEB": "「当たっただけだ！」", "Battle/Dat/Battle/Message/161.bmd|0x00300A": "「こんなもの、ダメージの内に入らん！」", "Battle/Dat/Battle/Message/161.bmd|0x003044": "「ふん、それがどうしたと言うのだ！」", "Battle/Dat/Battle/Message/161.bmd|0x00307B": "「何の、かすっただけだ！」", "Battle/Dat/Battle/Message/161.bmd|0x0030A3": "「それで我らを止める気か！」", "Battle/Dat/Battle/Message/161.bmd|0x0030CE": "「我らシュテドニアスを/　甘く見てもらっては困る！」", "Battle/Dat/Battle/Message/161.bmd|0x00311B": "「地上人め、やるな！」", "Battle/Dat/Battle/Message/161.bmd|0x00313D": "「調子に乗るなよ、地上人！」", "Battle/Dat/Battle/Message/161.bmd|0x003168": "「ふん、地上では/　それで通用していたのかも知れんが……」", "Battle/Dat/Battle/Message/161.bmd|0x0031BE": "「ハッ！　スピードだけか、サイバスター！」", "Battle/Dat/Battle/Message/161.bmd|0x0031FE": "「サイバスター……噂ほどではないな」", "Battle/Dat/Battle/Message/161.bmd|0x003235": "「大したことはないな、魔装機神も」"}