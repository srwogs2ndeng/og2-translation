{"Battle/Dat/Battle/Message/126.bmd|0x001CA5": "「次は僕の番だ」", "Battle/Dat/Battle/Message/126.bmd|0x001CBE": "「くうっ！　よくも！」", "Battle/Dat/Battle/Message/126.bmd|0x001CE0": "「チッ、ここまでか！」", "Battle/Dat/Battle/Message/126.bmd|0x001D02": "「ぼ、僕は何度でも甦る！/　甦るはずなんだぁぁ！！」", "Battle/Dat/Battle/Message/126.bmd|0x001D4F": "「目障りだな、どこまでも……！」", "Battle/Dat/Battle/Message/126.bmd|0x001D80": "「許し難い存在だ、君達は……！」", "Battle/Dat/Battle/Message/126.bmd|0x001DB1": "「抹消してやる……その存在を必ず……！」", "Battle/Dat/Battle/Message/126.bmd|0x001DEE": "「アルタルフをここまで押し込むとはね……！」", "Battle/Dat/Battle/Message/126.bmd|0x001E31": "「どう抗おうと君達の運命は変わらない……！」", "Battle/Dat/Battle/Message/126.bmd|0x001E74": "「ちっ、しつこい連中だ……！」", "Battle/Dat/Battle/Message/126.bmd|0x001EA2": "「詰めが甘いね、イング……！」", "Battle/Dat/Battle/Message/126.bmd|0x001ED0": "「許してやるさ、イング。ここまではね……！」", "Battle/Dat/Battle/Message/126.bmd|0x001F13": "「くっ！/　コピーがオリジナルを上回るなどと……！」", "Battle/Dat/Battle/Message/126.bmd|0x001F60": "「これがイングの力だと……馬鹿な！」", "Battle/Dat/Battle/Message/126.bmd|0x001F97": "「ゼンガー……/　あの時と同じようにいくと思うな……！」", "Battle/Dat/Battle/Message/126.bmd|0x001FEA": "「イデアラントが/　マシンナリー・チルドレンを/　超えるなどと……！」", "Battle/Dat/Battle/Message/126.bmd|0x002050": "「ブロンゾ２８……君ごときに！」", "Battle/Dat/Battle/Message/126.bmd|0x002081": "「チッ、壊れた人形の分際で！」", "Battle/Dat/Battle/Message/126.bmd|0x0020AF": "「これぐらいは想定内さ」", "Battle/Dat/Battle/Message/126.bmd|0x0020D4": "「フフフ、面白くなってきたよ」", "Battle/Dat/Battle/Message/126.bmd|0x002102": "「さすがだと言っておこうか」", "Battle/Dat/Battle/Message/126.bmd|0x00212D": "「しぶといな、やはり」", "Battle/Dat/Battle/Message/126.bmd|0x00214F": "「そんなもので、このアルタルフは倒せない」", "Battle/Dat/Battle/Message/126.bmd|0x00218F": "「ふん、反逆者の分際で……」", "Battle/Dat/Battle/Message/126.bmd|0x0021BA": "「フッ、やるじゃないか、イング」", "Battle/Dat/Battle/Message/126.bmd|0x0021EB": "「次はどうするつもりだ、イング？」", "Battle/Dat/Battle/Message/126.bmd|0x00221F": "「イング……お前だけは……！」", "Battle/Dat/Battle/Message/126.bmd|0x00224D": "「くっ、コピーの分際で……！」", "Battle/Dat/Battle/Message/126.bmd|0x00227B": "「どうした、ゼンガー？/　手を抜いているのか？」", "Battle/Dat/Battle/Message/126.bmd|0x0022C2": "「イデアラントごときが……！」", "Battle/Dat/Battle/Message/126.bmd|0x0022F0": "「ブーステッド・チルドレンが……/　調子に乗るな！」", "Battle/Dat/Battle/Message/126.bmd|0x00233D": "「人形ごときがよくも……！」", "Battle/Dat/Battle/Message/126.bmd|0x002368": "「ほう、僕のアルタルフに食いついたか」", "Battle/Dat/Battle/Message/126.bmd|0x0023A2": "「以前より弱体化しているね」", "Battle/Dat/Battle/Message/126.bmd|0x0023CD": "「このぐらいは構わないさ」", "Battle/Dat/Battle/Message/126.bmd|0x0023F5": "「もう少しやると思っていたけどね」", "Battle/Dat/Battle/Message/126.bmd|0x002429": "「ある意味懐かしいね、この感覚は」", "Battle/Dat/Battle/Message/126.bmd|0x00245D": "「しばらくの間、付き合ってやるか……」", "Battle/Dat/Battle/Message/126.bmd|0x002497": "「非力だな、イング」", "Battle/Dat/Battle/Message/126.bmd|0x0024B6": "「もっと抵抗してみせろ、イング」", "Battle/Dat/Battle/Message/126.bmd|0x0024E7": "「オリジナルである僕に楯突くか……！」", "Battle/Dat/Battle/Message/126.bmd|0x002521": "「イング……お前が僕を上回るなどと……！」", "Battle/Dat/Battle/Message/126.bmd|0x002561": "「受け止めたぞ、ゼンガー」", "Battle/Dat/Battle/Message/126.bmd|0x002589": "「アリエイル……それで終わりかい？」", "Battle/Dat/Battle/Message/126.bmd|0x0025C0": "「やるじゃないか、ブロンゾ２８」", "Battle/Dat/Battle/Message/126.bmd|0x0025F1": "「生意気な人形め……」", "Battle/Dat/Battle/Message/126.bmd|0x002613": "「学習能力が低いね」", "Battle/Dat/Battle/Message/126.bmd|0x002632": "「僕のアルタルフを捉えることは出来ない」", "Battle/Dat/Battle/Message/126.bmd|0x00266F": "「ふん、人形などに……」", "Battle/Dat/Battle/Message/126.bmd|0x002694": "「イング……やはり、お前はその程度だ」", "Battle/Dat/Battle/Message/126.bmd|0x0026CE": "「つまらない相手だ」", "Battle/Dat/Battle/Message/126.bmd|0x0026ED": "「それで終わりかい？」", "Battle/Dat/Battle/Message/126.bmd|0x00270F": "「君達の能力は、そんなものだったかな？」", "Battle/Dat/Battle/Message/126.bmd|0x00274C": "「どうした、イング？」", "Battle/Dat/Battle/Message/126.bmd|0x00276E": "「お前にも断てぬものがあるんだよ」", "Battle/Dat/Battle/Message/126.bmd|0x0027A2": "「所詮、イデアラントはそんなものか」", "Battle/Dat/Battle/Message/126.bmd|0x0027D9": "「成長していないね、ブロンゾ２８」", "Battle/Dat/Battle/Message/126.bmd|0x00280D": "「無駄だよ」", "Battle/Dat/Battle/Message/126.bmd|0x002820": "「その手は通用しない」", "Battle/Dat/Battle/Message/126.bmd|0x002842": "「フッ、愚かな」", "Battle/Dat/Battle/Message/126.bmd|0x00285B": "「………」", "Battle/Dat/Battle/Message/126.bmd|0x00286B": "「反撃不能か。まあいい」", "Battle/Dat/Battle/Message/126.bmd|0x002890": "「しばしの生を楽しむんだね」", "Battle/Dat/Battle/Message/126.bmd|0x0028BB": "「逃げ足が早いね」", "Battle/Dat/Battle/Message/126.bmd|0x0028D7": "「すぐに見つけ出してやるさ」", "Battle/Dat/Battle/Message/126.bmd|0x002902": "「ふん、ロストしたか」", "Battle/Dat/Battle/Message/126.bmd|0x002924": "「見逃すわけにはいかないな」", "Battle/Dat/Battle/Message/126.bmd|0x00294F": "「まだ終わりじゃないよ」", "Battle/Dat/Battle/Message/126.bmd|0x002974": "「詰めが甘いな、アーマラ」", "Battle/Dat/Battle/Message/126.bmd|0x00299C": "「手伝ってやるよ、ドゥバン・オーグ」", "Battle/Dat/Battle/Message/126.bmd|0x0029D3": "「手加減でもしているのか、アルベロ？」", "Battle/Dat/Battle/Message/126.bmd|0x002A0D": "「そうはいかないのさ！」", "Battle/Dat/Battle/Message/126.bmd|0x002A32": "「駒が減るのはあまり良くないからね」", "Battle/Dat/Battle/Message/126.bmd|0x002A69": "「まだそんな所にいたのか」", "Battle/Dat/Battle/Message/126.bmd|0x002A91": "「フッ……僕を待っていたのかい？」", "Battle/Dat/Battle/Message/126.bmd|0x002AC5": "「レベル２、ピックアップ！」", "Battle/Dat/Battle/Message/126.bmd|0x002AF0": "「ダブル・ガナリー、Ｗモード！」", "Battle/Dat/Battle/Message/126.bmd|0x002B21": "「飛べ、アルタルフ！」", "Battle/Dat/Battle/Message/126.bmd|0x002B43": "「愚かな敵を討て！」", "Battle/Dat/Battle/Message/126.bmd|0x002B62": "「レベル２、ピックアップ」", "Battle/Dat/Battle/Message/126.bmd|0x002B8A": "「Ｗモード！」", "Battle/Dat/Battle/Message/126.bmd|0x002BA0": "「カーバー、アクティブ！」", "Battle/Dat/Battle/Message/126.bmd|0x002BC8": "「レベル３、ピックアップ！」", "Battle/Dat/Battle/Message/126.bmd|0x002BF3": "「アルタルフ、それは終焉を意味する！」", "Battle/Dat/Battle/Message/127.bmd|0x002291": "「お前を……狩る！」", "Battle/Dat/Battle/Message/127.bmd|0x0022B0": "「エンゲージ……！」", "Battle/Dat/Battle/Message/127.bmd|0x0022CF": "「獲物は……お前だ！」", "Battle/Dat/Battle/Message/127.bmd|0x0022F1": "「会敵……！」", "Battle/Dat/Battle/Message/127.bmd|0x002307": "「エンカウント……！」", "Battle/Dat/Battle/Message/127.bmd|0x002329": "「黒焔の狩人……その力を思い知れ！」", "Battle/Dat/Battle/Message/127.bmd|0x002360": "「行くぞ、ガリルナガン……！」", "Battle/Dat/Battle/Message/127.bmd|0x00238E": "「ガリルナガン……仕掛けるぞ！」", "Battle/Dat/Battle/Message/127.bmd|0x0023BF": "「ハイ・パーソナルトルーパーの力を、/　見せてやる！」", "Battle/Dat/Battle/Message/127.bmd|0x00240F": "「イング、お前の力を見せてみろ……！」", "Battle/Dat/Battle/Message/127.bmd|0x002449": "「フフフ……力を発揮しなければ、死ぬぞ」", "Battle/Dat/Battle/Message/127.bmd|0x002486": "「イング……生か死か、好きな方を選べ！」", "Battle/Dat/Battle/Message/127.bmd|0x0024C3": "「アルテウル様に逆らう愚か者が！」", "Battle/Dat/Battle/Message/127.bmd|0x0024F7": "「壊してやるよ、イング！」", "Battle/Dat/Battle/Message/127.bmd|0x00251F": "「破壊する！　お前も、その機体もな！」", "Battle/Dat/Battle/Message/127.bmd|0x002559": "「イング！　本性を出したか！」", "Battle/Dat/Battle/Message/127.bmd|0x002587": "「その力、試してやる！」", "Battle/Dat/Battle/Message/127.bmd|0x0025AC": "「アリエイル・オーグ……裏切り者が！」", "Battle/Dat/Battle/Message/127.bmd|0x0025E6": "「お前の寿命を早めてやるよ！」", "Battle/Dat/Battle/Message/127.bmd|0x002614": "「裏切り者は、処刑あるのみ！」", "Battle/Dat/Battle/Message/127.bmd|0x002642": "「ＳＲＸチーム……お前達は用済みだ」", "Battle/Dat/Battle/Message/127.bmd|0x002679": "「用済みの駒は始末しなければな」", "Battle/Dat/Battle/Message/127.bmd|0x0026AA": "「ＳＲＸチーム……/　アルテウル様の邪魔はさせんぞ」", "Battle/Dat/Battle/Message/127.bmd|0x0026F7": "「お前にわかるか、私の正体が？」", "Battle/Dat/Battle/Message/127.bmd|0x002728": "「繰り糸が切れた人形は、始末しなければな」", "Battle/Dat/Battle/Message/127.bmd|0x002768": "「本当の主が誰か、わかっているか？」", "Battle/Dat/Battle/Message/127.bmd|0x00279F": "「お前も凶鳥の後を追うがいい！」", "Battle/Dat/Battle/Message/127.bmd|0x0027D0": "「踊れ、鋼龍戦隊。あの方の掌中で」", "Battle/Dat/Battle/Message/127.bmd|0x002804": "「お前達も駒の一つに過ぎん……！」", "Battle/Dat/Battle/Message/127.bmd|0x002838": "「私は、アルテウル様の剣……！」", "Battle/Dat/Battle/Message/127.bmd|0x002869": "「フッ、そんな継ぎ接ぎだらけの機体で！」", "Battle/Dat/Battle/Message/127.bmd|0x0028A6": "「凶鳥が何度甦ろうと、/　このガリルナガンで狩ってやる！」", "Battle/Dat/Battle/Message/127.bmd|0x0028FC": "「凶鳥は黒焔に灼かれる！　それが運命だ！」", "Battle/Dat/Battle/Message/127.bmd|0x00293C": "「ＳＲＸ……無様なマシンだな」", "Battle/Dat/Battle/Message/127.bmd|0x00296A": "「お前達の技術レベルでは、/　その程度の仕上がりか」", "Battle/Dat/Battle/Message/127.bmd|0x0029B7": "　　　"}