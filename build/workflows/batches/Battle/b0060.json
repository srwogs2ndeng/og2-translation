{"Battle/Dat/Battle/Message/040.bmd|0x00C6D6": "「クスハ、無理すんな！」", "Battle/Dat/Battle/Message/040.bmd|0x00C6FB": "「マサキ、今の内に！」", "Battle/Dat/Battle/Message/040.bmd|0x00C71D": "「何やってんだ、アラド！」", "Battle/Dat/Battle/Message/040.bmd|0x00C745": "「キョウスケ中尉、危ねえっ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C773": "「エクセレン少尉、下がってくれ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C7A7": "「コウタ、後ろに下がれ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C7CF": "「下がれ、アリエイル！」", "Battle/Dat/Battle/Message/040.bmd|0x00C7F4": "「ヒューゴ少尉、ここは任せろ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C825": "「アクア少尉、離脱してくれ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C853": "「下がれ、ジョッシュ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C878": "「リム、無理すんな！」", "Battle/Dat/Battle/Message/040.bmd|0x00C89A": "「ここは退け、トウマ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C8BF": "「下がれ、イング！」", "Battle/Dat/Battle/Message/040.bmd|0x00C8DE": "「ミチル、やせ我慢すんな！」", "Battle/Dat/Battle/Message/040.bmd|0x00C909": "「危ねえぞ、ミオ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C928": "「もう一発くらいやがれ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C950": "「ここからさらに押し込む！」", "Battle/Dat/Battle/Message/040.bmd|0x00C97B": "「このチャンス、逃がさねえ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C9A9": "「スプリットミサイル、発射！」", "Battle/Dat/Battle/Message/040.bmd|0x00C9D7": "「くらえ、くらえ、くらえぇぇっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CA0E": "「決めてやるぜ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CA2D": "「くらいやがれっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CA4F": "「うおおぉっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CA6B": "「くらえ！　Ｔ‐ＬＩＮＫナッコォ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CAA5": "「念動拳……！　Ｔ‐ＬＩＮＫナッコォ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CAE5": "「受けろ！　必殺！！/　Ｔ‐ＬＩＮＫナッコォ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CB2F": "「一撃粉砕！　鉄拳制裁！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CB5A": "「破ぁぁっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CB73": "「念動集中……！」", "Battle/Dat/Battle/Message/040.bmd|0x00CB8F": "「天上天下、念動破砕剣！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CBBA": "「超必殺……！」", "Battle/Dat/Battle/Message/040.bmd|0x00CBD3": "「Ｔ‐ＬＩＮＫソォォーード！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CC04": "「破を念じて……刃となれ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CC32": "「二人とも、フォーメーションＲで行くわよ！」", "Battle/Dat/Battle/Message/040.bmd|0x00CC75": "「了解です、大尉」", "Battle/Dat/Battle/Message/040.bmd|0x00CC91": "「よっしゃ！　行くぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00CCB6": "「ハイゾルランチャー、シューッ！」", "Battle/Dat/Battle/Message/040.bmd|0x00CCEA": "「ストライクシールド！」", "Battle/Dat/Battle/Message/040.bmd|0x00CD0F": "「チェェーーンジ！　Ｒ‐ウィング！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CD49": "「完全に捉えたぞ！」", "Battle/Dat/Battle/Message/040.bmd|0x00CD68": "「今よ！　リュウ！」", "Battle/Dat/Battle/Message/040.bmd|0x00CD87": "「うおおおおっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CDA6": "「Ｔ‐ＬＩＮＫ！/　クラッシュソォォォォドッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CDF0": "「Ｇ・リボルヴァーキャノン！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CE21": "「リボルヴァーキャノン！/　ランダムシューーッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CE6E": "「俺の狙いから逃げられるものか！」", "Battle/Dat/Battle/Message/040.bmd|0x00CEA2": "「照準セェット！　ファイア！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CED3": "「ガウン・ジェノサイダァーーーッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CF0D": "「念動波……ガウン・ジェノサイダー！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CF4A": "「そこだっ！/　ハイフィンガーランチャー！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CF8E": "「くらえ！　ブレード・キィィック！！」", "Battle/Dat/Battle/Message/040.bmd|0x00CFC8": "「はあああ……っ！」", "Battle/Dat/Battle/Message/040.bmd|0x00CFE7": "「念動結界……！　ドミニオン・ボール！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D027": "「砕け！　ドミニオン・ボーール！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D05E": "「Ｔ‐ＬＩＮＫ、フルコンタクト……！」", "Battle/Dat/Battle/Message/040.bmd|0x00D098": "「出力全開！」", "Battle/Dat/Battle/Message/040.bmd|0x00D0AE": "「Ｚ・Ｏ・ソード、射出！」", "Battle/Dat/Battle/Message/040.bmd|0x00D0D6": "「トロニウム・エンジン、フルドライブ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D116": "「全てを斬り裂け、ＳＲＸ！」", "Battle/Dat/Battle/Message/040.bmd|0x00D141": "「はあああっ！」", "Battle/Dat/Battle/Message/040.bmd|0x00D15A": "「超必殺！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D170": "「天上天下……念動！　爆砕剣！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D1A4": "「念動爆砕！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D1BD": "「行くぜ、隊長！」", "Battle/Dat/Battle/Message/040.bmd|0x00D1D9": "「ええ」", "Battle/Dat/Battle/Message/040.bmd|0x00D1E6": "「システムコネクト！　隊長、後は私が！」", "Battle/Dat/Battle/Message/040.bmd|0x00D223": "「任せるわ、アヤ」", "Battle/Dat/Battle/Message/040.bmd|0x00D23F": "「Ｔ‐ＬＩＮＫフルコンタクト！/　メタルジェノサイダーモード、起動！」", "Battle/Dat/Battle/Message/040.bmd|0x00D2A7": "「トロニウム・エンジン、フルドライブ！」", "Battle/Dat/Battle/Message/040.bmd|0x00D2E4": "「リュウ、トリガーを！」", "Battle/Dat/Battle/Message/040.bmd|0x00D309": "「くらえ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D31F": "「一撃必殺！　バスタァァァァキャノンッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D362": "「行くぞ、みんな！」", "Battle/Dat/Battle/Message/040.bmd|0x00D381": "「了解した」", "Battle/Dat/Battle/Message/040.bmd|0x00D394": "「システムコネクト……！　マイ、行くわよ！」", "Battle/Dat/Battle/Message/040.bmd|0x00D3D7": "「わかった、アヤ……！/　Ｔ‐ＬＩＮＫツインコンタクト！」", "Battle/Dat/Battle/Message/040.bmd|0x00D42D": "「メタルジェノサイダーモード、起動！」", "Battle/Dat/Battle/Message/040.bmd|0x00D467": "「リュウ、トリガーを預けるわ！」", "Battle/Dat/Battle/Message/040.bmd|0x00D498": "「おう！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D4AB": "「くらえ！　天下無敵の……！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D4DC": "「一撃必殺砲ぉぉっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D501": "「コールドメタルブレード！」", "Battle/Dat/Battle/Message/040.bmd|0x00D52C": "「切り裂け！　コールドメタルブレード！」", "Battle/Dat/Battle/Message/040.bmd|0x00D569": "「ＨＧ・リボルヴァー！　ファイア！」", "Battle/Dat/Battle/Message/040.bmd|0x00D5A0": "「ヘビージャイアント・リボルヴァー！」", "Battle/Dat/Battle/Message/040.bmd|0x00D5DA": "「ハイグレード・リボルヴァー！」", "Battle/Dat/Battle/Message/040.bmd|0x00D60B": "「照準セット！」", "Battle/Dat/Battle/Message/040.bmd|0x00D624": "「ブーステッド・ライホゥ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D652": "「行くぞ！　必殺っ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D677": "「Ｔ‐ＬＩＮＫブレードナッコォ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D6AE": "「オラオラオラァーッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D6D6": "「オォォラァッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D6F5": "「Ｔ‐ＬＩＮＫ！　ブレードナッコォッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D735": "「念動集中……！　うおおぉぉっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D76C": "「オラオラオラオラオラァーッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D7A0": "「切り裂け！　Ｔ‐ＬＩＮＫブレェェェド！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D7E3": "「ＡＲＴ‐１の超コンボ、見せてやるぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00D820": "「まずはこいつをくらえっ！」", "Battle/Dat/Battle/Message/040.bmd|0x00D84B": "「ＨＧ・リボルヴァー！/　ランダムシューッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D892": "「ＡＲＴ‐１、/　チェェンジ、ＡＲＴ‐ウィング！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D8DF": "「とっておきのコンボ技、受けてみやがれ！」", "Battle/Dat/Battle/Message/040.bmd|0x00D91F": "「行くぞ！　ブーステッド・ライホゥ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D95C": "「次だ！　ＨＧ・リボルヴァー！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D990": "「チェェェンジ！　ＡＲＴ‐ウィング！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D9CD": "「本命はここからだっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00D9F5": "「とどめだ！　天上天下念動破砕剣！！」", "Battle/Dat/Battle/Message/040.bmd|0x00DA2F": "「こいつで決めてやる！！」", "Battle/Dat/Battle/Message/040.bmd|0x00DA57": "「マイ、念動連撃拳で行くぞ！」", "Battle/Dat/Battle/Message/040.bmd|0x00DA85": "「うん！」", "Battle/Dat/Battle/Message/040.bmd|0x00DA95": "「Ｔ‐ＬＩＮＫナッコォッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00DAC3": "「ええいっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00DADC": "「よっしゃあ！　続けて行くぞ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00DB10": "「これで決めてみせる！」", "Battle/Dat/Battle/Message/040.bmd|0x00DB35": "「リュウ！」", "Battle/Dat/Battle/Message/040.bmd|0x00DB48": "「ああ！　いくぜぇっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00DB70": "「Ｔ‐ＬＩＮＫダブルナッコォォッ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00DBAA": "「うおおおおおおっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00DBCF": "「こうなったら、こいつを使うしかねえ！」", "Battle/Dat/Battle/Message/040.bmd|0x00DC0C": "「いっけぇぇぇっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00DC2E": "「アングリフ・マックスファイヤー！！」"}