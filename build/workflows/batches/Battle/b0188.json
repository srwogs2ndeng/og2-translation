{"Battle/Dat/Battle/Message/106.bmd|0x0086E0": "「アリエイル、ここは任せろ！」", "Battle/Dat/Battle/Message/106.bmd|0x00870E": "「下がるんだ、コウタ！」", "Battle/Dat/Battle/Message/106.bmd|0x008733": "「もう一撃！」", "Battle/Dat/Battle/Message/106.bmd|0x008749": "「まだ行ける！」", "Battle/Dat/Battle/Message/106.bmd|0x008762": "「覚悟してもらう！」", "Battle/Dat/Battle/Message/106.bmd|0x008781": "「当たれよ！」", "Battle/Dat/Battle/Message/106.bmd|0x008797": "「そこだ！」", "Battle/Dat/Battle/Message/106.bmd|0x0087AA": "「落ちろ！」", "Battle/Dat/Battle/Message/106.bmd|0x0087BD": "「当ててみせるさ！」", "Battle/Dat/Battle/Message/106.bmd|0x0087DC": "「このぉ！」", "Battle/Dat/Battle/Message/106.bmd|0x0087EF": "「俺だって、これぐらいは！」", "Battle/Dat/Battle/Message/106.bmd|0x00881A": "「ソードとシールドの組み合わせで！」", "Battle/Dat/Battle/Message/106.bmd|0x008851": "「ええいっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x00886A": "「ビーム・ラム！！」", "Battle/Dat/Battle/Message/106.bmd|0x008889": "「サイファー・ソード！　シールド！」", "Battle/Dat/Battle/Message/106.bmd|0x0088C0": "「うおおっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x0088D9": "「まだまだっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x0088F5": "「サイファー・ソード！」", "Battle/Dat/Battle/Message/106.bmd|0x00891A": "「ビーム・ラム！　貫けっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008948": "「インパルス・キャノン、セット！」", "Battle/Dat/Battle/Message/106.bmd|0x00897C": "「行けぇぇぇっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x00899B": "「こいつで仕留める！」", "Battle/Dat/Battle/Message/106.bmd|0x0089BD": "「インパルス・キャノン！！」", "Battle/Dat/Battle/Message/106.bmd|0x0089E8": "「もらったぞ！」", "Battle/Dat/Battle/Message/106.bmd|0x008A01": "「これで決めてやる！」", "Battle/Dat/Battle/Message/106.bmd|0x008A23": "「グラビティ・ボード！」", "Battle/Dat/Battle/Message/106.bmd|0x008A48": "「バースト・レイヴならば！」", "Battle/Dat/Battle/Message/106.bmd|0x008A73": "「サイファー・ガン！　くらえぇっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008AAD": "「うおおおおっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008ACC": "「とどめだ！」", "Battle/Dat/Battle/Message/106.bmd|0x008AE2": "「でええええいっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008B04": "「ガン・モード、連射！」", "Battle/Dat/Battle/Message/106.bmd|0x008B29": "「これで！」", "Battle/Dat/Battle/Message/106.bmd|0x008B3C": "「終わりだぁぁぁっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008B61": "「威力は前より上がっているんだ！」", "Battle/Dat/Battle/Message/106.bmd|0x008B95": "「くらえぇぇっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008BB4": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/106.bmd|0x008BD9": "「直撃させる！」", "Battle/Dat/Battle/Message/106.bmd|0x008BF2": "「ネオ・インパルス・キャノン！」", "Battle/Dat/Battle/Message/106.bmd|0x008C23": "「シュンパティア、ＲＣファンクション！」", "Battle/Dat/Battle/Message/106.bmd|0x008C60": "「ブレード・ビット！」", "Battle/Dat/Battle/Message/106.bmd|0x008C82": "「行けっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008C98": "「ビット射出！」", "Battle/Dat/Battle/Message/106.bmd|0x008CB1": "「頼んだぞ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008CCA": "「追い詰めろ！」", "Battle/Dat/Battle/Message/106.bmd|0x008CE3": "「ネオ・サイファー・ソード、セット！」", "Battle/Dat/Battle/Message/106.bmd|0x008D1D": "「ブレード！」", "Battle/Dat/Battle/Message/106.bmd|0x008D33": "「意外に取り回しが利くのさ……！」", "Battle/Dat/Battle/Message/106.bmd|0x008D67": "「この大きさでもな！」", "Battle/Dat/Battle/Message/106.bmd|0x008D89": "「捉えた！」", "Battle/Dat/Battle/Message/106.bmd|0x008D9C": "「ブーストッ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008DB8": "「うおおおおお！！」", "Battle/Dat/Battle/Message/106.bmd|0x008DD7": "「切り裂けぇぇ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008DF6": "「逃がさん！」", "Battle/Dat/Battle/Message/106.bmd|0x008E0C": "「これで決める！」", "Battle/Dat/Battle/Message/106.bmd|0x008E28": "「ガン・モード！　行けっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008E56": "「これで仕留める！」", "Battle/Dat/Battle/Message/106.bmd|0x008E75": "「ネオ・サイファー・ガン！」", "Battle/Dat/Battle/Message/106.bmd|0x008EA0": "「次はこっちだ！」", "Battle/Dat/Battle/Message/106.bmd|0x008EBC": "「クロー・アンカー！」", "Battle/Dat/Battle/Message/106.bmd|0x008EDE": "「おおおおっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008EFA": "「今だ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008F0D": "「行けぇっ！！」", "Battle/Dat/Battle/Message/106.bmd|0x008F26": "「ブレード！　エクステンション！！」", "Battle/Dat/Battle/Message/106.bmd|0x008F5D": "「クロー・アンカー、セット！」", "Battle/Dat/Battle/Message/106.