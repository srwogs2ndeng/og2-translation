{"Battle/Dat/Battle/Message/070.bmd|0x004693": "「チッ、しまった……！」", "Battle/Dat/Battle/Message/070.bmd|0x0046B8": "「うおっ！　こ、このままでは……！」", "Battle/Dat/Battle/Message/070.bmd|0x0046EF": "「やる！　予想以上の力だな……」", "Battle/Dat/Battle/Message/070.bmd|0x004720": "「くっ、読みが甘かったか！」", "Battle/Dat/Battle/Message/070.bmd|0x00474B": "「うっ！　直撃をくらったか……！」", "Battle/Dat/Battle/Message/070.bmd|0x00477F": "「うっ……！/　だがこの程度ならまだいける……！」", "Battle/Dat/Battle/Message/070.bmd|0x0047C9": "「やるっ……！　だが！」", "Battle/Dat/Battle/Message/070.bmd|0x0047EE": "「うっ！　こいつは油断できんな……」", "Battle/Dat/Battle/Message/070.bmd|0x004825": "「くっ！　やるな……/　だが、そう簡単にはやらせん！」", "Battle/Dat/Battle/Message/070.bmd|0x004875": "「まだだ！　まだ落ちはしない！」", "Battle/Dat/Battle/Message/070.bmd|0x0048A6": "「うっ！　ま、まだやらせん！」", "Battle/Dat/Battle/Message/070.bmd|0x0048D4": "「うぉっ！？　くっ、少しは効いたな……」", "Battle/Dat/Battle/Message/070.bmd|0x004911": "「チッ、意外とやるな……！」", "Battle/Dat/Battle/Message/070.bmd|0x00493C": "「その程度か？」", "Battle/Dat/Battle/Message/070.bmd|0x004955": "「少しは効いたな……」", "Battle/Dat/Battle/Message/070.bmd|0x004977": "「いい腕をしているが……/　ただ当てただけではな」", "Battle/Dat/Battle/Message/070.bmd|0x0049C1": "「まだまだだな」", "Battle/Dat/Battle/Message/070.bmd|0x0049DA": "「フッ、出直して来るんだな」", "Battle/Dat/Battle/Message/070.bmd|0x004A05": "「どうした？　そんなものか」", "Battle/Dat/Battle/Message/070.bmd|0x004A30": "「効かないな」", "Battle/Dat/Battle/Message/070.bmd|0x004A46": "「お前の動きは、手に取るようにわかるのさ！」", "Battle/Dat/Battle/Message/070.bmd|0x004A89": "「甘いな！」", "Battle/Dat/Battle/Message/070.bmd|0x004A9C": "「当たりはしない！」", "Battle/Dat/Battle/Message/070.bmd|0x004ABB": "「当たらないな」", "Battle/Dat/Battle/Message/070.bmd|0x004AD4": "「貴様の攻撃パターンなど、お見通しさ！」", "Battle/Dat/Battle/Message/070.bmd|0x004B11": "「フッ、愚かな……」", "Battle/Dat/Battle/Message/070.bmd|0x004B30": "「予測通りの攻撃パターンだ」", "Battle/Dat/Battle/Message/070.bmd|0x004B5B": "「残念だが、当たりはしない」", "Battle/Dat/Battle/Message/070.bmd|0x004B86": "「このゲシュペンストを、/　ただのパーソナルトルーパーと思うな」", "Battle/Dat/Battle/Message/070.bmd|0x004BE5": "「フッ、量産型とはわけが違うのさ」", "Battle/Dat/Battle/Message/070.bmd|0x004C19": "「こちらもインスペクター戦で/　経験を積んでいるのでな」", "Battle/Dat/Battle/Message/070.bmd|0x004C6C": "「インスペクターと同じく、我々を侮り過ぎだ」", "Battle/Dat/Battle/Message/070.bmd|0x004CAF": "「お前はこの世界へ来るべきではなかった」", "Battle/Dat/Battle/Message/070.bmd|0x004CEC": "「超機人と言えど、一定のパターンがあるな」", "Battle/Dat/Battle/Message/070.bmd|0x004D2C": "「教導隊の人間を甘く見ないでもらおうか」", "Battle/Dat/Battle/Message/070.bmd|0x004D69": "「どうした、俺はここだぞ！」", "Battle/Dat/Battle/Message/070.bmd|0x004D94": "「隙があるな。人の姿を持つが故に」", "Battle/Dat/Battle/Message/070.bmd|0x004DC8": "「それで俺に恐怖を与えることは出来ん」", "Battle/Dat/Battle/Message/070.bmd|0x004E02": "「時の運にも見放されたな、ゼゼーナン」", "Battle/Dat/Battle/Message/070.bmd|0x004E3C": "「それで終わりか、光龍」", "Battle/Dat/Battle/Message/070.bmd|0x004E61": "「四凶の力は、その程度か」", "Battle/Dat/Battle/Message/070.bmd|0x004E89": "「そう……俺には結末が見えている」", "Battle/Dat/Battle/Message/070.bmd|0x004EBD": "「封印されるべきはお前の方だ、ガンエデン」", "Battle/Dat/Battle/Message/070.bmd|0x004EFD": "「まだ早い……その時ではない、ユーゼス」", "Battle/Dat/Battle/Message/070.bmd|0x004F3A": "「結末は同じだぞ、ユーゼス・ゴッツォ」", "Battle/Dat/Battle/Message/070.bmd|0x004F74": "「一刻も早くクロスゲートを/　封印しなければ……！」", "Battle/Dat/Battle/Message/070.bmd|0x004FC1": "「無駄だ！」", "Battle/Dat/Battle/Message/070.bmd|0x004FD4": "「ジャマー発動！」", "Battle/Dat/Battle/Message/070.bmd|0x004FF0": "「ミサイルは効かないのさ！」", "Battle/Dat/Battle/Message/070.bmd|0x00501B": "「………」", "Battle/Dat/Battle/Message/070.bmd|0x00502B": "「しまった！　弾切れか！」", "Battle/Dat/Battle/Message/070.bmd|0x005053": "「この距離では、どうしようもないか……」", "Battle/Dat/Battle/Message/070.bmd|0x005090": "「しまった……！」", "Battle/Dat/Battle/Message/070.bmd|0x0050AC": "「援護する！」", "Battle/Dat/Battle/Message/070.bmd|0x0050C2": "「離脱し損なったか……！　行くぞ！」", "Battle/Dat/Battle/Message/070.bmd|0x0050F9": "「これで決める！」", "Battle/Dat/Battle/Message/070.bmd|0x005115": "「まだ終わりじゃないのさ！」", "Battle/Dat/Battle/Message/070.bmd|0x005140": "「レーツェル、援護する！」", "Battle/Dat/Battle/Message/070.bmd|0x005168": "「フ……昔と同じ連携の呼吸だな」", "Battle/Dat/Battle/Message/070.bmd|0x005199": "「このコンビネーション……身体が覚えている」", "Battle/Dat/Battle/Message/070.bmd|0x0051DC": "「続けて行くぞ、ゼンガー！」", "Battle/Dat/Battle/Message/070.bmd|0x005207": "「カイ少佐、援護します！」", "Battle/Dat/Battle/Message/070.bmd|0x00522F": "「援護するぞ、イルム」", "Battle/Dat/Battle/Message/070.bmd|0x005251": "「マサキ……後は任せてもらおう」", "Battle/Dat/Battle/Message/070.bmd|0x005282": "「ラミア、続けて行くぞ！」", "Battle/Dat/Battle/Message/070.bmd|0x0052AA": "「援護するぞ、キョウスケ中尉！」", "Battle/Dat/Battle/Message/070.bmd|0x0052DB": "「ヴィレッタ、後は任せてもらおう」", "Battle/Dat/Battle/Message/070.bmd|0x00530F": "「ヴィレッタ、俺がバックアップする！」", "Battle/Dat/Battle/Message/070.bmd|0x005349": "「リューネ、援護するぞ」", "Battle/Dat/Battle/Message/070.bmd|0x00536E": "「アラド、前に出過ぎるな！」", "Battle/Dat/Battle/Message/070.bmd|0x005399": "「コウタ、後は俺に任せるのだ」", "Battle/Dat/Battle/Message/070.bmd|0x0053C7": "「続けて行くぞ、ラウル！」", "Battle/Dat/Battle/Message/070.bmd|0x0053EF": "「フィオナ、後は俺が！」", "Battle/Dat/Battle/Message/070.bmd|0x005414": "「アリエイル、援護する！」", "Battle/Dat/Battle/Message/070.bmd|0x00543C": "「イング、後は任せるのだ」", "Battle/Dat/Battle/Message/070.bmd|0x005464": "「ヒューゴ、援護する！」", "Battle/Dat/Battle/Message/070.bmd|0x005489": "「アクア、後は任せたまえ」", "Battle/Dat/Battle/Message/070.bmd|0x0054B1": "「ジョッシュ、援護する！」", "Battle/Dat/Battle/Message/070.bmd|0x0054D9": "「リム、後は私が引き受ける！」", "Battle/Dat/Battle/Message/070.bmd|0x005507": "「今の内に離脱するのだ！」", "Battle/Dat/Battle/Message/070.bmd|0x00552F": "「そう簡単にはやらせん！」", "Battle/Dat/Battle/Message/070.bmd|0x005557": "「終わらせるわけにはいかないのでな！」", "Battle/Dat/Battle/Message/070.bmd|0x005591": "「ゼンガー、ここは俺に任せろ！」", "Battle/Dat/Battle/Message/070.bmd|0x0055C2": "「カイ少佐、早く離脱を！」", "Battle/Dat/Battle/Message/070.bmd|0x0055EA": "「マサキ、下がれ！」", "Battle/Dat/Battle/Message/070.bmd|0x005609": "「退くのだ、レーツェル！」", "Battle/Dat/Battle/Message/070.bmd|0x005631": "「ヴィレッタ、あの敵は俺に任せろ！」", "Battle/Dat/Battle/Message/070.bmd|0x005668": "「リューネ、早く後退するのだ！」", "Battle/Dat/Battle/Message/070.bmd|0x005699": "「下がれ、ラウル！」", "Battle/Dat/Battle/Message/070.bmd|0x0056B8": "「フィオナ、無理は禁物だ！」", "Battle/Dat/Battle/Message/070.bmd|0x0056E3": "「やはり、そう固まったか。ならば！」", "Battle/Dat/Battle/Message/070.bmd|0x00571A": "「これでどうだっ！」", "Battle/Dat/Battle/Message/070.bmd|0x005739": "「いただく！」", "Battle/Dat/Battle/Message/070.bmd|0x00574F": "「まだ行ける！」", "Battle/Dat/Battle/Message/070.bmd|0x005768": "「もう一撃！」", "Battle/Dat/Battle/Message/070.bmd|0x00577E": "「この機を逃しはしないのさ！」", "Battle/Dat/Battle/Message/070.bmd|0x0057AC": "「スプリットミサイル、発射！」", "Battle/Dat/Battle/Message/070.bmd|0x0057DA": "「くらえっ！」", "Battle/Dat/Battle/Message/070.bmd|0x0057F0": "「とどめだ！」", "Battle/Dat/Battle/Message/070.bmd|0x005806": "「もう逃げられんぞ！」", "Battle/Dat/Battle/Message/070.bmd|0x005828": "「そこだ！」", "Battle/Dat/Battle/Message/070.bmd|0x00583B": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/070.bmd|0x005860": "「落ちてもらう！」", "Battle/Dat/Battle/Message/070.bmd|0x00587C": "「いくぞっ！」", "Battle/Dat/Battle/Message/070.bmd|0x005892": "「悪いが、そちらのエネルギーをいただくぞ！」", "Battle/Dat/Battle/Message/070.bmd|0x0058D5": "「ヴァンピーア・レーザー、照射！」", "Battle/Dat/Battle/Message/070.bmd|0x005909": "「読み通りの所へ来たな……！」", "Battle/Dat/Battle/Message/070.bmd|0x005937": "「メガ・バスターキャノン、発射！」", "Battle/Dat/Battle/Message/070.bmd|0x00596B": "「出力調整完了……照準固定！」", "Battle/Dat/Battle/Message/070.bmd|0x005999": "「受けよ、メガ・バスターキャノン！」", "Battle/Dat/Battle/Message/070.bmd|0x0059D0": "「キャパシタ、開放！　インサイト！」", "Battle/Dat/Battle/Message/070.bmd|0x005A07": "「メガ・バスターキャノン、シュート！」", "Battle/Dat/Battle/Message/070.bmd|0x005A41": "「お前の動きは読めた……！」", "Battle/Dat/Battle/Message/070.bmd|0x005A6C": "「落ちろ！！」", "Battle/Dat/Battle/Message/070.bmd|0x005A82": "「はあっ！」", "Battle/Dat/Battle/Message/070.bmd|0x005A95": "「砕け散れ！」", "Battle/Dat/Battle/Message/070.bmd|0x005AAB": "「敵モーションパターン予測……！」", "Battle/Dat/Battle/Message/070.bmd|0x005ADF": "「ターゲットは全て捕捉した……！　行くぞ！」", "Battle/Dat/Battle/Message/070.bmd|0x005B22": "「照準、誤差修正……トリガーオープン！」", "Battle/Dat/Battle/Message/070.bmd|0x005B5F": "「くらえ！！」"}