{"Battle/Dat/Battle/Message/107.bmd|0x009FFF": "「当たれぇぇぇっ！！」", "Battle/Dat/Battle/Message/107.bmd|0x00A021": "「このっ！　落ちろ！」", "Battle/Dat/Battle/Message/107.bmd|0x00A043": "「落ちろぉぉぉぉっ！！」", "Battle/Dat/Battle/Message/107.bmd|0x00A068": "「シュンパティア、ＲＣファンクション！」", "Battle/Dat/Battle/Message/107.bmd|0x00A0A5": "「アクティブ・ビット！」", "Battle/Dat/Battle/Message/107.bmd|0x00A0CA": "「お願いね！」", "Battle/Dat/Battle/Message/107.bmd|0x00A0E0": "「ビット射出！」", "Battle/Dat/Battle/Message/107.bmd|0x00A0F9": "「頼んだわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x00A112": "「これでぇっ！！」", "Battle/Dat/Battle/Message/107.bmd|0x00A12E": "「行っけぇぇっ！！」", "Battle/Dat/Battle/Message/107.bmd|0x00A14D": "「ブレード、アクティブ！」", "Battle/Dat/Battle/Message/107.bmd|0x00A175": "「エミッション！」", "Battle/Dat/Battle/Message/107.bmd|0x00A191": "「さあ、行くわよ！/　デア・ブランシュネージュ！」", "Battle/Dat/Battle/Message/107.bmd|0x00A1DB": "「この子は格闘戦も出来るのよ！」", "Battle/Dat/Battle/Message/107.bmd|0x00A20C": "「ブレード、エミッション！」", "Battle/Dat/Battle/Message/107.bmd|0x00A237": "「さあ、やるわよ！/　デア・ブランシュネージュ！」", "Battle/Dat/Battle/Message/107.bmd|0x00A281": "「ガーディアン・ブレード！」", "Battle/Dat/Battle/Message/107.bmd|0x00A2AC": "「ええーーいっ！！」", "Battle/Dat/Battle/Message/107.bmd|0x00A2CB": "「たああーーーっ！！」", "Battle/Dat/Battle/Message/107.bmd|0x00A2ED": "「レイヴ・レーザー！」", "Battle/Dat/Battle/Message/107.bmd|0x00A30F": "「レース・アルカーナ、出力上昇！」", "Battle/Dat/Battle/Message/107.bmd|0x00A343": "「ブースト！」", "Battle/Dat/Battle/Message/107.bmd|0x00A359": "「捉えたわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x00A372": "「ヴェクター・ミサイル！」", "Battle/Dat/Battle/Message/107.bmd|0x00A39A": "「行けぇっ！！」", "Battle/Dat/Battle/Message/107.bmd|0x00A3B3": "「エクセルシオ・アルスノーヴァの力、/　見せてあげるわ！」", "Battle/Dat/Battle/Message/107.bmd|0x00A409": "「次はこれよ！」", "Battle/Dat/Battle/Message/107.bmd|0x00A422": "「アクティブ・ビット！　アタック！」", "Battle/Dat/Battle/Message/107.bmd|0x00A459": "「まだまだっ！」", "Battle/Dat/Battle/Message/107.bmd|0x00A472": "「バレル・オープン！」", "Battle/Dat/Battle/Message/107.bmd|0x00A494": "（シュンパティア、/　ＬＢファンクション……！）", "Battle/Dat/Battle/Message/107.bmd|0x00A4DB": "（リアナ、私も……）", "Battle/Dat/Battle/Message/107.bmd|0x00A4FA": "「行っけぇぇぇ！！」", "Battle/Dat/Battle/Message/107.bmd|0x00A519": "「ニュートロン・バスタァァァァッ！！」", "Battle/Dat/Battle/Message/107.bmd|0x00A553": "「まだ終わらないっ！」", "Battle/Dat/Battle/Message/107.bmd|0x00A575": "（シュンパティア、あたしに力を……！）", "Battle/Dat/Battle/Message/107.bmd|0x00A5AF": "（私もリアナに……）", "Battle/Dat/Battle/Message/107.bmd|0x00A5CE": "「ニュートロン・バスター！！」", "Battle/Dat/Battle/Message/107.bmd|0x00A5FC": "「これで決めるっ！！」", "Battle/Dat/Battle/Message/107.bmd|0x00A61E": "（クリス……あたしを見守っていて……）", "Battle/Dat/Battle/Message/107.bmd|0x00A658": "（クリス……あたしは挫けない……）", "Battle/Dat/Battle/Message/108.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/109.bmd|0x000F99": "「貴様達の死も苦しみも、全て我らの糧とせん」", "Battle/Dat/Battle/Message/109.bmd|0x000FDC": "「貴様達の希望とするもの全て……/　この俺が打ち砕く！」", "Battle/Dat/Battle/Message/109.bmd|0x00102F": "「恐怖の中で死ぬがいい」", "Battle/Dat/Battle/Message/109.bmd|0x001054": "「貴様達に抗えるか、この“破滅”の力に」", "Battle/Dat/Battle/Message/109.bmd|0x001091": "「貴様達の意思……この俺が叩き潰す！！」", "Battle/Dat/Battle/Message/109.bmd|0x0010CE": "「恐怖と絶望の内に滅びよ」", "Battle/Dat/Battle/Message/109.bmd|0x0010F6": "「このアクイラが、お前達の命を打ち砕く！」", "Battle/Dat/Battle/Message/109.bmd|0x001136": "「貴様達を待つのは、“破滅”の運命のみ……」", "Battle/Dat/Battle/Message/109.bmd|0x001179": "「人間、お前のマシーンは目障りだ」", "Battle/Dat/Battle/Message/109.bmd|0x0011AD": "「そのマシーン、システム……破壊する」", "Battle/Dat/Battle/Message/109.bmd|0x0011E7": "「人間……お前とそのマシーンは他と違うな」", "Battle/Dat/Battle/Message/109.bmd|0x001227": "「ふむ、人間……お前は……」", "Battle/Dat/Battle/Message/109.bmd|0x001252": "「人間であろうがなかろうが、/　“破滅”の運命からは逃れられん」", "Battle/Dat/Battle/Message/109.bmd|0x0012B1": "「お前も人間と共に滅びろ」", "Battle/Dat/Battle/Message/109.bmd|0x0012D9": "「容赦はせん。人間と運命を共にしろ」", "Battle/Dat/Battle/Message/109.bmd|0x001310": "「面白い。この俺の攻撃が、受けられるか」", "Battle/Dat/Battle/Message/109.bmd|0x00134D": "「フン……逃がしはせんぞ」", "Battle/Dat/Battle/Message/109.bmd|0x001375": "「これがかわせるか」", "Battle/Dat/Battle/Message/109.bmd|0x001394": "「貴様達の運命は決まっている」", "Battle/Dat/Battle/Message/109.bmd|0x0013C2": "「ふふふ……/　貴様達は、いずれ絶望に辿り着く……！」", "Battle/Dat/Battle/Message/109.bmd|0x001412": "「この俺を破るか……！」", "Battle/Dat/Battle/Message/109.bmd|0x001437": "「変わらんぞ、貴様達の運命はな……！」", "Battle/Dat/Battle/Message/109.bmd|0x001471": "「ぬう……この俺相手に、ここまでやるとはな」", "Battle/Dat/Battle/Message/109.bmd|0x0014B4": "「貴様達がその憎悪を糧に戦う限り、/　我らには勝てぬ……！」", "Battle/Dat/Battle/Message/109.bmd|0x00150D": "「くっ、なおもこれほどの力があるか……！」", "Battle/Dat/Battle/Message/109.bmd|0x00154D": "「ふふふ……/　よかろう、全力で打ち砕いてやる！」", "Battle/Dat/Battle/Message/109.bmd|0x001597": "「面白い……/　どこまで抗えるか、この俺に見せてみろ！」", "Battle/Dat/Battle/Message/109.bmd|0x0015EA": "「これが“破滅”に抗うお前達の力か……」", "Battle/Dat/Battle/Message/109.bmd|0x001627": "「ふむ……やるな」", "Battle/Dat/Battle/Message/109.bmd|0x001643": "「お前達にある希望……全て叩き潰してくれる」", "Battle/Dat/Battle/Message/109.bmd|0x001686": "「ふん、相手をする価値はあるようだな」", "Battle/Dat/Battle/Message/109.bmd|0x0016C0": "「そうだ……そうやって、あがき続けろ！」", "Battle/Dat/Battle/Message/109.bmd|0x0016FD": "「なるほど……この力……面白い」", "Battle/Dat/Battle/Message/109.bmd|0x00172E": "「あのマシーン……潰さねばならんな」", "Battle/Dat/Battle/Message/109.bmd|0x001765": "「ふん、この程度か」", "Battle/Dat/Battle/Message/109.bmd|0x001784": "「そう、そのあがきが絶望を呼ぶ」", "Battle/Dat/Battle/Message/109.bmd|0x0017B5": "「当てるだけでは、どうにもならん」", "Battle/Dat/Battle/Message/109.bmd|0x0017E9": "「そうだ……/　もっとあがけ、あがいてみせろ」", "Battle/Dat/Battle/Message/109.bmd|0x00182D": "「やはり、そのシステムは……」", "Battle/Dat/Battle/Message/109.bmd|0x00185B": "「“破滅”の運命には、抗えぬぞ」", "Battle/Dat/Battle/Message/109.bmd|0x00188C": "「見えるぞ……貴様達の恐怖が」", "Battle/Dat/Battle/Message/109.bmd|0x0018BA": "「無駄を繰り返し、絶望に辿り着くがよい」", "Battle/Dat/Battle/Message/109.bmd|0x0018F7": "「この俺を倒すことなど出来んのだ」", "Battle/Dat/Battle/Message/109.bmd|0x00192B": "「ふん、それでこの俺を倒すつもりか」", "Battle/Dat/Battle/Message/109.bmd|0x001962": "「………」", "Battle/Dat/Battle/Message/109.bmd|0x001972": "「ふん、戦いが長引き過ぎたか」", "Battle/Dat/Battle/Message/109.bmd|0x0019A0": "「俺を恐れているな……？」", "Battle/Dat/Battle/Message/109.bmd|0x0019C8": "「お前の恐怖……俺には見えるぞ」", "Battle/Dat/Battle/Message/109.bmd|0x0019F9": "「この俺が相手になってやる」", "Battle/Dat/Battle/Message/109.bmd|0x001A24": "「これで終わりだ」", "Battle/Dat/Battle/Message/109.bmd|0x001A40": "「やむを得んな」", "Battle/Dat/Battle/Message/109.bmd|0x001A59": "「やらせん！」", "Battle/Dat/Battle/Message/109.bmd|0x001A6F": "「さらなる恐怖を与えてやる」", "Battle/Dat/Battle/Message/109.bmd|0x001A9A": "「お前の苦しみは、まだ終わらん」", "Battle/Dat/Battle/Message/109.bmd|0x001ACB": "「行くぞ……！」", "Battle/Dat/Battle/Message/109.bmd|0x001AE4": "「受けるがいい、我が力を！」", "Battle/Dat/Battle/Message/109.bmd|0x001B0F": "「貴様の命、絶望の中で！」", "Battle/Dat/Battle/Message/109.bmd|0x001B37": "「消し去ってくれる！」", "Battle/Dat/Battle/Message/109.bmd|0x001B59": "「さあ、怒りと憎しみを込めて！」", "Battle/Dat/Battle/Message/109.bmd|0x001B8A": "「我が名を呼ぶがいい！」", "Battle/Dat/Battle/Message/109.bmd|0x001BAF": "「このフォルティス・アーラが、/　貴様達を屠る！」", "Battle/Dat/Battle/Message/109.bmd|0x001BF9": "「さあ、受け入れよ！　“破滅”の運命を！」", "Battle/Dat/Battle/Message/109.bmd|0x001C39": "「さあ、憎悪と共に心へ刻め！」", "Battle/Dat/Battle/Message/109.bmd|0x001C67": "「この俺の名を！！」", "Battle/Dat/Battle/Message/109.bmd|0x001C86": "「心に刻め、この俺の名を！」", "Battle/Dat/Battle/Message/109.bmd|0x001CB1": "「その恐怖、その憎悪と共に！！」", "Battle/Dat/Battle/Message/110.bmd|0x00151B": "「このイグニスが、/　貴様を絶望の中へ叩き落としてやるよ！」", "Battle/Dat/Battle/Message/110.bmd|0x001574": "「死して、我らルイーナと/　“破滅の王”の糧となれ！」", "Battle/Dat/Battle/Message/110.bmd|0x0015C4": "「クククッ、己の弱さを恨め！」", "Battle/Dat/Battle/Message/110.bmd|0x0015F2": "「メリオルエッセ、/　イグニスがお前達を滅ぼす！」", "Battle/Dat/Battle/Message/110.bmd|0x00163C": "「クククッ、貴様の中に恐怖を刻んでやるよ」", "Battle/Dat/Battle/Message/110.bmd|0x00167C": "「さあ、恐怖し、憎悪しろ！」", "Battle/Dat/Battle/Message/110.bmd|0x0016A7": "「ハハハッ、苦しんで死ね！」", "Battle/Dat/Battle/Message/110.bmd|0x0016D2": "「さあ、負の感情の波動を、我らに！」", "Battle/Dat/Battle/Message/110.bmd|0x001709": "「この俺に、怒りを、憎しみを抱け！」", "Battle/Dat/Battle/Message/110.bmd|0x001740": "「ほう、面白いな、そのマシーン」", "Battle/Dat/Battle/Message/110.bmd|0x001771": "「人間め、ラキに何をした？」", "Battle/Dat/Battle/Message/110.bmd|0x00179C": "「人間、貴様はここで死ねよ！」"}