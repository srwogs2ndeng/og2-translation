{"Battle/Dat/Battle/Message/060.bmd|0x00EECB": "「でぇいっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EEE4": "「まだまだまだぁっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EF09": "「マグナムの次は！」", "Battle/Dat/Battle/Message/060.bmd|0x00EF28": "「ファントムで決まりだぁぁっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EF5C": "「メガ・ブラスターキャノン！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EF8D": "「ラプター必殺！」", "Battle/Dat/Battle/Message/060.bmd|0x00EFA9": "「ブレード・サイ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EFCB": "「ぶった斬ってやるぜぇぇぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EFFF": "「とどめだっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F01B": "「ブレード・サイ、セット！」", "Battle/Dat/Battle/Message/060.bmd|0x00F046": "「くらえぇぇぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F068": "「ラプター、変形だ！」", "Battle/Dat/Battle/Message/060.bmd|0x00F08A": "「くらえ、くらえ、くらえぇぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F0C1": "「こいつも持ってけぇぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F0EF": "「ダーク・ロック！」", "Battle/Dat/Battle/Message/060.bmd|0x00F10E": "「もう一発！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F127": "「ハイパー・ブーストナックル！」", "Battle/Dat/Battle/Message/060.bmd|0x00F158": "「飛べぇぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F174": "「数撃ちゃ当たるんだよ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F19F": "「突撃ぃぃぃっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F1BE": "「スパイラル・ブレイカー！」", "Battle/Dat/Battle/Message/060.bmd|0x00F1E9": "「ツイン・ビームキャノンだっ！」", "Battle/Dat/Battle/Message/060.bmd|0x00F21A": "「ビーム・キャノン、連動！」", "Battle/Dat/Battle/Message/060.bmd|0x00F245": "「アルティメット・ビーム！/　行っけぇぇぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F28F": "「グルンガスト改、必殺！」", "Battle/Dat/Battle/Message/060.bmd|0x00F2B7": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F2D2": "「天中殺！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F2E8": "「こいつで真っ二つにしてやるぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00F31C": "「暗剣殺！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F332": "「もとい、暗剣殺っ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F357": "「これでどうだ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F376": "「でええええいっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F398": "「どいつもこいつもバッサリだぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00F3CC": "「グルンガスト改、超必殺！」", "Battle/Dat/Battle/Message/060.bmd|0x00F3F7": "「五！」", "Battle/Dat/Battle/Message/060.bmd|0x00F404": "「黄！」", "Battle/Dat/Battle/Message/060.bmd|0x00F411": "「殺！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F421": "「３！」", "Battle/Dat/Battle/Message/060.bmd|0x00F42E": "「２！」", "Battle/Dat/Battle/Message/060.bmd|0x00F43B": "「１！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F44B": "「斬っ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F45E": "「どんなもんだ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F47D": "「凶星、来たぁぁぁぁぁっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F4AB": "「タイマン勝負、どんなもんだ！」", "Battle/Dat/Battle/Message/060.bmd|0x00F4DC": "「コンビネーション・アタックだ！」", "Battle/Dat/Battle/Message/060.bmd|0x00F510": "「締めはドリル・アタッカー！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F541": "「こいつが参式の必殺剣だ！」", "Battle/Dat/Battle/Message/060.bmd|0x00F56C": "「獅子王刀、歳破！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F58E": "「決まったぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00F5A7": "「このミサイルは外すわけにはいかねえ！」", "Battle/Dat/Battle/Message/060.bmd|0x00F5E4": "「頼むから、当たってくれよ！　マジで！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F624": "「ＭＴＤ誘導弾、行けぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00F652": "「こいつに気づいた時は、もう手遅れだ！」", "Battle/Dat/Battle/Message/060.bmd|0x00F68F": "「フリー・エレクトロン・キャノン！/　発射ぁぁ！！」", "Battle/Dat/Battle/Message/061.bmd|0x004F02": "「行くわよっ！」", "Battle/Dat/Battle/Message/061.bmd|0x004F1B": "「先手必勝なんだから！」", "Battle/Dat/Battle/Message/061.bmd|0x004F40": "「邪魔しないで！」", "Battle/Dat/Battle/Message/061.bmd|0x004F5C": "「このまま一気にっ！」", "Battle/Dat/Battle/Message/061.bmd|0x004F7E": "「もう怒ったわよっ！」", "Battle/Dat/Battle/Message/061.bmd|0x004FA0": "「訓練の成果を、見せてあげるわ！」", "Battle/Dat/Battle/Message/061.bmd|0x004FD4": "「もらったわ！」", "Battle/Dat/Battle/Message/061.bmd|0x004FED": "「当ててみせる！」", "Battle/Dat/Battle/Message/061.bmd|0x005009": "「さあ、覚悟しなさい！」", "Battle/Dat/Battle/Message/061.bmd|0x00502E": "「あなた達なんかに負けるもんですか！」", "Battle/Dat/Battle/Message/061.bmd|0x005068": "「ゼオラ・シュバイツァー、行きますっ！」", "Battle/Dat/Battle/Message/061.bmd|0x0050A5": "「落としてみせるっ！」", "Battle/Dat/Battle/Message/061.bmd|0x0050C7": "「ビルトファルケン、行くわよっ！」", "Battle/Dat/Battle/Message/061.bmd|0x0050FB": "「仕掛けるわよ、ファルケン！」", "Battle/Dat/Battle/Message/061.bmd|0x005129": "「行くわよ、ファルケン！」", "Battle/Dat/Battle/Message/061.bmd|0x005151": "「ファルケンの力、見せてあげるわ！」", "Battle/Dat/Battle/Message/061.bmd|0x005188": "「ファルケンのスピード、/　思い知らせてあげる！」", "Battle/Dat/Battle/Message/061.bmd|0x0051D2": "「ビルトビルガー、行くわよ！」", "Battle/Dat/Battle/Message/061.bmd|0x005200": "「仕掛けるわよ、ビルガー！」", "Battle/Dat/Battle/Message/061.bmd|0x00522B": "「行くわよ、エグレッタ！」", "Battle/Dat/Battle/Message/061.bmd|0x005253": "「あなた、しつこいのよ！」", "Battle/Dat/Battle/Message/061.bmd|0x00527B": "「観念しなさい、エグレッタ！」", "Battle/Dat/Battle/Message/061.bmd|0x0052A9": "「シエンヌ……/　私もここで退くわけにはいかない！」", "Battle/Dat/Battle/Message/061.bmd|0x0052F6": "「行くわよ、シエンヌ……！」", "Battle/Dat/Battle/Message/061.bmd|0x005321": "「アルジャン・クラスの子と/　戦うことになるなんて……！」", "Battle/Dat/Battle/Message/061.bmd|0x005377": "「お互い、/　ここまで生き残ってきたって言うのに……！」", "Battle/Dat/Battle/Message/061.bmd|0x0053CA": "「シアン……/　あなた達に負けるわけにはいかない！」", "Battle/Dat/Battle/Message/061.bmd|0x005417": "「シオ、退く気はないのね……！」", "Battle/Dat/Battle/Message/061.bmd|0x005448": "「ターゲット、アレス・ガイスト……！」", "Battle/Dat/Battle/Message/061.bmd|0x005482": "「行くわよ、ドゥバン・オーグ！」", "Battle/Dat/Battle/Message/061.bmd|0x0054B3": "「ドゥバン！　あなたをここで止める！」", "Battle/Dat/Battle/Message/061.bmd|0x0054ED": "「観念しなさい、アルテウル！」", "Battle/Dat/Battle/Message/061.bmd|0x00551B": "「行くわよ、イグニス！」", "Battle/Dat/Battle/Message/061.bmd|0x005540": "「勝負よ、メリオルエッセ！」", "Battle/Dat/Battle/Message/061.bmd|0x00556B": "「メリオルエッセ……/　あなた達が何を企もうと！」", "Battle/Dat/Battle/Message/061.bmd|0x0055B5": "「そう簡単に絶望してたまるもんですか！」", "Battle/Dat/Battle/Message/061.bmd|0x0055F2": "「コンターギオ……これ以上はやらせない！」", "Battle/Dat/Battle/Message/061.bmd|0x005632": "「行くわよ、アクイラ！」", "Battle/Dat/Battle/Message/061.bmd|0x005657": "「逃がさないわよ、ウンブラ！」", "Battle/Dat/Battle/Message/061.bmd|0x005685": "「あの人、戦う気がないとでも……！？」", "Battle/Dat/Battle/Message/061.bmd|0x0056BF": "「“破滅の王”……何としてもここで！」", "Battle/Dat/Battle/Message/061.bmd|0x0056F9": "「ここでルイーナとの戦いを終わらせる！」", "Battle/Dat/Battle/Message/061.bmd|0x005736": "「行くわよ、ロフ！」", "Battle/Dat/Battle/Message/061.bmd|0x005755": "「ゲストの指揮官機ね……！」", "Battle/Dat/Battle/Message/061.bmd|0x005780": "「逃がさないわよ、ゼブ！」", "Battle/Dat/Battle/Message/061.bmd|0x0057A8": "「あ～、もう！　あの喋り方、イライラする！」", "Battle/Dat/Battle/Message/061.bmd|0x0057EB": "「行くわよ、セティ！」", "Battle/Dat/Battle/Message/061.bmd|0x00580D": "「もう観念しなさい、ゼゼーナン！」", "Battle/Dat/Battle/Message/061.bmd|0x005841": "「これでお終いよ、ゼゼーナン！」", "Battle/Dat/Battle/Message/061.bmd|0x005872": "「夏喃、あなたの誘いには乗らないわ！」", "Battle/Dat/Battle/Message/061.bmd|0x0058AC": "「行くわよ、夏喃！」", "Battle/Dat/Battle/Message/061.bmd|0x0058CB": "「胸のことばかり言わないでよっ！」", "Battle/Dat/Battle/Message/061.bmd|0x0058FF": "「行くわよ、ククル！」", "Battle/Dat/Battle/Message/061.bmd|0x005921": "「あの踊りに/　惑わされないようにしなきゃ……！」", "Battle/Dat/Battle/Message/061.bmd|0x00596B": "「孫光龍！　あなた、何様のつもりなのよ！？」", "Battle/Dat/Battle/Message/061.bmd|0x0059AE": "「あの人、どこまでも人を見下して……！」", "Battle/Dat/Battle/Message/061.bmd|0x0059EB": "「行くわよ、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/061.bmd|0x005A1C": "「ガイアセイバーズ……/　あなた達には負けない！」", "Battle/Dat/Battle/Message/061.bmd|0x005A66": "「ガイアセイバーズなんかに！」", "Battle/Dat/Battle/Message/061.bmd|0x005A94": "「覚悟しなさい、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/061.bmd|0x005ACB": "「メディウス・ロクス……乗っているのは誰？」", "Battle/Dat/Battle/Message/061.bmd|0x005B0E": "「迂闊にジンライの懐へ/　飛び込まないようにしなきゃ……！」", "Battle/Dat/Battle/Message/061.bmd|0x005B67": "「行くわよ、ジンライ！」", "Battle/Dat/Battle/Message/061.bmd|0x005B8C": "「ターゲット、メディウス・ロクス……！」", "Battle/Dat/Battle/Message/061.bmd|0x005BC9": "「これ以上、進化なんてさせないわ！」", "Battle/Dat/Battle/Message/061.bmd|0x005C00": "「ヒューゴ少尉の仇討ちよ！」"}