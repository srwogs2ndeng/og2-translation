{"Battle/Dat/Battle/Message/042.bmd|0x00708E": "「隊長、ここは退いて下さい！」", "Battle/Dat/Battle/Message/042.bmd|0x0070BC": "「後退して、キョウスケ中尉！」", "Battle/Dat/Battle/Message/042.bmd|0x0070EA": "「エクセレン、下がって！」", "Battle/Dat/Battle/Message/042.bmd|0x007112": "「カイ少佐、離脱を！」", "Battle/Dat/Battle/Message/042.bmd|0x007134": "「イング、下がりなさい！」", "Battle/Dat/Battle/Message/042.bmd|0x00715C": "「アリエイル、後退して！」", "Battle/Dat/Battle/Message/042.bmd|0x007184": "「ラミア少尉、後は任せて！」", "Battle/Dat/Battle/Message/042.bmd|0x0071AF": "「マサキ、無茶しちゃ駄目よ！」", "Battle/Dat/Battle/Message/042.bmd|0x0071DD": "「リューネ、下がって！」", "Battle/Dat/Battle/Message/042.bmd|0x007202": "「ジョッシュ、下がりなさい！」", "Battle/Dat/Battle/Message/042.bmd|0x007230": "「リム、離脱して！」", "Battle/Dat/Battle/Message/042.bmd|0x00724F": "「ヒューゴ少尉、離脱を！」", "Battle/Dat/Battle/Message/042.bmd|0x007277": "「アクア、ここは私が！」", "Battle/Dat/Battle/Message/042.bmd|0x00729C": "「一気に行くわよ！」", "Battle/Dat/Battle/Message/042.bmd|0x0072BB": "「それだけ固まっていれば！」", "Battle/Dat/Battle/Message/042.bmd|0x0072E6": "「まだいける！」", "Battle/Dat/Battle/Message/042.bmd|0x0072FF": "「もう一撃！」", "Battle/Dat/Battle/Message/042.bmd|0x007315": "「発射します！」", "Battle/Dat/Battle/Message/042.bmd|0x00732E": "「発射！」", "Battle/Dat/Battle/Message/042.bmd|0x00733E": "「受けなさい！！」", "Battle/Dat/Battle/Message/042.bmd|0x00735A": "「そこっ！」", "Battle/Dat/Battle/Message/042.bmd|0x00736D": "「スプリットミサイル！」", "Battle/Dat/Battle/Message/042.bmd|0x007392": "「これで……！」", "Battle/Dat/Battle/Message/042.bmd|0x0073AB": "「受けなさい！」", "Battle/Dat/Battle/Message/042.bmd|0x0073C4": "「レーザーキャノン、発射！」", "Battle/Dat/Battle/Message/042.bmd|0x0073EF": "「私の念を乗せて……」", "Battle/Dat/Battle/Message/042.bmd|0x007411": "「飛べ！　ストライクシールド！！」", "Battle/Dat/Battle/Message/042.bmd|0x007445": "「念動集中……」", "Battle/Dat/Battle/Message/042.bmd|0x00745E": "「ストライクシールド、発射！！」", "Battle/Dat/Battle/Message/042.bmd|0x00748F": "「Ｔ‐ＬＩＮＫ、フルコンタクト……」", "Battle/Dat/Battle/Message/042.bmd|0x0074C6": "「Ｔ‐ＬＩＮＫ、フルコンタクト……！」", "Battle/Dat/Battle/Message/042.bmd|0x007500": "「行けっ！！」", "Battle/Dat/Battle/Mess