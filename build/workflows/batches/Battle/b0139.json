{"Battle/Dat/Battle/Message/067.bmd|0x0092C0": "「でやああっ！！」", "Battle/Dat/Battle/Message/067.bmd|0x0092DC": "「奥義ッ！！」", "Battle/Dat/Battle/Message/067.bmd|0x0092F2": "「斬艦刀！　逸騎刀閃ッ！！」", "Battle/Dat/Battle/Message/067.bmd|0x00931D": "「切り裂く！」", "Battle/Dat/Battle/Message/067.bmd|0x009333": "「はあああああ！！」", "Battle/Dat/Battle/Message/067.bmd|0x009352": "「フッ、我らに……」", "Battle/Dat/Battle/Message/067.bmd|0x009371": "「断てぬものなし……！」", "Battle/Dat/Battle/Message/067.bmd|0x009396": "「チェェストォォォォォッ！！」", "Battle/Dat/Battle/Message/067.bmd|0x0093C4": "「断てぬものなしッ！！」", "Battle/Dat/Battle/Message/067.bmd|0x0093E9": "「砕け散れ……照星の彼方で！」", "Battle/Dat/Battle/Message/067.bmd|0x009417": "「受けよ！　我がトロンベ渾身の一撃を！！」", "Battle/Dat/Battle/Message/067.bmd|0x009457": "「私の前に現れた時点で、/　お前の運命は決まっている……」", "Battle/Dat/Battle/Message/067.bmd|0x0094AD": "「呪え……我が身の不運を！！」", "Battle/Dat/Battle/Message/067.bmd|0x0094DB": "「全弾受けていただく！！」", "Battle/Dat/Battle/Message/067.bmd|0x009503": "「ファング・スラッシャー、発射！」", "Battle/Dat/Battle/Message/067.bmd|0x009537": "「ターゲット・インサイト……！」", "Battle/Dat/Battle/Message/067.bmd|0x009568": "「竜巻の如く敵を切り裂け！」", "Battle/Dat/Battle/Message/067.bmd|0x009593": "「撃て、トロンベよ！！」", "Battle/Dat/Battle/Message/067.bmd|0x0095B8": "「行け！　ドリル・ブーストナックル！」", "Battle/Dat/Battle/Message/067.bmd|0x0095F2": "「砕け散れ！」", "Battle/Dat/Battle/Message/067.bmd|0x009608": "「貫け！　ドリル・ブーストナックル！」", "Battle/Dat/Battle/Message/067.bmd|0x009642": "「我が一撃、受けていただこう！」", "Battle/Dat/Battle/Message/067.bmd|0x009673": "「質の良い素材もまた、/　良い料理の要素だ……！」", "Battle/Dat/Battle/Message/067.bmd|0x0096BD": "「だが、お前は調理に値せん！」", "Battle/Dat/Battle/Message/067.bmd|0x0096EB": "「生か死か、好きな方を選ぶがいい」", "Battle/Dat/Battle/Message/067.bmd|0x00971F": "「捕らえたぞ！」", "Battle/Dat/Battle/Message/067.bmd|0x009738": "「高機動モード、起動！」", "Battle/Dat/Battle/Message/067.bmd|0x00975D": "「沈めっ！！」", "Battle/Dat/Battle/Message/067.bmd|0x009773": "「狙いは定まった……！」", "Battle/Dat/Battle/Message/067.bmd|0x009798": "「逃がしはせん……！」", "Battle/Dat/Battle/Message/067.bmd|0x0097BA": "「モードセレクト、Ｗ！」", "Battle/Dat/Battle/Message/067.bmd|0x0097DF": "「生か死か……好きな方を選ぶがいい！」", "Battle/Dat/Battle/Message/067.bmd|0x009819": "「Ｗモード、発射！」", "Battle/Dat/Battle/Message/067.bmd|0x009838": "「ギガ・ワイドブラスター、発射！」", "Battle/Dat/Battle/Message/067.bmd|0x00986C": "「ギガ・サークルブラスター、発射！」", "Battle/Dat/Battle/Message/067.bmd|0x0098A3": "「あの悲劇を再び起こさせないために……」", "Battle/Dat/Battle/Message/067.bmd|0x0098E0": "「生まれ変わった最強の盾、/　その力を思い知るがいい！」", "Battle/Dat/Battle/Message/067.bmd|0x009933": "「ハルバート・ランチャー、セット！」", "Battle/Dat/Battle/Message/067.bmd|0x00996A": "「生か死か、好きな方を選ぶがいい！」", "Battle/Dat/Battle/Message/067.bmd|0x0099A1": "「ソードブレイカー！」", "Battle/Dat/Battle/Message/067.bmd|0x0099C3": "「スラッシュ・リッパー、発射！」", "Battle/Dat/Battle/Message/067.bmd|0x0099F4": "「原始的な武器だが、威力は充分！」", "Battle/Dat/Battle/Message/067.bmd|0x009A28": "「行け、リープ・スラッシャー！」", "Battle/Dat/Battle/Message/067.bmd|0x009A59": "「我が敵を切り裂け！/　リープ・スラッシャー！」", "Battle/Dat/Battle/Message/067.bmd|0x009AA0": "「リープ・スラッシャー、発射！！」", "Battle/Dat/Battle/Message/067.bmd|0x009AD4": "「グラビトン・ランチャー、発射！」", "Battle/Dat/Battle/Message/067.bmd|0x009B08": "「シシオウブレード……！」", "Battle/Dat/Battle/Message/067.bmd|0x009B30": "「斬り裂く！！」", "Battle/Dat/Battle/Message/067.bmd|0x009B49": "「そこだ！」", "Battle/Dat/Battle/Message/067.bmd|0x009B5C": "「落ちろ！」", "Battle/Dat/Battle/Message/067.bmd|0x009B6F": "「もらった！」", "Battle/Dat/Battle/Message/067.bmd|0x009B85": "「斬れ、トロンベよ！」", "Battle/Dat/Battle/Message/067.bmd|0x009BA7": "「ブースト！」", "Battle/Dat/Battle/Message/067.bmd|0x009BBD": "「トロンベよ、撃ち抜け！」", "Battle/Dat/Battle/Message/067.bmd|0x009BE5": "「そして、砕け！！」", "Battle/Dat/Battle/Message/067.bmd|0x009C04": "「私に出会った不幸を呪え！」", "Battle/Dat/Battle/Message/067.bmd|0x009C2F": "「クレイモア！」", "Battle/Dat/Battle/Message/067.bmd|0x009C48": "「まだ終わりではない！」", "Battle/Dat/Battle/Message/067.bmd|0x009C6D": "「砕け散れぇぇっ！！」", "Battle/Dat/Battle/Message/067.bmd|0x009C8F": "「竜巻のごとく舞え！」", "Battle/Dat/Battle/Message/067.bmd|0x009CB1": "「ブレード・トンファー！！」", "Battle/Dat/Battle/Message/067.bmd|0x009CDC": "「ブレード・サイ、アクティブ！」", "Battle/Dat/Battle/Message/067.bmd|0x009D0D": "「切り裂け、竜巻の如く！」", "Battle/Dat/Battle/Message/067.bmd|0x009D35": "「受けよ、渾身の一撃を！」", "Battle/Dat/Battle/Message/067.bmd|0x009D5D": "「飛べ、トロンベよ！」", "Battle/Dat/Battle/Message/067.bmd|0x009D7F": "「逃がしはせん！」", "Battle/Dat/Battle/Message/067.bmd|0x009D9B": "「落ちていただく！」", "Battle/Dat/Battle/Message/067.bmd|0x009DBA": "「プラズマ・ステーク、アクティブ！」", "Battle/Dat/Battle/Message/067.bmd|0x009DF1": "「ジェット・マグナム！！」", "Battle/Dat/Battle/Message/067.bmd|0x009E19": "「スプリットミサイル！」", "Battle/Dat/Battle/Message/067.bmd|0x009E3E": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/067.bmd|0x009E63": "「突き進め、竜巻の如く！」", "Battle/Dat/Battle/Message/067.bmd|0x009E8B": "「メガ・ブラスターキャノン！」", "Battle/Dat/Battle/Message/067.bmd|0x009EB9": "「突き進め、駿馬の如く！」", "Battle/Dat/Battle/Message/067.bmd|0x009EE1": "「舞い上がれ、竜巻の如く！」", "Battle/Dat/Battle/Message/067.bmd|0x009F0C": "「ジェット・ファントム！！」", "Battle/Dat/Battle/Message/067.bmd|0x009F37": "「生か死か、好きな方を選ぶがいい……！」", "Battle/Dat/Battle/Message/067.bmd|0x009F74": "「ツイン・ビームカノン、発射！」", "Battle/Dat/Battle/Message/067.bmd|0x009FA5": "「ダーク・ロック！」", "Battle/Dat/Battle/Message/067.bmd|0x009FC4": "「もう一撃！」", "Battle/Dat/Battle/Message/067.bmd|0x009FDA": "「ハイパー・ブーストナックル！」", "Battle/Dat/Battle/Message/067.bmd|0x00A00B": "「打ち砕け！」", "Battle/Dat/Battle/Message/067.bmd|0x00A021": "「ビーム・キャノン、アクティブ！」", "Battle/Dat/Battle/Message/067.bmd|0x00A055": "「アルティメット・ビーム、発射！！」", "Battle/Dat/Battle/Message/067.bmd|0x00A08C": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/067.bmd|0x00A0A7": "「暗剣殺！！」", "Battle/Dat/Battle/Message/067.bmd|0x00A0BD": "「斬！！」", "Battle/Dat/Battle/Message/067.bmd|0x00A0CD": "「我を阻むものなし」", "Battle/Dat/Battle/Message/067.bmd|0x00A0EC": "「凶星の剣にて、お前を討つ！」", "Battle/Dat/Battle/Message/067.bmd|0x00A11A": "「五！」", "Battle/Dat/Battle/Message/067.bmd|0x00A127": "「黄！」", "Battle/Dat/Battle/Message/067.bmd|0x00A134": "「殺！！」", "Battle/Dat/Battle/Message/067.bmd|0x00A144": "「我が身の不幸を呪うがいい」", "Battle/Dat/Battle/Message/067.bmd|0x00A16F": "「ツイン・ビームキャノン、発射！」", "Battle/Dat/Battle/Message/067.bmd|0x00A1A3": "「回れ、トロンベ！　竜巻の如く！」", "Battle/Dat/Battle/Message/067.bmd|0x00A1D7": "「打ち砕く！！」", "Battle/Dat/Battle/Message/067.bmd|0x00A1F0": "「全弾受けていただく！」", "Battle/Dat/Battle/Message/067.bmd|0x00A215": "「コンビネーション・アタック！」", "Battle/Dat/Battle/Message/067.bmd|0x00A246": "「穿て、トロンベよ！」", "Battle/Dat/Battle/Message/067.bmd|0x00A268": "「トロンベよ、我が敵を凶方へ誘え……！」", "Battle/Dat/Battle/Message/067.bmd|0x00A2A5": "「獅子王刀、歳破！」", "Battle/Dat/Battle/Message/067.bmd|0x00A2C4": "「受けよ、渾身の一撃を！！」", "Battle/Dat/Battle/Message/067.bmd|0x00A2EF": "「私に出会った不幸を呪え」", "Battle/Dat/Battle/Message/067.bmd|0x00A317": "「ＭＴＤ誘導弾、受けていただく！」", "Battle/Dat/Battle/Message/067.bmd|0x00A34B": "「このミサイルの運動性能を、/　甘く見ないことだ！」", "Battle/Dat/Battle/Message/067.bmd|0x00A398": "「イルミネーター・リンク！」", "Battle/Dat/Battle/Message/067.bmd|0x00A3C3": "「天空からの光撃、受けていただく！」", "Battle/Dat/Battle/Message/068.bmd|0x0046A5": "「攻撃開始！」", "Battle/Dat/Battle/Message/068.bmd|0x0046BB": "「そこだ！」", "Battle/Dat/Battle/Message/068.bmd|0x0046CE": "「抵抗しても無駄だ！」", "Battle/Dat/Battle/Message/068.bmd|0x0046F0": "「直撃させる……！」", "Battle/Dat/Battle/Message/068.bmd|0x00470F": "「覚悟してもらうぞ……！」", "Battle/Dat/Battle/Message/068.bmd|0x004737": "「標的確認……！」", "Battle/Dat/Battle/Message/068.bmd|0x004753": "「悪いが、これが現実だ」", "Battle/Dat/Battle/Message/068.bmd|0x004778": "「運が無かったな」", "Battle/Dat/Battle/Message/068.bmd|0x004794": "「ここまでだな……！」", "Battle/Dat/Battle/Message/068.bmd|0x0047B6": "「遅い！」", "Battle/Dat/Battle/Message/068.bmd|0x0047C6": "「先手はもらった……！」", "Battle/Dat/Battle/Message/068.bmd|0x0047EB": "「俺が相手だ！」", "Battle/Dat/Battle/Message/068.bmd|0x004804": "「時間をかけるつもりはない……！」"}