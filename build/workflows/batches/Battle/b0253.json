{"Battle/Dat/Battle/Message/191.bmd|0x002349": "「ニャ～んか最近、/　おいら達の扱いが荒くなってきたニャ……」", "Battle/Dat/Battle/Message/191.bmd|0x0023A5": "「ぶつくさ言わニャいの！」", "Battle/Dat/Battle/Message/191.bmd|0x0023CD": "「任せたぜ！　クロ、シロ！」", "Battle/Dat/Battle/Message/191.bmd|0x0023F8": "「猫使いが荒いニャ～！」", "Battle/Dat/Battle/Message/191.bmd|0x00241D": "「そんニャこと言ってる場合じゃ/　ニャいでしょ！」", "Battle/Dat/Battle/Message/191.bmd|0x002467": "「ディスカッター、霞斬り！」", "Battle/Dat/Battle/Message/191.bmd|0x002492": "「おらおらおらおらっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x0024BA": "「行くぞ！　ディスカッター、霞斬りぃっ！」", "Battle/Dat/Battle/Message/191.bmd|0x0024FA": "「ディスカッターでぶった斬ってやる！」", "Battle/Dat/Battle/Message/191.bmd|0x002534": "「魔法剣エーテルちゃぶ台返し！」", "Battle/Dat/Battle/Message/191.bmd|0x002565": "「そんな技、ニャいニャ」", "Battle/Dat/Battle/Message/191.bmd|0x00258A": "「くらえっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x0025A3": "「アァァカシックバスタァァァァァッ！！」", "Battle/Dat/Battle/Message/191.bmd|0x0025E0": "「いっけぇぇっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x0025FF": "「アカシック・バスターッ！！」", "Battle/Dat/Battle/Message/191.bmd|0x00262D": "「でえええいっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x00264C": "「おりゃあああっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x00266E": "「こいつでとどめだ！！」", "Battle/Dat/Battle/Message/191.bmd|0x002693": "「コスモノヴァ！！」", "Battle/Dat/Battle/Message/192.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/193.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/194.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/195.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/196.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/197.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/198.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/199.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/200.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/201.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/202.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/203.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/204.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/205.bmd|0x0003A4": "「