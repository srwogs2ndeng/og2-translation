{"Battle/Dat/Battle/Message/130.bmd|0x001563": "「弾薬の再装填を！」", "Battle/Dat/Battle/Message/130.bmd|0x001582": "「死角に逃げ込まれたか……！」", "Battle/Dat/Battle/Message/130.bmd|0x0015B0": "「目標を再度捕捉せよ！」", "Battle/Dat/Battle/Message/130.bmd|0x0015D5": "「味方機を援護せよ！」", "Battle/Dat/Battle/Message/130.bmd|0x0015F7": "「続けて攻撃を！」", "Battle/Dat/Battle/Message/130.bmd|0x001613": "「最大戦速で突進！」", "Battle/Dat/Battle/Message/130.bmd|0x001632": "「本艦で受け止めるぞ！」", "Battle/Dat/Battle/Message/130.bmd|0x001657": "「目標を再度攻撃！」", "Battle/Dat/Battle/Message/130.bmd|0x001676": "「もう一度仕掛けるぞ！」", "Battle/Dat/Battle/Message/130.bmd|0x00169B": "「機銃座、撃ち方始め！」", "Battle/Dat/Battle/Message/130.bmd|0x0016C0": "「対空機銃、撃ち方始め！」", "Battle/Dat/Battle/Message/130.bmd|0x0016E8": "「ミサイル発射用意！　撃て！」", "Battle/Dat/Battle/Message/130.bmd|0x001716": "「ミサイル、撃て！」", "Battle/Dat/Battle/Message/130.bmd|0x001735": "「ＶＬＳミサイルランチャー、撃て！」", "Battle/Dat/Battle/Message/130.bmd|0x00176C": "「ＶＬＳミサイルランチャー、/　発射用意！　撃て！」", "Battle/Dat/Battle/Message/130.bmd|0x0017B9": "「対艦ミサイルで仕留めろ！」", "Battle/Dat/Battle/Message/130.bmd|0x0017E4": "「対艦ミサイル、発射用意！　撃て！」", "Battle/Dat/Battle/Message/130.bmd|0x00181B": "「対艦ミサイル、撃て！」", "Battle/Dat/Battle/Message/130.bmd|0x001840": "「副砲、攻撃用意！　撃て！」", "Battle/Dat/Battle/Message/130.bmd|0x00186B": "「仕留めてみせろ！　撃て！」", "Battle/Dat/Battle/Message/130.bmd|0x001896": "「各副砲、外すな！　撃て！」", "Battle/Dat/Battle/Message/130.bmd|0x0018C1": "「主砲、攻撃用意！　撃て！」", "Battle/Dat/Battle/Message/130.bmd|0x0018EC": "「主砲で仕留めろ！　撃て！」", "Battle/Dat/Battle/Message/130.bmd|0x001917": "「主砲、撃て！」", "Battle/Dat/Battle/Message/130.bmd|0x001930": "「ビーム砲艦、攻撃用意！」", "Battle/Dat/Battle/Message/130.bmd|0x001958": "「全艦、撃て！」", "Battle/Dat/Battle/Message/130.bmd|0x001971": "「全砲艦、パージ！　攻撃用意！」", "Battle/Dat/Battle/Message/130.bmd|0x0019A2": "「撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x000DA6": "「ガイアセイバーズの力を知らしめよ！」", "Battle/Dat/Battle/Message/131.bmd|0x000DE0": "「総員、奮闘せよ！」", "Battle/Dat/Battle/Message/131.bmd|0x000DFF": "「反乱分子を処分するのだ！」", "Battle/Dat/Battle/Message/131.bmd|0x000E2A": "「反逆者に情けは無用！」", "Battle/Dat/Battle/Message/131.bmd|0x000E4F": "「鋼龍戦隊を撃破する！」", "Battle/Dat/Battle/Message/131.bmd|0x000E74": "「総員、対艦戦闘用意！」", "Battle/Dat/Battle/Message/131.bmd|0x000E99": "「目標、敵母艦！」", "Battle/Dat/Battle/Message/131.bmd|0x000EB5": "「鋼龍戦隊の母艦を沈めるぞ！」", "Battle/Dat/Battle/Message/131.bmd|0x000EE3": "「直ちに反撃を！」", "Battle/Dat/Battle/Message/131.bmd|0x000EFF": "「目標を逃がすな！」", "Battle/Dat/Battle/Message/131.bmd|0x000F1E": "「反撃開始！」", "Battle/Dat/Battle/Message/131.bmd|0x000F34": "「目標を追尾せよ！」", "Battle/Dat/Battle/Message/131.bmd|0x000F53": "「ここまでか！　総員退避！！」", "Battle/Dat/Battle/Message/131.bmd|0x000F81": "「うぬうっ！　遺憾ながら艦を放棄する！」", "Battle/Dat/Battle/Message/131.bmd|0x000FBE": "「な、何っ！？　馬鹿な！！」", "Battle/Dat/Battle/Message/131.bmd|0x000FE9": "「そ、総員直ちに退艦せよ！！」", "Battle/Dat/Battle/Message/131.bmd|0x001017": "「いかん、これ以上は！！」", "Battle/Dat/Battle/Message/131.bmd|0x00103F": "「ええい！　急いでダメコンを！」", "Battle/Dat/Battle/Message/131.bmd|0x001070": "「くうっ！　敵機をこれ以上近寄らせるな！」", "Battle/Dat/Battle/Message/131.bmd|0x0010B0": "「立て直せ！　戦いはまだこれからだ！」", "Battle/Dat/Battle/Message/131.bmd|0x0010EA": "「周辺の機体を直掩に当たらせろ！」", "Battle/Dat/Battle/Message/131.bmd|0x00111E": "「こ、ここで沈んではならん！」", "Battle/Dat/Battle/Message/131.bmd|0x00114C": "「ぬううっ！/　ガイアセイバーズに敗北は許されんのだ！」", "Battle/Dat/Battle/Message/131.bmd|0x00119F": "「直撃か！　被弾箇所を知らせ！」", "Battle/Dat/Battle/Message/131.bmd|0x0011D0": "「この程度で本艦は沈まん」", "Battle/Dat/Battle/Message/131.bmd|0x0011F8": "「うろたえるな。冷静に対処しろ！」", "Battle/Dat/Battle/Message/131.bmd|0x00122C": "「ちいっ、本艦を集中的に狙って来たか！」", "Battle/Dat/Battle/Message/131.bmd|0x001269": "「くうっ！　弾幕をもっと厚くしろ！」", "Battle/Dat/Battle/Message/131.bmd|0x0012A0": "「ガイアセイバーズは、/　この程度では怯まんのだ！」", "Battle/Dat/Battle/Message/131.bmd|0x0012ED": "「操舵手！　回避が遅いぞ！」", "Battle/Dat/Battle/Message/131.bmd|0x001318": "「被弾箇所を報告せよ！」", "Battle/Dat/Battle/Message/131.bmd|0x00133D": "「構うな、攻撃に専念しろ！」", "Battle/Dat/Battle/Message/131.bmd|0x001368": "「各砲座、敵機を接近させるな！」", "Battle/Dat/Battle/Message/131.bmd|0x001399": "「フン、本艦に狙いを定めたか」", "Battle/Dat/Battle/Message/131.bmd|0x0013C7": "「ほう……ガイアセイバーズに/　刃向かうだけのことはあるな」", "Battle/Dat/Battle/Message/131.bmd|0x001420": "「当たりはしない」", "Battle/Dat/Battle/Message/131.bmd|0x00143C": "「よし、よくかわした」", "Battle/Dat/Battle/Message/131.bmd|0x00145E": "「的になるつもりはない」", "Battle/Dat/Battle/Message/131.bmd|0x001483": "「………」", "Battle/Dat/Battle/Message/131.bmd|0x001493": "「効きはせん！」", "Battle/Dat/Battle/Message/131.bmd|0x0014AC": "「無駄だ」", "Battle/Dat/Battle/Message/131.bmd|0x0014BC": "「その手は通用せん」", "Battle/Dat/Battle/Message/131.bmd|0x0014DB": "「そんな攻撃に！」", "Battle/Dat/Battle/Message/131.bmd|0x0014F7": "「これだけの砲塔があって、/　弾切れなどと……！」", "Battle/Dat/Battle/Message/131.bmd|0x001541": "「再装填を急がせろ！」", "Battle/Dat/Battle/Message/131.bmd|0x001563": "「弾薬の再装填を！」", "Battle/Dat/Battle/Message/131.bmd|0x001582": "「死角に逃げ込まれたか……！」", "Battle/Dat/Battle/Message/131.bmd|0x0015B0": "「目標を再度捕捉せよ！」", "Battle/Dat/Battle/Message/131.bmd|0x0015D5": "「味方機を援護せよ！」", "Battle/Dat/Battle/Message/131.bmd|0x0015F7": "「続けて攻撃を！」", "Battle/Dat/Battle/Message/131.bmd|0x001613": "「最大戦速で突進！」", "Battle/Dat/Battle/Message/131.bmd|0x001632": "「本艦で受け止めるぞ！」", "Battle/Dat/Battle/Message/131.bmd|0x001657": "「目標を再度攻撃！」", "Battle/Dat/Battle/Message/131.bmd|0x001676": "「もう一度仕掛けるぞ！」", "Battle/Dat/Battle/Message/131.bmd|0x00169B": "「機銃座、撃ち方始め！」", "Battle/Dat/Battle/Message/131.bmd|0x0016C0": "「対空機銃、撃ち方始め！」", "Battle/Dat/Battle/Message/131.bmd|0x0016E8": "「ミサイル発射用意！　撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x001716": "「ミサイル、撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x001735": "「ＶＬＳミサイルランチャー、撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x00176C": "「ＶＬＳミサイルランチャー、/　発射用意！　撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x0017B9": "「対艦ミサイルで仕留めろ！」", "Battle/Dat/Battle/Message/131.bmd|0x0017E4": "「対艦ミサイル、発射用意！　撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x00181B": "「対艦ミサイル、撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x001840": "「副砲、攻撃用意！　撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x00186B": "「仕留めてみせろ！　撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x001896": "「各副砲、外すな！　撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x0018C1": "「主砲、攻撃用意！　撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x0018EC": "「主砲で仕留めろ！　撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x001917": "「主砲、撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x001930": "「ビーム砲艦、攻撃用意！」", "Battle/Dat/Battle/Message/131.bmd|0x001958": "「全艦、撃て！」", "Battle/Dat/Battle/Message/131.bmd|0x001971": "「全砲艦、パージ！　攻撃用意！」", "Battle/Dat/Battle/Message/131.bmd|0x0019A2": "「撃て！」", "Battle/Dat/Battle/Message/132.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/132.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/132.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/132.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/132.bmd|0x0003FC": "「………？」", "Battle/Dat/Battle/Message/133.bmd|0x0020C0": "「最後の楽園を護るために……」", "Battle/Dat/Battle/Message/133.bmd|0x0020EE": "「古の人々の願い……それが私達を形作った」", "Battle/Dat/Battle/Message/133.bmd|0x00212E": "「私はイルイ……バラルの主であり、マシアフ」", "Battle/Dat/Battle/Message/133.bmd|0x002171": "「最後の楽園……それは地球」", "Battle/Dat/Battle/Message/133.bmd|0x00219C": "「楽園に住まう者達にガンエデンの加護を……」", "Battle/Dat/Battle/Message/133.bmd|0x0021DF": "「讃えなさい、古の守護神の復活を……」", "Battle/Dat/Battle/Message/133.bmd|0x002219": "「母なるガンエデンに祝福を……」", "Battle/Dat/Battle/Message/133.bmd|0x00224A": "「最後の楽園に久遠の安らぎを……」", "Battle/Dat/Battle/Message/133.bmd|0x00227E": "「災厄より逃れし者達の楽園……/　それを護るために……」", "Battle/Dat/Battle/Message/133.bmd|0x0022D1": "「ガンエデンの加護により、/　この星は真の意味で最後の楽園となるのです」", "Battle/Dat/Battle/Message/133.bmd|0x00233C": "「あなた達は人類を星の海へ導く存在……/　排除すべき対象です」", "Battle/Dat/Battle/Message/133.bmd|0x002398": "「もうあなたの夢が叶うことはない……」", "Battle/Dat/Battle/Message/133.bmd|0x0023D2": "「星の海へ……/　外界へ出る必要はないのです」", "Battle/Dat/Battle/Message/133.bmd|0x002416": "「超機人は我が下僕……/　刃向かうものは百邪……」"}