{"Battle/Dat/Battle/Message/054.bmd|0x009074": "「とどめだ！」", "Battle/Dat/Battle/Message/054.bmd|0x00908A": "「ジェット・ファントム！！」", "Battle/Dat/Battle/Message/054.bmd|0x0090B5": "「まだ終わりじゃない！！」", "Battle/Dat/Battle/Message/054.bmd|0x0090DD": "「全機、逃がしはしないぞ！」", "Battle/Dat/Battle/Message/054.bmd|0x009108": "「よし、ツイン・ビームカノンで！」", "Battle/Dat/Battle/Message/054.bmd|0x00913C": "「砲撃戦用機の見せ所だ！」", "Battle/Dat/Battle/Message/054.bmd|0x009164": "「ツイン・ビームカノン、発射！」", "Battle/Dat/Battle/Message/054.bmd|0x009195": "「ツイン・ビームカノン！！」", "Battle/Dat/Battle/Message/054.bmd|0x0091C0": "「ダーク・ロック！」", "Battle/Dat/Battle/Message/054.bmd|0x0091DF": "「おりゃあっ！」", "Battle/Dat/Battle/Message/054.bmd|0x0091F8": "「もう一撃っ！」", "Battle/Dat/Battle/Message/054.bmd|0x009211": "「ハイパー・ブーストナックル！」", "Battle/Dat/Battle/Message/054.bmd|0x009242": "「ビーム・キャノン、連動！」", "Battle/Dat/Battle/Message/054.bmd|0x00926D": "「アルティメット・ビーム、発射！！」", "Battle/Dat/Battle/Message/054.bmd|0x0092A4": "「グルンガスト、/　セミファイナル・モード……！」", "Battle/Dat/Battle/Message/054.bmd|0x0092EE": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/054.bmd|0x009309": "「暗剣殺！！」", "Battle/Dat/Battle/Message/054.bmd|0x00931F": "「斬！！」", "Battle/Dat/Battle/Message/054.bmd|0x00932F": "「さすがの斬れ味だ……！」", "Battle/Dat/Battle/Message/054.bmd|0x009357": "「グルンガスト、ファイナル・モード……！」", "Battle/Dat/Battle/Message/054.bmd|0x009397": "「五！」", "Battle/Dat/Battle/Message/054.bmd|0x0093A4": "「黄！」", "Battle/Dat/Battle/Message/054.bmd|0x0093B1": "「殺！！」", "Battle/Dat/Battle/Message/054.bmd|0x0093C1": "「これでどうだ！」", "Battle/Dat/Battle/Message/054.bmd|0x0093DD": "「ツイン・ビームキャノン、発射！」", "Battle/Dat/Battle/Message/054.bmd|0x009411": "「スパイラル・ブレイカー！」", "Battle/Dat/Battle/Message/054.bmd|0x00943C": "「突撃っ！！」", "Battle/Dat/Battle/Message/054.bmd|0x009452": "「オメガ・キャノン、発射！」", "Battle/Dat/Battle/Message/054.bmd|0x00947D": "「一斉砲撃！！」", "Battle/Dat/Battle/Message/054.bmd|0x009496": "「とどめだぁぁっ！！」", "Battle/Dat/Battle/Message/054.bmd|0x0094B8": "「パージして、各個攻撃します！」", "Battle/Dat/Battle/Message/054.bmd|0x0094E9": "「ドリル・アタッカー！！」", "Battle/Dat/Battle/Message/054.bmd|0x009511": "「参式、ファイナル・モード！」", "Battle/Dat/Battle/Message/054.bmd|0x00953F": "「獅子王刀、歳破！！」", "Battle/Dat/Battle/Message/054.bmd|0x009561": "「フル・ブースト！！」", "Battle/Dat/Battle/Message/054.bmd|0x009583": "「うおおおおお！！」", "Battle/Dat/Battle/Message/054.bmd|0x0095A2": "「凄い斬れ味だ……！」", "Battle/Dat/Battle/Message/054.bmd|0x0095C4": "「このミサイルを無駄にするわけには！」", "Battle/Dat/Battle/Message/054.bmd|0x0095FE": "「ＭＴＤ誘導弾、発射！」", "Battle/Dat/Battle/Message/054.bmd|0x009623": "「このミサイルは高いんだ、/　慎重に使わなきゃ……！」", "Battle/Dat/Battle/Message/054.bmd|0x009673": "「イルミネーター・リンク！」", "Battle/Dat/Battle/Message/054.bmd|0x00969E": "「フリー・エレクトロン・キャノン！/　発射！！」", "Battle/Dat/Battle/Message/055.bmd|0x0021CE": "「あの敵は本艦で撃破します！」", "Battle/Dat/Battle/Message/055.bmd|0x0021FC": "「こちらから仕掛けます！」", "Battle/Dat/Battle/Message/055.bmd|0x002224": "「各員、鋼龍戦隊の名に恥じぬ戦いを！」", "Battle/Dat/Battle/Message/055.bmd|0x00225E": "「攻撃目標、メリオルエッセ！」", "Battle/Dat/Battle/Message/055.bmd|0x00228C": "「メリオルエッセに仕掛けます！」", "Battle/Dat/Battle/Message/055.bmd|0x0022BD": "「メリオルエッセ機、本艦を指向！」", "Battle/Dat/Battle/Message/055.bmd|0x0022F1": "「先手を取ります！」", "Battle/Dat/Battle/Message/055.bmd|0x002310": "「攻撃目標、ゲスト指揮官機！」", "Battle/Dat/Battle/Message/055.bmd|0x00233E": "「本艦で指揮官機を撃破します！」", "Battle/Dat/Battle/Message/055.bmd|0x00236F": "「ゲスト指揮官機、インレンジ！」", "Battle/Dat/Battle/Message/055.bmd|0x0023A0": "「ゼゼーナン……/　あなたの野望もここまでです！」", "Battle/Dat/Battle/Message/055.bmd|0x0023EA": "「理不尽な武力干渉に、私達は屈しません！」", "Battle/Dat/Battle/Message/055.bmd|0x00242A": "「攻撃目標、ガイアセイバーズ機！」", "Battle/Dat/Battle/Message/055.bmd|0x00245E": "「ガイアセイバーズに屈してはなりません！」", "Battle/Dat/Battle/Message/055.bmd|0x00249E": "「前方よりガイアセイバーズ機、接近！」", "Battle/Dat/Battle/Message/055.bmd|0x0024D8": "「直ちに攻撃を！」", "Battle/Dat/Battle/Message/055.bmd|0x0024F4": "「ガイアセイバーズ機、高速接近！」", "Battle/Dat/Battle/Message/055.bmd|0x002528": "「ガイアセイバーズ機、インレンジ！」", "Battle/Dat/Battle/Message/055.bmd|0x00255F": "「攻撃用意！」", "Battle/Dat/Battle/Message/055.bmd|0x002575": "「攻撃目標、エア・クリスマス！」", "Battle/Dat/Battle/Message/055.bmd|0x0025A6": "「攻撃目標、セイバー１！」", "Battle/Dat/Battle/Message/055.bmd|0x0025CE": "「エア・クリスマスに仕掛けます！」", "Battle/Dat/Battle/Message/055.bmd|0x002602": "「総員、対艦戦闘用意！」", "Battle/Dat/Battle/Message/055.bmd|0x002627": "「前方のルイーナ機を撃破します！」", "Battle/Dat/Battle/Message/055.bmd|0x00265B": "「攻撃目標、ルイーナ機！」", "Battle/Dat/Battle/Message/055.bmd|0x002683": "「前方よりルイーナ機、接近！」", "Battle/Dat/Battle/Message/055.bmd|0x0026B1": "「ルイーナ機、高速接近！」", "Battle/Dat/Battle/Message/055.bmd|0x0026D9": "「ルイーナ機、インレンジ！」", "Battle/Dat/Battle/Message/055.bmd|0x002704": "「前方のゲスト機を排除します！」", "Battle/Dat/Battle/Message/055.bmd|0x002735": "「ゲストの好きにやらせてはなりません！」", "Battle/Dat/Battle/Message/055.bmd|0x002772": "「ゲスト機、本艦へ接近！」", "Battle/Dat/Battle/Message/055.bmd|0x00279A": "「ゲスト機、高速接近！」", "Battle/Dat/Battle/Message/055.bmd|0x0027BF": "「攻撃目標、超魔装機！」", "Battle/Dat/Battle/Message/055.bmd|0x0027E4": "「『超』が付く魔装機ですからな、/　油断なりませんぞ」", "Battle/Dat/Battle/Message/055.bmd|0x002834": "「ええ、わかっています」", "Battle/Dat/Battle/Message/055.bmd|0x002859": "「前方の魔装機を撃破します！」", "Battle/Dat/Battle/Message/055.bmd|0x002887": "「攻撃目標、魔装機！」", "Battle/Dat/Battle/Message/055.bmd|0x0028A9": "「敵魔装機、接近！」", "Battle/Dat/Battle/Message/055.bmd|0x0028C8": "「敵魔装機、インレンジ！」", "Battle/Dat/Battle/Message/055.bmd|0x0028F0": "「攻撃目標、デモンゴーレム！」", "Battle/Dat/Battle/Message/055.bmd|0x00291E": "「むう、/　シンプルでわかりやすい怪物ですな」", "Battle/Dat/Battle/Message/055.bmd|0x002962": "「ああいうのは苦手です……」", "Battle/Dat/Battle/Message/055.bmd|0x00298D": "「何としてもヴォルクルスを撃破するのです！」", "Battle/Dat/Battle/Message/055.bmd|0x0029D0": "「いかにも邪神、といった感じの体ですな」", "Battle/Dat/Battle/Message/055.bmd|0x002A0D": "「しかし、怯むわけにはいきません！」", "Battle/Dat/Battle/Message/055.bmd|0x002A44": "「攻撃目標、妖機人！」", "Battle/Dat/Battle/Message/055.bmd|0x002A66": "「前方の妖機人を撃破します！」", "Battle/Dat/Battle/Message/055.bmd|0x002A94": "「艦長、あの類のものは……」", "Battle/Dat/Battle/Message/055.bmd|0x002ABF": "「苦手です、もちろん！」", "Battle/Dat/Battle/Message/055.bmd|0x002AE4": "「では、妖怪退治といきましょうか」", "Battle/Dat/Battle/Message/055.bmd|0x002B18": "「はい、お札の用意をお願いします」", "Battle/Dat/Battle/Message/055.bmd|0x002B4C": "「そんなもの、ありません！」", "Battle/Dat/Battle/Message/055.bmd|0x002B77": "「妖機人、インレンジ！」", "Battle/Dat/Battle/Message/055.bmd|0x002B9C": "「うう……攻撃開始！」", "Battle/Dat/Battle/Message/055.bmd|0x002BBE": "「攻撃目標、超機人！」", "Battle/Dat/Battle/Message/055.bmd|0x002BE0": "「本艦であの超機人を阻止します！」", "Battle/Dat/Battle/Message/055.bmd|0x002C14": "「いやはや、こうなると怪獣映画ですな」", "Battle/Dat/Battle/Message/055.bmd|0x002C4E": "「攻撃目標、ＡＩ１！」", "Battle/Dat/Battle/Message/055.bmd|0x002C70": "「ＡＩ１、本艦を指向しています！」", "Battle/Dat/Battle/Message/055.bmd|0x002CA4": "「あれに取り込まれるわけにはいきません！」", "Battle/Dat/Battle/Message/055.bmd|0x002CE4": "「攻撃目標、クストース！」", "Battle/Dat/Battle/Message/055.bmd|0x002D0C": "「イーグル、シャーク、パンサー/　……あちらも戦隊ですな」", "Battle/Dat/Battle/Message/055.bmd|0x002D62": "「何のことです？」", "Battle/Dat/Battle/Message/055.bmd|0x002D7E": "「攻撃目標、ガンエデン！」", "Battle/Dat/Battle/Message/055.bmd|0x002DA6": "「私達の世界に、あのような神は不要です！」", "Battle/Dat/Battle/Message/055.bmd|0x002DE6": "「ほう、神々しい。/　拝んだら、御利益がありますかな」", "Battle/Dat/Battle/Message/055.bmd|0x002E36": "「ありません！」", "Battle/Dat/Battle/Message/055.bmd|0x002E4F": "「鋼龍戦隊ある限り、/　あなたの計画が成就することはない……！」", "Battle/Dat/Battle/Message/055.bmd|0x002EAE": "「最終攻撃目標、アダマトロン！/　各員、奮戦せよ！」", "Battle/Dat/Battle/Message/055.bmd|0x002EFB": "「あの姿……/　天使と悪魔の中道を往くというわけですか」", "Battle/Dat/Battle/Message/055.bmd|0x002F4E": "「つまり、人間……その新たな祖……！」", "Battle/Dat/Battle/Message/055.bmd|0x002F88": "「直ちに反撃を！」", "Battle/Dat/Battle/Message/055.bmd|0x002FA4": "「目標を逃がしてはなりません！」", "Battle/Dat/Battle/Message/055.bmd|0x002FD5": "「目標の追尾を！」", "Battle/Dat/Battle/Message/055.bmd|0x002FF1": "「反撃を開始します！」", "Battle/Dat/Battle/Message/055.bmd|0x003013": "「そ、総員退艦を！！」", "Battle/Dat/Battle/Message/055.bmd|0x003035": "「こ、これ以上の損傷は……！」", "Battle/Dat/Battle/Message/055.bmd|0x003063": "「ああっ！　主翼が！！」"}