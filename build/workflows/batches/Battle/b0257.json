{"Battle/Dat/Battle/Message/221.bmd|0x0035CC": "「後に続くぞ！」", "Battle/Dat/Battle/Message/221.bmd|0x0035E5": "「後は任せろ！」", "Battle/Dat/Battle/Message/221.bmd|0x0035FE": "「いける！　もう一撃！」", "Battle/Dat/Battle/Message/221.bmd|0x003623": "「やらせん！」", "Battle/Dat/Battle/Message/221.bmd|0x003639": "「させるかっ！」", "Battle/Dat/Battle/Message/221.bmd|0x003652": "「ここは引き受ける！」", "Battle/Dat/Battle/Message/221.bmd|0x003674": "「覚悟してもらおうか！」", "Battle/Dat/Battle/Message/221.bmd|0x003699": "「まだだ！　もう一撃！」", "Battle/Dat/Battle/Message/221.bmd|0x0036BE": "「まだ終わりじゃないぞ！」", "Battle/Dat/Battle/Message/221.bmd|0x0036E6": "「まだまだっ！」", "Battle/Dat/Battle/Message/221.bmd|0x0036FF": "「もらう！」", "Battle/Dat/Battle/Message/221.bmd|0x003712": "「こいつをくらえ！」", "Battle/Dat/Battle/Message/221.bmd|0x003731": "「くらえ！」", "Battle/Dat/Battle/Message/221.bmd|0x003744": "「受けろ！」", "Battle/Dat/Battle/Message/221.bmd|0x003757": "「そこだ！」", "Battle/Dat/Battle/Message/221.bmd|0x00376A": "「落ちろ！」", "Battle/Dat/Battle/Message/221.bmd|0x00377D": "「はあっ！」", "Battle/Dat/Battle/Message/221.bmd|0x003790": "「おりゃあ！」", "Battle/Dat/Battle/Message/221.bmd|0x0037A6": "「たああっ！」", "Battle/Dat/Battle/Message/221.bmd|0x0037BC": "「むんっ！」", "Battle/Dat/Battle/Message/221.bmd|0x0037CF": "「当ててやる！」", "Battle/Dat/Battle/Message/221.bmd|0x0037E8": "「機銃座、撃ち方始め！」", "Battle/Dat/Battle/Message/221.bmd|0x00380D": "「対空機銃、撃て！」", "Battle/Dat/Battle/Message/221.bmd|0x00382C": "「高射砲、発射用意！　撃て！」", "Battle/Dat/Battle/Message/221.bmd|0x00385A": "「高射砲、１番、２番！　撃て！」", "Battle/Dat/Battle/Message/221.bmd|0x00388B": "「前部全砲塔、発射用意！　撃て！」", "Battle/Dat/Battle/Message/221.bmd|0x0038BF": "「前部砲塔、一斉射撃！　撃て！」", "Battle/Dat/Battle/Message/221.bmd|0x0038F0": "「バリオン・ビーム砲、発射用意！」", "Battle/Dat/Battle/Message/221.bmd|0x003924": "「撃て！」", "Battle/Dat/Battle/Message/221.bmd|0x003934": "「主砲、発射用意！」", "Battle/Dat/Battle/Message/222.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/223.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/224.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/225.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/226.bmd|0x000F72": "「くらえ！」", "Battle/Dat/Battle/Message/226.bmd|0x000F85": "「俺が相手をしてやる！」", "Battle/Dat/Battle/Message/226.bmd|0x000FAA": "「そこだ！」", "Battle/Dat/Battle/Message/226.bmd|0x000FBD": "「仕留める！」", "Battle/Dat/Battle/Message/226.bmd|0x000FD3": "「確実な攻撃を！」", "Battle/Dat/Battle/Message/226.bmd|0x000FEF": "「ここで食い止める！」", "Battle/Dat/Battle/Message/226.bmd|0x001011": "「好きにはやらせん！」", "Battle/Dat/Battle/Message/226.bmd|0x001033": "「力の差を教えてやる！」", "Battle/Dat/Battle/Message/226.bmd|0x001058": "「今までの連中と同じにするなよ！」", "Battle/Dat/Battle/Message/226.bmd|0x00108C": "「お前達はここで終わりだ！」", "Battle/Dat/Battle/Message/226.bmd|0x0010B7": "「お、おのれぇっ！！」", "Battle/Dat/Battle/Message/226.bmd|0x0010D9": "「だ、脱出する！」", "Battle/Dat/Battle/Message/226.bmd|0x0010F5": "「ここまでか！　脱出だ！」", "Battle/Dat/Battle/Message/226.bmd|0x00111D": "「くそっ！　機体を破棄する！」", "Battle/Dat/Battle/Message/226.bmd|0x00114B": "「ええい！　後退する！！」", "Battle/Dat/Battle/Message/226.bmd|0x001173": "「ぐあああっ！！」", "Battle/Dat/Battle/Message/226.bmd|0x00118F": "「いかん！　これ以上はまずいぞ！」", "Battle/Dat/Battle/Message/226.bmd|0x0011C3": "「な、何！？　損傷率７０％だとっ！？」", "Battle/Dat/Battle/Message/226.bmd|0x0011FD": "「くそ！　この機体では勝てんのか！」", "Battle/Dat/Battle/Message/226.bmd|0x001234": "「ま、まだだ！/　まだ貴様に屈したわけではない！」", "Battle/Dat/Battle/Message/226.bmd|0x00127E": "「な、何としてでも奴を止めてみせる！」", "Battle/Dat/Battle/Message/226.bmd|0x0012B8": "「ちいっ、機体の性能差がありすぎるのか！」", "Battle/Dat/Battle/Message/226.bmd|0x0012F8": "「うぬっ！/　ここまでのダメージを受けるとは！」", "Battle/Dat/Battle/Message/226.bmd|0x00133F": "「ここで倒れる俺ではない！」", "Battle/Dat/Battle/Message/226.bmd|0x00136A": "「うぐっ！　直撃だと！？」", "Battle/Dat/Battle/Message/226.bmd|0x001392": "「俺を止めることは出来なかったようだな！」", "Battle/Dat/Battle/Message/226.bmd|0x0013D2": "「ふん、それぐらいでなければな！」", "Battle/Dat/Battle/Message/226.bmd|0x001406": "「おのれ！　やってくれる！」", "Battle/Dat/Battle/Message/226.bmd|0x001431": "「ぐうっ！　一発や二発、食らったぐらいで！」", "Battle/Dat/Battle/Message/226.bmd|0x001474": "「こちらの装甲では止められんのか！？」", "Battle/Dat/Battle/Message/226.bmd|0x0014AE": "「ちいっ、俺を甘くみるなよ！」", "Battle/Dat/Battle/Message/226.bmd|0x0014DC": "「ふん！　口ほどでもない！」", "Battle/Dat/Battle/Message/226.bmd|0x001507": "「こちらの力をなめているのか！？」", "Battle/Dat/Battle/Message/226.bmd|0x00153B": "「こんなものでひるむ俺ではない！」", "Battle/Dat/Battle/Message/226.bmd|0x00156F": "「思っていた程の力ではないな！」", "Battle/Dat/Battle/Message/226.bmd|0x0015A0": "「ほう……この程度の抵抗しか出来ないのか」", "Battle/Dat/Battle/Message/226.bmd|0x0015E0": "「ダメージ軽微……作戦を続行する！」", "Battle/Dat/Battle/Message/226.bmd|0x001617": "「ふん……チェックの必要もない程度か」", "Battle/Dat/Battle/Message/226.bmd|0x001651": "「かわした！」", "Battle/Dat/Battle/Message/226.bmd|0x001667": "「モーションが大きすぎるんだよ！」", "Battle/Dat/Battle/Message/226.bmd|0x00169B": "「遅いっ！」", "Battle/Dat/Battle/Message/226.bmd|0x0016AE": "「照準がずれているようだな」", "Battle/Dat/Battle/Message/226.bmd|0x0016D9": "「今までの相手が弱すぎたようだな！」", "Battle/Dat/Battle/Message/226.bmd|0x001710": "「まぐれ当たりは続かないぞ！」", "Battle/Dat/Battle/Message/226.bmd|0x00173E": "「よし、回避成功だ！」", "Battle/Dat/Battle/Message/226.bmd|0x001760": "「その程度！」", "Battle/Dat/Battle/Message/226.bmd|0x001776": "「そんなもの！」", "Battle/Dat/Battle/Message/226.bmd|0x00178F": "「残念だったな！」", "Battle/Dat/Battle/Message/226.bmd|0x0017AB": "「無駄だ！」", "Battle/Dat/Battle/Message/226.bmd|0x0017BE": "「………」", "Battle/Dat/Battle/Message/226.bmd|0x0017CE": "「くっ、補給を！」", "Battle/Dat/Battle/Message/226.bmd|0x0017EA": "「長期戦では不利か！」", "Battle/Dat/Battle/Message/226.bmd|0x00180C": "「反撃できんとはな……！」", "Battle/Dat/Battle/Message/226.bmd|0x001834": "「手も足も出させんつもりか！」", "Battle/Dat/Battle/Message/226.bmd|0x001862": "「バカな、踊らされているのか！？」", "Battle/Dat/Battle/Message/226.bmd|0x001896": "「た、弾切れだと……！？」", "Battle/Dat/Battle/Message/226.bmd|0x0018BE": "「くっ、この間合いでは……！」", "Battle/Dat/Battle/Message/226.bmd|0x0018EC": "「ここからでは反撃できん！」", "Battle/Dat/Battle/Message/226.bmd|0x001917": "「反撃不可能だと！？」", "Battle/Dat/Battle/Message/226.bmd|0x001939": "「くそっ！　これじゃ狙い撃ちされる！」", "Battle/Dat/Battle/Message/226.bmd|0x001973": "「いかん！　これではただの標的だ！」", "Battle/Dat/Battle/Message/226.bmd|0x0019AA": "「くっ！　何も出来ないのか……！？」", "Battle/Dat/Battle/Message/226.bmd|0x0019E1": "「よし、援護するぞ！」", "Battle/Dat/Battle/Message/226.bmd|0x001A03": "「よそ見している暇はないぞ！」", "Battle/Dat/Battle/Message/226.bmd|0x001A31": "「この連携がかわせるか！」", "Battle/Dat/Battle/Message/226.bmd|0x001A59": "「これでとどめだ！」", "Battle/Dat/Battle/Message/226.bmd|0x001A78": "「確実に倒しておかねば！」", "Battle/Dat/Battle/Message/226.bmd|0x001AA0": "「フン、逃げ損なったな！」", "Battle/Dat/Battle/Message/226.bmd|0x001AC8": "「下がれ！」", "Battle/Dat/Battle/Message/226.bmd|0x001ADB": "「やらせん！」", "Battle/Dat/Battle/Message/226.bmd|0x001AF1": "「思うようにはさせん！」", "Battle/Dat/Battle/Message/226.bmd|0x001B16": "「早く後退しろ！」", "Battle/Dat/Battle/Message/226.bmd|0x001B32": "「同胞をやらせはせん！」", "Battle/Dat/Battle/Message/226.bmd|0x001B57": "「落とさせるか！」", "Battle/Dat/Battle/Message/226.bmd|0x001B73": "「今の内に後退を！」", "Battle/Dat/Battle/Message/226.bmd|0x001B92": "「ふん、油断したな！」", "Battle/Dat/Battle/Message/226.bmd|0x001BB4": "「一網打尽にしてやる！」", "Battle/Dat/Battle/Message/226.bmd|0x001BD9": "「まとめて叩き落とす！」", "Battle/Dat/Battle/Message/226.bmd|0x001BFE": "「落とす！」", "Battle/Dat/Battle/Message/226.bmd|0x001C11": "「直撃させる！」", "Battle/Dat/Battle/Message/227.bmd|0x000E8F": "「生かして帰すか！」", "Battle/Dat/Battle/Message/227.bmd|0x000EAE": "「そこっ！」", "Battle/Dat/Battle/Message/227.bmd|0x000EC1": "「仕留めてみせる！」", "Battle/Dat/Battle/Message/227.bmd|0x000EE0": "「抵抗するな！」", "Battle/Dat/Battle/Message/227.bmd|0x000EF9": "「お前はここまでだ！」", "Battle/Dat/Battle/Message/227.bmd|0x000F1B": "「当ててやる！」"}