": "「………？」", "Battle/Dat/Battle/Message/156.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/156.bmd|0x000440": "「！？！？！？」", "Battle/Dat/Battle/Message/156.bmd|0x000459": "「………！！！」", "Battle/Dat/Battle/Message/156.bmd|0x000472": "「………！！」", "Battle/Dat/Battle/Message/156.bmd|0x000488": "「………？」", "Battle/Dat/Battle/Message/157.bmd|0x00231A": "「カークス将軍の大義のために！」", "Battle/Dat/Battle/Message/157.bmd|0x00234B": "「敵機の捕捉成功。状況を開始する！」", "Battle/Dat/Battle/Message/157.bmd|0x002382": "「照準セット。ターゲット、ロックオン！」", "Battle/Dat/Battle/Message/157.bmd|0x0023BF": "「やってみせる！」", "Battle/Dat/Battle/Message/157.bmd|0x0023DB": "「攻撃開始！」", "Battle/Dat/Battle/Message/157.bmd|0x0023F1": "「行くぞ、地上人！」", "Battle/Dat/Battle/Message/157.bmd|0x002410": "「覚悟してもらうぞ、地上人！」", "Battle/Dat/Battle/Message/157.bmd|0x00243E": "「地上人よ、いざ勝負！」", "Battle/Dat/Battle/Message/157.bmd|0x002463": "「サイバスター！/　ここから先には進ませんぞ！」", "Battle/Dat/Battle/Message/157.bmd|0x0024AA": "「怯むものか、魔装機神が相手でも！」", "Battle/Dat/Battle/Message/157.bmd|0x0024E1": "「魔装機神でも、隙はどこかにあるはずだ！」", "Battle/Dat/Battle/Message/157.bmd|0x002521": "「グランヴェール！　やらせるものか！」", "Battle/Dat/Battle/Message/157.bmd|0x00255B": "「ガッデスを食い止めてみせる！」", "Battle/Dat/Battle/Message/157.bmd|0x00258C": "「ザムジード……我らの敵になるのであれば！」", "Battle/Dat/Battle/Message/157.bmd|0x0025CF": "「やらせんっ！」", "Battle/Dat/Battle/Message/157.bmd|0x0025E8": "「反撃する！」", "Battle/Dat/Battle/Message/157.bmd|0x0025FE": "「次はこちらの番だ！」", "Battle/Dat/Battle/Message/157.bmd|0x002620": "「まだここからだ！」", "Battle/Dat/Battle/Message/157.bmd|0x00263F": "「うあああっ！！」", "Battle/Dat/Battle/Message/157.bmd|0x00265B": "「こ、ここまでか！」", "Battle/Dat/Battle/Message/157.bmd|0x00267A": "「し、しまった！！」", "Battle/Dat/Battle/Message/157.bmd|0x002699": "「な、何とかもたせてみせる！」", "Battle/Dat/Battle/Message/157.bmd|0x0026C7": "「こ、ここで退くわけにはいかん！」", "Battle/Dat/Battle/Message/157.bmd|0x0026FB": "「ううっ……！　大義を成すまでは！」", "Battle/Dat/Battle/Message/157.bmd|0x002732": "「ぬうっ！　我らにも意地がある！」", "Battle/Dat/Battle/Message/157.bmd|0x002766": "「ぐううっ！/　まだ決着がついたわけではない！」", "Battle/Dat/Battle/Message/157.bmd|0x0027AD": "「ち、地上人……その力があれば……！」", "Battle/Dat/Battle/Message/157.bmd|0x0027E7": "「ええい、地上人め！/　これ以上はやらせんぞ！」", "Battle/Dat/Battle/Message/157.bmd|0x00282E": "「サ、サイバスター……つ、強過ぎる！」", "Battle/Dat/Battle/Message/157.bmd|0x002868": "「うぐっ……やはり、魔装機神には……！」", "Battle/Dat/Battle/Message/157.bmd|0x0028A5": "「ぐっ！/　覚悟なくして、魔装機神には挑まん！！」", "Battle/Dat/Battle/Message/157.bmd|0x0028EF": "「こ、これが炎の魔装機神の力か！」", "Battle/Dat/Battle/Message/157.bmd|0x002923": "「ガッデス……/　せめて、足止めだけでも……！！」", "Battle/Dat/Battle/Message/157.bmd|0x00296D": "「ザムジード……何というパワーだ……！」", "Battle/Dat/Battle/Message/157.bmd|0x0029AA": "「くっ！　致命傷じゃない！」", "Battle/Dat/Battle/Message/157.bmd|0x0029D5": "「まともに当たったか……！」", "Battle/Dat/Battle/Message/157.bmd|0x002A00": "「これぐらいのダメージ、覚悟はしていた！」", "Battle/Dat/Battle/Message/157.bmd|0x002A40": "「や、やる！　さすがだな！」", "Battle/Dat/Battle/Message/157.bmd|0x002A6B": "「臆するものか！　まだ戦う！」", "Battle/Dat/Battle/Message/157.bmd|0x002A99": "「地上人め、まだ抵抗するか！」", "Battle/Dat/Battle/Message/157.bmd|0x002AC7": "「やるな、地上人！」", "Battle/Dat/Battle/Message/157.bmd|0x002AE6": "「サイバスター……何という速さだ！」", "Battle/Dat/Battle/Message/157.bmd|0x002B1D": "「くっ！　魔装機神……やはり、強い！」", "Battle/Dat/Battle/Message/157.bmd|0x002B57": "「これ以上、魔装機神を進ませるわけには！」", "Battle/Dat/Battle/Message/157.bmd|0x002B97": "「うぐっ！　グランヴェール、やはり強い！」", "Battle/Dat/Battle/Message/157.bmd|0x002BD7": "「ガ、ガッデス……さすがだな……！」", "Battle/Dat/Battle/Message/157.bmd|0x002C0E": "「くっ！　ザムジードを止められんのか！？」", "Battle/Dat/Battle/Message/157.bmd|0x002C4E": "「そんなもので我らを止められるものか！」", "Battle/Dat/Battle/Message/157.bmd|0x002C8B": "「甘く見てもらっては困る！」"}