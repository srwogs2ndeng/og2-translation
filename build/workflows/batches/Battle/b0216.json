{"Battle/Dat/Battle/Message/127.bmd|0x003F7E": "「ストレイト・アタック！」", "Battle/Dat/Battle/Message/127.bmd|0x003FA6": "「捉えたぞ！」", "Battle/Dat/Battle/Message/127.bmd|0x003FBC": "「ハハッ、次は！」", "Battle/Dat/Battle/Message/127.bmd|0x003FD8": "「搗ち上げてやるよ！」", "Battle/Dat/Battle/Message/127.bmd|0x003FFA": "「さあ！」", "Battle/Dat/Battle/Message/127.bmd|0x00400A": "「仕上げだ！！」", "Battle/Dat/Battle/Message/127.bmd|0x004023": "「撒き散らせぇぇぇ！！」", "Battle/Dat/Battle/Message/127.bmd|0x004048": "「貫く！」", "Battle/Dat/Battle/Message/127.bmd|0x004058": "「まだ終わらん！」", "Battle/Dat/Battle/Message/127.bmd|0x004074": "「吹き飛べぇぇ！！」", "Battle/Dat/Battle/Message/127.bmd|0x004093": "「とどめだ！！」", "Battle/Dat/Battle/Message/127.bmd|0x0040AC": "「壊れろぉぉぉぉ！！」", "Battle/Dat/Battle/Message/127.bmd|0x0040CE": "「虚空の彼方へ消え去れ！」", "Battle/Dat/Battle/Message/127.bmd|0x0040F6": "「唸れ、トロニウム・レヴ！」", "Battle/Dat/Battle/Message/127.bmd|0x004121": "「マキシマム・シューート！！」", "Battle/Dat/Battle/Message/127.bmd|0x00414F": "「お前はもう終わりだ！！」", "Battle/Dat/Battle/Message/128.bmd|0x001E17": "「総員、奮闘せよ」", "Battle/Dat/Battle/Message/128.bmd|0x001E33": "「大義は我らにある。そう、我らにな……」", "Battle/Dat/Battle/Message/128.bmd|0x001E70": "「我らこそが地球圏の守護者だ。奮戦せよ」", "Battle/Dat/Battle/Message/128.bmd|0x001EAD": "「ガイアセイバーズの力を知らしめるのだ」", "Battle/Dat/Battle/Message/128.bmd|0x001EEA": "「大義は我らにあり。総員、奮闘せよ！」", "Battle/Dat/Battle/Message/128.bmd|0x001F24": "「イング、お前の力を試してやる」", "Battle/Dat/Battle/Message/128.bmd|0x001F55": "「これは試練なのだ、イング」", "Battle/Dat/Battle/Message/128.bmd|0x001F80": "「イング、お前は終極点へ辿りつけるか？」", "Battle/Dat/Battle/Message/128.bmd|0x001FBD": "「イング……これで死ぬようなら、お前は……」", "Battle/Dat/Battle/Message/128.bmd|0x002000": "「アリエイル、どのみちお前は……」", "Battle/Dat/Battle/Message/128.bmd|0x002034": "「お前もオヅヌと同じ運命を辿るがいい」", "Battle/Dat/Battle/Message/128.bmd|0x00206E": "「アリエイル、お前の宿命の時を早めてやろう」", "Battle/Dat/Battle/Message/128.bmd|0x0020B1": "「お前達のＴＥアブゾーバーは捨て石なのだよ」", "Battle/Dat/Battle/Message/128.bmd|0x0020F4": "「ツェントル・プロジェクトの成果を/　見せてもらおうか」", "Battle/Dat/Battle/Message/128.bmd|0x002147": "「ターミナス・エナジーは、私の道を開く……」", "Battle/Dat/Battle/Message/128.bmd|0x00218A": "「鋼龍戦隊……表舞台から失せろ」", "Battle/Dat/Battle/Message/128.bmd|0x0021BB": "「鋼龍戦隊……お前達はもう不要な存在だ」", "Battle/Dat/Battle/Message/128.bmd|0x0021F8": "「反乱分子は処分せねばな」", "Battle/Dat/Battle/Message/128.bmd|0x002220": "「お前達の役目は、我らが引き継いでやる……」", "Battle/Dat/Battle/Message/128.bmd|0x002263": "「お前達は我らに敗れ去る宿命なのだ」", "Battle/Dat/Battle/Message/128.bmd|0x00229A": "「フフ……お前達ではなく、/　我がガイアセイバーズこそが/　地球圏の守護者たり得るのだ」", "Battle/Dat/Battle/Message/128.bmd|0x00231B": "「ゲストを撃破せよ」", "Battle/Dat/Battle/Message/128.bmd|0x00233A": "「ゲスト……お前達は邪魔な存在だ」", "Battle/Dat/Battle/Message/128.bmd|0x00236E": "「ゲストを殲滅せよ」", "Battle/Dat/Battle/Message/128.bmd|0x00238D": "「異星人共を駆逐するのだ」", "Battle/Dat/Battle/Message/128.bmd|0x0023B5": "「フッ……クリスマス級は、/　スペースノア級を凌駕する」", "Battle/Dat/Battle/Message/128.bmd|0x002408": "「ヒリュウ……あの艦の役目は、/　冥王星宙域戦で終わっていたのだがな」", "Battle/Dat/Battle/Message/128.bmd|0x002470": "「フッ、ＳＲＸチームか」", "Battle/Dat/Battle/Message/128.bmd|0x002495": "「まだＳＲＸ計画の/　真髄に到達出来ていないようだな」", "Battle/Dat/Battle/Message/128.bmd|0x0024E5": "「ＳＲＸ計画……/　今のままでは頓挫したも同然か」", "Battle/Dat/Battle/Message/128.bmd|0x00252F": "「総員、奮戦せよ」", "Battle/Dat/Battle/Message/128.bmd|0x00254B": "「彼らこそが、我らの本命……真の敵だ」", "Battle/Dat/Battle/Message/128.bmd|0x002585": "「ガイアセイバーズ……その名に恥じぬ戦いを」", "Battle/Dat/Battle/Message/128.bmd|0x0025C8": "「我が計画の邪魔はさせんぞ」", "Battle/Dat/Battle/Message/128.bmd|0x0025F3": "「直ちに反撃を！」", "Battle/Dat/Battle/Message/128.bmd|0x00260F": "「目標を逃がすな！」", "Battle/Dat/Battle/Message/128.bmd|0x00262E": "「反撃開始！」", "Battle/Dat/Battle/Message/128.bmd|0x002644": "「目標を追尾せよ！」", "Battle/Dat/Battle/Message/128.bmd|0x002663": "「……ここまでのようだな」", "Battle/Dat/Battle/Message/128.bmd|0x00268B": "「ここが引き際か……」", "Battle/Dat/Battle/Message/128.bmd|0x0026AD": "「おのれ、このようなことが！！」", "Battle/Dat/Battle/Message/128.bmd|0x0026DE": "「どう抗おうと/　お前達の行く末は決まっている……」", "Battle/Dat/Battle/Message/128.bmd|0x00272B": "「ほう……ここまでやるとはな」", "Battle/Dat/Battle/Message/128.bmd|0x002759": "「それがお前達の底力か」", "Battle/Dat/Battle/Message/128.bmd|0x00277E": "「ちっ、悪あがきを……！」", "Battle/Dat/Battle/Message/128.bmd|0x0027A6": "「ぬうっ、直撃か！」", "Battle/Dat/Battle/Message/128.bmd|0x0027C5": "「ふん、いかに抵抗しようとも……」", "Battle/Dat/Battle/Message/128.bmd|0x0027F9": "「フッ、いずれお前達も……」", "Battle/Dat/Battle/Message/128.bmd|0x002824": "「エア・クリスマスに/　ここまでのダメージを与えるとはな」", "Battle/Dat/Battle/Message/128.bmd|0x00287A": "「アリエイル、/　あがいたところでお前の宿命は変わらんぞ」", "Battle/Dat/Battle/Message/128.bmd|0x0028D0": "「フフ……惜しいな、アリエイル」", "Battle/Dat/Battle/Message/128.bmd|0x002901": "「それなりの成果は挙がっているようだな」", "Battle/Dat/Battle/Message/128.bmd|0x00293E": "「そのＴＥアブゾーバーで/　私を倒すことは出来ん」", "Battle/Dat/Battle/Message/128.bmd|0x002988": "「そうだ、イング……/　お前に秘められた力を解き放て」", "Battle/Dat/Battle/Message/128.bmd|0x0029D8": "「イング、お前の可能性を見せろ」", "Battle/Dat/Battle/Message/128.bmd|0x002A09": "「イング、お前こそが私の……」", "Battle/Dat/Battle/Message/128.bmd|0x002A37": "「フフフ……意地を見せたか、鋼龍戦隊」", "Battle/Dat/Battle/Message/128.bmd|0x002A71": "「さすがは鋼龍戦隊……と言っておこう」", "Battle/Dat/Battle/Message/128.bmd|0x002AAB": "「ＳＲＸ計画…………/　予備策としての使い道はある」", "Battle/Dat/Battle/Message/128.bmd|0x002AF8": "「お前達のＳＲＸ計画は、歪められている」", "Battle/Dat/Battle/Message/128.bmd|0x002B35": "「ほう、やるな」", "Battle/Dat/Battle/Message/128.bmd|0x002B4E": "「次はどのような手で来るつもりだ？」", "Battle/Dat/Battle/Message/128.bmd|0x002B85": "「こちらの耐久力を甘く見るな」", "Battle/Dat/Battle/Message/128.bmd|0x002BB3": "「被弾箇所の報告を急げ」", "Battle/Dat/Battle/Message/128.bmd|0x002BD8": "「想定範囲内の損害だ。うろたえるな」", "Battle/Dat/Battle/Message/128.bmd|0x002C0F": "「今のはなかなかの手だった」", "Battle/Dat/Battle/Message/128.bmd|0x002C3A": "「邪魔者は早急に排除せねばな……」", "Battle/Dat/Battle/Message/128.bmd|0x002C6E": "「直撃か……面白い」", "Battle/Dat/Battle/Message/128.bmd|0x002C8D": "「あくまで我らに楯突くか、アリエイル」", "Battle/Dat/Battle/Message/128.bmd|0x002CC7": "「フン、イデアラントごときが……」", "Battle/Dat/Battle/Message/128.bmd|0x002CFB": "「所詮、あの機体は予備策の一つに過ぎん……」", "Battle/Dat/Battle/Message/128.bmd|0x002D3E": "「イング、遠慮をする必要はないぞ」", "Battle/Dat/Battle/Message/128.bmd|0x002D72": "「それでいいのだ、イング」", "Battle/Dat/Battle/Message/128.bmd|0x002D9A": "「まだだ。まだ足りんぞ、イング」", "Battle/Dat/Battle/Message/128.bmd|0x002DCB": "「フン…………諦めの悪さは鋼龍戦隊の特徴か」", "Battle/Dat/Battle/Message/128.bmd|0x002E0E": "「どうした？　鋼龍戦隊の意地を見せてみろ」", "Battle/Dat/Battle/Message/128.bmd|0x002E4E": "「凡庸な攻撃だな、ＳＲＸチーム」", "Battle/Dat/Battle/Message/128.bmd|0x002E7F": "「やはり、お前達は/　ＳＲＸ計画の真髄を理解していない」", "Battle/Dat/Battle/Message/128.bmd|0x002ED2": "「つまらぬ手だ」", "Battle/Dat/Battle/Message/128.bmd|0x002EEB": "「この程度か」", "Battle/Dat/Battle/Message/128.bmd|0x002F01": "「ふん……思いの外、非力だな」", "Battle/Dat/Battle/Message/128.bmd|0x002F2F": "「各員、冷静に対処せよ」", "Battle/Dat/Battle/Message/128.bmd|0x002F54": "「そんなものでエア・クリスマスは止められん」", "Battle/Dat/Battle/Message/128.bmd|0x002F97": "「ほう、エア・クリスマスに目を付けたか」", "Battle/Dat/Battle/Message/128.bmd|0x002FD4": "「他愛のない相手だ」", "Battle/Dat/Battle/Message/128.bmd|0x002FF3": "「非力だな、アリエイル」", "Battle/Dat/Battle/Message/128.bmd|0x003018": "「アリエイル……やはり、お前は……」", "Battle/Dat/Battle/Message/128.bmd|0x00304F": "「ターミナス・エナジーを/　有効に使えていないな」", "Battle/Dat/Battle/Message/128.bmd|0x003099": "「どうした、イング？　それで終わりか？」", "Battle/Dat/Battle/Message/128.bmd|0x0030D6": "「お前の力は、その程度ではあるまい」", "Battle/Dat/Battle/Message/128.bmd|0x00310D": "「イング……私を失望させるな」", "Battle/Dat/Battle/Message/128.bmd|0x00313B": "「フン、蛮勇だけでこの艦は沈められんぞ」", "Battle/Dat/Battle/Message/128.bmd|0x003178": "「鋼龍戦隊の力は、そんなものではなかろう？」", "Battle/Dat/Battle/Message/128.bmd|0x0031BB": "「鋼龍戦隊など、恐るるに足らん」", "Battle/Dat/Battle/Message/128.bmd|0x0031EC": "「Ｌ５戦役の勝者らしからぬ力だな」", "Battle/Dat/Battle/Message/128.bmd|0x003220": "「ＳＲＸチーム、彼らの利用価値は……」", "Battle/Dat/Battle/Message/128.bmd|0x00325A": "「その程度か。/　ＳＲＸチームは人選を誤ったようだな」", "Battle/Dat/Battle/Message/128.bmd|0x0032AA": "「その程度でこの艦に挑んでくるとはな」", "Battle/Dat/Battle/Message/128.bmd|0x0032E4": "「我らに歯向かう愚かさを知れ」", "Battle/Dat/Battle/Message/128.bmd|0x003312": "「戦いでは常に先手を読むことが肝要だ」", "Battle/Dat/Battle/Message/128.bmd|0x00334C": "「エア・クリスマスを甘く見るな」", "Battle/Dat/Battle/Message/128.bmd|0x00337D": "「フッ、面白い見せ物だった」", "Battle/Dat/Battle/Message/128.bmd|0x0033A8": "「いいぞ、操舵手。私の読み通りだ」", "Battle/Dat/Battle/Message/128.bmd|0x0033DC": "「よし、このまま反撃に移る」"}