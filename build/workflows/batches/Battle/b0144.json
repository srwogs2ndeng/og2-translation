{"Battle/Dat/Battle/Message/069.bmd|0x005DD5": "「眩しかったけど、何とかかわせた！」", "Battle/Dat/Battle/Message/069.bmd|0x005E0C": "「ふふっ、こういう装備もあるんだよ」", "Battle/Dat/Battle/Message/069.bmd|0x005E43": "「全部もらっちゃうわけには/　いかないからね！」", "Battle/Dat/Battle/Message/069.bmd|0x005E8A": "「おっとっと、危ない危ない」", "Battle/Dat/Battle/Message/069.bmd|0x005EB5": "「無駄、無駄！」", "Battle/Dat/Battle/Message/069.bmd|0x005ECE": "「ミサイルなんて効かないよ！」", "Battle/Dat/Battle/Message/069.bmd|0x005EFC": "「さあさあ、帰った帰った！」", "Battle/Dat/Battle/Message/069.bmd|0x005F27": "「あたしを狙ったって無駄だよ！」", "Battle/Dat/Battle/Message/069.bmd|0x005F58": "「………」", "Battle/Dat/Battle/Message/069.bmd|0x005F68": "「あ、あれ！？　どうなってんの！？」", "Battle/Dat/Battle/Message/069.bmd|0x005F9F": "「こんな所で弾切れなんて、/　冗談じゃないよ！」", "Battle/Dat/Battle/Message/069.bmd|0x005FE6": "「あいつ、どこに行ったの！？」", "Battle/Dat/Battle/Message/069.bmd|0x006014": "「もう！　また一からやり直しじゃない！」", "Battle/Dat/Battle/Message/069.bmd|0x006051": "「ＯＫ、ＯＫ！　バックコーラスは任せて！」", "Battle/Dat/Battle/Message/069.bmd|0x006091": "「あたしの出番が来たわね！」", "Battle/Dat/Battle/Message/069.bmd|0x0060BC": "「泣きっ面に蜂！　弱り目にカーラさん！」", "Battle/Dat/Battle/Message/069.bmd|0x0060F9": "「さあて、本番はここからだよ！」", "Battle/Dat/Battle/Message/069.bmd|0x00612A": "「いただきっ！」", "Battle/Dat/Battle/Message/069.bmd|0x006143": "「ユウ！　後はお任せ！」", "Battle/Dat/Battle/Message/069.bmd|0x006168": "「さっすが～、ユウ！　あたしも続くよ！」", "Battle/Dat/Battle/Message/069.bmd|0x0061A5": "「ユウ、ちゃんとついてってるからね！」", "Battle/Dat/Battle/Message/069.bmd|0x0061DF": "「クスハ、後は任せて！」", "Battle/Dat/Battle/Message/069.bmd|0x006204": "「リオ、見せ場をサンキュ！」", "Battle/Dat/Battle/Message/069.bmd|0x00622F": "「選手交代だよ、レオナ！」", "Battle/Dat/Battle/Message/069.bmd|0x006257": "「手伝うよ、ブリット！」", "Battle/Dat/Battle/Message/069.bmd|0x00627C": "「タスク、あたしも……/　って、聞いてないじゃん！」", "Battle/Dat/Battle/Message/069.bmd|0x0062C9": "「頼りにしてよね、リョウト！」", "Battle/Dat/Battle/Message/069.bmd|0x0062F7": "「頑張ってるじゃない、アラド！」", "Battle/Dat/Battle/Message/069.bmd|0x006328": "「ゼオラ、あたしがフォローするからね！」", "Battle/Dat/Battle/Message/069.bmd|0x006365": "「ゼンガー少佐、助太刀しちゃうよ！」", "Battle/Dat/Battle/Message/069.bmd|0x00639C": "「レーツェルさん、フォローはバッチリ！」", "Battle/Dat/Battle/Message/069.bmd|0x0063D9": "「王女様、あまり無茶しちゃダメだよ！」", "Battle/Dat/Battle/Message/069.bmd|0x006413": "「手伝うよ、ラトゥーニ！」", "Battle/Dat/Battle/Message/069.bmd|0x00643B": "「ラウル、力になるよ！」", "Battle/Dat/Battle/Message/069.bmd|0x006460": "「コウタ、後はあたしに任せて！」", "Battle/Dat/Battle/Message/069.bmd|0x006491": "「イング、後は任せて！」", "Battle/Dat/Battle/Message/069.bmd|0x0064B6": "「手伝うよ、トウマ！」", "Battle/Dat/Battle/Message/069.bmd|0x0064D8": "「ほな、こっちからも行くでぇ！」", "Battle/Dat/Battle/Message/069.bmd|0x006509": "「ミオ、後はお任せ！」", "Battle/Dat/Battle/Message/069.bmd|0x00652B": "「こういうとこで/　黙ってらんない性分なのよね！」", "Battle/Dat/Battle/Message/069.bmd|0x006575": "「ちょっと待って待ってぇっ！！」", "Battle/Dat/Battle/Message/069.bmd|0x0065A6": "「あたしの包容力、見せたげるよっ！」", "Battle/Dat/Battle/Message/069.bmd|0x0065DD": "「攻めてばっかじゃ、ダメだもんね！」", "Battle/Dat/Battle/Message/069.bmd|0x006614": "「余計なお世話なんて言わせないから！」", "Battle/Dat/Battle/Message/069.bmd|0x00664E": "「ユウ！/　あたしが代わりに受けとめるからね！」", "Battle/Dat/Battle/Message/069.bmd|0x006695": "「ユウをやらせるもんかっ！」", "Battle/Dat/Battle/Message/069.bmd|0x0066C0": "「リオ、早く逃げて！」", "Battle/Dat/Battle/Message/069.bmd|0x0066E2": "「クスハ、そこをどいて！」", "Battle/Dat/Battle/Message/069.bmd|0x00670A": "「レオナ、油断しちゃダメだよ！」", "Battle/Dat/Battle/Message/069.bmd|0x00673B": "「ブリット、早く逃げて！」", "Battle/Dat/Battle/Message/069.bmd|0x006763": "「ボーッとしちゃダメだよ、タスク！」", "Battle/Dat/Battle/Message/069.bmd|0x00679A": "「リョウト、ここはあたしに任せて！」", "Battle/Dat/Battle/Message/069.bmd|0x0067D1": "「アラド、道を空けて！」", "Battle/Dat/Battle/Message/069.bmd|0x0067F6": "「ゼオラ、後ろへ下がって！」", "Battle/Dat/Battle/Message/069.bmd|0x006821": "「ゼンガー少佐、/　あいつはあたしが引き受けるよ！」", "Battle/Dat/Battle/Message/069.bmd|0x00686E": "「レーツェルさん、今の内に！」", "Battle/Dat/Battle/Message/069.bmd|0x00689C": "「ラウル、前に出過ぎだよ！」", "Battle/Dat/Battle/Message/069.bmd|0x0068C7": "「コウタ、そこをどいて！」", "Battle/Dat/Battle/Message/069.bmd|0x0068EF": "「イング、下がって！」", "Battle/Dat/Battle/Message/069.bmd|0x006911": "「トウマ、無茶しちゃ駄目だよ！」", "Battle/Dat/Battle/Message/069.bmd|0x006942": "「早く下がれっちゅーてんねん！」", "Battle/Dat/Battle/Message/069.bmd|0x006973": "「危ないよ、ミオ！」", "Battle/Dat/Battle/Message/069.bmd|0x006992": "「ワン、ツー、スリー！/　タイミングはバッチリ！」", "Battle/Dat/Battle/Message/069.bmd|0x0069DC": "「ほらほら！/　そんなポジションじゃいい的だよ！」", "Battle/Dat/Battle/Message/069.bmd|0x006A26": "「自分で自分を援護攻撃！」", "Battle/Dat/Battle/Message/069.bmd|0x006A4E": "「行くよ！　セルフ援護攻撃！」", "Battle/Dat/Battle/Message/069.bmd|0x006A7C": "「スプリットミサイル！」", "Battle/Dat/Battle/Message/069.bmd|0x006AA1": "「マトリクス・ミサイル、発射！」", "Battle/Dat/Battle/Message/069.bmd|0x006AD2": "「照準ＯＫ！/　マトリクス・ミサイル、ファイア！」", "Battle/Dat/Battle/Message/069.bmd|0x006B1C": "「これでキメ！！」", "Battle/Dat/Battle/Message/069.bmd|0x006B38": "「確実に当てていくんだから！」", "Battle/Dat/Battle/Message/069.bmd|0x006B66": "「ハイ・ツインランチャー！！」", "Battle/Dat/Battle/Message/069.bmd|0x006B94": "「行っけぇ！！」", "Battle/Dat/Battle/Message/069.bmd|0x006BAD": "「直撃いただきっ！！」", "Battle/Dat/Battle/Message/069.bmd|0x006BCF": "「まとめていただきよ！！」", "Battle/Dat/Battle/Message/069.bmd|0x006BF7": "「ここがマップ兵器の使いどころっ！！」", "Battle/Dat/Battle/Message/069.bmd|0x006C31": "「今度のは２本！　威力も２倍だよ！！」", "Battle/Dat/Battle/Message/069.bmd|0x006C6B": "「ツイン・リニアカノン、発射！！」", "Battle/Dat/Battle/Message/069.bmd|0x006C9F": "「ツイン・リニアカノン！　撃ち抜けっ！」", "Battle/Dat/Battle/Message/069.bmd|0x006CDC": "「タイミングを合わせて……！」", "Battle/Dat/Battle/Message/069.bmd|0x006D0A": "「命中率は１００％！」", "Battle/Dat/Battle/Message/069.bmd|0x006D2C": "「そ～れっ！　行っけぇっ！！」", "Battle/Dat/Battle/Message/069.bmd|0x006D5A": "「そーれっ！」", "Battle/Dat/Battle/Message/069.bmd|0x006D70": "「あたしの華麗なステップ、見せてあげるよ！」", "Battle/Dat/Battle/Message/069.bmd|0x006DB3": "「これでフィニッシュ！！」", "Battle/Dat/Battle/Message/069.bmd|0x006DDB": "「バーンとブレイクフィールド！」", "Battle/Dat/Battle/Message/069.bmd|0x006E0C": "「クイックステップ！　ゲット・サイト！」", "Battle/Dat/Battle/Message/069.bmd|0x006E49": "「ファング・スラッシャー！！」", "Battle/Dat/Battle/Message/069.bmd|0x006E77": "「そこねっ！」", "Battle/Dat/Battle/Message/069.bmd|0x006E8D": "「グラマーインパクト・キャノン！　発射！！」", "Battle/Dat/Battle/Message/069.bmd|0x006ED0": "「こいつで勝負！」", "Battle/Dat/Battle/Message/069.bmd|0x006EEC": "「切り捨て御免っ！！」", "Battle/Dat/Battle/Message/069.bmd|0x006F0E": "「知ってた？　カブトムシより、/　クワガタの方が強いんだよ！」", "Battle/Dat/Battle/Message/069.bmd|0x006F6A": "「決めるよ、ビルガー！」", "Battle/Dat/Battle/Message/069.bmd|0x006F8F": "「こうなったら奥の手！」", "Battle/Dat/Battle/Message/069.bmd|0x006FB4": "「シェイプアップだよ、ビルガー！」", "Battle/Dat/Battle/Message/069.bmd|0x006FE8": "「スピードは当社比１．２倍！」", "Battle/Dat/Battle/Message/069.bmd|0x007016": "「ラストはビシッと……」", "Battle/Dat/Battle/Message/069.bmd|0x00703B": "「ビクティム・ビーク！！」", "Battle/Dat/Battle/Message/069.bmd|0x007063": "「狙いとタイミングはバッチリ！」", "Battle/Dat/Battle/Message/069.bmd|0x007094": "「遠慮せず受け取ってよね！」", "Battle/Dat/Battle/Message/069.bmd|0x0070BF": "「絶対に当ててやるからっ！」", "Battle/Dat/Battle/Message/069.bmd|0x0070EA": "「射撃もダンスもリズムは一緒！」", "Battle/Dat/Battle/Message/069.bmd|0x00711B": "「ビートに乗せて、ダブルシュート！！」", "Battle/Dat/Battle/Message/069.bmd|0x007155": "「このリズム、ワルツじゃなくてサンバかな」", "Battle/Dat/Battle/Message/069.bmd|0x007195": "「行くよ、オクスタン！　そぉぉれっ！！」", "Battle/Dat/Battle/Message/069.bmd|0x0071D2": "「行くよ！　Ｇ・サークルブラスター！！」", "Battle/Dat/Battle/Message/069.bmd|0x00720F": "「火傷するよ！/　ギガ・ワイドブラスター！！」", "Battle/Dat/Battle/Message/069.bmd|0x007253": "「行くよ、ジガン！/　あんたの拳は百万ボルト！！」", "Battle/Dat/Battle/Message/069.bmd|0x00729D": "「ハートごとシビれさせてあげるよっ！！」", "Battle/Dat/Battle/Message/069.bmd|0x0072DA": "「照準ＯＫ！」", "Battle/Dat/Battle/Message/069.bmd|0x0072F0": "「ハルバート・ランチャー、ファイア！」", "Battle/Dat/Battle/Message/069.bmd|0x00732A": "「ちゃんと追いかけてね！」", "Battle/Dat/Battle/Message/069.bmd|0x007352": "「ソードブレイカー！　レッツゴーッ！！」", "Battle/Dat/Battle/Message/069.bmd|0x00738F": "「こいつはとっておきの武器だよ！/　とっといて！！」", "Battle/Dat/Battle/Message/069.bmd|0x0073DC": "「グラビトン・ランチャー！　行っけぇ！」", "Battle/Dat/Battle/Message/069.bmd|0x007419": "「ブッ飛ばしてやるんだから！」", "Battle/Dat/Battle/Message/069.bmd|0x007447": "「ガツーンと行くよ！　ガツーンと！！」", "Battle/Dat/Battle/Message/069.bmd|0x007481": "「抜いたら凄いんだからっ！！」", "Battle/Dat/Battle/Message/069.bmd|0x0074AF": "「秘剣！　獅子王千枚おろし！！」"}