{"Battle/Dat/Battle/Message/152.bmd|0x0091F7": "「甘い！」", "Battle/Dat/Battle/Message/152.bmd|0x009207": "「当たるか！」", "Battle/Dat/Battle/Message/152.bmd|0x00921D": "「ガイアセイバーズを甘く見るな！」", "Battle/Dat/Battle/Message/152.bmd|0x009251": "「遅い！」", "Battle/Dat/Battle/Message/152.bmd|0x009261": "「どこを見ている！」", "Battle/Dat/Battle/Message/152.bmd|0x009280": "「ちゃんと狙え！」", "Battle/Dat/Battle/Message/152.bmd|0x00929C": "「ガイアセイバーズに刃向かう愚かさを知れ！」", "Battle/Dat/Battle/Message/152.bmd|0x0092DF": "「その程度！」", "Battle/Dat/Battle/Message/152.bmd|0x0092F5": "「そんなもの！」", "Battle/Dat/Battle/Message/152.bmd|0x00930E": "「残念だったな！」", "Battle/Dat/Battle/Message/152.bmd|0x00932A": "「無駄だ！」", "Battle/Dat/Battle/Message/152.bmd|0x00933D": "「その手は食わんぞ！」", "Battle/Dat/Battle/Message/152.bmd|0x00935F": "「………」", "Battle/Dat/Battle/Message/152.bmd|0x00936F": "「くっ、反撃できん！」", "Battle/Dat/Battle/Message/152.bmd|0x009391": "「後退するしかないか！」", "Battle/Dat/Battle/Message/152.bmd|0x0093B6": "「手も足も出せんとは！」", "Battle/Dat/Battle/Message/152.bmd|0x0093DB": "「このままでは的になる！」", "Battle/Dat/Battle/Message/152.bmd|0x009403": "「奴らに乗せられたか！」", "Battle/Dat/Battle/Message/152.bmd|0x009428": "「くっ、補給せねば！」", "Battle/Dat/Battle/Message/152.bmd|0x00944A": "「うぬっ、使える武器は！？」", "Battle/Dat/Battle/Message/152.bmd|0x009475": "「くっ、この間合いでは……！」", "Battle/Dat/Battle/Message/152.bmd|0x0094A3": "「奴め、どこへ行った！？」", "Battle/Dat/Battle/Message/152.bmd|0x0094CB": "「くそっ、どこから攻撃して来た！？」", "Battle/Dat/Battle/Message/152.bmd|0x009502": "「チッ、奴はどこにいる！？」", "Battle/Dat/Battle/Message/152.bmd|0x00952D": "「ええい、これでは狙い撃ちされる！」", "Battle/Dat/Battle/Message/152.bmd|0x009564": "「死角に入られたか！」", "Battle/Dat/Battle/Message/152.bmd|0x009586": "「続けて行く！」", "Battle/Dat/Battle/Message/152.bmd|0x00959F": "「まだ俺がいる！」", "Battle/Dat/Battle/Message/152.bmd|0x0095BB": "「逃げ損なったか！」", "Battle/Dat/Battle/Message/152.bmd|0x0095DA": "「まだ終わりじゃない！」", "Battle/Dat/Battle/Message/152.bmd|0x0095FF": "「ねじ込んでやる！」", "Battle/Dat/Battle/Message/152.bmd|0x00961E": "「よし、援護を！」", "Battle/Dat/Battle/Message/152.bmd|0x00963A": "「やらせるものか！」", "Battle/Dat/Battle/Message/152.bmd|0x009659": "「受け止めてみせる！」", "Battle/Dat/Battle/Message/152.bmd|0x00967B": "「やらせん！」", "Battle/Dat/Battle/Message/152.bmd|0x009691": "「お前の相手は俺だ！」", "Battle/Dat/Battle/Message/152.bmd|0x0096B3": "「割り込む！」", "Battle/Dat/Battle/Message/152.bmd|0x0096C9": "「俺が盾になれば！」", "Battle/Dat/Battle/Message/152.bmd|0x0096E8": "「こちらで受け止めれば！」", "Battle/Dat/Battle/Message/152.bmd|0x009710": "「運が悪かったな！」", "Battle/Dat/Battle/Message/152.bmd|0x00972F": "「こういう展開もある！」", "Battle/Dat/Battle/Message/152.bmd|0x009754": "「ふん、油断したな！」", "Battle/Dat/Battle/Message/152.bmd|0x009776": "「いい流れだ！　行ける！」", "Battle/Dat/Battle/Message/152.bmd|0x00979E": "「当たれよ！」", "Battle/Dat/Battle/Message/152.bmd|0x0097B4": "「こいつをくらえ！」", "Battle/Dat/Battle/Message/152.bmd|0x0097D3": "「もらったぞ！」", "Battle/Dat/Battle/Message/152.bmd|0x0097EC": "「おりゃあ！」", "Battle/Dat/Battle/Message/152.bmd|0x009802": "「でえいっ！」", "Battle/Dat/Battle/Message/152.bmd|0x009818": "「これなら！」", "Battle/Dat/Battle/Message/152.bmd|0x00982E": "「この距離なら！」", "Battle/Dat/Battle/Message/152.bmd|0x00984A": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/152.bmd|0x00986F": "「落ちろぉっ！！」", "Battle/Dat/Battle/Message/152.bmd|0x00988B": "「捉えたぞ！」", "Battle/Dat/Battle/Message/152.bmd|0x0098A1": "「照準ＯＫ！」", "Battle/Dat/Battle/Message/152.bmd|0x0098B7": "「行けぇっ！！」", "Battle/Dat/Battle/Message/152.bmd|0x0098D0": "「ターゲット・インサイト！」", "Battle/Dat/Battle/Message/152.bmd|0x0098FB": "「ロックオン！」", "Battle/Dat/Battle/Message/152.bmd|0x009914": "「沈めっ！！」", "Battle/Dat/Battle/Message/152.bmd|0x00992A": "「くらえ！」", "Battle/Dat/Battle/Message/152.bmd|0x00993D": "「受けてみろ！」", "Battle/Dat/Battle/Message/152.bmd|0x009956": "「この距離ならば！」", "Battle/Dat/Battle/Message/152.bmd|0x009975": "「この間合いなら！」", "Battle/Dat/Battle/Message/152.bmd|0x009994": "「そこだ！」", "Battle/Dat/Battle/Message/152.bmd|0x0099A7": "「当たれ！」", "Battle/Dat/Battle/Message/152.bmd|0x0099BA": "「受けろ！」", "Battle/Dat/Battle/Message/152.bmd|0x0099CD": "「直撃させる！」", "Battle/Dat/Battle/Message/152.bmd|0x0099E6": "「もらった！」", "Battle/Dat/Battle/Message/152.bmd|0x0099FC": "「叩き落とす！」", "Battle/Dat/Battle/Message/152.bmd|0x009A15": "「叩き落としてやる！」", "Battle/Dat/Battle/Message/152.bmd|0x009A37": "「キャスク・ミサイル！」", "Battle/Dat/Battle/Message/152.bmd|0x009A5C": "「キャスク・ミサイル、発射！」", "Battle/Dat/Battle/Message/152.bmd|0x009A8A": "「キャスク・ミサイルで！」", "Battle/Dat/Battle/Message/152.bmd|0x009AB2": "「くらえっ！！」", "Battle/Dat/Battle/Message/152.bmd|0x009ACB": "「避けられると思うな！」", "Battle/Dat/Battle/Message/152.bmd|0x009AF0": "「コンテナ、セット！　行けっ！！」", "Battle/Dat/Battle/Message/152.bmd|0x009B24": "「こいつからは逃げられん！」", "Battle/Dat/Battle/Message/152.bmd|0x009B4F": "「新型リオンの力を！」", "Battle/Dat/Battle/Message/152.bmd|0x009B71": "「見せてやる！」", "Battle/Dat/Battle/Message/152.bmd|0x009B8A": "「このミサイルは一味違うぞ！」", "Battle/Dat/Battle/Message/152.bmd|0x009BB8": "「行けぇぇっ！！」", "Battle/Dat/Battle/Message/152.bmd|0x009BD4": "「高速で追い詰める！」", "Battle/Dat/Battle/Message/152.bmd|0x009BF6": "「ハッチ開放！」", "Battle/Dat/Battle/Message/152.bmd|0x009C0F": "「ＭＴＤ誘導弾、発射！」", "Battle/Dat/Battle/Message/152.bmd|0x009C34": "「このサイリオンで翻弄してやる！」", "Battle/Dat/Battle/Message/152.bmd|0x009C68": "「テスラ・ドライブのミサイルだ！」", "Battle/Dat/Battle/Message/152.bmd|0x009C9C": "「かわすことなど出来ん！！」", "Battle/Dat/Battle/Message/152.bmd|0x009CC7": "「サイリオンからは逃げられんぞ！」", "Battle/Dat/Battle/Message/152.bmd|0x009CFB": "「このミサイルは特別製だ！」", "Battle/Dat/Battle/Message/152.bmd|0x009D26": "「ＭＴＤ誘導弾！　行けぇぇっ！！」", "Battle/Dat/Battle/Message/152.bmd|0x009D5A": "「サイリオンの真価を見せてやる！」", "Battle/Dat/Battle/Message/152.bmd|0x009D8E": "「ＴＤＡノーズ、セット！」", "Battle/Dat/Battle/Message/152.bmd|0x009DB6": "「行くぞ！　ブースト！！」", "Battle/Dat/Battle/Message/152.bmd|0x009DDE": "「ブレイク・フィールド！」", "Battle/Dat/Battle/Message/152.bmd|0x009E06": "「砕け散れぇぇぇっ！！」", "Battle/Dat/Battle/Message/152.bmd|0x009E2B": "「シーケンスＳＳＢ！」", "Battle/Dat/Battle/Message/152.bmd|0x009E4D": "「ロック・オン！」", "Battle/Dat/Battle/Message/152.bmd|0x009E69": "「見切ることなど出来んぞ！」", "Battle/Dat/Battle/Message/152.bmd|0x009E94": "「フィールド展開！」", "Battle/Dat/Battle/Message/152.bmd|0x009EB3": "「スーパー・ソニック・ブレイカー！！」", "Battle/Dat/Battle/Message/152.bmd|0x009EED": "「キャニスからは逃げられん！」", "Battle/Dat/Battle/Message/152.bmd|0x009F1B": "「ダブル・ガナリー、Ｗモード！」", "Battle/Dat/Battle/Message/152.bmd|0x009F4C": "「追い詰めてやる！」", "Battle/Dat/Battle/Message/152.bmd|0x009F6B": "「Ｗモード、ファイア！！」", "Battle/Dat/Battle/Message/152.bmd|0x009F93": "「飛べ、キャニス！」", "Battle/Dat/Battle/Message/152.bmd|0x009FB2": "「ダブル・ガナリー！　くらえ！」", "Battle/Dat/Battle/Message/153.bmd|0x0063F0": "「我らこそが外敵を討ち、/　地球を護る剣なのだ！」", "Battle/Dat/Battle/Message/153.bmd|0x00643A": "「地球圏の未来は、我らが切り開く！」", "Battle/Dat/Battle/Message/153.bmd|0x006471": "「前大戦のエースと言えど！」", "Battle/Dat/Battle/Message/153.bmd|0x00649C": "「叛乱分子を排除する！」", "Battle/Dat/Battle/Message/153.bmd|0x0064C1": "「鋼龍戦隊！　お前達の役目は終わった！」", "Battle/Dat/Battle/Message/153.bmd|0x0064FE": "「鋼龍戦隊、貴様らが犯した罪は重い！」", "Battle/Dat/Battle/Message/153.bmd|0x006538": "「鋼龍戦隊など、もはや無用の長物だ！」", "Battle/Dat/Battle/Message/153.bmd|0x006572": "「鋼龍戦隊、貴様らはここで終わりだ！」", "Battle/Dat/Battle/Message/153.bmd|0x0065AC": "「我らこそが地球の守護者だ！」", "Battle/Dat/Battle/Message/153.bmd|0x0065DA": "「ガイアセイバーズの名の下に、/　お前達を討つ！」", "Battle/Dat/Battle/Message/153.bmd|0x006624": "「裏切り者は死ね！」", "Battle/Dat/Battle/Message/153.bmd|0x006643": "「離反者を始末する！」", "Battle/Dat/Battle/Message/153.bmd|0x006665": "「ゲストの好きにはやらせん！」", "Battle/Dat/Battle/Message/153.bmd|0x006693": "「ゲスト機を撃破する！」", "Battle/Dat/Battle/Message/153.bmd|0x0066B8": "「ルイーナめ、我らが相手だ！」"}