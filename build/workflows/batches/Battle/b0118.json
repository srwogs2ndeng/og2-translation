{"Battle/Dat/Battle/Message/061.bmd|0x00769E": "「くっ、ジンライ……速いわね！」", "Battle/Dat/Battle/Message/061.bmd|0x0076CF": "「私を甘く見ないで！」", "Battle/Dat/Battle/Message/061.bmd|0x0076F1": "「さあ！　どんどんかかってらっしゃい！」", "Battle/Dat/Battle/Message/061.bmd|0x00772E": "「回避はスマートにねっ！」", "Battle/Dat/Battle/Message/061.bmd|0x007756": "「しつこいのは嫌いなの！」", "Battle/Dat/Battle/Message/061.bmd|0x00777E": "「その手に乗るもんですか！」", "Battle/Dat/Battle/Message/061.bmd|0x0077A9": "「そんなんじゃダメよ？」", "Battle/Dat/Battle/Message/061.bmd|0x0077CE": "「狙いが甘いわよ！」", "Battle/Dat/Battle/Message/061.bmd|0x0077ED": "「これぐらい、やってみせるわ！」", "Battle/Dat/Battle/Message/061.bmd|0x00781E": "「そう簡単には捕まらないんだから！」", "Battle/Dat/Battle/Message/061.bmd|0x007855": "「おととい来なさい！」", "Battle/Dat/Battle/Message/061.bmd|0x007877": "「スピードには自信があるもの！」", "Battle/Dat/Battle/Message/061.bmd|0x0078A8": "「伊達に隼って/　名付けられたわけじゃないのよ？」", "Battle/Dat/Battle/Message/061.bmd|0x0078F2": "「これぐらい、ファルケンなら余裕よ！」", "Battle/Dat/Battle/Message/061.bmd|0x00792C": "「当たらないわよ、エグレッタ！」", "Battle/Dat/Battle/Message/061.bmd|0x00795D": "「当たらないわ、シアン！」", "Battle/Dat/Battle/Message/061.bmd|0x007985": "「アルジャン・クラスと言っても……！」", "Battle/Dat/Battle/Message/061.bmd|0x0079BF": "「無駄よ、ドゥバン！」", "Battle/Dat/Battle/Message/061.bmd|0x0079E1": "「当たらないわよ、イグニス！」", "Battle/Dat/Battle/Message/061.bmd|0x007A0F": "「メリオルエッセ相手でも、/　互角に戦ってみせるわ！」", "Battle/Dat/Battle/Message/061.bmd|0x007A5F": "「甘いわよ、コンターギオ！」", "Battle/Dat/Battle/Message/061.bmd|0x007A8A": "「当たらないわ、ロフ！」", "Battle/Dat/Battle/Message/061.bmd|0x007AAF": "「仙人だと言っても！」", "Battle/Dat/Battle/Message/061.bmd|0x007AD1": "「絶望も破滅もお断りよ！」", "Battle/Dat/Battle/Message/061.bmd|0x007AF9": "「その斧を受けるわけにはいかないわ！」", "Battle/Dat/Battle/Message/061.bmd|0x007B33": "「ルイーナなんかに！」", "Battle/Dat/Battle/Message/061.bmd|0x007B55": "「ゲストにやられるわけには！」", "Battle/Dat/Battle/Message/061.bmd|0x007B83": "「妖機人なんかに！」", "Battle/Dat/Battle/Message/061.bmd|0x007BA2": "「ＡＩ１に取り込まれてたまるもんですか！」", "Battle/Dat/Battle/Message/061.bmd|0x007BE2": "「それで終わりかしら？」", "Battle/Dat/Battle/Message/061.bmd|0x007C07": "「どこ見てるの？　私はここよ！」", "Battle/Dat/Battle/Message/061.bmd|0x007C38": "「残念賞は出ないわよ！」", "Battle/Dat/Battle/Message/061.bmd|0x007C5D": "「よくやったわ、ファルケン！」", "Battle/Dat/Battle/Message/061.bmd|0x007C8B": "「いい感じね、ファルケン！」", "Battle/Dat/Battle/Message/061.bmd|0x007CB6": "「シエンヌ、私はここよ！」", "Battle/Dat/Battle/Message/061.bmd|0x007CDE": "「私もここで……/　あなた達にやられるわけにはいかない！」", "Battle/Dat/Battle/Message/061.bmd|0x007D34": "「シオ……当たらないわ」", "Battle/Dat/Battle/Message/061.bmd|0x007D59": "「アクイラ、私はここにいるわ！」", "Battle/Dat/Battle/Message/061.bmd|0x007D8A": "「だから、シャキッと喋りなさいよ！」", "Battle/Dat/Battle/Message/061.bmd|0x007DC1": "「セティ、私はここよ！」", "Battle/Dat/Battle/Message/061.bmd|0x007DE6": "「夏喃、あなたの手は通用しないわよ！」", "Battle/Dat/Battle/Message/061.bmd|0x007E20": "「ゼゼーナン！　悪あがきはよしなさい！」", "Battle/Dat/Battle/Message/061.bmd|0x007E5D": "「ヒュッケバインより/　スピードは上だけど……！」", "Battle/Dat/Battle/Message/061.bmd|0x007EA7": "「機体の動きは柔軟だけど……！」", "Battle/Dat/Battle/Message/061.bmd|0x007ED8": "「インスペクターよりはやるみたいだけど……」", "Battle/Dat/Battle/Message/061.bmd|0x007F1B": "「雀武王を振り切れた！」", "Battle/Dat/Battle/Message/061.bmd|0x007F40": "「いける……四凶とも戦える！」", "Battle/Dat/Battle/Message/061.bmd|0x007F6E": "「あんなのに組み付かれるのは御免よ！」", "Battle/Dat/Battle/Message/061.bmd|0x007FA8": "「ガンエデン……凄い攻撃ね……！」", "Battle/Dat/Battle/Message/061.bmd|0x007FDC": "「早くガンエデンを止めなきゃ……！」", "Battle/Dat/Battle/Message/061.bmd|0x008013": "「ユーゼス！　それでも私達は怯まない！」", "Battle/Dat/Battle/Message/061.bmd|0x008050": "「ジンライを振り切ったわ！」", "Battle/Dat/Battle/Message/061.bmd|0x00807B": "「ダブルＧと言っても！」", "Battle/Dat/Battle/Message/061.bmd|0x0080A0": "「こういう手もあるわよっ！」", "Battle/Dat/Battle/Message/061.bmd|0x0080CB": "「備えあれば、憂いなしよっ！」", "Battle/Dat/Battle/Message/061.bmd|0x0080F9": "「ジャマーのおかげで助かったわ！」", "Battle/Dat/Battle/Message/061.bmd|0x00812D": "「そんな攻撃、届かないわよ！」", "Battle/Dat/Battle/Message/061.bmd|0x00815B": "「………」", "Battle/Dat/Battle/Message/061.bmd|0x00816B": "「何も出来ないなんて……！」", "Battle/Dat/Battle/Message/061.bmd|0x008196": "「いけない！　敵を見失った！？」", "Battle/Dat/Battle/Message/061.bmd|0x0081C7": "「まだ行けるわ！」", "Battle/Dat/Battle/Message/061.bmd|0x0081E3": "「これでトドメよっ！」", "Battle/Dat/Battle/Message/061.bmd|0x008205": "「思い通りにいくもんですか！」", "Battle/Dat/Battle/Message/061.bmd|0x008233": "「アラド、いつものタイミングね！」", "Battle/Dat/Battle/Message/061.bmd|0x008267": "「アラド、フォーメーションＩで行くわ！」", "Battle/Dat/Battle/Message/061.bmd|0x0082A4": "「もう！　世話が焼けるんだからっ！」", "Battle/Dat/Battle/Message/061.bmd|0x0082DB": "「アラド！　どこ行くのよっ！？」", "Battle/Dat/Battle/Message/061.bmd|0x00830C": "「教導隊のコンビネーション、/　見せてあげるわ！」", "Battle/Dat/Battle/Message/061.bmd|0x008356": "「ラト、あなたは先に行って！」", "Battle/Dat/Battle/Message/061.bmd|0x008384": "「やっぱり息が合うわね、あの子とは！」", "Battle/Dat/Battle/Message/061.bmd|0x0083BE": "「わかったわ、ラト！　後は任せて！」", "Battle/Dat/Battle/Message/061.bmd|0x0083F5": "「ラミア少尉、援護します！」", "Battle/Dat/Battle/Message/061.bmd|0x008420": "「少尉、援護します！」", "Battle/Dat/Battle/Message/061.bmd|0x008442": "「シャイン王女、後は私が！」", "Battle/Dat/Battle/Message/061.bmd|0x00846D": "「ラーダさん、続けて攻撃します！」", "Battle/Dat/Battle/Message/061.bmd|0x0084A1": "「援護します、カイ少佐！」", "Battle/Dat/Battle/Message/061.bmd|0x0084C9": "「フィオナ、後は任せて！」", "Battle/Dat/Battle/Message/061.bmd|0x0084F1": "「ヒューゴ少尉、援護します！」", "Battle/Dat/Battle/Message/061.bmd|0x00851F": "「アクア少尉、続けて行きます！」", "Battle/Dat/Battle/Message/061.bmd|0x008550": "「ジョッシュさん、後は私が！」", "Battle/Dat/Battle/Message/061.bmd|0x00857E": "「リム、後は任せて！」", "Battle/Dat/Battle/Message/061.bmd|0x0085A0": "「アリエイル、後は私が！」", "Battle/Dat/Battle/Message/061.bmd|0x0085C8": "「トウマさん、援護します！」", "Battle/Dat/Battle/Message/061.bmd|0x0085F3": "「イング、後は任せて！」", "Battle/Dat/Battle/Message/061.bmd|0x008618": "「手伝うわ、ショウコ！」", "Battle/Dat/Battle/Message/061.bmd|0x00863D": "「ミオ、援護するわ！」", "Battle/Dat/Battle/Message/061.bmd|0x00865F": "「守ってみせるっ！」", "Battle/Dat/Battle/Message/061.bmd|0x00867E": "「もう！　世話が焼けるんだから！」", "Battle/Dat/Battle/Message/061.bmd|0x0086B2": "「ちょっと！　しっかりしなさいよっ！」", "Battle/Dat/Battle/Message/061.bmd|0x0086EC": "「アラド！？　何やってんのよ！」", "Battle/Dat/Battle/Message/061.bmd|0x00871D": "「アラド！　さっさと後退しなさい！」", "Battle/Dat/Battle/Message/061.bmd|0x008754": "「アラド！/　よそ見してる場合じゃないわよ！」", "Battle/Dat/Battle/Message/061.bmd|0x008798": "「もう！　アラドったら！」", "Battle/Dat/Battle/Message/061.bmd|0x0087C0": "「ラト、そこをどいて！」", "Battle/Dat/Battle/Message/061.bmd|0x0087E5": "「ラトをやらせるわけには！」", "Battle/Dat/Battle/Message/061.bmd|0x008810": "「下がってください、少尉！」", "Battle/Dat/Battle/Message/061.bmd|0x00883B": "「王女、危ないっ！」", "Battle/Dat/Battle/Message/061.bmd|0x00885A": "「少佐、早く離脱して下さい！」", "Battle/Dat/Battle/Message/061.bmd|0x008888": "「ラーダさん、今の内に！」", "Battle/Dat/Battle/Message/061.bmd|0x0088B0": "「ラミア少尉、そこから離脱して下さい！」", "Battle/Dat/Battle/Message/061.bmd|0x0088ED": "「フィオナ、早く下がって！」", "Battle/Dat/Battle/Message/061.bmd|0x008918": "「ヒューゴ少尉、下がってください！」", "Battle/Dat/Battle/Message/061.bmd|0x00894F": "「アクア少尉、すぐに離脱を！」", "Battle/Dat/Battle/Message/061.bmd|0x00897D": "「ジョッシュさん、後退して下さい！」", "Battle/Dat/Battle/Message/061.bmd|0x0089B4": "「リム、危ない！」", "Battle/Dat/Battle/Message/061.bmd|0x0089D0": "「アリエイル、下がって！」", "Battle/Dat/Battle/Message/061.bmd|0x0089F8": "「トウマさん、逃げて！」", "Battle/Dat/Battle/Message/061.bmd|0x008A1D": "「イング、後退して！」", "Battle/Dat/Battle/Message/061.bmd|0x008A3F": "「ショウコ、下がって！」", "Battle/Dat/Battle/Message/061.bmd|0x008A64": "「ミオ、後退して！」", "Battle/Dat/Battle/Message/061.bmd|0x008A83": "「一気に倒してやるから！」", "Battle/Dat/Battle/Message/061.bmd|0x008AAB": "「その位置が仇になったわね！」", "Battle/Dat/Battle/Message/061.bmd|0x008AD9": "「逃がさないんだから！」", "Battle/Dat/Battle/Message/061.bmd|0x008AFE": "「最後の一押しよっ！」", "Battle/Dat/Battle/Message/061.bmd|0x008B20": "「これも受けてもらうわよっ！」", "Battle/Dat/Battle/Message/061.bmd|0x008B4E": "「スプリットミサイル、シュートッ！！」", "Battle/Dat/Battle/Message/061.bmd|0x008B88": "「逃がさないっ！！」", "Battle/Dat/Battle/Message/061.bmd|0x008BA7": "「これで終わりよっ！！」", "Battle/Dat/Battle/Message/061.bmd|0x008BCC": "「射撃なら任せて！」", "Battle/Dat/Battle/Message/061.bmd|0x008BEB": "「ハイ・ツインランチャー！/　これで終わりよっ！」"}