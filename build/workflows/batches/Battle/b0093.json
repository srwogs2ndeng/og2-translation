{"Battle/Dat/Battle/Message/052.bmd|0x008EC5": "「少尉、後は私が！」", "Battle/Dat/Battle/Message/052.bmd|0x008EE4": "「あの子、やっていることはタスクと同じね」", "Battle/Dat/Battle/Message/052.bmd|0x008F24": "「スレイ、後は私に任せなさい」", "Battle/Dat/Battle/Message/052.bmd|0x008F52": "「援護するわ、スレイ」", "Battle/Dat/Battle/Message/052.bmd|0x008F74": "「援護するわ、マサキ」", "Battle/Dat/Battle/Message/052.bmd|0x008F96": "「リューネ、後は任せて」", "Battle/Dat/Battle/Message/052.bmd|0x008FBB": "「援護するわ、ジョッシュ」", "Battle/Dat/Battle/Message/052.bmd|0x008FE3": "「リム、後は任せなさい」", "Battle/Dat/Battle/Message/052.bmd|0x009008": "「援護するわ、アリエイル」", "Battle/Dat/Battle/Message/052.bmd|0x009030": "「イング、援護するわ」", "Battle/Dat/Battle/Message/052.bmd|0x009052": "「アイビス、後は私が」", "Battle/Dat/Battle/Message/052.bmd|0x009074": "「そちらの思い通りにはさせなくてよ！」", "Battle/Dat/Battle/Message/052.bmd|0x0090AE": "「あなたの相手は私がするわ！」", "Battle/Dat/Battle/Message/052.bmd|0x0090DC": "「私の存在を見落としていたようね！」", "Battle/Dat/Battle/Message/052.bmd|0x009113": "「タスク！　早く退避なさい！」", "Battle/Dat/Battle/Message/052.bmd|0x009141": "「どこを見ているの、タスク！」", "Battle/Dat/Battle/Message/052.bmd|0x00916F": "「タスク！　調子に乗ってはダメよ！」", "Battle/Dat/Battle/Message/052.bmd|0x0091A6": "「リオ、下がりなさい！」", "Battle/Dat/Battle/Message/052.bmd|0x0091CB": "「後退しなさい、クスハ！」", "Battle/Dat/Battle/Message/052.bmd|0x0091F3": "「カーラ、よそ見をしていてはダメよ！」", "Battle/Dat/Battle/Message/052.bmd|0x00922D": "「ブリット、早く離脱を！」", "Battle/Dat/Battle/Message/052.bmd|0x009255": "「リョウト、今の内に退避なさい！」", "Battle/Dat/Battle/Message/052.bmd|0x009289": "「ユウキ、私が時間を稼ぐわ！」", "Battle/Dat/Battle/Message/052.bmd|0x0092B7": "「ライディース……！/　あなたらしくないわね」", "Battle/Dat/Battle/Message/052.bmd|0x0092FB": "「中尉、今の内に後退を！」", "Battle/Dat/Battle/Message/052.bmd|0x009323": "「少尉、早く離脱を！」", "Battle/Dat/Battle/Message/052.bmd|0x009345": "「アラド、周りをよく見なさい！」", "Battle/Dat/Battle/Message/052.bmd|0x009376": "「スレイ！　早く離脱なさい！」", "Battle/Dat/Battle/Message/052.bmd|0x0093A4": "「スレイ、後退を！」", "Battle/Dat/Battle/Message/052.bmd|0x0093C3": "「マサキ、離脱を！」", "Battle/Dat/Battle/Message/052.bmd|0x0093E2": "「リューネ、下がって！」", "Battle/Dat/Battle/Message/052.bmd|0x009407": "「下がりなさい、ジョッシュ！」", "Battle/Dat/Battle/Message/052.bmd|0x009435": "「リム、離脱を！」", "Battle/Dat/Battle/Message/052.bmd|0x009451": "「アリエイル、後退を！」", "Battle/Dat/Battle/Message/052.bmd|0x009476": "「下がりなさい、イング！」", "Battle/Dat/Battle/Message/052.bmd|0x00949E": "「アイビス、離脱を！」", "Battle/Dat/Battle/Message/052.bmd|0x0094C0": "「フフッ……/　おあつらえ向きのフォーメーションね！」", "Battle/Dat/Battle/Message/052.bmd|0x009510": "「揃って同じ運命を辿りなさい！」", "Battle/Dat/Battle/Message/052.bmd|0x009541": "「そのフォーメーション、/　突き崩してあげるわ！」", "Battle/Dat/Battle/Message/052.bmd|0x00958B": "「まだ行ける！」", "Battle/Dat/Battle/Message/052.bmd|0x0095A4": "「これで仕留めてみせる！」", "Battle/Dat/Battle/Message/052.bmd|0x0095CC": "「逃げ切れなかったようね！」", "Battle/Dat/Battle/Message/052.bmd|0x0095F7": "「スプリットミサイル！」", "Battle/Dat/Battle/Message/052.bmd|0x00961C": "「受けなさい！」", "Battle/Dat/Battle/Message/052.bmd|0x009635": "「さあ、覚悟なさい！」", "Battle/Dat/Battle/Message/052.bmd|0x009657": "「射撃戦なら任せて！」", "Battle/Dat/Battle/Message/052.bmd|0x009679": "「ハイ・ツインランチャー、発射！」", "Battle/Dat/Battle/Message/052.bmd|0x0096AD": "「これでっ！」", "Battle/Dat/Battle/Message/052.bmd|0x0096C3": "「バレル展開！」", "Battle/Dat/Battle/Message/052.bmd|0x0096DC": "「ターゲット・インサイト！」", "Battle/Dat/Battle/Message/052.bmd|0x009707": "「私の前から消え失せなさい！」", "Battle/Dat/Battle/Message/052.bmd|0x009735": "「はあっ！」", "Battle/Dat/Battle/Message/052.bmd|0x009748": "「行くわよ、アーマリオン！」", "Battle/Dat/Battle/Message/052.bmd|0x009773": "「ソニック・ブーストキック！」", "Battle/Dat/Battle/Message/052.bmd|0x0097A1": "「このレールガンは一味違うわよ！」", "Battle/Dat/Battle/Message/052.bmd|0x0097D5": "「ここはブレードレールガンで！」", "Battle/Dat/Battle/Message/052.bmd|0x009806": "「この連撃から逃げられるかしら？」", "Battle/Dat/Battle/Message/052.bmd|0x00983A": "「ズィーガーリオンから/　逃げられると思わないことね！」", "Battle/Dat/Battle/Message/052.bmd|0x00988D": "「ブレイクフィールド、展開！」", "Battle/Dat/Battle/Message/052.bmd|0x0098BB": "「私の行く手を阻めば、待っているのは死よ！」", "Battle/Dat/Battle/Message/052.bmd|0x0098FE": "「あなたの不幸……/　それは私の前に現れたこと！」", "Battle/Dat/Battle/Message/052.bmd|0x009948": "「ズィーガーリオン……/　その名の通り、勝利を私に！」", "Battle/Dat/Battle/Message/052.bmd|0x009998": "「狙いはついた……あなたはもう終わり」", "Battle/Dat/Battle/Message/052.bmd|0x0099D2": "「疾風のように、空を駆ける！」", "Battle/Dat/Battle/Message/052.bmd|0x009A00": "「ソニック・アクセラレーション！！」", "Battle/Dat/Battle/Message/052.bmd|0x009A37": "「フルブースト！！」", "Battle/Dat/Battle/Message/052.bmd|0x009A56": "「オーバーブースト！　アタック！！」", "Battle/Dat/Battle/Message/052.bmd|0x009A8D": "「勝者となるのは、この私よ！」", "Battle/Dat/Battle/Message/052.bmd|0x009ABB": "「貫きなさい！　ズィーガーリオン！」", "Battle/Dat/Battle/Message/052.bmd|0x009AF2": "「蒼麗の閃光！　悪しき影を砕け！！」", "Battle/Dat/Battle/Message/052.bmd|0x009B29": "「この武器に死角はなくてよ！」", "Battle/Dat/Battle/Message/052.bmd|0x009B57": "「遠慮はいらない……/　全て受け取りなさい！」", "Battle/Dat/Battle/Message/052.bmd|0x009B9B": "「スラッシャー、セット！」", "Battle/Dat/Battle/Message/052.bmd|0x009BC3": "「行きなさい！」", "Battle/Dat/Battle/Message/052.bmd|0x009BDC": "「あなたにこれが見切れて？」", "Battle/Dat/Battle/Message/052.bmd|0x009C07": "「ファング・スラッシャー！」", "Battle/Dat/Battle/Message/052.bmd|0x009C32": "「ファング・スラッシャー、発射！」", "Battle/Dat/Battle/Message/052.bmd|0x009C66": "「リープ・ミサイル、発射！」", "Battle/Dat/Battle/Message/052.bmd|0x009C91": "「ターゲット・ロック！　ファイア！！」", "Battle/Dat/Battle/Message/052.bmd|0x009CCB": "「ブースト！　アタック！」", "Battle/Dat/Battle/Message/052.bmd|0x009CF3": "「ドリル・ブーストナックル！」", "Battle/Dat/Battle/Message/052.bmd|0x009D21": "「アタック！！」", "Battle/Dat/Battle/Message/052.bmd|0x009D3A": "「ドリル・ブーストナックル、発射！」", "Battle/Dat/Battle/Message/052.bmd|0x009D71": "「オメガ・ブラスター、最大出力！　発射！」", "Battle/Dat/Battle/Message/052.bmd|0x009DB1": "「行くわよ、ビルガー！」", "Battle/Dat/Battle/Message/052.bmd|0x009DD6": "「クラッシャー、セット！」", "Battle/Dat/Battle/Message/052.bmd|0x009DFE": "「つかまえた！」", "Battle/Dat/Battle/Message/052.bmd|0x009E17": "「ジャケットアーマー、パージ！」", "Battle/Dat/Battle/Message/052.bmd|0x009E48": "「飛びなさい、ビルガー！」", "Battle/Dat/Battle/Message/052.bmd|0x009E70": "「ブースト！」", "Battle/Dat/Battle/Message/052.bmd|0x009E86": "「もう一撃！」", "Battle/Dat/Battle/Message/052.bmd|0x009E9C": "「終わりよ！」", "Battle/Dat/Battle/Message/052.bmd|0x009EB2": "「ロック・オン……！/　スプリットミサイル、ファイア！」", "Battle/Dat/Battle/Message/052.bmd|0x009F05": "「ターゲット・インサイト……！　ファイア！」", "Battle/Dat/Battle/Message/052.bmd|0x009F48": "「モードセレクト、Ｗ……！」", "Battle/Dat/Battle/Message/052.bmd|0x009F73": "「あなたを貫いてあげる！」", "Battle/Dat/Battle/Message/052.bmd|0x009F9B": "「Ｇ・サークルブラスター、発射！」", "Battle/Dat/Battle/Message/052.bmd|0x009FCF": "「最強の盾も、使いようでは最強の矛となる！」", "Battle/Dat/Battle/Message/052.bmd|0x00A012": "「タスクに出来て、/　私に出来ないわけがないわ！」", "Battle/Dat/Battle/Message/052.bmd|0x00A05C": "「この暴風、/　あなたに受け止められるかしら！？」", "Battle/Dat/Battle/Message/052.bmd|0x00A0A6": "「これで終わりよ！/　ジガンテ・ウンギア！！」", "Battle/Dat/Battle/Message/052.bmd|0x00A0EA": "「受けなさい！　ジガンテ・ウンギア！！」", "Battle/Dat/Battle/Message/052.bmd|0x00A127": "「狙いはついたわ……！」", "Battle/Dat/Battle/Message/052.bmd|0x00A14C": "「ハルバート・ランチャー、発射！」", "Battle/Dat/Battle/Message/052.bmd|0x00A180": "「行きなさい！　ソードブレイカー！」", "Battle/Dat/Battle/Message/052.bmd|0x00A1B7": "「ターゲット・マルチロック！　ファイア！」", "Battle/Dat/Battle/Message/052.bmd|0x00A1F7": "「固まっていたのが、運の尽きよ！！」", "Battle/Dat/Battle/Message/052.bmd|0x00A22E": "「グラビトン・ランチャー、発射！」", "Battle/Dat/Battle/Message/052.bmd|0x00A262": "「獅子の牙を受けなさい！」", "Battle/Dat/Battle/Message/052.bmd|0x00A28A": "「シシオウブレード！！」", "Battle/Dat/Battle/Message/052.bmd|0x00A2AF": "「ターゲット・インサイト……！」", "Battle/Dat/Battle/Message/052.bmd|0x00A2E0": "「スラッシュ・リッパー、発射！」", "Battle/Dat/Battle/Message/052.bmd|0x00A311": "「リープ・スラッシャー、発射！」", "Battle/Dat/Battle/Message/052.bmd|0x00A342": "「行きなさい！　リープ・スラッシャー！」", "Battle/Dat/Battle/Message/052.bmd|0x00A37F": "「リボルビング・バンカー！」", "Battle/Dat/Battle/Message/052.bmd|0x00A3AA": "「撃ち抜く！」", "Battle/Dat/Battle/Message/052.bmd|0x00A3C0": "「クレイモア！」", "Battle/Dat/Battle/Message/052.bmd|0x00A3D9": "「まだここからよ！」", "Battle/Dat/Battle/Message/052.bmd|0x00A3F8": "「その身を貫くっ！！」", "Battle/Dat/Battle/Message/052.bmd|0x00A41A": "「あなたの運もここまでね……！」"}