{"Battle/Dat/Battle/Message/128.bmd|0x003407": "「油断するな。次の攻撃に備えろ」", "Battle/Dat/Battle/Message/128.bmd|0x003438": "「効きはせん」", "Battle/Dat/Battle/Message/128.bmd|0x00344E": "「無意味だな」", "Battle/Dat/Battle/Message/128.bmd|0x003464": "「ふん、無駄なあがきを」", "Battle/Dat/Battle/Message/128.bmd|0x003489": "「その手は通用せんぞ」", "Battle/Dat/Battle/Message/128.bmd|0x0034AB": "「ＥＰ展開！」", "Battle/Dat/Battle/Message/128.bmd|0x0034C1": "「………」", "Battle/Dat/Battle/Message/128.bmd|0x0034D1": "「敵に時間を与えるな！」", "Battle/Dat/Battle/Message/128.bmd|0x0034F6": "「弾薬の再装填を急げ！」", "Battle/Dat/Battle/Message/128.bmd|0x00351B": "「敵に時間を与えるな！　弾薬の再装填を！」", "Battle/Dat/Battle/Message/128.bmd|0x00355B": "「ふん、死角に入ったか」", "Battle/Dat/Battle/Message/128.bmd|0x003580": "「目標の再捕捉を！」", "Battle/Dat/Battle/Message/128.bmd|0x00359F": "「味方機を援護せよ！」", "Battle/Dat/Battle/Message/128.bmd|0x0035C1": "「続けて攻撃を！」", "Battle/Dat/Battle/Message/128.bmd|0x0035DD": "「最大戦速で突進せよ！」", "Battle/Dat/Battle/Message/128.bmd|0x003602": "「本艦で受け止める！」", "Battle/Dat/Battle/Message/128.bmd|0x003624": "「目標を再度攻撃！」", "Battle/Dat/Battle/Message/128.bmd|0x003643": "「これで仕留めてみせろ！」", "Battle/Dat/Battle/Message/128.bmd|0x00366B": "「ＥＡＡＭランチャー、攻撃用意！　撃て！」", "Battle/Dat/Battle/Message/128.bmd|0x0036AB": "「ＥＡＡＭランチャー、撃て！」", "Battle/Dat/Battle/Message/128.bmd|0x0036D9": "「副砲、１番から４番！　攻撃用意！」", "Battle/Dat/Battle/Message/128.bmd|0x003710": "「撃て！」", "Battle/Dat/Battle/Message/128.bmd|0x003720": "「前部副砲、攻撃用意！」", "Battle/Dat/Battle/Message/128.bmd|0x003745": "「前部副砲、攻撃用意！」　", "Battle/Dat/Battle/Message/128.bmd|0x00376D": "「１番から４番！　撃て！」", "Battle/Dat/Battle/Message/128.bmd|0x003795": "「艦長、仕留めてみせろ」", "Battle/Dat/Battle/Message/128.bmd|0x0037BA": "「了解。主砲、１番から５番！　撃て！！」", "Battle/Dat/Battle/Message/128.bmd|0x0037F7": "「艦長、任せるぞ」", "Battle/Dat/Battle/Message/128.bmd|0x003813": "「はっ。上部主砲、撃て！！」", "Battle/Dat/Battle/Message/128.bmd|0x00383E": "「艦長、遠慮はいらん。主砲を使え」", "Battle/Dat/Battle/Message/128.bmd|0x003872": "「了解。上部主砲、撃て！！」", "Battle/Dat/Battle/Message/128.bmd|0x00389D": "「主砲、１番から５番！　撃て！！」", "Battle/Dat/Battle/Message/128.bmd|0x0038D1": "「上部主砲、撃て！！」", "Battle/Dat/Battle/Message/128.bmd|0x0038F3": "「司令、/　ファー・ツリー・ブレードを使用します」", "Battle/Dat/Battle/Message/128.bmd|0x00393D": "「よかろう」", "Battle/Dat/Battle/Message/128.bmd|0x003950": "「ＦＴＢシーケンスへ移行！」", "Battle/Dat/Battle/Message/128.bmd|0x00397B": "「フィールド・ブレード、ＯＮ！」", "Battle/Dat/Battle/Message/128.bmd|0x0039AC": "「突撃せよ！！」", "Battle/Dat/Battle/Message/129.bmd|0x000C4F": "m「奴らを撃て」", "Battle/Dat/Battle/Message/129.bmd|0x000C66": "「障害物を一掃するのだ」", "Battle/Dat/Battle/Message/129.bmd|0x000C8B": "「攻撃を開始しろ」", "Battle/Dat/Battle/Message/129.bmd|0x000CA7": "「消え失せろ」", "Battle/Dat/Battle/Message/129.bmd|0x000CBD": "「俺の邪魔をするな」", "Battle/Dat/Battle/Message/129.bmd|0x000CDC": "「俺の子ら……/　マシンナリー・チルドレンが/　この世界を粛正するのだ」", "Battle/Dat/Battle/Message/129.bmd|0x000D45": "「不良品に興味はない」", "Battle/Dat/Battle/Message/129.bmd|0x000D67": "「消滅しろ、ゼンガー・ゾンボルト」", "Battle/Dat/Battle/Message/129.bmd|0x000D9B": "「死ね、ゼンガー」", "Battle/Dat/Battle/Message/129.bmd|0x000DB7": "「う、うおあああっ！！」", "Battle/Dat/Battle/Message/129.bmd|0x000DDC": "「ぐっ！　何をやっている！？」", "Battle/Dat/Battle/Message/129.bmd|0x000E0A": "「ここで奴らを消さねば、俺の計画が……！」", "Battle/Dat/Battle/Message/129.bmd|0x000E4A": "「うぐっ！　忌々しい旧人類共め！」", "Battle/Dat/Battle/Message/129.bmd|0x000E7E": "「欠陥品がここまでの力を発揮するとは……！」", "Battle/Dat/Battle/Message/129.bmd|0x000EC1": "「おのれ、ゼンガー……！　貴様だけは！」", "Battle/Dat/Battle/Message/129.bmd|0x000EFE": "「チッ、力押ししか出来ん輩が……！」", "Battle/Dat/Battle/Message/129.bmd|0x000F35": "「まったく、鬱陶しい連中だ」", "Battle/Dat/Battle/Message/129.bmd|0x000F60": "「無能な連中の相手をする時間はない」", "Battle/Dat/Battle/Message/129.bmd|0x000F97": "「損傷箇所の修理を急ぐのだ」", "Battle/Dat/Battle/Message/129.bmd|0x000FC2": "「くっ！　調子に乗るなよ……！」", "Battle/Dat/Battle/Message/129.bmd|0x000FF3": "「不良品ごときに倒される俺ではない」", "Battle/Dat/Battle/Message/129.bmd|0x00102A": "「ゼンガー……貴様のやり方は通用せんぞ」", "Battle/Dat/Battle/Message/129.bmd|0x001067": "「俺の計画を阻むことは出来んぞ」", "Battle/Dat/Battle/Message/129.bmd|0x001098": "「フッ……兵の代わりはいくらでもいるのでな」", "Battle/Dat/Battle/Message/129.bmd|0x0010DB": "「そんなものか。非力だな」", "Battle/Dat/Battle/Message/129.bmd|0x001103": "「低能だな、貴様は」", "Battle/Dat/Battle/Message/129.bmd|0x001122": "「所詮は欠陥品か……」", "Battle/Dat/Battle/Message/129.bmd|0x001144": "「ゼンガー……貴様は目障りだ」", "Battle/Dat/Battle/Message/129.bmd|0x001172": "「フン……無能な奴だ」", "Battle/Dat/Battle/Message/129.bmd|0x001194": "「無駄だ」", "Battle/Dat/Battle/Message/129.bmd|0x0011A4": "「フッ、当てただけではな」", "Battle/Dat/Battle/Message/129.bmd|0x0011CC": "「もっと別の手段を考えろ」", "Battle/Dat/Battle/Message/129.bmd|0x0011F4": "「………」", "Battle/Dat/Battle/Message/129.bmd|0x001204": "「チッ……何をしている？」", "Battle/Dat/Battle/Message/129.bmd|0x00122C": "「フン、こちらを翻弄する気か」", "Battle/Dat/Battle/Message/129.bmd|0x00125A": "「もっと頭を使え」", "Battle/Dat/Battle/Message/129.bmd|0x001276": "「ふふふ……残念だったな」", "Battle/Dat/Battle/Message/130.bmd|0x000DA6": "「ガイアセイバーズの力を知らしめよ！」", "Battle/Dat/Battle/Message/130.bmd|0x000DE0": "「総員、奮闘せよ！」", "Battle/Dat/Battle/Message/130.bmd|0x000DFF": "「反乱分子を処分するのだ！」", "Battle/Dat/Battle/Message/130.bmd|0x000E2A": "「反逆者に情けは無用！」", "Battle/Dat/Battle/Message/130.bmd|0x000E4F": "「鋼龍戦隊を撃破する！」", "Battle/Dat/Battle/Message/130.bmd|0x000E74": "「総員、対艦戦闘用意！」", "Battle/Dat/Battle/Message/130.bmd|0x000E99": "「目標、敵母艦！」", "Battle/Dat/Battle/Message/130.bmd|0x000EB5": "「鋼龍戦隊の母艦を沈めるぞ！」", "Battle/Dat/Battle/Message/130.bmd|0x000EE3": "「直ちに反撃を！」", "Battle/Dat/Battle/Message/130.bmd|0x000EFF": "「目標を逃がすな！」", "Battle/Dat/Battle/Message/130.bmd|0x000F1E": "「反撃開始！」", "Battle/Dat/Battle/Message/130.bmd|0x000F34": "「目標を追尾せよ！」", "Battle/Dat/Battle/Message/130.bmd|0x000F53": "「ここまでか！　総員退避！！」", "Battle/Dat/Battle/Message/130.bmd|0x000F81": "「うぬうっ！　遺憾ながら艦を放棄する！」", "Battle/Dat/Battle/Message/130.bmd|0x000FBE": "「な、何っ！？　馬鹿な！！」", "Battle/Dat/Battle/Message/130.bmd|0x000FE9": "「そ、総員直ちに退艦せよ！！」", "Battle/Dat/Battle/Message/130.bmd|0x001017": "「いかん、これ以上は！！」", "Battle/Dat/Battle/Message/130.bmd|0x00103F": "「ええい！　急いでダメコンを！」", "Battle/Dat/Battle/Message/130.bmd|0x001070": "「くうっ！　敵機をこれ以上近寄らせるな！」", "Battle/Dat/Battle/Message/130.bmd|0x0010B0": "「立て直せ！　戦いはまだこれからだ！」", "Battle/Dat/Battle/Message/130.bmd|0x0010EA": "「周辺の機体を直掩に当たらせろ！」", "Battle/Dat/Battle/Message/130.bmd|0x00111E": "「こ、ここで沈んではならん！」", "Battle/Dat/Battle/Message/130.bmd|0x00114C": "「ぬううっ！/　ガイアセイバーズに敗北は許されんのだ！」", "Battle/Dat/Battle/Message/130.bmd|0x00119F": "「直撃か！　被弾箇所を知らせ！」", "Battle/Dat/Battle/Message/130.bmd|0x0011D0": "「この程度で本艦は沈まん」", "Battle/Dat/Battle/Message/130.bmd|0x0011F8": "「うろたえるな。冷静に対処しろ！」", "Battle/Dat/Battle/Message/130.bmd|0x00122C": "「ちいっ、本艦を集中的に狙って来たか！」", "Battle/Dat/Battle/Message/130.bmd|0x001269": "「くうっ！　弾幕をもっと厚くしろ！」", "Battle/Dat/Battle/Message/130.bmd|0x0012A0": "「ガイアセイバーズは、/　この程度では怯まんのだ！」", "Battle/Dat/Battle/Message/130.bmd|0x0012ED": "「操舵手！　回避が遅いぞ！」", "Battle/Dat/Battle/Message/130.bmd|0x001318": "「被弾箇所を報告せよ！」", "Battle/Dat/Battle/Message/130.bmd|0x00133D": "「構うな、攻撃に専念しろ！」", "Battle/Dat/Battle/Message/130.bmd|0x001368": "「各砲座、敵機を接近させるな！」", "Battle/Dat/Battle/Message/130.bmd|0x001399": "「フン、本艦に狙いを定めたか」", "Battle/Dat/Battle/Message/130.bmd|0x0013C7": "「ほう……ガイアセイバーズに/　刃向かうだけのことはあるな」", "Battle/Dat/Battle/Message/130.bmd|0x001420": "「当たりはしない」", "Battle/Dat/Battle/Message/130.bmd|0x00143C": "「よし、よくかわした」", "Battle/Dat/Battle/Message/130.bmd|0x00145E": "「的になるつもりはない」", "Battle/Dat/Battle/Message/130.bmd|0x001483": "「………」", "Battle/Dat/Battle/Message/130.bmd|0x001493": "「効きはせん！」", "Battle/Dat/Battle/Message/130.bmd|0x0014AC": "「無駄だ」", "Battle/Dat/Battle/Message/130.bmd|0x0014BC": "「その手は通用せん」", "Battle/Dat/Battle/Message/130.bmd|0x0014DB": "「そんな攻撃に！」", "Battle/Dat/Battle/Message/130.bmd|0x0014F7": "「これだけの砲塔があって、/　弾切れなどと……！」", "Battle/Dat/Battle/Message/130.bmd|0x001541": "「再装填を急がせろ！」"}