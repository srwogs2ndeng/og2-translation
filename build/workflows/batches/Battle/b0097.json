{"Battle/Dat/Battle/Message/053.bmd|0x009806": "「こいつで切り刻んでやる！」", "Battle/Dat/Battle/Message/053.bmd|0x009831": "「行け！　スラッシュ・リッパー！」", "Battle/Dat/Battle/Message/053.bmd|0x009865": "「ヘッ……こいつを持ってりゃ、/　アルトになれるってか？」", "Battle/Dat/Battle/Message/053.bmd|0x0098BB": "「撃ちブチ貫いてやる！！」", "Battle/Dat/Battle/Message/053.bmd|0x0098E3": "「ハッ、まさにあたし向きの得物じゃねえか！」", "Battle/Dat/Battle/Message/053.bmd|0x009926": "「どつく！　ひたすらどつき倒す！！」", "Battle/Dat/Battle/Message/053.bmd|0x00995D": "「ブーストハンマーを……/　くらいやがれぇっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x0099A7": "「へへ、好きだぜ……この手の得物はよ！！」", "Battle/Dat/Battle/Message/053.bmd|0x0099E7": "「こいつの切れ味は格段に違うぜ！」", "Battle/Dat/Battle/Message/053.bmd|0x009A1B": "「ヘッ、微塵切りなら得意だぜ！！」", "Battle/Dat/Battle/Message/053.bmd|0x009A4F": "「散りなっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x009A68": "「あたしに刃物を握らせるとどうなるか……/　教えてやる！！」", "Battle/Dat/Battle/Message/053.bmd|0x009AC1": "「現実の厳しさを教えてやる！」", "Battle/Dat/Battle/Message/053.bmd|0x009AEF": "「暴れんじゃねえぞ。撃ち落とすからよ！」", "Battle/Dat/Battle/Message/053.bmd|0x009B2C": "「あいつはあたしが落とす！」", "Battle/Dat/Battle/Message/053.bmd|0x009B57": "「突っ込め、アルト！」", "Battle/Dat/Battle/Message/053.bmd|0x009B79": "「さあ、天国まで！」", "Battle/Dat/Battle/Message/053.bmd|0x009B98": "「ブッ飛びやがれぇぇぇ！！」", "Battle/Dat/Battle/Message/053.bmd|0x009BC3": "「後のことは考えねえ！　全部ブチかます！」", "Battle/Dat/Battle/Message/053.bmd|0x009C03": "「まずは鉄球のシャワーだ！」", "Battle/Dat/Battle/Message/053.bmd|0x009C2E": "「次はホーンでブッ飛べ！」", "Battle/Dat/Battle/Message/053.bmd|0x009C56": "「こいつも撃ち尽くす！！」", "Battle/Dat/Battle/Message/053.bmd|0x009C7E": "「地獄の門に打ち付けてやるぜぇぇぇ！！」", "Battle/Dat/Battle/Message/053.bmd|0x009CBB": "「ラッセル！　さっさと弾ァ持ってこい！」", "Battle/Dat/Battle/Message/053.bmd|0x009CF8": "「ブレード・トンファー！」", "Battle/Dat/Battle/Message/053.bmd|0x009D20": "「おおおおっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x009D3C": "「あたしと刃物の組み合わせは…………」", "Battle/Dat/Battle/Message/053.bmd|0x009D76": "「危険だぜ！！」", "Battle/Dat/Battle/Message/053.bmd|0x009D8F": "「微塵切りだぁぁっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x009DB4": "「とどめっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x009DCD": "「ヘッ、大暴れしてやるぜ！」", "Battle/Dat/Battle/Message/053.bmd|0x009DF8": "「そーら！　次、行くぞ！」", "Battle/Dat/Battle/Message/053.bmd|0x009E20": "「弾ァ撃ち尽くしてやるぜ！！」", "Battle/Dat/Battle/Message/053.bmd|0x009E4E": "「まだ撃ち切ってねえ！」", "Battle/Dat/Battle/Message/053.bmd|0x009E73": "「こっちの方が取り回し易いぜ！」", "Battle/Dat/Battle/Message/053.bmd|0x009EA4": "「てめえにゃ、このモードで充分だ！」", "Battle/Dat/Battle/Message/053.bmd|0x009EDB": "「あたしは/　ショートレンジが好みなんだよ！」", "Battle/Dat/Battle/Message/053.bmd|0x009F1F": "「ホントは/　ブン殴ってやりてぇところだがな！」", "Battle/Dat/Battle/Message/053.bmd|0x009F66": "「あたしの鉄拳をくらって、/　昇天しやがれ！」", "Battle/Dat/Battle/Message/053.bmd|0x009FAA": "「ジェット・マグナム！！」", "Battle/Dat/Battle/Message/053.bmd|0x009FD2": "「次はミサイルだ！」", "Battle/Dat/Battle/Message/053.bmd|0x009FF1": "「スプリットミサイル！」", "Battle/Dat/Battle/Message/053.bmd|0x00A016": "「こいつは長物になるんだよ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A044": "「そうら、ブチ抜けぇぇぇ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A072": "「さあ、行ってこいや！」", "Battle/Dat/Battle/Message/053.bmd|0x00A097": "「天国と地獄、好きな方になぁ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A0CB": "「さあ、サンドバッグになりやがれ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A102": "「てめえの明日はどっちか！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A130": "「オラオラオラオラ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A155": "「どっせぇいっ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A171": "「成仏せいやぁぁぁ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A196": "「ドラドラドラドラ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A1BB": "「でりゃあっ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A1D4": "「あたしが教えてやるぜぇぇ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A205": "「おりゃあ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A21B": "「てめえに明日なんかねえんだよ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A252": "「ただ撃つだけじゃつまらねえからな！」", "Battle/Dat/Battle/Message/053.bmd|0x00A28C": "「このモーションには、/　あたしも一枚噛んでるのさ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A2DC": "「プラズマ・ステーク、セット！」", "Battle/Dat/Battle/Message/053.bmd|0x00A30D": "「黒焦げになっちまいな！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A338": "「打って、撃つ！　どうだ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A366": "「くらえ！/　メガ・ブラスターキャノン！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A3A7": "「あたしのリングに上がったのが、/　運の尽きだぜ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A3F4": "「いいか、/　マグナムの次はファントムってのが！」", "Battle/Dat/Battle/Message/053.bmd|0x00A43E": "「こいつがタイプＧの真骨頂だぜ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A472": "「タコ殴りゃぁぁぁっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A49A": "「さあ、見てこいや！」", "Battle/Dat/Battle/Message/053.bmd|0x00A4BC": "「天国、地獄！　大地獄！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A4E7": "「お約束なんだよッ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A50C": "「カチ上げてやるぜぇぇっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A53A": "「とどめだっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A556": "「ジェット！　ファントォォム！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A58A": "「そらそらそらぁーっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A5B2": "「どうした、どうした、どうしたぁっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A5EF": "「派手に打ち上げてやる！」", "Battle/Dat/Battle/Message/053.bmd|0x00A617": "「ジェット・ファントム！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A642": "「ジタバタするんじゃねえぞ……！」", "Battle/Dat/Battle/Message/053.bmd|0x00A676": "「大人しくくらいやがれっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A6A4": "「てめえは鯉だ、まな板の上のな！」", "Battle/Dat/Battle/Message/053.bmd|0x00A6D8": "「こんがり焼けちまえぇっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A706": "「ドンピシャだ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A722": "「ツイン・ビームカノン、発射！」", "Battle/Dat/Battle/Message/053.bmd|0x00A753": "「ヘッ、いい武器積んでるぜ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A781": "「こいつはおまけだ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A7A6": "「ハイパー・ブーストナックル！」", "Battle/Dat/Battle/Message/053.bmd|0x00A7D7": "「ブッ飛んで、ブン殴ってこい！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A80B": "「今度の鉄拳も痛いぜぇ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A833": "「行っけぇぇぇっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A855": "「前より２本増しだ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A877": "「アルティメット・ビーム！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A8A5": "「見せてやるぜ、超闘士の本気を！」", "Battle/Dat/Battle/Message/053.bmd|0x00A8D9": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A8F4": "「暗剣殺！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A90A": "「斬！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A91A": "「往生しろよ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A933": "「さぁて、/　ブッちぎりで不幸な目に遭ってもらおうか」", "Battle/Dat/Battle/Message/053.bmd|0x00A983": "「五！」", "Battle/Dat/Battle/Message/053.bmd|0x00A990": "「黄！」", "Battle/Dat/Battle/Message/053.bmd|0x00A99D": "「殺！！」", "Battle/Dat/Battle/Message/053.bmd|0x00A9AD": "「成仏しろよ！」", "Battle/Dat/Battle/Message/053.bmd|0x00A9C6": "「ツイン・ビームキャノン！」", "Battle/Dat/Battle/Message/053.bmd|0x00A9F1": "「スパイラル・ブレイカー！」", "Battle/Dat/Battle/Message/053.bmd|0x00AA1C": "「回れ回れ、回れぇっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00AA44": "「オメガ・キャノン！」", "Battle/Dat/Battle/Message/053.bmd|0x00AA66": "「こいつはデカい砲台だ！　行けぇ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00AAA0": "「捻り潰してやるぜ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00AAC5": "「ドリル付きの方に乗ってりゃ良かったな！」", "Battle/Dat/Battle/Message/053.bmd|0x00AB05": "「やっぱこれだぜ！/　ドリル・アタッカー！！」", "Battle/Dat/Battle/Message/053.bmd|0x00AB49": "「連打もいいが、一発で決めるとするか！」", "Battle/Dat/Battle/Message/053.bmd|0x00AB86": "「獅子王刀、歳破！！」", "Battle/Dat/Battle/Message/053.bmd|0x00ABA8": "「そーら、ド正面から！」", "Battle/Dat/Battle/Message/053.bmd|0x00ABCD": "「真っ二つだーっ！！」", "Battle/Dat/Battle/Message/053.bmd|0x00ABEF": "「ラッセル！　砥石持って来い！」", "Battle/Dat/Battle/Message/053.bmd|0x00AC20": "「遠慮はしねえ！　請求書は上に回す！！」", "Battle/Dat/Battle/Message/053.bmd|0x00AC5D": "「ヘッ、豪勢なミサイルだぜ、こいつはよ！」", "Battle/Dat/Battle/Message/053.bmd|0x00AC9D": "「月のねえ晩は、頭の上に気を付けろよ！」", "Battle/Dat/Battle/Message/053.bmd|0x00ACDA": "「こいつがいるからなぁっ！！」", "Battle/Dat/Battle/Message/054.bmd|0x0048F5": "「慎重にいかなきゃ…！」", "Battle/Dat/Battle/Message/054.bmd|0x00491A": "「何としてでも…！」", "Battle/Dat/Battle/Message/054.bmd|0x004939": "「この距離なら！」"}