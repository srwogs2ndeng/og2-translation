{"Battle/Dat/Battle/Message/095.bmd|0x0038E6": "「ドライバーキャノン、発射！」", "Battle/Dat/Battle/Message/095.bmd|0x003914": "「撃ち抜く！」", "Battle/Dat/Battle/Message/095.bmd|0x00392A": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/095.bmd|0x00394F": "「ギガブラスター、発射！！」", "Battle/Dat/Battle/Message/095.bmd|0x00397A": "「チャージ完了！　トリガー！」", "Battle/Dat/Battle/Message/095.bmd|0x0039A8": "「ギガブラスター！　行けっ！！」", "Battle/Dat/Battle/Message/095.bmd|0x0039D9": "「ドライバーキャノン、セット！」", "Battle/Dat/Battle/Message/095.bmd|0x003A0A": "「くらえ！！」", "Battle/Dat/Battle/Message/095.bmd|0x003A20": "「バレル、セット！」", "Battle/Dat/Battle/Message/095.bmd|0x003A3F": "「ドライバーキャノン！　行けっ！！」", "Battle/Dat/Battle/Message/095.bmd|0x003A76": "「まずはこれを受けてもらう！」", "Battle/Dat/Battle/Message/095.bmd|0x003AA4": "「続けて行くぞ！！」", "Battle/Dat/Battle/Message/095.bmd|0x003AC3": "「まずは速射だ！」", "Battle/Dat/Battle/Message/095.bmd|0x003ADF": "「撃ち抜く！！」", "Battle/Dat/Battle/Message/095.bmd|0x003AF8": "「これがかわせるか！」", "Battle/Dat/Battle/Message/095.bmd|0x003B1A": "「次はこいつだ！」", "Battle/Dat/Battle/Message/095.bmd|0x003B36": "「一気に畳み掛ける！」", "Battle/Dat/Battle/Message/095.bmd|0x003B58": "「くらえっ！！」", "Battle/Dat/Battle/Message/095.bmd|0x003B71": "「とどめだ！」", "Battle/Dat/Battle/Message/095.bmd|0x003B87": "「バニッシュ！　ゲイザァァァッ！！」", "Battle/Dat/Battle/Message/095.bmd|0x003BBE": "「さあ、仕上げだ！」", "Battle/Dat/Battle/Message/095.bmd|0x003BDD": "「バニッシュゲイザー！/　砕け散れぇぇっ！！」", "Battle/Dat/Battle/Message/096.bmd|0x001E5A": "「そ～んじゃま、ちょいと行きますか」", "Battle/Dat/Battle/Message/096.bmd|0x001E91": "「こ～っちも仕事なんでね」", "Battle/Dat/Battle/Message/096.bmd|0x001EB9": "「い～っちょ、やりますか」", "Battle/Dat/Battle/Message/096.bmd|0x001EE1": "「さ～て、行きますか」", "Battle/Dat/Battle/Message/096.bmd|0x001F03": "「あ～んたらは危険なのさ」", "Battle/Dat/Battle/Message/096.bmd|0x001F2B": "「ちょ～っくら、ちょいと！」", "Battle/Dat/Battle/Message/096.bmd|0x001F56": "「仕事しなきゃね」", "Battle/Dat/Battle/Message/096.bmd|0x001F72": "「シュウ・シラカワ……目～障りな男だよ」", "Battle/Dat/Battle/Message/096.bmd|0x001FAF": "「グランゾン……早く始末しないと」", "Battle/Dat/Battle/Message/096.bmd|0x001FE3": "「ま～ったく、と～んだ食わせ者だよ、シュウ」", "Battle/Dat/Battle/Message/096.bmd|0x002026": "「もう、あんたにはついてけないね」", "Battle/Dat/Battle/Message/096.bmd|0x00205A": "「お互い覚悟を決める時が来たな」", "Battle/Dat/Battle/Message/096.bmd|0x00208B": "「ゼゼーナン……落とし前をつける」", "Battle/Dat/Battle/Message/096.bmd|0x0020BF": "「サイバスター、い～ただき！」", "Battle/Dat/Battle/Message/096.bmd|0x0020ED": "「風の魔装機神って奴ね」", "Battle/Dat/Battle/Message/096.bmd|0x002112": "「風が呼んでる、ってか？」", "Battle/Dat/Battle/Message/096.bmd|0x00213A": "「色んな魔装機神がいるもんだ～ね」", "Battle/Dat/Battle/Message/096.bmd|0x00216E": "「魔装機神み～たいなメカがいるから、/　地球は厄介な～んだな」", "Battle/Dat/Battle/Message/096.bmd|0x0021CA": "「趣味的なメカだね」", "Battle/Dat/Battle/Message/096.bmd|0x0021E9": "「そ～んじゃま、ガ～ルハントと洒落こもうか」", "Battle/Dat/Battle/Message/096.bmd|0x00222C": "「ヒュッケバインって、/　消～えたはずじゃなかったか？」", "Battle/Dat/Battle/Message/096.bmd|0x00227F": "「あれ、問題が多いからね。消してやるよ」", "Battle/Dat/Battle/Message/096.bmd|0x0022BC": "「随分とボ～ロボロだな」", "Battle/Dat/Battle/Message/096.bmd|0x0022E1": "「そ～の眼鏡、割ってやるよ」", "Battle/Dat/Battle/Message/096.bmd|0x00230C": "「ボ～ロボロの次は、トゲトゲか」", "Battle/Dat/Battle/Message/096.bmd|0x00233D": "「別の星の技術を使ってる奴も、厄介だ～ね」", "Battle/Dat/Battle/Message/096.bmd|0x00237D": "「見～た目のハッタリは凄いな」", "Battle/Dat/Battle/Message/096.bmd|0x0023AB": "「ダブルＧは始末しないとな」", "Battle/Dat/Battle/Message/096.bmd|0x0023D6": "「ダブルＧを倒せば、/　あいつらも意気消沈す～るだろ」", "Battle/Dat/Battle/Message/096.bmd|0x002426": "「そ～の剣、重そうだ～ね」", "Battle/Dat/Battle/Message/096.bmd|0x00244E": "「さ～て、グルンガストをさく～っと倒すか」", "Battle/Dat/Battle/Message/096.bmd|0x00248E": "「グ～ルンと回って、ガスッと変形する奴ね」", "Battle/Dat/Battle/Message/096.bmd|0x0024CE": "「あ～んなのが量産されたら、あいつらは/　攻め込んでくる。今の内に始末しなきゃな」", "Battle/Dat/Battle/Message/096.bmd|0x002548": "「派手なメカだね。誰が作ったんだか」", "Battle/Dat/Battle/Message/096.bmd|0x00257F": "「バリってるねぇ、色々」", "Battle/Dat/Battle/Message/096.bmd|0x0025A4": "「昔からあ～ゆ～のを作ってるから、/　地球人は危険なんだな」", "Battle/Dat/Battle/Message/096.bmd|0x0025FD": "「今度は俺の番ね」", "Battle/Dat/Battle/Message/096.bmd|0x002619": "「そ～んじゃ、お返しっと」", "Battle/Dat/Battle/Message/096.bmd|0x002641": "「こ～っちのも見てってちょうだいよ」", "Battle/Dat/Battle/Message/096.bmd|0x002678": "「逃～げようったって、無駄」", "Battle/Dat/Battle/Message/096.bmd|0x0026A3": "「じゃ、次は俺から」", "Battle/Dat/Battle/Message/096.bmd|0x0026C2": "「こ～こからが本番、ってねぇ」", "Battle/Dat/Battle/Message/096.bmd|0x0026F0": "「ギ～ブ・アンド・テイクね」", "Battle/Dat/Battle/Message/096.bmd|0x00271B": "「な、何とまあ！」", "Battle/Dat/Battle/Message/096.bmd|0x002737": "「あ～りゃま、やぁられちまったい！」", "Battle/Dat/Battle/Message/096.bmd|0x00276E": "「こ、こりゃ、か～なわんわぁ！」", "Battle/Dat/Battle/Message/096.bmd|0x00279F": "「まぁいった、まいった。出直してくるわ」", "Battle/Dat/Battle/Message/096.bmd|0x0027DC": "「こ～のまま終わるつもりはな～いんだよね」", "Battle/Dat/Battle/Message/096.bmd|0x00281C": "「くうっ！　さぁすが、やるやる」", "Battle/Dat/Battle/Message/096.bmd|0x00284D": "「おおっ？　ちょ～いとまずいかもね」", "Battle/Dat/Battle/Message/096.bmd|0x002884": "「おおっとお！　洒落になんなくなってきたかな」", "Battle/Dat/Battle/Message/096.bmd|0x0028CA": "「くううっ！　効～いたあ……」", "Battle/Dat/Battle/Message/096.bmd|0x0028F8": "「おっとっと、オーグバリューでも危ないな」", "Battle/Dat/Battle/Message/096.bmd|0x002938": "「つうう……！　魔装機神、侮れないね」", "Battle/Dat/Battle/Message/096.bmd|0x002972": "「くうう……/　ヒュッケバインを超えるって～の？」", "Battle/Dat/Battle/Message/096.bmd|0x0029BC": "「いてて……ガスッとやられちまったい」", "Battle/Dat/Battle/Message/096.bmd|0x0029F6": "「おおっ！　バリバリだ～ね、そのマシン」", "Battle/Dat/Battle/Message/096.bmd|0x002A33": "「グランゾン……や～っぱ始末に悪いわ」", "Battle/Dat/Battle/Message/096.bmd|0x002A6D": "「お～嬢ちゃん相手に、/　ボケてる場合じゃないかもね」", "Battle/Dat/Battle/Message/096.bmd|0x002ABD": "「へえ～、な～かなか」", "Battle/Dat/Battle/Message/096.bmd|0x002ADF": "「う～ん、まあまあってと～ころかね」", "Battle/Dat/Battle/Message/096.bmd|0x002B16": "「ふうん、い～い腕してるねぇ」", "Battle/Dat/Battle/Message/096.bmd|0x002B44": "「あ～たた、当たっちまったい」", "Battle/Dat/Battle/Message/096.bmd|0x002B72": "「お～、揺～れた、揺れた」", "Battle/Dat/Battle/Message/096.bmd|0x002B9A": "「オーグバリューは、ま～だまだ大丈夫よ」", "Battle/Dat/Battle/Message/096.bmd|0x002BD7": "「や～るね、サイバスター」", "Battle/Dat/Battle/Message/096.bmd|0x002BFF": "「こ～っちが消えるわけには/　い～かないんだよね」", "Battle/Dat/Battle/Message/096.bmd|0x002C49": "「ほ～う、グルンガスト……な～かなか」", "Battle/Dat/Battle/Message/096.bmd|0x002C83": "「お～お、バリッと来～たねえ」", "Battle/Dat/Battle/Message/096.bmd|0x002CB1": "「バラン＝シュナイル……性能はさ～すがね」", "Battle/Dat/Battle/Message/096.bmd|0x002CF1": "「さ～すが、グランゾン」", "Battle/Dat/Battle/Message/096.bmd|0x002D16": "「ぼ～ちぼちでんな、お嬢ちゃん」", "Battle/Dat/Battle/Message/096.bmd|0x002D47": "「ん～？　な～んか当たったか？」", "Battle/Dat/Battle/Message/096.bmd|0x002D78": "「や～れやれ、こんなもんか」", "Battle/Dat/Battle/Message/096.bmd|0x002DA3": "「駄目駄目、お～話にならんね」", "Battle/Dat/Battle/Message/096.bmd|0x002DD1": "「当～てただけかい？」", "Battle/Dat/Battle/Message/096.bmd|0x002DF3": "「軽い、軽い」", "Battle/Dat/Battle/Message/096.bmd|0x002E09": "「こ～う見えて、/　オーグバリューは丈夫なんだな」", "Battle/Dat/Battle/Message/096.bmd|0x002E53": "「大したことないね、サイバスター」", "Battle/Dat/Battle/Message/096.bmd|0x002E87": "「ヒュッケバインがあ～の世で泣いてるよ」", "Battle/Dat/Battle/Message/096.bmd|0x002EC4": "「しょ～ぼいね、グルンガストも」", "Battle/Dat/Battle/Message/096.bmd|0x002EF5": "「色は派手なんだけどねぇ」", "Battle/Dat/Battle/Message/096.bmd|0x002F1D": "「グランゾンって、そ～んなもん？」", "Battle/Dat/Battle/Message/096.bmd|0x002F51": "「突っ込みが弱いね、お嬢ちゃん」", "Battle/Dat/Battle/Message/096.bmd|0x002F82": "「案外や～るじゃないの、あのおっさん」", "Battle/Dat/Battle/Message/096.bmd|0x002FBC": "「ひょ～いっとな」", "Battle/Dat/Battle/Message/096.bmd|0x002FD8": "「そ～こじゃないでしょ。/　俺はこ～っちよ、こっち」", "Battle/Dat/Battle/Message/096.bmd|0x003025": "「は～ずれ」", "Battle/Dat/Battle/Message/096.bmd|0x003038": "「当～たらないんだな、これが」", "Battle/Dat/Battle/Message/096.bmd|0x003066": "「残念ね」", "Battle/Dat/Battle/Message/096.bmd|0x003076": "「あ～んたにそのマシンは上手く扱えないさ」", "Battle/Dat/Battle/Message/096.bmd|0x0030B6": "「付～け焼き刃だね、ゼゼーナン」", "Battle/Dat/Battle/Message/096.bmd|0x0030E7": "「あ、そ～ゆ～の、無駄無駄」", "Battle/Dat/Battle/Message/096.bmd|0x003112": "「効～かないんだな、これが」", "Battle/Dat/Battle/Message/096.bmd|0x00313D": "「こ～ゆ～備えもあ～るのさ」", "Battle/Dat/Battle/Message/096.bmd|0x003168": "「………」", "Battle/Dat/Battle/Message/096.bmd|0x003178": "「あ～らら、何てこった」", "Battle/Dat/Battle/Message/096.bmd|0x00319D": "「う～ん、失態だ～ね」"}