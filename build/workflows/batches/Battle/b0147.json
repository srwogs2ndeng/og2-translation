{"Battle/Dat/Battle/Message/070.bmd|0x005B75": "「行くぞ！」", "Battle/Dat/Battle/Message/070.bmd|0x005B88": "「グルンガスト、ファイナルアタック！」", "Battle/Dat/Battle/Message/070.bmd|0x005BC2": "「シシオウブレード！」", "Battle/Dat/Battle/Message/070.bmd|0x005BE4": "「この武器は飾りではないのさ」", "Battle/Dat/Battle/Message/070.bmd|0x005C12": "「受けろ！」", "Battle/Dat/Battle/Message/070.bmd|0x005C25": "「そして、砕け散れ！」", "Battle/Dat/Battle/Message/070.bmd|0x005C47": "「高機動モード、セット！」", "Battle/Dat/Battle/Message/070.bmd|0x005C6F": "「ウィング、展開！」", "Battle/Dat/Battle/Message/070.bmd|0x005C8E": "「落ちろ！」", "Battle/Dat/Battle/Message/070.bmd|0x005CA1": "「Ｗモード、発射！」", "Battle/Dat/Battle/Message/070.bmd|0x005CC0": "「味方機は下がれ！　ＭＡＰＷを発射する！」", "Battle/Dat/Battle/Message/070.bmd|0x005D00": "「シーズアンカー、セットアップ！」", "Battle/Dat/Battle/Message/070.bmd|0x005D34": "「我が一撃を受けろ！」", "Battle/Dat/Battle/Message/070.bmd|0x005D56": "「自動追尾モード、セット！」", "Battle/Dat/Battle/Message/070.bmd|0x005D81": "「行け、ソードブレイカー！」", "Battle/Dat/Battle/Message/070.bmd|0x005DAC": "「スラッシュ・リッパー、発射！！」", "Battle/Dat/Battle/Message/070.bmd|0x005DE0": "「いけっ！　スラッシュリッパー！！」", "Battle/Dat/Battle/Message/070.bmd|0x005E17": "「斬り裂け！　スラッシュリッパー！！」", "Battle/Dat/Battle/Message/070.bmd|0x005E51": "「ターゲット・ロック……」", "Battle/Dat/Battle/Message/070.bmd|0x005E79": "「グラビトン・ランチャー、発射！」", "Battle/Dat/Battle/Message/070.bmd|0x005EAD": "「これで決める……！」", "Battle/Dat/Battle/Message/070.bmd|0x005ECF": "「そこだっ！」", "Battle/Dat/Battle/Message/070.bmd|0x005EE5": "「そこだな……！」", "Battle/Dat/Battle/Message/070.bmd|0x005F01": "「ブースト・オン！」", "Battle/Dat/Battle/Message/070.bmd|0x005F20": "「バンカー！」", "Battle/Dat/Battle/Message/070.bmd|0x005F36": "「撃ち抜く！！」", "Battle/Dat/Battle/Message/070.bmd|0x005F4F": "「クレイモア！」", "Battle/Dat/Battle/Message/070.bmd|0x005F68": "「次っ！」", "Battle/Dat/Battle/Message/070.bmd|0x005F78": "「まだまだ！」", "Battle/Dat/Battle/Message/070.bmd|0x005F8E": "「ブレード・トンファー、セット！」", "Battle/Dat/Battle/Message/070.bmd|0x005FC2": "「仕掛ける！」", "Battle/Dat/Battle/Message/070.bmd|0x005FD8": "「ブレード・サイ、アクティブ！」", "Battle/Dat/Battle/Message/070.bmd|0x006009": "「セット！」", "Battle/Dat/Battle/Message/070.bmd|0x00601C": "「シーケンス・ＢＰ１」", "Battle/Dat/Battle/Message/070.bmd|0x00603E": "「とどめ！！」", "Battle/Dat/Battle/Message/070.bmd|0x006054": "「シーケンス・ＢＰ２！」", "Battle/Dat/Battle/Message/070.bmd|0x006079": "「パターン、ＲＴアレンジ！」", "Battle/Dat/Battle/Message/070.bmd|0x0060A4": "「撃ち込む！」", "Battle/Dat/Battle/Message/070.bmd|0x0060BA": "「プラズマ・ステーク、アクティブ！」", "Battle/Dat/Battle/Message/070.bmd|0x0060F1": "「ジェット・マグナム！！」", "Battle/Dat/Battle/Message/070.bmd|0x006119": "「ロングレンジ・モード！」", "Battle/Dat/Battle/Message/070.bmd|0x006141": "「発射！！」", "Battle/Dat/Battle/Message/070.bmd|0x006154": "「シーケンス、ＪＭ３！」", "Battle/Dat/Battle/Message/070.bmd|0x006179": "「せいっ！」", "Battle/Dat/Battle/Message/070.bmd|0x00618C": "「メガ・ブラスターキャノン、発射！」", "Battle/Dat/Battle/Message/070.bmd|0x0061C3": "「シーケンス・ＪＰ１！」", "Battle/Dat/Battle/Message/070.bmd|0x0061E8": "「とどめ！」", "Battle/Dat/Battle/Message/070.bmd|0x0061FB": "「ジェット・ファントム！！」", "Battle/Dat/Battle/Message/070.bmd|0x006226": "「ターゲット・ロック……！」", "Battle/Dat/Battle/Message/070.bmd|0x006251": "「ツイン・ビームカノン、発射！」", "Battle/Dat/Battle/Message/070.bmd|0x006282": "「ダーク・ロック！」", "Battle/Dat/Battle/Message/070.bmd|0x0062A1": "「ハイパー・ブーストナックル！」", "Battle/Dat/Battle/Message/070.bmd|0x0062D2": "「行けっ！」", "Battle/Dat/Battle/Message/070.bmd|0x0062E5": "「ビーム・キャノン、アクティブ！」", "Battle/Dat/Battle/Message/070.bmd|0x006319": "「超闘士がお前を凶方へ導く」", "Battle/Dat/Battle/Message/070.bmd|0x006344": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/070.bmd|0x00635F": "「暗剣殺！！」", "Battle/Dat/Battle/Message/070.bmd|0x006375": "「斬！！」", "Battle/Dat/Battle/Message/070.bmd|0x006385": "「シーケンス・エンド」", "Battle/Dat/Battle/Message/070.bmd|0x0063A7": "「グルンガスト改、ファイナル・アタック」", "Battle/Dat/Battle/Message/070.bmd|0x0063E4": "「五！」", "Battle/Dat/Battle/Message/070.bmd|0x0063F1": "「黄！」", "Battle/Dat/Battle/Message/070.bmd|0x0063FE": "「殺！！」", "Battle/Dat/Battle/Message/070.bmd|0x00640E": "「大凶方の彼方へ去れ！」", "Battle/Dat/Battle/Message/070.bmd|0x006433": "「これで決めさせてもらう……！」", "Battle/Dat/Battle/Message/070.bmd|0x006464": "「グルンガスト参式、ファイナル・アタック」", "Battle/Dat/Battle/Message/070.bmd|0x0064A4": "「獅子王刀、歳破！！」", "Battle/Dat/Battle/Message/070.bmd|0x0064C6": "「どのみちお前の運は尽きていた」", "Battle/Dat/Battle/Message/070.bmd|0x0064F7": "「ＭＴＤ誘導弾、発射！」", "Battle/Dat/Battle/Message/070.bmd|0x00651C": "「イルミネーター・リンク！」", "Battle/Dat/Battle/Message/071.bmd|0x00298A": "「む……！　そこか！」", "Battle/Dat/Battle/Message/071.bmd|0x0029AC": "「隙あり！」", "Battle/Dat/Battle/Message/071.bmd|0x0029BF": "「受けてみよ！」", "Battle/Dat/Battle/Message/071.bmd|0x0029D8": "「ゆくぞ、零式！」", "Battle/Dat/Battle/Message/071.bmd|0x0029F4": "「おぬしの命が翳っておるぞ……！」", "Battle/Dat/Battle/Message/071.bmd|0x002A28": "「行く手を阻むものは、全て打ち倒す！」", "Battle/Dat/Battle/Message/071.bmd|0x002A62": "「『剣ハ抜クベカラザルモノ』……/　じゃが、ここは致し方あるまい」", "Battle/Dat/Battle/Message/071.bmd|0x002AC4": "「超闘士の力、とくと見よ！」", "Battle/Dat/Battle/Message/071.bmd|0x002AEF": "「異星の人機よ、覚悟せい！」", "Battle/Dat/Battle/Message/071.bmd|0x002B1A": "「我ら地球人の意地を見よ！」", "Battle/Dat/Battle/Message/071.bmd|0x002B45": "「異星の者よ、いざ尋常に勝負！」", "Battle/Dat/Battle/Message/071.bmd|0x002B76": "「異形のものよ、覚悟せい！」", "Battle/Dat/Battle/Message/071.bmd|0x002BA1": "「その邪念、ここで断ち切ってくれる」", "Battle/Dat/Battle/Message/071.bmd|0x002BD8": "「兜首を貰い受ける！」", "Battle/Dat/Battle/Message/071.bmd|0x002BFA": "「不肖の弟子は斬らねばならぬか……！」", "Battle/Dat/Battle/Message/071.bmd|0x002C34": "「おぬしの剣は邪なものに染まっておる」", "Battle/Dat/Battle/Message/071.bmd|0x002C6E": "「参るぞ、ムラタ！」", "Battle/Dat/Battle/Message/071.bmd|0x002C8D": "「おぬしの理想ごと、断ち切ってくれる！」", "Battle/Dat/Battle/Message/071.bmd|0x002CCA": "「ふん……死に時と場所は、自分で見極めるわ」", "Battle/Dat/Battle/Message/071.bmd|0x002D0D": "「仙人になってまで/　長生きしようと思っておらぬ」", "Battle/Dat/Battle/Message/071.bmd|0x002D57": "「泰北……いざ尋常に勝負！」", "Battle/Dat/Battle/Message/071.bmd|0x002D82": "「この戦、負けるわけにはいかぬ」", "Battle/Dat/Battle/Message/071.bmd|0x002DB3": "「ふふ……まさに、一世一代の勝負じゃな」", "Battle/Dat/Battle/Message/071.bmd|0x002DF0": "「ここで破滅するのは、お主だけでよいわ！」", "Battle/Dat/Battle/Message/071.bmd|0x002E30": "「お主が黒幕か……！」", "Battle/Dat/Battle/Message/071.bmd|0x002E52": "「お主らに、/　地球の守護者を名乗る資格はない！」", "Battle/Dat/Battle/Message/071.bmd|0x002E9C": "「進退窮まったな、ゼゼーナンよ」", "Battle/Dat/Battle/Message/071.bmd|0x002ECD": "「参るぞ、ククル！」", "Battle/Dat/Battle/Message/071.bmd|0x002EEC": "「真っ向勝負じゃ、ククル！」", "Battle/Dat/Battle/Message/071.bmd|0x002F17": "「孫光龍……/　我が先祖に代わり、お主を討つ！」", "Battle/Dat/Battle/Message/071.bmd|0x002F5E": "「お主との一戦……我がトウゴウ家の宿命よの」", "Battle/Dat/Battle/Message/071.bmd|0x002FA1": "「戦うべき相手を違えるでない！」", "Battle/Dat/Battle/Message/071.bmd|0x002FD2": "「おぬし達に地球は渡さぬ！」", "Battle/Dat/Battle/Message/071.bmd|0x002FFD": "「あんなものがおるとは……/　長生きはしてみるもんじゃ」", "Battle/Dat/Battle/Message/071.bmd|0x003050": "「偽神は、我が剣にて湮滅すべし！」", "Battle/Dat/Battle/Message/071.bmd|0x003084": "「ユーゼス……因果地平の彼方へ去れい！」", "Battle/Dat/Battle/Message/071.bmd|0x0030C1": "「行くぞ、ジンライ！」", "Battle/Dat/Battle/Message/071.bmd|0x0030E3": "「悪機め、神妙にせい！」", "Battle/Dat/Battle/Message/071.bmd|0x003108": "「機忍共め、成敗してくれるわ！」", "Battle/Dat/Battle/Message/071.bmd|0x003139": "「妖機人め、成敗してくれるわ！」", "Battle/Dat/Battle/Message/071.bmd|0x00316A": "「退散せよ、妖機人！」", "Battle/Dat/Battle/Message/071.bmd|0x00318C": "「四神の超機人……相手にとって不足なし！」", "Battle/Dat/Battle/Message/071.bmd|0x0031CC": "「四神でありながら、人界に仇なすか……！」", "Battle/Dat/Battle/Message/071.bmd|0x00320C": "「四凶は滅すべし！」", "Battle/Dat/Battle/Message/071.bmd|0x00322B": "「四凶よ、尋常に勝負せい！」", "Battle/Dat/Battle/Message/071.bmd|0x003256": "「返すぞ！」", "Battle/Dat/Battle/Message/071.bmd|0x003269": "「なんの、ここからじゃ！」", "Battle/Dat/Battle/Message/071.bmd|0x003291": "「まだ勝負はついておらぬ！」", "Battle/Dat/Battle/Message/071.bmd|0x0032BC": "「……やれやれ、疲れるわい」", "Battle/Dat/Battle/Message/071.bmd|0x0032E7": "「もう一踏ん張りしようかの」"}