{"Battle/Dat/Battle/Message/071.bmd|0x003312": "「む、無念なり！」", "Battle/Dat/Battle/Message/071.bmd|0x00332E": "「……年寄りの出番は、ここまでのようじゃ」", "Battle/Dat/Battle/Message/071.bmd|0x00336E": "「むうう……こちらは/　老骨に鞭を打っておるというのに」", "Battle/Dat/Battle/Message/071.bmd|0x0033C1": "「こりゃ！　年寄りはもっと大切にせんか！」", "Battle/Dat/Battle/Message/071.bmd|0x003401": "「そんなもので/　我が意地を砕くことは出来んぞ！」", "Battle/Dat/Battle/Message/071.bmd|0x00344B": "「……まさに年寄りの冷や水じゃな」", "Battle/Dat/Battle/Message/071.bmd|0x00347F": "「ぐうっ！　このワシを退かせるとは……！！」", "Battle/Dat/Battle/Message/071.bmd|0x0034C2": "「おぬしに討たれるワシではないわ！！」", "Battle/Dat/Battle/Message/071.bmd|0x0034FC": "「ううっ……！　昔のようにはいかんのう」", "Battle/Dat/Battle/Message/071.bmd|0x003539": "「むうっ、奴の舞に惑わされたか！」", "Battle/Dat/Battle/Message/071.bmd|0x00356D": "「くっ！　仙人を侮るのは危険よの……！」", "Battle/Dat/Battle/Message/071.bmd|0x0035AA": "「むう、やはりただの老いぼれではないのう」", "Battle/Dat/Battle/Message/071.bmd|0x0035EA": "「法外な攻めよの。/　じゃが、光龍……お主には負けぬ！」", "Battle/Dat/Battle/Message/071.bmd|0x00363D": "「どうした、ワシはまだ破滅しておらぬぞ！」", "Battle/Dat/Battle/Message/071.bmd|0x00367D": "「この踏み込み……ダブルＧならではか！」", "Battle/Dat/Battle/Message/071.bmd|0x0036BA": "「機忍が……ワシの邪魔をするでないわ！」", "Battle/Dat/Battle/Message/071.bmd|0x0036F7": "「妖機人に後れを取るとはのう……！」", "Battle/Dat/Battle/Message/071.bmd|0x00372E": "「四凶だけあって、禍々しい気じゃ……！」", "Battle/Dat/Battle/Message/071.bmd|0x00376B": "「ワシも戦ってみせようぞ、その応龍皇と！」", "Battle/Dat/Battle/Message/071.bmd|0x0037AB": "「ふん、神を名乗るだけのことはあるのう」", "Battle/Dat/Battle/Message/071.bmd|0x0037E8": "「ユーゼスめ、妄想を現出させおったか……！」", "Battle/Dat/Battle/Message/071.bmd|0x00382B": "「ふん、ムラタめ……いい打ち込みをしおる」", "Battle/Dat/Battle/Message/071.bmd|0x00386B": "「邪な念でワシを斬り捨てることは出来んぞ！」", "Battle/Dat/Battle/Message/071.bmd|0x0038AE": "「やれやれ、年寄り相手に大人げないのう」", "Battle/Dat/Battle/Message/071.bmd|0x0038EB": "「ぬうっ！　踏み込まれたか！」", "Battle/Dat/Battle/Message/071.bmd|0x003919": "「はっはっは！　片腹痛いわ！」", "Battle/Dat/Battle/Message/071.bmd|0x003947": "「なかなかいい筋をしておる。/　ワシの所へ来んか？」", "Battle/Dat/Battle/Message/071.bmd|0x003994": "「ふふふ……若い頃を思い出すわい」", "Battle/Dat/Battle/Message/071.bmd|0x0039C8": "「むう……血がたぎってきたわ！」", "Battle/Dat/Battle/Message/071.bmd|0x0039F9": "「まだまだじゃの」", "Battle/Dat/Battle/Message/071.bmd|0x003A15": "「むう……浅いのう」", "Battle/Dat/Battle/Message/071.bmd|0x003A34": "「年寄りにはもっと優しくしてくれんかの？」", "Battle/Dat/Battle/Message/071.bmd|0x003A74": "「む……！　いい動きをしておるわい」", "Battle/Dat/Battle/Message/071.bmd|0x003AAB": "「何じゃ？　誰ぞワシに触ったか？」", "Battle/Dat/Battle/Message/071.bmd|0x003ADF": "「おお、あやつの動きに/　気を取られてしまったわい」", "Battle/Dat/Battle/Message/071.bmd|0x003B2C": "「それほどの腕を持ちながら……惜しいのう」", "Battle/Dat/Battle/Message/071.bmd|0x003B6C": "「浅いわ、ククル！」", "Battle/Dat/Battle/Message/071.bmd|0x003B8B": "「やるのう、夏喃」", "Battle/Dat/Battle/Message/071.bmd|0x003BA7": "「力押しでワシは倒せんぞ、泰北」", "Battle/Dat/Battle/Message/071.bmd|0x003BD8": "「それで終わりか、光龍」", "Battle/Dat/Battle/Message/071.bmd|0x003BFD": "「この邪な気……尋常ではないな」", "Battle/Dat/Battle/Message/071.bmd|0x003C2E": "「むっ、やるな、機忍」", "Battle/Dat/Battle/Message/071.bmd|0x003C50": "「む、妖機人に食いつかれるとはのう」", "Battle/Dat/Battle/Message/071.bmd|0x003C87": "「ふん、それで四凶とはな」", "Battle/Dat/Battle/Message/071.bmd|0x003CAF": "「紛い物の神などにやられはせん」", "Battle/Dat/Battle/Message/071.bmd|0x003CE0": "「効かんぞ、ユーゼス」", "Battle/Dat/Battle/Message/071.bmd|0x003D02": "「剣はただ振ればいいというものではないわ」", "Battle/Dat/Battle/Message/071.bmd|0x003D42": "「剣の速さはなかなか……/　じゃが、気迫が足りんの」", "Battle/Dat/Battle/Message/071.bmd|0x003D8F": "「見切ったぞ」", "Battle/Dat/Battle/Message/071.bmd|0x003DA5": "「甘い！」", "Battle/Dat/Battle/Message/071.bmd|0x003DB5": "「修行が足りん」", "Battle/Dat/Battle/Message/071.bmd|0x003DCE": "「ほほう、なかなかの技じゃの」", "Battle/Dat/Battle/Message/071.bmd|0x003DFC": "「当たらぬぞ、夏喃」", "Battle/Dat/Battle/Message/071.bmd|0x003E1B": "「お主の加護などいらぬわ」", "Battle/Dat/Battle/Message/071.bmd|0x003E43": "「おぬしの剣など届かぬ」", "Battle/Dat/Battle/Message/071.bmd|0x003E68": "「ふん、剣に曇りがあるぞ」", "Battle/Dat/Battle/Message/071.bmd|0x003E90": "「ま、年の功という奴じゃな」", "Battle/Dat/Battle/Message/071.bmd|0x003EBB": "「まだまだ若い者には負けんわ！」", "Battle/Dat/Battle/Message/071.bmd|0x003EEC": "「弟子達の手前もあるからのう」", "Battle/Dat/Battle/Message/071.bmd|0x003F1A": "「何なら、ワシが手ほどきをしてやるぞ？」", "Battle/Dat/Battle/Message/071.bmd|0x003F57": "「甘いぞ、ククル」", "Battle/Dat/Battle/Message/071.bmd|0x003F73": "「無駄じゃ、泰北」", "Battle/Dat/Battle/Message/071.bmd|0x003F8F": "「トウゴウ家の漢を、甘く見るでない」", "Battle/Dat/Battle/Message/071.bmd|0x003FC6": "「ふん、“破滅の王”などと言ってもな」", "Battle/Dat/Battle/Message/071.bmd|0x004000": "「機忍などに、やられはせんわい」", "Battle/Dat/Battle/Message/071.bmd|0x004031": "「妖機人め、ワシはここじゃ」", "Battle/Dat/Battle/Message/071.bmd|0x00405C": "「ふん、邪な超機人などに」", "Battle/Dat/Battle/Message/071.bmd|0x004084": "「見かけ倒しじゃの、四霊の超機人は」", "Battle/Dat/Battle/Message/071.bmd|0x0040BB": "「妄言は大概にせい、ユーゼス」", "Battle/Dat/Battle/Message/071.bmd|0x0040E9": "「その邪念が、剣を遅らせたな」", "Battle/Dat/Battle/Message/071.bmd|0x004117": "「効かん！」", "Battle/Dat/Battle/Message/071.bmd|0x00412A": "「むうん！」", "Battle/Dat/Battle/Message/071.bmd|0x00413D": "「無駄だ！」", "Battle/Dat/Battle/Message/071.bmd|0x004150": "「気合が足りん！」", "Battle/Dat/Battle/Message/071.bmd|0x00416C": "「ま、こういう手も使わんとな」", "Battle/Dat/Battle/Message/071.bmd|0x00419A": "「おお、バリアがあったのを忘れとったわい」", "Battle/Dat/Battle/Message/071.bmd|0x0041DA": "「………」", "Battle/Dat/Battle/Message/071.bmd|0x0041EA": "「やれやれ……」", "Battle/Dat/Battle/Message/071.bmd|0x004203": "「助太刀する！」", "Battle/Dat/Battle/Message/071.bmd|0x00421C": "「もう一撃じゃ！」", "Battle/Dat/Battle/Message/071.bmd|0x004238": "「その隙、逃しはせん」", "Battle/Dat/Battle/Message/071.bmd|0x00425A": "「ワシを呼んだか、ゼンガー・ゾンボルト！」", "Battle/Dat/Battle/Message/071.bmd|0x00429A": "「ブリット、打ち込みが足りんぞ！」", "Battle/Dat/Battle/Message/071.bmd|0x0042CE": "「クスハ、後はワシに任せよ！」", "Battle/Dat/Battle/Message/071.bmd|0x0042FC": "「アラド、おぬしは先を急ぎすぎじゃ」", "Battle/Dat/Battle/Message/071.bmd|0x004333": "「詰めが甘いぞ、トウマ！」", "Battle/Dat/Battle/Message/071.bmd|0x00435B": "「ラウル、後は任せい！」", "Battle/Dat/Battle/Message/071.bmd|0x004380": "「超機人よ、助太刀するぞ！」", "Battle/Dat/Battle/Message/071.bmd|0x0043AB": "「邪魔をするぞ！」", "Battle/Dat/Battle/Message/071.bmd|0x0043C7": "「その勝負、ワシが預かる！」", "Battle/Dat/Battle/Message/071.bmd|0x0043F2": "「ワシの弟子に手出しはさせん！」", "Battle/Dat/Battle/Message/071.bmd|0x004423": "「トウマ、下がれい！」", "Battle/Dat/Battle/Message/071.bmd|0x004445": "「退けい、ラウル！」", "Battle/Dat/Battle/Message/071.bmd|0x004464": "「その機体にはワシの先祖の魂が/　眠っておるのでな」", "Battle/Dat/Battle/Message/071.bmd|0x0044B1": "「む……まだ行けるのう！」", "Battle/Dat/Battle/Message/071.bmd|0x0044D9": "「いざ参る！」", "Battle/Dat/Battle/Message/071.bmd|0x0044EF": "「ゆけ！　噴射拳！」", "Battle/Dat/Battle/Message/071.bmd|0x00450E": "「飛べい！　噴射拳！」", "Battle/Dat/Battle/Message/071.bmd|0x004530": "「超絶熱線砲じゃ！！」", "Battle/Dat/Battle/Message/071.bmd|0x004552": "「超絶熱線砲！　くらえい！」", "Battle/Dat/Battle/Message/071.bmd|0x00457D": "「リシュウ・トウゴウ、推して参るぞ！」", "Battle/Dat/Battle/Message/071.bmd|0x0045B7": "「零式斬艦刀！　疾風迅雷！」", "Battle/Dat/Battle/Message/071.bmd|0x0045E2": "「必勝と必生の極意を見せてやろう……！」", "Battle/Dat/Battle/Message/071.bmd|0x00461F": "「ぬおおおお！！」", "Battle/Dat/Battle/Message/071.bmd|0x00463B": "「チェストォォォォォッ！！」", "Battle/Dat/Battle/Message/071.bmd|0x004666": "「我に断てぬものなし！！」", "Battle/Dat/Battle/Message/071.bmd|0x00468E": "「我が太刀に断てぬものなし！」", "Battle/Dat/Battle/Message/071.bmd|0x0046BC": "「剣は抜かずに済めば無事太平……！」", "Battle/Dat/Battle/Message/071.bmd|0x0046F3": "「抜いたからには、一刀両断！！」", "Battle/Dat/Battle/Message/071.bmd|0x004724": "「神速の剣を見よ！！」", "Battle/Dat/Battle/Message/071.bmd|0x004746": "「零式斬艦刀！　疾風怒濤！」", "Battle/Dat/Battle/Message/071.bmd|0x004771": "「キェェェェェイ！！」", "Battle/Dat/Battle/Message/071.bmd|0x004793": "「我が斬艦刀に断てぬものなし！」", "Battle/Dat/Battle/Message/071.bmd|0x0047C4": "「超闘士の拳を受けよ！」", "Battle/Dat/Battle/Message/071.bmd|0x0047E9": "「ゆけ！　回転噴射拳！」", "Battle/Dat/Battle/Message/071.bmd|0x00480E": "「貫け！　回転噴射拳！」", "Battle/Dat/Battle/Message/071.bmd|0x004833": "「熱線砲、最大出力！」", "Battle/Dat/Battle/Message/071.bmd|0x004855": "「究極熱線砲！　くらえい！！」", "Battle/Dat/Battle/Message/071.bmd|0x004883": "「打剣！」", "Battle/Dat/Battle/Message/071.bmd|0x004893": "「せいっ！」"}