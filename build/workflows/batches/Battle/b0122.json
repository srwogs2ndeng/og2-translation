{"Battle/Dat/Battle/Message/062.bmd|0x0097AA": "「まだ私もいる……」", "Battle/Dat/Battle/Message/062.bmd|0x0097C9": "「援護するわ、リュウセイ」", "Battle/Dat/Battle/Message/062.bmd|0x0097F1": "「リュウセイの力になる……！」", "Battle/Dat/Battle/Message/062.bmd|0x00981F": "「リュウセイの邪魔にならないように……！」", "Battle/Dat/Battle/Message/062.bmd|0x00985F": "「アラド、先を急ぎすぎ……」", "Battle/Dat/Battle/Message/062.bmd|0x00988A": "「続けて攻撃するわ、アラド」", "Battle/Dat/Battle/Message/062.bmd|0x0098B5": "「アラド……こっちの攻撃に当たらないでね」", "Battle/Dat/Battle/Message/062.bmd|0x0098F5": "「新教導隊の連携を見せてあげる……！」", "Battle/Dat/Battle/Message/062.bmd|0x00992F": "「さすがゼオラ……/　こっちの動きも計算に入れてる……」", "Battle/Dat/Battle/Message/062.bmd|0x009982": "「ゼオラが離脱した……私も攻撃を」", "Battle/Dat/Battle/Message/062.bmd|0x0099B6": "「フォーメーションＩね、ゼオラ」", "Battle/Dat/Battle/Message/062.bmd|0x0099E7": "「シャイン王女、後は私が……！」", "Battle/Dat/Battle/Message/062.bmd|0x009A18": "「シャイン王女の動きに合わせて……！」", "Battle/Dat/Battle/Message/062.bmd|0x009A52": "「王女のコントロールをフォロー……/　……攻撃！」", "Battle/Dat/Battle/Message/062.bmd|0x009A9C": "「シャイン王女、そちらに合わせます」", "Battle/Dat/Battle/Message/062.bmd|0x009AD3": "「少尉、援護します」", "Battle/Dat/Battle/Message/062.bmd|0x009AF2": "「カイ少佐、バックアップに入ります」", "Battle/Dat/Battle/Message/062.bmd|0x009B29": "「マイ、手伝うわ……！」", "Battle/Dat/Battle/Message/062.bmd|0x009B4E": "「マイ、後のことは気にしないで。/　私がやるから……！」", "Battle/Dat/Battle/Message/062.bmd|0x009BA1": "「ラミア少尉、フォローします」", "Battle/Dat/Battle/Message/062.bmd|0x009BCF": "「援護します、ラミア少尉」", "Battle/Dat/Battle/Message/062.bmd|0x009BF7": "「ゼンガー少佐、援護します」", "Battle/Dat/Battle/Message/062.bmd|0x009C22": "「フィオナ、援護するわ」", "Battle/Dat/Battle/Message/062.bmd|0x009C47": "「エクサランスのバックアップを……！」", "Battle/Dat/Battle/Message/062.bmd|0x009C81": "「エクサランスをバックアップ」", "Battle/Dat/Battle/Message/062.bmd|0x009CAF": "「ヒューゴ少尉、援護します」", "Battle/Dat/Battle/Message/062.bmd|0x009CDA": "「援護します、アクア少尉」", "Battle/Dat/Battle/Message/062.bmd|0x009D02": "「ショウコ、援護するわ」", "Battle/Dat/Battle/Message/062.bmd|0x009D27": "「イング、後は任せて」", "Battle/Dat/Battle/Message/062.bmd|0x009D49": "「雷鳳をバックアップ」", "Battle/Dat/Battle/Message/062.bmd|0x009D6B": "「艦長、後は私が」", "Battle/Dat/Battle/Message/062.bmd|0x009D87": "「エール・シュヴァリアーをバックアップ」", "Battle/Dat/Battle/Message/062.bmd|0x009DC4": "「ジェアン・シュヴァリアーをバックアップ」", "Battle/Dat/Battle/Message/062.bmd|0x009E04": "「ブランシュネージュをバックアップ」", "Battle/Dat/Battle/Message/062.bmd|0x009E3B": "「デア・ブランシュネージュをバックアップ」", "Battle/Dat/Battle/Message/062.bmd|0x009E7B": "「フォルテギガスをバックアップ」", "Battle/Dat/Battle/Message/062.bmd|0x009EAC": "「カバーする……！」", "Battle/Dat/Battle/Message/062.bmd|0x009ECB": "「これが私に出来ること……！」", "Battle/Dat/Battle/Message/062.bmd|0x009EF9": "「こっちの機体は、まだ保つもの……！」", "Battle/Dat/Battle/Message/062.bmd|0x009F33": "「リュウセイ、危ない……っ！」", "Battle/Dat/Battle/Message/062.bmd|0x009F61": "「リュウセイは……私が守る！」", "Battle/Dat/Battle/Message/062.bmd|0x009F8F": "「あの人を失いたくない……！」", "Battle/Dat/Battle/Message/062.bmd|0x009FBD": "「いくら身体が頑丈だからって……！」", "Battle/Dat/Battle/Message/062.bmd|0x009FF4": "「もう仲間を失いたくない！」", "Battle/Dat/Battle/Message/062.bmd|0x00A01F": "「ゼオラ、回避に専念して！」", "Battle/Dat/Battle/Message/062.bmd|0x00A04A": "「王女、コントロールをこちらに！」", "Battle/Dat/Battle/Message/062.bmd|0x00A07E": "「シャイン王女、早く私の後ろに！」", "Battle/Dat/Battle/Message/062.bmd|0x00A0B2": "「シャイン王女、/　コントロールを預かります！」", "Battle/Dat/Battle/Message/062.bmd|0x00A0F9": "「カイ少佐、後退して下さい……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A12D": "「マイ、無理をしないで……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A15B": "「ラミア少尉、離脱を！」", "Battle/Dat/Battle/Message/062.bmd|0x00A180": "「ヒューゴ少尉、後は私が」", "Battle/Dat/Battle/Message/062.bmd|0x00A1A8": "「アクア少尉、離脱を」", "Battle/Dat/Battle/Message/062.bmd|0x00A1CA": "「後退して、イング」", "Battle/Dat/Battle/Message/062.bmd|0x00A1E9": "「ショウコ、ここは任せて」", "Battle/Dat/Battle/Message/062.bmd|0x00A211": "「敵機の座標確認……これなら！」", "Battle/Dat/Battle/Message/062.bmd|0x00A242": "「もう一撃……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A25E": "「再攻撃可能……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A27D": "「回避パターン、予測。逃がさない……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A2BA": "「スプリットミサイル、発射……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A2EE": "「距離算出……ターゲット確認……」", "Battle/Dat/Battle/Message/062.bmd|0x00A322": "「これで！」", "Battle/Dat/Battle/Message/062.bmd|0x00A335": "「当てる！」", "Battle/Dat/Battle/Message/062.bmd|0x00A348": "「……発射！」", "Battle/Dat/Battle/Message/062.bmd|0x00A35E": "「……照準内に入った」", "Battle/Dat/Battle/Message/062.bmd|0x00A380": "「ターゲット、ロック……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A3AB": "「ロック・オン……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A3CD": "「追尾して……撃つ」", "Battle/Dat/Battle/Message/062.bmd|0x00A3EC": "「ＢＭセレクト、ガンファイト」", "Battle/Dat/Battle/Message/062.bmd|0x00A41A": "「ロール・キャノン……！　これで！」", "Battle/Dat/Battle/Message/062.bmd|0x00A451": "「ロール・キャノン……発射！」", "Battle/Dat/Battle/Message/062.bmd|0x00A47F": "「ショートレンジ……/　なら、ロール・キャノンで！」", "Battle/Dat/Battle/Message/062.bmd|0x00A4CC": "「ボストーク・レーザー……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A4FA": "「チャージ完了……レーザー発射！」", "Battle/Dat/Battle/Message/062.bmd|0x00A52E": "「ロングレンジ……/　なら、ボストーク・レーザーで！」", "Battle/Dat/Battle/Message/062.bmd|0x00A57E": "「Ｗ‐㍾ＮＫシステム、シングルモード……」", "Battle/Dat/Battle/Message/062.bmd|0x00A5BE": "「ソニック・ドライバー……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A5EC": "「フル・ブースト！」", "Battle/Dat/Battle/Message/062.bmd|0x00A60B": "「モードチェンジ、シングル」", "Battle/Dat/Battle/Message/062.bmd|0x00A636": "「ブレイクフィールド、展開……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A66A": "「シングルモードにセット……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A69B": "「ブレイクフィールド、出力最大……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A6D5": "「ファイナル・ロック！」", "Battle/Dat/Battle/Message/062.bmd|0x00A6FA": "「リュウセイみたいにやってみる……」", "Battle/Dat/Battle/Message/062.bmd|0x00A731": "「行くぜぇ！　超必殺ぅ！！」", "Battle/Dat/Battle/Message/062.bmd|0x00A75C": "「これで……終わり！」", "Battle/Dat/Battle/Message/062.bmd|0x00A77E": "「これで……最後！」", "Battle/Dat/Battle/Message/062.bmd|0x00A79D": "「パターン・エンド！」", "Battle/Dat/Battle/Message/062.bmd|0x00A7BF": "「フェアリィィィ・スパァァァァァァクッ！！」", "Battle/Dat/Battle/Message/062.bmd|0x00A802": "「音速爆砕っ！！」", "Battle/Dat/Battle/Message/062.bmd|0x00A81E": "「ラトゥーニ、行きますわよ」", "Battle/Dat/Battle/Message/062.bmd|0x00A849": "「はい……」", "Battle/Dat/Battle/Message/062.bmd|0x00A85C": "「Ｗ‐㍾ＮＫシステム、ダブルモード！」", "Battle/Dat/Battle/Message/062.bmd|0x00A896": "「託しますわ、あなたに！」", "Battle/Dat/Battle/Message/062.bmd|0x00A8BE": "「受け取りました、あなたから……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A8F5": "「パターンセレクト、Ｒ・Ｈ・Ｂ……！」", "Battle/Dat/Battle/Message/062.bmd|0x00A92F": "「エンゲージ！」", "Battle/Dat/Battle/Message/062.bmd|0x00A948": "「ラトゥーニ……」", "Battle/Dat/Battle/Message/062.bmd|0x00A964": "「シャイン王女……行きます！」", "Battle/Dat/Battle/Message/062.bmd|0x00A992": "「Ｗ‐㍾ＮＫシステム、モードチェンジ！」", "Battle/Dat/Battle/Message/062.bmd|0x00A9CF": "「ユーハブコントロール！」", "Battle/Dat/Battle/Message/062.bmd|0x00A9F7": "「アイハブコントロール！」", "Battle/Dat/Battle/Message/062.bmd|0x00AA1F": "「ラトゥーニ、/　ロイヤル・ハート・ブレイカーを使いますわよ！」", "Battle/Dat/Battle/Message/062.bmd|0x00AA7E": "「わかりました、王女」", "Battle/Dat/Battle/Message/062.bmd|0x00AAA0": "「モード、シングルからダブルに！」", "Battle/Dat/Battle/Message/062.bmd|0x00AAD4": "「そちらにコントロールを！」", "Battle/Dat/Battle/Message/062.bmd|0x00AAFF": "「はい。行きます！」", "Battle/Dat/Battle/Message/062.bmd|0x00AB1E": "「パターンセレクト！　ターゲット・ロック！」", "Battle/Dat/Battle/Message/062.bmd|0x00AB61": "「フルブースト！」", "Battle/Dat/Battle/Message/062.bmd|0x00AB7D": "「王女、ここはシングルで！」", "Battle/Dat/Battle/Message/062.bmd|0x00ABA8": "「後は任せますわよ、ラトゥーニ！」", "Battle/Dat/Battle/Message/062.bmd|0x00ABDC": "「シンクロアタック！」", "Battle/Dat/Battle/Message/062.bmd|0x00ABFE": "「シャイン王女！」", "Battle/Dat/Battle/Message/062.bmd|0x00AC1A": "「ラトゥーニ！」", "Battle/Dat/Battle/Message/062.bmd|0x00AC33": "「ファイナル……！」", "Battle/Dat/Battle/Message/062.bmd|0x00AC52": "「ブレイクですわ！」", "Battle/Dat/Battle/Message/062.bmd|0x00AC71": "「ファイナルシーケンス……！」", "Battle/Dat/Battle/Message/062.bmd|0x00AC9F": "「これで……！」", "Battle/Dat/Battle/Message/062.bmd|0x00ACB8": "「終わりでございますわ！」", "Battle/Dat/Battle/Message/062.bmd|0x00ACE0": "「ラトゥーニ、そちらに！」"}