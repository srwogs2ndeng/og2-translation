bmd|0x000AA7": "「ここで捕まるわけにはいかない……！」", "Battle/Dat/Battle/Message/248.bmd|0x000AE1": "「何としても/　シェードの外まで行かなければ……！」", "Battle/Dat/Battle/Message/248.bmd|0x000B2E": "「今度は僕の番だ」", "Battle/Dat/Battle/Message/248.bmd|0x000B4A": "「まだレンジ内だ……！」", "Battle/Dat/Battle/Message/248.bmd|0x000B6F": "「次はこちらから仕掛ける……！」", "Battle/Dat/Battle/Message/248.bmd|0x000BA0": "「僕は……ここで……！？」", "Battle/Dat/Battle/Message/248.bmd|0x000BC8": "「くっ、何としてでも可視領域へ……！」", "Battle/Dat/Battle/Message/248.bmd|0x000C02": "「耐えてくれ、キャニス……！」", "Battle/Dat/Battle/Message/248.bmd|0x000C30": "「ここで立ち止まってはいられない……！」", "Battle/Dat/Battle/Message/248.bmd|0x000C6D": "「推力低下が仇になったか……！」", "Battle/Dat/Battle/Message/248.bmd|0x000C9E": "「もっと機敏に反応しなければ……」", "Battle/Dat/Battle/Message/248.bmd|0x000CD2": "「制御系に支障はない……」", "Battle/Dat/Battle/Message/248.bmd|0x000CFA": "「それを受けるわけにはいかない」", "Battle/Dat/Battle/Message/248.bmd|0x000D2B": "「キャニス同士ならば……」", "Battle/Dat/Battle/Message/248.bmd|0x000D53": "「このまま逃げ切ってみせる」", "Battle/Dat/Battle/Message/248.bmd|0x000D7E": "「ＡＴＣ、ＡＣＳ、共に異常なし」", "Battle/Dat/Battle/Message/248.bmd|0x000DAF": "「この程度で怯むものか」", "Battle/Dat/Battle/Message/248.bmd|0x000DD4": "「………」", "Battle/Dat/Battle/Message/248.bmd|0x000DE4": "「このままでは的になってしまう……」", "Battle/Dat/Battle/Message/248.bmd|0x000E1B": "「こちらの間合いを読まれたか……！」", "Battle/Dat/Battle/Message/248.bmd|0x000E52": "「逃げられると思うな……！」", "Battle/Dat/Battle/Message/248.bmd|0x000E7D": "「その隙は逃がさない……！」", "Battle/Dat/Battle/Message/248.bmd|0x000EA8": "「やらせはしない！」", "Battle/Dat/Battle/Message/248.bmd|0x000EC7": "「これも受けてもらう」", "Battle/Dat/Battle/Message/248.bmd|0x000EE9": "「はああっ！」", "Battle/Dat/Battle/Message/248.bmd|0x000EFF": "「うおおおっ！」", "Battle/Dat/Battle/Message/248.bmd|0x000F18": "「切り裂く！」", "Battle/Dat/Battle/Message/248.bmd|0x000F2E": "「受けろっ！」", "Battle/Dat/Battle/Message/248.bmd|0x000F44": "「今だ！」", "Battle/Dat/Battle/Message/248.bmd|0x000F54": "「そこだ！」", "Battle/Dat/Battle/Message/248.bmd|0x000F67": "「当ててみせる！」", "Battle/Dat/Battle/Message/248.bmd|0x000F83": "「もらった！」", "Battle/Dat/Battle/Message/248.bmd|0x000F99": "「ターゲット・ロック」", "Battle/Dat/Battle/Message/248.bmd|0x000FBB": "「ターゲット・インサイト」", "Battle/Dat/Battle/Message/248.bmd|0x000FE3": "「くらえっ！」", "Battle/Dat/Battle/Message/248.bmd|0x000FF9": "「よし、ロックした……！」", "Battle/Dat/Battle/Message/248.bmd|0x001021": "「落ちろ！」", "Battle/Dat/Battle/Message/249.bmd|0x000E8F": "「生かして帰すか！」", "Battle/Dat/Battle/Message/249.bmd|0x000EAE": "「そこっ！」", "Battle/Dat/Battle/Message/249.bmd|0x000EC1": "「仕留めてみせる！」", "Battle/Dat/Battle/Message/249.bmd|0x000EE0": "「抵抗するな！」", "Battle/Dat/Battle/Message/249.bmd|0x000EF9": "「お前はここまでだ！」", "Battle/Dat/Battle/Message/249.bmd|0x000F1B": "「当ててやる！」", "Battle/Dat/Battle/Message/249.bmd|0x000F34": "「消え去れ！」", "Battle/Dat/Battle/Message/249.bmd|0x000F4A": "「調子に乗るな！」", "Battle/Dat/Battle/Message/249.bmd|0x000F66": "「や、やられた！！」", "Battle/Dat/Battle/Message/249.bmd|0x000F85": "「だ、脱出する！」", "Battle/Dat/Battle/Message/249.bmd|0x000FA1": "「ここまでか！　脱出だ！」", "Battle/Dat/Battle/Message/249.bmd|0x000FC9": "「くそっ！　機体を破棄する！」", "Battle/Dat/Battle/Message/249.bmd|0x000FF7": "「ええい！　次はこうはいかんぞ！」", "Battle/Dat/Battle/Message/249.bmd|0x00102B": "「必ず戻ってくるぞ！！」", "Battle/Dat/Battle/Message/249.bmd|0x001050": "「な、何だとぉぉ！？」", "Battle/Dat/Battle/Message/249.bmd|0x001072": "「ぐあああっ！！」", "Battle/Dat/Battle/Message/249.bmd|0x00108E": "「い、いかん！　これ以上くらったら……」", "Battle/Dat/Battle/Message/249.bmd|0x0010CB": "「な、何！？　損傷率７０％だとっ！？」", "Battle/Dat/Battle/Message/249.bmd|0x001105": "「うぬっ！/　ここまでのダメージを受けるとは！」", "Battle/Dat/Battle/Message/249.bmd|0x00114C": "「うおあっ！　ちょ、直撃だと！？」", "Battle/Dat/Battle/Message/249.bmd|0x001180": "「まぐれ当たりで調子に乗るなよ！」", "Battle/Dat/Battle/Message/249.bmd|0x0011B4": "「チ、思った以上に出来るな！」", "Battle/Dat/Battle/Message/249.bmd|0x0011E2": "「おのれ！　やってくれる！」", "Battle/Dat/Battle/Message/249.bmd|0x00120D": "「ぐうっ！/　一発や二発、食らったぐらいで！」", "Battle/Dat/Battle/Message/249.bmd|0x001251": "「ぬうっ！　こちらを甘く見るなよ！！」", "Battle/Dat/Battle/Message/249.bmd|0x00128B": "「ふん！　口ほどでもない！」", "Battle/Dat/Battle/Message/249.bmd|0x0012B6": "「こちらの力をなめているのか！？」", "Battle/Dat/Battle/Message/249.bmd|0x0012EA": "「無駄なあがきだ！」", "Battle/Dat/Battle/Message/249.bmd|0x001309": "「その程度で我々に刃向かうとは！」", "Battle/Dat/Battle/Message/249.bmd|0x00133D": "「無駄な抵抗は見苦しいぞ！」", "Battle/Dat/Battle/Message/249.bmd|0x001368": "「ダメージ軽微……作戦を続行する！」", "Battle/Dat/Battle/Message/249.bmd|0x00139F": "「ふん……チェックの必要もない程度か……」", "Battle/Dat/Battle/Message/249.bmd|0x0013DF": "「かわした！」", "Battle/Dat/Battle/Message/249.bmd|0x0013F5": "「モーションが大きすぎるんだよ！」", "Battle/Dat/Battle/Message/249.bmd|0x001429": "「遅いっ！」", "Battle/Dat/Battle/Message/249.bmd|0x00143C": "「照準がずれているようだな」", "Battle/Dat/Battle/Message/249.bmd|0x001467": "「よし、回避成功だ！」", "Battle/Dat/Battle/Message/249.bmd|0x001489": "「その程度！」", "Battle/Dat/Battle/Message/249.bmd|0x00149F": "「そんなもの！」", "Battle/Dat/Battle/Message/249.bmd|0x0014B8": "「残念だったな！」", "Battle/Dat/Battle/Message/249.bmd|0x0014D4": "「無駄だ！」", "Battle/Dat/Battle/Message/249.bmd|0x0014E7": "「………」", "Battle/Dat/Battle/Message/249.bmd|0x0014F7": "「くっ、補給を！」", "Battle/Dat/Battle/Message/249.bmd|0x001513": "「長期戦では不利か！」", "Battle/Dat/Battle/Message/249.bmd|0x001535": "「反撃できんとはな……！」", "Battle/Dat/Battle/Message/249.bmd|0x00155D": "「手も足も出させんつもりか！」"}