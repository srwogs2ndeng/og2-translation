{"Battle/Dat/Battle/Message/038.bmd|0x00A33B": "「リム、後は任せてくれ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A363": "「トウマ、フォローは任せろ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A391": "「イング、援護するぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A3B6": "「テュッティさん、援護します！」", "Battle/Dat/Battle/Message/038.bmd|0x00A3E7": "「ミオ、後は任せろ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A409": "「プレシア、後は俺が！」", "Battle/Dat/Battle/Message/038.bmd|0x00A42E": "「ヤンロンさん、自分が援護を！」", "Battle/Dat/Battle/Message/038.bmd|0x00A45F": "「割り込ませてもらうっ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A487": "「見逃すわけにいくかよ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A4AF": "「こっちで受け止める！」", "Battle/Dat/Battle/Message/038.bmd|0x00A4D4": "「突っ込め！　虎龍王！！」", "Battle/Dat/Battle/Message/038.bmd|0x00A4FC": "「虎龍王！　お前のスピードなら！」", "Battle/Dat/Battle/Message/038.bmd|0x00A530": "「キョウスケ中尉、下がってください！」", "Battle/Dat/Battle/Message/038.bmd|0x00A56A": "「少尉、何やってんです！」", "Battle/Dat/Battle/Message/038.bmd|0x00A592": "「エクセレン少尉！　早く後ろへ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A5C6": "「無茶をするな！　クスハ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A5F1": "「クスハ！　離脱するんだ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A61C": "「下がれ、タスク！」", "Battle/Dat/Battle/Message/038.bmd|0x00A63B": "「レオナ、後退しろ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A65D": "「リョウト！　奴は俺に任せろ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A68E": "「リオ！　前に出すぎだ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A6B6": "「後退しろ、ユウ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A6D5": "「カーラ、早く下がるんだ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A700": "「ラミアさん、今の内に離脱を！」", "Battle/Dat/Battle/Message/038.bmd|0x00A731": "「アラド！　どこを見ているんだ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A765": "「ゼンガー少佐、下がってください！」", "Battle/Dat/Battle/Message/038.bmd|0x00A79C": "「リュウセイ、突っ込み過ぎだぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A7D0": "「レーツェルさん、後退を！」", "Battle/Dat/Battle/Message/038.bmd|0x00A7FB": "「ヴィレッタ大尉、ここは引き受けます！」", "Battle/Dat/Battle/Message/038.bmd|0x00A838": "「下がるんだ、アリエイル！」", "Battle/Dat/Battle/Message/038.bmd|0x00A863": "「ヒューゴ少尉、離脱を！」", "Battle/Dat/Battle/Message/038.bmd|0x00A88B": "「アクア少尉、後退を！」", "Battle/Dat/Battle/Message/038.bmd|0x00A8B0": "「下がれ、ジョッシュ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A8D5": "「ジョッシュ、奴は俺が引き受ける！」", "Battle/Dat/Battle/Message/038.bmd|0x00A90C": "「ジョッシュ、/　お前が嫌だと言っても盾になる！」", "Battle/Dat/Battle/Message/038.bmd|0x00A956": "「下がるんだ、リム！」", "Battle/Dat/Battle/Message/038.bmd|0x00A978": "「トウマ、迂闊だぞ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A99A": "「イング、離脱しろ！」", "Battle/Dat/Battle/Message/038.bmd|0x00A9BC": "「テュッティさん、ここは自分が！」", "Battle/Dat/Battle/Message/038.bmd|0x00A9F0": "「逃げろ、ミオ！」", "Battle/Dat/Battle/Message/038.bmd|0x00AA0C": "「プレシア、下がるんだ！」", "Battle/Dat/Battle/Message/038.bmd|0x00AA34": "「ヤンロンさん、ここは引き受けます！」", "Battle/Dat/Battle/Message/038.bmd|0x00AA6E": "「一気に仕掛ける！」", "Battle/Dat/Battle/Message/038.bmd|0x00AA8D": "「まとめて相手してやる！」", "Battle/Dat/Battle/Message/038.bmd|0x00AAB5": "「そのフォーメーション、突き崩してやる！」", "Battle/Dat/Battle/Message/038.bmd|0x00AAF5": "「チャンスは逃がさない！」", "Battle/Dat/Battle/Message/038.bmd|0x00AB1D": "「まだいけるっ！」", "Battle/Dat/Battle/Message/038.bmd|0x00AB39": "「もう一度仕掛けるっ！」", "Battle/Dat/Battle/Message/038.bmd|0x00AB5E": "「スプリットミサイル！」", "Battle/Dat/Battle/Message/038.bmd|0x00AB83": "「これで決めるっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00ABA5": "「エネルギーチャージ、完了！」", "Battle/Dat/Battle/Message/038.bmd|0x00ABD3": "「ハイ・ツインランチャー！　ファイア！」", "Battle/Dat/Battle/Message/038.bmd|0x00AC10": "「ファイア！」", "Battle/Dat/Battle/Message/038.bmd|0x00AC26": "「タイガー・ナッコォ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AC4E": "「タイガー・ナックル、ＧＯ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AC7F": "「虎王飛拳！　行けぇぇっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00ACAD": "「おおおおおっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00ACCC": "「ランダム・スパイクッ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00ACF7": "「ゲットセット！　ランダム・スパイク！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AD37": "「出ろ！　ランダム・スパイク！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AD6B": "「虎龍王！　連挺乱打！」", "Battle/Dat/Battle/Message/038.bmd|0x00AD90": "「たあああああっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00ADB2": "「おりゃっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00ADCB": "「おおっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00ADE1": "「はあああっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00ADFD": "「おりゃあっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AE19": "「ソニック・ジャベリン！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AE44": "「吠えろ、虎王！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AE63": "「ゲットセット！/　ソニック・ジャベリン！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AEA7": "「伸びろ！　ソニック・ジャベリン！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AEE1": "「虎龍王！　神速槍！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AF06": "「猛虎の叫び、とくと聞け！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AF34": "「はああああっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AF53": "「一意専心、狙いは一つっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AF81": "「虎龍王！　虎王乱撃！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AFA9": "「虎龍王が最大奥義！　虎王乱撃！！」", "Battle/Dat/Battle/Message/038.bmd|0x00AFE0": "「でやあぁぁぁっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B002": "「はああああああ……っ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B02D": "「タイラント！」", "Battle/Dat/Battle/Message/038.bmd|0x00B046": "「オーバー……！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B065": "「ブレイクゥゥッ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B087": "「ターゲット・オールロック！/　ファイア！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B0CB": "「もらった！」", "Battle/Dat/Battle/Message/038.bmd|0x00B0E1": "「こいつで決めてやる！」", "Battle/Dat/Battle/Message/038.bmd|0x00B106": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/038.bmd|0x00B12B": "「くらえぇっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B147": "「こいつで叩き斬る！」", "Battle/Dat/Battle/Message/038.bmd|0x00B169": "「ソニック・ブースト！　キィィィィック！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B1AC": "「こいつを受け止められるか！」", "Battle/Dat/Battle/Message/038.bmd|0x00B1DA": "「ソニック・アクセラレーション！　ＧＯ！」", "Battle/Dat/Battle/Message/038.bmd|0x00B21A": "「多少無茶でも、これを使うしかないっ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B25A": "「チャクラム・シューター、ＧＯ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B291": "「チャクラム、セット！　ＧＯ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B2C5": "「行け！　チャクラム！」", "Battle/Dat/Battle/Message/038.bmd|0x00B2EA": "「行け！」", "Battle/Dat/Battle/Message/038.bmd|0x00B2FA": "「ファング・スラッシャー！」", "Battle/Dat/Battle/Message/038.bmd|0x00B325": "「ＧＯ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B338": "「ターゲット・ロック！/　リープ・ミサイル、ファイア！！」　", "Battle/Dat/Battle/Message/038.bmd|0x00B391": "「Ｇインパクト・キャノン、ファイア！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B3CE": "「Ｇインパクト・キャノン、発射！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B405": "「くらえ！　Ｇインパクト・キャノン！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B442": "「こいつで撃ち抜いてやる！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B470": "「ビッグ・ミサイル！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B495": "「オメガ・キャノン、発射！」", "Battle/Dat/Battle/Message/038.bmd|0x00B4C0": "「ドリル・アタァァック！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B4EB": "「ダブル・オメガレーザー！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B519": "「スパイラル・アタァァック！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B54A": "「アイソリッド・レーザー！！」　", "Battle/Dat/Battle/Message/038.bmd|0x00B57B": "「ブーストナックル、ＧＯ！！」　", "Battle/Dat/Battle/Message/038.bmd|0x00B5AC": "「行け！　ブーストナッコォッ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B5E0": "「くらえ！　ブーストナックル！！」　", "Battle/Dat/Battle/Message/038.bmd|0x00B617": "「ドリル・ブーストナックル！　ＧＯ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B654": "「ドリル・ブーストナッコォ！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B685": "「必殺！　オメガ・ブラスター！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B6B9": "「受けろ！　オメガ・ブラスター！！」", "Battle/Dat/Battle/Message/038.bmd|0x00B6F0": "「その間合い、見切った！」", "Battle/Dat/Battle/Message/038.bmd|0x00B718": "「斬る！」", "Battle/Dat/Battle/Message/038.bmd|0x00B728": "「一の太刀を打ち込むっ！」", "Battle/Dat/Battle/Message/038.bmd|0x00B750": "「二の太刀があると思うなよ！」", "Battle/Dat/Battle/Message/038.bmd|0x00B77E": "「ええいっ！」"}