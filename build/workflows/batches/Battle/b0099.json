{"Battle/Dat/Battle/Message/054.bmd|0x0065B9": "「やっぱり、カチーナ中尉のようには……！」", "Battle/Dat/Battle/Message/054.bmd|0x0065F9": "「ふう……。大したことはないみたいだ」", "Battle/Dat/Battle/Message/054.bmd|0x006633": "「こんなもの、当たった内には入らない……！」", "Battle/Dat/Battle/Message/054.bmd|0x006676": "「く……！　この程度で退くものか！」", "Battle/Dat/Battle/Message/054.bmd|0x0066AD": "「ここで逃げたら、中尉に怒鳴られる……！」", "Battle/Dat/Battle/Message/054.bmd|0x0066ED": "「つ、次は回避する……！」", "Battle/Dat/Battle/Message/054.bmd|0x006715": "「しまった！　よけきれなかった！」", "Battle/Dat/Battle/Message/054.bmd|0x006749": "「この程度の損傷なら……/　思い切った戦いが出来る」", "Battle/Dat/Battle/Message/054.bmd|0x006796": "「少し揺れただけか。さすがに重装甲だ」", "Battle/Dat/Battle/Message/054.bmd|0x0067D0": "「機動性重視と言っても、まだ保つ……！」", "Battle/Dat/Battle/Message/054.bmd|0x00680D": "「この機体でかわしきれなかったなんて……！」", "Battle/Dat/Battle/Message/054.bmd|0x006850": "「ゲシュペンストなら、多少の無茶は利く！」", "Battle/Dat/Battle/Message/054.bmd|0x006890": "「効いてませんよ、カークス将軍！」", "Battle/Dat/Battle/Message/054.bmd|0x0068C4": "「ブーステッド・チルドレン……/　さすがにやるな」", "Battle/Dat/Battle/Message/054.bmd|0x00690E": "「マシンナリー・チルドレンを/　甘く見たつもりはないけど……！」", "Battle/Dat/Battle/Message/054.bmd|0x00696D": "「効いていないぞ、イグニス！」", "Battle/Dat/Battle/Message/054.bmd|0x00699B": "「そんなもの、怖くはないぞ！」", "Battle/Dat/Battle/Message/054.bmd|0x0069C9": "「それで終わりか、コンターギオ！」", "Battle/Dat/Battle/Message/054.bmd|0x0069FD": "「受け止めたぞ、ロフ！」", "Battle/Dat/Battle/Message/054.bmd|0x006A22": "「何なんだ、あの男の口調は……」", "Battle/Dat/Battle/Message/054.bmd|0x006A53": "「効いていないぞ、夏喃！」", "Battle/Dat/Battle/Message/054.bmd|0x006A7B": "「受け止めたぞ、泰北！」", "Battle/Dat/Battle/Message/054.bmd|0x006AA0": "「耐えてみせたぞ、孫光龍！」", "Battle/Dat/Battle/Message/054.bmd|0x006ACB": "「無駄だ、ゼゼーナン！」", "Battle/Dat/Battle/Message/054.bmd|0x006AF0": "「う、受け止めたぞ、/　“破滅の王”の攻撃を……！」", "Battle/Dat/Battle/Message/054.bmd|0x006B3D": "「効いていないぞ、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/054.bmd|0x006B77": "「それがどうしたんだ、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/054.bmd|0x006BB7": "「この程度なら、魔装機とも戦える！」", "Battle/Dat/Battle/Message/054.bmd|0x006BEE": "「邪神の攻撃だって、耐えてみせる……！」", "Battle/Dat/Battle/Message/054.bmd|0x006C2B": "「受け止めたぞ、ジンライ！」", "Battle/Dat/Battle/Message/054.bmd|0x006C56": "「ジンライ……思っていた程じゃないかもな」", "Battle/Dat/Battle/Message/054.bmd|0x006C96": "「これ以上はやらせないぞ、ジンライ！」", "Battle/Dat/Battle/Message/054.bmd|0x006CD0": "「あの斧を何とか止めさえすれば……！」", "Battle/Dat/Battle/Message/054.bmd|0x006D0A": "「くっ！　ルイーナに食いつかれたか！」", "Battle/Dat/Battle/Message/054.bmd|0x006D44": "「ルイーナにやられるわけには……！」", "Battle/Dat/Battle/Message/054.bmd|0x006D7B": "「インスペクターと同じぐらいの強さか」", "Battle/Dat/Battle/Message/054.bmd|0x006DB5": "「ゲスト！　これ以上はやらせないぞ！」", "Battle/Dat/Battle/Message/054.bmd|0x006DEF": "「くっ、妖機人の動きは読みにくい……！」", "Battle/Dat/Battle/Message/054.bmd|0x006E2C": "「な、何なんだ、あの動きは！」", "Battle/Dat/Battle/Message/054.bmd|0x006E5A": "「防御力なら、こっちだって自信があるんだ！」", "Battle/Dat/Battle/Message/054.bmd|0x006E9D": "「四凶の力が、/　この程度だと思えないけど……！」", "Battle/Dat/Battle/Message/054.bmd|0x006EE7": "「迂闊に飛び込んだら、/　取り込まれてしまう……！」", "Battle/Dat/Battle/Message/054.bmd|0x006F34": "「これがお前の加護か、ガンエデン！」", "Battle/Dat/Battle/Message/054.bmd|0x006F6B": "「そんなものは通用しないぞ、ユーゼス！」", "Battle/Dat/Battle/Message/054.bmd|0x006FA8": "「当たるものか！」", "Battle/Dat/Battle/Message/054.bmd|0x006FC4": "「無駄なダメージは受けられない……！」", "Battle/Dat/Battle/Message/054.bmd|0x006FFE": "「かわした！　次の敵は！？」", "Battle/Dat/Battle/Message/054.bmd|0x007029": "「焦らずに相手の動きを見れば……！」", "Battle/Dat/Battle/Message/054.bmd|0x007060": "「運だけで生き延びてきたわけじゃない！」", "Battle/Dat/Battle/Message/054.bmd|0x00709D": "「妖機人に捕まってたまるか！」", "Battle/Dat/Battle/Message/054.bmd|0x0070CB": "「ルイーナにやられてたまるか！」", "Battle/Dat/Battle/Message/054.bmd|0x0070FC": "「あ、危なかった……！」", "Battle/Dat/Battle/Message/054.bmd|0x007121": "「カチーナ中尉に比べれば、/　マシな相手か……？」", "Battle/Dat/Battle/Message/054.bmd|0x00716B": "「カチーナ中尉の訓練のおかげか……」", "Battle/Dat/Battle/Message/054.bmd|0x0071A2": "「よし、かわしたぞ！」", "Battle/Dat/Battle/Message/054.bmd|0x0071C4": "「ふう、回避成功か」", "Battle/Dat/Battle/Message/054.bmd|0x0071E3": "「何とかやり過ごせたか……」", "Battle/Dat/Battle/Message/054.bmd|0x00720E": "「よし、この調子で……！」", "Battle/Dat/Battle/Message/054.bmd|0x007236": "「ギリギリだった……？」", "Battle/Dat/Battle/Message/054.bmd|0x00725B": "「化け物なんて怖くないぞ！」", "Battle/Dat/Battle/Message/054.bmd|0x007286": "「インスペクターと同じ要領でいけるな」", "Battle/Dat/Battle/Message/054.bmd|0x0072C0": "「まともに食らうわけにはっ！」", "Battle/Dat/Battle/Message/054.bmd|0x0072EE": "「バリア、出力全開！」", "Battle/Dat/Battle/Message/054.bmd|0x007310": "「防御装置、作動！」", "Battle/Dat/Battle/Message/054.bmd|0x00732F": "「ジャマーを使えば……！」", "Battle/Dat/Battle/Message/054.bmd|0x007357": "「こちらにはジャマーがあるんだ！」", "Battle/Dat/Battle/Message/054.bmd|0x00738B": "「………」", "Battle/Dat/Battle/Message/054.bmd|0x00739B": "「な、何も出来ないなんて……！」", "Battle/Dat/Battle/Message/054.bmd|0x0073CC": "「くっ、早くリロードを！」", "Battle/Dat/Battle/Message/054.bmd|0x0073F4": "「と、届かないのか……！？」", "Battle/Dat/Battle/Message/054.bmd|0x00741F": "「しまった、ロストした……！」", "Battle/Dat/Battle/Message/054.bmd|0x00744D": "「自分が援護します！」", "Battle/Dat/Battle/Message/054.bmd|0x00746F": "「もう一押し出来るっ！」", "Battle/Dat/Battle/Message/054.bmd|0x007494": "「隙が出来た！　今だっ！」", "Battle/Dat/Battle/Message/054.bmd|0x0074BC": "「このチャンス、逃がしはしないぞ！」", "Battle/Dat/Battle/Message/054.bmd|0x0074F3": "「自分も続きます！」", "Battle/Dat/Battle/Message/054.bmd|0x007512": "「カチーナ中尉！　前に出過ぎです！」", "Battle/Dat/Battle/Message/054.bmd|0x007549": "「よし……！　中尉のいつものタイミングだ！」", "Battle/Dat/Battle/Message/054.bmd|0x00758C": "「カチーナ中尉に追いつかなければ！」", "Battle/Dat/Battle/Message/054.bmd|0x0075C3": "「ラーダさん、後は自分に任せて下さい！」", "Battle/Dat/Battle/Message/054.bmd|0x007600": "「ラーダさん、援護します！」", "Battle/Dat/Battle/Message/054.bmd|0x00762B": "「レオナ少尉、後は任せて！」", "Battle/Dat/Battle/Message/054.bmd|0x007656": "「さすがレオナ少尉だ……！」", "Battle/Dat/Battle/Message/054.bmd|0x007681": "「タスク少尉、焦っちゃ駄目だ！」", "Battle/Dat/Battle/Message/054.bmd|0x0076B2": "「タ、タスク少尉！　どこへ！？」", "Battle/Dat/Battle/Message/054.bmd|0x0076E3": "「アラド、まだ終わってないぞ！」", "Battle/Dat/Battle/Message/054.bmd|0x007714": "「レフィーナ艦長、援護します！」", "Battle/Dat/Battle/Message/054.bmd|0x007745": "「ジョッシュ、後は任せて！」", "Battle/Dat/Battle/Message/054.bmd|0x007770": "「リム、援護するよ！」", "Battle/Dat/Battle/Message/054.bmd|0x007792": "「ヒューゴ少尉、援護します！」", "Battle/Dat/Battle/Message/054.bmd|0x0077C0": "「アクア少尉、後は自分が！」", "Battle/Dat/Battle/Message/054.bmd|0x0077EB": "「イング、後は任せて！」", "Battle/Dat/Battle/Message/054.bmd|0x007810": "「アリエイル、後は自分が！」", "Battle/Dat/Battle/Message/054.bmd|0x00783B": "「ミチル、後は任せてくれ！」", "Battle/Dat/Battle/Message/054.bmd|0x007866": "「ゼンガー少佐、援護します！」", "Battle/Dat/Battle/Message/054.bmd|0x007894": "「カイ少佐、後は自分が！」", "Battle/Dat/Battle/Message/054.bmd|0x0078BC": "「援護します、ギリアム少佐！」", "Battle/Dat/Battle/Message/054.bmd|0x0078EA": "「キョウスケ中尉、援護します！」", "Battle/Dat/Battle/Message/054.bmd|0x00791B": "「エクセレン少尉、援護します！」", "Battle/Dat/Battle/Message/054.bmd|0x00794C": "「ＳＲＸチームのバックアップを！」", "Battle/Dat/Battle/Message/054.bmd|0x007980": "「マサキ、援護する！」", "Battle/Dat/Battle/Message/054.bmd|0x0079A2": "「リューネ、後は任せて！」", "Battle/Dat/Battle/Message/054.bmd|0x0079CA": "「リューネ、君は先へ行くんだ！」", "Battle/Dat/Battle/Message/054.bmd|0x0079FB": "「ヤンロンさん、後は任せて下さい！」", "Battle/Dat/Battle/Message/054.bmd|0x007A32": "「テュッティさん、援護します！」", "Battle/Dat/Battle/Message/054.bmd|0x007A63": "「ミ、ミオ！　どこへ行くんだ！？」", "Battle/Dat/Battle/Message/054.bmd|0x007A97": "「王女、後は任せて下さい！」", "Battle/Dat/Battle/Message/054.bmd|0x007AC2": "「ガードには自信がある！」", "Battle/Dat/Battle/Message/054.bmd|0x007AEA": "「自分が守ります！」", "Battle/Dat/Battle/Message/054.bmd|0x007B09": "「打たれ強さには、自信がある！」", "Battle/Dat/Battle/Message/054.bmd|0x007B3A": "「やらせるものか！」", "Battle/Dat/Battle/Message/054.bmd|0x007B59": "「そこから離脱して下さい！」", "Battle/Dat/Battle/Message/054.bmd|0x007B84": "「自分が受け止めます！」", "Battle/Dat/Battle/Message/054.bmd|0x007BA9": "「先走っちゃ駄目です！　カチーナ中尉！」", "Battle/Dat/Battle/Message/054.bmd|0x007BE6": "「カチーナ中尉！　左から敵が！！」", "Battle/Dat/Battle/Message/054.bmd|0x007C1A": "「中尉をやらせはしない！」", "Battle/Dat/Battle/Message/054.bmd|0x007C42": "「ラーダさん、後退を！」", "Battle/Dat/Battle/Message/054.bmd|0x007C67": "「ラーダさん、自分が盾になります！」", "Battle/Dat/Battle/Message/054.bmd|0x007C9E": "「レオナ少尉、離脱を！」", "Battle/Dat/Battle/Message/054.bmd|0x007CC3": "「タスク少尉、早く下がるんだ！」"}