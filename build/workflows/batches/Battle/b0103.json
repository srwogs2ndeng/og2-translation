{"Battle/Dat/Battle/Message/055.bmd|0x00494A": "「ＶＬＳホーミングミサイル、発射！！」", "Battle/Dat/Battle/Message/055.bmd|0x004984": "「両舷発射口、全開放！　ミサイル、発射！」", "Battle/Dat/Battle/Message/055.bmd|0x0049C4": "「上部両舷ミサイル発射口、開け！　撃て！」", "Battle/Dat/Battle/Message/055.bmd|0x004A04": "「ＶＬＳホーミングミサイル、撃て！！」", "Battle/Dat/Battle/Message/055.bmd|0x004A3E": "「上部両舷ミサイル、全門撃て！！」", "Battle/Dat/Battle/Message/055.bmd|0x004A72": "「対艦ミサイル、スタンバイ」", "Battle/Dat/Battle/Message/055.bmd|0x004A9D": "「１番、４番！　撃て！」", "Battle/Dat/Battle/Message/055.bmd|0x004AC2": "「対艦ミサイル、発射口開け！」", "Battle/Dat/Battle/Message/055.bmd|0x004AF0": "「発射管１番から６番まで装填完了」", "Battle/Dat/Battle/Message/055.bmd|0x004B24": "「まずは１番、４番！　撃て！」", "Battle/Dat/Battle/Message/055.bmd|0x004B52": "「対艦ミサイル、１番、４番発射口開け！」", "Battle/Dat/Battle/Message/055.bmd|0x004B8F": "「撃て！」", "Battle/Dat/Battle/Message/055.bmd|0x004B9F": "「イルミネーター・リンク」", "Battle/Dat/Battle/Message/055.bmd|0x004BC7": "「各砲座へ……/　目標を撃墜すれば、艦長の秘密を教えますぞ」", "Battle/Dat/Battle/Message/055.bmd|0x004C20": "「あ、あの……副長？」", "Battle/Dat/Battle/Message/055.bmd|0x004C42": "「１番、２番主砲、スタンバイ」", "Battle/Dat/Battle/Message/055.bmd|0x004C70": "「撃て！！」", "Battle/Dat/Battle/Message/055.bmd|0x004C83": "「艦長、頃合いですぞ」", "Battle/Dat/Battle/Message/055.bmd|0x004CA5": "「ええ。１番、２番主砲、撃て！！」", "Battle/Dat/Battle/Message/055.bmd|0x004CD9": "「ドラゴン２より各機へ！/　本艦はこれより主砲を発射する！」", "Battle/Dat/Battle/Message/055.bmd|0x004D32": "「主砲、１番、２番！　撃て！！」", "Battle/Dat/Battle/Message/055.bmd|0x004D63": "「１番、２番主砲、相対測合わせ良し」", "Battle/Dat/Battle/Message/055.bmd|0x004D9A": "「目標、インレンジ」", "Battle/Dat/Battle/Message/055.bmd|0x004DB9": "「主砲、１番、２番！　てーっ！」", "Battle/Dat/Battle/Message/055.bmd|0x004DEA": "「砲撃手、目標を撃墜すれば、/　艦長のブロマイドを進呈しますぞ」", "Battle/Dat/Battle/Message/055.bmd|0x004E49": "「そんなものをいつの間に！？」", "Battle/Dat/Battle/Message/055.bmd|0x004E77": "「砲撃手、目標を撃墜すれば、/　艦長だけでなく、/　ユンのブロマイドも差し上げますぞ」", "Battle/Dat/Battle/Message/055.bmd|0x004EF5": "「構いませんが、後で代金を徴収しますからね」", "Battle/Dat/Battle/Message/055.bmd|0x004F38": "「それより、砲撃を！」", "Battle/Dat/Battle/Message/055.bmd|0x004F5A": "「艦首超重力衝撃砲、発射用意！」", "Battle/Dat/Battle/Message/055.bmd|0x004F8B": "「了解。シークェンスＧ、開始！」", "Battle/Dat/Battle/Message/055.bmd|0x004FBC": "「測距、最終確認。誤差修正、上下角２度」", "Battle/Dat/Battle/Message/055.bmd|0x004FF9": "「エネルギー充填、１００％を超えます！」", "Battle/Dat/Battle/Message/055.bmd|0x005036": "「艦長、発射準備完了です」", "Battle/Dat/Battle/Message/055.bmd|0x00505E": "「超重力衝撃砲、発射！！」", "Battle/Dat/Battle/Message/055.bmd|0x005086": "「今が重力衝撃砲の使い時ですぞ、艦長」", "Battle/Dat/Battle/Message/055.bmd|0x0050C0": "「ええ！　シークェンスＧへの移行を！」", "Battle/Dat/Battle/Message/055.bmd|0x0050FA": "「ドラゴン２より各機へ！/　直ちに射線上から離脱を！」", "Battle/Dat/Battle/Message/055.bmd|0x00514A": "「エネルギー充填１２０％！」", "Battle/Dat/Battle/Message/055.bmd|0x005175": "「総員、対衝撃・閃光防御！」", "Battle/Dat/Battle/Message/055.bmd|0x0051A0": "「超重力衝撃砲！　発射して下さい！！」", "Battle/Dat/Battle/Message/055.bmd|0x0051DA": "「ドラゴン２より各機へ！/　本艦はこれより超重力衝撃砲を発射します！」", "Battle/Dat/Battle/Message/055.bmd|0x005242": "「シークェンスＧ、始め！」", "Battle/Dat/Battle/Message/055.bmd|0x00526A": "「重力ブレーキ、作動準備！」", "Battle/Dat/Battle/Message/055.bmd|0x005295": "「エネルギーコンデンサー、問題なし！」", "Battle/Dat/Battle/Message/055.bmd|0x0052CF": "「最終安全装置、解除！」", "Battle/Dat/Battle/Message/055.bmd|0x0052F4": "「超重力衝撃砲、撃てーっ！！」", "Battle/Dat/Battle/Message/056.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/056.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/056.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/056.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/056.bmd|0x0003FC": "「………？」", "Battle/Dat/Battle/Message/057.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/057.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/057.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/057.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/057.bmd|0x0003FC": "「………？」", "Battle/Dat/Battle/Message/058.bmd|0x005604": "「貴様らとは年季が違うわ！」", "Battle/Dat/Battle/Message/058.bmd|0x00562F": "「行くぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x005642": "「勝敗は瞬時に決する！」", "Battle/Dat/Battle/Message/058.bmd|0x005667": "「そんな腕では戦場で生き残れんぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x00569E": "「まだまだ若い者には負けん！」", "Battle/Dat/Battle/Message/058.bmd|0x0056CC": "「もらうぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x0056E2": "「フン、そこか！」", "Battle/Dat/Battle/Message/058.bmd|0x0056FE": "「そんな動きで！」", "Battle/Dat/Battle/Message/058.bmd|0x00571A": "「逃がさん！」", "Battle/Dat/Battle/Message/058.bmd|0x005730": "「そこだ！」", "Battle/Dat/Battle/Message/058.bmd|0x005743": "「消え失せろ！！」", "Battle/Dat/Battle/Message/058.bmd|0x00575F": "「逃げる隙など与えんぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x005787": "「攻める時は、大胆かつ着実に、だ！」", "Battle/Dat/Battle/Message/058.bmd|0x0057BE": "「伊達に教導隊の隊長を/　やっているわけではないのでな……！」", "Battle/Dat/Battle/Message/058.bmd|0x00581A": "「この間合いは……タイプＧ向きだ！」", "Battle/Dat/Battle/Message/058.bmd|0x005851": "「ゲシュペンストの力、思い知るがいい！」", "Battle/Dat/Battle/Message/058.bmd|0x00588E": "「こいつは俺の手足も同然でな……！」", "Battle/Dat/Battle/Message/058.bmd|0x0058C5": "「ゲシュペンストの実力を見せてやる！」", "Battle/Dat/Battle/Message/058.bmd|0x0058FF": "「改型の性能を見せてやる！」", "Battle/Dat/Battle/Message/058.bmd|0x00592A": "「生まれ変わったゲシュペンストの力、/　見るがいい！」", "Battle/Dat/Battle/Message/058.bmd|0x00597A": "「こいつが、/　ただのマイナーチェンジ機でないことを/　教えてやる！」", "Battle/Dat/Battle/Message/058.bmd|0x0059E0": "「こいつを/　ただのゲシュペンストだと思うなよ！」", "Battle/Dat/Battle/Message/058.bmd|0x005A2A": "「ハロウィン・プランの成果を見せてやる！」", "Battle/Dat/Battle/Message/058.bmd|0x005A6A": "「改型のパワー、とくと味わえ！」", "Battle/Dat/Battle/Message/058.bmd|0x005A9B": "「俺の部下達に手出しはさせんぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x005ACF": "「スクールの生き残りか……！」", "Battle/Dat/Battle/Message/058.bmd|0x005AFD": "「この俺の拳で、躾けてやる！」", "Battle/Dat/Battle/Message/058.bmd|0x005B2B": "「行くぞ、ドゥバン・オーグ！」", "Battle/Dat/Battle/Message/058.bmd|0x005B59": "「アレス・ガイスト、奴のコアは……！」", "Battle/Dat/Battle/Message/058.bmd|0x005B93": "「そのパワーで/　俺を押し切れると思うなよ！」", "Battle/Dat/Battle/Message/058.bmd|0x005BD7": "「その力は、/　お前に制御できるものではない！」", "Battle/Dat/Battle/Message/058.bmd|0x005C1E": "「ドゥバン！　貴様をここで止める！」", "Battle/Dat/Battle/Message/058.bmd|0x005C55": "「真っ向勝負だ、アクイラ！」", "Battle/Dat/Battle/Message/058.bmd|0x005C80": "「メリオルエッセ機、確認。攻撃開始！」", "Battle/Dat/Battle/Message/058.bmd|0x005CBA": "「あのメリオルエッセは、俺に任せろ！」", "Battle/Dat/Battle/Message/058.bmd|0x005CF4": "「行くぞ、イグニス！」", "Battle/Dat/Battle/Message/058.bmd|0x005D16": "「覚悟してもらうぞ、コンターギオ！」", "Battle/Dat/Battle/Message/058.bmd|0x005D4D": "「そちら側に回ったか、リー中佐……！」", "Battle/Dat/Battle/Message/058.bmd|0x005D87": "「鋼龍戦隊を欺いた罪……/　許すわけにはいかん！」", "Battle/Dat/Battle/Message/058.bmd|0x005DD1": "「アルテウル！　ここで決着をつけるぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x005E0E": "「ペルフェクティオ！/　この世界にお前の居場所はない！」", "Battle/Dat/Battle/Message/058.bmd|0x005E61": "「結局、/　やることはインスペクターと同じか！」", "Battle/Dat/Battle/Message/058.bmd|0x005EA8": "「武力で俺達を/　押さえつけられると思うな！」", "Battle/Dat/Battle/Message/058.bmd|0x005EEC": "「行くぞ、ロフ！」", "Battle/Dat/Battle/Message/058.bmd|0x005F08": "「この勝負、受けてもらうぞ、ロフ！」", "Battle/Dat/Battle/Message/058.bmd|0x005F3F": "「ああいう奴ほど、油断ならん……！」", "Battle/Dat/Battle/Message/058.bmd|0x005F76": "「行くぞ、セティ！」", "Battle/Dat/Battle/Message/058.bmd|0x005F95": "「引き際を見誤ったな、ゼゼーナン！」", "Battle/Dat/Battle/Message/058.bmd|0x005FCC": "「戯言はそこまでにしろ、孫光龍！」", "Battle/Dat/Battle/Message/058.bmd|0x006000": "「光龍！/　貴様の世迷い言に付き合う気はない！」", "Battle/Dat/Battle/Message/058.bmd|0x006047": "「ガイアセイバーズ、/　お前達の好きにはやらせん！」", "Battle/Dat/Battle/Message/058.bmd|0x006094": "「ガイアセイバーズ……/　ただで済むと思うなよ！」", "Battle/Dat/Battle/Message/058.bmd|0x0060DE": "「行くぞ、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/058.bmd|0x00610C": "「トウマ！　システムに呑み込まれるな！」", "Battle/Dat/Battle/Message/058.bmd|0x006149": "「何としても雷鳳を止める！」", "Battle/Dat/Battle/Message/058.bmd|0x006174": "「トウマ！　荒療治で行くぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x0061A2": "「メディウス・ロクス……/　パイロットは誰だ？」", "Battle/Dat/Battle/Message/058.bmd|0x0061E9": "「ツェントル・プロジェクト……/　やはり、何かあるな」", "Battle/Dat/Battle/Message/058.bmd|0x006239": "「アルベロ・エスト少佐か……！」", "Battle/Dat/Battle/Message/058.bmd|0x00626A": "「少佐、/　あなたと戦うことになるとはな……！」", "Battle/Dat/Battle/Message/058.bmd|0x0062B1": "「ターゲット、メディウス・ロクス……！」", "Battle/Dat/Battle/Message/058.bmd|0x0062EE": "「ジンライをここで食い止める！」", "Battle/Dat/Battle/Message/058.bmd|0x00631F": "「無人機に後れは取らん！」"}