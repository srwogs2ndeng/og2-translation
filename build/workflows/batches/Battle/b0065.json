{"Battle/Dat/Battle/Message/041.bmd|0x0090B9": "「レオナ、無茶をするな！」", "Battle/Dat/Battle/Message/041.bmd|0x0090E1": "「兄さん、この場は俺が預かる！」", "Battle/Dat/Battle/Message/041.bmd|0x009112": "「隊長、早く離脱を！」", "Battle/Dat/Battle/Message/041.bmd|0x009134": "「下がれ、ラトゥーニ！」", "Battle/Dat/Battle/Message/041.bmd|0x009159": "「王女、御身は自分が守ります！」", "Battle/Dat/Battle/Message/041.bmd|0x00918A": "「下がれ、ジョッシュ！」", "Battle/Dat/Battle/Message/041.bmd|0x0091AF": "「後退しろ、リム！」", "Battle/Dat/Battle/Message/041.bmd|0x0091CE": "「ヒューゴ少尉、ここは自分が！」", "Battle/Dat/Battle/Message/041.bmd|0x0091FF": "「アクア少尉、後退を！」", "Battle/Dat/Battle/Message/041.bmd|0x009224": "「下がれ、アリエイル！」", "Battle/Dat/Battle/Message/041.bmd|0x009249": "「離脱しろ、イング！」", "Battle/Dat/Battle/Message/041.bmd|0x00926B": "「散開する時間は与えん！」", "Battle/Dat/Battle/Message/041.bmd|0x009293": "「まとめて砕け散るがいい！」", "Battle/Dat/Battle/Message/041.bmd|0x0092BE": "「これで終わらせる！」", "Battle/Dat/Battle/Message/041.bmd|0x0092E0": "「狙いは変わらん……攻撃する！」", "Battle/Dat/Battle/Message/041.bmd|0x009311": "「スプリットミサイル、発射！」", "Battle/Dat/Battle/Message/041.bmd|0x00933F": "「落ちろ！」", "Battle/Dat/Battle/Message/041.bmd|0x009352": "「逃がしはしない！」", "Battle/Dat/Battle/Message/041.bmd|0x009371": "「くらえ！」", "Battle/Dat/Battle/Message/041.bmd|0x009384": "「この一撃で！」", "Battle/Dat/Battle/Message/041.bmd|0x00939D": "「行けっ！　ビームチャクラム！」", "Battle/Dat/Battle/Message/041.bmd|0x0093CE": "「チャクラム！　ＧＯ！」", "Battle/Dat/Battle/Message/041.bmd|0x0093F3": "「ビームチャクラム、射出！」", "Battle/Dat/Battle/Message/041.bmd|0x00941E": "「いけ！　光の戦輪よ！」", "Battle/Dat/Battle/Message/041.bmd|0x009443": "「我が敵を切り裂け！　ビームチャクラム！」", "Battle/Dat/Battle/Message/041.bmd|0x009483": "「うなれ！　チャクラム！」", "Battle/Dat/Battle/Message/041.bmd|0x0094AB": "「逃がさん！」", "Battle/Dat/Battle/Message/041.bmd|0x0094C1": "「とどめだ！」", "Battle/Dat/Battle/Message/041.bmd|0x0094D7": "「もう一撃！」", "Battle/Dat/Battle/Message/041.bmd|0x0094ED": "「ターゲット・インサイト！」", "Battle/Dat/Battle/Message/041.bmd|0x009518": "「ハイゾルランチャー、シューッ！！」", "Battle/Dat/Battle/Message/041.bmd|0x00954F": "「くらえ！　ハイゾルランチャー！！」", "Battle/Dat/Battle/Message/041.bmd|0x009586": "「観念しろ……ハイゾルランチャー、発射！！」", "Battle/Dat/Battle/Message/041.bmd|0x0095C9": "「これを受けて塵となれ！」", "Battle/Dat/Battle/Message/041.bmd|0x0095F1": "「ターゲット・ロック……！」", "Battle/Dat/Battle/Message/041.bmd|0x00961C": "「ハイゾルランチャー、発射！」", "Battle/Dat/Battle/Message/041.bmd|0x00964A": "「バーストモード……ターゲット・ロック！」", "Battle/Dat/Battle/Message/041.bmd|0x00968A": "「バーストモード……全て叩き落とす！」", "Battle/Dat/Battle/Message/041.bmd|0x0096C4": "「行け！　ハイゾルランチャー！」", "Battle/Dat/Battle/Message/041.bmd|0x0096F5": "「集束モード……ターゲット・ロック！」", "Battle/Dat/Battle/Message/041.bmd|0x00972F": "「一点集中……ターゲット・ロック！」", "Battle/Dat/Battle/Message/041.bmd|0x009766": "「くらえ！　ハイゾルランチャー！」", "Battle/Dat/Battle/Message/041.bmd|0x00979A": "「二人とも、フォーメーションＲで行くわよ！」", "Battle/Dat/Battle/Message/041.bmd|0x0097DD": "「了解です、大尉」", "Battle/Dat/Battle/Message/041.bmd|0x0097F9": "「よっしゃ！　行くぜ！」", "Battle/Dat/Battle/Message/041.bmd|0x00981E": "「ハイゾルランチャー、シューッ！」", "Battle/Dat/Battle/Message/041.bmd|0x009852": "「ストライクシールド！」", "Battle/Dat/Battle/Message/041.bmd|0x009877": "「チェェーーンジ！　Ｒ‐ウィング！！」", "Battle/Dat/Battle/Message/041.bmd|0x0098B1": "「完全に捉えたぞ！」", "Battle/Dat/Battle/Message/041.bmd|0x0098D0": "「今よ！　リュウ！」", "Battle/Dat/Battle/Message/041.bmd|0x0098EF": "「うおおおおっ！！」", "Battle/Dat/Battle/Message/041.bmd|0x00990E": "「破を念じて……刃となれ！！」", "Battle/Dat/Battle/Message/041.bmd|0x00993C": "「Ｔ‐ＬＩＮＫ！/　クラッシュソォォォォドッ！！」", "Battle/Dat/Battle/Message/041.bmd|0x009986": "「バレル展開！」", "Battle/Dat/Battle/Message/041.bmd|0x00999F": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/041.bmd|0x0099C4": "「出力最大！　発射！」", "Battle/Dat/Battle/Message/041.bmd|0x0099E6": "「受けろ！」", "Battle/Dat/Battle/Message/041.bmd|0x0099F9": "「逃がしはせん！」", "Battle/Dat/Battle/Message/041.bmd|0x009A15": "「これでとどめだ！」", "Battle/Dat/Battle/Message/041.bmd|0x009A34": "「ターゲット・ロック！　フィールド展開！」", "Battle/Dat/Battle/Message/041.bmd|0x009A74": "「跳弾は……かわせばいい！」", "Battle/Dat/Battle/Message/041.bmd|0x009A9F": "「クレイモア、発射！」", "Battle/Dat/Battle/Message/041.bmd|0x009AC1": "「ターゲット、マルチロック！　落ちろ！」", "Battle/Dat/Battle/Message/041.bmd|0x009AFE": "「１機たりとも逃がしはせん！　行けっ！」", "Battle/Dat/Battle/Message/041.bmd|0x009B3B": "「我が敵を切り裂け！」", "Battle/Dat/Battle/Message/041.bmd|0x009B5D": "「ファング・スラッシャー！」", "Battle/Dat/Battle/Message/041.bmd|0x009B88": "「ハイ・ツインランチャー、シューッ！」", "Battle/Dat/Battle/Message/041.bmd|0x009BC2": "「ブーストナックル、発射！」", "Battle/Dat/Battle/Message/041.bmd|0x009BED": "「行け、ブーストナックル！」", "Battle/Dat/Battle/Message/041.bmd|0x009C18": "「ターゲット・インサイト……！　行け！」", "Battle/Dat/Battle/Message/041.bmd|0x009C55": "「これで最後だ！」", "Battle/Dat/Battle/Message/041.bmd|0x009C71": "「くらえ！！」", "Battle/Dat/Battle/Message/041.bmd|0x009C87": "「クラッシャー、セットアップ！」", "Battle/Dat/Battle/Message/041.bmd|0x009CB8": "「砕け散れ！」", "Battle/Dat/Battle/Message/041.bmd|0x009CCE": "「ジャケットアーマー、パージ！」", "Battle/Dat/Battle/Message/041.bmd|0x009CFF": "「行くぞ！」", "Battle/Dat/Battle/Message/041.bmd|0x009D12": "「百舌の力を……」", "Battle/Dat/Battle/Message/041.bmd|0x009D2E": "「とくと味わえ！」", "Battle/Dat/Battle/Message/041.bmd|0x009D4A": "「オクスタン、Ｅモード！　シューッ！」", "Battle/Dat/Battle/Message/041.bmd|0x009D84": "「扱いづらい銃だが……やってみせる！」", "Battle/Dat/Battle/Message/041.bmd|0x009DBE": "「オクスタン、Ｂモード！　シューッ！」", "Battle/Dat/Battle/Message/041.bmd|0x009DF8": "「ＢとＥ……同時に発射する！」", "Battle/Dat/Battle/Message/041.bmd|0x009E26": "「隼よ、我が敵を撃ち貫け！」", "Battle/Dat/Battle/Message/041.bmd|0x009E51": "「Ｗモード！　シューッ！」", "Battle/Dat/Battle/Message/041.bmd|0x009E79": "「エレクトロード、セット！　行くぞ！」", "Battle/Dat/Battle/Message/041.bmd|0x009EB3": "「ジガンから逃げられると思うな！」", "Battle/Dat/Battle/Message/041.bmd|0x009EE7": "「粉砕する！」", "Battle/Dat/Battle/Message/041.bmd|0x009EFD": "「狙いは外さん！」", "Battle/Dat/Battle/Message/041.bmd|0x009F19": "「ハルバート・ランチャー、シューッ！」", "Battle/Dat/Battle/Message/041.bmd|0x009F53": "「ロック解除！　自動追尾開始！」", "Battle/Dat/Battle/Message/041.bmd|0x009F84": "「行け！　ソードブレイカー！」", "Battle/Dat/Battle/Message/041.bmd|0x009FB2": "「スラッシュ・リッパー！」", "Battle/Dat/Battle/Message/041.bmd|0x009FDA": "「行け！　鋼の戦輪よ！」", "Battle/Dat/Battle/Message/041.bmd|0x009FFF": "「グラビトン・ランチャー、シューッ！」", "Battle/Dat/Battle/Message/041.bmd|0x00A039": "「行け、リープ・スラッシャー！」", "Battle/Dat/Battle/Message/041.bmd|0x00A06A": "「斬り裂く……！」", "Battle/Dat/Battle/Message/041.bmd|0x00A086": "「シシオウブレード！」", "Battle/Dat/Battle/Message/041.bmd|0x00A0A8": "「ブースト！」", "Battle/Dat/Battle/Message/041.bmd|0x00A0BE": "「リボルビング・バンカー！」", "Battle/Dat/Battle/Message/041.bmd|0x00A0E9": "「砕け散れ！！」", "Battle/Dat/Battle/Message/041.bmd|0x00A102": "「ここが切り札の使い時か！」", "Battle/Dat/Battle/Message/041.bmd|0x00A12D": "「クレイモア！」", "Battle/Dat/Battle/Message/041.bmd|0x00A146": "「続けて行くぞ！」", "Battle/Dat/Battle/Message/041.bmd|0x00A162": "「もう逃げられん！」", "Battle/Dat/Battle/Message/041.bmd|0x00A181": "「バンカー！　撃ち抜く！！」", "Battle/Dat/Battle/Message/041.bmd|0x00A1AC": "「この距離……/　危険だが、見返りは充分にある！」", "Battle/Dat/Battle/Message/041.bmd|0x00A1F6": "「消え去れ！」", "Battle/Dat/Battle/Message/041.bmd|0x00A20C": "「ブレード・サイ、セット！」", "Battle/Dat/Battle/Message/041.bmd|0x00A237": "「パターン・セレクト！」", "Battle/Dat/Battle/Message/041.bmd|0x00A25C": "「はあああっ！」", "Battle/Dat/Battle/Message/041.bmd|0x00A275": "「モード・チェンジ！」", "Battle/Dat/Battle/Message/041.bmd|0x00A297": "「プラズマ・ステーク、セット！」", "Battle/Dat/Battle/Message/041.bmd|0x00A2C8": "「ジェット・マグナム！」", "Battle/Dat/Battle/Message/041.bmd|0x00A2ED": "「スプリットミサイル！」", "Battle/Dat/Battle/Message/041.bmd|0x00A312": "「ロングレンジ・モード！」", "Battle/Dat/Battle/Message/041.bmd|0x00A33A": "「出力最大！　シューッ！」", "Battle/Dat/Battle/Message/041.bmd|0x00A362": "「この連打、かわせまい！」", "Battle/Dat/Battle/Message/041.bmd|0x00A38A": "「せいっ！！」", "Battle/Dat/Battle/Message/041.bmd|0x00A3A0": "「メガ・ブラスターキャノン、シューッ！」", "Battle/Dat/Battle/Message/041.bmd|0x00A3DD": "「まだ終わらん！」"}