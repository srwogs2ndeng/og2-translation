{"Battle/Dat/Battle/Message/078.bmd|0x00A268": "「バーナゥ！/　オーバー・カイザー・ソード！！」", "Battle/Dat/Battle/Message/078.bmd|0x00A2AF": "「カイザークラァァァッシュ！！」", "Battle/Dat/Battle/Message/079.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/080.bmd|0x0014AB": "「さあ、行くわよ！」", "Battle/Dat/Battle/Message/080.bmd|0x0014CA": "「そこねっ！」", "Battle/Dat/Battle/Message/080.bmd|0x0014E0": "「お兄ちゃんばかりに/　任せてられないんだから！」", "Battle/Dat/Battle/Message/080.bmd|0x00152A": "「そっちの好きには、やらせないから！」", "Battle/Dat/Battle/Message/080.bmd|0x001564": "「当ててみせるっ！」", "Battle/Dat/Battle/Message/080.bmd|0x001583": "「今ねっ！」", "Battle/Dat/Battle/Message/080.bmd|0x001596": "「ん！　いい所に！」", "Battle/Dat/Battle/Message/080.bmd|0x0015B5": "「そこ、動かないでよ！」", "Battle/Dat/Battle/Message/080.bmd|0x0015DA": "「チャンスが来たわっ！」", "Battle/Dat/Battle/Message/080.bmd|0x0015FF": "「ラトゥーニ達に手出しさせないんだから！」", "Battle/Dat/Battle/Message/080.bmd|0x00163F": "「メリオルエッセ……ショウコが相手よ！」", "Battle/Dat/Battle/Message/080.bmd|0x00167C": "「ゲスト！　地球から出て行きなさいよ！」", "Battle/Dat/Battle/Message/080.bmd|0x0016B9": "「私達の星にちょっかい出さないでよね！」", "Battle/Dat/Battle/Message/080.bmd|0x0016F6": "「ショウコは、/　あなたについていく気なんてないんだから！」", "Battle/Dat/Battle/Message/080.bmd|0x00174F": "「行くわよ、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/080.bmd|0x001780": "「ガイアセイバーズ……/　あなた達の好きにはやらせない！」", "Battle/Dat/Battle/Message/080.bmd|0x0017D6": "「忍者ロボなんかに負けない！」", "Battle/Dat/Battle/Message/080.bmd|0x001804": "「あなた達！　浅草から出て行きなさいよ！」", "Battle/Dat/Battle/Message/080.bmd|0x001844": "「ルイーナの好きにはやらせない！」", "Battle/Dat/Battle/Message/080.bmd|0x001878": "「行くわよ、ルイーナ！」", "Battle/Dat/Battle/Message/080.bmd|0x00189D": "「行くわよ、妖機人！」", "Battle/Dat/Battle/Message/080.bmd|0x0018BF": "「妖怪退治だって、やってみせるもん！」", "Battle/Dat/Battle/Message/080.bmd|0x0018F9": "「これはお返しよっ！」", "Battle/Dat/Battle/Message/080.bmd|0x00191B": "「ショウコを怒らせると、後が怖いんだから！」", "Battle/Dat/Battle/Message/080.bmd|0x00195E": "「まだこれからよっ！」", "Battle/Dat/Battle/Message/080.bmd|0x001980": "「今度はショウコの番よ！」", "Battle/Dat/Battle/Message/080.bmd|0x0019A8": "「諦めないんだから！」", "Battle/Dat/Battle/Message/080.bmd|0x0019CA": "「追いついてみせるっ！」", "Battle/Dat/Battle/Message/080.bmd|0x0019EF": "「お兄ちゃん……エミィ……ごめん！！」", "Battle/Dat/Battle/Message/080.bmd|0x001A29": "「ジ、Ｇサンダーゲートが！！」", "Battle/Dat/Battle/Message/080.bmd|0x001A57": "「きゃああっ！　お兄ちゃん！！」", "Battle/Dat/Battle/Message/080.bmd|0x001A88": "「ま、まだショウコは負けてないわよ！！」", "Battle/Dat/Battle/Message/080.bmd|0x001AC5": "「こんなにダメージを受けるなんて……！！」", "Battle/Dat/Battle/Message/080.bmd|0x001B05": "「ああっ！　つ、墜落する！？」", "Battle/Dat/Battle/Message/080.bmd|0x001B33": "「パニクっちゃダメよ、落ち着かなきゃ！」", "Battle/Dat/Battle/Message/080.bmd|0x001B70": "「んもう！　何すんのよっ！」", "Battle/Dat/Battle/Message/080.bmd|0x001B9B": "「くっ！　ちゃんとやらなきゃ！」", "Battle/Dat/Battle/Message/080.bmd|0x001BCC": "「こんな所でやられるつもりなんて/　ないんだから！」", "Battle/Dat/Battle/Message/080.bmd|0x001C19": "「ううっ、バランスが取れないよ……！」", "Battle/Dat/Battle/Message/080.bmd|0x001C53": "「お兄ちゃんに心配かけるわけには/　いかないのに……！」", "Battle/Dat/Battle/Message/080.bmd|0x001CA6": "「あたたた……当たっちゃった」", "Battle/Dat/Battle/Message/080.bmd|0x001CD4": "「これぐらい、大したことないわよ！」", "Battle/Dat/Battle/Message/080.bmd|0x001D0B": "「うう、読みが外れちゃった……」", "Battle/Dat/Battle/Message/080.bmd|0x001D3C": "「次はちゃんとよけてみせるから！」", "Battle/Dat/Battle/Message/080.bmd|0x001D70": "「Ｇサンダーゲートはまだ大丈夫！」", "Battle/Dat/Battle/Message/080.bmd|0x001DA4": "「当たらないわよ！」", "Battle/Dat/Battle/Message/080.bmd|0x001DC3": "「残念でした～！」", "Battle/Dat/Battle/Message/080.bmd|0x001DDF": "「ちょ、ちょっと危なかったかな？」", "Battle/Dat/Battle/Message/080.bmd|0x001E13": "「メリオルエッセに/　捕まるわけにはいかないもん！」", "Battle/Dat/Battle/Message/080.bmd|0x001E60": "「ガイアセイバーズなんかに！」", "Battle/Dat/Battle/Message/080.bmd|0x001E8E": "「忍者ロボなんかに！」", "Battle/Dat/Battle/Message/080.bmd|0x001EB0": "「ルイーナなんて、振り切ってやるわ！」", "Battle/Dat/Battle/Message/080.bmd|0x001EEA": "「ルイーナにやられるわけにはいかないから！」", "Battle/Dat/Battle/Message/080.bmd|0x001F2D": "「そう簡単につかまるショウコじゃないもん！」", "Battle/Dat/Battle/Message/080.bmd|0x001F70": "「お兄ちゃんを心配させるわけには/　いかないもんね！」", "Battle/Dat/Battle/Message/080.bmd|0x001FC0": "「ショウコを狙ったってダメなんだから！」", "Battle/Dat/Battle/Message/080.bmd|0x001FFD": "「あれ？　もう終わり？」", "Battle/Dat/Battle/Message/080.bmd|0x002022": "「び、びっくりした～」", "Battle/Dat/Battle/Message/080.bmd|0x002044": "「いい加減に地球のことを諦めなさいよ！」", "Battle/Dat/Battle/Message/080.bmd|0x002081": "「強引なお客さんには、お帰りいただきます！」", "Battle/Dat/Battle/Message/080.bmd|0x0020C4": "「夏喃、私はここよ！」", "Battle/Dat/Battle/Message/080.bmd|0x0020E6": "「あなた達、浅草で暴れないでよ！」", "Battle/Dat/Battle/Message/080.bmd|0x00211A": "「ガードは結構固いの！」", "Battle/Dat/Battle/Message/080.bmd|0x00213F": "「効かないもん！」", "Battle/Dat/Battle/Message/080.bmd|0x00215B": "「そう簡単にっ！」", "Battle/Dat/Battle/Message/080.bmd|0x002177": "「………」", "Battle/Dat/Battle/Message/080.bmd|0x002187": "「え！？　攻撃できないの！？」", "Battle/Dat/Battle/Message/080.bmd|0x0021B5": "「そんなぁ……節約してたのに」", "Battle/Dat/Battle/Message/080.bmd|0x0021E3": "「ど、どこへ行ったの！？」", "Battle/Dat/Battle/Message/080.bmd|0x00220B": "「見失っちゃった……！」", "Battle/Dat/Battle/Message/080.bmd|0x002230": "「後はショウコにお任せ！」", "Battle/Dat/Battle/Message/080.bmd|0x002258": "「続けて行きますっ！」", "Battle/Dat/Battle/Message/080.bmd|0x00227A": "「これはおまけよ！」", "Battle/Dat/Battle/Message/080.bmd|0x002299": "「お兄ちゃん、後は任せて！」", "Battle/Dat/Battle/Message/080.bmd|0x0022C4": "「ちょっと！/　まだ終わってないわよ、お兄ちゃん！」", "Battle/Dat/Battle/Message/080.bmd|0x002311": "「ラトゥーニ、手伝うわ！」", "Battle/Dat/Battle/Message/080.bmd|0x002339": "「え！？　アラド、もう行っちゃうの！？」", "Battle/Dat/Battle/Message/080.bmd|0x002376": "「ゼオラ、後はショウコが！」", "Battle/Dat/Battle/Message/080.bmd|0x0023A1": "「ラウルさん、手伝います！」", "Battle/Dat/Battle/Message/080.bmd|0x0023CC": "「イング、後は任せて！」", "Battle/Dat/Battle/Message/080.bmd|0x0023F1": "「ジョッシュさん、援護します！」", "Battle/Dat/Battle/Message/080.bmd|0x002422": "「リムさん、後はショウコが！」", "Battle/Dat/Battle/Message/080.bmd|0x002450": "「トウマさん、手伝います！」", "Battle/Dat/Battle/Message/080.bmd|0x00247B": "「ミオ、後は任せて！」", "Battle/Dat/Battle/Message/080.bmd|0x00249D": "「ミチルさん、ショウコも行くわ！」", "Battle/Dat/Battle/Message/080.bmd|0x0024D1": "「ミチルさん、どこ行くの！？」", "Battle/Dat/Battle/Message/080.bmd|0x0024FF": "「やらせるもんか！」", "Battle/Dat/Battle/Message/080.bmd|0x00251E": "「あたしが盾になります！」", "Battle/Dat/Battle/Message/080.bmd|0x002546": "「間に入ればっ！」", "Battle/Dat/Battle/Message/080.bmd|0x002562": "「お兄ちゃんを守ってみせるっ！」", "Battle/Dat/Battle/Message/080.bmd|0x002593": "「お兄ちゃん、危ないっ！」", "Battle/Dat/Battle/Message/080.bmd|0x0025BB": "「もう！　ホントに世話が焼けるんだから！」", "Battle/Dat/Battle/Message/080.bmd|0x0025FB": "「ラトゥーニ、逃げて！」", "Battle/Dat/Battle/Message/080.bmd|0x002620": "「アラド、何やってるの！」", "Battle/Dat/Battle/Message/080.bmd|0x002648": "「ゼオラ、ここは任せて！」", "Battle/Dat/Battle/Message/080.bmd|0x002670": "「ラウルさんは逃げて下さい！」", "Battle/Dat/Battle/Message/080.bmd|0x00269E": "「イング、逃げて！」", "Battle/Dat/Battle/Message/080.bmd|0x0026BD": "「ジョッシュさん、下がってください！」", "Battle/Dat/Battle/Message/080.bmd|0x0026F7": "「リムさん、後は任せて！」", "Battle/Dat/Battle/Message/080.bmd|0x00271F": "「逃げて、トウマさん！」", "Battle/Dat/Battle/Message/080.bmd|0x002744": "「ミオ、ここはショウコが！」", "Battle/Dat/Battle/Message/080.bmd|0x00276F": "「ミチルさん、無茶だよ！」", "Battle/Dat/Battle/Message/080.bmd|0x002797": "「ミチルさん、やせ我慢しちゃ駄目！」", "Battle/Dat/Battle/Message/080.bmd|0x0027CE": "「どんどん行くわよっ！」", "Battle/Dat/Battle/Message/080.bmd|0x0027F3": "「まだ行ける！」", "Battle/Dat/Battle/Message/080.bmd|0x00280C": "「もう一回！」", "Battle/Dat/Battle/Message/080.bmd|0x002822": "「Ｇミサイル、発射ぁ！」", "Battle/Dat/Battle/Message/080.bmd|0x002847": "「サンダー・スマッシャー！/　撃つんだからっ！」", "Battle/Dat/Battle/Message/080.bmd|0x00288E": "「サンダー！　スマッシャァァァッ！！」", "Battle/Dat/Battle/Message/080.bmd|0x0028C8": "「サンダー・スマッシャー！/　いっけぇぇっ！！」", "Battle/Dat/Battle/Message/080.bmd|0x00290F": "「Ｇサンダーゲート、ＧＯ！！」", "Battle/Dat/Battle/Message/080.bmd|0x00293D": "「逃がさないわよっ！」", "Battle/Dat/Battle/Message/080.bmd|0x00295F": "「これで決めてみせるんだから！」", "Battle/Dat/Battle/Message/080.bmd|0x002990": "「行っけぇ！　Ｇサンダーゲート！！」", "Battle/Dat/Battle/Message/080.bmd|0x0029C7": "「ゲート・ブレイカー！！」", "Battle/Dat/Battle/Message/080.bmd|0x0029EF": "「必殺！　ゲート・ブレイカー！！」", "Battle/Dat/Battle/Message/081.bmd|0x0003A4": "「………」"}