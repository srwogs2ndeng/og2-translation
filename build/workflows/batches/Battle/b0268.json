{"Battle/Dat/Battle/Message/270.bmd|0x001C88": "「お主らが真理に達するのであれば、/　それも善哉」", "Battle/Dat/Battle/Message/270.bmd|0x001CD2": "「ワシに抗うか、ククル。それも善哉」", "Battle/Dat/Battle/Message/270.bmd|0x001D09": "「偽魂が人道を往く……それも善哉」", "Battle/Dat/Battle/Message/270.bmd|0x001D3D": "「偽魂も道を究めれば、真魂となろう」", "Battle/Dat/Battle/Message/270.bmd|0x001D74": "「青龍……我らの下に戻らぬか。それも善哉」", "Battle/Dat/Battle/Message/270.bmd|0x001DB4": "「白虎よ、そこがお主の在所か。それも善哉」", "Battle/Dat/Battle/Message/270.bmd|0x001DF4": "「では、流れのままに」", "Battle/Dat/Battle/Message/270.bmd|0x001E16": "「魚心あれば水心」", "Battle/Dat/Battle/Message/270.bmd|0x001E32": "「こちらから仕掛けるぞ」", "Battle/Dat/Battle/Message/270.bmd|0x001E57": "「返すぞ、武雀王」", "Battle/Dat/Battle/Message/270.bmd|0x001E73": "「返すぞ、武王機」", "Battle/Dat/Battle/Message/270.bmd|0x001E8F": "「ふむ、ここが潮時じゃの」", "Battle/Dat/Battle/Message/270.bmd|0x001EB7": "「フワッハッハッハ！　善き哉、善き哉！」", "Battle/Dat/Battle/Message/270.bmd|0x001EF4": "「フワッハッハ！　やりおるわい！」", "Battle/Dat/Battle/Message/270.bmd|0x001F28": "「ほほう、これはこれは！」", "Battle/Dat/Battle/Message/270.bmd|0x001F50": "「人の身でここまでやるとはの！」", "Battle/Dat/Battle/Message/270.bmd|0x001F81": "「フハハハ！　まさになすがままじゃのう！」", "Battle/Dat/Battle/Message/270.bmd|0x001FC1": "「これは刮眼せねばならんのう」", "Battle/Dat/Battle/Message/270.bmd|0x001FEF": "「おおっ、これはぬかったのう」", "Battle/Dat/Battle/Message/270.bmd|0x00201D": "「この泰北、油断したわい」", "Battle/Dat/Battle/Message/270.bmd|0x002045": "「玄武の守りを崩すとは……善哉、善哉」", "Battle/Dat/Battle/Message/270.bmd|0x00207F": "「ふむう……/　夏喃が目を付けただけのことはあるわ」", "Battle/Dat/Battle/Message/270.bmd|0x0020CC": "「白虎の操者よ、よい気迫じゃ」", "Battle/Dat/Battle/Message/270.bmd|0x0020FA": "「ふむう、よい念を持っておる」", "Battle/Dat/Battle/Message/270.bmd|0x002128": "「その力、人のために使うか。それも善哉」", "Battle/Dat/Battle/Message/270.bmd|0x002165": "「ほほう、玄武を超えるか、青龍よ！」", "Battle/Dat/Battle/Message/270.bmd|0x00219C": "「うむ！　四神の力、しかと見た！」", "Battle/Dat/Battle/Message/270.bmd|0x0021D0": "「ほほう、多少は揺らいだのう」", "Battle/Dat/Battle/Message/270.bmd|0x0021FE": "「うむ、いい気迫じゃ」", "Battle/Dat/Battle/Message/270.bmd|0x002220": "「ふむ、興が湧いてきたわい」", "Battle/Dat/Battle/Message/270.bmd|0x00224B": "「お主の気と力、確かに受け止めた」", "Battle/Dat/Battle/Message/270.bmd|0x00227F": "「事に従うも肝要じゃ」", "Battle/Dat/Battle/Message/270.bmd|0x0022A1": "「お主の血汗もやがては甘露となろうぞ」", "Battle/Dat/Battle/Message/270.bmd|0x0022DB": "「これもまた、道を究めるための術なり」", "Battle/Dat/Battle/Message/270.bmd|0x002315": "「ふむう……今しばらく様子を見るべきかのう」", "Battle/Dat/Battle/Message/270.bmd|0x002358": "「それで良い、良いぞ、青龍の操者よ」", "Battle/Dat/Battle/Message/270.bmd|0x00238F": "「白虎の操者よ、精進せい」", "Battle/Dat/Battle/Message/270.bmd|0x0023B7": "「ふむ……/　尸解すれば、天仙にまで至るかも知れんのう」", "Battle/Dat/Battle/Message/270.bmd|0x00240A": "「あくまで人として力を使うか。それも善哉」", "Battle/Dat/Battle/Message/270.bmd|0x00244A": "「古の戦再び、じゃのう」", "Battle/Dat/Battle/Message/270.bmd|0x00246F": "「これも四神の宿命よのう」", "Battle/Dat/Battle/Message/270.bmd|0x002497": "「ふむ……存外、非力じゃのう」", "Battle/Dat/Battle/Message/270.bmd|0x0024C5": "「もそっと気迫を込めい」", "Battle/Dat/Battle/Message/270.bmd|0x0024EA": "「ふむ、何か当たったかのう」", "Battle/Dat/Battle/Message/270.bmd|0x002515": "「ワシを倒す気か。それも善哉」", "Battle/Dat/Battle/Message/270.bmd|0x002543": "「持てる力を存分に引き出すのじゃ」", "Battle/Dat/Battle/Message/270.bmd|0x002577": "「玄武の甲羅を砕くには、力が足りぬわ」", "Battle/Dat/Battle/Message/270.bmd|0x0025B1": "「当てただけではのう」", "Battle/Dat/Battle/Message/270.bmd|0x0025D3": "「精進が足らぬのう」", "Battle/Dat/Battle/Message/270.bmd|0x0025F2": "「青龍の操者よ、遠慮は要らぬ」", "Battle/Dat/Battle/Message/270.bmd|0x002620": "「これも修行じゃ、白虎の操者よ」", "Battle/Dat/Battle/Message/270.bmd|0x002651": "「仙道に従うも良し、従わぬも良し」", "Battle/Dat/Battle/Message/270.bmd|0x002685": "「己が力と思念を、もそっと練るがよい」", "Battle/Dat/Battle/Message/270.bmd|0x0026BF": "「我が下に還るも良し、還らぬも良し」", "Battle/Dat/Battle/Message/270.bmd|0x0026F6": "「四神の力は、そのようなものではあるまいて」", "Battle/Dat/Battle/Message/270.bmd|0x002739": "「当たらぬな」", "Battle/Dat/Battle/Message/270.bmd|0x00274F": "「フワッハッハッハッハッハ！」", "Battle/Dat/Battle/Message/270.bmd|0x00277D": "「遠慮は要らぬぞ」", "Battle/Dat/Battle/Message/270.bmd|0x002799": "「精進が足りぬな」", "Battle/Dat/Battle/Message/270.bmd|0x0027B5": "「効かぬな」", "Battle/Dat/Battle/Message/270.bmd|0x0027C8": "「玄武の守りは固くてのう」", "Battle/Dat/Battle/Message/270.bmd|0x0027F0": "「神獣の盾じゃ」", "Battle/Dat/Battle/Message/270.bmd|0x002809": "「徒労に終わったのう」", "Battle/Dat/Battle/Message/270.bmd|0x00282B": "「それで神獣盾は破れぬ」", "Battle/Dat/Battle/Message/270.bmd|0x002850": "「惜しいのう」", "Battle/Dat/Battle/Message/270.bmd|0x002866": "「………」", "Battle/Dat/Battle/Message/270.bmd|0x002876": "「これは仕方ないのう、フワッハッハッハ！」", "Battle/Dat/Battle/Message/270.bmd|0x0028B6": "「亀だけに手も足も出ぬわ、フワッハッハ！」", "Battle/Dat/Battle/Message/270.bmd|0x0028F6": "「なすがまま……それも善哉」", "Battle/Dat/Battle/Message/270.bmd|0x002921": "「ほほう、してやられたわ」", "Battle/Dat/Battle/Message/270.bmd|0x002949": "「加勢するぞ」", "Battle/Dat/Battle/Message/270.bmd|0x00295F": "「一働きするかの」", "Battle/Dat/Battle/Message/270.bmd|0x00297B": "「光龍、手を貸そう」", "Battle/Dat/Battle/Message/270.bmd|0x00299A": "「夏喃、後は任せい」", "Battle/Dat/Battle/Message/270.bmd|0x0029B9": "「役目を果たさねばのう」", "Battle/Dat/Battle/Message/270.bmd|0x0029DE": "「ここはワシに任せい」", "Battle/Dat/Battle/Message/270.bmd|0x002A00": "「ワシが受け止めてやるわ」", "Battle/Dat/Battle/Message/270.bmd|0x002A28": "「光龍、後は任せい」", "Battle/Dat/Battle/Message/270.bmd|0x002A47": "「夏喃、何をしておる」", "Battle/Dat/Battle/Message/270.bmd|0x002A69": "「これも役目でのう」", "Battle/Dat/Battle/Message/270.bmd|0x002A88": "「ふむ、まだ行けるか」", "Battle/Dat/Battle/Message/270.bmd|0x002AAA": "「逃げぬのか。それも善哉」", "Battle/Dat/Battle/Message/270.bmd|0x002AD2": "「玄甲彈！」", "Battle/Dat/Battle/Message/270.bmd|0x002AE5": "「行けい、玄甲彈！」", "Battle/Dat/Battle/Message/270.bmd|0x002B04": "「放て、武王機！」", "Battle/Dat/Battle/Message/270.bmd|0x002B20": "「黒蛇光！」", "Battle/Dat/Battle/Message/270.bmd|0x002B33": "「黒蛇よ、破光を放て！」", "Battle/Dat/Battle/Message/270.bmd|0x002B58": "「受けるがよいぞ！」", "Battle/Dat/Battle/Message/270.bmd|0x002B77": "「武王火槍！」", "Battle/Dat/Battle/Message/270.bmd|0x002B8D": "「放て、武雀王！」", "Battle/Dat/Battle/Message/270.bmd|0x002BA9": "「北宮玄武、天門忽開！」", "Battle/Dat/Battle/Message/270.bmd|0x002BCE": "「黒蛇臼砲！！」", "Battle/Dat/Battle/Message/270.bmd|0x002BE7": "「玄天大聖、後玄武避万鬼」", "Battle/Dat/Battle/Message/270.bmd|0x002C0F": "「紛維衝天！」", "Battle/Dat/Battle/Message/270.bmd|0x002C25": "「上元天都東北方振動！」", "Battle/Dat/Battle/Message/270.bmd|0x002C4A": "「天門忽開！」", "Battle/Dat/Battle/Message/270.bmd|0x002C60": "「玄天衝天砲！！」", "Battle/Dat/Battle/Message/271.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/272.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/272.bmd|0x000440": "「！？！？！？」", "Battle/Dat/Battle/Message/272.bmd|0x000459": "「………！！！」", "Battle/Dat/Battle/Message/272.bmd|0x000472": "「………！！」", "Battle/Dat/Battle/Message/272.bmd|0x000488": "「………？」", "Battle/Dat/Battle/Message/273.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/273.bmd|0x000440": "「！？！？！？」", "Battle/Dat/Battle/Message/273.bmd|0x000459": "「………！！！」", "Battle/Dat/Battle/Message/273.bmd|0x000472": "「………！！」", "Battle/Dat/Battle/Message/273.bmd|0x000488": "「………？」", "Battle/Dat/Battle/Message/274.bmd|0x0010BE": "「迂闊な奴め！」", "Battle/Dat/Battle/Message/274.bmd|0x0010D7": "「レンジ内に入ったな……！」", "Battle/Dat/Battle/Message/274.bmd|0x001102": "「容赦はせん！」", "Battle/Dat/Battle/Message/274.bmd|0x00111B": "「獲物が来たか……！」", "Battle/Dat/Battle/Message/274.bmd|0x00113D": "「後手に回るつもりはない！」", "Battle/Dat/Battle/Message/274.bmd|0x001168": "「受けろ！」", "Battle/Dat/Battle/Message/274.bmd|0x00117B": "「そこか！」", "Battle/Dat/Battle/Message/274.bmd|0x00118E": "「遅い！　もらったぞ！」", "Battle/Dat/Battle/Message/274.bmd|0x0011B3": "「消えてもらうぞ！」", "Battle/Dat/Battle/Message/274.bmd|0x0011D2": "「撃破あるのみ！」", "Battle/Dat/Battle/Message/274.bmd|0x0011EE": "「出力、安定しています」", "Battle/Dat/Battle/Message/274.bmd|0x001213": "「了解した。仕掛ける！」"}