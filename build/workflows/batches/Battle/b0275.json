{"Battle/Dat/Battle/Message/286.bmd|0x006DEA": "「こちらベガリオン、続いて仕掛ける」", "Battle/Dat/Battle/Message/286.bmd|0x006E21": "「フォローは私に任せておけ」", "Battle/Dat/Battle/Message/286.bmd|0x006E4C": "「シリーズ７７の連携だな」", "Battle/Dat/Battle/Message/286.bmd|0x006E74": "「カバーする！　後退しろ！」", "Battle/Dat/Battle/Message/286.bmd|0x006E9F": "「下がれ！　ここは私が引き受ける！」", "Battle/Dat/Battle/Message/286.bmd|0x006ED6": "「ちいっ！　世話を焼かせる！」", "Battle/Dat/Battle/Message/286.bmd|0x006F04": "「今回は貸しにしておく……！」", "Battle/Dat/Battle/Message/286.bmd|0x006F32": "「ノロマめ！　ここは下がれ！」", "Battle/Dat/Battle/Message/286.bmd|0x006F60": "「まったく、世話を焼かせる！」", "Battle/Dat/Battle/Message/286.bmd|0x006F8E": "「らしくないぞ、レオナ・ガーシュタイン！」", "Battle/Dat/Battle/Message/286.bmd|0x006FCE": "「どうやら腕が落ちたようだな、レオナ」", "Battle/Dat/Battle/Message/286.bmd|0x007008": "「ベガリオンの装甲なら何とかなる……！」", "Battle/Dat/Battle/Message/286.bmd|0x007045": "「おあつらえむきのポジションだ！」", "Battle/Dat/Battle/Message/286.bmd|0x007079": "「弱いやつほど群れるようだな！」", "Battle/Dat/Battle/Message/286.bmd|0x0070AA": "「ターゲット・マルチ・ロック！/　もらった！！」", "Battle/Dat/Battle/Message/286.bmd|0x0070F1": "「彗星は戻ってくるものだ！」", "Battle/Dat/Battle/Message/286.bmd|0x00711C": "「これが本命だ！　行くぞ！」", "Battle/Dat/Battle/Message/286.bmd|0x007147": "「グラビティ・ガイダンス、スタンバイ！」", "Battle/Dat/Battle/Message/286.bmd|0x007184": "「これだけの高速散弾、かわせまい！」", "Battle/Dat/Battle/Message/286.bmd|0x0071BB": "「プレアディス、ファイヤ！」", "Battle/Dat/Battle/Message/286.bmd|0x0071E6": "「０５、セット……ファイヤ！」", "Battle/Dat/Battle/Message/286.bmd|0x007214": "「ホーミング・セット……ファイヤ！」", "Battle/Dat/Battle/Message/286.bmd|0x00724B": "「高速ミサイルだ、かわせまい！」", "Battle/Dat/Battle/Message/286.bmd|0x00727C": "「ミドルレンジだ！　くらえっ！」", "Battle/Dat/Battle/Message/286.bmd|0x0072AD": "「風穴を空けてやる……」", "Battle/Dat/Battle/Message/286.bmd|0x0072D2": "「Ｇドライバー、シュート！」", "Battle/Dat/Battle/Message/286.bmd|0x0072FD": "「破壊力重視の大口径だ！」", "Battle/Dat/Battle/Message/286.bmd|0x007325": "「その身で受けろ！」", "Battle/Dat/Battle/Message/286.bmd|0x007344": "「破壊力は、その身で知るがいい！」", "Battle/Dat/Battle/Message/286.bmd|0x007378": "「Ｇブレイクドライバー、シュート！」", "Battle/Dat/Battle/Message/286.bmd|0x0073AF": "「セイファート、ファイヤ！」", "Battle/Dat/Battle/Message/286.bmd|0x0073DA": "「０９セット……ファイヤ！」", "Battle/Dat/Battle/Message/286.bmd|0x007405": "「対艦ミサイルだ、当たれば決まる！」", "Battle/Dat/Battle/Message/286.bmd|0x00743C": "「シューートッ！」", "Battle/Dat/Battle/Message/286.bmd|0x007458": "「ターゲット・インサイト！」", "Battle/Dat/Battle/Message/286.bmd|0x007483": "「センター・ロック！　逃がさん！」", "Battle/Dat/Battle/Message/286.bmd|0x0074B7": "「撃ち抜く！」", "Battle/Dat/Battle/Message/286.bmd|0x0074CD": "「この一撃で決める！」", "Battle/Dat/Battle/Message/286.bmd|0x0074EF": "「格闘戦か……！　面白い！！」", "Battle/Dat/Battle/Message/286.bmd|0x00751D": "「遅い！　ソニック・ブーストキック！！」", "Battle/Dat/Battle/Message/286.bmd|0x00755A": "「私の足元にひれ伏すがいい！」", "Battle/Dat/Battle/Message/286.bmd|0x007588": "「マッハを超える蹴りを食らえ！！」", "Battle/Dat/Battle/Message/286.bmd|0x0075BC": "「フル・ブースト・ドライブ！」", "Battle/Dat/Battle/Message/286.bmd|0x0075EA": "「ソニック・アクセラレーション、/　スタンバイ！」", "Battle/Dat/Battle/Message/286.bmd|0x007634": "「ソニック・アクセラレーション！/　決める！！」", "Battle/Dat/Battle/Message/286.bmd|0x00767B": "「マックススピードだ！　かわせまい！！」", "Battle/Dat/Battle/Message/286.bmd|0x0076B8": "「ええーいっ！！」", "Battle/Dat/Battle/Message/286.bmd|0x0076D4": "「まとめて相手をしてやる！」", "Battle/Dat/Battle/Message/286.bmd|0x0076FF": "「ターゲット・ロック！　もらったぞ！」", "Battle/Dat/Battle/Message/286.bmd|0x007739": "「距離があるか！　だが……！」", "Battle/Dat/Battle/Message/286.bmd|0x007767": "「オンリー・ワン・フィニッシュ！」", "Battle/Dat/Battle/Message/286.bmd|0x00779B": "「趣味ではないが、威力は保証付きだ！」", "Battle/Dat/Battle/Message/286.bmd|0x0077D5": "「この一撃、受けてみるがいい！」", "Battle/Dat/Battle/Message/286.bmd|0x007806": "「終わりだ！」", "Battle/Dat/Battle/Message/286.bmd|0x00781C": "「ジャケット・アーマー、パージ！」", "Battle/Dat/Battle/Message/286.bmd|0x007850": "「ふん……これなら充分な速度だ！」", "Battle/Dat/Battle/Message/286.bmd|0x007884": "「こいつの真骨頂、見せてやろう！」", "Battle/Dat/Battle/Message/286.bmd|0x0078B8": "「そろそろとどめだ！」", "Battle/Dat/Battle/Message/286.bmd|0x0078DA": "「モズの一刺し、その身で味わうがいい！」", "Battle/Dat/Battle/Message/286.bmd|0x007917": "「ファイヤ・ロック・オープン！/　連続射撃だ！」", "Battle/Dat/Battle/Message/286.bmd|0x00795E": "「かわせるものならかわしてみろ！！」", "Battle/Dat/Battle/Message/286.bmd|0x007995": "「火器管制モード！　フル・アクション！」", "Battle/Dat/Battle/Message/286.bmd|0x0079D2": "「どこへ逃げようと追い詰める！！」", "Battle/Dat/Battle/Message/286.bmd|0x007A06": "「このパワー……悪くない……！」", "Battle/Dat/Battle/Message/286.bmd|0x007A37": "「消えろ！　ジガンテ・ウンギア！」", "Battle/Dat/Battle/Message/286.bmd|0x007A6B": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/286.bmd|0x007A90": "「いけ！　ソードブレイカー！！」", "Battle/Dat/Battle/Message/286.bmd|0x007AC1": "「食らうがいい！　シシオウブレード！！」", "Battle/Dat/Battle/Message/286.bmd|0x007AFE": "「いい加速性能だ！」", "Battle/Dat/Battle/Message/286.bmd|0x007B1D": "「リボルビング・バンカー！！」", "Battle/Dat/Battle/Message/286.bmd|0x007B4B": "「全弾、撃ち込む！」", "Battle/Dat/Battle/Message/286.bmd|0x007B6A": "「ブーストッ！」", "Battle/Dat/Battle/Message/286.bmd|0x007B83": "「そこだ！　クレイモア！」", "Battle/Dat/Battle/Message/286.bmd|0x007BAB": "「はあっ！」", "Battle/Dat/Battle/Message/286.bmd|0x007BBE": "「まだまだ！！」", "Battle/Dat/Battle/Message/286.bmd|0x007BD7": "「とどめのリボルビング・バンカーだ！！」", "Battle/Dat/Battle/Message/286.bmd|0x007C14": "「クロス・レンジに飛び込む！」", "Battle/Dat/Battle/Message/286.bmd|0x007C42": "「トンファー、セット！」", "Battle/Dat/Battle/Message/286.bmd|0x007C67": "「この連打をかわせるか！」", "Battle/Dat/Battle/Message/286.bmd|0x007C8F": "「ブレード・サイ、アクティブ！」", "Battle/Dat/Battle/Message/286.bmd|0x007CC0": "「レディ！」", "Battle/Dat/Battle/Message/286.bmd|0x007CD3": "「ゴーッ！！」", "Battle/Dat/Battle/Message/286.bmd|0x007CE9": "「勝利への道は見えた！」", "Battle/Dat/Battle/Message/286.bmd|0x007D0E": "「はああああっ！！」", "Battle/Dat/Battle/Message/286.bmd|0x007D2D": "「見ろ、ラプターのスピードを！」", "Battle/Dat/Battle/Message/286.bmd|0x007D5E": "「遅いぞ！」", "Battle/Dat/Battle/Message/286.bmd|0x007D71": "「フル・シュートッ！！」", "Battle/Dat/Battle/Message/286.bmd|0x007D96": "「プラズマ・ステーク、セット！」", "Battle/Dat/Battle/Message/286.bmd|0x007DC7": "「ジェット・マグナム！！」", "Battle/Dat/Battle/Message/286.bmd|0x007DEF": "「逃がすものかっ！」", "Battle/Dat/Battle/Message/286.bmd|0x007E0E": "「ロングレンジ・モード！」", "Battle/Dat/Battle/Message/286.bmd|0x007E36": "「ファイヤッ！！」", "Battle/Dat/Battle/Message/286.bmd|0x007E52": "「抵抗しても無駄だ！」", "Battle/Dat/Battle/Message/286.bmd|0x007E74": "「せえいっ！！」", "Battle/Dat/Battle/Message/286.bmd|0x007E8D": "「メガ・ブラスターキャノン！！」", "Battle/Dat/Battle/Message/286.bmd|0x007EBE": "「必殺のコンビネーションだ！」", "Battle/Dat/Battle/Message/286.bmd|0x007EEC": "「この連打、かわせまい！」", "Battle/Dat/Battle/Message/286.bmd|0x007F14": "「まだまだ！」", "Battle/Dat/Battle/Message/286.bmd|0x007F2A": "「フィニッシュブローだ！」", "Battle/Dat/Battle/Message/286.bmd|0x007F52": "「ジェット・ファントム！！」", "Battle/Dat/Battle/Message/286.bmd|0x007F7D": "「受けろ、ダーク・ロック！」", "Battle/Dat/Battle/Message/286.bmd|0x007FA8": "「続いていくぞ！」", "Battle/Dat/Battle/Message/286.bmd|0x007FC4": "「ハイパー・ブーストナックル、セット！」", "Battle/Dat/Battle/Message/286.bmd|0x008001": "「そこだっ！！」", "Battle/Dat/Battle/Message/286.bmd|0x00801A": "「照準セット！　エネルギー集束！」", "Battle/Dat/Battle/Message/286.bmd|0x00804E": "「アルティメット・ビーム！！」", "Battle/Dat/Battle/Message/286.bmd|0x00807C": "「グルンガスト、その力を見せろ！」", "Battle/Dat/Battle/Message/286.bmd|0x0080B0": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/286.bmd|0x0080CB": "「暗剣殺！！」", "Battle/Dat/Battle/Message/286.bmd|0x0080E1": "「たああああああっ！！」", "Battle/Dat/Battle/Message/286.bmd|0x008106": "「フィニッシュ……！」", "Battle/Dat/Battle/Message/286.bmd|0x008128": "「彗星が凶星を導く……！」", "Battle/Dat/Battle/Message/286.bmd|0x008150": "「五！」", "Battle/Dat/Battle/Message/286.bmd|0x00815D": "「黄！」", "Battle/Dat/Battle/Message/286.bmd|0x00816A": "「殺っ！！」", "Battle/Dat/Battle/Message/286.bmd|0x00817D": "「はあああーーっ！！」", "Battle/Dat/Battle/Message/286.bmd|0x00819F": "「終わりだ……！」", "Battle/Dat/Battle/Message/286.bmd|0x0081BB": "「私の趣味に合う戦法だ！」", "Battle/Dat/Battle/Message/286.bmd|0x0081E3": "「スパイラル・ブレイカー！」", "Battle/Dat/Battle/Message/286.bmd|0x00820E": "「くらうがいい！」"}