{"Battle/Dat/Battle/Message/153.bmd|0x0094EB": "「くそっ、どこから攻撃して来た！？」", "Battle/Dat/Battle/Message/153.bmd|0x009522": "「チッ、奴はどこにいる！？」", "Battle/Dat/Battle/Message/153.bmd|0x00954D": "「ええい、これでは狙い撃ちされる！」", "Battle/Dat/Battle/Message/153.bmd|0x009584": "「死角に入られたか！」", "Battle/Dat/Battle/Message/153.bmd|0x0095A6": "「続けて行く！」", "Battle/Dat/Battle/Message/153.bmd|0x0095BF": "「まだ俺がいる！」", "Battle/Dat/Battle/Message/153.bmd|0x0095DB": "「逃げ損なったか！」", "Battle/Dat/Battle/Message/153.bmd|0x0095FA": "「まだ終わりじゃない！」", "Battle/Dat/Battle/Message/153.bmd|0x00961F": "「ねじ込んでやる！」", "Battle/Dat/Battle/Message/153.bmd|0x00963E": "「よし、援護を！」", "Battle/Dat/Battle/Message/153.bmd|0x00965A": "「やらせるものか！」", "Battle/Dat/Battle/Message/153.bmd|0x009679": "「受け止めてみせる！」", "Battle/Dat/Battle/Message/153.bmd|0x00969B": "「やらせん！」", "Battle/Dat/Battle/Message/153.bmd|0x0096B1": "「お前の相手は俺だ！」", "Battle/Dat/Battle/Message/153.bmd|0x0096D3": "「割り込む！」", "Battle/Dat/Battle/Message/153.bmd|0x0096E9": "「俺が盾になれば！」", "Battle/Dat/Battle/Message/153.bmd|0x009708": "「こちらで受け止めれば！」", "Battle/Dat/Battle/Message/153.bmd|0x009730": "「運が悪かったな！」", "Battle/Dat/Battle/Message/153.bmd|0x00974F": "「こういう展開もある！」", "Battle/Dat/Battle/Message/153.bmd|0x009774": "「ふん、油断したな！」", "Battle/Dat/Battle/Message/153.bmd|0x009796": "「いい流れだ！　行ける！」", "Battle/Dat/Battle/Message/153.bmd|0x0097BE": "「当たれよ！」", "Battle/Dat/Battle/Message/153.bmd|0x0097D4": "「こいつをくらえ！」", "Battle/Dat/Battle/Message/153.bmd|0x0097F3": "「もらったぞ！」", "Battle/Dat/Battle/Message/153.bmd|0x00980C": "「おりゃあ！」", "Battle/Dat/Battle/Message/153.bmd|0x009822": "「でえいっ！」", "Battle/Dat/Battle/Message/153.bmd|0x009838": "「これなら！」", "Battle/Dat/Battle/Message/153.bmd|0x00984E": "「この距離なら！」", "Battle/Dat/Battle/Message/153.bmd|0x00986A": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/153.bmd|0x00988F": "「落ちろぉっ！！」", "Battle/Dat/Battle/Message/153.bmd|0x0098AB": "「捉えたぞ！」", "Battle/Dat/Battle/Message/153.bmd|0x0098C1": "「照準ＯＫ！」", "Battle/Dat/Battle/Message/153.bmd|0x0098D7": "「行けぇっ！！」", "Battle/Dat/Battle/Message/153.bmd|0x0098F0": "「ターゲット・インサイト！」", "Battle/Dat/Battle/Message/153.bmd|0x00991B": "「ロックオン！」", "Battle/Dat/Battle/Message/153.bmd|0x009934": "「沈めっ！！」", "Battle/Dat/Battle/Message/153.bmd|0x00994A": "「くらえ！」", "Battle/Dat/Battle/Message/153.bmd|0x00995D": "「受けてみろ！」", "Battle/Dat/Battle/Message/153.bmd|0x009976": "「この距離ならば！」", "Battle/Dat/Battle/Message/153.bmd|0x009995": "「この間合いなら！」", "Battle/Dat/Battle/Message/153.bmd|0x0099B4": "「そこだ！」", "Battle/Dat/Battle/Message/153.bmd|0x0099C7": "「当たれ！」", "Battle/Dat/Battle/Message/153.bmd|0x0099DA": "「受けろ！」", "Battle/Dat/Battle/Message/153.bmd|0x0099ED": "「直撃させる！」", "Battle/Dat/Battle/Message/153.bmd|0x009A06": "「もらった！」", "Battle/Dat/Battle/Message/153.bmd|0x009A1C": "「叩き落とす！」", "Battle/Dat/Battle/Message/153.bmd|0x009A35": "「叩き落としてやる！」", "Battle/Dat/Battle/Message/153.bmd|0x009A57": "「キャスク・ミサイル！」", "Battle/Dat/Battle/Message/153.bmd|0x009A7C": "「キャスク・ミサイル、発射！」", "Battle/Dat/Battle/Message/153.bmd|0x009AAA": "「キャスク・ミサイルで！」", "Battle/Dat/Battle/Message/153.bmd|0x009AD2": "「くらえっ！！」", "Battle/Dat/Battle/Message/153.bmd|0x009AEB": "「避けられると思うな！」", "Battle/Dat/Battle/Message/153.bmd|0x009B10": "「コンテナ、セット！　行けっ！！」", "Battle/Dat/Battle/Message/153.bmd|0x009B44": "「こいつからは逃げられん！」", "Battle/Dat/Battle/Message/153.bmd|0x009B6F": "「新型リオンの力を！」", "Battle/Dat/Battle/Message/153.bmd|0x009B91": "「見せてやる！」", "Battle/Dat/Battle/Message/153.bmd|0x009BAA": "「このミサイルは一味違うぞ！」", "Battle/Dat/Battle/Message/153.bmd|0x009BD8": "「行けぇぇっ！！」", "Battle/Dat/Battle/Message/153.bmd|0x009BF4": "「高速で追い詰める！」", "Battle/Dat/Battle/Message/153.bmd|0x009C16": "「ハッチ開放！」", "Battle/Dat/Battle/Message/153.bmd|0x009C2F": "「ＭＴＤ誘導弾、発射！」", "Battle/Dat/Battle/Message/153.bmd|0x009C54": "「このサイリオンで翻弄してやる！」", "Battle/Dat/Battle/Message/153.bmd|0x009C88": "「テスラ・ドライブのミサイルだ！」", "Battle/Dat/Battle/Message/153.bmd|0x009CBC": "「かわすことなど出来ん！！」", "Battle/Dat/Battle/Message/153.bmd|0x009CE7": "「サイリオンからは逃げられんぞ！」", "Battle/Dat/Battle/Message/153.bmd|0x009D1B": "「このミサイルは特別製だ！」", "Battle/Dat/Battle/Message/153.bmd|0x009D46": "「ＭＴＤ誘導弾！　行けぇぇっ！！」", "Battle/Dat/Battle/Message/153.bmd|0x009D7A": "「サイリオンの真価を見せてやる！」", "Battle/Dat/Battle/Message/153.bmd|0x009DAE": "「ＴＤＡノーズ、セット！」", "Battle/Dat/Battle/Message/153.bmd|0x009DD6": "「行くぞ！　ブースト！！」", "Battle/Dat/Battle/Message/153.bmd|0x009DFE": "「ブレイク・フィールド！」", "Battle/Dat/Battle/Message/153.bmd|0x009E26": "「砕け散れぇぇぇっ！！」", "Battle/Dat/Battle/Message/153.bmd|0x009E4B": "「シーケンスＳＳＢ！」", "Battle/Dat/Battle/Message/153.bmd|0x009E6D": "「ロック・オン！」", "Battle/Dat/Battle/Message/153.bmd|0x009E89": "「見切ることなど出来んぞ！」", "Battle/Dat/Battle/Message/153.bmd|0x009EB4": "「フィールド展開！」", "Battle/Dat/Battle/Message/153.bmd|0x009ED3": "「スーパー・ソニック・ブレイカー！！」", "Battle/Dat/Battle/Message/153.bmd|0x009F0D": "「キャニスからは逃げられん！」", "Battle/Dat/Battle/Message/153.bmd|0x009F3B": "「ダブル・ガナリー、Ｗモード！」", "Battle/Dat/Battle/Message/153.bmd|0x009F6C": "「追い詰めてやる！」", "Battle/Dat/Battle/Message/153.bmd|0x009F8B": "「Ｗモード、ファイア！！」", "Battle/Dat/Battle/Message/153.bmd|0x009FB3": "「飛べ、キャニス！」", "Battle/Dat/Battle/Message/153.bmd|0x009FD2": "「ダブル・ガナリー！　くらえ！」", "Battle/Dat/Battle/Message/154.bmd|0x0063D0": "「我らこそが外敵を討ち、/　地球を護る剣なのだ！」", "Battle/Dat/Battle/Message/154.bmd|0x00641A": "「地球圏の未来は、我らが切り開く！」", "Battle/Dat/Battle/Message/154.bmd|0x006451": "「前大戦のエースと言えど！」", "Battle/Dat/Battle/Message/154.bmd|0x00647C": "「叛乱分子を排除する！」", "Battle/Dat/Battle/Message/154.bmd|0x0064A1": "「鋼龍戦隊！　お前達の役目は終わった！」", "Battle/Dat/Battle/Message/154.bmd|0x0064DE": "「鋼龍戦隊、貴様らが犯した罪は重い！」", "Battle/Dat/Battle/Message/154.bmd|0x006518": "「鋼龍戦隊など、もはや無用の長物だ！」", "Battle/Dat/Battle/Message/154.bmd|0x006552": "「鋼龍戦隊、貴様らはここで終わりだ！」", "Battle/Dat/Battle/Message/154.bmd|0x00658C": "「我らこそが地球の守護者だ！」", "Battle/Dat/Battle/Message/154.bmd|0x0065BA": "「ガイアセイバーズの名の下に、/　お前達を討つ！」", "Battle/Dat/Battle/Message/154.bmd|0x006604": "「裏切り者は死ね！」", "Battle/Dat/Battle/Message/154.bmd|0x006623": "「離反者を始末する！」", "Battle/Dat/Battle/Message/154.bmd|0x006645": "「ゲストの好きにはやらせん！」", "Battle/Dat/Battle/Message/154.bmd|0x006673": "「ゲスト機を撃破する！」", "Battle/Dat/Battle/Message/154.bmd|0x006698": "「ルイーナめ、我らが相手だ！」", "Battle/Dat/Battle/Message/154.bmd|0x0066C6": "「我らはお前達など恐れはしない！」", "Battle/Dat/Battle/Message/154.bmd|0x0066FA": "「母艦を沈めれば、奴らは終わりだ！」", "Battle/Dat/Battle/Message/154.bmd|0x006731": "「鋼龍戦隊の要はあの艦だ！　沈める！」", "Battle/Dat/Battle/Message/154.bmd|0x00676B": "「スペースノア級と言えども！」", "Battle/Dat/Battle/Message/154.bmd|0x006799": "「反逆者の艦に容赦はせんぞ！」", "Battle/Dat/Battle/Message/154.bmd|0x0067C7": "「合体する前に落とす！」", "Battle/Dat/Battle/Message/154.bmd|0x0067EC": "「１機落とせば、合体できまい！」", "Battle/Dat/Battle/Message/154.bmd|0x00681D": "「ＳＲＸ計画の試作機など！」", "Battle/Dat/Battle/Message/154.bmd|0x006848": "「エンジンに/　直撃させるわけにはいかんが……！」", "Battle/Dat/Battle/Message/154.bmd|0x006892": "「長射程とは言え、穴はあるはずだ！」", "Battle/Dat/Battle/Message/154.bmd|0x0068C9": "「奴の射程にも隙はある！」", "Battle/Dat/Battle/Message/154.bmd|0x0068F1": "「撃たれる前に撃つ！」", "Battle/Dat/Battle/Message/154.bmd|0x006913": "「アルトアイゼンを落とせば、手柄になる！」", "Battle/Dat/Battle/Message/154.bmd|0x006953": "「杭打ち機などにやられるか！」", "Battle/Dat/Battle/Message/154.bmd|0x006981": "「奴のレンジ外から攻撃すれば！」", "Battle/Dat/Battle/Message/154.bmd|0x0069B2": "「ＡＴＸ計画の試作機など！」", "Battle/Dat/Battle/Message/154.bmd|0x0069DD": "「アルトアイゼンもどきめ！」", "Battle/Dat/Battle/Message/154.bmd|0x006A08": "「欠陥機に何が出来る！」", "Battle/Dat/Battle/Message/154.bmd|0x006A2D": "「寄せ集めの機体など！」", "Battle/Dat/Battle/Message/154.bmd|0x006A52": "「無様な姿をさらしおって！」", "Battle/Dat/Battle/Message/154.bmd|0x006A7D": "「見るに忍びん姿だ……完全に破壊してやる！」", "Battle/Dat/Battle/Message/154.bmd|0x006AC0": "「アインストの成れの果てめ！」"}