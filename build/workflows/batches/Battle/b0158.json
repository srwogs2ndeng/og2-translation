{"Battle/Dat/Battle/Message/078.bmd|0x007604": "「やるじゃねえか……！　だがな！！」", "Battle/Dat/Battle/Message/078.bmd|0x00763B": "「くそっ、しくじった！」", "Battle/Dat/Battle/Message/078.bmd|0x007660": "「反省点を次に生かすんだ、コウタ」", "Battle/Dat/Battle/Message/078.bmd|0x007694": "「やりやがったな、あんちきしょう！！」", "Battle/Dat/Battle/Message/078.bmd|0x0076CE": "「落ち着け、コウタ。/　冷静に状況を判断するんだ」", "Battle/Dat/Battle/Message/078.bmd|0x007718": "「コウタ、大丈夫か？」", "Battle/Dat/Battle/Message/078.bmd|0x00773A": "「こんなの、/　爺ちゃんの鉄拳に比べたら何でもねえ！」", "Battle/Dat/Battle/Message/078.bmd|0x00778A": "「結構頑丈じゃねえか、こいつ」", "Battle/Dat/Battle/Message/078.bmd|0x0077B8": "「ああ……キサブローのおかげだ」", "Battle/Dat/Battle/Message/078.bmd|0x0077E9": "「いてて……/　これじゃ爺ちゃんにどやされちまうぜ」", "Battle/Dat/Battle/Message/078.bmd|0x007836": "「……いつものことだ」", "Battle/Dat/Battle/Message/078.bmd|0x007858": "「ああっ、コンパチカイザーが！」", "Battle/Dat/Battle/Message/078.bmd|0x007889": "「こんな所でやられてたまるか！」", "Battle/Dat/Battle/Message/078.bmd|0x0078BA": "「ファイトだよ、お兄ちゃん！！」", "Battle/Dat/Battle/Message/078.bmd|0x0078EB": "「ああ！　見てろよ、ショウコ！」", "Battle/Dat/Battle/Message/078.bmd|0x00791C": "「くっ、当たっちまうとはな！」", "Battle/Dat/Battle/Message/078.bmd|0x00794A": "「こんなもん、傷の内に入るかよ！」", "Battle/Dat/Battle/Message/078.bmd|0x00797E": "「この程度でひるんでたまるか！」", "Battle/Dat/Battle/Message/078.bmd|0x0079AF": "「アーマーに傷がついた程度だ！　いけるぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x0079F2": "「何だ、大したことねえな」", "Battle/Dat/Battle/Message/078.bmd|0x007A1A": "「くっ！　微妙な所に当ててきやがって！」", "Battle/Dat/Battle/Message/078.bmd|0x007A57": "「お前の動きも微妙だったぞ」", "Battle/Dat/Battle/Message/078.bmd|0x007A82": "「ひるむな、コウタ」", "Battle/Dat/Battle/Message/078.bmd|0x007AA1": "「ああ、こんなもん屁でもねえぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x007AD5": "「チッ！　ちゃんと動け、コンパチカイザー！」", "Battle/Dat/Battle/Message/078.bmd|0x007B18": "「いや……今のはお前の操縦ミスだ」", "Battle/Dat/Battle/Message/078.bmd|0x007B4C": "「この程度……カイザーなら大丈夫だ」", "Battle/Dat/Battle/Message/078.bmd|0x007B83": "「ああ、爺ちゃんにも感謝しとくぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x007BBA": "「……後でキサブローが文句を言うだろうな」", "Battle/Dat/Battle/Message/078.bmd|0x007BFA": "「ああ……あんたとセットでな」", "Battle/Dat/Battle/Message/078.bmd|0x007C28": "「お兄ちゃん、大丈夫！？」", "Battle/Dat/Battle/Message/078.bmd|0x007C50": "「お前こそ怪我はないか！？」", "Battle/Dat/Battle/Message/078.bmd|0x007C7B": "「うん、ショウコは平気よ」", "Battle/Dat/Battle/Message/078.bmd|0x007CA3": "「くっ！　やられた！」", "Battle/Dat/Battle/Message/078.bmd|0x007CC5": "「頑張って、お兄ちゃん！」", "Battle/Dat/Battle/Message/078.bmd|0x007CED": "「エグレッタめ、やるじゃねえか！」", "Battle/Dat/Battle/Message/078.bmd|0x007D21": "「浅いんだよ、ドゥバン！」", "Battle/Dat/Battle/Message/078.bmd|0x007D49": "「チョンマゲ野郎め、冗談は顔だけにしろ！」", "Battle/Dat/Battle/Message/078.bmd|0x007D89": "「効いてねえぜ、メッセ野郎！」", "Battle/Dat/Battle/Message/078.bmd|0x007DB7": "「何の真似だ、眉毛侍！」", "Battle/Dat/Battle/Message/078.bmd|0x007DDC": "「てめえの炎で/　俺を燃やし尽くすことは出来ねえ！」", "Battle/Dat/Battle/Message/078.bmd|0x007E29": "「それで終わりか、ロフ！」", "Battle/Dat/Battle/Message/078.bmd|0x007E51": "「あの野郎、マジでイライラするぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x007E88": "「効いてねえぜ、セティ！」", "Battle/Dat/Battle/Message/078.bmd|0x007EB0": "「どうした、夏喃！　それで終わりか！」", "Battle/Dat/Battle/Message/078.bmd|0x007EEA": "「手加減してんのか、あの爺さんは……！」", "Battle/Dat/Battle/Message/078.bmd|0x007F27": "「それで終わりか、孫光龍！」", "Battle/Dat/Battle/Message/078.bmd|0x007F52": "「応龍皇ってのも、大したことねえな！」", "Battle/Dat/Battle/Message/078.bmd|0x007F8C": "「なめるなよ、ゼゼーナン！」", "Battle/Dat/Battle/Message/078.bmd|0x007FB7": "「それが“破滅の王”の力かよ！」", "Battle/Dat/Battle/Message/078.bmd|0x007FE8": "「効いてねえぜ、メディウス何とか！」", "Battle/Dat/Battle/Message/078.bmd|0x00801F": "「チッ、てめえの忍法なんぞに！」", "Battle/Dat/Battle/Message/078.bmd|0x008050": "「笑わせんな、忍者野郎！」", "Battle/Dat/Battle/Message/078.bmd|0x008078": "「ハッ！　雀なんぞに！」", "Battle/Dat/Battle/Message/078.bmd|0x00809D": "「やれやれ、亀に食いつかれるたあな」", "Battle/Dat/Battle/Message/078.bmd|0x0080D4": "「四凶ってのは、見かけ倒しかよ！」", "Battle/Dat/Battle/Message/078.bmd|0x008108": "「チッ、ＡＩ１……あいつは面倒だぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x008142": "「調子に乗るんじゃねえぜ、ガンエデン！」", "Battle/Dat/Battle/Message/078.bmd|0x00817F": "「ユーゼス！　てめえが何をやろうと！」", "Battle/Dat/Battle/Message/078.bmd|0x0081B9": "「甘いっ！」", "Battle/Dat/Battle/Message/078.bmd|0x0081CC": "「どこ見てやがる！」", "Battle/Dat/Battle/Message/078.bmd|0x0081EB": "「俺はここだぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x008207": "「ヘッ、ノロマな奴だぜ」", "Battle/Dat/Battle/Message/078.bmd|0x00822C": "「バトルレーサーのスピードを甘く見るな！」", "Battle/Dat/Battle/Message/078.bmd|0x00826C": "「こちとらいつもより身軽なんだよ！」", "Battle/Dat/Battle/Message/078.bmd|0x0082A3": "「ひらりっ、とな！」", "Battle/Dat/Battle/Message/078.bmd|0x0082C2": "「ドゥバン！　おととい来やがれってんだ！」", "Battle/Dat/Battle/Message/078.bmd|0x008302": "「どこ見てんだ、チョンマゲ野郎！」", "Battle/Dat/Battle/Message/078.bmd|0x008336": "「甘いんだよ、メッセ野郎！」", "Battle/Dat/Battle/Message/078.bmd|0x008361": "「てめえの喋り方はイライラすんだよ！」", "Battle/Dat/Battle/Message/078.bmd|0x00839B": "「甘えぜ、セティ！」", "Battle/Dat/Battle/Message/078.bmd|0x0083BA": "「当たらねえぜ、メディウス何とか！」", "Battle/Dat/Battle/Message/078.bmd|0x0083F1": "「ルイーナなんぞにやられるかよ！」", "Battle/Dat/Battle/Message/078.bmd|0x008425": "「化け物なんぞにやられるか！」", "Battle/Dat/Battle/Message/078.bmd|0x008453": "「てめえは/　ピーチクパーチク鳴いてりゃいいんだよ！」", "Battle/Dat/Battle/Message/078.bmd|0x0084A3": "「亀なんぞにやられるかってんだ！」", "Battle/Dat/Battle/Message/078.bmd|0x0084D7": "「おととい来やがれってんだ！」", "Battle/Dat/Battle/Message/078.bmd|0x008505": "「てやんでえ！　べらぼうめ！」", "Battle/Dat/Battle/Message/078.bmd|0x008533": "「こちとら喧嘩にゃ慣れてるんでな！」", "Battle/Dat/Battle/Message/078.bmd|0x00856A": "「そう簡単に捕まってたまるかよ！」", "Battle/Dat/Battle/Message/078.bmd|0x00859E": "「ヘッ、当たるかよ！」", "Battle/Dat/Battle/Message/078.bmd|0x0085C0": "「調子に乗るな、コウタ。/　まだ戦いは続いている」", "Battle/Dat/Battle/Message/078.bmd|0x00860A": "「よし、かわしたぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x00862C": "「あと０．２秒反応が遅ければ、/　当たっていたぞ」", "Battle/Dat/Battle/Message/078.bmd|0x008676": "「相変わらず/　微妙なアドバイスをしやがって……」", "Battle/Dat/Battle/Message/078.bmd|0x0086C0": "「見たか、ロア！」", "Battle/Dat/Battle/Message/078.bmd|0x0086DC": "「……嫌でも見るしかないのでな」", "Battle/Dat/Battle/Message/078.bmd|0x00870D": "「コウタ、今の動きは……」", "Battle/Dat/Battle/Message/078.bmd|0x008735": "「結果オーライ！　お説教はいらねえぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x008772": "「……」", "Battle/Dat/Battle/Message/078.bmd|0x00877F": "「ん？　何も言わねえのかよ？」", "Battle/Dat/Battle/Message/078.bmd|0x0087AD": "「……後で言う」", "Battle/Dat/Battle/Message/078.bmd|0x0087C6": "「お兄ちゃん、さっすがぁ！」", "Battle/Dat/Battle/Message/078.bmd|0x0087F1": "「そ……そうか？」", "Battle/Dat/Battle/Message/078.bmd|0x00880D": "「頼りにしてるわよ、お兄ちゃん！」", "Battle/Dat/Battle/Message/078.bmd|0x008841": "「見たか、ショウコ！」", "Battle/Dat/Battle/Message/078.bmd|0x008863": "「うん。でも……ギリギリだったね」", "Battle/Dat/Battle/Message/078.bmd|0x008897": "「当たるかよ！」", "Battle/Dat/Battle/Message/078.bmd|0x0088B0": "「お、お兄ちゃん……！/　もうちょっと丁寧に操縦して！」", "Battle/Dat/Battle/Message/078.bmd|0x008903": "「わ……わりぃ」", "Battle/Dat/Battle/Message/078.bmd|0x00891C": "「どこ見てんだ、エグレッタ！」", "Battle/Dat/Battle/Message/078.bmd|0x00894A": "「俺はここだ、眉毛侍！」", "Battle/Dat/Battle/Message/078.bmd|0x00896F": "「てめえの炎はそんなもんか！」", "Battle/Dat/Battle/Message/078.bmd|0x00899D": "「残念だったな、ロフ！」", "Battle/Dat/Battle/Message/078.bmd|0x0089C2": "「夏喃め、遊んでるつもりか！」", "Battle/Dat/Battle/Message/078.bmd|0x0089F0": "「爺さん、どこ見てんだ！」", "Battle/Dat/Battle/Message/078.bmd|0x008A18": "「口先だけか、孫光龍！」", "Battle/Dat/Battle/Message/078.bmd|0x008A3D": "「ヘッ、大した見せ物だったぜ、光龍！」", "Battle/Dat/Battle/Message/078.bmd|0x008A77": "「ゼゼーナン！　てめえなんぞにやられるか！」", "Battle/Dat/Battle/Message/078.bmd|0x008ABA": "「何が“破滅の王”だ、笑わせんな！」", "Battle/Dat/Battle/Message/078.bmd|0x008AF1": "「ざまぁねえな、忍者野郎！」", "Battle/Dat/Battle/Message/078.bmd|0x008B1C": "「てめえの忍法も大したこたぁねえな！」", "Battle/Dat/Battle/Message/078.bmd|0x008B56": "「四凶ってのも、大したこたぁねえな！」", "Battle/Dat/Battle/Message/078.bmd|0x008B90": "「てめえなんぞと一つになる気はねえ！」", "Battle/Dat/Battle/Message/078.bmd|0x008BCA": "「それで終わりか、ガンエデン！」", "Battle/Dat/Battle/Message/078.bmd|0x008BFB": "「ユーゼスめ、/　わけのわからねえことばかり言いやがって！」", "Battle/Dat/Battle/Message/078.bmd|0x008C54": "「効くかっ！」", "Battle/Dat/Battle/Message/078.bmd|0x008C6A": "「全部もらうわけにはいかねえからな！」", "Battle/Dat/Battle/Message/078.bmd|0x008CA4": "「無駄、無駄ぁっ！」", "Battle/Dat/Battle/Message/078.bmd|0x008CC3": "「………」"}