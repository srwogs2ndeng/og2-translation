{"Battle/Dat/Battle/Message/274.bmd|0x001238": "「敵機行動予測データ、送ります」", "Battle/Dat/Battle/Message/274.bmd|0x001269": "「了解。攻撃を開始する！」", "Battle/Dat/Battle/Message/274.bmd|0x001291": "「ここは俺の判断でいく！」", "Battle/Dat/Battle/Message/274.bmd|0x0012B9": "「わかりました。お任せします」", "Battle/Dat/Battle/Message/274.bmd|0x0012E7": "「データの収集を開始します。/　後はよろしく」", "Battle/Dat/Battle/Message/274.bmd|0x00132B": "「ああ、任せろ」", "Battle/Dat/Battle/Message/274.bmd|0x001344": "「逃げ切れると思うな！」", "Battle/Dat/Battle/Message/274.bmd|0x001369": "「今度はこちらから行くぞ！」", "Battle/Dat/Battle/Message/274.bmd|0x001394": "「借りは返す！」", "Battle/Dat/Battle/Message/274.bmd|0x0013AD": "「逃げ場など、与えはせん！」", "Battle/Dat/Battle/Message/274.bmd|0x0013D8": "「この好機、逃しはせん！」", "Battle/Dat/Battle/Message/274.bmd|0x001400": "「敵はこちらを迎え撃つつもりのようです」", "Battle/Dat/Battle/Message/274.bmd|0x00143D": "「ならばっ！」", "Battle/Dat/Battle/Message/274.bmd|0x001453": "「反撃可能……どうしますか？」", "Battle/Dat/Battle/Message/274.bmd|0x001481": "「無論、仕掛ける！」", "Battle/Dat/Battle/Message/274.bmd|0x0014A0": "「くっ！　ここまでとはな！」", "Battle/Dat/Battle/Message/274.bmd|0x0014CB": "「そうだ……！　全力で来るがいい！！」", "Battle/Dat/Battle/Message/274.bmd|0x001505": "「ぐっ！　サーボさえ動くのであれば！」", "Battle/Dat/Battle/Message/274.bmd|0x00153F": "「ぬうっ！　動きを読まれたか！」", "Battle/Dat/Battle/Message/274.bmd|0x001570": "「うっ！　持ちこたえたか！」", "Battle/Dat/Battle/Message/274.bmd|0x00159B": "「己の死は、己に意味をもたらさんのだ！」", "Battle/Dat/Battle/Message/274.bmd|0x0015D8": "「くっ！　こちらに隙があったか！」", "Battle/Dat/Battle/Message/274.bmd|0x00160C": "「ここから巻き返す！」", "Battle/Dat/Battle/Message/274.bmd|0x00162E": "「データ以上の力を出す……/　それが人間というものだ！」", "Battle/Dat/Battle/Message/274.bmd|0x001681": "「こちらの指示に従ってください！」", "Battle/Dat/Battle/Message/274.bmd|0x0016B5": "「口を出すな！/　戦っているのは、この俺だ！」", "Battle/Dat/Battle/Message/274.bmd|0x0016F9": "「フン、やってくれる！」", "Battle/Dat/Battle/Message/274.bmd|0x00171E": "「本気を出してきたようだな……！」", "Battle/Dat/Battle/Message/274.bmd|0x001752": "「いい攻撃だったと言っておこう」", "Battle/Dat/Battle/Message/274.bmd|0x001783": "「まだ浅い！」", "Battle/Dat/Battle/Message/274.bmd|0x001799": "「ほう、なかなかやるな」", "Battle/Dat/Battle/Message/274.bmd|0x0017BE": "「致命傷ではない！」", "Battle/Dat/Battle/Message/274.bmd|0x0017DD": "「直撃か！　だが！」", "Battle/Dat/Battle/Message/274.bmd|0x0017FC": "「ほう、俺に食らいついてきたか」", "Battle/Dat/Battle/Message/274.bmd|0x00182D": "「チッ、俺も甘いな」", "Battle/Dat/Battle/Message/274.bmd|0x00184C": "「かすめた程度だ！」", "Battle/Dat/Battle/Message/274.bmd|0x00186B": "「フッ、浅いな」", "Battle/Dat/Battle/Message/274.bmd|0x001884": "「気にする程の損傷ではない」", "Battle/Dat/Battle/Message/274.bmd|0x0018AF": "「回避し損なうとは……！」", "Battle/Dat/Battle/Message/274.bmd|0x0018D7": "「ダメージは軽い。ミッション続行だ」", "Battle/Dat/Battle/Message/274.bmd|0x00190E": "「フン、こんなものか」", "Battle/Dat/Battle/Message/274.bmd|0x001930": "「ぐっ！　こちらに油断があったか！」", "Battle/Dat/Battle/Message/274.bmd|0x001967": "「ぬうっ！　いい腕をしている！」", "Battle/Dat/Battle/Message/274.bmd|0x001998": "「こちらの読みが甘かったようだな……！」", "Battle/Dat/Battle/Message/274.bmd|0x0019D5": "「申し訳ありません。再計算します」", "Battle/Dat/Battle/Message/274.bmd|0x001A09": "「サーベラス……その程度か」", "Battle/Dat/Battle/Message/274.bmd|0x001A34": "「やはり、出力が安定していないようだな」", "Battle/Dat/Battle/Message/274.bmd|0x001A71": "「ガルムレイドを使いこなせていないようだな」", "Battle/Dat/Battle/Message/274.bmd|0x001AB4": "「当たらん！」", "Battle/Dat/Battle/Message/274.bmd|0x001ACA": "「甘いな！」", "Battle/Dat/Battle/Message/274.bmd|0x001ADD": "「動きがわかり易すぎる」", "Battle/Dat/Battle/Message/274.bmd|0x001B02": "「貴様に俺は止められん！」", "Battle/Dat/Battle/Message/274.bmd|0x001B2A": "「出掛かりから既に見切っている！」", "Battle/Dat/Battle/Message/274.bmd|0x001B5E": "「単純な動きだな」", "Battle/Dat/Battle/Message/274.bmd|0x001B7A": "「フン、他愛もない」", "Battle/Dat/Battle/Message/274.bmd|0x001B99": "「その程度の腕で戦場に出てくるとはな」", "Battle/Dat/Battle/Message/274.bmd|0x001BD3": "「所詮は素人か」", "Battle/Dat/Battle/Message/274.bmd|0x001BEC": "「効きはせん！」", "Battle/Dat/Battle/Message/274.bmd|0x001C05": "「ＴＥスフィア、展開！」", "Battle/Dat/Battle/Message/274.bmd|0x001C2A": "「そんなもの、俺には届かんぞ！」", "Battle/Dat/Battle/Message/274.bmd|0x001C5B": "「甘いっ！」", "Battle/Dat/Battle/Message/274.bmd|0x001C6E": "「こういう手もある！」", "Battle/Dat/Battle/Message/274.bmd|0x001C90": "「笑止っ！」", "Battle/Dat/Battle/Message/274.bmd|0x001CA3": "「………」", "Battle/Dat/Battle/Message/274.bmd|0x001CB3": "「フン……ＡＩ１も、あてにならんな」", "Battle/Dat/Battle/Message/274.bmd|0x001CEA": "「反撃不可能か……！」", "Battle/Dat/Battle/Message/274.bmd|0x001D0C": "「効率の良さだけでは、戦いに勝てんよ」", "Battle/Dat/Battle/Message/274.bmd|0x001D46": "「チッ、見失ったか！」", "Battle/Dat/Battle/Message/274.bmd|0x001D68": "「生き延びたいだけなら、それも良かろう」", "Battle/Dat/Battle/Message/274.bmd|0x001DA5": "「好機は最大限に生かす！/　覚えておけ！」", "Battle/Dat/Battle/Message/274.bmd|0x001DE3": "「その隙を見逃す俺ではない！」", "Battle/Dat/Battle/Message/274.bmd|0x001E11": "「敵、離脱不可能です」", "Battle/Dat/Battle/Message/274.bmd|0x001E33": "「ならば、追い詰めるまで！」", "Battle/Dat/Battle/Message/274.bmd|0x001E5E": "「貴様の相手は俺だ！」", "Battle/Dat/Battle/Message/274.bmd|0x001E80": "「チッ、やむを得ん！」", "Battle/Dat/Battle/Message/274.bmd|0x001EA2": "「その陣形が命取りだ！」", "Battle/Dat/Battle/Message/274.bmd|0x001EC7": "「まだそこにいたか！」", "Battle/Dat/Battle/Message/274.bmd|0x001EE9": "「追い詰める！」", "Battle/Dat/Battle/Message/274.bmd|0x001F02": "「一斉攻撃！　かかれっ！」", "Battle/Dat/Battle/Message/274.bmd|0x001F2A": "「全機、集中攻撃！」", "Battle/Dat/Battle/Message/274.bmd|0x001F49": "「ロックオン！」", "Battle/Dat/Battle/Message/274.bmd|0x001F62": "「くらえ！」", "Battle/Dat/Battle/Message/274.bmd|0x001F75": "「逃しはせん！」", "Battle/Dat/Battle/Message/274.bmd|0x001F8E": "「仕留める！」", "Battle/Dat/Battle/Message/274.bmd|0x001FA4": "「ＡＩ１、ターゲット選択終了。/　出力、問題ありません」", "Battle/Dat/Battle/Message/274.bmd|0x001FF7": "「行くぞ！！」", "Battle/Dat/Battle/Message/274.bmd|0x00200D": "「良いデータが得られることを/　期待しています」", "Battle/Dat/Battle/Message/274.bmd|0x002054": "「任せてもらおう！」", "Battle/Dat/Battle/Message/274.bmd|0x002073": "「ＦＡＰ、指定」", "Battle/Dat/Battle/Message/274.bmd|0x00208C": "「お前の命運は尽きた……！！」", "Battle/Dat/Battle/Message/274.bmd|0x0020BA": "「ここで散れいっ！！」", "Battle/Dat/Battle/Message/274.bmd|0x0020DC": "「もう逃げられんぞ……！！」", "Battle/Dat/Battle/Message/274.bmd|0x002107": "「行け！　無明の世界へ！」", "Battle/Dat/Battle/Message/275.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/275.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/275.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/275.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/275.bmd|0x0003FC": "「………？」", "Battle/Dat/Battle/Message/276.bmd|0x000430": "「………」", "Battle/Dat/Battle/Message/276.bmd|0x000440": "「！？！？！？」", "Battle/Dat/Battle/Message/276.bmd|0x000459": "「………！！！」", "Battle/Dat/Battle/Message/276.bmd|0x000472": "「………！！」", "Battle/Dat/Battle/Message/276.bmd|0x000488": "「………？」", "Battle/Dat/Battle/Message/277.bmd|0x000A02": "「俺達に目をつけられたのが不運だったな！」", "Battle/Dat/Battle/Message/277.bmd|0x000A42": "「こいつはいいカモだ！　高く売れるぜ！」", "Battle/Dat/Battle/Message/277.bmd|0x000A7F": "「大人しく、俺達の飯の種になっちまいな！」", "Battle/Dat/Battle/Message/277.bmd|0x000ABF": "「ここいらは、このゴルド様の縄張りだ！/　知らずに入ってきた/　そっちが悪いんだよ！」", "Battle/Dat/Battle/Message/277.bmd|0x000B3D": "「やりおったなっ！」", "Battle/Dat/Battle/Message/277.bmd|0x000B5C": "「借りは返すぜっ！」", "Battle/Dat/Battle/Message/277.bmd|0x000B7B": "「お返しだっ！」", "Battle/Dat/Battle/Message/277.bmd|0x000B94": "「やらせるかよっ！」", "Battle/Dat/Battle/Message/277.bmd|0x000BB3": "「くっそぉぉぉっ！！　やられたっ！」", "Battle/Dat/Battle/Message/277.bmd|0x000BEA": "「や、やられたぁっ！」", "Battle/Dat/Battle/Message/277.bmd|0x000C0C": "「な、何なんだ、こいつはっ！？」", "Battle/Dat/Battle/Message/277.bmd|0x000C3D": "「こんなパワーがあるってのかよ！？」", "Battle/Dat/Battle/Message/277.bmd|0x000C74": "「ぐあああっ！！/　こ、こいつ、化け物か！？」", "Battle/Dat/Battle/Message/277.bmd|0x000CB8": "「まだだっ！　まだやられてねえぞ！」", "Battle/Dat/Battle/Message/277.bmd|0x000CEF": "「ちいっ！　やりおったな！」", "Battle/Dat/Battle/Message/277.bmd|0x000D1A": "「このっ！　意外とやるじゃねえか！」", "Battle/Dat/Battle/Message/277.bmd|0x000D51": "「くっ！　油断しちまったぜ！」"}