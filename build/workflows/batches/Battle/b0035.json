{"Battle/Dat/Battle/Message/031.bmd|0x0013B7": "「やらせんっ！」", "Battle/Dat/Battle/Message/031.bmd|0x0013D0": "「返り討ちって知ってるか？」", "Battle/Dat/Battle/Message/031.bmd|0x0013FB": "「いい気になるなよっ！」", "Battle/Dat/Battle/Message/031.bmd|0x001420": "「追撃をかける！」", "Battle/Dat/Battle/Message/031.bmd|0x00143C": "「今度はこちらの番です！」", "Battle/Dat/Battle/Message/031.bmd|0x001464": "「くっ、やられたかっ！」", "Battle/Dat/Battle/Message/031.bmd|0x001489": "「しまった！　抜かったか！」", "Battle/Dat/Battle/Message/031.bmd|0x0014B4": "「ええい！　ここまでか！」", "Battle/Dat/Battle/Message/031.bmd|0x0014DC": "「ぐうっ！！/　ま、まずい、完全に押されている！」", "Battle/Dat/Battle/Message/031.bmd|0x001526": "「ぐうっ！　こ、こいつはシャレにならんぞ！」", "Battle/Dat/Battle/Message/031.bmd|0x001569": "「な、何だとっ！？/　くっ……心の隙があったか！」", "Battle/Dat/Battle/Message/031.bmd|0x0015B3": "「ぐうぅっ！！/　何なんだ、このパワーはっ！？」", "Battle/Dat/Battle/Message/031.bmd|0x0015FA": "「うおっ！？/　ま、まずいぞ……まさかこれほどとは」", "Battle/Dat/Battle/Message/031.bmd|0x001647": "「まずい！/　このままじゃ、サイバスターに！」", "Battle/Dat/Battle/Message/031.bmd|0x00168B": "「やはり、魔装機神が相手では！」", "Battle/Dat/Battle/Message/031.bmd|0x0016BC": "「こ、これがガッデスの力か！」", "Battle/Dat/Battle/Message/031.bmd|0x0016EA": "「このっ！/　こっちの回避パターンを読んでやがったか！」", "Battle/Dat/Battle/Message/031.bmd|0x00173D": "「ええい！　まともに食らったか！」", "Battle/Dat/Battle/Message/031.bmd|0x001771": "「こいつ、やっぱり油断ならねぇ！」", "Battle/Dat/Battle/Message/031.bmd|0x0017A5": "「やるっ！/　やはりそうでなくてはな！」", "Battle/Dat/Battle/Message/031.bmd|0x0017E0": "「くっ！　さすがにいい腕してるな」", "Battle/Dat/Battle/Message/031.bmd|0x001814": "「うぐっ！/　サイバスター……やはり、速い！」", "Battle/Dat/Battle/Message/031.bmd|0x001858": "「ぐっ！　さすが魔装機神……！」", "Battle/Dat/Battle/Message/031.bmd|0x001889": "「くっ、さすがテュッティ殿……！」", "Battle/Dat/Battle/Message/031.bmd|0x0018BD": "「悪いな、効いてないんだよ」", "Battle/Dat/Battle/Message/031.bmd|0x0018E8": "「ふっ、案外大したことないんだな」", "Battle/Dat/Battle/Message/031.bmd|0x00191C": "「……おい、/　まさか手を抜いてるんじゃないだろうな？」", "Battle/Dat/Battle/Message/031.bmd|0x00196F": "「その程度か……期待外れだな」", "Battle/Dat/Battle/Message/031.bmd|0x00199D": "「全力でやってそれか？　……興ざめだな」", "Battle/Dat/Battle/Message/031.bmd|0x0019DA": "「サイバスター相手に/　油断したつもりはないが……！」", "Battle/Dat/Battle/Message/031.bmd|0x001A2A": "「魔装機神の力が/　この程度だとは思えんが……！」", "Battle/Dat/Battle/Message/031.bmd|0x001A74": "「ガッデスを振り切れなかったか！」", "Battle/Dat/Battle/Message/031.bmd|0x001AA8": "「悪いな、外れだ」", "Battle/Dat/Battle/Message/031.bmd|0x001AC4": "「そう簡単に当たってたまるか！」", "Battle/Dat/Battle/Message/031.bmd|0x001AF5": "「おっと、危ない！」", "Battle/Dat/Battle/Message/031.bmd|0x001B14": "「当たりません！」", "Battle/Dat/Battle/Message/031.bmd|0x001B30": "「嬉しいねぇ、/　こちらの予測通りに攻撃してくれるとはな」", "Battle/Dat/Battle/Message/031.bmd|0x001B86": "「悪いな、/　確率通りにいかないのが人生ってもんだ」", "Battle/Dat/Battle/Message/031.bmd|0x001BD3": "「………」", "Battle/Dat/Battle/Message/031.bmd|0x001BE3": "「くそっ！　こんな時に弾切れかよ！」", "Battle/Dat/Battle/Message/031.bmd|0x001C1A": "「ちっ、この距離では反撃は無理だな」", "Battle/Dat/Battle/Message/031.bmd|0x001C51": "「ちっ、反撃は無理だな…！」", "Battle/Dat/Battle/Message/031.bmd|0x001C7C": "「とどめは任せろ！」", "Battle/Dat/Battle/Message/031.bmd|0x001C9B": "「よし、次は私がいく！」", "Battle/Dat/Battle/Message/031.bmd|0x001CC0": "「遅いなっ！」", "Battle/Dat/Battle/Message/031.bmd|0x001CD6": "「カバーに入る！」", "Battle/Dat/Battle/Message/031.bmd|0x001CF2": "「ライオネス少尉、援護するぞ！」", "Battle/Dat/Battle/Message/031.bmd|0x001D23": "「下がれ！」", "Battle/Dat/Battle/Message/031.bmd|0x001D36": "「ここは私に任せろ！」", "Battle/Dat/Battle/Message/031.bmd|0x001D58": "「やらせはしないっ！」", "Battle/Dat/Battle/Message/031.bmd|0x001D7A": "「見捨てられるかっ！」", "Battle/Dat/Battle/Message/031.bmd|0x001D9C": "「いかん！　下がれ、少尉！/　ここは私が受ける！」", "Battle/Dat/Battle/Message/031.bmd|0x001DE6": "「もう一撃いかせてもらう。悪いな」", "Battle/Dat/Battle/Message/031.bmd|0x001E1A": "「反応が遅いぞ！」", "Battle/Dat/Battle/Message/031.bmd|0x001E36": "「その隙が命取りだ！」", "Battle/Dat/Battle/Message/031.bmd|0x001E58": "「こういう手もあるのさ！」", "Battle/Dat/Battle/Message/031.bmd|0x001E80": "「こいつで終わりだっ！」", "Battle/Dat/Battle/Message/031.bmd|0x001EA5": "「もう一撃！」", "Battle/Dat/Battle/Message/031.bmd|0x001EBB": "「やってみせる！」", "Battle/Dat/Battle/Message/031.bmd|0x001ED7": "「くらえっ！」", "Battle/Dat/Battle/Message/031.bmd|0x001EED": "「もらった！」", "Battle/Dat/Battle/Message/031.bmd|0x001F03": "「遅い！」", "Battle/Dat/Battle/Message/031.bmd|0x001F13": "「行けっ！」", "Battle/Dat/Battle/Message/031.bmd|0x001F26": "「当てるっ！」", "Battle/Dat/Battle/Message/031.bmd|0x001F3C": "「そこだっ！」", "Battle/Dat/Battle/Message/032.bmd|0x000C3E": "「捕まえた。もう、逃がさないから」", "Battle/Dat/Battle/Message/032.bmd|0x000C72": "「うふふ、こうなったらもう、こっちのものよ」", "Battle/Dat/Battle/Message/032.bmd|0x000CB5": "「さあ、いい子だから大人しくしてなさい」", "Battle/Dat/Battle/Message/032.bmd|0x000CF2": "「さあ、覚悟は出来てる？」", "Battle/Dat/Battle/Message/032.bmd|0x000D1A": "「ふふ、楽しくなってきたわ」", "Battle/Dat/Battle/Message/032.bmd|0x000D45": "「さて、私の番かしらね」", "Battle/Dat/Battle/Message/032.bmd|0x000D6A": "「お返しさせてもらうわ」", "Battle/Dat/Battle/Message/032.bmd|0x000D8F": "「ただで帰すと思ってるの！？」", "Battle/Dat/Battle/Message/032.bmd|0x000DBD": "「お返しっ！」", "Battle/Dat/Battle/Message/032.bmd|0x000DD3": "「やってくれたねっ！」", "Battle/Dat/Battle/Message/032.bmd|0x000DF5": "「こっちが反撃する番よ！」", "Battle/Dat/Battle/Message/032.bmd|0x000E1D": "「ふふ、倍返しさせてもらうわ！」", "Battle/Dat/Battle/Message/032.bmd|0x000E4E": "「くっ……またやられた」", "Battle/Dat/Battle/Message/032.bmd|0x000E73": "「このっ……覚えときなさいよっ！」", "Battle/Dat/Battle/Message/032.bmd|0x000EA7": "「あうぅっ！/　こ、このパワー……押されてる！？」", "Battle/Dat/Battle/Message/032.bmd|0x000EF1": "「くぅっ！　まずいわ、このままじゃ」", "Battle/Dat/Battle/Message/032.bmd|0x000F28": "「もう、何するのよ！」", "Battle/Dat/Battle/Message/032.bmd|0x000F4A": "「ぐえっ！！/　な、何てこと……追い詰められてる？」", "Battle/Dat/Battle/Message/032.bmd|0x000F97": "「ぐふぅっ！！/　こ、こんなパワーがあるなんて……」", "Battle/Dat/Battle/Message/032.bmd|0x000FE4": "「あぅっ！！　さ、さすがね……」", "Battle/Dat/Battle/Message/032.bmd|0x001015": "「ど、どういうこと！？/　こんなの、聞いてないわよ！？」", "Battle/Dat/Battle/Message/032.bmd|0x001068": "「あうっ！　ふ……やるじゃないの」", "Battle/Dat/Battle/Message/032.bmd|0x00109C": "「つっ……さすがね。/　けど、これ以上はやらせないから！」", "Battle/Dat/Battle/Message/032.bmd|0x0010F2": "「ちっ、やってくれる！」", "Battle/Dat/Battle/Message/032.bmd|0x001117": "「あだっ！　……今のは痛かったよ！」", "Battle/Dat/Battle/Message/032.bmd|0x00114E": "「あら……/　今のはそれなりに美しく決まってたわね」", "Battle/Dat/Battle/Message/032.bmd|0x00119B": "「くっ……やるわね。/　なら、こちらも本気を出さないと」", "Battle/Dat/Battle/Message/032.bmd|0x0011EE": "「ちっ、避けたつもりだったのに……」", "Battle/Dat/Battle/Message/032.bmd|0x001225": "「くっ……このっ！/　いつまでもいい気になってんじゃないよ！」", "Battle/Dat/Battle/Message/032.bmd|0x001281": "「こ、このっ！　やってくれるじゃないの！」", "Battle/Dat/Battle/Message/032.bmd|0x0012C1": "「効かないわよ！」", "Battle/Dat/Battle/Message/032.bmd|0x0012DD": "「何、それ？　本気でやってそれなの？」", "Battle/Dat/Battle/Message/032.bmd|0x001317": "「何だ、大したことないのね」", "Battle/Dat/Battle/Message/032.bmd|0x001342": "「ふん、その程度じゃビクともしないわよ」", "Battle/Dat/Battle/Message/032.bmd|0x00137F": "「こっちの装甲をなめてるみたいね」", "Battle/Dat/Battle/Message/032.bmd|0x0013B3": "「あら、案外大したことないじゃない」", "Battle/Dat/Battle/Message/032.bmd|0x0013EA": "「うふふ、可愛いものねぇ」", "Battle/Dat/Battle/Message/032.bmd|0x001412": "「駄目ね。そんな攻撃、美学が感じられない」", "Battle/Dat/Battle/Message/032.bmd|0x001452": "「ふーん、意外ね。その程度だったの」", "Battle/Dat/Battle/Message/032.bmd|0x001489": "「駄目ね……全然駄目。出直してらっしゃい」", "Battle/Dat/Battle/Message/032.bmd|0x0014C9": "「ふん、そんな攻撃、当たるものですか」", "Battle/Dat/Battle/Message/032.bmd|0x001503": "「ふん、どこ狙ってるのよ」", "Battle/Dat/Battle/Message/032.bmd|0x00152B": "「狙いが甘いのよ！」", "Battle/Dat/Battle/Message/032.bmd|0x00154A": "「おおっと！」", "Battle/Dat/Battle/Message/032.bmd|0x001560": "「ちょっと！　危ないでしょ！」", "Battle/Dat/Battle/Message/032.bmd|0x00158E": "「何するの！　当たったら危ないでしょ！」", "Battle/Dat/Battle/Message/032.bmd|0x0015CB": "「どう？　この回避機動。美しいでしょ？」", "Battle/Dat/Battle/Message/032.bmd|0x001608": "「ああ、無駄無駄。/　そんな攻撃、とっくに解析済みだから」", "Battle/Dat/Battle/Message/032.bmd|0x00165E": "「………」", "Battle/Dat/Battle/Message/032.bmd|0x00166E": "「何てこと！/　こんな時に使える武器がないなんて！」", "Battle/Dat/Battle/Message/032.bmd|0x0016BB": "「参ったわ。ここからじゃ届かないのよね」", "Battle/Dat/Battle/Message/032.bmd|0x0016F8": "「あら、まだ足りないの？　それじゃ遠慮なく」", "Battle/Dat/Battle/Message/032.bmd|0x00173B": "「残念、まだ終わりじゃないの！」", "Battle/Dat/Battle/Message/032.bmd|0x00176C": "「待ちなさい！　まだ終わってないわ！」", "Battle/Dat/Battle/Message/032.bmd|0x0017A6": "「遅いわね！　もう一撃！」"}