{"Battle/Dat/Battle/Message/277.bmd|0x000D7F": "「けっ、やりやがったな！」", "Battle/Dat/Battle/Message/277.bmd|0x000DA7": "「はっ、それで終わりか？」", "Battle/Dat/Battle/Message/277.bmd|0x000DCF": "「何だ、そりゃ？　痛くもかゆくもねえぜ！」", "Battle/Dat/Battle/Message/277.bmd|0x000E0F": "「がはははっ！　非力な奴め！」", "Battle/Dat/Battle/Message/277.bmd|0x000E3D": "「効かん、効かんなぁ」", "Battle/Dat/Battle/Message/277.bmd|0x000E5F": "「遅いなっ！」", "Battle/Dat/Battle/Message/277.bmd|0x000E75": "「何やってやがる！」", "Battle/Dat/Battle/Message/277.bmd|0x000E94": "「下手くそが！」", "Battle/Dat/Battle/Message/277.bmd|0x000EAD": "「がはは！　どこを狙っている！」", "Battle/Dat/Battle/Message/277.bmd|0x000EDE": "「………」", "Battle/Dat/Battle/Message/277.bmd|0x000EEE": "「くっ、弾切れかよ！」", "Battle/Dat/Battle/Message/277.bmd|0x000F10": "「ちっ、こっちの射程を計算したか」", "Battle/Dat/Battle/Message/277.bmd|0x000F44": "「むっ！？」", "Battle/Dat/Battle/Message/277.bmd|0x000F57": "「手助けするぜっ！」", "Battle/Dat/Battle/Message/277.bmd|0x000F76": "「任せろっ！」", "Battle/Dat/Battle/Message/277.bmd|0x000F8C": "「させるかよっ！」", "Battle/Dat/Battle/Message/277.bmd|0x000FA8": "「下がってろ！」", "Battle/Dat/Battle/Message/277.bmd|0x000FC1": "「もう一発、かますぜ！」", "Battle/Dat/Battle/Message/277.bmd|0x000FE6": "「遅いんだよ！」", "Battle/Dat/Battle/Message/277.bmd|0x000FFF": "「まだ終わりじゃねえぜ！」", "Battle/Dat/Battle/Message/277.bmd|0x001027": "「くらえっ！」", "Battle/Dat/Battle/Message/277.bmd|0x00103D": "「くたばれっ！」", "Battle/Dat/Battle/Message/277.bmd|0x001056": "「こいつでどうだっ！」", "Battle/Dat/Battle/Message/277.bmd|0x001078": "「やられちまえってんだよ！」", "Battle/Dat/Battle/Message/277.bmd|0x0010A3": "「せいっ！」", "Battle/Dat/Battle/Message/277.bmd|0x0010B6": "「はっ！」", "Battle/Dat/Battle/Message/277.bmd|0x0010C6": "「うりゃっ！」", "Battle/Dat/Battle/Message/277.bmd|0x0010DC": "「ていっ！」", "Battle/Dat/Battle/Message/277.bmd|0x0010EF": "「とうっ！」", "Battle/Dat/Battle/Message/278.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/279.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/280.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/281.bmd|0x000889": "「行くぞ！」", "Battle/Dat/Battle/Message/281.bmd|0x00089C": "「邪魔だっ！」", "Battle/Dat/Battle/Message/281.bmd|0x0008B2": "「私には……やるべきことがあるのだ！」", "Battle/Dat/Battle/Message/281.bmd|0x0008EC": "「狙いは外さん！」", "Battle/Dat/Battle/Message/281.bmd|0x000908": "「受けよ！」", "Battle/Dat/Battle/Message/281.bmd|0x00091B": "「メガスマッシャー！！」", "Battle/Dat/Battle/Message/281.bmd|0x000940": "「では、こちらからも行くぞ」", "Battle/Dat/Battle/Message/281.bmd|0x00096B": "「反撃開始だ」", "Battle/Dat/Battle/Message/281.bmd|0x000981": "「では、こちらの番だな！」", "Battle/Dat/Battle/Message/281.bmd|0x0009A9": "「逃げられると思ったか？」", "Battle/Dat/Battle/Message/281.bmd|0x0009D1": "「むうっ……み、見事だ」", "Battle/Dat/Battle/Message/281.bmd|0x0009F6": "「むうっ！？/　デュラクシールが押されているだと？」", "Battle/Dat/Battle/Message/281.bmd|0x000A43": "「馬鹿な……/　デュラクシールが……こんなことで……」", "Battle/Dat/Battle/Message/281.bmd|0x000A93": "「ぐうっ！！/　いくらデュラクシールとはいえ、/　このダメージは……」", "Battle/Dat/Battle/Message/281.bmd|0x000AF9": "「ぐっ……い、いかん！/　パワーが上がらんのか！？」", "Battle/Dat/Battle/Message/281.bmd|0x000B46": "「くっ……さすがに今のは効いたな」", "Battle/Dat/Battle/Message/281.bmd|0x000B7A": "「やるな……そうこなくては」", "Battle/Dat/Battle/Message/281.bmd|0x000BA5": "「くっ、デュラクシールとて、/　万全ではないということか」", "Battle/Dat/Battle/Message/281.bmd|0x000BFB": "「いい攻撃だ……/　だが、デュラクシールはこの程度では落ちんぞ！」", "Battle/Dat/Battle/Message/281.bmd|0x000C5D": "「その程度では効かんな」", "Battle/Dat/Battle/Message/281.bmd|0x000C82": "「ああ、さすがはデュラクシールだ」", "Battle/Dat/Battle/Message/281.bmd|0x000CB6": "「この程度で、/　私を止められるとでも思ったか？」", "Battle/Dat/Battle/Message/281.bmd|0x000D00": "「そんな攻撃など、物の数ではない！」", "Battle/Dat/Battle/Message/281.bmd|0x000D37": "「どうした、それで精一杯か？」", "Battle/Dat/Battle/Message/281.bmd|0x000D65": "「無駄だよ……/　このデュラクシールを/　止められるものなどいない……」", "Battle/Dat/Battle/Message/281.bmd|0x000DCE": "「当たりはせん！」", "Battle/Dat/Battle/Message/281.bmd|0x000DEA": "「そう簡単に当たるものか」", "Battle/Dat/Battle/Message/281.bmd|0x000E12": "「どこを狙っている！」", "Battle/Dat/Battle/Message/281.bmd|0x000E34": "「甘いな！」", "Battle/Dat/Battle/Message/281.bmd|0x000E47": "「………」", "Battle/Dat/Battle/Message/281.bmd|0x000E57": "「弾切れとはな……仕方がないか」", "Battle/Dat/Battle/Message/281.bmd|0x000E88": "「む、射程外か……」", "Battle/Dat/Battle/Message/281.bmd|0x000EA7": "「……仕方がないか」", "Battle/Dat/Battle/Message/281.bmd|0x000EC6": "「これでどうだ！」", "Battle/Dat/Battle/Message/281.bmd|0x000EE2": "「もらうっ！」", "Battle/Dat/Battle/Message/281.bmd|0x000EF8": "「そこかっ！」", "Battle/Dat/Battle/Message/281.bmd|0x000F0E": "「くらえっ！」", "Battle/Dat/Battle/Message/281.bmd|0x000F24": "「超振動クロー！」", "Battle/Dat/Battle/Message/281.bmd|0x000F40": "「はああっ！」", "Battle/Dat/Battle/Message/281.bmd|0x000F56": "「せいっ！！」", "Battle/Dat/Battle/Message/281.bmd|0x000F6C": "「タオーステイル！」", "Battle/Dat/Battle/Message/282.bmd|0x0007C0": "「がああああ！！」", "Battle/Dat/Battle/Message/282.bmd|0x0007DC": "「うああああ！！」", "Battle/Dat/Battle/Message/282.bmd|0x0007F8": "「ぐああああっ！！」", "Battle/Dat/Battle/Message/282.bmd|0x000817": "「ぐあっ！　がああああ！！」", "Battle/Dat/Battle/Message/282.bmd|0x000842": "「うぐおおおお！！」", "Battle/Dat/Battle/Message/282.bmd|0x000861": "「ぐうっ！　がああっ！！」", "Battle/Dat/Battle/Message/282.bmd|0x000889": "「うあっ！　くあっ！！」", "Battle/Dat/Battle/Message/282.bmd|0x0008AE": "「ぐっ！　ぬあああ！！」", "Battle/Dat/Battle/Message/282.bmd|0x0008D3": "「ぐうっ！」", "Battle/Dat/Battle/Message/282.bmd|0x0008E6": "「ぐはっ！」", "Battle/Dat/Battle/Message/282.bmd|0x0008F9": "「うああっ！！」", "Battle/Dat/Battle/Message/282.bmd|0x000912": "「おおおお！！」", "Battle/Dat/Battle/Message/282.bmd|0x00092B": "「くあああ！！」", "Battle/Dat/Battle/Message/282.bmd|0x000944": "「………」", "Battle/Dat/Battle/Message/282.bmd|0x000954": "「ぬああ！　うああああっ！！」", "Battle/Dat/Battle/Message/282.bmd|0x000982": "「うおあああ！」", "Battle/Dat/Battle/Message/282.bmd|0x00099B": "「ぬああああ！」", "Battle/Dat/Battle/Message/282.bmd|0x0009B4": "「あああああ！」", "Battle/Dat/Battle/Message/282.bmd|0x0009CD": "「がああああああ！！」", "Battle/Dat/Battle/Message/283.bmd|0x000C58": "「進化！　進化するぞ、おれは！！」", "Battle/Dat/Battle/Message/283.bmd|0x000C8C": "「支配！　支配してやるぞ！！」", "Battle/Dat/Battle/Message/283.bmd|0x000CBA": "「変える！/　変えてやるぞ、この呪われた宿命を！！」", "Battle/Dat/Battle/Message/283.bmd|0x000D07": "「超越！　超越するぞ、全ての存在を！！」", "Battle/Dat/Battle/Message/283.bmd|0x000D44": "「超える！　超えるぞ、イデアラントを！！」", "Battle/Dat/Battle/Message/283.bmd|0x000D84": "「アリエイル！　おれは運命を変える！！」", "Battle/Dat/Battle/Message/283.bmd|0x000DC1": "「お前がイデアラントであることをやめるなら！/　おれはイデアラントを超えてやる！！」", "Battle/Dat/Battle/Message/283.bmd|0x000E3E": "「貴様だ！　貴様の力を物にすれば！！」", "Battle/Dat/Battle/Message/283.bmd|0x000E78": "「貴様を得て、おれは進化を遂げる！！」", "Battle/Dat/Battle/Message/283.bmd|0x000EB2": "「おれの糧となれ、アインストォ！！」", "Battle/Dat/Battle/Message/283.bmd|0x000EE9": "「追う！　追い詰めてやる！！」", "Battle/Dat/Battle/Message/283.bmd|0x000F17": "「逃がさん！　逃がしはせん！！」", "Battle/Dat/Battle/Message/283.bmd|0x000F48": "「力！　さらなる力を！！」", "Battle/Dat/Battle/Message/283.bmd|0x000F70": "「お、おれは！！　おれはぁぁぁ！！！」", "Battle/Dat/Battle/Message/283.bmd|0x000FAA": "「ぐああっ！　おのれ！！」", "Battle/Dat/Battle/Message/283.bmd|0x000FD2": "「まだ！　まだ終わらんぞ！！」", "Battle/Dat/Battle/Message/283.bmd|0x001000": "「ここから！　俺はここからだ！！」", "Battle/Dat/Battle/Message/283.bmd|0x001034": "「ぬぐううっ！　アレス、お前ならば！！」", "Battle/Dat/Battle/Message/283.bmd|0x001071": "「届かん！　届かんぞ、おれの命には！！」", "Battle/Dat/Battle/Message/283.bmd|0x0010AE": "「お、おのれ！　おのれ、アリエイル！！」", "Battle/Dat/Battle/Message/283.bmd|0x0010EB": "「ぬうっ！　よくも！！」", "Battle/Dat/Battle/Message/283.bmd|0x001110": "「死なん！　おれは死なんぞ！！」", "Battle/Dat/Battle/Message/283.bmd|0x001141": "「よくも！　よくもこのおれに！！」", "Battle/Dat/Battle/Message/283.bmd|0x001175": "「止まらん！/　止まらんぞ、おれもアレスも！！」", "Battle/Dat/Battle/Message/283.bmd|0x0011BC": "「アリエイル、貴様ァ！！」", "Battle/Dat/Battle/Message/283.bmd|0x0011E4": "「ちいっ！　鬱陶しい！！」", "Battle/Dat/Battle/Message/283.bmd|0x00120C": "「ええい、邪魔をするな！！」", "Battle/Dat/Battle/Message/283.bmd|0x001237": "「浅い！　浅いぞ！！」"}