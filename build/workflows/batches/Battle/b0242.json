{"Battle/Dat/Battle/Message/157.bmd|0x002CB6": "「ふん！　何だ、それは？」", "Battle/Dat/Battle/Message/157.bmd|0x002CDE": "「この程度、気にする必要はない」", "Battle/Dat/Battle/Message/157.bmd|0x002D0F": "「思っていたほどのパワーではないな！」", "Battle/Dat/Battle/Message/157.bmd|0x002D49": "「甘いぞ、地上人！」", "Battle/Dat/Battle/Message/157.bmd|0x002D68": "「地上人よ、遠慮は無用だ！」", "Battle/Dat/Battle/Message/157.bmd|0x002D93": "「ぐっ！　サイバスターに食いつかれたか！」", "Battle/Dat/Battle/Message/157.bmd|0x002DD3": "「魔装機神の力がこの程度だとは思えんが……」", "Battle/Dat/Battle/Message/157.bmd|0x002E16": "「よし、魔装機神と渡り合えるぞ！」", "Battle/Dat/Battle/Message/157.bmd|0x002E4A": "「グランヴェール……そんなものなのか？」", "Battle/Dat/Battle/Message/157.bmd|0x002E87": "「ガッデス……手加減をしているのか？」", "Battle/Dat/Battle/Message/157.bmd|0x002EC1": "「ザムジードの力を/　使いこなせていないようだな！」", "Battle/Dat/Battle/Message/157.bmd|0x002F0E": "「当たるものか！」", "Battle/Dat/Battle/Message/157.bmd|0x002F2A": "「魔装機神と言えど、動きをよく見れば！」", "Battle/Dat/Battle/Message/157.bmd|0x002F67": "「よし、回避成功！」", "Battle/Dat/Battle/Message/157.bmd|0x002F86": "「ふっ、予測通りだ」", "Battle/Dat/Battle/Message/157.bmd|0x002FA5": "「やはり、そう来たか」", "Battle/Dat/Battle/Message/157.bmd|0x002FC7": "「無駄だっ！」", "Battle/Dat/Battle/Message/157.bmd|0x002FDD": "「効くものか！」", "Battle/Dat/Battle/Message/157.bmd|0x002FF6": "「そんなもの！」", "Battle/Dat/Battle/Message/157.bmd|0x00300F": "「………」", "Battle/Dat/Battle/Message/157.bmd|0x00301F": "「反撃できんとは！」", "Battle/Dat/Battle/Message/157.bmd|0x00303E": "「くっ、これでは！」", "Battle/Dat/Battle/Message/157.bmd|0x00305D": "「手出し出来んとは……！」", "Battle/Dat/Battle/Message/157.bmd|0x003085": "「残弾の確認を怠ったか！」", "Battle/Dat/Battle/Message/157.bmd|0x0030AD": "「ロストしたか……！」", "Battle/Dat/Battle/Message/157.bmd|0x0030CF": "「奴め、どこへ消えた！？」", "Battle/Dat/Battle/Message/157.bmd|0x0030F7": "「ちっ、見失ったか！」", "Battle/Dat/Battle/Message/157.bmd|0x003119": "「くっ、この間合いでは！」", "Battle/Dat/Battle/Message/157.bmd|0x003141": "「援護に入る！」", "Battle/Dat/Battle/Message/157.bmd|0x00315A": "「後は任せておけっ！」", "Battle/Dat/Battle/Message/157.bmd|0x00317C": "「将軍、援護します！」", "Battle/Dat/Battle/Message/157.bmd|0x00319E": "「もう一撃！」", "Battle/Dat/Battle/Message/157.bmd|0x0031B4": "「こちらで引き受ける！」", "Battle/Dat/Battle/Message/157.bmd|0x0031D9": "「やらせるものか！」", "Battle/Dat/Battle/Message/157.bmd|0x0031F8": "「将軍、ここは自分が！」", "Battle/Dat/Battle/Message/157.bmd|0x00321D": "「体勢を崩したな！」", "Battle/Dat/Battle/Message/157.bmd|0x00323C": "「隙あり！」", "Battle/Dat/Battle/Message/157.bmd|0x00324F": "「こいつで！」", "Battle/Dat/Battle/Message/157.bmd|0x003265": "「くらえっ！」", "Battle/Dat/Battle/Message/157.bmd|0x00327B": "「もらう！」", "Battle/Dat/Battle/Message/157.bmd|0x00328E": "「受けろ！」", "Battle/Dat/Battle/Message/157.bmd|0x0032A1": "「やあっ！」", "Battle/Dat/Battle/Message/157.bmd|0x0032B4": "「むんっ！」", "Battle/Dat/Battle/Message/157.bmd|0x0032C7": "「はあっ！」", "Battle/Dat/Battle/Message/157.bmd|0x0032DA": "「たあっ！」", "Battle/Dat/Battle/Message/157.bmd|0x0032ED": "「そこだ！」", "Battle/Dat/Battle/Message/157.bmd|0x003300": "「当ててやる！」", "Battle/Dat/Battle/Message/157.bmd|0x003319": "「機銃座、撃ち方始め！」", "Battle/Dat/Battle/Message/157.bmd|0x00333E": "「対空機銃、撃て！」", "Battle/Dat/Battle/Message/157.bmd|0x00335D": "「高射砲、発射用意！　撃て！」", "Battle/Dat/Battle/Message/157.bmd|0x00338B": "「高射砲、１番、２番！　撃て！」", "Battle/Dat/Battle/Message/157.bmd|0x0033BC": "「前部全砲塔、発射用意！　撃て！」", "Battle/Dat/Battle/Message/157.bmd|0x0033F0": "「前部砲塔、一斉射撃！　撃て！」", "Battle/Dat/Battle/Message/157.bmd|0x003421": "「バリオン・ビーム砲、発射用意！」", "Battle/Dat/Battle/Message/157.bmd|0x003455": "「撃て！」", "Battle/Dat/Battle/Message/157.bmd|0x003465": "「主砲、発射用意！」", "Battle/Dat/Battle/Message/158.bmd|0x00231A": "「カークス将軍の大義のために！」", "Battle/Dat/Battle/Message/158.bmd|0x00234B": "「敵機の捕捉成功。状況を開始する！」", "Battle/Dat/Battle/Message/158.bmd|0x002382": "「照準セット。ターゲット、ロックオン！」", "Battle/Dat/Battle/Message/158.bmd|0x0023BF": "「やってみせる！」", "Battle/Dat/Battle/Message/158.bmd|0x0023DB": "「攻撃開始！」", "Battle/Dat/Battle/Message/158.bmd|0x0023F1": "「行くぞ、地上人！」", "Battle/Dat/Battle/Message/158.bmd|0x002410": "「覚悟してもらうぞ、地上人！」", "Battle/Dat/Battle/Message/158.bmd|0x00243E": "「地上人よ、いざ勝負！」", "Battle/Dat/Battle/Message/158.bmd|0x002463": "「サイバスター！/　ここから先には進ませんぞ！」", "Battle/Dat/Battle/Message/158.bmd|0x0024AA": "「怯むものか、魔装機神が相手でも！」", "Battle/Dat/Battle/Message/158.bmd|0x0024E1": "「魔装機神でも、隙はどこかにあるはずだ！」", "Battle/Dat/Battle/Message/158.bmd|0x002521": "「グランヴェール！　やらせるものか！」", "Battle/Dat/Battle/Message/158.bmd|0x00255B": "「ガッデスを食い止めてみせる！」", "Battle/Dat/Battle/Message/158.bmd|0x00258C": "「ザムジード……我らの敵になるのであれば！」", "Battle/Dat/Battle/Message/158.bmd|0x0025CF": "「やらせんっ！」", "Battle/Dat/Battle/Message/158.bmd|0x0025E8": "「反撃する！」", "Battle/Dat/Battle/Message/158.bmd|0x0025FE": "「次はこちらの番だ！」", "Battle/Dat/Battle/Message/158.bmd|0x002620": "「まだここからだ！」", "Battle/Dat/Battle/Message/158.bmd|0x00263F": "「うあああっ！！」", "Battle/Dat/Battle/Message/158.bmd|0x00265B": "「こ、ここまでか！」", "Battle/Dat/Battle/Message/158.bmd|0x00267A": "「し、しまった！！」", "Battle/Dat/Battle/Message/158.bmd|0x002699": "「な、何とかもたせてみせる！」", "Battle/Dat/Battle/Message/158.bmd|0x0026C7": "「こ、ここで退くわけにはいかん！」", "Battle/Dat/Battle/Message/158.bmd|0x0026FB": "「ううっ……！　大義を成すまでは！」", "Battle/Dat/Battle/Message/158.bmd|0x002732": "「ぬうっ！　我らにも意地がある！」", "Battle/Dat/Battle/Message/158.bmd|0x002766": "「ぐううっ！/　まだ決着がついたわけではない！」", "Battle/Dat/Battle/Message/158.bmd|0x0027AD": "「ち、地上人……その力があれば……！」", "Battle/Dat/Battle/Message/158.bmd|0x0027E7": "「ええい、地上人め！/　これ以上はやらせんぞ！」", "Battle/Dat/Battle/Message/158.bmd|0x00282E": "「サ、サイバスター……つ、強過ぎる！」", "Battle/Dat/Battle/Message/158.bmd|0x002868": "「うぐっ……やはり、魔装機神には……！」", "Battle/Dat/Battle/Message/158.bmd|0x0028A5": "「ぐっ！/　覚悟なくして、魔装機神には挑まん！！」", "Battle/Dat/Battle/Message/158.bmd|0x0028EF": "「こ、これが炎の魔装機神の力か！」", "Battle/Dat/Battle/Message/158.bmd|0x002923": "「ガッデス……/　せめて、足止めだけでも……！！」", "Battle/Dat/Battle/Message/158.bmd|0x00296D": "「ザムジード……何というパワーだ……！」", "Battle/Dat/Battle/Message/158.bmd|0x0029AA": "「くっ！　致命傷じゃない！」", "Battle/Dat/Battle/Message/158.bmd|0x0029D5": "「まともに当たったか……！」", "Battle/Dat/Battle/Message/158.bmd|0x002A00": "「これぐらいのダメージ、覚悟はしていた！」", "Battle/Dat/Battle/Message/158.bmd|0x002A40": "「や、やる！　さすがだな！」", "Battle/Dat/Battle/Message/158.bmd|0x002A6B": "「臆するものか！　まだ戦う！」", "Battle/Dat/Battle/Message/158.bmd|0x002A99": "「地上人め、まだ抵抗するか！」", "Battle/Dat/Battle/Message/158.bmd|0x002AC7": "「やるな、地上人！」", "Battle/Dat/Battle/Message/158.bmd|0x002AE6": "「サイバスター……何という速さだ！」", "Battle/Dat/Battle/Message/158.bmd|0x002B1D": "「くっ！　魔装機神……やはり、強い！」", "Battle/Dat/Battle/Message/158.bmd|0x002B57": "「これ以上、魔装機神を進ませるわけには！」", "Battle/Dat/Battle/Message/158.bmd|0x002B97": "「うぐっ！　グランヴェール、やはり強い！」", "Battle/Dat/Battle/Message/158.bmd|0x002BD7": "「ガ、ガッデス……さすがだな……！」", "Battle/Dat/Battle/Message/158.bmd|0x002C0E": "「くっ！　ザムジードを止められんのか！？」", "Battle/Dat/Battle/Message/158.bmd|0x002C4E": "「そんなもので我らを止められるものか！」", "Battle/Dat/Battle/Message/158.bmd|0x002C8B": "「甘く見てもらっては困る！」", "Battle/Dat/Battle/Message/158.bmd|0x002CB6": "「ふん！　何だ、それは？」", "Battle/Dat/Battle/Message/158.bmd|0x002CDE": "「この程度、気にする必要はない」", "Battle/Dat/Battle/Message/158.bmd|0x002D0F": "「思っていたほどのパワーではないな！」", "Battle/Dat/Battle/Message/158.bmd|0x002D49": "「甘いぞ、地上人！」", "Battle/Dat/Battle/Message/158.bmd|0x002D68": "「地上人よ、遠慮は無用だ！」", "Battle/Dat/Battle/Message/158.bmd|0x002D93": "「ぐっ！　サイバスターに食いつかれたか！」", "Battle/Dat/Battle/Message/158.bmd|0x002DD3": "「魔装機神の力がこの程度だとは思えんが……」", "Battle/Dat/Battle/Message/158.bmd|0x002E16": "「よし、魔装機神と渡り合えるぞ！」", "Battle/Dat/Battle/Message/158.bmd|0x002E4A": "「グランヴェール……そんなものなのか？」", "Battle/Dat/Battle/Message/158.bmd|0x002E87": "「ガッデス……手加減をしているのか？」", "Battle/Dat/Battle/Message/158.bmd|0x002EC1": "「ザムジードの力を/　使いこなせていないようだな！」", "Battle/Dat/Battle/Message/158.bmd|0x002F0E": "「当たるものか！」", "Battle/Dat/Battle/Message/158.bmd|0x002F2A": "「魔装機神と言えど、動きをよく見れば！」", "Battle/Dat/Battle/Message/158.bmd|0x002F67": "「よし、回避成功！」", "Battle/Dat/Battle/Message/158.bmd|0x002F86": "「ふっ、予測通りだ」"}