{"Battle/Dat/Battle/Message/029.bmd|0x00341D": "「あん？　何の真似だ、地上人？」", "Battle/Dat/Battle/Message/029.bmd|0x00344E": "「浅いぞ、地上人！」", "Battle/Dat/Battle/Message/029.bmd|0x00346D": "「ハッ、地上人を買い被り過ぎたか」", "Battle/Dat/Battle/Message/029.bmd|0x0034A1": "「がははは！/　サイバスターってのはこの程度かよ！」", "Battle/Dat/Battle/Message/029.bmd|0x0034EE": "「速さだけで勝負が決まるか！」", "Battle/Dat/Battle/Message/029.bmd|0x00351C": "「ああん？/　それで終わりかい、ガッデスさんよ」", "Battle/Dat/Battle/Message/029.bmd|0x003563": "「何だ、そりゃ。/　グランヴェールってのは、/　パワーが売りじゃなかったのかよ」", "Battle/Dat/Battle/Message/029.bmd|0x0035D8": "「はっ！　その得物は飾りか！」", "Battle/Dat/Battle/Message/029.bmd|0x003606": "「ふん、やはり見かけ倒しか」", "Battle/Dat/Battle/Message/029.bmd|0x003631": "「甘いわ！/　そんなもの、当たりはせん！」", "Battle/Dat/Battle/Message/029.bmd|0x00366F": "「遅いな！」", "Battle/Dat/Battle/Message/029.bmd|0x003682": "「はっはっはっ！　どうした、どうした！」", "Battle/Dat/Battle/Message/029.bmd|0x0036BF": "「おおっと！」", "Battle/Dat/Battle/Message/029.bmd|0x0036D5": "「教科書通りの攻撃か。素直過ぎるな！」", "Battle/Dat/Battle/Message/029.bmd|0x00370F": "「当たりはせんわ！」", "Battle/Dat/Battle/Message/029.bmd|0x00372E": "「子供と遊んでいる暇はない！」", "Battle/Dat/Battle/Message/029.bmd|0x00375C": "「動きはいいが、狙いが雑だ！」", "Battle/Dat/Battle/Message/029.bmd|0x00378A": "「いくらグランゾンでも、/　当てることが出来ねば！」", "Battle/Dat/Battle/Message/029.bmd|0x0037D7": "「甘いぞ、サフィーネ！」", "Battle/Dat/Battle/Message/029.bmd|0x0037FC": "「ふん、サイバスターの名が泣くぞ！」", "Battle/Dat/Battle/Message/029.bmd|0x003833": "「ガッデス、噂ほどではないな！」", "Battle/Dat/Battle/Message/029.bmd|0x003864": "「グランヴェールといえど、当たらねばな！」", "Battle/Dat/Battle/Message/029.bmd|0x0038A4": "「下手くそめが。どこを狙っとるか！」", "Battle/Dat/Battle/Message/029.bmd|0x0038DB": "「残念だったな、地上人！」", "Battle/Dat/Battle/Message/029.bmd|0x003903": "「ふん、そう来ると思っとったわい！」", "Battle/Dat/Battle/Message/029.bmd|0x00393A": "「………」", "Battle/Dat/Battle/Message/029.bmd|0x00394A": "「くそっ！/　弾切れとは、ついておらん！」", "Battle/Dat/Battle/Message/029.bmd|0x003988": "「ええい！/　届かんとはどういうことだ！」", "Battle/Dat/Battle/Message/029.bmd|0x0039C6": "「ちっ、油断したか」", "Battle/Dat/Battle/Message/029.bmd|0x0039E5": "「おら、もう一回行くぜ！」", "Battle/Dat/Battle/Message/029.bmd|0x003A0D": "「おらっ！」", "Battle/Dat/Battle/Message/029.bmd|0x003A20": "「邪魔だ、どきやがれっ！」", "Battle/Dat/Battle/Message/029.bmd|0x003A48": "「でゃっ！」", "Battle/Dat/Battle/Message/029.bmd|0x003A5B": "「だぁっ！」", "Battle/Dat/Battle/Message/029.bmd|0x003A6E": "「どりゃっ！」", "Battle/Dat/Battle/Message/029.bmd|0x003A84": "「でぃっ！」", "Battle/Dat/Battle/Message/029.bmd|0x003A97": "「こいつで今度こそ、今度こそ終わりだ！」", "Battle/Dat/Battle/Message/029.bmd|0x003AD4": "「落ちてしまえ！」", "Battle/Dat/Battle/Message/030.bmd|0x000F91": "「このまま黙って見過ごすことは出来ない！」", "Battle/Dat/Battle/Message/030.bmd|0x000FD1": "「目標を捕捉した。これより攻撃を開始する！」", "Battle/Dat/Battle/Message/030.bmd|0x001014": "「覚悟はいいな、地上人！」", "Battle/Dat/Battle/Message/030.bmd|0x00103C": "「無駄な抵抗はやめろ、地上人！」", "Battle/Dat/Battle/Message/030.bmd|0x00106D": "「行きます、マサキ殿！」", "Battle/Dat/Battle/Message/030.bmd|0x001092": "「テュッティ殿、お覚悟を！」", "Battle/Dat/Battle/Message/030.bmd|0x0010BD": "「こんなことで争ってる場合では/　ないというのに……！」", "Battle/Dat/Battle/Message/030.bmd|0x001110": "「カークス将軍にこそ大義がある。/　いたずらに抵抗を重ねるな！」", "Battle/Dat/Battle/Message/030.bmd|0x00116F": "「これでは内乱と同じだ……/　こんな戦い、一刻も早く終わらさねば！」", "Battle/Dat/Battle/Message/030.bmd|0x0011D4": "「本来なら、味方同士のはずなのに……/　どうしてこんなことに！」", "Battle/Dat/Battle/Message/030.bmd|0x001233": "「カークス将軍にも、フェイルロード殿下にも大義はある。/　しかし……！」", "Battle/Dat/Battle/Message/030.bmd|0x00129E": "「これ以上、我が国を好きにはさせない！/　覚悟しろ、賊共！」", "Battle/Dat/Battle/Message/030.bmd|0x0012F7": "「次はこちらの番だ！」", "Battle/Dat/Battle/Message/030.bmd|0x001319": "「反撃する！」", "Battle/Dat/Battle/Message/030.bmd|0x00132F": "「好きにはやらせないっ！」", "Battle/Dat/Battle/Message/030.bmd|0x001357": "「ただでは帰さない！」", "Battle/Dat/Battle/Message/030.bmd|0x001379": "「やってみせる！」", "Battle/Dat/Battle/Message/030.bmd|0x001395": "「今度はこちらから行きます！」", "Battle/Dat/Battle/Message/030.bmd|0x0013C3": "「しまった！　やられたっ！」", "Battle/Dat/Battle/Message/030.bmd|0x0013EE": "「くっ……ここまでか……！」", "Battle/Dat/Battle/Message/030.bmd|0x001419": "「こ、これ以上は危険ね……！」", "Battle/Dat/Battle/Message/030.bmd|0x001447": "「あうっ！　こ、こうも一方的に！」", "Battle/Dat/Battle/Message/030.bmd|0x00147B": "「ううっ！　シールドが３０％以下に……！！」", "Battle/Dat/Battle/Message/030.bmd|0x0014BE": "「パ、パワーの差があり過ぎる！」", "Battle/Dat/Battle/Message/030.bmd|0x0014EF": "「ううっ……限界が近い……！」", "Battle/Dat/Battle/Message/030.bmd|0x00151D": "「こ、これがサイバスターのパワー……！」", "Battle/Dat/Battle/Message/030.bmd|0x00155A": "「ううっ、魔装機神には敵わない……！」", "Battle/Dat/Battle/Message/030.bmd|0x001594": "「ガ、ガッデスと距離を取らなければ！」", "Battle/Dat/Battle/Message/030.bmd|0x0015CE": "「まともに当たった！？　しかし、まだ！」", "Battle/Dat/Battle/Message/030.bmd|0x00160B": "「この程度で落ちはしない！」", "Battle/Dat/Battle/Message/030.bmd|0x001636": "「まだだ！　まだいける！」", "Battle/Dat/Battle/Message/030.bmd|0x00165E": "「思ったよりやるわね。けど、まだ戦える！」", "Battle/Dat/Battle/Message/030.bmd|0x00169E": "「くっ、こうも好き勝手やられるなんて！」", "Battle/Dat/Battle/Message/030.bmd|0x0016DB": "「ううっ、サイバスター相手では……！」", "Battle/Dat/Battle/Message/030.bmd|0x001715": "「ま、魔装機神を甘く見たつもりはないが……！」", "Battle/Dat/Battle/Message/030.bmd|0x00175B": "「くっ！　やはり、ガッデスには……！」", "Battle/Dat/Battle/Message/030.bmd|0x001795": "「こんなもの、当たっただけ！」", "Battle/Dat/Battle/Message/030.bmd|0x0017C3": "「ダメージ軽微、各部異常なし！」", "Battle/Dat/Battle/Message/030.bmd|0x0017F4": "「効きはしないっ！」", "Battle/Dat/Battle/Message/030.bmd|0x001813": "「かすっただけだ！」", "Battle/Dat/Battle/Message/030.bmd|0x001832": "「かわせなかったとは……！」", "Battle/Dat/Battle/Message/030.bmd|0x00185D": "「サイバスター……さすがに速い……！」", "Battle/Dat/Battle/Message/030.bmd|0x001897": "「魔装機神……思っていたほどでは……！」", "Battle/Dat/Battle/Message/030.bmd|0x0018D4": "「テュッティ殿、もしや手加減を……！？」", "Battle/Dat/Battle/Message/030.bmd|0x001911": "「当たりはしない！」", "Battle/Dat/Battle/Message/030.bmd|0x001930": "「どこを狙っている！」", "Battle/Dat/Battle/Message/030.bmd|0x001952": "「そう簡単に当たるものか！」", "Battle/Dat/Battle/Message/030.bmd|0x00197D": "「遅いっ！」", "Battle/Dat/Battle/Message/030.bmd|0x001990": "「当たりはしません！」", "Battle/Dat/Battle/Message/030.bmd|0x0019B2": "「回避成功！」", "Battle/Dat/Battle/Message/030.bmd|0x0019C8": "「………」", "Battle/Dat/Battle/Message/030.bmd|0x0019D8": "「くっ、使える武器がない！」", "Battle/Dat/Battle/Message/030.bmd|0x001A03": "「このままでは的になるだけか！」", "Battle/Dat/Battle/Message/030.bmd|0x001A34": "「敵機を見失うとは！」", "Battle/Dat/Battle/Message/030.bmd|0x001A56": "「くっ、どこへ行った！？」", "Battle/Dat/Battle/Message/030.bmd|0x001A7E": "「油断したな！」", "Battle/Dat/Battle/Message/030.bmd|0x001A97": "「追い打ちをかける！」", "Battle/Dat/Battle/Message/030.bmd|0x001AB9": "「アクロス少佐、援護します！」", "Battle/Dat/Battle/Message/030.bmd|0x001AE7": "「ここは私が！」", "Battle/Dat/Battle/Message/030.bmd|0x001B00": "「私が盾になる！」", "Battle/Dat/Battle/Message/030.bmd|0x001B1C": "「アクロス少佐をやらせるものか！」", "Battle/Dat/Battle/Message/030.bmd|0x001B50": "「この私に隙を見せるなんてね！」", "Battle/Dat/Battle/Message/030.bmd|0x001B81": "「安心するのはまだ早い！」", "Battle/Dat/Battle/Message/030.bmd|0x001BA9": "「もう一撃、受けてもらいます！」", "Battle/Dat/Battle/Message/030.bmd|0x001BDA": "「当ててみせる！」", "Battle/Dat/Battle/Message/030.bmd|0x001BF6": "「落ちなさいっ！」", "Battle/Dat/Battle/Message/030.bmd|0x001C12": "「これなら！」", "Battle/Dat/Battle/Message/030.bmd|0x001C28": "「行けっ！」", "Battle/Dat/Battle/Message/030.bmd|0x001C3B": "「この距離なら！」", "Battle/Dat/Battle/Message/030.bmd|0x001C57": "「そこっ！」", "Battle/Dat/Battle/Message/030.bmd|0x001C6A": "「逃がしはしない！」", "Battle/Dat/Battle/Message/030.bmd|0x001C89": "「やあっ！」", "Battle/Dat/Battle/Message/030.bmd|0x001C9C": "「とうっ！」", "Battle/Dat/Battle/Message/031.bmd|0x0011E1": "「私にも意地があるからな……/　そう簡単に終わらせはしないよ！」", "Battle/Dat/Battle/Message/031.bmd|0x001240": "「あまり気は進まんが……/　戦うとなった以上、躊躇はしない！」", "Battle/Dat/Battle/Message/031.bmd|0x00129C": "「攻撃目標確認！」", "Battle/Dat/Battle/Message/031.bmd|0x0012B8": "「マサキ殿、お覚悟を！」", "Battle/Dat/Battle/Message/031.bmd|0x0012DD": "「お覚悟を、テュッティ殿！」", "Battle/Dat/Battle/Message/031.bmd|0x001308": "「悪いな、地上人。落とさせてもらうぞ！」", "Battle/Dat/Battle/Message/031.bmd|0x001345": "「行くぞ、地上人！」", "Battle/Dat/Battle/Message/031.bmd|0x001364": "「おっと、ただでは帰さないぞ。悪いな」", "Battle/Dat/Battle/Message/031.bmd|0x00139E": "「反撃開始だ！」"}