{"Battle/Dat/Battle/Message/043.bmd|0x006740": "「いけっ！　ファング・スラッシャー！」", "Battle/Dat/Battle/Message/043.bmd|0x00677A": "「見える……逃がさない！」", "Battle/Dat/Battle/Message/043.bmd|0x0067A2": "「切り裂け！　ファング・スラッシャー！」", "Battle/Dat/Battle/Message/043.bmd|0x0067DF": "「念じるままに……！」", "Battle/Dat/Battle/Message/043.bmd|0x006801": "「飛べ！　ファング・スラッシャー！！」", "Battle/Dat/Battle/Message/043.bmd|0x00683B": "「ファング・スラッシャー、行けっ！」", "Battle/Dat/Battle/Message/043.bmd|0x006872": "「一斉発射……！　行けぇっ！」", "Battle/Dat/Battle/Message/043.bmd|0x0068A0": "「Ｇインパクト・キャノン、発射！」", "Battle/Dat/Battle/Message/043.bmd|0x0068D4": "「Ｔ‐ＬＩＮＫ、フルコンタクト！」", "Battle/Dat/Battle/Message/043.bmd|0x006908": "「ハイ・ツインランチャー、発射！」", "Battle/Dat/Battle/Message/043.bmd|0x00693C": "「ハイ・ツインランチャー、ファイア！！」", "Battle/Dat/Battle/Message/043.bmd|0x006979": "「ハイ・ツインランチャー、シュート！！」", "Battle/Dat/Battle/Message/043.bmd|0x0069B6": "「コールドメタルソード！」", "Battle/Dat/Battle/Message/043.bmd|0x0069DE": "「クラッシャー、セットアップ！」", "Battle/Dat/Battle/Message/043.bmd|0x006A0F": "「行くよ、ビルガー！」", "Battle/Dat/Battle/Message/043.bmd|0x006A31": "「ウイング展開……！」", "Battle/Dat/Battle/Message/043.bmd|0x006A53": "「ブースト！」", "Battle/Dat/Battle/Message/043.bmd|0x006A69": "「ビクティム・ビーク……」", "Battle/Dat/Battle/Message/043.bmd|0x006A91": "「とどめっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x006AAA": "「ミサイル、一斉発射！」", "Battle/Dat/Battle/Message/043.bmd|0x006ACF": "「狙いは外さない……！」", "Battle/Dat/Battle/Message/043.bmd|0x006AF4": "「ダブル・ファイア！」", "Battle/Dat/Battle/Message/043.bmd|0x006B16": "「ええいっ！」", "Battle/Dat/Battle/Message/043.bmd|0x006B2C": "「砕けっ！」", "Battle/Dat/Battle/Message/043.bmd|0x006B3F": "「１機も逃がさない！」", "Battle/Dat/Battle/Message/043.bmd|0x006B61": "「行くよ、ジガンスクード……！」", "Battle/Dat/Battle/Message/043.bmd|0x006B92": "「ジガンテ・ウンギア！」", "Battle/Dat/Battle/Message/043.bmd|0x006BB7": "「要領は同じだ……！」", "Battle/Dat/Battle/Message/043.bmd|0x006BD9": "「行け、ソードブレイカー！！」", "Battle/Dat/Battle/Message/043.bmd|0x006C07": "「ライフル、ダブル・ファイア！」", "Battle/Dat/Battle/Message/043.bmd|0x006C38": "「ツイン・マグナライフル、発射！」", "Battle/Dat/Battle