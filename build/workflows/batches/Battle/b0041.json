{"Battle/Dat/Battle/Message/036.bmd|0x0090F1": "「受け取れ！」", "Battle/Dat/Battle/Message/036.bmd|0x009107": "「こいつもな！」", "Battle/Dat/Battle/Message/036.bmd|0x009120": "「とどめを打つぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x00913F": "「了解！　せーの！！」", "Battle/Dat/Battle/Message/036.bmd|0x009161": "「これがおれ達の……」", "Battle/Dat/Battle/Message/036.bmd|0x009183": "「切り札……もとい、愛の打ち上げ花火よん」", "Battle/Dat/Battle/Message/036.bmd|0x0091C3": "「仕掛けるぞ、アリエイル」", "Battle/Dat/Battle/Message/036.bmd|0x0091EB": "「了解です、キョウスケ中尉。援護します」", "Battle/Dat/Battle/Message/036.bmd|0x009228": "「エターナリィ・ダーニング・ネイルズ……」", "Battle/Dat/Battle/Message/036.bmd|0x009268": "「コードＥ．Ｄ．Ｎ．、発動！」", "Battle/Dat/Battle/Message/036.bmd|0x009296": "「撃ち抜くっ！」", "Battle/Dat/Battle/Message/036.bmd|0x0092AF": "「こちらも！」", "Battle/Dat/Battle/Message/036.bmd|0x0092C5": "「追い詰めます！」", "Battle/Dat/Battle/Message/036.bmd|0x0092E1": "「ブースト！！」", "Battle/Dat/Battle/Message/036.bmd|0x0092FA": "「リボルビング・ステーク！」", "Battle/Dat/Battle/Message/036.bmd|0x009325": "「仕上げだ！」", "Battle/Dat/Battle/Message/036.bmd|0x00933B": "「了解！　フォース・レイ！」", "Battle/Dat/Battle/Message/036.bmd|0x009366": "「ターゲット、撃破」", "Battle/Dat/Battle/Message/036.bmd|0x009385": "「言わばアルト同士だ、合わせ易い」", "Battle/Dat/Battle/Message/036.bmd|0x0093B9": "「おれ達の爪は！」", "Battle/Dat/Battle/Message/036.bmd|0x0093D5": "「鋭いぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x0093E8": "「このタイミングなら！」", "Battle/Dat/Battle/Message/036.bmd|0x00940D": "「送ります！」", "Battle/Dat/Battle/Message/036.bmd|0x009423": "「貫くっ！」", "Battle/Dat/Battle/Message/036.bmd|0x009436": "「合わせろ、アリエイル！」", "Battle/Dat/Battle/Message/036.bmd|0x00945E": "「了解！　ステークでっ！！」", "Battle/Dat/Battle/Message/036.bmd|0x009489": "「とどめだ！　クレイモア！！」", "Battle/Dat/Battle/Message/036.bmd|0x0094B7": "「フォース・レイ、発射！」", "Battle/Dat/Battle/Message/036.bmd|0x0094DF": "「エクセレン少尉のようには/　いきませんでしたが……」", "Battle/Dat/Battle/Message/036.bmd|0x00952F": "「いや、いい連係だった」", "Battle/Dat/Battle/Message/036.bmd|0x009554": "「砲戦はあまり得意ではないんだが……」", "Battle/Dat/Battle/Message/036.bmd|0x00958E": "「狙わせてもらう……！」", "Battle/Dat/Battle/Message/036.bmd|0x0095B3": "「射撃は苦手なんだが……」", "Battle/Dat/Battle/Message/036.bmd|0x0095DB": "「既に狙いがついているのでな……！」", "Battle/Dat/Battle/Message/036.bmd|0x009612": "「撃ち抜く！」", "Battle/Dat/Battle/Message/036.bmd|0x009628": "「飛び込ませてもらう！」", "Battle/Dat/Battle/Message/036.bmd|0x00964D": "「止められるなら……止めてみろっ！」", "Battle/Dat/Battle/Message/036.bmd|0x009684": "「正面からぶつけさせてもらう！」", "Battle/Dat/Battle/Message/036.bmd|0x0096B5": "「伊達や酔狂で/　こんな頭をしているわけではないぞ……！」", "Battle/Dat/Battle/Message/036.bmd|0x00970B": "「ブースト！　あとはぶつけるのみ……！」", "Battle/Dat/Battle/Message/036.bmd|0x009748": "「これだけのベアリング弾…」", "Battle/Dat/Battle/Message/036.bmd|0x009773": "「かわせるかっ！」", "Battle/Dat/Battle/Message/036.bmd|0x00978F": "「クレイモア…！」", "Battle/Dat/Battle/Message/036.bmd|0x0097AB": "「抜けられると思うなよ…！」", "Battle/Dat/Battle/Message/036.bmd|0x0097D6": "「一発一発がチタン製の特注品だ…！」", "Battle/Dat/Battle/Message/036.bmd|0x00980D": "「受け取れ…！」", "Battle/Dat/Battle/Message/036.bmd|0x009826": "「この距離でクレイモア…！」", "Battle/Dat/Battle/Message/036.bmd|0x009851": "「もらったぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x00986A": "「無駄に火薬ばかり多くてな」", "Battle/Dat/Battle/Message/036.bmd|0x009895": "「威力は受けて確かめろ！」", "Battle/Dat/Battle/Message/036.bmd|0x0098BD": "「チャクラム・シューターで勝負……！」", "Battle/Dat/Battle/Message/036.bmd|0x0098F7": "「なます斬りになってもらう……！」", "Battle/Dat/Battle/Message/036.bmd|0x00992B": "「もらう……！　こちらの牙は鋭いぞ……！」", "Battle/Dat/Battle/Message/036.bmd|0x00996B": "「切り裂け……！」", "Battle/Dat/Battle/Message/036.bmd|0x009987": "「当たれよ……！」", "Battle/Dat/Battle/Message/036.bmd|0x0099A3": "「Ｇインパクト・キャノン、発射する！」", "Battle/Dat/Battle/Message/036.bmd|0x0099DD": "「これがこちらの手札だ……！」", "Battle/Dat/Battle/Message/036.bmd|0x009A0B": "「もらう……！　こちらの翼は斬れるぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x009A48": "「体当たりは得意でな……！」", "Battle/Dat/Battle/Message/036.bmd|0x009A73": "「そこか……！　ブーストナックル！」", "Battle/Dat/Battle/Message/036.bmd|0x009AAA": "「この拳で決める……！」", "Battle/Dat/Battle/Message/036.bmd|0x009ACF": "「最大出力……！/　グルンガスト、やってみせろ！」", "Battle/Dat/Battle/Message/036.bmd|0x009B19": "「剣も使い勝手は悪くない……！」", "Battle/Dat/Battle/Message/036.bmd|0x009B4A": "「角ばかりだと思うなよ！」", "Battle/Dat/Battle/Message/036.bmd|0x009B72": "「語呂は悪いが……」", "Battle/Dat/Battle/Message/036.bmd|0x009B91": "「博士の趣味はわからんが……」", "Battle/Dat/Battle/Message/036.bmd|0x009BBF": "「どんな装甲でも……」", "Battle/Dat/Battle/Message/036.bmd|0x009BE1": "「挟み潰すのみ！」", "Battle/Dat/Battle/Message/036.bmd|0x009BFD": "「伊達や酔狂で/　この鋏をつけているわけではないぞ……！」", "Battle/Dat/Battle/Message/036.bmd|0x009C53": "「この攻撃に賭けさせてもらうぞ……！」", "Battle/Dat/Battle/Message/036.bmd|0x009C8D": "「チップは払った……もう後戻りはできん」", "Battle/Dat/Battle/Message/036.bmd|0x009CCA": "「ビルガー、やってみせろ……！」", "Battle/Dat/Battle/Message/036.bmd|0x009CFB": "「『生贄』になるかどうかは……」", "Battle/Dat/Battle/Message/036.bmd|0x009D2C": "「お前次第だ！」", "Battle/Dat/Battle/Message/036.bmd|0x009D45": "「このような装備もあるんでな……！」", "Battle/Dat/Battle/Message/036.bmd|0x009D7C": "「Ｅモードにセット。/　……なんとか当ててみせる……！」", "Battle/Dat/Battle/Message/036.bmd|0x009DCF": "「遠くからの攻撃は性に合わんが……/　仕方あるまい……！」", "Battle/Dat/Battle/Message/036.bmd|0x009E25": "「Ｂモードにセット。/　……なんとか当ててみせる……！」", "Battle/Dat/Battle/Message/036.bmd|0x009E78": "「これも実弾だ。/　……とはいえ、同じとは言えんか」", "Battle/Dat/Battle/Message/036.bmd|0x009EC5": "「ファルケン、頼むぞ……！」", "Battle/Dat/Battle/Message/036.bmd|0x009EF0": "「オクスタン・ライフルをＷモードに。/　……いけえっ！」", "Battle/Dat/Battle/Message/036.bmd|0x009F43": "「ヴァイスの後継機なら、やってみせろ……！」", "Battle/Dat/Battle/Message/036.bmd|0x009F86": "「当たりさえすれば……ただでは済まんぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x009FC6": "「殴り合いなら……ひけはとらんぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x009FFD": "「懐に入った……！　いけえっ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A02E": "「悪いが、この距離なら慣れている……！」", "Battle/Dat/Battle/Message/036.bmd|0x00A06B": "「まとめて面倒を見る……！/　ジガン、頼むぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A0B2": "「悪いが、ぶつかるのは得意でな……！」", "Battle/Dat/Battle/Message/036.bmd|0x00A0EC": "「格闘戦なら、ひけはとらんぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A11D": "「止められると思うな！」", "Battle/Dat/Battle/Message/036.bmd|0x00A142": "「こういう武器も得意ではないんだがな」", "Battle/Dat/Battle/Message/036.bmd|0x00A17C": "「それでも威力は保証付きだ……！」", "Battle/Dat/Battle/Message/036.bmd|0x00A1B0": "「一発でも多く当たれば……それでいい！」", "Battle/Dat/Battle/Message/036.bmd|0x00A1ED": "「これで切り裂く……！」", "Battle/Dat/Battle/Message/036.bmd|0x00A212": "「そこだ……！　スラッシュ・リッパー！」", "Battle/Dat/Battle/Message/036.bmd|0x00A24F": "「原始的な武器の方が/　性にあっているんでな……！」", "Battle/Dat/Battle/Message/036.bmd|0x00A29C": "「この鉄塊……受け取れ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A2C4": "「かわせるか？　獅子王の刃を！」", "Battle/Dat/Battle/Message/036.bmd|0x00A2F5": "「ブレード！　いけえっ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A31D": "「とったぞ！！」", "Battle/Dat/Battle/Message/036.bmd|0x00A336": "「射撃は苦手なんだがな。/　……四の五の言っていられんか」", "Battle/Dat/Battle/Message/036.bmd|0x00A38C": "「その隙は逃さん……！」", "Battle/Dat/Battle/Message/036.bmd|0x00A3B1": "「多少古くさい武装だが、威力は関係ない！」", "Battle/Dat/Battle/Message/036.bmd|0x00A3F1": "「前より大口径だ……/　威力は受けて確かめろ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A438": "「どんな装甲だろうと！」", "Battle/Dat/Battle/Message/036.bmd|0x00A45D": "「撃ち貫くのみ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A479": "「行けぇっ！！」", "Battle/Dat/Battle/Message/036.bmd|0x00A492": "「止められるなら！」", "Battle/Dat/Battle/Message/036.bmd|0x00A4B1": "「止めてみろっ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A4CD": "「零距離、とったぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A4EF": "「おれもジョーカーを切らせてもらう！」", "Battle/Dat/Battle/Message/036.bmd|0x00A529": "「抜けられると思うなよ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A551": "「ここだ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A564": "「これで抜けない装甲はないぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A595": "「全弾持っていけぇっ！！」", "Battle/Dat/Battle/Message/036.bmd|0x00A5BD": "「撃ち抜く！！」", "Battle/Dat/Battle/Message/036.bmd|0x00A5D6": "「これがおれのジョーカーだ」", "Battle/Dat/Battle/Message/036.bmd|0x00A601": "「まだだっ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A617": "「受け取れっ！」", "Battle/Dat/Battle/Message/036.bmd|0x00A630": "「バンカー！　撃ち抜くっ！！」"}