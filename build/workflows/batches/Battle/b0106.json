{"Battle/Dat/Battle/Message/058.bmd|0x00903B": "「切り裂けぃ！」", "Battle/Dat/Battle/Message/058.bmd|0x009054": "「奴を追い詰めろ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009076": "「Ｇインパクト・キャノン！　発射！！」", "Battle/Dat/Battle/Message/058.bmd|0x0090B0": "「くらえ！　スパイラル・アタック！！」", "Battle/Dat/Battle/Message/058.bmd|0x0090EA": "「アイソリッド・レーザー！」", "Battle/Dat/Battle/Message/058.bmd|0x009115": "「俺の鉄拳をくらえい！！」", "Battle/Dat/Battle/Message/058.bmd|0x00913D": "「ドリル・ブーストナックル！！」", "Battle/Dat/Battle/Message/058.bmd|0x00916E": "「オメガ・ブラスター、発射！」", "Battle/Dat/Battle/Message/058.bmd|0x00919C": "「どりゃあっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x0091B8": "「クラッシャー、セット！」", "Battle/Dat/Battle/Message/058.bmd|0x0091E0": "「追い詰める！！」", "Battle/Dat/Battle/Message/058.bmd|0x0091FC": "「ぬおおおお！！」", "Battle/Dat/Battle/Message/058.bmd|0x009218": "「砕けろ！！」", "Battle/Dat/Battle/Message/058.bmd|0x00922E": "「余計な装甲は必要ない！」", "Battle/Dat/Battle/Message/058.bmd|0x009256": "「行くぞ！！」", "Battle/Dat/Battle/Message/058.bmd|0x00926C": "「とどめっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009285": "「真っ向勝負！」", "Battle/Dat/Battle/Message/058.bmd|0x00929E": "「でえええい！！」", "Battle/Dat/Battle/Message/058.bmd|0x0092BA": "「ギガ・ワイドブラスター！！」", "Battle/Dat/Battle/Message/058.bmd|0x0092E8": "「マキシマム・モード！/　ワイドブラスター！！」", "Battle/Dat/Battle/Message/058.bmd|0x00932F": "「ジガンスクード！　全てを焼き尽くせ！！」", "Battle/Dat/Battle/Message/058.bmd|0x00936F": "「ギガ・サークルブラスター！！」", "Battle/Dat/Battle/Message/058.bmd|0x0093A0": "「ジガンスクード、最大出力！」", "Battle/Dat/Battle/Message/058.bmd|0x0093CE": "「ドゥロのパワー、その身で受けとめろ！！」", "Battle/Dat/Battle/Message/058.bmd|0x00940E": "「ジガンテ・ウンギア！　砕けいっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009448": "「行け！」", "Battle/Dat/Battle/Message/058.bmd|0x009458": "「スラッシュ・リッパー！！」", "Battle/Dat/Battle/Message/058.bmd|0x009483": "「スラッシュ・リッパー、セット！」", "Battle/Dat/Battle/Message/058.bmd|0x0094B7": "「自動追尾モード、オン！」", "Battle/Dat/Battle/Message/058.bmd|0x0094DF": "「スラッシュ・リッパー、発射！」", "Battle/Dat/Battle/Message/058.bmd|0x009510": "「リッパー、ロック解除！」", "Battle/Dat/Battle/Message/058.bmd|0x009538": "「ふっ、俺向きの武器だな」", "Battle/Dat/Battle/Message/058.bmd|0x009560": "「ステークをくらえい！」", "Battle/Dat/Battle/Message/058.bmd|0x009585": "「貴様を貫いてやる！」", "Battle/Dat/Battle/Message/058.bmd|0x0095A7": "「ブーストハンマー！　砕け散れい！」", "Battle/Dat/Battle/Message/058.bmd|0x0095DE": "「しかとその身で受けとめろ！！」", "Battle/Dat/Battle/Message/058.bmd|0x00960F": "「こいつの斬れ味を見せてやる！」", "Battle/Dat/Battle/Message/058.bmd|0x009640": "「でええええい！」", "Battle/Dat/Battle/Message/058.bmd|0x00965C": "「斬！！」", "Battle/Dat/Battle/Message/058.bmd|0x00966C": "「ふっ、さすがの業物だ」", "Battle/Dat/Battle/Message/058.bmd|0x009691": "「間合いを詰めねば、話にならんのでな！」", "Battle/Dat/Battle/Message/058.bmd|0x0096CE": "「リボルビング・バンカー！」", "Battle/Dat/Battle/Message/058.bmd|0x0096F9": "「撃ち抜く！！」", "Battle/Dat/Battle/Message/058.bmd|0x009712": "「この連続攻撃は止められんぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x009743": "「まずはクレイモアだ！」", "Battle/Dat/Battle/Message/058.bmd|0x009768": "「でえいっ！」", "Battle/Dat/Battle/Message/058.bmd|0x00977E": "「チェーンガン！」", "Battle/Dat/Battle/Message/058.bmd|0x00979A": "「バンカー！　全弾叩き込む！！」", "Battle/Dat/Battle/Message/058.bmd|0x0097CB": "「ふっ、なかなかいい得物だ」", "Battle/Dat/Battle/Message/058.bmd|0x0097F6": "「ブレード・トンファー！」", "Battle/Dat/Battle/Message/058.bmd|0x00981E": "「ブレード・サイ、アクティブ！」", "Battle/Dat/Battle/Message/058.bmd|0x00984F": "「いい得物だ！」", "Battle/Dat/Battle/Message/058.bmd|0x009868": "「うおおおおっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009887": "「とどめだ！！」", "Battle/Dat/Battle/Message/058.bmd|0x0098A0": "「行くぞ！　モード・チェンジ！」", "Battle/Dat/Battle/Message/058.bmd|0x0098D1": "「持てる弾を撃ち尽くしてでも！」", "Battle/Dat/Battle/Message/058.bmd|0x009902": "「この距離なら、/　ショートレンジ・モードで！」", "Battle/Dat/Battle/Message/058.bmd|0x009949": "「間近の敵にも対応できるのでな！」", "Battle/Dat/Battle/Message/058.bmd|0x00997D": "「２Ｗキャノン！　行けい！」", "Battle/Dat/Battle/Message/058.bmd|0x0099A8": "「このレンジなら、こいつで！」", "Battle/Dat/Battle/Message/058.bmd|0x0099D6": "「俺の拳を止められると思うな！」", "Battle/Dat/Battle/Message/058.bmd|0x009A07": "「拳一つで戦えるとは言わん！」", "Battle/Dat/Battle/Message/058.bmd|0x009A35": "「プラズマ・バックラー、セット！」", "Battle/Dat/Battle/Message/058.bmd|0x009A69": "「ジェット・マグナム！！」", "Battle/Dat/Battle/Message/058.bmd|0x009A91": "「だが、拳一つを甘く見るなよ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009AC5": "「ジェット・マグナァァァムッ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009AF9": "「続けてスプリットミサイル！」", "Battle/Dat/Battle/Message/058.bmd|0x009B27": "「ここまでは牽制だ！」", "Battle/Dat/Battle/Message/058.bmd|0x009B49": "「２Ｗキャノン、ロングレンジ・モード！」", "Battle/Dat/Battle/Message/058.bmd|0x009B86": "「くらえいっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009BA2": "「バレル展開！　ロックオン！」", "Battle/Dat/Battle/Message/058.bmd|0x009BD0": "「吹き飛べぇぇっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009BF2": "「これが本命！　ロングレンジ・モード！」", "Battle/Dat/Battle/Message/058.bmd|0x009C2F": "「撃ち抜けいっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009C4E": "「ＰＴは伊達に/　人の姿をしているわけではない！」", "Battle/Dat/Battle/Message/058.bmd|0x009C98": "「ダブル・プラズマ・バックラー、セット！」", "Battle/Dat/Battle/Message/058.bmd|0x009CD8": "「その有用性と可能性を教えてやる！！」", "Battle/Dat/Battle/Message/058.bmd|0x009D12": "「おりゃあ！」", "Battle/Dat/Battle/Message/058.bmd|0x009D28": "「くらえ！　ジェット・マグナムッ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009D62": "「俺の拳は止まらんぞ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009D8A": "「プラズマ・ステーク、アクティブ！」", "Battle/Dat/Battle/Message/058.bmd|0x009DC1": "「タイプＧならではの連撃だ！」", "Battle/Dat/Battle/Message/058.bmd|0x009DEF": "「メガ・ブラスターキャノン！」", "Battle/Dat/Battle/Message/058.bmd|0x009E1D": "「メガ・ブラスターキャノン！　くらえい！」", "Battle/Dat/Battle/Message/058.bmd|0x009E5D": "「合計８本のプラズマステークだ！」", "Battle/Dat/Battle/Message/058.bmd|0x009E91": "「オール・プラズマステーク、アクティブ！」", "Battle/Dat/Battle/Message/058.bmd|0x009ED1": "「剛を制するのは、速・流・撃だ！」", "Battle/Dat/Battle/Message/058.bmd|0x009F05": "「そう簡単には止まらんぞ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009F33": "「まだまだぁっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009F52": "「ジェット！　ファントォォォム！！」", "Battle/Dat/Battle/Message/058.bmd|0x009F89": "「ぬおおおおっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x009FA8": "「極めるぞ！」", "Battle/Dat/Battle/Message/058.bmd|0x009FBE": "「ジェット・ファントォォム！！」", "Battle/Dat/Battle/Message/058.bmd|0x009FEF": "「まずは速さで相手の気勢をくじくっ！」", "Battle/Dat/Battle/Message/058.bmd|0x00A029": "「そして、反動をも流れに組み込むっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x00A066": "「最後は！」", "Battle/Dat/Battle/Message/058.bmd|0x00A079": "「一撃で極める！！」", "Battle/Dat/Battle/Message/058.bmd|0x00A098": "「ツイン・ビームカノン！　行けいっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x00A0D5": "「こいつの火力を侮るなよ！」", "Battle/Dat/Battle/Message/058.bmd|0x00A100": "「ダーク・ロック！」", "Battle/Dat/Battle/Message/058.bmd|0x00A11F": "「こいつも！」", "Battle/Dat/Battle/Message/058.bmd|0x00A135": "「ハイパー・ブーストナックル！」", "Battle/Dat/Battle/Message/058.bmd|0x00A166": "「貫けいっ！！」", "Battle/Dat/Battle/Message/058.bmd|0x00A17F": "「ビーム・キャノン、アクティブ！」", "Battle/Dat/Battle/Message/058.bmd|0x00A1B3": "「アルティメット・ビーム！！」", "Battle/Dat/Battle/Message/058.bmd|0x00A1E1": "「見るがいい、超闘士の必殺剣を！」", "Battle/Dat/Battle/Message/058.bmd|0x00A215": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/058.bmd|0x00A230": "「暗剣殺！！」", "Battle/Dat/Battle/Message/058.bmd|0x00A246": "「さすがの斬れ味だったな」", "Battle/Dat/Battle/Message/058.bmd|0x00A26E": "「壱式、ファイナルモード！」", "Battle/Dat/Battle/Message/058.bmd|0x00A299": "「五！」", "Battle/Dat/Battle/Message/058.bmd|0x00A2A6": "「黄！」", "Battle/Dat/Battle/Message/058.bmd|0x00A2B3": "「殺！！」", "Battle/Dat/Battle/Message/058.bmd|0x00A2C3": "「この剛剣を止める術はない」", "Battle/Dat/Battle/Message/058.bmd|0x00A2EE": "「ツイン・ビームキャノン、発射！」", "Battle/Dat/Battle/Message/058.bmd|0x00A322": "「スパイラル・ブレイカー！」", "Battle/Dat/Battle/Message/058.bmd|0x00A34D": "「オメガ・キャノン、発射！」", "Battle/Dat/Battle/Message/058.bmd|0x00A378": "「ドリル・アタック！！」", "Battle/Dat/Battle/Message/058.bmd|0x00A39D": "「全ての火器を叩き込む！」", "Battle/Dat/Battle/Message/058.bmd|0x00A3C5": "「見るがいい、/　ラプターとバイソンのコンビネーションを！」"}