{"Battle/Dat/Battle/Message/101.bmd|0x00B0BF": "「チッ、何をやってるんだ！？」", "Battle/Dat/Battle/Message/101.bmd|0x00B0ED": "「すまん、ロストした！」", "Battle/Dat/Battle/Message/101.bmd|0x00B112": "「すぐにつかまえてみせるわ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B140": "「続けて攻撃する！」", "Battle/Dat/Battle/Message/101.bmd|0x00B15F": "「チャンスは逃がさん！」", "Battle/Dat/Battle/Message/101.bmd|0x00B184": "「離脱しそこなったか……！　今だっ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B1BE": "「隙を見せたな……！　行くぞ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00B1F2": "「援護に入る！　道を空けてくれ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B226": "「あのグランゾンの/　援護をする羽目になるとは……！」", "Battle/Dat/Battle/Message/101.bmd|0x00B276": "「レッド・オーガのカバーに入る！」", "Battle/Dat/Battle/Message/101.bmd|0x00B2AA": "「カイ少佐、援護します！」", "Battle/Dat/Battle/Message/101.bmd|0x00B2D2": "「少佐、後は自分が！」", "Battle/Dat/Battle/Message/101.bmd|0x00B2F4": "「ラミア少尉、援護する！」", "Battle/Dat/Battle/Message/101.bmd|0x00B31C": "「ラーダさん、援護します！」", "Battle/Dat/Battle/Message/101.bmd|0x00B347": "「ラトゥーニ、援護する！」", "Battle/Dat/Battle/Message/101.bmd|0x00B36F": "「アラド、後は任せろ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B394": "「援護するぞ、ゼオラ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B3B9": "「ジョッシュ、後は任せろ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B3E4": "「リム、後は俺が！」", "Battle/Dat/Battle/Message/101.bmd|0x00B403": "「援護するぞ、アリエイル！」", "Battle/Dat/Battle/Message/101.bmd|0x00B42E": "「イング、援護する！」", "Battle/Dat/Battle/Message/101.bmd|0x00B450": "「キョウスケ中尉、後は俺が！」", "Battle/Dat/Battle/Message/101.bmd|0x00B47E": "「よし、ＡＴＸチームの援護を！」", "Battle/Dat/Battle/Message/101.bmd|0x00B4AF": "「ＳＲＸチーム！　援護する！」", "Battle/Dat/Battle/Message/101.bmd|0x00B4DD": "「援護するぞ、マスタッシュマン！」", "Battle/Dat/Battle/Message/101.bmd|0x00B511": "「援護ＯＫよ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B52A": "「よし、もう一撃っ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B54C": "「お前の相手は俺だ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B56E": "「早く後退を！」", "Battle/Dat/Battle/Message/101.bmd|0x00B587": "「ここは俺達に任せて、後退を！」", "Battle/Dat/Battle/Message/101.bmd|0x00B5B8": "「これぐらいのことはさせてもらう！」", "Battle/Dat/Battle/Message/101.bmd|0x00B5EF": "「気にするな！/　俺はそう簡単にくたばらん！」", "Battle/Dat/Battle/Message/101.bmd|0x00B633": "「カイ少佐、離脱を！」", "Battle/Dat/Battle/Message/101.bmd|0x00B655": "「少佐、後退して下さい！」", "Battle/Dat/Battle/Message/101.bmd|0x00B67D": "「下がれ、ラミア少尉！」", "Battle/Dat/Battle/Message/101.bmd|0x00B6A2": "「ラーダさん、ここは俺が！」", "Battle/Dat/Battle/Message/101.bmd|0x00B6CD": "「後退しろ、ラトゥーニ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B6F5": "「アラド、何をやっている！」", "Battle/Dat/Battle/Message/101.bmd|0x00B720": "「下がれ、ゼオラ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B73F": "「ジョッシュ、後退しろ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B767": "「下がるんだ、リム！」", "Battle/Dat/Battle/Message/101.bmd|0x00B789": "「アリエイル、ここは任せろ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B7B7": "「イング、離脱しろ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B7D9": "「味方機が狙われてるわ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B801": "「そうはさせるか！」　", "Battle/Dat/Battle/Message/101.bmd|0x00B823": "「一気に行くぞっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00B845": "「まだそんな所にいたか！」", "Battle/Dat/Battle/Message/101.bmd|0x00B86D": "「逃げ遅れたな！」", "Battle/Dat/Battle/Message/101.bmd|0x00B889": "「このまま追い詰める！」", "Battle/Dat/Battle/Message/101.bmd|0x00B8AE": "「ヒューゴ、まだいけるわ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B8D9": "「ああ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B8E9": "「一気にたたみかけるぞ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B911": "「ここで決める！」", "Battle/Dat/Battle/Message/101.bmd|0x00B92D": "「くらえっ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B943": "「受けろ！」", "Battle/Dat/Battle/Message/101.bmd|0x00B956": "「このタイミングなら！」", "Battle/Dat/Battle/Message/101.bmd|0x00B97B": "「ポッドアウト！　行けっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00B9A9": "「ポッド射出！　逃がしはしない！」", "Battle/Dat/Battle/Message/101.bmd|0x00B9DD": "「マシンガン・ポッド、展開！　ＧＯ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BA1A": "「落ちろっ！」", "Battle/Dat/Battle/Message/101.bmd|0x00BA30": "「そこだ！」", "Battle/Dat/Battle/Message/101.bmd|0x00BA43": "「くらえ！　ターミナス・キャノン！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BA7D": "「ブラッディ・レイ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BAA2": "「ブラッディ・レイ、発射っ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BAD3": "「ファング・ナックル！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BAFB": "「ファング・ナックル！　シュート！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BB35": "「ファング・ナックル！　行けっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BB6C": "「くらえ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BB82": "「サンダー・スピンエッジ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BBB0": "「クラッシュ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BBCC": "「行くぞ！　バーニング・ブレイカー！」", "Battle/Dat/Battle/Message/101.bmd|0x00BC06": "「砕け散れぇぇっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BC28": "「レイガン・ポッド、展開！　ＧＯ！」", "Battle/Dat/Battle/Message/101.bmd|0x00BC5F": "「くらえ！」", "Battle/Dat/Battle/Message/101.bmd|0x00BC72": "「エンジン出力、ブルーゾーン！」", "Battle/Dat/Battle/Message/101.bmd|0x00BCA3": "「イグナイト！」", "Battle/Dat/Battle/Message/101.bmd|0x00BCBC": "「パイクッ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BCD5": "「もう一撃！」", "Battle/Dat/Battle/Message/101.bmd|0x00BCEB": "「とどめぇぇっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BD0A": "「次はこっちだ！」", "Battle/Dat/Battle/Message/101.bmd|0x00BD26": "「貫けぇぇっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BD42": "「ＴＥエンジン、オーバー・ブルー！」", "Battle/Dat/Battle/Message/101.bmd|0x00BD79": "「イグナイト・パイク！」", "Battle/Dat/Battle/Message/101.bmd|0x00BD9E": "「おりゃあっ！」", "Battle/Dat/Battle/Message/101.bmd|0x00BDB7": "「ターミナス・スマッシャー！」", "Battle/Dat/Battle/Message/101.bmd|0x00BDE5": "「ラストォッ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BE01": "「うおおおおお！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BE20": "「おおおっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BE39": "「でえいっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BE52": "「これも受けなさいっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BE7A": "「ロウガ・クラッシャー！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BEA5": "「くらえ！　ロウガ・クラッシャー！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BEDF": "「受けろ！　狼牙の一撃をっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BF10": "「貫けぇっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BF29": "「でえいっ！」", "Battle/Dat/Battle/Message/101.bmd|0x00BF3F": "「くらえ！　ライトニング・スピンエッジ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BF82": "「はあっ！」", "Battle/Dat/Battle/Message/101.bmd|0x00BF95": "「ライトニング・スピンエッジ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00BFC9": "「ライトニング・スピンエッジ！」", "Battle/Dat/Battle/Message/101.bmd|0x00BFFA": "「出力、ブルーゾーン！」", "Battle/Dat/Battle/Message/101.bmd|0x00C01F": "「ターミナス・ブラスター！」", "Battle/Dat/Battle/Message/101.bmd|0x00C04A": "「ディスチャージ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00C06C": "「ターミナス・ブラスタァァァッ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00C0A3": "「おりゃあっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00C0BF": "「行けぇぇっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00C0DB": "「こいつで決めてやるっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00C106": "「エグゼキューション！！」", "Battle/Dat/Battle/Message/101.bmd|0x00C12E": "「レイドッッ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00C14A": "「叩き込め！　ガルムレイド・ブレイズ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00C18A": "「おおおおっ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00C1A6": "「エグゼキューション・レイドッ！！」", "Battle/Dat/Battle/Message/101.bmd|0x00C1DD": "「イクスプロージョン！！」", "Battle/Dat/Battle/Message/102.bmd|0x0042DE": "「あとは実践あるのみ！」", "Battle/Dat/Battle/Message/102.bmd|0x004303": "「あの敵は、私に任せて！」", "Battle/Dat/Battle/Message/102.bmd|0x00432B": "「結果を出してみせるっ！」", "Battle/Dat/Battle/Message/102.bmd|0x004353": "「先手を打たせてもらうわよ！」", "Battle/Dat/Battle/Message/102.bmd|0x004381": "「さあ、私の予測外の行動が/　取れるかしら！？」", "Battle/Dat/Battle/Message/102.bmd|0x0043C8": "「私一人でだって、やってみせる！」", "Battle/Dat/Battle/Message/102.bmd|0x0043FC": "「ヒューゴの分も戦ってみせる！」", "Battle/Dat/Battle/Message/102.bmd|0x00442D": "「行くわよ、サーベラス！」"}