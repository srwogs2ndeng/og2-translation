{"Battle/Dat/Battle/Message/082.bmd|0x00497E": "「ハンデにしといたるわ、宇宙人！」", "Battle/Dat/Battle/Message/082.bmd|0x0049B2": "「フン、顔の割には/　大したことないやっちゃのう」", "Battle/Dat/Battle/Message/082.bmd|0x0049FC": "「何や、/　メリオルエッセはそんなもんかいな！」", "Battle/Dat/Battle/Message/082.bmd|0x004A43": "「おっさん、もっと気合い入れんかい！」", "Battle/Dat/Battle/Message/082.bmd|0x004A7D": "「それで斬り込み隊長やて？　笑わしよる」", "Battle/Dat/Battle/Message/082.bmd|0x004ABA": "「おどれは気迫が足りんのじゃ！」", "Battle/Dat/Battle/Message/082.bmd|0x004AEB": "「そんなんで、よう頭が張れるもんや！」", "Battle/Dat/Battle/Message/082.bmd|0x004B25": "「ごちゃごちゃゆーとるから、/　詰めが甘うなるんじゃ！」", "Battle/Dat/Battle/Message/082.bmd|0x004B78": "「ガイアセイバーズちゅーても、/　大したことないのう」", "Battle/Dat/Battle/Message/082.bmd|0x004BC8": "「大したことない化け物やな」", "Battle/Dat/Battle/Message/082.bmd|0x004BF3": "「フン、おもろい攻撃して来よるわ！」", "Battle/Dat/Battle/Message/082.bmd|0x004C2A": "「忍者っちゅーんは、/　もっと色々やるんちゃうんか？」", "Battle/Dat/Battle/Message/082.bmd|0x004C7A": "「宇宙人なんぞ、屁でもないわい」", "Battle/Dat/Battle/Message/082.bmd|0x004CAB": "「チッ！　あの黒いの、速いやんけ！」", "Battle/Dat/Battle/Message/082.bmd|0x004CE2": "「ええい、ルイーナは鬱陶しいのう！」", "Battle/Dat/Battle/Message/082.bmd|0x004D19": "「超機人ちゅーんは、こんなもんかい！」", "Battle/Dat/Battle/Message/082.bmd|0x004D53": "「何や、見かけ倒しやな」", "Battle/Dat/Battle/Message/082.bmd|0x004D78": "「バッタもんの神さんに/　やられるかっちゅーねん！」", "Battle/Dat/Battle/Message/082.bmd|0x004DC5": "「効いてへんぞ、ユーゼス！」", "Battle/Dat/Battle/Message/082.bmd|0x004DF0": "「当たるかいな！」", "Battle/Dat/Battle/Message/082.bmd|0x004E0C": "「どこ見てんねん！」", "Battle/Dat/Battle/Message/082.bmd|0x004E2B": "「へたれが！　出直してこいや！」", "Battle/Dat/Battle/Message/082.bmd|0x004E5C": "「アホゥ！　スカタン！」", "Battle/Dat/Battle/Message/082.bmd|0x004E81": "「このがしんたれが！」", "Battle/Dat/Battle/Message/082.bmd|0x004EA3": "「いちびっとるから、そうなんねん！」", "Battle/Dat/Battle/Message/082.bmd|0x004EDA": "「………」", "Battle/Dat/Battle/Message/082.bmd|0x004EEA": "「ちっ、しくったわ！」", "Battle/Dat/Battle/Message/082.bmd|0x004F0C": "「おっしゃ！　ワイの出番や！」", "Battle/Dat/Battle/Message/082.bmd|0x004F3A": "「こっちからもかましたる！」", "Battle/Dat/Battle/Message/082.bmd|0x004F65": "「ワイもいるでぇ！」", "Battle/Dat/Battle/Message/082.bmd|0x004F84": "「突っ込むでぇ、Ｇバンカラン！」", "Battle/Dat/Battle/Message/082.bmd|0x004FB5": "「こいつは大サービスや！」", "Battle/Dat/Battle/Message/082.bmd|0x004FDD": "「ショウコはん、ワイが手伝いまっさ！」", "Battle/Dat/Battle/Message/082.bmd|0x005017": "「ショウコはんの後ろには、/　ワイがいるんや！」", "Battle/Dat/Battle/Message/082.bmd|0x00505E": "「コウタ！　これは貸しにしとくで！」", "Battle/Dat/Battle/Message/082.bmd|0x005095": "「しゃーない、手伝ったるわ！」", "Battle/Dat/Battle/Message/082.bmd|0x0050C3": "「姉御、手ェ貸しまっせ！」", "Battle/Dat/Battle/Message/082.bmd|0x0050EB": "「やらせるかいな！」", "Battle/Dat/Battle/Message/082.bmd|0x00510A": "「邪魔するでぇ！」", "Battle/Dat/Battle/Message/082.bmd|0x005126": "「打たれ強さには自信があるんや！」", "Battle/Dat/Battle/Message/082.bmd|0x00515A": "「ここはワイに任しとき！」", "Battle/Dat/Battle/Message/082.bmd|0x005182": "「そうは問屋が卸さへんでぇ！」", "Battle/Dat/Battle/Message/082.bmd|0x0051B0": "「ワイの連れに手ェ出すんやない！」", "Battle/Dat/Battle/Message/082.bmd|0x0051E4": "「ショウコはん、危ない！」", "Battle/Dat/Battle/Message/082.bmd|0x00520C": "「ショウコはんのためなら、ワイは！」", "Battle/Dat/Battle/Message/082.bmd|0x005243": "「お前のためやない、/　ショウコはんのためや！」", "Battle/Dat/Battle/Message/082.bmd|0x00528A": "「お前に何かあったら、/　ショウコはんが悲しむんや！」", "Battle/Dat/Battle/Message/082.bmd|0x0052DA": "「姉御、ワイが引き受けますわ！」", "Battle/Dat/Battle/Message/082.bmd|0x00530B": "「もう一発かましたる！」", "Battle/Dat/Battle/Message/082.bmd|0x005330": "「しばくど、コラァ！」", "Battle/Dat/Battle/Message/082.bmd|0x005352": "「もう一回どついたるねん！」", "Battle/Dat/Battle/Message/082.bmd|0x00537D": "「何見とんじゃ、コラ！」", "Battle/Dat/Battle/Message/082.bmd|0x0053A2": "「ガン飛ばしたる！」", "Battle/Dat/Battle/Message/082.bmd|0x0053C1": "「当てもんは苦手なんじゃ！」", "Battle/Dat/Battle/Message/082.bmd|0x0053EC": "「蹴ったんど！」", "Battle/Dat/Battle/Message/082.bmd|0x005405": "「まずは蹴りじゃあ！」", "Battle/Dat/Battle/Message/082.bmd|0x005427": "「どついたる！」", "Battle/Dat/Battle/Message/082.bmd|0x005440": "「ウラウラウラウラウラァァッ！！」", "Battle/Dat/Battle/Message/082.bmd|0x005474": "「いてもうたらあぁ！！」", "Battle/Dat/Battle/Message/082.bmd|0x005499": "「次は鉄拳を！」", "Battle/Dat/Battle/Message/082.bmd|0x0054B2": "「死ぬほど食らわせたらぁぁぁ！！」", "Battle/Dat/Battle/Message/082.bmd|0x0054E6": "「行ってこいやぁぁ！！」", "Battle/Dat/Battle/Message/082.bmd|0x00550B": "「あかん！」", "Battle/Dat/Battle/Message/082.bmd|0x00551E": "「オラ、行くでぇ！！」", "Battle/Dat/Battle/Message/082.bmd|0x005540": "「ぬおおおお！！」", "Battle/Dat/Battle/Message/082.bmd|0x00555C": "「おどれなんざ、イチコロじゃ！」", "Battle/Dat/Battle/Message/082.bmd|0x00558D": "「そこ動くなや！」", "Battle/Dat/Battle/Message/082.bmd|0x0055A9": "「オラァ！」", "Battle/Dat/Battle/Message/082.bmd|0x0055BC": "「ウオラァ！」", "Battle/Dat/Battle/Message/082.bmd|0x0055D2": "「泣いて謝っても遅いんじゃああ！！」", "Battle/Dat/Battle/Message/082.bmd|0x005609": "「どぉぉりゃあ！！」", "Battle/Dat/Battle/Message/082.bmd|0x005628": "「往生せいやぁぁぁっ！！」", "Battle/Dat/Battle/Message/082.bmd|0x005650": "「動いたら！」", "Battle/Dat/Battle/Message/082.bmd|0x005666": "「ブッ飛ばすでぇ！！」", "Battle/Dat/Battle/Message/082.bmd|0x005688": "「動くなっちゅーとんじゃ、/　このボケェ！！」", "Battle/Dat/Battle/Message/082.bmd|0x0056CC": "「どっせい！」", "Battle/Dat/Battle/Message/082.bmd|0x0056E2": "「ブチかましたらぁぁぁぁ！！」", "Battle/Dat/Battle/Message/082.bmd|0x005710": "「何でやねん！？」", "Battle/Dat/Battle/Message/082.bmd|0x00572C": "「おどれら、三途の川ァ渡る準備！」", "Battle/Dat/Battle/Message/082.bmd|0x005760": "「出来とんのやろなぁぁぁ！！」", "Battle/Dat/Battle/Message/082.bmd|0x00578E": "「惚れた女に命を懸ける！」", "Battle/Dat/Battle/Message/082.bmd|0x0057B6": "「それが漢の心意気！」", "Battle/Dat/Battle/Message/082.bmd|0x0057D8": "「おらあっ！！」", "Battle/Dat/Battle/Message/082.bmd|0x0057F1": "「うーーーらっ！」", "Battle/Dat/Battle/Message/082.bmd|0x00580D": "「どついて！　どついて！　どついてぇ！！」", "Battle/Dat/Battle/Message/082.bmd|0x00584D": "「どついてどついてどついて/　どつき倒すッ！！」", "Battle/Dat/Battle/Message/082.bmd|0x005894": "「消え去らせ、ボケェェッ！！」", "Battle/Dat/Battle/Message/082.bmd|0x0058C2": "「ショウコはん、見とってくれたかのう」", "Battle/Dat/Battle/Message/082.bmd|0x0058FC": "「ほな、イカ焼き食いに行こか」", "Battle/Dat/Battle/Message/082.bmd|0x00592A": "「行くでぇ！！」", "Battle/Dat/Battle/Message/082.bmd|0x005943": "「必殺ゥゥ！！」", "Battle/Dat/Battle/Message/082.bmd|0x00595C": "「８７１０式龍虎射連打！！」", "Battle/Dat/Battle/Message/082.bmd|0x005987": "「オラオラオラオラオラァーッ！！」", "Battle/Dat/Battle/Message/082.bmd|0x0059BB": "「うぉら！　去ねぇぇぇぇ！！」", "Battle/Dat/Battle/Message/082.bmd|0x0059E9": "「これでタイタンズは優勝やで」", "Battle/Dat/Battle/Message/082.bmd|0x005A17": "「ほな、茶シバきに行こか」", "Battle/Dat/Battle/Message/082.bmd|0x005A3F": "「何見とんじゃ、コラァ！」", "Battle/Dat/Battle/Message/083.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/084.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/085.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/086.bmd|0x0020EC": "「物事はスマートに、な」", "Battle/Dat/Battle/Message/086.bmd|0x002111": "「なるようにしかならんか」", "Battle/Dat/Battle/Message/086.bmd|0x002139": "「運が悪かったな」", "Battle/Dat/Battle/Message/086.bmd|0x002155": "「仕留める！」", "Battle/Dat/Battle/Message/086.bmd|0x00216B": "「観念するんだな」", "Battle/Dat/Battle/Message/086.bmd|0x002187": "「もらう！」", "Battle/Dat/Battle/Message/086.bmd|0x00219A": "「諦めるんだな」", "Battle/Dat/Battle/Message/086.bmd|0x0021B3": "「当たってもらう！」", "Battle/Dat/Battle/Message/086.bmd|0x0021D2": "「すぐに終わらせる、これがな」", "Battle/Dat/Battle/Message/086.bmd|0x002200": "「時間をかける気はない……！」", "Battle/Dat/Battle/Message/086.bmd|0x00222E": "「おれの前に立ったか」", "Battle/Dat/Battle/Message/086.bmd|0x002250": "「手加減などせんぞ」", "Battle/Dat/Battle/Message/086.bmd|0x00226F": "「おれの相手をしてもらおうか」", "Battle/Dat/Battle/Message/086.bmd|0x00229D": "「やるぞ、ソウルゲイン！」", "Battle/Dat/Battle/Message/086.bmd|0x0022C5": "「行くぞ、ドゥバン・オーグ」", "Battle/Dat/Battle/Message/086.bmd|0x0022F0": "「当たり負けはせん、これがな」", "Battle/Dat/Battle/Message/086.bmd|0x00231E": "「ドゥバン……/　紛い物では、所詮無理な話だ」", "Battle/Dat/Battle/Message/086.bmd|0x002362": "「知らぬ間に/　地球は異星人に支配されるということか。/　巧妙だが、気の長い話だな」", "Battle/Dat/Battle/Message/086.bmd|0x0023DD": "「行くぞ、メリオルエッセ！」", "Battle/Dat/Battle/Message/086.bmd|0x002408": "「恐怖を味わうことになるのは、お前達の方だ」"}