{"Battle/Dat/Battle/Message/166.bmd|0x0026FC": "「こ、ここまでか！」", "Battle/Dat/Battle/Message/166.bmd|0x00271B": "「し、しまった！！」", "Battle/Dat/Battle/Message/166.bmd|0x00273A": "「ぐうっ！/　こちらの見通しが甘かったか……！」", "Battle/Dat/Battle/Message/166.bmd|0x002781": "「殿下のために、ここで退くわけにはいかん！」", "Battle/Dat/Battle/Message/166.bmd|0x0027C4": "「わ、我らには大義が！　意地があるのだ！！」", "Battle/Dat/Battle/Message/166.bmd|0x002807": "「ふ、ふふふ……覚悟はもう出来ている……！」", "Battle/Dat/Battle/Message/166.bmd|0x00284A": "「わ、我らの義を世に示すために……/　そのためには！」", "Battle/Dat/Battle/Message/166.bmd|0x00289A": "「ち、地上人……その力があれば……！」", "Battle/Dat/Battle/Message/166.bmd|0x0028D4": "「ええい、地上人め！/　これ以上はやらせんぞ！」", "Battle/Dat/Battle/Message/166.bmd|0x00291B": "「サ、サイバスター……強過ぎる！」", "Battle/Dat/Battle/Message/166.bmd|0x00294F": "「うぐっ……やはり、魔装機神には……！」", "Battle/Dat/Battle/Message/166.bmd|0x00298C": "「ぐっ！/　覚悟なくして、魔装機神には挑まん！！」", "Battle/Dat/Battle/Message/166.bmd|0x0029D6": "「こ、これが炎の魔装機神の力か！」", "Battle/Dat/Battle/Message/166.bmd|0x002A0A": "「ガッデス……/　せめて、足止めだけでも……！！」", "Battle/Dat/Battle/Message/166.bmd|0x002A54": "「ザムジード……何というパワー……！」", "Battle/Dat/Battle/Message/166.bmd|0x002A8E": "「くっ！　まだ任務は続行可能だ！」", "Battle/Dat/Battle/Message/166.bmd|0x002AC2": "「まともに当たったか……！」", "Battle/Dat/Battle/Message/166.bmd|0x002AED": "「チッ、いい目をしている！」", "Battle/Dat/Battle/Message/166.bmd|0x002B18": "「くっ！　あくまでも抗うか！」", "Battle/Dat/Battle/Message/166.bmd|0x002B46": "「この程度で怯む我らではない！」", "Battle/Dat/Battle/Message/166.bmd|0x002B77": "「地上人め、まだ抵抗するか！」", "Battle/Dat/Battle/Message/166.bmd|0x002BA5": "「やるな、地上人！」", "Battle/Dat/Battle/Message/166.bmd|0x002BC4": "「何としてもサイバスターを止めねば！」", "Battle/Dat/Battle/Message/166.bmd|0x002BFE": "「くっ！　魔装機神……やはり、強い！」", "Battle/Dat/Battle/Message/166.bmd|0x002C38": "「その力、殿下のために使えば……！」", "Battle/Dat/Battle/Message/166.bmd|0x002C6F": "「グランヴェール……一筋縄ではいかんな」", "Battle/Dat/Battle/Message/166.bmd|0x002CAC": "「ガ、ガッデス……さすがだな……！」", "Battle/Dat/Battle/Message/166.bmd|0x002CE3": "「くっ！　ザムジードを止められんのか！？」", "Battle/Dat/Battle/Message/166.bmd|0x002D23": "「損傷軽微。このまま戦闘を続行する」", "Battle/Dat/Battle/Message/166.bmd|0x002D5A": "「そう簡単にやられるか！」", "Battle/Dat/Battle/Message/166.bmd|0x002D82": "「被害微弱。状況続行」", "Battle/Dat/Battle/Message/166.bmd|0x002DA4": "「この程度、気にする必要はない」", "Battle/Dat/Battle/Message/166.bmd|0x002DD5": "「気迫が足りんぞ！」", "Battle/Dat/Battle/Message/166.bmd|0x002DF4": "「甘いぞ、地上人！」", "Battle/Dat/Battle/Message/166.bmd|0x002E13": "「地上人よ、遠慮は無用だ！」", "Battle/Dat/Battle/Message/166.bmd|0x002E3E": "「サイバスターを振り切れなかったか……！」", "Battle/Dat/Battle/Message/166.bmd|0x002E7E": "「魔装機神の力がこの程度だとは思えんが……」", "Battle/Dat/Battle/Message/166.bmd|0x002EC1": "「これならば、魔装機神と戦えるぞ！」", "Battle/Dat/Battle/Message/166.bmd|0x002EF8": "「グランヴェールの力は、/　こんなものではないはずだ」", "Battle/Dat/Battle/Message/166.bmd|0x002F48": "「ガッデス……手加減をしているのか？」", "Battle/Dat/Battle/Message/166.bmd|0x002F82": "「ザムジードの力を/　使いこなせていないようだな！」", "Battle/Dat/Battle/Message/166.bmd|0x002FCF": "「当たるものか！」", "Battle/Dat/Battle/Message/166.bmd|0x002FEB": "「魔装機神と言えど、動きをよく見れば！」", "Battle/Dat/Battle/Message/166.bmd|0x003028": "「よし、回避成功！」", "Battle/Dat/Battle/Message/166.bmd|0x003047": "「ふっ、予測通りだ」", "Battle/Dat/Battle/Message/166.bmd|0x003066": "「やはり、そう来たか」", "Battle/Dat/Battle/Message/166.bmd|0x003088": "「無駄だっ！」", "Battle/Dat/Battle/Message/166.bmd|0x00309E": "「効くものか！」", "Battle/Dat/Battle/Message/166.bmd|0x0030B7": "「そんなもの！」", "Battle/Dat/Battle/Message/166.bmd|0x0030D0": "「………」", "Battle/Dat/Battle/Message/166.bmd|0x0030E0": "「こんな時に弾切れか！」", "Battle/Dat/Battle/Message/166.bmd|0x003105": "「反撃できんとは！」", "Battle/Dat/Battle/Message/166.bmd|0x003124": "「くっ、これでは！」", "Battle/Dat/Battle/Message/166.bmd|0x003143": "「手出し出来んとは……！」", "Battle/Dat/Battle/Message/166.bmd|0x00316B": "「ロストしたか……！」", "Battle/Dat/Battle/Message/166.bmd|0x00318D": "「奴め、どこへ消えた！？」", "Battle/Dat/Battle/Message/166.bmd|0x0031B5": "「ちっ、見失ったか！」", "Battle/Dat/Battle/Message/166.bmd|0x0031D7": "「くっ、この間合いでは！」", "Battle/Dat/Battle/Message/166.bmd|0x0031FF": "「援護に入る！」", "Battle/Dat/Battle/Message/166.bmd|0x003218": "「後は任せておけっ！」", "Battle/Dat/Battle/Message/166.bmd|0x00323A": "「殿下、援護致します！」", "Battle/Dat/Battle/Message/166.bmd|0x00325F": "「もう一撃！」", "Battle/Dat/Battle/Message/166.bmd|0x003275": "「こちらで引き受ける！」", "Battle/Dat/Battle/Message/166.bmd|0x00329A": "「やらせるものか！」", "Battle/Dat/Battle/Message/166.bmd|0x0032B9": "「殿下、お下がりください！」", "Battle/Dat/Battle/Message/166.bmd|0x0032E4": "「体勢を崩したな！」", "Battle/Dat/Battle/Message/166.bmd|0x003303": "「隙あり！」", "Battle/Dat/Battle/Message/166.bmd|0x003316": "「こいつで！」", "Battle/Dat/Battle/Message/166.bmd|0x00332C": "「くらえっ！」", "Battle/Dat/Battle/Message/166.bmd|0x003342": "「もらう！」", "Battle/Dat/Battle/Message/166.bmd|0x003355": "「やあっ！」", "Battle/Dat/Battle/Message/166.bmd|0x003368": "「むんっ！」", "Battle/Dat/Battle/Message/166.bmd|0x00337B": "「はあっ！」", "Battle/Dat/Battle/Message/166.bmd|0x00338E": "「たあっ！」", "Battle/Dat/Battle/Message/166.bmd|0x0033A1": "「受けろ！」", "Battle/Dat/Battle/Message/166.bmd|0x0033B4": "「そこだ！」", "Battle/Dat/Battle/Message/166.bmd|0x0033C7": "「当ててやる！」", "Battle/Dat/Battle/Message/166.bmd|0x0033E0": "「機銃座、撃ち方始め！」", "Battle/Dat/Battle/Message/166.bmd|0x003405": "「対空機銃、撃て！」", "Battle/Dat/Battle/Message/166.bmd|0x003424": "「高射砲、発射用意！　撃て！」", "Battle/Dat/Battle/Message/166.bmd|0x003452": "「高射砲、１番、２番！　撃て！」", "Battle/Dat/Battle/Message/166.bmd|0x003483": "「前部全砲塔、発射用意！　撃て！」", "Battle/Dat/Battle/Message/166.bmd|0x0034B7": "「前部砲塔、一斉射撃！　撃て！」", "Battle/Dat/Battle/Message/166.bmd|0x0034E8": "「バリオン・ビーム砲、発射用意！」", "Battle/Dat/Battle/Message/166.bmd|0x00351C": "「撃て！」", "Battle/Dat/Battle/Message/166.bmd|0x00352C": "「主砲、発射用意！」", "Battle/Dat/Battle/Message/167.bmd|0x000CED": "「ウゥー……グアッ！」", "Battle/Dat/Battle/Message/167.bmd|0x000D0F": "「シ……シシシシ……」", "Battle/Dat/Battle/Message/167.bmd|0x000D31": "「イノチ……イノチダ……」", "Battle/Dat/Battle/Message/167.bmd|0x000D59": "「ググク……シネ……」", "Battle/Dat/Battle/Message/167.bmd|0x000D7B": "「ギギギ……ウラメシイ……」", "Battle/Dat/Battle/Message/167.bmd|0x000DA6": "「コ……コロス……ウウウ……」", "Battle/Dat/Battle/Message/167.bmd|0x000DD4": "「イキテル……ネタマシイ……」", "Battle/Dat/Battle/Message/167.bmd|0x000E02": "「ググ……イノチヲ……クレェ……」", "Battle/Dat/Battle/Message/167.bmd|0x000E36": "「ウラミ……ハラス……」", "Battle/Dat/Battle/Message/167.bmd|0x000E5B": "「ギアァァァッ！」", "Battle/Dat/Battle/Message/167.bmd|0x000E77": "「ニクイ……ニクイ……」", "Battle/Dat/Battle/Message/167.bmd|0x000E9C": "「ウオオォォン！！」", "Battle/Dat/Battle/Message/167.bmd|0x000EBB": "「クラウ……クラウ！」", "Battle/Dat/Battle/Message/167.bmd|0x000EDD": "「ワレハ……シナヌ……」", "Battle/Dat/Battle/Message/167.bmd|0x000F02": "「ギャアァァァッ！！」", "Battle/Dat/Battle/Message/167.bmd|0x000F24": "「グオアァァァッ！！」", "Battle/Dat/Battle/Message/167.bmd|0x000F46": "「グガアァァァッ！？」", "Battle/Dat/Battle/Message/167.bmd|0x000F68": "「オ、オノレェェッ！？」", "Battle/Dat/Battle/Message/167.bmd|0x000F8D": "「ユルサン……ユルサンゾ！」", "Battle/Dat/Battle/Message/167.bmd|0x000FB8": "「オオオゥゥッ！？」", "Battle/Dat/Battle/Message/167.bmd|0x000FD7": "「グオオゥゥッ！？」", "Battle/Dat/Battle/Message/167.bmd|0x000FF6": "「グオォォ……」", "Battle/Dat/Battle/Message/167.bmd|0x00100F": "「クククク……ドウシタ……」", "Battle/Dat/Battle/Message/167.bmd|0x00103A": "「ワレハ……フジミナリ……」", "Battle/Dat/Battle/Message/167.bmd|0x001065": "「クク……イクラデモコイ……」", "Battle/Dat/Battle/Message/167.bmd|0x001093": "「イタミナド……ナイ……」", "Battle/Dat/Battle/Message/167.bmd|0x0010BB": "「ワカラヌカ……ムダダト……」", "Battle/Dat/Battle/Message/167.bmd|0x0010E9": "「クククク……」", "Battle/Dat/Battle/Message/167.bmd|0x001102": "「キカヌ……」", "Battle/Dat/Battle/Message/167.bmd|0x001118": "「シレモノガ……」", "Battle/Dat/Battle/Message/167.bmd|0x001134": "「クカカカカ……」", "Battle/Dat/Battle/Message/167.bmd|0x001150": "「ムダダ……」", "Battle/Dat/Battle/Message/167.bmd|0x001166": "「オォォォ……」", "Battle/Dat/Battle/Message/167.bmd|0x00117F": "「アタラヌ……」"}