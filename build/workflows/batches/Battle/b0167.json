{"Battle/Dat/Battle/Message/093.bmd|0x001F0D": "「アインスト！/　貴様を生かしておくわけにはいかん！」", "Battle/Dat/Battle/Message/093.bmd|0x001F5D": "「この傷の痛み……貴様にも味わってもらう！」", "Battle/Dat/Battle/Message/093.bmd|0x001FA0": "「アインストは残らず駆逐せねばならんのだ！」", "Battle/Dat/Battle/Message/093.bmd|0x001FE3": "「潰してやるさ、アルトアイゼン！」", "Battle/Dat/Battle/Message/093.bmd|0x002017": "「奴さえ仕留めれば、鋼龍戦隊は！」", "Battle/Dat/Battle/Message/093.bmd|0x00204B": "「奴も/　アインストになるかも知れんからな……！」", "Battle/Dat/Battle/Message/093.bmd|0x002095": "「仕留めてやるよ、サイバスター！」", "Battle/Dat/Battle/Message/093.bmd|0x0020C9": "「サイバスター……最優先の標的だ！」", "Battle/Dat/Battle/Message/093.bmd|0x002100": "「魔装機神を仕留めれば、手柄になる！」", "Battle/Dat/Battle/Message/093.bmd|0x00213A": "「この世界じゃ、/　魔装機神は極上の獲物だからな……！」", "Battle/Dat/Battle/Message/093.bmd|0x00218D": "「次は俺の番だ！」", "Battle/Dat/Battle/Message/093.bmd|0x0021A9": "「逃がすかよ！」", "Battle/Dat/Battle/Message/093.bmd|0x0021C2": "「お返しだ！」", "Battle/Dat/Battle/Message/093.bmd|0x0021D8": "「仕切り直しだ！」", "Battle/Dat/Battle/Message/093.bmd|0x0021F4": "「ただで済むと思うな！」", "Battle/Dat/Battle/Message/093.bmd|0x002219": "「こ、ここまでか！！」", "Battle/Dat/Battle/Message/093.bmd|0x00223B": "「くそっ、これ以上は！！」", "Battle/Dat/Battle/Message/093.bmd|0x002263": "「こ、後退する！！」", "Battle/Dat/Battle/Message/093.bmd|0x002282": "「き、貴様らぁぁぁ！！」", "Battle/Dat/Battle/Message/093.bmd|0x0022A7": "「いかん！　これ以上はまずいぞ！」", "Battle/Dat/Battle/Message/093.bmd|0x0022DB": "「くそ！　この機体では勝てんのか！」", "Battle/Dat/Battle/Message/093.bmd|0x002312": "「ぐっ！/　俺とて、修羅場は何度もくぐってきたのだ！」", "Battle/Dat/Battle/Message/093.bmd|0x002362": "「こ、こんな所で終われんのだ、俺は！」", "Battle/Dat/Battle/Message/093.bmd|0x00239C": "「い、いいようにやられてたまるか！」", "Battle/Dat/Battle/Message/093.bmd|0x0023D3": "「何だ！？　貴様、何をやった！？」", "Battle/Dat/Battle/Message/093.bmd|0x002407": "「くそっ！　この機体では対応しきれん！！」", "Battle/Dat/Battle/Message/093.bmd|0x002447": "「ぐうう……悲願を果たすまで死ねるか！」", "Battle/Dat/Battle/Message/093.bmd|0x002484": "「お、おのれ、ユウキ！！」", "Battle/Dat/Battle/Message/093.bmd|0x0024AC": "「ユウキ、貴様に後れを取るとは……！」", "Battle/Dat/Battle/Message/093.bmd|0x0024E6": "「くそっ！　裏切り者がよくもこんな！！」", "Battle/Dat/Battle/Message/093.bmd|0x002523": "「こ、これがヴァルシオーネの力なのか！」", "Battle/Dat/Battle/Message/093.bmd|0x002560": "「リュ……リューネ・ゾルダーク……/　やってくれる！」", "Battle/Dat/Battle/Message/093.bmd|0x0025B0": "「うぐっ！　ゼンガーを止められんのか！？」", "Battle/Dat/Battle/Message/093.bmd|0x0025F0": "「う、受け止めたぞ、ゼンガー……！！」", "Battle/Dat/Battle/Message/093.bmd|0x00262A": "「ア……アインスト！　貴様ぁ！！」", "Battle/Dat/Battle/Message/093.bmd|0x00265E": "「ううっ、アインストにやられてたまるかよ！」", "Battle/Dat/Battle/Message/093.bmd|0x0026A1": "「ア、アルトアイゼン……何てパワーなんだ！」", "Battle/Dat/Battle/Message/093.bmd|0x0026E4": "「ぐああっ！　サイバスターめ！」", "Battle/Dat/Battle/Message/093.bmd|0x002715": "「ええい、サイバスターを止められん！！」", "Battle/Dat/Battle/Message/093.bmd|0x002752": "「こ、これが魔装機神の力か……！！」", "Battle/Dat/Battle/Message/093.bmd|0x002789": "「何としても魔装機神を止めなければ……！！」", "Battle/Dat/Battle/Message/093.bmd|0x0027CC": "「ええい、直撃とはな！」", "Battle/Dat/Battle/Message/093.bmd|0x0027F1": "「性能差は、腕でカバーしてやるさ！」", "Battle/Dat/Battle/Message/093.bmd|0x002828": "「チッ！　さすがにやるな！」", "Battle/Dat/Battle/Message/093.bmd|0x002853": "「くうっ！　いい所を狙ってくる！」", "Battle/Dat/Battle/Message/093.bmd|0x002887": "「まだ余裕はある！　やってやるさ！」", "Battle/Dat/Battle/Message/093.bmd|0x0028BE": "「何とでもしてやるさ、この状況なら！」", "Battle/Dat/Battle/Message/093.bmd|0x0028F8": "「まだまだ！　この程度で不利とは言えんさ！」", "Battle/Dat/Battle/Message/093.bmd|0x00293B": "「ぬうっ！　これ以上はやらせんぞ！」", "Battle/Dat/Battle/Message/093.bmd|0x002972": "「まだ甘いな、ユウキ・ジェグナン！」", "Battle/Dat/Battle/Message/093.bmd|0x0029A9": "「ちいっ！　ユウキ、貴様……！」", "Battle/Dat/Battle/Message/093.bmd|0x0029DA": "「裏切り者が調子に乗るな！」", "Battle/Dat/Battle/Message/093.bmd|0x002A05": "「ぬうっ！　裏切り者にやられてたまるか！」", "Battle/Dat/Battle/Message/093.bmd|0x002A45": "「ぐうっ！　やるな、ヴァルシオーネ！」", "Battle/Dat/Battle/Message/093.bmd|0x002A7F": "「リューネ・ゾルダーク！/　まだ終わってはいないぞ！」", "Battle/Dat/Battle/Message/093.bmd|0x002ACF": "「ぐうっ！　ゼンガーめ、よくも！」", "Battle/Dat/Battle/Message/093.bmd|0x002B03": "「ゼンガー！　まだ勝負はついていない！」", "Battle/Dat/Battle/Message/093.bmd|0x002B40": "「アインストめ、やってくれたな！！」", "Battle/Dat/Battle/Message/093.bmd|0x002B77": "「ぐうう……古傷がうずくぜ……！」", "Battle/Dat/Battle/Message/093.bmd|0x002BAB": "「ただ突っ込んでくるだけか、/　アルトアイゼン！」", "Battle/Dat/Battle/Message/093.bmd|0x002BF5": "「さすがにやるな、サイバスター！」", "Battle/Dat/Battle/Message/093.bmd|0x002C29": "「おのれ、サイバスターめ！」", "Battle/Dat/Battle/Message/093.bmd|0x002C54": "「魔装機神相手で/　油断したつもりはないが……！」", "Battle/Dat/Battle/Message/093.bmd|0x002C9E": "「やはり、魔装機とは一味違うな！」", "Battle/Dat/Battle/Message/093.bmd|0x002CD2": "「大したことはないな」", "Battle/Dat/Battle/Message/093.bmd|0x002CF4": "「なめているのか、この俺を！」", "Battle/Dat/Battle/Message/093.bmd|0x002D22": "「チッ、まとわりつくな！」", "Battle/Dat/Battle/Message/093.bmd|0x002D4A": "「その程度の力しかないのか」", "Battle/Dat/Battle/Message/093.bmd|0x002D75": "「ふん、つまらん手を使う」", "Battle/Dat/Battle/Message/093.bmd|0x002D9D": "「チッ、かわせなかったか！」", "Battle/Dat/Battle/Message/093.bmd|0x002DC8": "「くっ、ぬかった！」", "Battle/Dat/Battle/Message/093.bmd|0x002DE7": "「何だ？　触れただけか？」", "Battle/Dat/Battle/Message/093.bmd|0x002E0F": "「効かんぞ、ユウキ・ジェグナン！」", "Battle/Dat/Battle/Message/093.bmd|0x002E43": "「貴様はもう少しやると思っていたがな」", "Battle/Dat/Battle/Message/093.bmd|0x002E7D": "「チッ、裏切り者めが！」", "Battle/Dat/Battle/Message/093.bmd|0x002EA2": "「ふん……やはり、ユウキほどではないな」", "Battle/Dat/Battle/Message/093.bmd|0x002EDF": "「そんなものか、ヴァルシオーネの力は！」", "Battle/Dat/Battle/Message/093.bmd|0x002F1C": "「甘いな、リューネ・ゾルダーク！」", "Battle/Dat/Battle/Message/093.bmd|0x002F50": "「そんなものか、ゼンガー・ゾンボルト！」", "Battle/Dat/Battle/Message/093.bmd|0x002F8D": "「案外非力だな、ゼンガー！」", "Battle/Dat/Battle/Message/093.bmd|0x002FB8": "「チッ、アインストめ！」", "Battle/Dat/Battle/Message/093.bmd|0x002FDD": "「アインスト、やはり貴様は許せん！」", "Battle/Dat/Battle/Message/093.bmd|0x003014": "「アルトアイゼン……買い被り過ぎたか」", "Battle/Dat/Battle/Message/093.bmd|0x00304E": "「浅いな、サイバスター！」", "Battle/Dat/Battle/Message/093.bmd|0x003076": "「サイバスター……/　スピードは大したものだがな」", "Battle/Dat/Battle/Message/093.bmd|0x0030C0": "「魔装機神など、大したことはない」", "Battle/Dat/Battle/Message/093.bmd|0x0030F4": "「どうした？　魔装機神の名が泣くぞ」", "Battle/Dat/Battle/Message/093.bmd|0x00312B": "「甘い！」", "Battle/Dat/Battle/Message/093.bmd|0x00313B": "「当たらないのさ！」", "Battle/Dat/Battle/Message/093.bmd|0x00315A": "「遅いんだよ！」", "Battle/Dat/Battle/Message/093.bmd|0x003173": "「出直して来い！」", "Battle/Dat/Battle/Message/093.bmd|0x00318F": "「フッ、笑わせる」", "Battle/Dat/Battle/Message/093.bmd|0x0031AB": "「そんなものは通用せん！」", "Battle/Dat/Battle/Message/093.bmd|0x0031D3": "「無駄だ！」", "Battle/Dat/Battle/Message/093.bmd|0x0031E6": "「その手は食わないのさ！」", "Battle/Dat/Battle/Message/093.bmd|0x00320E": "「………」", "Battle/Dat/Battle/Message/093.bmd|0x00321E": "「チッ、迂闊だった！」", "Battle/Dat/Battle/Message/093.bmd|0x003240": "「くっ、反撃できん！」", "Battle/Dat/Battle/Message/093.bmd|0x003262": "「手も足も出せんとは！」", "Battle/Dat/Battle/Message/093.bmd|0x003287": "「奴め、どこへ行った！？」", "Battle/Dat/Battle/Message/093.bmd|0x0032AF": "「チッ、奴はどこにいる！？」", "Battle/Dat/Battle/Message/093.bmd|0x0032DA": "「ええい、死角に入られたか！」", "Battle/Dat/Battle/Message/093.bmd|0x003308": "「フッ、油断したな！」", "Battle/Dat/Battle/Message/093.bmd|0x00332A": "「これで終わらせてやる！」", "Battle/Dat/Battle/Message/093.bmd|0x003352": "「やらせるものか！」", "Battle/Dat/Battle/Message/093.bmd|0x003371": "「貴様の相手は俺だ！」", "Battle/Dat/Battle/Message/093.bmd|0x003393": "「運が悪かったな！」", "Battle/Dat/Battle/Message/093.bmd|0x0033B2": "「こういう展開もある！」", "Battle/Dat/Battle/Message/093.bmd|0x0033D7": "「いい流れだ！　行ける！」", "Battle/Dat/Battle/Message/093.bmd|0x0033FF": "「ブレイク・フィールド！」", "Battle/Dat/Battle/Message/093.bmd|0x003427": "「ソニック・ブレイカー！！」", "Battle/Dat/Battle/Message/093.bmd|0x003452": "「フィールド展開！」", "Battle/Dat/Battle/Message/093.bmd|0x003471": "「砕いてやるさ！！」", "Battle/Dat/Battle/Message/093.bmd|0x003490": "「くらえ！」", "Battle/Dat/Battle/Message/093.bmd|0x0034A3": "「これなら！」", "Battle/Dat/Battle/Message/093.bmd|0x0034B9": "「受けろ！」", "Battle/Dat/Battle/Message/093.bmd|0x0034CC": "「もらった！」", "Battle/Dat/Battle/Message/093.bmd|0x0034E2": "「叩き斬ってやる！」", "Battle/Dat/Battle/Message/093.bmd|0x003501": "「そこだ！」", "Battle/Dat/Battle/Message/093.bmd|0x003514": "「当ててやる！」"}