{"Battle/Dat/Battle/Message/078.bmd|0x008CD3": "「くそっ、反撃できねえ！」", "Battle/Dat/Battle/Message/078.bmd|0x008CFB": "「こんな所で/　一休みしてる場合じゃねえってのに！」", "Battle/Dat/Battle/Message/078.bmd|0x008D48": "「チッ、どうなってんだ！？」", "Battle/Dat/Battle/Message/078.bmd|0x008D73": "「あいつ、どこへ行きやがった！？」", "Battle/Dat/Battle/Message/078.bmd|0x008DA7": "「くっ、見失っちまったか！」", "Battle/Dat/Battle/Message/078.bmd|0x008DD2": "「ちぇっ、逃げ足の速い奴だな」", "Battle/Dat/Battle/Message/078.bmd|0x008E00": "「まだ行けるっ！」", "Battle/Dat/Battle/Message/078.bmd|0x008E1C": "「チャンスは逃がさねえ！」", "Battle/Dat/Battle/Message/078.bmd|0x008E44": "「俺が手を貸してやるぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x008E6C": "「アラド、後は俺がやる！」", "Battle/Dat/Battle/Message/078.bmd|0x008E94": "「ゼオラ、ここは俺に任せろ！」", "Battle/Dat/Battle/Message/078.bmd|0x008EC2": "「ラトゥーニ、手伝ってやるぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x008EF3": "「ラウル！　後は引き受けた！」", "Battle/Dat/Battle/Message/078.bmd|0x008F21": "「親分は先に行ってくれ！」", "Battle/Dat/Battle/Message/078.bmd|0x008F49": "「ショウコ、後は俺に任せろ！」", "Battle/Dat/Battle/Message/078.bmd|0x008F77": "「ショウコ、あんまり無茶するんじゃねえぞ！」", "Battle/Dat/Battle/Message/078.bmd|0x008FBA": "「イング、後は任せな！」", "Battle/Dat/Battle/Message/078.bmd|0x008FDF": "「手伝うぜ、ジョッシュ！」", "Battle/Dat/Battle/Message/078.bmd|0x009007": "「リム、後は任せろ！」", "Battle/Dat/Battle/Message/078.bmd|0x009029": "「トウマ、手伝うぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x00904B": "「マサキ、後は任せな！」", "Battle/Dat/Battle/Message/078.bmd|0x009070": "「手伝ってやるぜ、ミオ！」", "Battle/Dat/Battle/Message/078.bmd|0x009098": "「ミチル！　こいつは貸しだからな！」", "Battle/Dat/Battle/Message/078.bmd|0x0090CF": "「ミチル！　そいつは俺に任せろってんでえ！」", "Battle/Dat/Battle/Message/078.bmd|0x009112": "「突っ込め！　コンパチカイザー！」", "Battle/Dat/Battle/Message/078.bmd|0x009146": "「やらせるかよっ！」", "Battle/Dat/Battle/Message/078.bmd|0x009165": "「ここは俺が引き受けたっ！」", "Battle/Dat/Battle/Message/078.bmd|0x009190": "「アラド、何やってんだ！」", "Battle/Dat/Battle/Message/078.bmd|0x0091B8": "「下がれ、ゼオラ！」", "Battle/Dat/Battle/Message/078.bmd|0x0091D7": "「ラトゥーニ、早く逃げろ！」", "Battle/Dat/Battle/Message/078.bmd|0x009202": "「ラウル、今の内に逃げろ！」", "Battle/Dat/Battle/Message/078.bmd|0x00922D": "「親分、ここは引き受けた！」", "Battle/Dat/Battle/Message/078.bmd|0x009258": "「ショウコに手ェ出すんじゃねえ！！」", "Battle/Dat/Battle/Message/078.bmd|0x00928F": "「妹に手を出す奴は俺が許さねえ！」", "Battle/Dat/Battle/Message/078.bmd|0x0092C3": "「ショウコ、早く逃げろ！」", "Battle/Dat/Battle/Message/078.bmd|0x0092EB": "「ショウコは俺が守る！！」", "Battle/Dat/Battle/Message/078.bmd|0x009313": "「下がれ、イング！」", "Battle/Dat/Battle/Message/078.bmd|0x009332": "「ジョッシュ、ここは引き受けた！」", "Battle/Dat/Battle/Message/078.bmd|0x009366": "「リム、無茶すんな！」", "Battle/Dat/Battle/Message/078.bmd|0x009388": "「トウマ、ここは任せろ！」", "Battle/Dat/Battle/Message/078.bmd|0x0093B0": "「下がれ、ミオ！」", "Battle/Dat/Battle/Message/078.bmd|0x0093CC": "「ミチル！　てめえ、何やってんだ！」", "Battle/Dat/Battle/Message/078.bmd|0x009403": "「しょうがねえ！　助けてやるぜ、ミチル！」", "Battle/Dat/Battle/Message/078.bmd|0x009443": "「サイバスターでも避けられねえのなら！」", "Battle/Dat/Battle/Message/078.bmd|0x009480": "「まとめて相手をしてやるぜ！！」", "Battle/Dat/Battle/Message/078.bmd|0x0094B1": "「うおおっ！　そこをどきやがれっ！！」", "Battle/Dat/Battle/Message/078.bmd|0x0094EB": "「こいつも持ってけ、べらぼうめ！」", "Battle/Dat/Battle/Message/078.bmd|0x00951F": "「江戸っ子は、宵越しの銭を持たねえんだよ！」", "Battle/Dat/Battle/Message/078.bmd|0x009562": "「出し惜しみはしないということか」", "Battle/Dat/Battle/Message/078.bmd|0x009596": "「お兄ちゃん、まだ行けるわ！」", "Battle/Dat/Battle/Message/078.bmd|0x0095C4": "「ああ、押し込んでやる！」", "Battle/Dat/Battle/Message/078.bmd|0x0095EC": "「うおおおっ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009608": "「ファイター・ビームガン！」", "Battle/Dat/Battle/Message/078.bmd|0x009633": "「ファイター・ビームガン！/　くらえ！」", "Battle/Dat/Battle/Message/078.bmd|0x00966E": "「当たれっ！」", "Battle/Dat/Battle/Message/078.bmd|0x009684": "「そこだっ！」", "Battle/Dat/Battle/Message/078.bmd|0x00969A": "「ファイター・ビームボゥ！」", "Battle/Dat/Battle/Message/078.bmd|0x0096C5": "「セット！」", "Battle/Dat/Battle/Message/078.bmd|0x0096D8": "「狙いはついた！」", "Battle/Dat/Battle/Message/078.bmd|0x0096F4": "「撃ち抜いてやる！！」", "Battle/Dat/Battle/Message/078.bmd|0x009716": "「この距離なら、こいつだ！」", "Battle/Dat/Battle/Message/078.bmd|0x009741": "「ビームボゥ・モード！」", "Battle/Dat/Battle/Message/078.bmd|0x009766": "「外すなよ」", "Battle/Dat/Battle/Message/078.bmd|0x009779": "「ああ！　行けぇっ！！」", "Battle/Dat/Battle/Message/078.bmd|0x00979E": "「飛べ、バトルレーサー！」", "Battle/Dat/Battle/Message/078.bmd|0x0097C6": "「突っ込め、バトルレーサー！」", "Battle/Dat/Battle/Message/078.bmd|0x0097F4": "「ほらほら！　こっちだ、こっち！」", "Battle/Dat/Battle/Message/078.bmd|0x009828": "「行け、コウタ！」", "Battle/Dat/Battle/Message/078.bmd|0x009844": "「うおおおお！！」", "Battle/Dat/Battle/Message/078.bmd|0x009860": "「突き抜けろぉぉぉっ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009888": "「ヘッ、どこ見てやがる！」", "Battle/Dat/Battle/Message/078.bmd|0x0098B0": "「今だ、コウタ！」", "Battle/Dat/Battle/Message/078.bmd|0x0098CC": "「燃えろぉぉぉぉっ！！」", "Battle/Dat/Battle/Message/078.bmd|0x0098F1": "「オーバー！　ビィィィィィム！！」", "Battle/Dat/Battle/Message/078.bmd|0x009925": "「くらえ！　オーバー・ビームッ！！」", "Battle/Dat/Battle/Message/078.bmd|0x00995C": "「今だ、スパイラルナックルを！」", "Battle/Dat/Battle/Message/078.bmd|0x00998D": "「スパイラル！　ナッコォォッ！！」", "Battle/Dat/Battle/Message/078.bmd|0x0099C1": "「放て、カイザーの拳を！」", "Battle/Dat/Battle/Message/078.bmd|0x0099E9": "「うおおっ！　スパイラルナッコォォッ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009A29": "「うおおっ！」", "Battle/Dat/Battle/Message/078.bmd|0x009A3F": "「行け！　スパイラルナッコォ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009A73": "「カイザー・ブゥゥメランッ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009AA4": "「切り裂け！　カイザー・ブーメラン！！」", "Battle/Dat/Battle/Message/078.bmd|0x009AE1": "「唸れ！　カイザー・ブーメラン！！」", "Battle/Dat/Battle/Message/078.bmd|0x009B18": "「コウタ、カイザー・バーストだ！」", "Battle/Dat/Battle/Message/078.bmd|0x009B4C": "「カイザーァァァ……バーストッ！！！」", "Battle/Dat/Battle/Message/078.bmd|0x009B86": "「くらえ！　必殺！！」", "Battle/Dat/Battle/Message/078.bmd|0x009BA8": "「カイザー・バァァァストッ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009BD9": "「ダブル・スパイラルナッコォ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009C0D": "「カイザー・バースト！！」", "Battle/Dat/Battle/Message/078.bmd|0x009C35": "「まだまだぁっ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009C54": "「カイザァァッ！　トルネェェェェェドッ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009C97": "「とどめだぁっ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009CB6": "「カイザー・トルネードッ！！/　ブチ抜けぇぇぇっ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009D06": "「今だ！　ショルダー・キャノン！！」", "Battle/Dat/Battle/Message/078.bmd|0x009D3D": "「ショルダー・キャノン！　発射！！」", "Battle/Dat/Battle/Message/078.bmd|0x009D74": "「撃て、カイザーの両拳を！」", "Battle/Dat/Battle/Message/078.bmd|0x009D9F": "「ダブル！　スパイラルナッコォォォッ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009DDF": "「行け！　ダブル・スパイラルナッコォ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009E1F": "「唱えろ、コウタ。/　バーナウ・ファー・ドラグ……！」", "Battle/Dat/Battle/Message/078.bmd|0x009E6F": "「バーナウ・ファー・ドラグ！」", "Battle/Dat/Battle/Message/078.bmd|0x009E9D": "「ファイヤー・ドラゴン！！/　行けぇぇぇっ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009EE4": "「コウタ、炎の龍を召喚するんだ」", "Battle/Dat/Battle/Message/078.bmd|0x009F15": "「ファイヤー・ドラゴン！/　燃えろぉぉぉっ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009F5C": "「コウタ、ファイヤー・ドラゴンを呼べ！」", "Battle/Dat/Battle/Message/078.bmd|0x009F99": "「ああ！　バーナウ・ファー・ドラグ！！」", "Battle/Dat/Battle/Message/078.bmd|0x009FD6": "「くらえ！　ファイヤー・ドラゴン！！」", "Battle/Dat/Battle/Message/078.bmd|0x00A010": "「カイザースキャナー！」", "Battle/Dat/Battle/Message/078.bmd|0x00A035": "「ロックオン！」", "Battle/Dat/Battle/Message/078.bmd|0x00A04E": "「オーバーゲートエンジン……/　その力を解放する時が来た！」", "Battle/Dat/Battle/Message/078.bmd|0x00A0A7": "「ああ！　行くぜ！！」", "Battle/Dat/Battle/Message/078.bmd|0x00A0C9": "「オーバーブーストッ！！」", "Battle/Dat/Battle/Message/078.bmd|0x00A0F1": "「うおおおおっ！！」", "Battle/Dat/Battle/Message/078.bmd|0x00A110": "「オーバー・カイザー！　ソォォォドッ！！」", "Battle/Dat/Battle/Message/078.bmd|0x00A150": "「でりゃあああっ！！」", "Battle/Dat/Battle/Message/078.bmd|0x00A172": "「カイザースキャナー、オン！」", "Battle/Dat/Battle/Message/078.bmd|0x00A1A0": "「そこだな！」", "Battle/Dat/Battle/Message/078.bmd|0x00A1B6": "「開け、次元の門よ……！/　そして、我らに力を！」", "Battle/Dat/Battle/Message/078.bmd|0x00A200": "「行くぞ、Ｇコンパチカイザー！！」", "Battle/Dat/Battle/Message/078.bmd|0x00A234": "「Ｇサンダーゲート、出力全開！！」"}