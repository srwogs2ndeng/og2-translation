{"Battle/Dat/Battle/Message/068.bmd|0x00629F": "「ここで消えるわけにはいかないのでな」", "Battle/Dat/Battle/Message/068.bmd|0x0062D9": "「こいつをスピードだけの機体だと思うなよ」", "Battle/Dat/Battle/Message/068.bmd|0x006319": "「こいつの装甲を甘く見るな！」", "Battle/Dat/Battle/Message/068.bmd|0x006347": "「悪いが、見た目通り頑丈でな」", "Battle/Dat/Battle/Message/068.bmd|0x006375": "「その程度か、オレグ大尉！」", "Battle/Dat/Battle/Message/068.bmd|0x0063A0": "「ちっ、ジンライを振り切れなかったか」", "Battle/Dat/Battle/Message/068.bmd|0x0063DA": "「くっ、さすがに素早いな」", "Battle/Dat/Battle/Message/068.bmd|0x006402": "「妖機人に食いつかれるとはな」", "Battle/Dat/Battle/Message/068.bmd|0x006430": "「お前の動きは見切っている！」", "Battle/Dat/Battle/Message/068.bmd|0x00645E": "「マシン・シーケンスの機体制御など！」", "Battle/Dat/Battle/Message/068.bmd|0x006498": "「ゲストなどに！」", "Battle/Dat/Battle/Message/068.bmd|0x0064B4": "「光龍、貴様などに！」", "Battle/Dat/Battle/Message/068.bmd|0x0064D6": "「妖機人などに！」", "Battle/Dat/Battle/Message/068.bmd|0x0064F2": "「見え透いたモーションだったな」", "Battle/Dat/Battle/Message/068.bmd|0x006523": "「あいにくだが、俺には通じん！」", "Battle/Dat/Battle/Message/068.bmd|0x006554": "「お前が仕掛けた時から、/　この結果は決まっていた」", "Battle/Dat/Battle/Message/068.bmd|0x0065A1": "「心を平静に保てば、造作もないことだ」", "Battle/Dat/Battle/Message/068.bmd|0x0065DB": "「こいつの運動性を甘く見たようだな」", "Battle/Dat/Battle/Message/068.bmd|0x006612": "「この運動性、反応速度……/　名機と言われるだけある」", "Battle/Dat/Battle/Message/068.bmd|0x006662": "「以前より運動性が向上しているのでな」", "Battle/Dat/Battle/Message/068.bmd|0x00669C": "「伊達に空を飛んでいるわけじゃない」", "Battle/Dat/Battle/Message/068.bmd|0x0066D3": "「甘いな、オレグ大尉」", "Battle/Dat/Battle/Message/068.bmd|0x0066F5": "「無駄だ、オレグ大尉」", "Battle/Dat/Battle/Message/068.bmd|0x006717": "「お前に狩られるつもりはない」", "Battle/Dat/Battle/Message/068.bmd|0x006745": "「無駄だ、ドゥバン！」", "Battle/Dat/Battle/Message/068.bmd|0x006767": "「甘いな、イグニス」", "Battle/Dat/Battle/Message/068.bmd|0x006786": "「どこを見ている、コンターギオ！」", "Battle/Dat/Battle/Message/068.bmd|0x0067BA": "「無駄だ、アクイラ」", "Battle/Dat/Battle/Message/068.bmd|0x0067D9": "「ゼゼーナン、お前では無理だ！」", "Battle/Dat/Battle/Message/068.bmd|0x00680A": "「無駄だ、ペルフェクティオ！」", "Battle/Dat/Battle/Message/068.bmd|0x006838": "「それでもダブルＧか！」", "Battle/Dat/Battle/Message/068.bmd|0x00685D": "「ルイーナなどにやられるか！」", "Battle/Dat/Battle/Message/068.bmd|0x00688B": "「魔装機で俺を捉えることは出来ん」", "Battle/Dat/Battle/Message/068.bmd|0x0068BF": "「さすがにあれは非常識だな」", "Battle/Dat/Battle/Message/068.bmd|0x0068EA": "「ふん、見かけ倒しだな」", "Battle/Dat/Battle/Message/068.bmd|0x00690F": "「超機人にやられるわけにはいかん」", "Battle/Dat/Battle/Message/068.bmd|0x006943": "「四凶などと……名ばかりか」", "Battle/Dat/Battle/Message/068.bmd|0x00696E": "「俺を取り込めると思うな！」", "Battle/Dat/Battle/Message/068.bmd|0x006999": "「紛い物の神などに！」", "Battle/Dat/Battle/Message/068.bmd|0x0069BB": "「ユーゼス、それがお前の力か！」", "Battle/Dat/Battle/Message/068.bmd|0x0069EC": "「悪いが、こういう備えがあるのでな」", "Battle/Dat/Battle/Message/068.bmd|0x006A23": "「こちらもそれ相応の準備はしている」", "Battle/Dat/Battle/Message/068.bmd|0x006A5A": "「Ｇ・ウォール展開！」", "Battle/Dat/Battle/Message/068.bmd|0x006A7C": "「Ｇテリトリー展開！」", "Battle/Dat/Battle/Message/068.bmd|0x006A9E": "「フ……残念だったな」", "Battle/Dat/Battle/Message/068.bmd|0x006AC0": "「ジャマーの力だ。惜しかったな」", "Battle/Dat/Battle/Message/068.bmd|0x006AF1": "「………」", "Battle/Dat/Battle/Message/068.bmd|0x006B01": "「平静を失った結果がこれか……」", "Battle/Dat/Battle/Message/068.bmd|0x006B32": "「やるな……！　基本に忠実な戦法だ」", "Battle/Dat/Battle/Message/068.bmd|0x006B69": "「隙を見せたな……！」", "Battle/Dat/Battle/Message/068.bmd|0x006B8B": "「フォローは万全だ」", "Battle/Dat/Battle/Message/068.bmd|0x006BAA": "「回避し損なったようだな」", "Battle/Dat/Battle/Message/068.bmd|0x006BD2": "「カーラ、後は任せろ！」", "Battle/Dat/Battle/Message/068.bmd|0x006BF7": "「よくやった、カーラ。充分な牽制だ」", "Battle/Dat/Battle/Message/068.bmd|0x006C2E": "「カーラ、援護するぞ！」", "Battle/Dat/Battle/Message/068.bmd|0x006C53": "「詰めが甘いぞ、カーラ！」", "Battle/Dat/Battle/Message/068.bmd|0x006C7B": "「ブリット、後は俺に任せろ！」", "Battle/Dat/Battle/Message/068.bmd|0x006CA9": "「リョウト、俺も続くぞ！」", "Battle/Dat/Battle/Message/068.bmd|0x006CD1": "「下がれ、タスク。後は俺の仕事だ！」", "Battle/Dat/Battle/Message/068.bmd|0x006D08": "「クスハ、後は俺がやる！」", "Battle/Dat/Battle/Message/068.bmd|0x006D30": "「リオ、援護するぞ！」", "Battle/Dat/Battle/Message/068.bmd|0x006D52": "「レオナ、お前は先に行け！」", "Battle/Dat/Battle/Message/068.bmd|0x006D7D": "「アラド、奴はまだ倒れていないぞ！」", "Battle/Dat/Battle/Message/068.bmd|0x006DB4": "「俺に後始末をさせるとはな……」", "Battle/Dat/Battle/Message/068.bmd|0x006DE5": "「援護するぞ、ゼオラ」", "Battle/Dat/Battle/Message/068.bmd|0x006E07": "「ゼオラ、奴のトドメは俺が刺す」", "Battle/Dat/Battle/Message/068.bmd|0x006E38": "「少佐、後は自分が！」", "Battle/Dat/Battle/Message/068.bmd|0x006E5A": "「ラウル、援護する！」", "Battle/Dat/Battle/Message/068.bmd|0x006E7C": "「ジョッシュ、後は任せろ！」", "Battle/Dat/Battle/Message/068.bmd|0x006EA7": "「リム、後は俺が！」", "Battle/Dat/Battle/Message/068.bmd|0x006EC6": "「ヒューゴ少尉、援護する！」", "Battle/Dat/Battle/Message/068.bmd|0x006EF1": "「アクア少尉、援護する！」", "Battle/Dat/Battle/Message/068.bmd|0x006F19": "「トウマ、後は任せろ！」", "Battle/Dat/Battle/Message/068.bmd|0x006F3E": "「援護するぞ、イング！」", "Battle/Dat/Battle/Message/068.bmd|0x006F63": "「お前の相手は俺だ！」", "Battle/Dat/Battle/Message/068.bmd|0x006F85": "「今の内に後退を！」", "Battle/Dat/Battle/Message/068.bmd|0x006FA4": "「まだこちらには余裕があるのでな！」", "Battle/Dat/Battle/Message/068.bmd|0x006FDB": "「カーラ、どこを見ている！」", "Battle/Dat/Battle/Message/068.bmd|0x007006": "「カーラ、俺の後ろへ回れ！」", "Battle/Dat/Battle/Message/068.bmd|0x007031": "「前に出過ぎだ、カーラ！」", "Battle/Dat/Battle/Message/068.bmd|0x007059": "「下がれ、ブリット！」", "Battle/Dat/Battle/Message/068.bmd|0x00707B": "「迂闊だぞ、タスク！」", "Battle/Dat/Battle/Message/068.bmd|0x00709D": "「無理をするな、リョウト！」", "Battle/Dat/Battle/Message/068.bmd|0x0070C8": "「後退しろ、クスハ！」", "Battle/Dat/Battle/Message/068.bmd|0x0070EA": "「下がれ、リオ！」", "Battle/Dat/Battle/Message/068.bmd|0x007106": "「レオナ、奴は俺が引き受ける！」", "Battle/Dat/Battle/Message/068.bmd|0x007137": "「説教を覚悟しておけよ、アラド！」", "Battle/Dat/Battle/Message/068.bmd|0x00716B": "「突撃癖は直っていないな、アラド」", "Battle/Dat/Battle/Message/068.bmd|0x00719F": "「ゼオラ、後退しろ！」", "Battle/Dat/Battle/Message/068.bmd|0x0071C1": "「少佐、ここは自分が引き受けます！」", "Battle/Dat/Battle/Message/068.bmd|0x0071F8": "「下がれ、ラウル！」", "Battle/Dat/Battle/Message/068.bmd|0x007217": "「ジョッシュ、後退しろ！」", "Battle/Dat/Battle/Message/068.bmd|0x00723F": "「リム、下がるんだ！」", "Battle/Dat/Battle/Message/068.bmd|0x007261": "「ヒューゴ少尉、離脱を！」", "Battle/Dat/Battle/Message/068.bmd|0x007289": "「アクア少尉、後退を！」", "Battle/Dat/Battle/Message/068.bmd|0x0072AE": "「無茶をするな、トウマ！」", "Battle/Dat/Battle/Message/068.bmd|0x0072D6": "「下がれ、イング！」", "Battle/Dat/Battle/Message/068.bmd|0x0072F5": "「相手が何人いようと！」", "Battle/Dat/Battle/Message/068.bmd|0x00731A": "「固まっていたのが運の尽きだな！」", "Battle/Dat/Battle/Message/068.bmd|0x00734E": "「いい位置だ……！　いける！」", "Battle/Dat/Battle/Message/068.bmd|0x00737C": "「観念してもらおうか！」", "Battle/Dat/Battle/Message/068.bmd|0x0073A1": "「もう諦めろ！」", "Battle/Dat/Battle/Message/068.bmd|0x0073BA": "「これで仕留めてみせる！」", "Battle/Dat/Battle/Message/068.bmd|0x0073E2": "「落ちろ！」", "Battle/Dat/Battle/Message/068.bmd|0x0073F5": "「この距離……直撃させる！」", "Battle/Dat/Battle/Message/068.bmd|0x007420": "「スプリットミサイル！」", "Battle/Dat/Battle/Message/068.bmd|0x007445": "「切り裂く！！」", "Battle/Dat/Battle/Message/068.bmd|0x00745E": "「照準セット！　誤差修正！」", "Battle/Dat/Battle/Message/068.bmd|0x007489": "「撃ち抜く！　ハイ・ツインランチャー！」", "Battle/Dat/Battle/Message/068.bmd|0x0074C6": "「こいつの射程を甘く見るなよ」", "Battle/Dat/Battle/Message/068.bmd|0x0074F4": "「行け！」", "Battle/Dat/Battle/Message/068.bmd|0x007504": "「受けろ！」", "Battle/Dat/Battle/Message/068.bmd|0x007517": "「ツイン・ソリッドカノンで！」", "Battle/Dat/Battle/Message/068.bmd|0x007545": "「この距離……ソリッドカノンならば！」", "Battle/Dat/Battle/Message/068.bmd|0x00757F": "「ツイン・ソリッドカノン……/　撃ち抜いてやる！」", "Battle/Dat/Battle/Message/068.bmd|0x0075C9": "「悪く思うな……これも戦術だ！」", "Battle/Dat/Battle/Message/068.bmd|0x0075FA": "「まとめて片付けてやる！」", "Battle/Dat/Battle/Message/068.bmd|0x007622": "「一斉発射！」", "Battle/Dat/Battle/Message/068.bmd|0x007638": "「この距離、直撃させる！」", "Battle/Dat/Battle/Message/068.bmd|0x007660": "「バレル展開！　セット！」"}