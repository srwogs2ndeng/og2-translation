{"Battle/Dat/Battle/Message/255.bmd|0x004155": "「フン、ケルベリオンの相手じゃねえな」", "Battle/Dat/Battle/Message/255.bmd|0x00418F": "「ヘッ、これで勝ち組間違いなしだぜ」", "Battle/Dat/Battle/Message/255.bmd|0x0041C6": "「何だぁ？　ビビってんのか、てめえ」", "Battle/Dat/Battle/Message/255.bmd|0x0041FD": "「フン……下のクラスじゃ、そんなもんか」", "Battle/Dat/Battle/Message/255.bmd|0x00423A": "「ゼオラ、てめえも落ちこぼれだな」", "Battle/Dat/Battle/Message/255.bmd|0x00426E": "「ビビってんのか、ラトゥーニ？」", "Battle/Dat/Battle/Message/255.bmd|0x00429F": "「そんなに速くねえな、サイバスター」", "Battle/Dat/Battle/Message/255.bmd|0x0042D6": "「何だぁ？　それでも魔装機神か？」", "Battle/Dat/Battle/Message/255.bmd|0x00430A": "「残念だったな！」", "Battle/Dat/Battle/Message/255.bmd|0x004326": "「効かねえんだよ！」", "Battle/Dat/Battle/Message/255.bmd|0x004345": "「どうした？　アテが外れたか？」", "Battle/Dat/Battle/Message/255.bmd|0x004376": "「駄目だな、それじゃ」", "Battle/Dat/Battle/Message/255.bmd|0x004398": "「………」", "Battle/Dat/Battle/Message/255.bmd|0x0043A8": "「チッ！　何だよ、こりゃあ！」", "Battle/Dat/Battle/Message/255.bmd|0x0043D6": "「くそっ！　イラつくぜ！！」", "Battle/Dat/Battle/Message/255.bmd|0x004401": "「マジでムカつくんだよ、こういうの！」", "Battle/Dat/Battle/Message/255.bmd|0x00443B": "「あの野郎、どこへ行きやがった！？」", "Battle/Dat/Battle/Message/255.bmd|0x004472": "「フン、逃げ足の早い奴め」", "Battle/Dat/Battle/Message/255.bmd|0x00449A": "「ま、ここは見逃してやるぜ」", "Battle/Dat/Battle/Message/255.bmd|0x0044C5": "「美味しい所は、俺がもらう！」", "Battle/Dat/Battle/Message/255.bmd|0x0044F3": "「手柄は、仕留めた奴のもんさ！」", "Battle/Dat/Battle/Message/255.bmd|0x004524": "「シエンヌ、手柄は俺のもんだ！」", "Battle/Dat/Battle/Message/255.bmd|0x004555": "「悪く思うなよ、シエンヌ！」", "Battle/Dat/Battle/Message/255.bmd|0x004580": "「シオ、あいつはもらったぜ！」", "Battle/Dat/Battle/Message/255.bmd|0x0045AE": "「悪いな、シオ！　横取りだ！」", "Battle/Dat/Battle/Message/255.bmd|0x0045DC": "「しゃあねえ、助けてやるか！」", "Battle/Dat/Battle/Message/255.bmd|0x00460A": "「こいつは貸しにしといてやるよ！」", "Battle/Dat/Battle/Message/255.bmd|0x00463E": "「シエンヌ、ざまぁねえな！」", "Battle/Dat/Battle/Message/255.bmd|0x004669": "「恩に着ろよ、シオ！」", "Battle/Dat/Battle/Message/255.bmd|0x00468B": "「これでケリをつけてやる！」", "Battle/Dat/Battle/Message/255.bmd|0x0046B6": "「さっさとくたばりやがれ！」", "Battle/Dat/Battle/Message/255.bmd|0x0046E1": "「くらいやがれ！」", "Battle/Dat/Battle/Message/255.bmd|0x0046FD": "「そこだっ！」", "Battle/Dat/Battle/Message/255.bmd|0x004713": "「ピーク・シューター！」", "Battle/Dat/Battle/Message/255.bmd|0x004738": "「受けな！　ピーク・シューター！」", "Battle/Dat/Battle/Message/255.bmd|0x00476C": "「撃ち抜いてやる！！」", "Battle/Dat/Battle/Message/255.bmd|0x00478E": "「ぶっ飛ばしてやるよ！」", "Battle/Dat/Battle/Message/255.bmd|0x0047B3": "「ターネイル、展開！」", "Battle/Dat/Battle/Message/255.bmd|0x0047D5": "「掻き回してやるぜ！/　オラオラオラオラーッ！！」", "Battle/Dat/Battle/Message/255.bmd|0x00481F": "「まずはこいつだ！」", "Battle/Dat/Battle/Message/255.bmd|0x00483E": "「ネイル、オープン！」", "Battle/Dat/Battle/Message/255.bmd|0x004860": "「ターネイル・クラッシャー！！/　死ね死ね！　死にやがれぇぇぇ！！」", "Battle/Dat/Battle/Message/255.bmd|0x0048C5": "「ブレイク・フィールド！！」", "Battle/Dat/Battle/Message/255.bmd|0x0048F0": "「フィールド展開！」", "Battle/Dat/Battle/Message/255.bmd|0x00490F": "「どこ見てんだ、馬鹿！」", "Battle/Dat/Battle/Message/255.bmd|0x004934": "「オラオラオラ！/　ぶっ飛べ！　ぶっ飛びやがれぇぇ！！」", "Battle/Dat/Battle/Message/255.bmd|0x004987": "「さあて、仕上げだ！」", "Battle/Dat/Battle/Message/255.bmd|0x0049A9": "「こいつはマジ痛てえぞ！！」", "Battle/Dat/Battle/Message/255.bmd|0x0049D4": "「ソニック・デストロイヤー！！」", "Battle/Dat/Battle/Message/255.bmd|0x004A05": "「ハハッ！　トロい奴だな！」", "Battle/Dat/Battle/Message/255.bmd|0x004A30": "「ターネイル・クラッシャー！！」", "Battle/Dat/Battle/Message/255.bmd|0x004A61": "「そ～ら、地獄の門は！」", "Battle/Dat/Battle/Message/255.bmd|0x004A86": "「すぐそこにあるぜぇぇぇぇ！！」", "Battle/Dat/Battle/Message/255.bmd|0x004AB7": "「あたしら３人で奴を噛み砕くよ！」", "Battle/Dat/Battle/Message/255.bmd|0x004AEB": "「おう！」", "Battle/Dat/Battle/Message/255.bmd|0x004AFB": "「……僕一人でもいいんだけどな」", "Battle/Dat/Battle/Message/255.bmd|0x004B2C": "「ほらほら！！」", "Battle/Dat/Battle/Message/255.bmd|0x004B45": "「踊れ、踊れ！！」", "Battle/Dat/Battle/Message/255.bmd|0x004B61": "「弾の無駄遣いだよね、これ」", "Battle/Dat/Battle/Message/255.bmd|0x004B8C": "「上昇する！」", "Battle/Dat/Battle/Message/255.bmd|0x004BA2": "「ついてきな、シアン！　シオ！」", "Battle/Dat/Battle/Message/255.bmd|0x004BD3": "「二人共、タイミングを合わせな！/　１！」", "Battle/Dat/Battle/Message/255.bmd|0x004C11": "「２！」", "Battle/Dat/Battle/Message/255.bmd|0x004C1E": "「３」", "Battle/Dat/Battle/Message/255.bmd|0x004C28": "「ケルベロス！　ストラァァァァァイク！！」", "Battle/Dat/Battle/Message/256.bmd|0x00289C": "「これまでの分を取り返すのさ！」", "Battle/Dat/Battle/Message/256.bmd|0x0028CD": "「さっさとくたばりな！」", "Battle/Dat/Battle/Message/256.bmd|0x0028F2": "「やってやるよ！」", "Battle/Dat/Battle/Message/256.bmd|0x00290E": "「お前らは踏み台なのさ！/　あたしが出世するためのね！」", "Battle/Dat/Battle/Message/256.bmd|0x002961": "「あたしにリマコンなんて必要ないんだよ！」", "Battle/Dat/Battle/Message/256.bmd|0x0029A1": "「とっとと死にな！」", "Battle/Dat/Battle/Message/256.bmd|0x0029C0": "「さあ、逝っちまいなよ！」", "Battle/Dat/Battle/Message/256.bmd|0x0029E8": "「楽にしてやるよ！」", "Battle/Dat/Battle/Message/256.bmd|0x002A07": "「手柄になりゃ、相手は誰だっていいのさ！」", "Battle/Dat/Battle/Message/256.bmd|0x002A47": "「手柄が立てられれば、/　戦場はどこだっていいのさ！」", "Battle/Dat/Battle/Message/256.bmd|0x002A97": "「この世界にいた方が、稼げそうだからね！」", "Battle/Dat/Battle/Message/256.bmd|0x002AD7": "「死にな、アリエイル！」", "Battle/Dat/Battle/Message/256.bmd|0x002AFC": "「どのみち、/　ベータ・セイバーは目障りだったからねぇ！」", "Battle/Dat/Battle/Message/256.bmd|0x002B52": "「裏切り者は死にな！」", "Battle/Dat/Battle/Message/256.bmd|0x002B74": "「馬鹿だね、/　ガイアセイバーズにいれば、/　いい思いが出来たのにさ！」", "Battle/Dat/Battle/Message/256.bmd|0x002BDD": "「アルジャン・クラスのあたしに/　勝てると思っているのか！」", "Battle/Dat/Battle/Message/256.bmd|0x002C36": "「お前らとあたしらは違うのさ！」", "Battle/Dat/Battle/Message/256.bmd|0x002C67": "「お前らとつるむ気なんてないんだよ！」", "Battle/Dat/Battle/Message/256.bmd|0x002CA1": "「あたしら以外の/　ブーステッド・チルドレンは、/　死ねばいいのさ！」", "Battle/Dat/Battle/Message/256.bmd|0x002D07": "「ふん、ブロンゾ・クラスごときが！」", "Battle/Dat/Battle/Message/256.bmd|0x002D3E": "「落ちこぼれは死ね！」", "Battle/Dat/Battle/Message/256.bmd|0x002D60": "「身の程を知りな、アラド！」", "Battle/Dat/Battle/Message/256.bmd|0x002D8B": "「死にな、ゼオラ！」", "Battle/Dat/Battle/Message/256.bmd|0x002DAA": "「くたばりな、ゼオラ！」", "Battle/Dat/Battle/Message/256.bmd|0x002DCF": "「目障りなんだよ、ラトゥーニ！」", "Battle/Dat/Battle/Message/256.bmd|0x002E00": "「死ね、ラトゥーニ！」", "Battle/Dat/Battle/Message/256.bmd|0x002E22": "「ＡＴＸチームをやりゃあ、いい手柄になる！」", "Battle/Dat/Battle/Message/256.bmd|0x002E65": "「くたばりな、ＡＴＸチーム！」", "Battle/Dat/Battle/Message/256.bmd|0x002E93": "「死にな、ＳＲＸチーム！」", "Battle/Dat/Battle/Message/256.bmd|0x002EBB": "「やってやるよ、ＳＲＸチーム！」", "Battle/Dat/Battle/Message/256.bmd|0x002EEC": "「逝っちまいな、ＳＲＸチーム！」", "Battle/Dat/Battle/Message/256.bmd|0x002F1D": "「ＶＩＰだろうが何だろうが、/　お構いなしなのさ！」", "Battle/Dat/Battle/Message/256.bmd|0x002F6A": "「ラトゥーニと一緒にあの世へ逝きな！」", "Battle/Dat/Battle/Message/256.bmd|0x002FA4": "「鋼龍戦隊か。望む所だよ！」", "Battle/Dat/Battle/Message/256.bmd|0x002FCF": "「鋼龍戦隊……いい獲物じゃないか」", "Battle/Dat/Battle/Message/256.bmd|0x003003": "「鋼龍戦隊の連中を落とせば、/　いい手柄になる！」", "Battle/Dat/Battle/Message/256.bmd|0x00304D": "「くたばりな、鋼龍戦隊！」", "Battle/Dat/Battle/Message/256.bmd|0x003075": "「鋼龍戦隊、お前らは死ねばいいんだよ！」", "Battle/Dat/Battle/Message/256.bmd|0x0030B2": "「今、あいつらを始末しといた方がいいかもね」", "Battle/Dat/Battle/Message/256.bmd|0x0030F5": "「ガイアセイバーズに逆らうなんて、/　馬鹿な連中だよ！」", "Battle/Dat/Battle/Message/256.bmd|0x003148": "「地獄の番犬同士で勝負といこうか！」", "Battle/Dat/Battle/Message/256.bmd|0x00317F": "「あたしの機体もケルベロスなのさ！」", "Battle/Dat/Battle/Message/256.bmd|0x0031B6": "「アルトアイゼン……金星だね！」", "Battle/Dat/Battle/Message/256.bmd|0x0031E7": "「ヴァイスを落とせば、手柄になる！」", "Battle/Dat/Battle/Message/256.bmd|0x00321E": "「特機はいい稼ぎになるからね！」", "Battle/Dat/Battle/Message/256.bmd|0x00324F": "「目立つ奴から片付ける！」", "Battle/Dat/Battle/Message/256.bmd|0x003277": "「雑魚より大物狙いさ！」", "Battle/Dat/Battle/Message/256.bmd|0x00329C": "「あの特機は、あたしの獲物だよ！」", "Battle/Dat/Battle/Message/256.bmd|0x0032D0": "「大物を落とすと、儲かるのさ！」", "Battle/Dat/Battle/Message/256.bmd|0x003301": "「くたばりな、ヴァルシオーネ！」", "Battle/Dat/Battle/Message/256.bmd|0x003332": "「ヴァルシオーネ！　その首、もらうよ！」", "Battle/Dat/Battle/Message/256.bmd|0x00336F": "「ちゃちいリオンだねぇ！」", "Battle/Dat/Battle/Message/256.bmd|0x003397": "「ダブルＧは大金星だ！　やってやるよ！」", "Battle/Dat/Battle/Message/256.bmd|0x0033D4": "「ダブルＧを仕留めりゃ、/　この上ない手柄だよ！」", "Battle/Dat/Battle/Message/256.bmd|0x00341E": "「いただくよ、ダイゼンガー！」"}