{"Battle/Dat/Battle/Message/059.bmd|0x009526": "「後はボクに任しとき！/　……だから、これは何だ？」", "Battle/Dat/Battle/Message/059.bmd|0x009573": "「中尉の後に続く……！」", "Battle/Dat/Battle/Message/059.bmd|0x009598": "「中尉と私の連携ならば……！」", "Battle/Dat/Battle/Message/059.bmd|0x0095C6": "「中尉、援護しますです」", "Battle/Dat/Battle/Message/059.bmd|0x0095EB": "「中尉、後はお任せしちゃったり……/　いや、お任せを」", "Battle/Dat/Battle/Message/059.bmd|0x00963B": "「エクセ姉様、後は私が」", "Battle/Dat/Battle/Message/059.bmd|0x009660": "「エクセ姉様……/　後は私に任せるということか」", "Battle/Dat/Battle/Message/059.bmd|0x0096A7": "「エクセ姉様、援護するですの」", "Battle/Dat/Battle/Message/059.bmd|0x0096D5": "「ブルックリン少尉、援護する」", "Battle/Dat/Battle/Message/059.bmd|0x009703": "「援護するぞ、少尉」", "Battle/Dat/Battle/Message/059.bmd|0x009722": "「少佐、後は私が」", "Battle/Dat/Battle/Message/059.bmd|0x00973E": "「隊長、援護します」", "Battle/Dat/Battle/Message/059.bmd|0x00975D": "「カイ少佐、援護しちゃいますのことよ」", "Battle/Dat/Battle/Message/059.bmd|0x009797": "「ゼオラ、援護する」", "Battle/Dat/Battle/Message/059.bmd|0x0097B6": "「ゼオラ、お前は先に行け」", "Battle/Dat/Battle/Message/059.bmd|0x0097DE": "「アラド、どこへ行くつもりだ？」", "Battle/Dat/Battle/Message/059.bmd|0x00980F": "「待て、アラド。……もう遅いか」", "Battle/Dat/Battle/Message/059.bmd|0x009840": "「ラトゥーニ、あの敵は私に任せろ」", "Battle/Dat/Battle/Message/059.bmd|0x009874": "「援護するぞ、ラトゥーニ」", "Battle/Dat/Battle/Message/059.bmd|0x00989C": "「ギリアム少佐、あの敵は私が」", "Battle/Dat/Battle/Message/059.bmd|0x0098CA": "「援護するぞ、ラウル」", "Battle/Dat/Battle/Message/059.bmd|0x0098EC": "「アクセル隊長、バックアップします」", "Battle/Dat/Battle/Message/059.bmd|0x009923": "「隊長……/　ああ見えてこちらの動きも計算の内か」", "Battle/Dat/Battle/Message/059.bmd|0x00996D": "「隊長、後はボク……/　いや、私が」", "Battle/Dat/Battle/Message/059.bmd|0x0099A2": "「フッ……/　以前では考えられなかった連携だな」", "Battle/Dat/Battle/Message/059.bmd|0x0099E9": "「ＳＲＸチームを援護する」", "Battle/Dat/Battle/Message/059.bmd|0x009A11": "「的確な攻撃だな、アリエイル」", "Battle/Dat/Battle/Message/059.bmd|0x009A3F": "「彼女とはタイミングが合わせ易い……！」", "Battle/Dat/Battle/Message/059.bmd|0x009A7C": "「彼女は私の動きも計算に入れていたか」", "Battle/Dat/Battle/Message/059.bmd|0x009AB6": "「ヒューゴ少尉、カバーに入る」", "Battle/Dat/Battle/Message/059.bmd|0x009AE4": "「後は任せろ、ヒューゴ少尉」", "Battle/Dat/Battle/Message/059.bmd|0x009B0F": "「アクア、援護する」", "Battle/Dat/Battle/Message/059.bmd|0x009B2E": "「連係で行くぞ、アクア」", "Battle/Dat/Battle/Message/059.bmd|0x009B53": "「ジョッシュ、援護する」", "Battle/Dat/Battle/Message/059.bmd|0x009B78": "「ジョッシュ、/　あのターゲットは私が引き受ける」", "Battle/Dat/Battle/Message/059.bmd|0x009BC2": "「リム、後はボク……もとい、私が」", "Battle/Dat/Battle/Message/059.bmd|0x009BF6": "「道を開けてくれ、リム」", "Battle/Dat/Battle/Message/059.bmd|0x009C1B": "「クスハ、後は私に任せろ」", "Battle/Dat/Battle/Message/059.bmd|0x009C43": "「熱くなり過ぎるな、コウタ」", "Battle/Dat/Battle/Message/059.bmd|0x009C6E": "「イング、バックアップする」", "Battle/Dat/Battle/Message/059.bmd|0x009C99": "「イングのカバーに入る」", "Battle/Dat/Battle/Message/059.bmd|0x009CBE": "「こちらなら受け止められる」", "Battle/Dat/Battle/Message/059.bmd|0x009CE9": "「悪いが、割り込むぞ」", "Battle/Dat/Battle/Message/059.bmd|0x009D0B": "「こちらには気づかなかったようだな」", "Battle/Dat/Battle/Message/059.bmd|0x009D42": "「お下がりなすって！」", "Battle/Dat/Battle/Message/059.bmd|0x009D64": "「そこをどきんしゃ～い！　いや、これは！」", "Battle/Dat/Battle/Message/059.bmd|0x009DA4": "「ここは任せてちょんまげ！/　……ちょんまげ？」", "Battle/Dat/Battle/Message/059.bmd|0x009DEB": "「中尉、すぐに後退を」", "Battle/Dat/Battle/Message/059.bmd|0x009E0D": "「中尉を狙ってきたか……！」", "Battle/Dat/Battle/Message/059.bmd|0x009E38": "「中尉、逃げちゃって下さりませ」", "Battle/Dat/Battle/Message/059.bmd|0x009E69": "「エクセ姉様、今の内に離脱を」", "Battle/Dat/Battle/Message/059.bmd|0x009E97": "「エクセ姉様、お下がりなさってください」", "Battle/Dat/Battle/Message/059.bmd|0x009ED4": "「少尉、今の内に後退を」", "Battle/Dat/Battle/Message/059.bmd|0x009EF9": "「少佐、すぐに後退を」", "Battle/Dat/Battle/Message/059.bmd|0x009F1B": "「隊長、お下がりなすって！」", "Battle/Dat/Battle/Message/059.bmd|0x009F46": "「危険でございましょう、隊長！」", "Battle/Dat/Battle/Message/059.bmd|0x009F77": "「少佐、後退しなんせ！」", "Battle/Dat/Battle/Message/059.bmd|0x009F9C": "「少佐、/　危なかったりなんかしちゃったりして！」", "Battle/Dat/Battle/Message/059.bmd|0x009FE6": "「ゼオラ、私が時間を稼ぐ」", "Battle/Dat/Battle/Message/059.bmd|0x00A00E": "「アラド、ペナルティだぞ」", "Battle/Dat/Battle/Message/059.bmd|0x00A036": "「下がれ、ラトゥーニ」", "Battle/Dat/Battle/Message/059.bmd|0x00A058": "「無理をするな、ラウル」", "Battle/Dat/Battle/Message/059.bmd|0x00A07D": "「アクセル隊長、/　迂闊でございますです」", "Battle/Dat/Battle/Message/059.bmd|0x00A0BB": "「隊長をやらせるわけには……！」", "Battle/Dat/Battle/Message/059.bmd|0x00A0EC": "「速やかに離脱しろ、アリエイル」", "Battle/Dat/Battle/Message/059.bmd|0x00A11D": "「退け、アリエイル」", "Battle/Dat/Battle/Message/059.bmd|0x00A13C": "「後退するんだ、ヒューゴ少尉」", "Battle/Dat/Battle/Message/059.bmd|0x00A16A": "「下がるんだ、アクア」", "Battle/Dat/Battle/Message/059.bmd|0x00A18C": "「ここは後退するべきだ、ジョッシュ」", "Battle/Dat/Battle/Message/059.bmd|0x00A1C3": "「リム、そこから離脱しろ」", "Battle/Dat/Battle/Message/059.bmd|0x00A1EB": "「コウタ、前に出過ぎるな」", "Battle/Dat/Battle/Message/059.bmd|0x00A213": "「下がれ、イング」", "Battle/Dat/Battle/Message/059.bmd|0x00A22F": "「効率良く攻撃すれば……！」", "Battle/Dat/Battle/Message/059.bmd|0x00A25A": "「貴様らの陣形……利用させてもらう！」", "Battle/Dat/Battle/Message/059.bmd|0x00A294": "「再攻撃可能と判断」", "Battle/Dat/Battle/Message/059.bmd|0x00A2B3": "「離脱しないのであれば……！」", "Battle/Dat/Battle/Message/059.bmd|0x00A2E1": "「運がなかったな」", "Battle/Dat/Battle/Message/059.bmd|0x00A2FD": "「再度攻撃しちゃいますのことよ」", "Battle/Dat/Battle/Message/059.bmd|0x00A32E": "「スプリットミサイル、発射！」", "Battle/Dat/Battle/Message/059.bmd|0x00A35C": "「行けっ！」", "Battle/Dat/Battle/Message/059.bmd|0x00A36F": "「切り裂く！」", "Battle/Dat/Battle/Message/059.bmd|0x00A385": "「照準セット……」", "Battle/Dat/Battle/Message/059.bmd|0x00A3A1": "「ハイ・ツインランチャー、発射！」", "Battle/Dat/Battle/Message/059.bmd|0x00A3D5": "「受けろ……！」", "Battle/Dat/Battle/Message/059.bmd|0x00A3EE": "「撃ち抜く！！」", "Battle/Dat/Battle/Message/059.bmd|0x00A407": "「この剣を受けきれるか！」", "Battle/Dat/Battle/Message/059.bmd|0x00A42F": "「切り裂く……！」", "Battle/Dat/Battle/Message/059.bmd|0x00A44B": "「ミラージュ・ソード、Ｅモード……！」", "Battle/Dat/Battle/Message/059.bmd|0x00A485": "「幻影の槍よ……行けっ！」", "Battle/Dat/Battle/Message/059.bmd|0x00A4AD": "「シャドウ・ランサー！」", "Battle/Dat/Battle/Message/059.bmd|0x00A4D2": "「ミドルレンジ……ならば、これで！」", "Battle/Dat/Battle/Message/059.bmd|0x00A509": "「行くぞ……！」", "Battle/Dat/Battle/Message/059.bmd|0x00A522": "「ミラージュ……サイン！」", "Battle/Dat/Battle/Message/059.bmd|0x00A54A": "「見極められるか……？」", "Battle/Dat/Battle/Message/059.bmd|0x00A56F": "「この幻影の印を！」", "Battle/Dat/Battle/Message/059.bmd|0x00A58E": "「ミラージュ・サイン！」", "Battle/Dat/Battle/Message/059.bmd|0x00A5B3": "「イリュージョン・アロー、セット……！」", "Battle/Dat/Battle/Message/059.bmd|0x00A5F0": "「狙いは……外さん！」", "Battle/Dat/Battle/Message/059.bmd|0x00A612": "「照準セット……！」", "Battle/Dat/Battle/Message/059.bmd|0x00A631": "「イリュージョン・アロー！」", "Battle/Dat/Battle/Message/059.bmd|0x00A65C": "「イリュージョン・アロー……！」", "Battle/Dat/Battle/Message/059.bmd|0x00A68D": "「幻影の矢を見るがいい！」", "Battle/Dat/Battle/Message/059.bmd|0x00A6B5": "「リミット、解除……！」", "Battle/Dat/Battle/Message/059.bmd|0x00A6DA": "「コード・ファントム・フェニックス！」", "Battle/Dat/Battle/Message/059.bmd|0x00A714": "「リミット、解除。コード、入力……！」", "Battle/Dat/Battle/Message/059.bmd|0x00A74E": "「行け！　ファントム・フェニックス！」", "Battle/Dat/Battle/Message/059.bmd|0x00A788": "「最大出力……！　照準セット！」", "Battle/Dat/Battle/Message/059.bmd|0x00A7B9": "「ファントム・フェニックス！」", "Battle/Dat/Battle/Message/059.bmd|0x00A7E7": "「コード入力、ファントム・フェニックス！」", "Battle/Dat/Battle/Message/059.bmd|0x00A827": "「飛べ、幽炎の鳳凰よ！！」", "Battle/Dat/Battle/Message/059.bmd|0x00A84F": "「リミット解除、イヤッホウ！」", "Battle/Dat/Battle/Message/059.bmd|0x00A87D": "「ファントム・フェニックスで/　ぶっ飛びやがりーの！！」", "Battle/Dat/Battle/Message/059.bmd|0x00A8D0": "「この間合い……外さん！」", "Battle/Dat/Battle/Message/059.bmd|0x00A8F8": "「烈火刃！」", "Battle/Dat/Battle/Message/059.bmd|0x00A90B": "「烈火刃！　行け！」", "Battle/Dat/Battle/Message/059.bmd|0x00A92A": "「この烈火刃で！」", "Battle/Dat/Battle/Message/059.bmd|0x00A946": "「爪牙！　水の流れの如く！」", "Battle/Dat/Battle/Message/059.bmd|0x00A971": "「とどめだ！！」", "Battle/Dat/Battle/Message/059.bmd|0x00A98A": "「もらった！」", "Battle/Dat/Battle/Message/059.bmd|0x00A9A0": "「水流爪牙！！」"}