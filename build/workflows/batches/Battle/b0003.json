{"Battle/Dat/Battle/Message/002.bmd|0x00AA7E": "「どこ見てんだ！　隙だらけだぜ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00AAB5": "「まだだ！　もう一撃！！」", "Battle/Dat/Battle/Message/002.bmd|0x00AADD": "「こいつはおまけだ！　とっときなっ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00AB1A": "「助太刀するぜっ！」", "Battle/Dat/Battle/Message/002.bmd|0x00AB39": "「まだだっ！　次は俺が行く！」", "Battle/Dat/Battle/Message/002.bmd|0x00AB67": "「援護するぜ！」", "Battle/Dat/Battle/Message/002.bmd|0x00AB80": "「次は俺が相手だっ！」", "Battle/Dat/Battle/Message/002.bmd|0x00ABA2": "「ここは俺に任せなっ！」", "Battle/Dat/Battle/Message/002.bmd|0x00ABC7": "「まだ終わってねぇぜっ！」", "Battle/Dat/Battle/Message/002.bmd|0x00ABEF": "「チャンスニャ、マサキ！」", "Battle/Dat/Battle/Message/002.bmd|0x00AC17": "「よ～し、もういっちょ！」", "Battle/Dat/Battle/Message/002.bmd|0x00AC3F": "「敵機が逃げていくニャ！」", "Battle/Dat/Battle/Message/002.bmd|0x00AC67": "「まだいけるニャ！」", "Battle/Dat/Battle/Message/002.bmd|0x00AC86": "「リューネ、ここは任せなっ！」", "Battle/Dat/Battle/Message/002.bmd|0x00ACB4": "「リューネ、手を貸すぜ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00ACDF": "「後は俺に任せろ、リューネ！」", "Battle/Dat/Battle/Message/002.bmd|0x00AD0D": "「リューネ！　後は俺に任せなっ！」", "Battle/Dat/Battle/Message/002.bmd|0x00AD41": "「シュウ……！　妙な真似をしやがったら……/　このままてめえを撃つ！」", "Battle/Dat/Battle/Message/002.bmd|0x00ADA9": "「ちっ、シュウめ。/　てめえの後始末くらい自分でやれっての！」", "Battle/Dat/Battle/Message/002.bmd|0x00AE05": "「手を貸すぜ、リュウセイ！」", "Battle/Dat/Battle/Message/002.bmd|0x00AE30": "「リュウセイ！　後は任せな！」", "Battle/Dat/Battle/Message/002.bmd|0x00AE5E": "「手伝うぜ、ブリット！」", "Battle/Dat/Battle/Message/002.bmd|0x00AE83": "「援護するぜ、キョウスケ！」", "Battle/Dat/Battle/Message/002.bmd|0x00AEAE": "「正面突破はおめえらの十八番だろ！/　先に行け！」", "Battle/Dat/Battle/Message/002.bmd|0x00AEF8": "「エクセレン、後は俺がやっとくぜ！」", "Battle/Dat/Battle/Message/002.bmd|0x00AF2F": "「アラド！　おめえは先に行け！」", "Battle/Dat/Battle/Message/002.bmd|0x00AF60": "「アイビス！　後は任せな！」", "Battle/Dat/Battle/Message/002.bmd|0x00AF8B": "「援護するぜ、ジョッシュ！」", "Battle/Dat/Battle/Message/002.bmd|0x00AFB6": "「リム、後は任せな！」", "Battle/Dat/Battle/Message/002.bmd|0x00AFD8": "「アリエイル、後は俺がやる！」", "Battle/Dat/Battle/Message/002.bmd|0x00B006": "「イング、後は任せな！」", "Battle/Dat/Battle/Message/002.bmd|0x00B02B": "「トウマ、手伝ってやるぜ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B056": "「ミチル、後始末は任せな！」", "Battle/Dat/Battle/Message/002.bmd|0x00B081": "「テュッティ、後は任せな！」", "Battle/Dat/Battle/Message/002.bmd|0x00B0AC": "「どうした、ヤンロン？/　俺がとどめ刺していいのか？」", "Battle/Dat/Battle/Message/002.bmd|0x00B0FC": "「よーし、ミオ！　俺が片を付けてやるぜ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B13C": "「俺に任せときな、セニア！」", "Battle/Dat/Battle/Message/002.bmd|0x00B167": "「後は俺がやってやるぜ、ゲンナジー！」", "Battle/Dat/Battle/Message/002.bmd|0x00B1A1": "「おし、おっさん！/　後は俺が片を付けてやるぜ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B1EB": "「討ち漏らしたな、ザッシュ。/　ま、後は俺がやってやるよ」", "Battle/Dat/Battle/Message/002.bmd|0x00B241": "「てめえの手伝いなんざ御免だが、/　ま、今回は特別だ」", "Battle/Dat/Battle/Message/002.bmd|0x00B291": "「ちっ！　やらせるかよっ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B2BC": "「このっ！　させるか！」", "Battle/Dat/Battle/Message/002.bmd|0x00B2E1": "「俺が受け止めてやるっ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B309": "「俺が護ってやる！」", "Battle/Dat/Battle/Message/002.bmd|0x00B328": "「下がれ、リューネ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B34A": "「リューネ！　突っ込み過ぎだ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B37B": "「させるかっ！　リューネ、俺に任せろっ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B3BB": "「しょうがねえ……！　助けてやるぜ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B3F5": "「ちっ、シュウ、てめえを守るとはな。/　まったく、世も末だぜ」", "Battle/Dat/Battle/Message/002.bmd|0x00B451": "「下がれ、ジョッシュ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B476": "「リム、早く逃げろ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B498": "「下がれ、アリエイル！」", "Battle/Dat/Battle/Message/002.bmd|0x00B4BD": "「イング、ここは任せろ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B4E5": "「下がれ、トウマ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B504": "「ミチル、何やってんだ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B52C": "「テュッティ、俺の後ろに下がれ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B560": "「無理すんな、ヤンロン！」", "Battle/Dat/Battle/Message/002.bmd|0x00B588": "「ちっ、/　ザムジードのタフさを過信しすぎだぞ、ミオ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B5DB": "「無理すんな、セニア！」", "Battle/Dat/Battle/Message/002.bmd|0x00B600": "「危ねえっ！　プレシア、下がれ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00B637": "「ゲンナジー、俺が受け持つ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B665": "「おっさん！　無理すんなって！」", "Battle/Dat/Battle/Message/002.bmd|0x00B696": "「何やってる、ザッシュ！/　ぼーっとしてんじゃねぇ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B6E6": "「まとめて片づけてやるぜ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B711": "「もう一撃、叩き込んでやる！」", "Battle/Dat/Battle/Message/002.bmd|0x00B73F": "「ヘッ、/　まだそんな所でグズグズしてやがったか！」", "Battle/Dat/Battle/Message/002.bmd|0x00B78C": "「サイバスターなら、まだ行ける！」", "Battle/Dat/Battle/Message/002.bmd|0x00B7C0": "「いけぇっ！　カロリックミサイル！！」", "Battle/Dat/Battle/Message/002.bmd|0x00B7FA": "「いっけぇぇっ！！/　サイフラァァァッシュ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00B841": "「いけっ！　ハイファミリア！！」", "Battle/Dat/Battle/Message/002.bmd|0x00B872": "「待ってましたニャ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B894": "「あたし達にまかせて！」", "Battle/Dat/Battle/Message/002.bmd|0x00B8B9": "「おいら達にまかせときニャって！」", "Battle/Dat/Battle/Message/002.bmd|0x00B8ED": "「行くニャ、シロ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B90C": "「あたし達に、おまかせニャ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B93A": "「たのんだぜ、クロ、シロ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B965": "「ＯＫニャ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B97B": "「クロ、シロ！　お前達の出番だぜ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B9B2": "「よし、ハイファミリアだ！」", "Battle/Dat/Battle/Message/002.bmd|0x00B9DD": "「やってやるぜっ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00B9FF": "「やるのはあたし達ニャんだケドね……」", "Battle/Dat/Battle/Message/002.bmd|0x00BA39": "「ニャ～んか最近、/　おいら達の扱いが荒くなってきたニャ……」", "Battle/Dat/Battle/Message/002.bmd|0x00BA95": "「ぶつくさ言わニャいの！」", "Battle/Dat/Battle/Message/002.bmd|0x00BABD": "「任せたぜ！　クロ、シロ！」", "Battle/Dat/Battle/Message/002.bmd|0x00BAE8": "「猫使いが荒いニャ～！」", "Battle/Dat/Battle/Message/002.bmd|0x00BB0D": "「そんニャこと言ってる場合じゃ/　ニャいでしょ！」", "Battle/Dat/Battle/Message/002.bmd|0x00BB57": "「行けっ、クロ、シロ！」", "Battle/Dat/Battle/Message/002.bmd|0x00BB7C": "「ＯＫ！」", "Battle/Dat/Battle/Message/002.bmd|0x00BB8C": "「任せるニャ！」", "Battle/Dat/Battle/Message/002.bmd|0x00BBA5": "「クロ、シロ、出番だぜ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00BBD0": "「待ってたニャン！」", "Battle/Dat/Battle/Message/002.bmd|0x00BBEF": "「いっちょやってやるニャ！」", "Battle/Dat/Battle/Message/002.bmd|0x00BC1A": "「お前らに任せるぜ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00BC3F": "「やれやれ」", "Battle/Dat/Battle/Message/002.bmd|0x00BC52": "「ファミリア使いが荒いニャ」", "Battle/Dat/Battle/Message/002.bmd|0x00BC7D": "「ディスカッター、霞斬り！」", "Battle/Dat/Battle/Message/002.bmd|0x00BCA8": "「おらおらおらおらっ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00BCD0": "「行くぞ！　ディスカッター、霞斬りぃっ！」", "Battle/Dat/Battle/Message/002.bmd|0x00BD10": "「ディスカッターでぶった斬ってやる！」", "Battle/Dat/Battle/Message/002.bmd|0x00BD4A": "「魔法剣エーテルちゃぶ台返し！」", "Battle/Dat/Battle/Message/002.bmd|0x00BD7B": "「そんな技、ニャいニャ」", "Battle/Dat/Battle/Message/002.bmd|0x00BDA0": "「てめえの存在、その何もかもを/　アカシックレコードから消してやる！」", "Battle/Dat/Battle/Message/002.bmd|0x00BE08": "「サイバード・チェンジ！」", "Battle/Dat/Battle/Message/002.bmd|0x00BE30": "「アァァカシックバスタァァァァァッ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00BE6D": "「行くぞ、アカシックレコードサーチ！」", "Battle/Dat/Battle/Message/002.bmd|0x00BEA7": "「くらえっ！/　アァァカシックバスタァァァッ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00BEF1": "「貫けぇぇぇっ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00BF10": "「行っけぇぇぇぇぇっ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00BF38": "「こいつのパワーは桁違いだぜ！」", "Battle/Dat/Battle/Message/002.bmd|0x00BF69": "「マクスウェルコイル、充電完了！」", "Battle/Dat/Battle/Message/002.bmd|0x00BF9D": "「全自動追尾、セットＯＫ！」", "Battle/Dat/Battle/Message/002.bmd|0x00BFC8": "「こいつは痛いぜっ！！　コスモノヴァ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00C008": "「全エネルギーを集中！！」", "Battle/Dat/Battle/Message/002.bmd|0x00C030": "「プラーニャ指数、限界値突破！」", "Battle/Dat/Battle/Message/002.bmd|0x00C061": "「行けるニャ、マサキ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00C089": "「これで終わりだっ！！　コスモノヴァ！！」", "Battle/Dat/Battle/Message/002.bmd|0x00C0C9": "「バニティリッパー！」", "Battle/Dat/Battle/Message/002.bmd|0x00C0EB": "「とっておきを見せてやるぜ！」", "Battle/Dat/Battle/Message/002.bmd|0x00C119": "「でえいっ！」"}