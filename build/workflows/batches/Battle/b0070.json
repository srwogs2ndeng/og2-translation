{"Battle/Dat/Battle/Message/043.bmd|0x0053E9": "「あの念は……強過ぎる！」", "Battle/Dat/Battle/Message/043.bmd|0x005411": "「ガンエデンに同調しちゃいけない……！」", "Battle/Dat/Battle/Message/043.bmd|0x00544E": "「ちょっと危なかった……？」", "Battle/Dat/Battle/Message/043.bmd|0x005479": "「あいつ、ちょっと気持ち悪い……」", "Battle/Dat/Battle/Message/043.bmd|0x0054AD": "「リュウが見せてくれたアニメに/　あんなのが出てたけど……」", "Battle/Dat/Battle/Message/043.bmd|0x005506": "「バリア展開！」", "Battle/Dat/Battle/Message/043.bmd|0x00551F": "「防御装置が作動した……！」", "Battle/Dat/Battle/Message/043.bmd|0x00554A": "「これなら……！」", "Battle/Dat/Battle/Message/043.bmd|0x005566": "「念動フィールド！」", "Battle/Dat/Battle/Message/043.bmd|0x005585": "「あたしの念で……！」", "Battle/Dat/Battle/Message/043.bmd|0x0055A7": "「Ｔ‐ＬＩＮＫフルコンタクト！」", "Battle/Dat/Battle/Message/043.bmd|0x0055D8": "「念動フィールド、展開……！」", "Battle/Dat/Battle/Message/043.bmd|0x005606": "「フィールド展開が、間に合った……！」", "Battle/Dat/Battle/Message/043.bmd|0x005640": "「………」", "Battle/Dat/Battle/Message/043.bmd|0x005650": "「攻撃不可能！？　そんな……！」", "Battle/Dat/Battle/Message/043.bmd|0x005681": "「な、何もできないの……！？」", "Battle/Dat/Battle/Message/043.bmd|0x0056AF": "「敵を見失うなんて……！」", "Battle/Dat/Battle/Message/043.bmd|0x0056D7": "「どこへ行った……？」", "Battle/Dat/Battle/Message/043.bmd|0x0056F9": "「まだ私もいる……！」", "Battle/Dat/Battle/Message/043.bmd|0x00571B": "「今だ、前進を！」", "Battle/Dat/Battle/Message/043.bmd|0x005737": "「その隙は見逃さない！」", "Battle/Dat/Battle/Message/043.bmd|0x00575C": "「リュウ、後は任せて！」", "Battle/Dat/Battle/Message/043.bmd|0x005781": "「リュウが隙を作ってくれた……！」", "Battle/Dat/Battle/Message/043.bmd|0x0057B5": "「リュウと私の連係で！」", "Battle/Dat/Battle/Message/043.bmd|0x0057DA": "「ライディース、続けていく！」", "Battle/Dat/Battle/Message/043.bmd|0x005808": "「ライディース、援護する……！」", "Battle/Dat/Battle/Message/043.bmd|0x005839": "「アヤ、私も続く……！」", "Battle/Dat/Battle/Message/043.bmd|0x00585E": "「二人で力を合わせれば！」", "Battle/Dat/Battle/Message/043.bmd|0x005886": "「アヤの力になる……！」", "Battle/Dat/Battle/Message/043.bmd|0x0058AB": "「隊長、援護する……！」", "Battle/Dat/Battle/Message/043.bmd|0x0058D0": "「ヴィレッタ隊長、後は私が……！」", "Battle/Dat/Battle/Message/043.bmd|0x005904": "「ラトゥーニ、後は任せて」", "Battle/Dat/Battle/Message/043.bmd|0x00592C": "「手伝うよ、ラトゥーニ」", "Battle/Dat/Battle/Message/043.bmd|0x005951": "「シャイン王女、後は私が……！」", "Battle/Dat/Battle/Message/043.bmd|0x005982": "「マサキやシロ、クロのためにも……！」", "Battle/Dat/Battle/Message/043.bmd|0x0059BC": "「イング、援護する……！」", "Battle/Dat/Battle/Message/043.bmd|0x0059E4": "「アラド、もう離脱するの……！？」", "Battle/Dat/Battle/Message/043.bmd|0x005A18": "「そちらの好きにさせるものか！」", "Battle/Dat/Battle/Message/043.bmd|0x005A49": "「これぐらいのことはさせてもらう！」", "Battle/Dat/Battle/Message/043.bmd|0x005A80": "「危ない、リュウ！」", "Battle/Dat/Battle/Message/043.bmd|0x005A9F": "「あたしがリュウを守ってみせる……！」", "Battle/Dat/Battle/Message/043.bmd|0x005AD9": "「ライディース、下がって！」", "Battle/Dat/Battle/Message/043.bmd|0x005B04": "「アヤをやらせはしない！」", "Battle/Dat/Battle/Message/043.bmd|0x005B2C": "「隊長、下がって！」", "Battle/Dat/Battle/Message/043.bmd|0x005B4B": "「ラトゥーニ、早く逃げて！」", "Battle/Dat/Battle/Message/043.bmd|0x005B76": "「イング、今の内に！」", "Battle/Dat/Battle/Message/043.bmd|0x005B98": "「チャンスは逃がさない！」", "Battle/Dat/Battle/Message/043.bmd|0x005BC0": "「当ててみせる！」", "Battle/Dat/Battle/Message/043.bmd|0x005BDC": "「ここから追い込む！」", "Battle/Dat/Battle/Message/043.bmd|0x005BFE": "「今なら！」", "Battle/Dat/Battle/Message/043.bmd|0x005C11": "「まだ追いつける！」", "Battle/Dat/Battle/Message/043.bmd|0x005C30": "「スプリットミサイル！」", "Battle/Dat/Battle/Message/043.bmd|0x005C55": "「落ちろ！」", "Battle/Dat/Battle/Message/043.bmd|0x005C68": "「まだまだ！」", "Battle/Dat/Battle/Message/043.bmd|0x005C7E": "「フィニッシュ！」", "Battle/Dat/Battle/Message/043.bmd|0x005C9A": "「見えた！」", "Battle/Dat/Battle/Message/043.bmd|0x005CAD": "「行くぞ、みんな！」", "Battle/Dat/Battle/Message/043.bmd|0x005CCC": "「了解した」", "Battle/Dat/Battle/Message/043.bmd|0x005CDF": "「システムコネクト……！　マイ、行くわよ！」", "Battle/Dat/Battle/Message/043.bmd|0x005D22": "「わかった、アヤ……！/　Ｔ‐ＬＩＮＫツインコンタクト！」", "Battle/Dat/Battle/Message/043.bmd|0x005D78": "「メタルジェノサイダーモード、起動！」", "Battle/Dat/Battle/Message/043.bmd|0x005DB2": "「トロニウム・エンジン、フルドライブ！」", "Battle/Dat/Battle/Message/043.bmd|0x005DEF": "「リュウ、トリガーを預けるわ！」", "Battle/Dat/Battle/Message/043.bmd|0x005E20": "「おう！！」", "Battle/Dat/Battle/Message/043.bmd|0x005E33": "「くらえ！　天下無敵の……！！」", "Battle/Dat/Battle/Message/043.bmd|0x005E64": "「一撃必殺砲ぉぉっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x005E89": "「受けてもらう……！」", "Battle/Dat/Battle/Message/043.bmd|0x005EAB": "「この間合いなら！」", "Battle/Dat/Battle/Message/043.bmd|0x005ECA": "「ファイア！」", "Battle/Dat/Battle/Message/043.bmd|0x005EE0": "「シュート！」", "Battle/Dat/Battle/Message/043.bmd|0x005EF6": "「敵の行動パターンを……！」", "Battle/Dat/Battle/Message/043.bmd|0x005F21": "「ターゲット・ロック……！」", "Battle/Dat/Battle/Message/043.bmd|0x005F4C": "「行けっ！」", "Battle/Dat/Battle/Message/043.bmd|0x005F5F": "「狙いは定まった……！」", "Battle/Dat/Battle/Message/043.bmd|0x005F84": "「一気に仕掛ける……！」", "Battle/Dat/Battle/Message/043.bmd|0x005FA9": "「リュウみたいにやってみる……！」", "Battle/Dat/Battle/Message/043.bmd|0x005FDD": "「連続攻撃……かわせるか！」", "Battle/Dat/Battle/Message/043.bmd|0x006008": "「Ｔ‐ＬＩＮＫフルコンタクト！/　はああああっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x006055": "「Ｔ‐ＬＩＮＫ！　ブレードナックル！！」", "Battle/Dat/Battle/Message/043.bmd|0x006092": "「はあああっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x0060AE": "「ええーいっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x0060CA": "「Ｔ‐ＬＩＮＫ！　ブレードナッコォォ！！」", "Battle/Dat/Battle/Message/043.bmd|0x00610A": "「おりゃおりゃおりゃおりゃおりゃおりゃー！！」", "Battle/Dat/Battle/Message/043.bmd|0x006150": "「破ぁぁっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x006169": "「コンビネーションで仕掛ける！」", "Battle/Dat/Battle/Message/043.bmd|0x00619A": "「つかまえた……！」", "Battle/Dat/Battle/Message/043.bmd|0x0061B9": "「リュウ譲りのコンボだ！」", "Battle/Dat/Battle/Message/043.bmd|0x0061E1": "「ブーステッド・ライフル！」", "Battle/Dat/Battle/Message/043.bmd|0x00620C": "「リュウみたいにやってみる！」", "Battle/Dat/Battle/Message/043.bmd|0x00623A": "「ブーステッド・ライフォー！！」", "Battle/Dat/Battle/Message/043.bmd|0x00626B": "「出し惜しみはしない……！」", "Battle/Dat/Battle/Message/043.bmd|0x006296": "「ターゲット・ファイナルロック！」", "Battle/Dat/Battle/Message/043.bmd|0x0062CA": "「行けぇぇぇぇっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x0062EC": "「えええーいっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x00630B": "「Ｔ‐ＬＩＮＫクラッシュソード！！」", "Battle/Dat/Battle/Message/043.bmd|0x006342": "「くらえ！　くらえっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x00636A": "「Ｔ‐ＬＩＮＫ！　ズバッシャアァァッ！！」", "Battle/Dat/Battle/Message/043.bmd|0x0063AA": "「突撃ぃぃぃぃっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x0063CC": "「マイ、念動連撃拳で行くぞ！」", "Battle/Dat/Battle/Message/043.bmd|0x0063FA": "「うん！」", "Battle/Dat/Battle/Message/043.bmd|0x00640A": "「チェェーーンジ！　Ｒ‐ウィング！！」", "Battle/Dat/Battle/Message/043.bmd|0x006444": "「くらえ、くらえ、くらえぇぇっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x00647B": "「Ｔ‐ＬＩＮＫナッコォッ！！」", "Battle/Dat/Battle/Message/043.bmd|0x0064A9": "「ええいっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x0064C2": "「よっしゃあ！　続けて行くぞ！！」", "Battle/Dat/Battle/Message/043.bmd|0x0064F6": "「リボルヴァーキャノン！/　ランダムシューーッ！！」", "Battle/Dat/Battle/Message/043.bmd|0x006543": "「これで決めてみせる！」", "Battle/Dat/Battle/Message/043.bmd|0x006568": "「リュウ！」", "Battle/Dat/Battle/Message/043.bmd|0x00657B": "「ああ！　いくぜぇっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x0065A3": "「念動集中……！」", "Battle/Dat/Battle/Message/043.bmd|0x0065BF": "「超必殺！！」", "Battle/Dat/Battle/Message/043.bmd|0x0065D5": "「Ｔ‐ＬＩＮＫダブルナッコォォッ！！」", "Battle/Dat/Battle/Message/043.bmd|0x00660F": "「うおおおおおおっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x006634": "「ターゲット、ロック……！」", "Battle/Dat/Battle/Message/043.bmd|0x00665F": "「届けっ！」", "Battle/Dat/Battle/Message/043.bmd|0x006672": "「これでぇっ！！」", "Battle/Dat/Battle/Message/043.bmd|0x00668E": "「ブレイクフィールド、展開！」", "Battle/Dat/Battle/Message/043.bmd|0x0066BC": "「マキシマム・シュート！」", "Battle/Dat/Battle/Message/043.bmd|0x0066E4": "「チャクラム・シューター、射出！」", "Battle/Dat/Battle/Message/043.bmd|0x006718": "「見える……敵の動きが！」"}