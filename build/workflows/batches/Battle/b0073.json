{"Battle/Dat/Battle/Message/044.bmd|0x007410": "「無駄よ」", "Battle/Dat/Battle/Message/044.bmd|0x007420": "「残念だったわね」", "Battle/Dat/Battle/Message/044.bmd|0x00743C": "「お礼を言わなければならないかしら？」", "Battle/Dat/Battle/Message/044.bmd|0x007476": "「………」", "Battle/Dat/Battle/Message/044.bmd|0x007486": "「反撃不可能か……！」", "Battle/Dat/Battle/Message/044.bmd|0x0074A8": "「そんなに怖がらなくてもいいわ……」", "Battle/Dat/Battle/Message/044.bmd|0x0074DF": "「この一撃、かわせるかしら？」", "Battle/Dat/Battle/Message/044.bmd|0x00750D": "「こちらの読みどおりね」", "Battle/Dat/Battle/Message/044.bmd|0x007532": "「ラーダ、後は任せて」", "Battle/Dat/Battle/Message/044.bmd|0x007554": "「リュウセイ、後は私に任せなさい」", "Battle/Dat/Battle/Message/044.bmd|0x007588": "「リュウセイ、攻撃はもっと正確に行いなさい」", "Battle/Dat/Battle/Message/044.bmd|0x0075CB": "「詰めが甘いわね。後で特訓よ」", "Battle/Dat/Battle/Message/044.bmd|0x0075F9": "「援護するわ、ライ！」", "Battle/Dat/Battle/Message/044.bmd|0x00761B": "「ライ、連携で行くわ！」", "Battle/Dat/Battle/Message/044.bmd|0x007640": "「続けて行くわよ、アヤ！」", "Battle/Dat/Battle/Message/044.bmd|0x007668": "「アヤ、あなたは先に行きなさい」", "Battle/Dat/Battle/Message/044.bmd|0x007699": "「マイ、後は私に任せて」", "Battle/Dat/Battle/Message/044.bmd|0x0076BE": "「マイ、援護するわ」", "Battle/Dat/Battle/Message/044.bmd|0x0076DD": "「援護するわ、ギリアム少佐」", "Battle/Dat/Battle/Message/044.bmd|0x007708": "「ＡＴＸチームへ。連続攻撃を行う」", "Battle/Dat/Battle/Message/044.bmd|0x00773C": "「続けていくわよ、中尉！」", "Battle/Dat/Battle/Message/044.bmd|0x007764": "「援護するわ、キョウスケ中尉」", "Battle/Dat/Battle/Message/044.bmd|0x007792": "「少尉、連携を仕掛けるわ」", "Battle/Dat/Battle/Message/044.bmd|0x0077BA": "「エクセレン、後は任せなさい」", "Battle/Dat/Battle/Message/044.bmd|0x0077E8": "「リオ、後は引き受けるわ」", "Battle/Dat/Battle/Message/044.bmd|0x007810": "「リョウト、援護するわ」", "Battle/Dat/Battle/Message/044.bmd|0x007835": "「少佐、援護するわ」", "Battle/Dat/Battle/Message/044.bmd|0x007854": "「カイ少佐、後は私が」", "Battle/Dat/Battle/Message/044.bmd|0x007876": "「ラミア、連携で行く」", "Battle/Dat/Battle/Message/044.bmd|0x007898": "「イング、援護するわ」", "Battle/Dat/Battle/Message/044.bmd|0x0078BA": "「アリエイル、後は任せなさい」", "Battle/Dat/Battle/Message/044.bmd|0x0078E8": "「マサキ、援護するわ」", "Battle/Dat/Battle/Message/044.bmd|0x00790A": "「リューネ、後は任せなさい」", "Battle/Dat/Battle/Message/044.bmd|0x007935": "「スティール２へ。これより援護に入る！」", "Battle/Dat/Battle/Message/044.bmd|0x007972": "「ドラゴン２へ。これより援護に入る！」", "Battle/Dat/Battle/Message/044.bmd|0x0079AC": "「アイアン３へ。これより援護する！」", "Battle/Dat/Battle/Message/044.bmd|0x0079E3": "「この身に代えても！」", "Battle/Dat/Battle/Message/044.bmd|0x007A05": "「無理は禁物よ！」", "Battle/Dat/Battle/Message/044.bmd|0x007A21": "「お前の相手は私がする！」", "Battle/Dat/Battle/Message/044.bmd|0x007A49": "「ラーダ、ここは私が引き受けるわ」", "Battle/Dat/Battle/Message/044.bmd|0x007A7D": "「下がりなさい、リュウセイ！」", "Battle/Dat/Battle/Message/044.bmd|0x007AAB": "「回避がなってないわね。後で特訓よ」", "Battle/Dat/Battle/Message/044.bmd|0x007AE2": "「ライ、すぐに離脱を！」", "Battle/Dat/Battle/Message/044.bmd|0x007B07": "「アヤ、回避運動を取りなさい！」", "Battle/Dat/Battle/Message/044.bmd|0x007B38": "「マイ、下がりなさい！」", "Battle/Dat/Battle/Message/044.bmd|0x007B5D": "「ギリアム少佐、後退を！」", "Battle/Dat/Battle/Message/044.bmd|0x007B85": "「少尉、早く離脱を！」", "Battle/Dat/Battle/Message/044.bmd|0x007BA7": "「エクセレン、すぐに離脱を！」", "Battle/Dat/Battle/Message/044.bmd|0x007BD5": "「リオ、離脱しなさい！」", "Battle/Dat/Battle/Message/044.bmd|0x007BFA": "「下がりなさい、リョウト！」", "Battle/Dat/Battle/Message/044.bmd|0x007C25": "「中尉、すぐに後退を！」", "Battle/Dat/Battle/Message/044.bmd|0x007C4A": "「下がりなさい、キョウスケ中尉！」", "Battle/Dat/Battle/Message/044.bmd|0x007C7E": "「アリエイル、後退しなさい！」", "Battle/Dat/Battle/Message/044.bmd|0x007CAC": "「イング、離脱しなさい！」", "Battle/Dat/Battle/Message/044.bmd|0x007CD4": "「マサキ、下がりなさい！」", "Battle/Dat/Battle/Message/044.bmd|0x007CFC": "「リューネ、後退しなさい！」", "Battle/Dat/Battle/Message/044.bmd|0x007D27": "「アラド……お前にも特訓が必要ね」", "Battle/Dat/Battle/Message/044.bmd|0x007D5B": "「その位置が命取りになる！」", "Battle/Dat/Battle/Message/044.bmd|0x007D86": "「散開などさせない！」", "Battle/Dat/Battle/Message/044.bmd|0x007DA8": "「まとめて落とす！」", "Battle/Dat/Battle/Message/044.bmd|0x007DC7": "「そのフォーメーションなら！」", "Battle/Dat/Battle/Message/044.bmd|0x007DF5": "「まだそこにいるのなら！」", "Battle/Dat/Battle/Message/044.bmd|0x007E1D": "「狙いは先程から定まったままよ！」", "Battle/Dat/Battle/Message/044.bmd|0x007E51": "「これで！」", "Battle/Dat/Battle/Message/044.bmd|0x007E64": "「もう一撃！」", "Battle/Dat/Battle/Message/044.bmd|0x007E7A": "「受けなさい！！」", "Battle/Dat/Battle/Message/044.bmd|0x007E96": "「後はトリガーを引くだけ……！」", "Battle/Dat/Battle/Message/044.bmd|0x007EC7": "「狙いは外さないわ！」", "Battle/Dat/Battle/Message/044.bmd|0x007EE9": "「仕留める！」", "Battle/Dat/Battle/Message/044.bmd|0x007EFF": "「落ちてもらう！」", "Battle/Dat/Battle/Message/044.bmd|0x007F1B": "「行くぜ、隊長！」", "Battle/Dat/Battle/Message/044.bmd|0x007F37": "「ええ」", "Battle/Dat/Battle/Message/044.bmd|0x007F44": "「システムコネクト！　隊長、後は私が！」", "Battle/Dat/Battle/Message/044.bmd|0x007F81": "「任せるわ、アヤ」", "Battle/Dat/Battle/Message/044.bmd|0x007F9D": "「Ｔ‐ＬＩＮＫフルコンタクト！/　メタルジェノサイダーモード、起動！」", "Battle/Dat/Battle/Message/044.bmd|0x008005": "「トロニウム・エンジン、フルドライブ！」", "Battle/Dat/Battle/Message/044.bmd|0x008042": "「リュウ、トリガーを！」", "Battle/Dat/Battle/Message/044.bmd|0x008067": "「くらえ！！」", "Battle/Dat/Battle/Message/044.bmd|0x00807D": "「一撃必殺！　バスタァァァァキャノンッ！！」", "Battle/Dat/Battle/Message/044.bmd|0x0080C0": "「ファイア！」", "Battle/Dat/Battle/Message/044.bmd|0x0080D6": "「落ちなさい！」", "Battle/Dat/Battle/Message/044.bmd|0x0080EF": "「バレル展開！　トリガー・オープン！」", "Battle/Dat/Battle/Message/044.bmd|0x008129": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/044.bmd|0x00814E": "「デッド・エンド・シュート！」", "Battle/Dat/Battle/Message/044.bmd|0x00817C": "「はあっ！」", "Battle/Dat/Battle/Message/044.bmd|0x00818F": "「まだよ！」", "Battle/Dat/Battle/Message/044.bmd|0x0081A2": "「これでっ！！」", "Battle/Dat/Battle/Message/044.bmd|0x0081BB": "「ブレイクフィールド、展開！」", "Battle/Dat/Battle/Message/044.bmd|0x0081E9": "「逃がしはしない！！」", "Battle/Dat/Battle/Message/044.bmd|0x00820B": "「チャクラム・シューター、発射！」", "Battle/Dat/Battle/Message/044.bmd|0x00823F": "「チャクラム・シューター！　行け！」", "Battle/Dat/Battle/Message/044.bmd|0x008276": "「行け、ファング・スラッシャー！」", "Battle/Dat/Battle/Message/044.bmd|0x0082AA": "「ファング・スラッシャー！」", "Battle/Dat/Battle/Message/044.bmd|0x0082D5": "「切り裂け！　ファング・スラッシャー！」", "Battle/Dat/Battle/Message/044.bmd|0x008312": "「マルチロック完了！　フル・ファイア！」", "Battle/Dat/Battle/Message/044.bmd|0x00834F": "「マキシマム・シュート！」", "Battle/Dat/Battle/Message/044.bmd|0x008377": "「もうお前は逃げられない」", "Battle/Dat/Battle/Message/044.bmd|0x00839F": "「ハイ・ツインランチャー、発射！」", "Battle/Dat/Battle/Message/044.bmd|0x0083D3": "「ターゲット・インサイト」", "Battle/Dat/Battle/Message/044.bmd|0x0083FB": "「デッドエンド・シュート！」", "Battle/Dat/Battle/Message/044.bmd|0x008426": "「ハイ・ツインランチャー……」", "Battle/Dat/Battle/Message/044.bmd|0x008454": "「アタック！」", "Battle/Dat/Battle/Message/044.bmd|0x00846A": "「オメガ・ブラスター、ファイア！」", "Battle/Dat/Battle/Message/044.bmd|0x00849E": "「冷たく輝くこの剣……！」", "Battle/Dat/Battle/Message/044.bmd|0x0084C6": "「受けなさい！」", "Battle/Dat/Battle/Message/044.bmd|0x0084DF": "「クラッシャー、セットアップ！」", "Battle/Dat/Battle/Message/044.bmd|0x008510": "「捕まえた！」", "Battle/Dat/Battle/Message/044.bmd|0x008526": "「ビルガー、モードチェンジ！」", "Battle/Dat/Battle/Message/044.bmd|0x008554": "「ブースト！」", "Battle/Dat/Battle/Message/044.bmd|0x00856A": "「終わりよ！！」", "Battle/Dat/Battle/Message/044.bmd|0x008583": "「ターゲット、確認！」", "Battle/Dat/Battle/Message/044.bmd|0x0085A5": "「Ｅモード、ファイア！」", "Battle/Dat/Battle/Message/044.bmd|0x0085CA": "「Ｂモード、ファイア！」", "Battle/Dat/Battle/Message/044.bmd|0x0085EF": "「Ｗモード、セット！」", "Battle/Dat/Battle/Message/044.bmd|0x008611": "「ダブル・ファイア！」", "Battle/Dat/Battle/Message/044.bmd|0x008633": "「ギガ・サークルブラスター、発射！」", "Battle/Dat/Battle/Message/044.bmd|0x00866A": "「受けなさい……」", "Battle/Dat/Battle/Message/044.bmd|0x008686": "「巨人の爪を！」", "Battle/Dat/Battle/Message/044.bmd|0x00869F": "「トリガー・オープン！」", "Battle/Dat/Battle/Message/044.bmd|0x0086C4": "「フル・ファイア！」"}