{"Battle/Dat/Battle/Message/037.bmd|0x00DAB4": "「トウマ君、やる気があるのはわかるけどね」", "Battle/Dat/Battle/Message/037.bmd|0x00DAF4": "「後ろのあなたのハートまで貫いちゃうから！」", "Battle/Dat/Battle/Message/037.bmd|0x00DB37": "「さくさくさくっと行くわよん！」", "Battle/Dat/Battle/Message/037.bmd|0x00DB68": "「はいはい、押さないで。一列に並んでね？」", "Battle/Dat/Battle/Message/037.bmd|0x00DBA8": "「言わばセルフ援護ね。行ってみましょうか！」", "Battle/Dat/Battle/Message/037.bmd|0x00DBEB": "「はぁ～い！　また出て来たわよ！」", "Battle/Dat/Battle/Message/037.bmd|0x00DC1F": "「お姉さんのアプローチは、/　まだ終わってないのよね！」", "Battle/Dat/Battle/Message/037.bmd|0x00DC72": "「せ～の、いけぇぇーっ！！」", "Battle/Dat/Battle/Message/037.bmd|0x00DC9D": "「突撃ぃ～！」", "Battle/Dat/Battle/Message/037.bmd|0x00DCB3": "「これ、結構効くかもよ？」", "Battle/Dat/Battle/Message/037.bmd|0x00DCDB": "「なんか自分も傷つきそうだけど、/　やるしかないわね！」", "Battle/Dat/Battle/Message/037.bmd|0x00DD2E": "「くるくるくるーっと！　目まで回しそうね」", "Battle/Dat/Battle/Message/037.bmd|0x00DD6E": "「恋も攻撃も獲物は逃がさない……！」", "Battle/Dat/Battle/Message/037.bmd|0x00DDA5": "「これが鉄則よ！」", "Battle/Dat/Battle/Message/037.bmd|0x00DDC1": "「ハイ・ツインランチャー、それっと！」", "Battle/Dat/Battle/Message/037.bmd|0x00DDFB": "「アメリカンなご挨拶！」", "Battle/Dat/Battle/Message/037.bmd|0x00DE20": "「ハァ～イ！　ツインランチャー！！」", "Battle/Dat/Battle/Message/037.bmd|0x00DE57": "「わお、すんごくいい距離よん？」", "Battle/Dat/Battle/Message/037.bmd|0x00DE88": "「ハウリング・ランチャー……/　Ｅモードっと。いざ！」", "Battle/Dat/Battle/Message/037.bmd|0x00DED8": "「オクスタン・ランチャーと/　使い勝手は同じなのよね」", "Battle/Dat/Battle/Message/037.bmd|0x00DF28": "「わおーん！/　と、ハウリング・ランチャー、いってみましょか！」", "Battle/Dat/Battle/Message/037.bmd|0x00DF87": "「ええと、Ｂモード……っと。おまたせ！」", "Battle/Dat/Battle/Message/037.bmd|0x00DFC4": "「あんま飛ばないけど、威力はあるわよぉ！」", "Battle/Dat/Battle/Message/037.bmd|0x00E004": "「おたけびランチャーで勝負！」", "Battle/Dat/Battle/Message/037.bmd|0x00E032": "「わおわおーん！」", "Battle/Dat/Battle/Message/037.bmd|0x00E04E": "「そんじゃま、派手にいきましょっか！」", "Battle/Dat/Battle/Message/037.bmd|0x00E088": "「さぁて、お待ちかね！」", "Battle/Dat/Battle/Message/037.bmd|0x00E0AD": "「ちょっと嘘くさい武器だけどね！」", "Battle/Dat/Battle/Message/037.bmd|0x00E0E1": "「ＷモードのＷは『わおーん』の略なの」", "Battle/Dat/Battle/Message/037.bmd|0x00E11B": "「わお！　そのまんまじゃなぁい！」", "Battle/Dat/Battle/Message/037.bmd|0x00E14F": "「たまには雰囲気変えてみましょっか！」", "Battle/Dat/Battle/Message/037.bmd|0x00E189": "「ハウリング・ランチャー、セット！」", "Battle/Dat/Battle/Message/037.bmd|0x00E1C0": "「……と、ハウリング・ランチャー、発射！」", "Battle/Dat/Battle/Message/037.bmd|0x00E200": "「これ、どういう仕組みなのかしら？」", "Battle/Dat/Battle/Message/037.bmd|0x00E237": "「……って、これ、Ｘモードだったわよね」", "Battle/Dat/Battle/Message/037.bmd|0x00E274": "「わお……じゃない、Ｘモード、発射！！」", "Battle/Dat/Battle/Message/037.bmd|0x00E2B1": "「いつもとはパターン変えていきましょっか！」", "Battle/Dat/Battle/Message/037.bmd|0x00E2F4": "「いいだろう……行くぞ！」", "Battle/Dat/Battle/Message/037.bmd|0x00E31C": "「さーて、/　暴れまくり幽霊ちゃん、行ってみましょっか！」", "Battle/Dat/Battle/Message/037.bmd|0x00E372": "「こちらの手は読ません。パターンを変える」", "Battle/Dat/Battle/Message/037.bmd|0x00E3B2": "「後ろ、とったわよ！　と思わせといて！」", "Battle/Dat/Battle/Message/037.bmd|0x00E3EF": "「こちらが仕掛ける！」", "Battle/Dat/Battle/Message/037.bmd|0x00E411": "「行くわよ、キョウスケ！」", "Battle/Dat/Battle/Message/037.bmd|0x00E439": "「いい位置だ！」", "Battle/Dat/Battle/Message/037.bmd|0x00E452": "「続けてキャッチ＆リリース！」", "Battle/Dat/Battle/Message/037.bmd|0x00E480": "「ちょいなっ！！」", "Battle/Dat/Battle/Message/037.bmd|0x00E49C": "「クレイモア！」", "Battle/Dat/Battle/Message/037.bmd|0x00E4B5": "「バンカー！」", "Battle/Dat/Battle/Message/037.bmd|0x00E4CB": "「これがおれ達の！」", "Battle/Dat/Battle/Message/037.bmd|0x00E4EA": "「切り札よん！」", "Battle/Dat/Battle/Message/037.bmd|0x00E503": "「行けぇぇっ！！」", "Battle/Dat/Battle/Message/037.bmd|0x00E51F": "「……お前にしては、真面目な締めだったな」", "Battle/Dat/Battle/Message/037.bmd|0x00E55F": "「あらん、そうだったっけ？」", "Battle/Dat/Battle/Message/037.bmd|0x00E58A": "「はぁーい！　こっちこっち！」", "Battle/Dat/Battle/Message/037.bmd|0x00E5B8": "「気を取られたな！」", "Battle/Dat/Battle/Message/037.bmd|0x00E5D7": "「キャッチボール、スタート！」", "Battle/Dat/Battle/Message/037.bmd|0x00E605": "「戻すぞ、エクセレン！」", "Battle/Dat/Battle/Message/037.bmd|0x00E62A": "「返すわよ、キョウスケ！」", "Battle/Dat/Battle/Message/037.bmd|0x00E652": "「カッキーン！！」", "Battle/Dat/Battle/Message/037.bmd|0x00E66E": "「受け取れ！」", "Battle/Dat/Battle/Message/037.bmd|0x00E684": "「こいつもな！」", "Battle/Dat/Battle/Message/037.bmd|0x00E69D": "「とどめを打つぞ！」", "Battle/Dat/Battle/Message/037.bmd|0x00E6BC": "「了解！　せーの！！」", "Battle/Dat/Battle/Message/037.bmd|0x00E6DE": "「これがおれ達の……」", "Battle/Dat/Battle/Message/037.bmd|0x00E700": "「切り札……もとい、愛の打ち上げ花火よん」", "Battle/Dat/Battle/Message/037.bmd|0x00E740": "「発射ぁっ！」", "Battle/Dat/Battle/Message/037.bmd|0x00E756": "「サイって言うか、カマキリよね」", "Battle/Dat/Battle/Message/037.bmd|0x00E787": "「ジャキーン！」", "Battle/Dat/Battle/Message/037.bmd|0x00E7A0": "「必殺！　天宙蟷螂拳！！」", "Battle/Dat/Battle/Message/037.bmd|0x00E7C8": "「成敗！！」", "Battle/Dat/Battle/Message/037.bmd|0x00E7DB": "「ラプターちゃんのフルコースよ！」", "Battle/Dat/Battle/Message/037.bmd|0x00E80F": "「それそれそれそれーっ！」", "Battle/Dat/Battle/Message/037.bmd|0x00E837": "「ブレード・サイからのぉ、変形！」", "Battle/Dat/Battle/Message/037.bmd|0x00E86B": "「撃ちまくり天国！」", "Battle/Dat/Battle/Message/037.bmd|0x00E88A": "「そろそろ打ち止めっ！！」", "Battle/Dat/Battle/Message/037.bmd|0x00E8B2": "「パンチスイッチ、オン！」", "Battle/Dat/Battle/Message/037.bmd|0x00E8DA": "「ゲシュちゃん改パーンチ！！」", "Battle/Dat/Battle/Message/037.bmd|0x00E908": "「まずはミサイル！」", "Battle/Dat/Battle/Message/037.bmd|0x00E927": "「ＬモードのＬは！」", "Battle/Dat/Battle/Message/037.bmd|0x00E946": "「もち、ＬＯＶＥのＬよん！」", "Battle/Dat/Battle/Message/037.bmd|0x00E971": "「ＬＩＰのＬなのよん！」", "Battle/Dat/Battle/Message/037.bmd|0x00E996": "「よ～く狙って…！」", "Battle/Dat/Battle/Message/037.bmd|0x00E9B5": "「はぁ～い、/　ツイン・ビームカノン、どうぞ～！」", "Battle/Dat/Battle/Message/037.bmd|0x00E9FF": "「制限突破でガンガン行くわよ！」", "Battle/Dat/Battle/Message/037.bmd|0x00EA30": "「よいしょっと！」", "Battle/Dat/Battle/Message/037.bmd|0x00EA4C": "「ただ撃つだけじゃないのよね！」", "Battle/Dat/Battle/Message/037.bmd|0x00EA7D": "「ゲシュちゃん改ファイヤァァァッ！！」", "Battle/Dat/Battle/Message/037.bmd|0x00EAB7": "「ゲシュちゃん、私に力を！」", "Battle/Dat/Battle/Message/037.bmd|0x00EAE2": "「ワンダーボルトパンチ！　パンチ！！」", "Battle/Dat/Battle/Message/037.bmd|0x00EB1C": "「バーニング・ブレイズ！！」", "Battle/Dat/Battle/Message/037.bmd|0x00EB47": "「ゴッズバンドスマッシュ！」", "Battle/Dat/Battle/Message/037.bmd|0x00EB72": "「手裏剣、シュシュシュッ！」", "Battle/Dat/Battle/Message/037.bmd|0x00EB9D": "「投げるだけじゃないわよ！」", "Battle/Dat/Battle/Message/037.bmd|0x00EBC8": "「そうれっと！」", "Battle/Dat/Battle/Message/037.bmd|0x00EBE1": "「グルンちゃん改、ぶっ飛びパンチ発射ぁっ！」", "Battle/Dat/Battle/Message/037.bmd|0x00EC24": "「当たると痛いわよ！」", "Battle/Dat/Battle/Message/037.bmd|0x00EC46": "「この拳固は一味違うわよ！」", "Battle/Dat/Battle/Message/037.bmd|0x00EC71": "「そうれ、ガツーンと！」", "Battle/Dat/Battle/Message/037.bmd|0x00EC96": "「アルティメットの名は伊達じゃないわよ！」", "Battle/Dat/Battle/Message/037.bmd|0x00ECD6": "「行っけぇぇっ！！」", "Battle/Dat/Battle/Message/037.bmd|0x00ECF5": "「これがグルンちゃん改の必殺剣よ！」", "Battle/Dat/Battle/Message/037.bmd|0x00ED2C": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/037.bmd|0x00ED47": "「暗剣殺！！」", "Battle/Dat/Battle/Message/037.bmd|0x00ED5D": "「ちょいなーーっ！！」", "Battle/Dat/Battle/Message/037.bmd|0x00ED7F": "「また、つまらないものを、/　斬ったり斬らなかったり！」", "Battle/Dat/Battle/Message/037.bmd|0x00EDD2": "「私に断てぬものなし！　なんてね」", "Battle/Dat/Battle/Message/037.bmd|0x00EE06": "「グルンちゃん改のとっておきを見せてあげる！」", "Battle/Dat/Battle/Message/037.bmd|0x00EE4C": "「暗！」", "Battle/Dat/Battle/Message/037.bmd|0x00EE59": "「黄！」", "Battle/Dat/Battle/Message/037.bmd|0x00EE66": "「殺！！」", "Battle/Dat/Battle/Message/037.bmd|0x00EE76": "「五！」", "Battle/Dat/Battle/Message/037.bmd|0x00EE83": "「四！」", "Battle/Dat/Battle/Message/037.bmd|0x00EE90": "「三！！」", "Battle/Dat/Battle/Message/037.bmd|0x00EEA0": "「ええーーーいっ！！」", "Battle/Dat/Battle/Message/037.bmd|0x00EEC2": "「……って、五黄殺だったわよね」", "Battle/Dat/Battle/Message/037.bmd|0x00EEF3": "「……って、カウントダウンじゃないわよね」", "Battle/Dat/Battle/Message/037.bmd|0x00EF33": "「ツイン・ビームキャノン！　行っけぇ！」", "Battle/Dat/Battle/Message/037.bmd|0x00EF70": "「グルングルン回るわよ！」", "Battle/Dat/Battle/Message/037.bmd|0x00EF98": "「そうれ、ドッカーン！」", "Battle/Dat/Battle/Message/037.bmd|0x00EFBD": "「ドリルはついてないけど、/　ドリル・アタック！！」"}