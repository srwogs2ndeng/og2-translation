{"Battle/Dat/Battle/Message/048.bmd|0x004872": "「魔装機で本艦を沈められると思うなよ」", "Battle/Dat/Battle/Message/048.bmd|0x0048AC": "「対インスペクター戦のデータが役に立ったか」", "Battle/Dat/Battle/Message/048.bmd|0x0048EF": "「ゲストめ、本艦を甘く見るなよ」", "Battle/Dat/Battle/Message/048.bmd|0x004920": "「………」", "Battle/Dat/Battle/Message/048.bmd|0x004930": "「フィールド展開！　間に合わせろ！」", "Battle/Dat/Battle/Message/048.bmd|0x004967": "「効きはしないぞ……！」", "Battle/Dat/Battle/Message/048.bmd|0x00498C": "「フィールドを展開せよ！」", "Battle/Dat/Battle/Message/048.bmd|0x0049B4": "「フィールド展開！」", "Battle/Dat/Battle/Message/048.bmd|0x0049D3": "「フィールドを張れ！」", "Battle/Dat/Battle/Message/048.bmd|0x0049F5": "「効きはしない！」", "Battle/Dat/Battle/Message/048.bmd|0x004A11": "「艦首前面にエネルギー・フィールド展開！」", "Battle/Dat/Battle/Message/048.bmd|0x004A51": "「エネルギー・フィールド、展開！」", "Battle/Dat/Battle/Message/048.bmd|0x004A85": "「よし、ジャマーが効いたか」", "Battle/Dat/Battle/Message/048.bmd|0x004AB0": "「ジャマー作動！」", "Battle/Dat/Battle/Message/048.bmd|0x004ACC": "「ミサイルなど通用しないぞ！」", "Battle/Dat/Battle/Message/048.bmd|0x004AFA": "「ＥＰ展開！」", "Battle/Dat/Battle/Message/048.bmd|0x004B10": "「そんなものは通用しない！」", "Battle/Dat/Battle/Message/048.bmd|0x004B3B": "「その手は食わんぞ！」", "Battle/Dat/Battle/Message/048.bmd|0x004B5D": "「弾幕に切れ目が生じるとはな……！」", "Battle/Dat/Battle/Message/048.bmd|0x004B94": "「艦長、反撃不可能です！」", "Battle/Dat/Battle/Message/048.bmd|0x004BBC": "「減速し、目標との距離を取れ！」", "Battle/Dat/Battle/Message/048.bmd|0x004BED": "「弾薬の再装填、急げ！」", "Battle/Dat/Battle/Message/048.bmd|0x004C12": "「奴は戦艦以上の射程を持っているのか……！」", "Battle/Dat/Battle/Message/048.bmd|0x004C55": "「この艦の砲撃が届かないとはな……！」", "Battle/Dat/Battle/Message/048.bmd|0x004C8F": "「やむを得ん、対空警戒を厳となせ！」", "Battle/Dat/Battle/Message/048.bmd|0x004CC6": "「目標をロスト！」", "Battle/Dat/Battle/Message/048.bmd|0x004CE2": "「再捕捉を急げ！」", "Battle/Dat/Battle/Message/048.bmd|0x004CFE": "「目標、レンジ外へ離脱！」", "Battle/Dat/Battle/Message/048.bmd|0x004D26": "「奴はまた来る。油断するな」", "Battle/Dat/Battle/Message/048.bmd|0x004D51": "「ここは防御に徹するしかないか……！」", "Battle/Dat/Battle/Message/048.bmd|0x004D8B": "「よし、友軍機を援護するぞ！」", "Battle/Dat/Battle/Message/048.bmd|0x004DB9": "「続けて本艦も攻撃だ！」", "Battle/Dat/Battle/Message/048.bmd|0x004DDE": "「まだいける！　砲撃開始！！」", "Battle/Dat/Battle/Message/048.bmd|0x004E0C": "「続けて撃て！！」", "Battle/Dat/Battle/Message/048.bmd|0x004E28": "「味方機を援護する！」", "Battle/Dat/Battle/Message/048.bmd|0x004E4A": "「まだいける！　攻撃開始！」", "Battle/Dat/Battle/Message/048.bmd|0x004E75": "「続けて攻撃せよ！」", "Battle/Dat/Battle/Message/048.bmd|0x004E94": "「レフィーナ艦長、後は我々が！」", "Battle/Dat/Battle/Message/048.bmd|0x004EC5": "「よし、ヒリュウ改に続け！」", "Battle/Dat/Battle/Message/048.bmd|0x004EF0": "「さすがレフィーナ艦長……！/　我々も負けていられんぞ！」", "Battle/Dat/Battle/Message/048.bmd|0x004F46": "「ヒリュウ改に続き、本艦も攻撃開始！」", "Battle/Dat/Battle/Message/048.bmd|0x004F80": "「こちらスティール２！　これより援護する！」", "Battle/Dat/Battle/Message/048.bmd|0x004FC3": "「スティール２よりドラゴン２へ！/　これより援護します！」", "Battle/Dat/Battle/Message/048.bmd|0x005019": "「クロガネを援護するんだ！」", "Battle/Dat/Battle/Message/048.bmd|0x005044": "「クロガネに続け！」", "Battle/Dat/Battle/Message/048.bmd|0x005063": "「スティール２よりアイアン３！/　これより援護する！」", "Battle/Dat/Battle/Message/048.bmd|0x0050B3": "「艦首を割り込ませろ！」", "Battle/Dat/Battle/Message/048.bmd|0x0050D8": "「全速前進！　友軍機を守れ！」", "Battle/Dat/Battle/Message/048.bmd|0x005106": "「艦を盾にしろ！」", "Battle/Dat/Battle/Message/048.bmd|0x005122": "「突っ込め！/　こちらで防ぎきるんだ！」", "Battle/Dat/Battle/Message/048.bmd|0x00515D": "「全速前進！　味方機を守れ！」", "Battle/Dat/Battle/Message/048.bmd|0x00518B": "「本艦なら、防ぎ切れる！」", "Battle/Dat/Battle/Message/048.bmd|0x0051B3": "「レフィーナ艦長、後退して下さい！」", "Battle/Dat/Battle/Message/048.bmd|0x0051EA": "「全速前進！　ヒリュウ改を守れ！」", "Battle/Dat/Battle/Message/048.bmd|0x00521E": "「行け！　クロガネの盾になるんだ！」", "Battle/Dat/Battle/Message/048.bmd|0x005255": "「目標を再度攻撃する！」", "Battle/Dat/Battle/Message/048.bmd|0x00527A": "「今だ、もう一撃！」", "Battle/Dat/Battle/Message/048.bmd|0x005299": "「対空機銃、撃ち方始め！」", "Battle/Dat/Battle/Message/048.bmd|0x0052C1": "「機銃座、撃ち方始め！」", "Battle/Dat/Battle/Message/048.bmd|0x0052E6": "「ＡＡＷオート、撃ち方始め！」", "Battle/Dat/Battle/Message/048.bmd|0x005314": "「対空迎撃、ＡＡＷフルオート！」", "Battle/Dat/Battle/Message/048.bmd|0x005345": "「ＶＬＳホーミングミサイルランチャー、/　発射口開け！！」", "Battle/Dat/Battle/Message/048.bmd|0x00539B": "「上部両舷ホーミングミサイルランチャー、/　発射！」", "Battle/Dat/Battle/Message/048.bmd|0x0053E8": "「ＶＬＳホーミングミサイル、発射！！」", "Battle/Dat/Battle/Message/048.bmd|0x005422": "「ミサイル攻撃用意！　撃て！！」", "Battle/Dat/Battle/Message/048.bmd|0x005453": "「アクティブ、/　目標位置最終確認、終了しました！」", "Battle/Dat/Battle/Message/048.bmd|0x0054A0": "「３番、てーっ！」", "Battle/Dat/Battle/Message/048.bmd|0x0054BC": "「アクティブ、/　目標位置最終確認終了！」", "Battle/Dat/Battle/Message/048.bmd|0x0054FA": "「１番、５番、発射！」", "Battle/Dat/Battle/Message/048.bmd|0x00551C": "「よし、攻撃始め！！」", "Battle/Dat/Battle/Message/048.bmd|0x00553E": "「ＳＴＦ魚雷、スタンバイ！」", "Battle/Dat/Battle/Message/048.bmd|0x005569": "「１番、３番、撃て！」", "Battle/Dat/Battle/Message/048.bmd|0x00558B": "「イルミネーター・リンク！」", "Battle/Dat/Battle/Message/048.bmd|0x0055B6": "「魚雷、１番、３番、撃て！」", "Battle/Dat/Battle/Message/048.bmd|0x0055E1": "「目標、インレンジ！」", "Battle/Dat/Battle/Message/048.bmd|0x005603": "「魚雷、１番、５番、てーっ！！」", "Battle/Dat/Battle/Message/048.bmd|0x005634": "「艦長、測距終了しました！」", "Battle/Dat/Battle/Message/048.bmd|0x00565F": "「両舷副砲、撃て！！」", "Battle/Dat/Battle/Message/048.bmd|0x005681": "「目標へ一斉砲撃！」", "Battle/Dat/Battle/Message/048.bmd|0x0056A0": "「副砲、１番から４番、撃て！！」", "Battle/Dat/Battle/Message/048.bmd|0x0056D1": "「前部副砲、１番から４番、てーっ！！」", "Battle/Dat/Battle/Message/048.bmd|0x00570B": "「両舷副砲、てーっ！！」", "Battle/Dat/Battle/Message/048.bmd|0x005730": "「副砲、１番から４番、攻撃用意！」", "Battle/Dat/Battle/Message/048.bmd|0x005764": "「撃て！！」", "Battle/Dat/Battle/Message/048.bmd|0x005777": "「主砲、相対測合わせ良し！」", "Battle/Dat/Battle/Message/048.bmd|0x0057A2": "「前部主砲、一斉射撃！！」", "Battle/Dat/Battle/Message/048.bmd|0x0057CA": "「アイアン３より各機！/　本艦はこれより主砲を発射する！」", "Battle/Dat/Battle/Message/048.bmd|0x005820": "「主砲、１番、２番！　撃て！！」", "Battle/Dat/Battle/Message/048.bmd|0x005851": "「１番、２番主砲、てーっ！！」", "Battle/Dat/Battle/Message/048.bmd|0x00587F": "「測距データ、確認！/　相対速度合わせ、良し！」", "Battle/Dat/Battle/Message/048.bmd|0x0058C6": "「衝撃砲、１番、２番！　撃て！！」", "Battle/Dat/Battle/Message/048.bmd|0x0058FA": "「上部衝撃砲、１番、２番！　攻撃用意！」", "Battle/Dat/Battle/Message/048.bmd|0x005937": "「外すなよ！　撃て！！」", "Battle/Dat/Battle/Message/048.bmd|0x00595C": "「上部衝撃砲、相対測合わせ良し！」", "Battle/Dat/Battle/Message/048.bmd|0x005990": "「１番、２番！　てーっ！！」", "Battle/Dat/Battle/Message/048.bmd|0x0059BB": "「スティール２より各機！/　本艦はこれより主砲を発射する！」", "Battle/Dat/Battle/Message/048.bmd|0x005A14": "「これより艦前方へ一斉砲撃！/　その後、艦首超大型回転衝角を使用する！」", "Battle/Dat/Battle/Message/048.bmd|0x005A7F": "「目標との相対距離確認！」", "Battle/Dat/Battle/Message/048.bmd|0x005AA7": "「仰角誤差修正！　前部各砲、攻撃用意！」", "Battle/Dat/Battle/Message/048.bmd|0x005AE4": "「超大型回転衝角、始動！！」", "Battle/Dat/Battle/Message/048.bmd|0x005B0F": "「テスラ・ドライブ出力最大！/　オーバー・ブースト！！」", "Battle/Dat/Battle/Message/048.bmd|0x005B62": "「前部各砲、撃ち方始め！！」", "Battle/Dat/Battle/Message/048.bmd|0x005B8D": "「総員、対衝撃防御！！」", "Battle/Dat/Battle/Message/048.bmd|0x005BB2": "「クロガネ、突撃ぃぃぃっ！！」", "Battle/Dat/Battle/Message/048.bmd|0x005BE0": "「艦首トロニウム・バスターキャノン、/　ファイナル・シーケンスへ移行！」", "Battle/Dat/Battle/Message/048.bmd|0x005C4B": "「測距終了！　ＦＥＢ開放どうぞ！」", "Battle/Dat/Battle/Message/048.bmd|0x005C7F": "「味方機、射線上からの離脱を確認！」", "Battle/Dat/Battle/Message/048.bmd|0x005CB6": "「発射１０秒前！」", "Battle/Dat/Battle/Message/048.bmd|0x005CD2": "「昇圧ビーム・キャパシタ、開放！/　最終安全装置、解除！」", "Battle/Dat/Battle/Message/048.bmd|0x005D28": "「総員、対衝撃・閃光防御！」", "Battle/Dat/Battle/Message/048.bmd|0x005D53": "「発射５秒前！　３！　２！　１！」", "Battle/Dat/Battle/Message/048.bmd|0x005D87": "「バスターキャノン！　発射ぁぁ！！」", "Battle/Dat/Battle/Message/048.bmd|0x005DBE": "「スティール２より各機へ！/　バスターキャノン、発射２０秒前！」", "Battle/Dat/Battle/Message/048.bmd|0x005E1D": "「重力ブレーキ、スタンバイ！」", "Battle/Dat/Battle/Message/048.bmd|0x005E4B": "「味方機、射線上より退避完了！」", "Battle/Dat/Battle/Message/048.bmd|0x005E7C": "「トロニウム・バスターキャノン！/　発射ぁぁ！！」", "Battle/Dat/Battle/Message/049.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/049.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/049.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/049.bmd|0x0003E6": "「………！！」"}