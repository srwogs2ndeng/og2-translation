{"Battle/Dat/Battle/Message/087.bmd|0x0022C7": "「これで……」", "Battle/Dat/Battle/Message/087.bmd|0x0022DD": "「消えてもらいますの」", "Battle/Dat/Battle/Message/087.bmd|0x0022FF": "「見えますの……」", "Battle/Dat/Battle/Message/087.bmd|0x00231B": "「あなたの運命……」", "Battle/Dat/Battle/Message/087.bmd|0x00233A": "「これで……お終いですの」", "Battle/Dat/Battle/Message/087.bmd|0x002362": "「覚悟は……よろしいですの？」", "Battle/Dat/Battle/Message/087.bmd|0x002390": "「お別れですの……」", "Battle/Dat/Battle/Message/087.bmd|0x0023AF": "「さくさく……さくさく……いきますの」", "Battle/Dat/Battle/Message/087.bmd|0x0023E9": "「やさしく……やさしく……致しますの」", "Battle/Dat/Battle/Message/087.bmd|0x002423": "「あなたの身体と……魂に……」", "Battle/Dat/Battle/Message/088.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/089.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/090.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/091.bmd|0x001C93": "「くらえ！」", "Battle/Dat/Battle/Message/091.bmd|0x001CA6": "「無明を垣間見よ！」", "Battle/Dat/Battle/Message/091.bmd|0x001CC5": "「散り際は潔くな！」", "Battle/Dat/Battle/Message/091.bmd|0x001CE4": "「いざ勝負！」", "Battle/Dat/Battle/Message/091.bmd|0x001CFA": "「修羅の道を往くのみ！」", "Battle/Dat/Battle/Message/091.bmd|0x001D1F": "「落ちよ！」", "Battle/Dat/Battle/Message/091.bmd|0x001D32": "「逃がしはせん！」", "Battle/Dat/Battle/Message/091.bmd|0x001D4E": "「もらったぞ！」", "Battle/Dat/Battle/Message/091.bmd|0x001D67": "「相手になってやる！」", "Battle/Dat/Battle/Message/091.bmd|0x001D89": "「俺の打ち込みがかわせるか！？」", "Battle/Dat/Battle/Message/091.bmd|0x001DBA": "「修羅の道を往き、/　人血と機油で己が心を満たすのみ！」", "Battle/Dat/Battle/Message/091.bmd|0x001E0D": "「物言わぬ骸となれい！」", "Battle/Dat/Battle/Message/091.bmd|0x001E32": "「人機を斬る……それが俺の生き様よ！」", "Battle/Dat/Battle/Message/091.bmd|0x001E6C": "「老木は朽ち果てるのみ！」", "Battle/Dat/Battle/Message/091.bmd|0x001E94": "「無意味な題目など、元より馬耳東風！」", "Battle/Dat/Battle/Message/091.bmd|0x001ECE": "「参るぞ、ゼンガー・ゾンボルト！」", "Battle/Dat/Battle/Message/091.bmd|0x001F02": "「ゼンガー！/　貴様との死合を待ち望んでいたぞ！」", "Battle/Dat/Battle/Message/091.bmd|0x001F4C": "「参るぞ、ＡＴＸチーム！」", "Battle/Dat/Battle/Message/091.bmd|0x001F74": "「ＡＴＸチーム…この俺に相応しい相手だ！」", "Battle/Dat/Battle/Message/091.bmd|0x001FB4": "「ＡＴＸチームの実力、見せてもらおうか！」", "Battle/Dat/Battle/Message/091.bmd|0x001FF4": "「青二才が！」", "Battle/Dat/Battle/Message/091.bmd|0x00200A": "「勢いだけの若僧など！」", "Battle/Dat/Battle/Message/091.bmd|0x00202F": "「若僧が！　貴様では食い足りん！」", "Battle/Dat/Battle/Message/091.bmd|0x002063": "「ふふ…少しは楽しめそうな相手だ」", "Battle/Dat/Battle/Message/091.bmd|0x002097": "「貴様の大義ごと斬り捨ててくれる！」", "Battle/Dat/Battle/Message/091.bmd|0x0020CE": "「俺に大義など不要…/　人機を斬れれば、それでよい！」", "Battle/Dat/Battle/Message/091.bmd|0x00211E": "「馴れ合いの教導隊など、相手ではないわ！」", "Battle/Dat/Battle/Message/091.bmd|0x00215E": "「元教導隊…この俺に相応しい相手だ！」", "Battle/Dat/Battle/Message/091.bmd|0x002198": "「女子供と言えど、容赦はせん！」", "Battle/Dat/Battle/Message/091.bmd|0x0021C9": "「我が前に立ちし者は、/　例え女子供であろうとも斬る！」", "Battle/Dat/Battle/Message/091.bmd|0x00221C": "「情けなどかけん。覚悟せい！」", "Battle/Dat/Battle/Message/091.bmd|0x00224A": "「艦を斬る刀は、斬艦刀だけではないわ！」", "Battle/Dat/Battle/Message/091.bmd|0x002287": "「巨大なる盾か。/　たちどころに両断してくれる！」", "Battle/Dat/Battle/Message/091.bmd|0x0022D1": "「大物の特機だな。我が剣の錆となれい！」", "Battle/Dat/Battle/Message/091.bmd|0x00230E": "「特機か。フフフ…血が騒ぐわ！」", "Battle/Dat/Battle/Message/091.bmd|0x00233F": "「獲物は大きければ、大きい程良い！」", "Battle/Dat/Battle/Message/091.bmd|0x002376": "「特機こそ我が獲物に相応しい！」", "Battle/Dat/Battle/Message/091.bmd|0x0023A7": "「返すぞ！」", "Battle/Dat/Battle/Message/091.bmd|0x0023BA": "「勝負はまだついておらん！」", "Battle/Dat/Battle/Message/091.bmd|0x0023E5": "「一撃で仕留める！」", "Battle/Dat/Battle/Message/091.bmd|0x002404": "「む、無念！！」", "Battle/Dat/Battle/Message/091.bmd|0x00241D": "「み、見事だ！！」", "Battle/Dat/Battle/Message/091.bmd|0x002439": "「むううっ！/　この“無明”を下がらせるとは！」", "Battle/Dat/Battle/Message/091.bmd|0x002480": "「ぐうっ！　ここで退くつもりなどない！」", "Battle/Dat/Battle/Message/091.bmd|0x0024BD": "「ぬうっ！　見事！」", "Battle/Dat/Battle/Message/091.bmd|0x0024DC": "「ふっふっふ……血がたぎってきたわ……！」", "Battle/Dat/Battle/Message/091.bmd|0x00251C": "「まだ戦える……そう、阿修羅の如くな！」", "Battle/Dat/Battle/Message/091.bmd|0x002559": "「フハハハ！/　ゼンガー、まさにこれが死合よ！！」", "Battle/Dat/Battle/Message/091.bmd|0x0025A3": "「こ、この老いぼれめが！！」", "Battle/Dat/Battle/Message/091.bmd|0x0025CE": "「所詮は過去の遺物…！/　俺を斬り捨てるには至らん！」", "Battle/Dat/Battle/Message/091.bmd|0x00261E": "「おのれ、女！！」", "Battle/Dat/Battle/Message/091.bmd|0x00263A": "「ぬぐっ！　女！　必ず斬る！！」", "Battle/Dat/Battle/Message/091.bmd|0x00266B": "「ぐうっ！/　……受け止めたぞ、貴様の斬艦刀を…！」", "Battle/Dat/Battle/Message/091.bmd|0x0026B8": "「艦は斬れても、/　この“無明”を斬ることは出来ん！」", "Battle/Dat/Battle/Message/091.bmd|0x002708": "「貴様の剣風で俺の命の灯は消せん！」", "Battle/Dat/Battle/Message/091.bmd|0x00273F": "「ぐうっ！/　その巨体は伊達ではないようだな！」", "Battle/Dat/Battle/Message/091.bmd|0x002786": "「俺を危殆に追い込むとは…！/　非凡なる人機よ！」", "Battle/Dat/Battle/Message/091.bmd|0x0027D0": "「うぐっ！　特機の力でも、/　我が“無明”は落とせん！！」", "Battle/Dat/Battle/Message/091.bmd|0x002826": "「あまりのんびり相手はしてやれん……！」", "Battle/Dat/Battle/Message/091.bmd|0x002863": "「その足運びの揺らぎ……/　本調子ではないのか？」", "Battle/Dat/Battle/Message/091.bmd|0x0028AD": "「むう！　我が身に打ち込んできたか！」", "Battle/Dat/Battle/Message/091.bmd|0x0028E7": "「ふふ……ふははは！　楽しませてくれる！！」", "Battle/Dat/Battle/Message/091.bmd|0x00292A": "「これぞ戦い！　これぞ我が生きる道！！」", "Battle/Dat/Battle/Message/091.bmd|0x002967": "「うぐっ！　老いぼれめ、さすがだな！」", "Battle/Dat/Battle/Message/091.bmd|0x0029A1": "「道場剣法で、この俺を倒すことは出来ん！」", "Battle/Dat/Battle/Message/091.bmd|0x0029E1": "「若僧…/　叫んでいれば勝てるというものではないぞ」", "Battle/Dat/Battle/Message/091.bmd|0x002A2E": "「どうした、ゼンガー！　それで終わりか！」", "Battle/Dat/Battle/Message/091.bmd|0x002A6E": "「どうした！　教導隊とは名ばかりか！」", "Battle/Dat/Battle/Message/091.bmd|0x002AA8": "「女ごときにこの俺は倒せん！」", "Battle/Dat/Battle/Message/091.bmd|0x002AD6": "「ぐっ！　女子供に後れを取るとは！」", "Battle/Dat/Battle/Message/091.bmd|0x002B0D": "「ゼンガー！/　貴様にも斬れぬものがあると知れい！」", "Battle/Dat/Battle/Message/091.bmd|0x002B5A": "「ほう……/　その威力、さすがだと言っておこう！」", "Battle/Dat/Battle/Message/091.bmd|0x002BA4": "「フハハハ！/　小物相手では味わえぬ高ぶりよ！」", "Battle/Dat/Battle/Message/091.bmd|0x002BEB": "「凡百の機体とは、一味違うな！」", "Battle/Dat/Battle/Message/091.bmd|0x002C1C": "「ふん、どうにも食い足りん」", "Battle/Dat/Battle/Message/091.bmd|0x002C47": "「貴様では無理だな」", "Battle/Dat/Battle/Message/091.bmd|0x002C66": "「ほう……この“無明”に当てたか」", "Battle/Dat/Battle/Message/091.bmd|0x002C9A": "「いい踏み込みだ。だが、力が足りん」", "Battle/Dat/Battle/Message/091.bmd|0x002CD1": "「まさか、遠慮してるわけではあるまい？」", "Battle/Dat/Battle/Message/091.bmd|0x002D0E": "「ふふ…老体に鞭打ったというわけか」", "Battle/Dat/Battle/Message/091.bmd|0x002D45": "「老いぼれの力など、そんなものよ」", "Battle/Dat/Battle/Message/091.bmd|0x002D79": "「甘いぞ、ゼンガー・ゾンボルト！」", "Battle/Dat/Battle/Message/091.bmd|0x002DAD": "「フン、浅いな……ゼンガー」", "Battle/Dat/Battle/Message/091.bmd|0x002DD8": "「旧教導隊など、解散して当然よ」", "Battle/Dat/Battle/Message/091.bmd|0x002E09": "「チッ…女子供と侮ったか！」", "Battle/Dat/Battle/Message/091.bmd|0x002E34": "「女……/　逃げずに向かって来た度胸は認めてやろう」", "Battle/Dat/Battle/Message/091.bmd|0x002E81": "「噂の特機も大したことはないな」", "Battle/Dat/Battle/Message/091.bmd|0x002EB2": "「図体の割には非力だな」", "Battle/Dat/Battle/Message/091.bmd|0x002ED7": "「フン、食い足りん特機だ」", "Battle/Dat/Battle/Message/091.bmd|0x002EFF": "「惜しいな」", "Battle/Dat/Battle/Message/091.bmd|0x002F12": "「見切った！」", "Battle/Dat/Battle/Message/091.bmd|0x002F28": "「甘いわ！」", "Battle/Dat/Battle/Message/091.bmd|0x002F3B": "「出直してこい！」", "Battle/Dat/Battle/Message/091.bmd|0x002F57": "「相手にならんな……」", "Battle/Dat/Battle/Message/091.bmd|0x002F79": "「無駄だ！」", "Battle/Dat/Battle/Message/091.bmd|0x002F8C": "「そんなもの！」", "Battle/Dat/Battle/Message/091.bmd|0x002FA5": "「通用せんぞ！」", "Battle/Dat/Battle/Message/091.bmd|0x002FBE": "「………」", "Battle/Dat/Battle/Message/091.bmd|0x002FCE": "「ち、打つ手がないとはな！」", "Battle/Dat/Battle/Message/091.bmd|0x002FF9": "「奴の呼吸に乗せられてしまったか……！」", "Battle/Dat/Battle/Message/091.bmd|0x003036": "「ふっ、いい引き際だ」", "Battle/Dat/Battle/Message/091.bmd|0x003058": "「寄せては返す波の如く……というわけか」", "Battle/Dat/Battle/Message/091.bmd|0x003095": "「助太刀する！」", "Battle/Dat/Battle/Message/091.bmd|0x0030AE": "「ロレンツォ中佐、後は任せよ！」", "Battle/Dat/Battle/Message/091.bmd|0x0030DF": "「隙あり！」", "Battle/Dat/Battle/Message/091.bmd|0x0030F2": "「獅子王の剣がお前の血を欲しておるわ！」", "Battle/Dat/Battle/Message/091.bmd|0x00312F": "「微塵になれぇぇいっ！！」"}