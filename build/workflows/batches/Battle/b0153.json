{"Battle/Dat/Battle/Message/073.bmd|0x007BF0": "「ライディ様、お手伝い致しますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x007C27": "「続いていきますわ、ライディ様！」", "Battle/Dat/Battle/Message/073.bmd|0x007C5B": "「ライディ様のお兄様、/　お手伝い致しますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x007CA2": "「アラド！　ちょっとお待ちなさいませ！」", "Battle/Dat/Battle/Message/073.bmd|0x007CDF": "「アラド、後はお任せ下さいませ！」", "Battle/Dat/Battle/Message/073.bmd|0x007D13": "「ゼオラ、私も行きますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x007D3E": "「援護しますわ、ゼオラ！」", "Battle/Dat/Battle/Message/073.bmd|0x007D66": "「マイ、お手伝い致しますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x007D94": "「マイも頑張っていますのね。なら、私も！」", "Battle/Dat/Battle/Message/073.bmd|0x007DD4": "「アルフィミィ、後はお任せ下さいませ！」", "Battle/Dat/Battle/Message/073.bmd|0x007E11": "「ラウル、お手伝い致しますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x007E42": "「フィオナ、後はお任せ下さいませ！」", "Battle/Dat/Battle/Message/073.bmd|0x007E79": "「コウタ、援護致しますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x007EA4": "「イング、お手伝い致しますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x007ED5": "「アリエイル、後は私が！」", "Battle/Dat/Battle/Message/073.bmd|0x007EFD": "「ジョッシュ、後はお任せ下さいませ！」", "Battle/Dat/Battle/Message/073.bmd|0x007F37": "「リム、お手伝い致しますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x007F65": "「トウマ、援護致しますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x007F90": "「マサキ、援護致しますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x007FBB": "「リューネ、後は私が！」", "Battle/Dat/Battle/Message/073.bmd|0x007FE0": "「ミオ、お手伝い致しますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x00800E": "「お助け致します！」", "Battle/Dat/Battle/Message/073.bmd|0x00802D": "「フェアリオン、割り込んで！」", "Battle/Dat/Battle/Message/073.bmd|0x00805B": "「知らんぷりは出来ませんわ！」", "Battle/Dat/Battle/Message/073.bmd|0x008089": "「防いでみせます！」", "Battle/Dat/Battle/Message/073.bmd|0x0080A8": "「お守り致しますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x0080CA": "「ラトゥーニ、お下がりなさいませ！」", "Battle/Dat/Battle/Message/073.bmd|0x008101": "「今は私が守る番でございます！」", "Battle/Dat/Battle/Message/073.bmd|0x008132": "「ライディ様、お守り致します！」", "Battle/Dat/Battle/Message/073.bmd|0x008163": "「ライディ様のお役に立ちたい……！」", "Battle/Dat/Battle/Message/073.bmd|0x00819A": "「ライディ様、危のうございますっ！」", "Battle/Dat/Battle/Message/073.bmd|0x0081D1": "「ライディ様のお兄様、/　お下がりくださいませ！」", "Battle/Dat/Battle/Message/073.bmd|0x00821B": "「アラド、/　何をやってるんでございますの！？」", "Battle/Dat/Battle/Message/073.bmd|0x008262": "「アラド！/　骨まで切らせてはダメですわよ！」", "Battle/Dat/Battle/Message/073.bmd|0x0082A6": "「ゼオラ、ここは私が引き受けますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x0082E0": "「マイ、早く下がりなさいませ！」", "Battle/Dat/Battle/Message/073.bmd|0x008311": "「ラウル、お逃げなさいませ！」", "Battle/Dat/Battle/Message/073.bmd|0x00833F": "「フィオナ、ここは私が！」", "Battle/Dat/Battle/Message/073.bmd|0x008367": "「お逃げなさい、イング！」", "Battle/Dat/Battle/Message/073.bmd|0x00838F": "「アリエイル、危ないですわ！」", "Battle/Dat/Battle/Message/073.bmd|0x0083BD": "「ジョッシュ、ここは私が！」", "Battle/Dat/Battle/Message/073.bmd|0x0083E8": "「リム、逃げて下さいませ！」", "Battle/Dat/Battle/Message/073.bmd|0x008413": "「マサキ、ここは私が！」", "Battle/Dat/Battle/Message/073.bmd|0x008438": "「リューネ、危ないですわ！」", "Battle/Dat/Battle/Message/073.bmd|0x008463": "「ミオ、逃げて下さいませ！」", "Battle/Dat/Battle/Message/073.bmd|0x00848E": "「トウマ、早くお逃げなさい！」", "Battle/Dat/Battle/Message/073.bmd|0x0084BC": "「チャンスでございますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x0084E7": "「ブチかまし……いえ、/　一気にいきますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x00852B": "「まだ行けますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x00854A": "「さらにブチ込み……いえ、もう一撃ですわ！」", "Battle/Dat/Battle/Message/073.bmd|0x00858D": "「当ててみせますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x0085AF": "「撃ったりしますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x0085D1": "「届いて下さいませ！」", "Battle/Dat/Battle/Message/073.bmd|0x0085F3": "「ブチ抜……いえ、撃ちますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x008624": "「逆に振り回されないようにしませんと！」", "Battle/Dat/Battle/Message/073.bmd|0x008661": "「ドツキ……いえ、接近戦を仕掛けますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x0086A1": "「このハンマーでドツキ……/　いえ、叩いてやりますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x0086F4": "「シシオウブレードを使いますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x008728": "「逃がしませんわよ！」", "Battle/Dat/Battle/Message/073.bmd|0x00874A": "「おしまいですわ！！」", "Battle/Dat/Battle/Message/073.bmd|0x00876C": "「えええーーいっ！！」", "Battle/Dat/Battle/Message/073.bmd|0x00878E": "「おしまいでございます！」", "Battle/Dat/Battle/Message/073.bmd|0x0087B6": "「このミサイルは、超速いですわよ！」", "Battle/Dat/Battle/Message/073.bmd|0x0087ED": "「後で請求書が来ても大丈夫ですわ！」", "Battle/Dat/Battle/Message/073.bmd|0x008824": "「ＭＴＤ誘導弾！　飛びませ！」", "Battle/Dat/Battle/Message/073.bmd|0x008852": "「奥の手を使いますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x008877": "「行きますわよ！/　フリー・エレクトロン・キャノン！」", "Battle/Dat/Battle/Message/073.bmd|0x0088C7": "「ロール・キャノン！」", "Battle/Dat/Battle/Message/073.bmd|0x0088E9": "「ロール・キャノン！　行きますわよ！」", "Battle/Dat/Battle/Message/073.bmd|0x008923": "「ロール・キャノン！　ファイアですわ！」", "Battle/Dat/Battle/Message/073.bmd|0x008960": "「ボストーク・レーザー！」", "Battle/Dat/Battle/Message/073.bmd|0x008988": "「ボストーク・レーザー！　撃ちますわよ！」", "Battle/Dat/Battle/Message/073.bmd|0x0089C8": "「ボストーク・レーザー！　発射しますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x008A08": "「Ｗ‐㍾ＮＫシステム、シングルモード！」", "Battle/Dat/Battle/Message/073.bmd|0x008A45": "「音を超え、光をまとい！」", "Battle/Dat/Battle/Message/073.bmd|0x008A6D": "「飛びませ、フェアリオン！」", "Battle/Dat/Battle/Message/073.bmd|0x008A98": "「パターン・プロスペクト！」", "Battle/Dat/Battle/Message/073.bmd|0x008AC3": "「ブレイク・フィールド、展開！」", "Battle/Dat/Battle/Message/073.bmd|0x008AF4": "「ソニック・ドライバー！！」", "Battle/Dat/Battle/Message/073.bmd|0x008B1F": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/073.bmd|0x008B44": "「フィールド、ブレイクですわ！」", "Battle/Dat/Battle/Message/073.bmd|0x008B75": "「私もラトゥーニみたいにやってみますわ！」", "Battle/Dat/Battle/Message/073.bmd|0x008BB5": "「フェアリー・シャアァァァィン！！」", "Battle/Dat/Battle/Message/073.bmd|0x008BEC": "「シャイィィィィン・スパァァァァァァトッ！！」", "Battle/Dat/Battle/Message/073.bmd|0x008C32": "「スウェイヤー、アタック！」", "Battle/Dat/Battle/Message/073.bmd|0x008C5D": "「フィニッシュですわ！」", "Battle/Dat/Battle/Message/073.bmd|0x008C82": "「まだ終わりませんわよ！」", "Battle/Dat/Battle/Message/073.bmd|0x008CAA": "「これでラストですわ！」", "Battle/Dat/Battle/Message/073.bmd|0x008CCF": "「続けて、スウェイヤー！！」", "Battle/Dat/Battle/Message/073.bmd|0x008CFA": "「これでお終いですわ！」", "Battle/Dat/Battle/Message/073.bmd|0x008D1F": "「ラッシュ！　ラッシュ！　ラッシュ！！」", "Battle/Dat/Battle/Message/073.bmd|0x008D5C": "「フィニィィィィシュ！！」", "Battle/Dat/Battle/Message/073.bmd|0x008D84": "「ラトゥーニ、行きますわよ」", "Battle/Dat/Battle/Message/073.bmd|0x008DAF": "「はい……」", "Battle/Dat/Battle/Message/073.bmd|0x008DC2": "「Ｗ‐㍾ＮＫシステム、ダブルモード！」", "Battle/Dat/Battle/Message/073.bmd|0x008DFC": "「託しますわ、あなたに！」", "Battle/Dat/Battle/Message/073.bmd|0x008E24": "「受け取りました、あなたから……！」", "Battle/Dat/Battle/Message/073.bmd|0x008E5B": "「パターンセレクト、Ｒ・Ｈ・Ｂ……！」", "Battle/Dat/Battle/Message/073.bmd|0x008E95": "「エンゲージ！」", "Battle/Dat/Battle/Message/073.bmd|0x008EAE": "「ラトゥーニ……」", "Battle/Dat/Battle/Message/073.bmd|0x008ECA": "「シャイン王女……行きます！」", "Battle/Dat/Battle/Message/073.bmd|0x008EF8": "「Ｗ‐㍾ＮＫシステム、モードチェンジ！」", "Battle/Dat/Battle/Message/073.bmd|0x008F35": "「ユーハブコントロール！」", "Battle/Dat/Battle/Message/073.bmd|0x008F5D": "「アイハブコントロール！」", "Battle/Dat/Battle/Message/073.bmd|0x008F85": "「ラトゥーニ、/　ロイヤル・ハート・ブレイカーを使いますわよ！」", "Battle/Dat/Battle/Message/073.bmd|0x008FE4": "「わかりました、王女」", "Battle/Dat/Battle/Message/073.bmd|0x009006": "「モード、シングルからダブルに！」", "Battle/Dat/Battle/Message/073.bmd|0x00903A": "「そちらにコントロールを！」", "Battle/Dat/Battle/Message/073.bmd|0x009065": "「はい。行きます！」", "Battle/Dat/Battle/Message/073.bmd|0x009084": "「パターンセレクト！　ターゲット・ロック！」", "Battle/Dat/Battle/Message/073.bmd|0x0090C7": "「フルブースト！」", "Battle/Dat/Battle/Message/073.bmd|0x0090E3": "「王女、ここはシングルで！」", "Battle/Dat/Battle/Message/073.bmd|0x00910E": "「後は任せますわよ、ラトゥーニ！」", "Battle/Dat/Battle/Message/073.bmd|0x009142": "「シンクロアタック！」", "Battle/Dat/Battle/Message/073.bmd|0x009164": "「シャイン王女！」", "Battle/Dat/Battle/Message/073.bmd|0x009180": "「ラトゥーニ！」", "Battle/Dat/Battle/Message/073.bmd|0x009199": "「ファイナル……！」", "Battle/Dat/Battle/Message/073.bmd|0x0091B8": "「ブレイクですわ！」", "Battle/Dat/Battle/Message/073.bmd|0x0091D7": "「ファイナルシーケンス……！」", "Battle/Dat/Battle/Message/073.bmd|0x009205": "「これで……！」"}