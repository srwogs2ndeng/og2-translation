{"Battle/Dat/Battle/Message/047.bmd|0x007733": "「攻撃するだけ無駄よ！」", "Battle/Dat/Battle/Message/047.bmd|0x007758": "「ミサイルなんて！」", "Battle/Dat/Battle/Message/047.bmd|0x007777": "「………」", "Battle/Dat/Battle/Message/047.bmd|0x007787": "「攻撃が出来ないなんて……！」", "Battle/Dat/Battle/Message/047.bmd|0x0077B5": "「しまった……！　私のミスだわ……」", "Battle/Dat/Battle/Message/047.bmd|0x0077EC": "「何か使える武器はないの！？」", "Battle/Dat/Battle/Message/047.bmd|0x00781A": "「！？　あなた、卑怯よ！」", "Battle/Dat/Battle/Message/047.bmd|0x007842": "「ううっ……/　こちらの射程を見切られてる……！」", "Battle/Dat/Battle/Message/047.bmd|0x00788C": "「もっと近くに寄ってきなさいよ！」", "Battle/Dat/Battle/Message/047.bmd|0x0078C0": "「手玉に取られちゃってるの……！？」", "Battle/Dat/Battle/Message/047.bmd|0x0078F7": "「ここからなら、まだ攻撃できるっ！」", "Battle/Dat/Battle/Message/047.bmd|0x00792E": "「こっちの相手もしてもらうわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x007962": "「まだ私がいるわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x007984": "「諦めは悪い方なの！」", "Battle/Dat/Battle/Message/047.bmd|0x0079A6": "「リョウト君、気を抜いちゃダメよ！」", "Battle/Dat/Battle/Message/047.bmd|0x0079DD": "「手伝うわ、リョウト君！」", "Battle/Dat/Battle/Message/047.bmd|0x007A05": "「リョウト君、私も行くわ！」", "Battle/Dat/Battle/Message/047.bmd|0x007A30": "「後は私が……ってことね、リョウト君！」", "Battle/Dat/Battle/Message/047.bmd|0x007A6D": "「まだよ、クスハ！　私からも！」", "Battle/Dat/Battle/Message/047.bmd|0x007A9E": "「クスハ、下がって！　後は私が！」", "Battle/Dat/Battle/Message/047.bmd|0x007AD2": "「タスク君、詰めが甘いわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x007B00": "「レオナ、手伝うわ！」", "Battle/Dat/Battle/Message/047.bmd|0x007B22": "「ブリット君、援護するわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x007B50": "「リュウセイ君、援護するわ！」", "Battle/Dat/Battle/Message/047.bmd|0x007B7E": "「イルム中尉、援護します！」", "Battle/Dat/Battle/Message/047.bmd|0x007BA9": "「ラーダさん、手伝います！」", "Battle/Dat/Battle/Message/047.bmd|0x007BD4": "「ユウキ君、後は任せて！」", "Battle/Dat/Battle/Message/047.bmd|0x007BFC": "「カーラ、まだ終わってないわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x007C30": "「待ちなさいよ、アラド君！」", "Battle/Dat/Battle/Message/047.bmd|0x007C5B": "「手伝うわよ、コウタ君！」", "Battle/Dat/Battle/Message/047.bmd|0x007C83": "「ラウル君、後は引き受けるわ！」", "Battle/Dat/Battle/Message/047.bmd|0x007CB4": "「フィオナ、あなたは先に行って！」", "Battle/Dat/Battle/Message/047.bmd|0x007CE8": "「キョウスケ中尉、援護します！」", "Battle/Dat/Battle/Message/047.bmd|0x007D19": "「エクセレン少尉、後は任せて下さい！」", "Battle/Dat/Battle/Message/047.bmd|0x007D53": "「ジョッシュ、援護するわ！」", "Battle/Dat/Battle/Message/047.bmd|0x007D7E": "「リム、後は任せて！」", "Battle/Dat/Battle/Message/047.bmd|0x007DA0": "「ヒューゴ少尉、援護します！」", "Battle/Dat/Battle/Message/047.bmd|0x007DCE": "「アクア、続いて行くわよ！」", "Battle/Dat/Battle/Message/047.bmd|0x007DF9": "「ヤンロンさん、援護します！」", "Battle/Dat/Battle/Message/047.bmd|0x007E27": "「プレシア、後は任せて！」", "Battle/Dat/Battle/Message/047.bmd|0x007E4F": "「援護するわ、イング！」", "Battle/Dat/Battle/Message/047.bmd|0x007E74": "「ミチル君、ただ突っ込むだけじゃダメよ！」", "Battle/Dat/Battle/Message/047.bmd|0x007EB4": "「手伝うわ、アリエイル！」", "Battle/Dat/Battle/Message/047.bmd|0x007EDC": "「続いて行きます、ラミア少尉！」", "Battle/Dat/Battle/Message/047.bmd|0x007F0D": "「これより、スティール２の援護に入ります！」", "Battle/Dat/Battle/Message/047.bmd|0x007F50": "「こちらリオ！　艦長、援護します！」", "Battle/Dat/Battle/Message/047.bmd|0x007F87": "「これより、アイアン３の援護に入ります！」", "Battle/Dat/Battle/Message/047.bmd|0x007FC7": "「これより、ドラゴン２の援護に入ります！」", "Battle/Dat/Battle/Message/047.bmd|0x008007": "「見逃すわけにはいかないわ！」", "Battle/Dat/Battle/Message/047.bmd|0x008035": "「何としてでも、助けてみせるっ！」", "Battle/Dat/Battle/Message/047.bmd|0x008069": "「私が行けばっ！」", "Battle/Dat/Battle/Message/047.bmd|0x008085": "「この状況、放ってはおけないわ！」", "Battle/Dat/Battle/Message/047.bmd|0x0080B9": "「リョウト君！　無理しないで！」", "Battle/Dat/Battle/Message/047.bmd|0x0080EA": "「リョウト君、ディフェンスは私に任せて！」", "Battle/Dat/Battle/Message/047.bmd|0x00812A": "「クスハ！　あなたは早く逃げて！」", "Battle/Dat/Battle/Message/047.bmd|0x00815E": "「今行くわよ、クスハ！」", "Battle/Dat/Battle/Message/047.bmd|0x008183": "「タスク君！　何やってんのよ！」", "Battle/Dat/Battle/Message/047.bmd|0x0081B4": "「レオナ、すぐに後退して！」", "Battle/Dat/Battle/Message/047.bmd|0x0081DF": "「ブリット君、前に出過ぎよ！」", "Battle/Dat/Battle/Message/047.bmd|0x00820D": "「リュウセイ君、早く後ろに！」", "Battle/Dat/Battle/Message/047.bmd|0x00823B": "「イルム中尉、離脱して下さい！」", "Battle/Dat/Battle/Message/047.bmd|0x00826C": "「社長を守ってみせるっ！」", "Battle/Dat/Battle/Message/047.bmd|0x008294": "「ラーダさん、今の内に逃げて！」", "Battle/Dat/Battle/Message/047.bmd|0x0082C5": "「少佐、後退して下さい！」", "Battle/Dat/Battle/Message/047.bmd|0x0082ED": "「大尉、ここは任せて下さい！」", "Battle/Dat/Battle/Message/047.bmd|0x00831B": "「中尉、私が時間を稼ぎます！」", "Battle/Dat/Battle/Message/047.bmd|0x008349": "「下がって！　ユウキ君！」", "Battle/Dat/Battle/Message/047.bmd|0x008371": "「カーラ！　ちゃんと集中しなきゃダメよ！」", "Battle/Dat/Battle/Message/047.bmd|0x0083B1": "「アラド君！　装甲を過信しちゃダメ！」", "Battle/Dat/Battle/Message/047.bmd|0x0083EB": "「コウタ君、よそ見しちゃダメだって！」", "Battle/Dat/Battle/Message/047.bmd|0x008425": "「ラウル君、下がって！」", "Battle/Dat/Battle/Message/047.bmd|0x00844A": "「フィオナ、迂闊よ！」", "Battle/Dat/Battle/Message/047.bmd|0x00846C": "「ジョッシュ、下がって！」", "Battle/Dat/Battle/Message/047.bmd|0x008494": "「リム、無茶しちゃダメよ！」", "Battle/Dat/Battle/Message/047.bmd|0x0084BF": "「ヒューゴ少尉、後退して下さい！」", "Battle/Dat/Battle/Message/047.bmd|0x0084F3": "「アクア、早く逃げて！」", "Battle/Dat/Battle/Message/047.bmd|0x008518": "「ヤンロンさん、離脱して下さい！」", "Battle/Dat/Battle/Message/047.bmd|0x00854C": "「プレシア、無理しないで！」", "Battle/Dat/Battle/Message/047.bmd|0x008577": "「下がって、イング！」", "Battle/Dat/Battle/Message/047.bmd|0x008599": "「あなた達、覚悟しなさい！」", "Battle/Dat/Battle/Message/047.bmd|0x0085C4": "「一気に仕掛けるわよ！！」", "Battle/Dat/Battle/Message/047.bmd|0x0085EC": "「これで仕留めてみせる！」", "Battle/Dat/Battle/Message/047.bmd|0x008614": "「まだそこにいるのなら！」", "Battle/Dat/Battle/Message/047.bmd|0x00863C": "「もう一撃、受けなさい！」", "Battle/Dat/Battle/Message/047.bmd|0x008664": "「スプリットミサイル、発射！！」", "Battle/Dat/Battle/Message/047.bmd|0x008695": "「行くわよ！　ミサイル発射！！」", "Battle/Dat/Battle/Message/047.bmd|0x0086C6": "「これで！」", "Battle/Dat/Battle/Message/047.bmd|0x0086D9": "「照準……！　もらったわ！」", "Battle/Dat/Battle/Message/047.bmd|0x008704": "「落ちなさい！！」", "Battle/Dat/Battle/Message/047.bmd|0x008720": "「これでっ！」", "Battle/Dat/Battle/Message/047.bmd|0x008736": "「受けてみなさいっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x00875B": "「狙いは正確に……っ！」", "Battle/Dat/Battle/Message/047.bmd|0x008780": "「撃つわよっ！」", "Battle/Dat/Battle/Message/047.bmd|0x008799": "「バレル、展開！」", "Battle/Dat/Battle/Message/047.bmd|0x0087B5": "「ターゲット、ロック！」", "Battle/Dat/Battle/Message/047.bmd|0x0087DA": "「とどけぇぇっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x0087F9": "「アーマリオンの必殺技、見せてあげるわ！」", "Battle/Dat/Battle/Message/047.bmd|0x008839": "「ソニック・ブースト！　キィィィィック！！」", "Battle/Dat/Battle/Message/047.bmd|0x00887C": "「リョウト君が作ったモーションパターンよ！」", "Battle/Dat/Battle/Message/047.bmd|0x0088BF": "「ソニック・ブーストキック！！」", "Battle/Dat/Battle/Message/047.bmd|0x0088F0": "「ブレイクフィールド！　ブースト！」", "Battle/Dat/Battle/Message/047.bmd|0x008927": "「ソニック・アクセラレーション！！」", "Battle/Dat/Battle/Message/047.bmd|0x00895E": "「ファング・スラッシャー、セット！」", "Battle/Dat/Battle/Message/047.bmd|0x008995": "「いっけぇぇぇぇ！！」", "Battle/Dat/Battle/Message/047.bmd|0x0089B7": "「リープ・ミサイル、発射！」", "Battle/Dat/Battle/Message/047.bmd|0x0089E2": "「重力衝撃砲、発射っ！！」", "Battle/Dat/Battle/Message/047.bmd|0x008A0A": "「重力衝撃砲！　行くわよっ！！」", "Battle/Dat/Battle/Message/047.bmd|0x008A3B": "「ドリル・ブーストナックル！」", "Battle/Dat/Battle/Message/047.bmd|0x008A69": "「ドリル・アタック！！」", "Battle/Dat/Battle/Message/047.bmd|0x008A8E": "「スパイラル・アタァァァック！！」", "Battle/Dat/Battle/Message/047.bmd|0x008AC2": "「ドリル・ブーストナックル、発射！」", "Battle/Dat/Battle/Message/047.bmd|0x008AF9": "「オメガ・ブラスター！！」", "Battle/Dat/Battle/Message/047.bmd|0x008B21": "「行くわよ、ビルガー！」", "Battle/Dat/Battle/Message/047.bmd|0x008B46": "「コールドメタルソォォォド！！」", "Battle/Dat/Battle/Message/047.bmd|0x008B77": "「クラッシャー、セットアップ！」", "Battle/Dat/Battle/Message/047.bmd|0x008BA8": "「受けなさい！」", "Battle/Dat/Battle/Message/047.bmd|0x008BC1": "「スタッグビートル・クラッシャー！！」", "Battle/Dat/Battle/Message/047.bmd|0x008BFB": "「ジャケットアーマー、パージ！」", "Battle/Dat/Battle/Message/047.bmd|0x008C2C": "「フルブースト！」", "Battle/Dat/Battle/Message/047.bmd|0x008C48": "「一気に行くわよ！　ビルガー！」"}