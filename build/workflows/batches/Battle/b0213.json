{"Battle/Dat/Battle/Message/123.bmd|0x00D260": "「ギガ・サークルブラスター！」", "Battle/Dat/Battle/Message/123.bmd|0x00D28E": "「アンカー・ユニット、アクティブ！」", "Battle/Dat/Battle/Message/123.bmd|0x00D2C5": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/123.bmd|0x00D2EA": "「ジガンテ・ウンギア！！」", "Battle/Dat/Battle/Message/123.bmd|0x00D312": "「ハルバート・ランチャー、シュート！」", "Battle/Dat/Battle/Message/123.bmd|0x00D34C": "「ソードブレイカー！　行けぇっ！」", "Battle/Dat/Battle/Message/124.bmd|0x000D21": "「エンカウント！」", "Battle/Dat/Battle/Message/124.bmd|0x000D3D": "「エンゲージ！」", "Battle/Dat/Battle/Message/124.bmd|0x000D56": "「邪魔をするな！」", "Battle/Dat/Battle/Message/124.bmd|0x000D72": "「倒す！」", "Battle/Dat/Battle/Message/124.bmd|0x000D82": "「エグレッタ！/　エグゼクスバインの力を思い知れ！」", "Battle/Dat/Battle/Message/124.bmd|0x000DCF": "「エグレッタ、お前を倒す！/　このエグゼクスバインでな！」", "Battle/Dat/Battle/Message/124.bmd|0x000E25": "「このアッシュを狩れると思うな！」", "Battle/Dat/Battle/Message/124.bmd|0x000E59": "「お前が何者だろうと！」", "Battle/Dat/Battle/Message/124.bmd|0x000E7E": "「狩られるのはお前の方だ！/　このアッシュでな！」", "Battle/Dat/Battle/Message/124.bmd|0x000EC8": "「無事で済むと思うな、アーマラ！」", "Battle/Dat/Battle/Message/124.bmd|0x000EFC": "「覚悟するがいい、アーマラ！」", "Battle/Dat/Battle/Message/124.bmd|0x000F2A": "「スライダー、パージ！」", "Battle/Dat/Battle/Message/124.bmd|0x000F4F": "「ストライク・シールド！」", "Battle/Dat/Battle/Message/124.bmd|0x000F77": "「セイバー！」", "Battle/Dat/Battle/Message/124.bmd|0x000F8D": "「アクティブ！」", "Battle/Dat/Battle/Message/124.bmd|0x000FA6": "「Ｔ‐ＬＩＮＫコンタクト！」", "Battle/Dat/Battle/Message/124.bmd|0x000FD1": "「うおおおおっ！！」", "Battle/Dat/Battle/Message/124.bmd|0x000FF0": "「砕けろおぉぉ！！」", "Battle/Dat/Battle/Message/124.bmd|0x00100F": "「ぐうっ！　馬鹿な！！」", "Battle/Dat/Battle/Message/124.bmd|0x001034": "「うあああっ！！」", "Battle/Dat/Battle/Message/124.bmd|0x001050": "「ダメージ・コントロール！」", "Battle/Dat/Battle/Message/124.bmd|0x00107B": "「使える武器は、まだある！」", "Battle/Dat/Battle/Message/124.bmd|0x0010A6": "「くうっ！　直撃か！」", "Battle/Dat/Battle/Message/124.bmd|0x0010C8": "「向こうの方が一枚上手か……！」", "Battle/Dat/Battle/Message/124.bmd|0x0010F9": "「この程度の損傷で！」", "Battle/Dat/Battle/Message/124.bmd|0x00111B": "「サーボモーターの一つや二つぐらいで！」", "Battle/Dat/Battle/Message/124.bmd|0x001158": "「くっ！　多少のダメージなど！」", "Battle/Dat/Battle/Message/124.bmd|0x001189": "「戦闘を続行する！」", "Battle/Dat/Battle/Message/124.bmd|0x0011A8": "「エグレッタ、それで僕を倒せると思うな！」", "Battle/Dat/Battle/Message/124.bmd|0x0011E8": "「エグレッタ、お前がどんな手を使おうと！」", "Battle/Dat/Battle/Message/124.bmd|0x001228": "「詰めが甘いな、アーマラ！」", "Battle/Dat/Battle/Message/124.bmd|0x001253": "「アーマラ、お前の好きにはやらせない！」", "Battle/Dat/Battle/Message/124.bmd|0x001290": "「どのサーボモーターにも異常はない」", "Battle/Dat/Battle/Message/124.bmd|0x0012C7": "「当ててきたか！」", "Battle/Dat/Battle/Message/124.bmd|0x0012E3": "「浅いな！」", "Battle/Dat/Battle/Message/124.bmd|0x0012F6": "「効くものか！」", "Battle/Dat/Battle/Message/124.bmd|0x00130F": "「僕を止められると思うな！」", "Battle/Dat/Battle/Message/124.bmd|0x00133A": "「そんなものか、エグレッタ！」", "Battle/Dat/Battle/Message/124.bmd|0x001368": "「オリジネイターとはその程度か！」", "Battle/Dat/Battle/Message/124.bmd|0x00139C": "「当てただけか、アーマラ！」", "Battle/Dat/Battle/Message/124.bmd|0x0013C7": "「その程度か、アーマラ！」", "Battle/Dat/Battle/Message/124.bmd|0x0013EF": "「当たるものか！」", "Battle/Dat/Battle/Message/124.bmd|0x00140B": "「遅い！」", "Battle/Dat/Battle/Message/124.bmd|0x00141B": "「そんなもので！」", "Battle/Dat/Battle/Message/124.bmd|0x001437": "「そう簡単に！」", "Battle/Dat/Battle/Message/124.bmd|0x001450": "「アッシュには届かない！」", "Battle/Dat/Battle/Message/124.bmd|0x001478": "「エグゼクスバインを甘く見るな！」", "Battle/Dat/Battle/Message/124.bmd|0x0014AC": "「甘いな、エグレッタ！」", "Battle/Dat/Battle/Message/124.bmd|0x0014D1": "「お前の獲物にはならない！」", "Battle/Dat/Battle/Message/124.bmd|0x0014FC": "「無駄だ、アーマラ！」", "Battle/Dat/Battle/Message/124.bmd|0x00151E": "「アーマラ、お前の力は通用しない！」", "Battle/Dat/Battle/Message/124.bmd|0x001555": "「それで終わりか、エグレッタ！」", "Battle/Dat/Battle/Message/124.bmd|0x001586": "「………」", "Battle/Dat/Battle/Message/124.bmd|0x001596": "「くっ、打つ手なしか！」", "Battle/Dat/Battle/Message/124.bmd|0x0015BB": "「すぐに再捕捉する！」", "Battle/Dat/Battle/Message/124.bmd|0x0015DD": "「まだ終わりじゃない！」", "Battle/Dat/Battle/Message/124.bmd|0x001602": "「させるかっ！！」", "Battle/Dat/Battle/Message/124.bmd|0x00161E": "「全て叩く！！」", "Battle/Dat/Battle/Message/124.bmd|0x001637": "「もう一度だ！！」", "Battle/Dat/Battle/Message/124.bmd|0x001653": "「くらえ！！」", "Battle/Dat/Battle/Message/124.bmd|0x001669": "「グラビトン・ライフル！」", "Battle/Dat/Battle/Message/124.bmd|0x001691": "「薙ぎ払え！！」", "Battle/Dat/Battle/Message/124.bmd|0x0016AA": "「シーケンス、ＴＬＳ！」", "Battle/Dat/Battle/Message/124.bmd|0x0016CF": "「セイバー、アクティブ！」", "Battle/Dat/Battle/Message/124.bmd|0x0016F7": "「はあっ！」", "Battle/Dat/Battle/Message/124.bmd|0x00170A": "「はああああっ！」", "Battle/Dat/Battle/Message/124.bmd|0x001726": "「おおおっ！」", "Battle/Dat/Battle/Message/124.bmd|0x00173C": "「Ｔ‐ＬＩＮＫフルコンタクト！」", "Battle/Dat/Battle/Message/124.bmd|0x00176D": "「砕け散れぇぇぇ！！」", "Battle/Dat/Battle/Message/124.bmd|0x00178F": "「行け！！」", "Battle/Dat/Battle/Message/124.bmd|0x0017A2": "「Ｔ‐ＬＩＮＫスライダー！」", "Battle/Dat/Battle/Message/124.bmd|0x0017CD": "「全スライダー、パージ！」", "Battle/Dat/Battle/Message/124.bmd|0x0017F5": "「オープン・ブレード！」", "Battle/Dat/Battle/Message/124.bmd|0x00181A": "「行けっ！」", "Battle/Dat/Battle/Message/124.bmd|0x00182D": "「Ｔ‐ＬＩＮＫレボリューター！」", "Battle/Dat/Battle/Message/124.bmd|0x00185E": "「撃ち抜けぇっ！！」", "Battle/Dat/Battle/Message/125.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/125.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/125.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/125.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/125.bmd|0x0003FC": "「………？」", "Battle/Dat/Battle/Message/126.bmd|0x001589": "「今の立場も悪くはない」", "Battle/Dat/Battle/Message/126.bmd|0x0015AE": "「さて、任務を果たそうか」", "Battle/Dat/Battle/Message/126.bmd|0x0015D6": "「今の僕は、仮初めなのさ」", "Battle/Dat/Battle/Message/126.bmd|0x0015FE": "「僕達アルファ・セイバーが君達を切り裂く」", "Battle/Dat/Battle/Message/126.bmd|0x00163E": "「君達には借りがあるからね」", "Battle/Dat/Battle/Message/126.bmd|0x001669": "「今度は君達が地の底へ墜ちる番だ」", "Battle/Dat/Battle/Message/126.bmd|0x00169D": "「大統領を殺害した罪……その命で贖え」", "Battle/Dat/Battle/Message/126.bmd|0x0016D7": "「罪人は罰を受けなきゃならないのさ」", "Battle/Dat/Battle/Message/126.bmd|0x00170E": "「鋼龍戦隊……君達の役目は終わったのさ」", "Battle/Dat/Battle/Message/126.bmd|0x00174B": "「イング……これもパパの命令でね」", "Battle/Dat/Battle/Message/126.bmd|0x00177F": "「真実を知るのが先か、死ぬのが先か……」", "Battle/Dat/Battle/Message/126.bmd|0x0017BC": "「どこまで耐えられるかな、イング？」", "Battle/Dat/Battle/Message/126.bmd|0x0017F3": "「コピーが、/　オリジネイターである僕を超えるなどと……！」", "Battle/Dat/Battle/Message/126.bmd|0x00184C": "「殺してやるよ、イーグレット・イング……！」", "Battle/Dat/Battle/Message/126.bmd|0x00188F": "「イング、お前のナンバーは欠番だ……！」", "Battle/Dat/Battle/Message/126.bmd|0x0018CC": "「僕は許さない、お前の存在を……！」", "Battle/Dat/Battle/Message/126.bmd|0x001903": "「ゼンガー……今度はお前が死ぬ番だ」", "Battle/Dat/Battle/Message/126.bmd|0x00193A": "「僕と違って、/　お前は生き返ることが出来ないだろう？」", "Battle/Dat/Battle/Message/126.bmd|0x00198D": "「ドゥバンの代わりに君を始末してやる」", "Battle/Dat/Battle/Message/126.bmd|0x0019C7": "「限りある命をそういう風に使うとはね」", "Battle/Dat/Battle/Message/126.bmd|0x001A01": "「裏切り者には死を。/　ありきたりな言葉だけどね」", "Battle/Dat/Battle/Message/126.bmd|0x001A4B": "「ブロンゾ２８……/　スリサズやアンサズが/　地の底で君を待っているよ」", "Battle/Dat/Battle/Message/126.bmd|0x001AB4": "「今度こそ汚点を消す」", "Battle/Dat/Battle/Message/126.bmd|0x001AD6": "「君はもう放っておけないね、色々な意味で」", "Battle/Dat/Battle/Message/126.bmd|0x001B16": "「君達も目障りだ、ブロンゾ２８と同じくね」", "Battle/Dat/Battle/Message/126.bmd|0x001B56": "「御し難いね、ブーステッド・チルドレンは」", "Battle/Dat/Battle/Message/126.bmd|0x001B96": "「消えてもらうよ、Ｗ１７」", "Battle/Dat/Battle/Message/126.bmd|0x001BBE": "「フッ、人形は壊れたままか……」", "Battle/Dat/Battle/Message/126.bmd|0x001BEF": "「逃がさないよ」", "Battle/Dat/Battle/Message/126.bmd|0x001C08": "「どこへ行くつもりだ？」", "Battle/Dat/Battle/Message/126.bmd|0x001C2D": "「このまま帰すわけにはいかない！」", "Battle/Dat/Battle/Message/126.bmd|0x001C61": "「追え、アルタルフ」", "Battle/Dat/Battle/Message/126.bmd|0x001C80": "「さて、仕切り直しだな」"}