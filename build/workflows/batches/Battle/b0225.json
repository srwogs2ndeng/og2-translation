{"Battle/Dat/Battle/Message/145.bmd|0x00114B": "「どこから攻撃してきたというのだ！？」", "Battle/Dat/Battle/Message/145.bmd|0x001185": "「他に反撃可能な武器はないのか！？」", "Battle/Dat/Battle/Message/145.bmd|0x0011BC": "「馬鹿な！/　戦艦の射程を上回る攻撃など……！！」", "Battle/Dat/Battle/Message/145.bmd|0x001206": "「友軍機を援護する！」", "Battle/Dat/Battle/Message/145.bmd|0x001228": "「一斉射撃！　とどめをさすぞ！」", "Battle/Dat/Battle/Message/145.bmd|0x001259": "「援護砲撃！　撃て！！」", "Battle/Dat/Battle/Message/145.bmd|0x00127E": "「本艦を盾にする！」", "Battle/Dat/Battle/Message/145.bmd|0x00129D": "「構わん！　突っ込め！！」", "Battle/Dat/Battle/Message/145.bmd|0x0012C5": "「味方機を巻き込むなよ！　撃てぇっ！！」", "Battle/Dat/Battle/Message/145.bmd|0x001302": "「一斉射撃！」", "Battle/Dat/Battle/Message/145.bmd|0x001318": "「対空機銃、敵機を近づけるな！」", "Battle/Dat/Battle/Message/145.bmd|0x001349": "「艦前方に弾幕を展開しろ！」", "Battle/Dat/Battle/Message/145.bmd|0x001374": "「機銃群、攻撃開始！！」", "Battle/Dat/Battle/Message/145.bmd|0x001399": "「各砲座、一斉射撃！！」", "Battle/Dat/Battle/Message/145.bmd|0x0013BE": "「敵機データ入力！　ミサイル発射！！」", "Battle/Dat/Battle/Message/145.bmd|0x0013F8": "「ミサイル発射！！」", "Battle/Dat/Battle/Message/145.bmd|0x001417": "「魚雷、１番から４番まで発射準備！/　撃て！！」", "Battle/Dat/Battle/Message/145.bmd|0x00145E": "「魚雷、発射！！」", "Battle/Dat/Battle/Message/145.bmd|0x00147A": "「魚雷発射管、開け！/　１番から４番、発射！！」", "Battle/Dat/Battle/Message/145.bmd|0x0014C1": "「構わん！　対艦ミサイルを使え！！」", "Battle/Dat/Battle/Message/145.bmd|0x0014F8": "「２番、３番副砲、撃て！！」", "Battle/Dat/Battle/Message/145.bmd|0x001523": "「３番、４番副砲、砲撃始め！！」", "Battle/Dat/Battle/Message/145.bmd|0x001554": "「目標へ一斉砲撃！！」", "Battle/Dat/Battle/Message/145.bmd|0x001576": "「各砲座、各個に敵を撃破せよ！」", "Battle/Dat/Battle/Message/145.bmd|0x0015A7": "「１番、２番主砲、撃て！！」", "Battle/Dat/Battle/Message/145.bmd|0x0015D2": "「３番、４番主砲、発射！」", "Battle/Dat/Battle/Message/145.bmd|0x0015FA": "「砲撃戦用意！　撃て！！」", "Battle/Dat/Battle/Message/145.bmd|0x001622": "「前部全主砲、斉射！！」", "Battle/Dat/Battle/Message/145.bmd|0x001647": "「各砲、砲撃始め！！」", "Battle/Dat/Battle/Message/145.bmd|0x001669": "「敵機の射程外で撃破せよ！」", "Battle/Dat/Battle/Message/146.bmd|0x0050DB": "「生かして帰すか！」", "Battle/Dat/Battle/Message/146.bmd|0x0050FA": "「そこっ！」", "Battle/Dat/Battle/Message/146.bmd|0x00510D": "「仕留めてみせる！」", "Battle/Dat/Battle/Message/146.bmd|0x00512C": "「抵抗するな！」", "Battle/Dat/Battle/Message/146.bmd|0x005145": "「力ある者が正義だ！」", "Battle/Dat/Battle/Message/146.bmd|0x005167": "「我らの邪魔をするか！」", "Battle/Dat/Battle/Message/146.bmd|0x00518C": "「お前はここまでだ！」", "Battle/Dat/Battle/Message/146.bmd|0x0051AE": "「やってやる！　やってやるぞ！」", "Battle/Dat/Battle/Message/146.bmd|0x0051DF": "「当ててやる！」", "Battle/Dat/Battle/Message/146.bmd|0x0051F8": "「消え去れ！」", "Battle/Dat/Battle/Message/146.bmd|0x00520E": "「貴様らの好きにはやらせんぞ！」", "Battle/Dat/Battle/Message/146.bmd|0x00523F": "「調子に乗るな！」", "Battle/Dat/Battle/Message/146.bmd|0x00525B": "「母艦さえ落とせば、貴様らも終わりだ！」", "Battle/Dat/Battle/Message/146.bmd|0x005298": "「奴らの要はあの艦だ！　沈めてみせる！」", "Battle/Dat/Battle/Message/146.bmd|0x0052D5": "「スペースノア級と言えども！」", "Battle/Dat/Battle/Message/146.bmd|0x005303": "「何がＳＲＸ計画だ、笑わせるな！」", "Battle/Dat/Battle/Message/146.bmd|0x005337": "「所詮は試作機！　すぐにボロが出るさ！」", "Battle/Dat/Battle/Message/146.bmd|0x005374": "「奴らを合体させるわけには！」", "Battle/Dat/Battle/Message/146.bmd|0x0053A2": "「一機落とせば、合体できまい！」", "Battle/Dat/Battle/Message/146.bmd|0x0053D3": "「新型め、落ちろ！」", "Battle/Dat/Battle/Message/146.bmd|0x0053F2": "「新型か！　落とすぞ！」", "Battle/Dat/Battle/Message/146.bmd|0x005417": "「行くぞ、新型！」", "Battle/Dat/Battle/Message/146.bmd|0x005433": "「所詮はアーマードモジュールだ！/　落とせる！」", "Battle/Dat/Battle/Message/146.bmd|0x00547A": "「プロジェクトごと消え去れ！」", "Battle/Dat/Battle/Message/146.bmd|0x0054A8": "「所詮は速さだけが取り柄の機体だ！」", "Battle/Dat/Battle/Message/146.bmd|0x0054DF": "「フン、図体がでかいだけの機体だ！」", "Battle/Dat/Battle/Message/146.bmd|0x005516": "「見かけ倒しめ！」", "Battle/Dat/Battle/Message/146.bmd|0x005532": "「所詮は力だけの機体だ！」", "Battle/Dat/Battle/Message/146.bmd|0x00555A": "「その装甲、貫いてやる！」", "Battle/Dat/Battle/Message/146.bmd|0x005582": "「特機は最優先で落とす！」", "Battle/Dat/Battle/Message/146.bmd|0x0055AA": "「旧式の改造機など楽勝だ！」", "Battle/Dat/Battle/Message/146.bmd|0x0055D5": "「見た目は強そうだがな！」", "Battle/Dat/Battle/Message/146.bmd|0x0055FD": "「間合いを取れば、落とせる！」", "Battle/Dat/Battle/Message/146.bmd|0x00562B": "「奴を落とせば、大金星だ！」", "Battle/Dat/Battle/Message/146.bmd|0x005656": "「奴を落とせば、金星だ！」", "Battle/Dat/Battle/Message/146.bmd|0x00567E": "「その名の通り、幽霊にしてやる！」", "Battle/Dat/Battle/Message/146.bmd|0x0056B2": "「幽霊め、成仏させてやるぞ！」", "Battle/Dat/Battle/Message/146.bmd|0x0056E0": "「所詮は旧式、恐れることはない！」", "Battle/Dat/Battle/Message/146.bmd|0x005714": "「アダ名どおりに消え去れ！」", "Battle/Dat/Battle/Message/146.bmd|0x00573F": "「いくぞ、ヒュッケバイン！」", "Battle/Dat/Battle/Message/146.bmd|0x00576A": "「ヒュッケバインの後継機か……！」", "Battle/Dat/Battle/Message/146.bmd|0x00579E": "「冗談は見た目だけにしろ！」", "Battle/Dat/Battle/Message/146.bmd|0x0057C9": "「あの機体、何の冗談だ…！？」", "Battle/Dat/Battle/Message/146.bmd|0x0057F7": "「グルンガストを落とせば、手柄になる！」", "Battle/Dat/Battle/Message/146.bmd|0x005834": "「超闘士め、落ちろ！」", "Battle/Dat/Battle/Message/146.bmd|0x005856": "「行くぞ、グルンガスト！」", "Battle/Dat/Battle/Message/146.bmd|0x00587E": "「サイバスターは最優先で破壊しろ！」", "Battle/Dat/Battle/Message/146.bmd|0x0058B5": "「奴にあの武器を使わせるわけには！」", "Battle/Dat/Battle/Message/146.bmd|0x0058EC": "「行くぞ、サイバスター！」", "Battle/Dat/Battle/Message/146.bmd|0x005914": "「ヴァルシオーネ……/　我らの敵ならば、落とす！」", "Battle/Dat/Battle/Message/146.bmd|0x00595E": "「龍退治だ！」", "Battle/Dat/Battle/Message/146.bmd|0x005974": "「虎狩りだ！」", "Battle/Dat/Battle/Message/146.bmd|0x00598A": "「あの機体、何という威圧感だ……！」", "Battle/Dat/Battle/Message/146.bmd|0x0059C1": "「その剣、叩き折ってやる！」", "Battle/Dat/Battle/Message/146.bmd|0x0059EC": "「や、やられた！！」", "Battle/Dat/Battle/Message/146.bmd|0x005A0B": "「だ、脱出する！」", "Battle/Dat/Battle/Message/146.bmd|0x005A27": "「ここまでか！　脱出だ！」", "Battle/Dat/Battle/Message/146.bmd|0x005A4F": "「くそっ！　機体を破棄する！」", "Battle/Dat/Battle/Message/146.bmd|0x005A7D": "「ええい！　次はこうはいかんぞ！」", "Battle/Dat/Battle/Message/146.bmd|0x005AB1": "「必ず戻ってくるぞ！！」", "Battle/Dat/Battle/Message/146.bmd|0x005AD6": "「な、何だとぉぉ！？」", "Battle/Dat/Battle/Message/146.bmd|0x005AF8": "「ぐあああっ！！」", "Battle/Dat/Battle/Message/146.bmd|0x005B14": "「い、いかん！　これ以上くらったら……」", "Battle/Dat/Battle/Message/146.bmd|0x005B51": "「な、何！？　損傷率７０％だとっ！？」", "Battle/Dat/Battle/Message/146.bmd|0x005B8B": "「くそ！　この機体では勝てんのか！」", "Battle/Dat/Battle/Message/146.bmd|0x005BC2": "「ま、まだだ！/　まだ貴様に屈したわけではない！」", "Battle/Dat/Battle/Message/146.bmd|0x005C0C": "「うああ！　だ、誰か援護を頼む！」", "Battle/Dat/Battle/Message/146.bmd|0x005C40": "「う、うおおっ！？/　き、機体の性能差なのか！？」", "Battle/Dat/Battle/Message/146.bmd|0x005C8A": "「ぬ、ぬうっ！/　栄光ある我々がこの程度で！」", "Battle/Dat/Battle/Message/146.bmd|0x005CCE": "「うぬっ！/　ここまでのダメージを受けるとは！」", "Battle/Dat/Battle/Message/146.bmd|0x005D15": "「つ、強い！　強すぎる！！」", "Battle/Dat/Battle/Message/146.bmd|0x005D40": "「エ、ＡＴＸチームに一矢報いるまでは……！」", "Battle/Dat/Battle/Message/146.bmd|0x005D83": "「奴め、なんて踏み込みの速さだ！」", "Battle/Dat/Battle/Message/146.bmd|0x005DB7": "「馬鹿な、/　奴はゲシュペンストの改造機だぞ！」", "Battle/Dat/Battle/Message/146.bmd|0x005DFE": "「あれは本当に/　パーソナルトルーパーなのか！？」", "Battle/Dat/Battle/Message/146.bmd|0x005E48": "「駄目だ、教導隊にはかなわない！！」", "Battle/Dat/Battle/Message/146.bmd|0x005E7F": "「お、おのれ！　Ｒシリーズ！！」", "Battle/Dat/Battle/Message/146.bmd|0x005EB0": "「お、俺ではＲシリーズを止められんのか！？」", "Battle/Dat/Battle/Message/146.bmd|0x005EF3": "「くそっ！　合体前に何としても奴を！」", "Battle/Dat/Battle/Message/146.bmd|0x005F2D": "「ええい！/　ＳＲＸチームには勝てんのか！？」", "Battle/Dat/Battle/Message/146.bmd|0x005F71": "「ちいっ！　調整は万全というわけか！」", "Battle/Dat/Battle/Message/146.bmd|0x005FAB": "「ぐああっ！　新型め、なんて性能だ！！」", "Battle/Dat/Battle/Message/146.bmd|0x005FE8": "「ええい！　性能に差がありすぎる！」", "Battle/Dat/Battle/Message/146.bmd|0x00601F": "「うう…！/　新型のデータだけでも転送しなければ…！」", "Battle/Dat/Battle/Message/146.bmd|0x00606F": "「や、奴は本当にゲシュペンストなのか！？」", "Battle/Dat/Battle/Message/146.bmd|0x0060AF": "「ぐっ！/　あいつは旧式なんかじゃない！」", "Battle/Dat/Battle/Message/146.bmd|0x0060ED": "「大きさだけじゃない！/　他も負けている！！」", "Battle/Dat/Battle/Message/146.bmd|0x006131": "「ええい！　あの特機には勝てんのか！？」", "Battle/Dat/Battle/Message/146.bmd|0x00616E": "「何としてもあの特機を止めなければ……！！」", "Battle/Dat/Battle/Message/146.bmd|0x0061B1": "「ぐうっ！/　あんな機体にやられるわけには！」"}