{"Battle/Dat/Battle/Message/107.bmd|0x0075C7": "「ううっ！　やってくれたわね、エグレッタ！」", "Battle/Dat/Battle/Message/107.bmd|0x00760A": "「ううっ！/　アレス・ガイスト……何てパワーなの……！」", "Battle/Dat/Battle/Message/107.bmd|0x00765D": "「か、夏喃、あたしはまだ！」", "Battle/Dat/Battle/Message/107.bmd|0x007688": "「光龍、あんたなんかに……！」", "Battle/Dat/Battle/Message/107.bmd|0x0076B6": "「と、父さん……クリス……！！」", "Battle/Dat/Battle/Message/107.bmd|0x0076E7": "「ペルフェクティオ……！/　負けられないのよ、クリスのためにも！」", "Battle/Dat/Battle/Message/107.bmd|0x007749": "「こ、ここでやられたら、世界が破滅する！」", "Battle/Dat/Battle/Message/107.bmd|0x007789": "「ユ、ユーゼス……あたしはまだ……！！」", "Battle/Dat/Battle/Message/107.bmd|0x0077C6": "「あ、あの武器を何とかしなきゃ……！」", "Battle/Dat/Battle/Message/107.bmd|0x007800": "「これが四凶の力……！」", "Battle/Dat/Battle/Message/107.bmd|0x007825": "「こ、ここでＡＩ１を止めなきゃ……！」", "Battle/Dat/Battle/Message/107.bmd|0x00785F": "「くううっ！　これが神の力だって言うの！？」", "Battle/Dat/Battle/Message/107.bmd|0x0078A2": "「くうっ！　まだこの子は戦えるわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x0078DC": "「このっ、よくも！」", "Battle/Dat/Battle/Message/107.bmd|0x0078FB": "「ううっ、腰のモーターが引っ掛かってる！？」", "Battle/Dat/Battle/Message/107.bmd|0x00793E": "「ＡＤＣで何とか凌ぐ……！」", "Battle/Dat/Battle/Message/107.bmd|0x007969": "「くっ！　アニキを心配させるわけには/　いかないのに……！」", "Battle/Dat/Battle/Message/107.bmd|0x0079C2": "「この子もあたしも、まだ戦えるわ！」", "Battle/Dat/Battle/Message/107.bmd|0x0079F9": "「ううっ、正確な狙いね……！」", "Battle/Dat/Battle/Message/107.bmd|0x007A27": "「い、嫌な所に当ててくれるじゃない……！」", "Battle/Dat/Battle/Message/107.bmd|0x007A67": "（うぅ～、やられちゃうよぉ！）", "Battle/Dat/Battle/Message/107.bmd|0x007A95": "「やられない！」", "Battle/Dat/Battle/Message/107.bmd|0x007AAE": "「まだ、まだやられないわ！」", "Battle/Dat/Battle/Message/107.bmd|0x007AD9": "（リ、リアナ！）", "Battle/Dat/Battle/Message/107.bmd|0x007AF2": "「何とかしてみせるって言ったでしょ！」", "Battle/Dat/Battle/Message/107.bmd|0x007B2C": "（リ、リアナ、しっかり！）", "Battle/Dat/Battle/Message/107.bmd|0x007B54": "「ええ、何とかしてみせる！」", "Battle/Dat/Battle/Message/107.bmd|0x007B7F": "「くうっ、シュンパティアが……！/　ウェントスの影響なの……！？」", "Battle/Dat/Battle/Message/107.bmd|0x007BE1": "「イグニスに動きを読まれてる！？」", "Battle/Dat/Battle/Message/107.bmd|0x007C15": "「あたしはまだ戦えるわよ、コンターギオ！」", "Battle/Dat/Battle/Message/107.bmd|0x007C55": "「コンターギオ、あんたなんかに！」", "Battle/Dat/Battle/Message/107.bmd|0x007C89": "「や、やってくれるわね、ルイーナ！」", "Battle/Dat/Battle/Message/107.bmd|0x007CC0": "「こ、怖がったら、ルイーナの思う壺に……！」", "Battle/Dat/Battle/Message/107.bmd|0x007D03": "「ジンライ……あのスピードは！」", "Battle/Dat/Battle/Message/107.bmd|0x007D34": "「な、何なの、あのスピードは！」", "Battle/Dat/Battle/Message/107.bmd|0x007D65": "「窮奇王……何て速さなの！」", "Battle/Dat/Battle/Message/107.bmd|0x007D90": "「じゃ、雀武王の動きを見切れない！」", "Battle/Dat/Battle/Message/107.bmd|0x007DC7": "「エルデ！　まだあたしは戦えるわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x007E01": "「ＡＩ１……何をしてくるか、読めない……！」", "Battle/Dat/Battle/Message/107.bmd|0x007E44": "「そんな攻撃じゃ、この子は落とせないわ！」", "Battle/Dat/Battle/Message/107.bmd|0x007E84": "「この程度で止められると思わないで！」", "Battle/Dat/Battle/Message/107.bmd|0x007EBE": "「しまった、避けられなかった！」", "Battle/Dat/Battle/Message/107.bmd|0x007EEF": "「このぐらい、平気なんだから！」", "Battle/Dat/Battle/Message/107.bmd|0x007F20": "「この子の装甲を甘く見ないで！」", "Battle/Dat/Battle/Message/107.bmd|0x007F51": "「油断したつもりはないのに……！」", "Battle/Dat/Battle/Message/107.bmd|0x007F85": "「この程度の傷、どうってことないわ！」", "Battle/Dat/Battle/Message/107.bmd|0x007FBF": "「レース・アルカーナに異常はない、/　いけるわ！」", "Battle/Dat/Battle/Message/107.bmd|0x008009": "（あ、当たった！）", "Battle/Dat/Battle/Message/107.bmd|0x008025": "「大丈夫、これなら問題ないわ」", "Battle/Dat/Battle/Message/107.bmd|0x008053": "「全然効かないわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x008075": "（うぅ～、次は避けてね）", "Battle/Dat/Battle/Message/107.bmd|0x00809A": "「損傷軽微、問題なしっと」", "Battle/Dat/Battle/Message/107.bmd|0x0080C2": "（うぅ～、ホント？）", "Battle/Dat/Battle/Message/107.bmd|0x0080E1": "（これぐらい、平気だよね？）", "Battle/Dat/Battle/Message/107.bmd|0x00810C": "「ええ、まだ余裕よ！」", "Battle/Dat/Battle/Message/107.bmd|0x00812E": "「くっ！　ウェントス！」", "Battle/Dat/Battle/Message/107.bmd|0x008153": "「ウェントスに動きを読まれてる……！？」", "Battle/Dat/Battle/Message/107.bmd|0x008190": "「大したことないわよ、イグニス！」", "Battle/Dat/Battle/Message/107.bmd|0x0081C4": "「それで終わりなの、イグニス！」", "Battle/Dat/Battle/Message/107.bmd|0x0081F5": "「効いてないわよ、コンターギオ！」", "Battle/Dat/Battle/Message/107.bmd|0x008229": "「やってくれたわね、アクイラ！」", "Battle/Dat/Battle/Message/107.bmd|0x00825A": "「アクイラ、それで終わり！？」", "Battle/Dat/Battle/Message/107.bmd|0x008288": "「どうってことないわよ、ウンブラ！」", "Battle/Dat/Battle/Message/107.bmd|0x0082BF": "「ドゥバン！　これぐらい平気よ！」", "Battle/Dat/Battle/Message/107.bmd|0x0082F3": "「いい加減にしなさいよ、あんた達！」", "Battle/Dat/Battle/Message/107.bmd|0x00832A": "「まだ平気よ、夏喃！」", "Battle/Dat/Battle/Message/107.bmd|0x00834C": "「あんたの言うことなんか聞かないわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x008389": "「笑ってられるのも今の内よ、光龍！」", "Battle/Dat/Battle/Message/107.bmd|0x0083C0": "「この程度で絶望なんてしないわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x0083F7": "「効いてないわよ、ペルフェクティオ！」", "Battle/Dat/Battle/Message/107.bmd|0x008431": "「それで終わりなの、ペルフェクティオ！」", "Battle/Dat/Battle/Message/107.bmd|0x00846E": "「ユーゼス、あたしは怯まないわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x0084A5": "「ルイーナ！　あたしの邪魔をしないで！」", "Battle/Dat/Battle/Message/107.bmd|0x0084E2": "「ルイーナにやられるわけには！」", "Battle/Dat/Battle/Message/107.bmd|0x008513": "「くっ！　あいつ、速い！」", "Battle/Dat/Battle/Message/107.bmd|0x00853B": "「くっ！　ジンライを振り切れない！」", "Battle/Dat/Battle/Message/107.bmd|0x008572": "「しつこいのよ、あんた達は！」", "Battle/Dat/Battle/Message/107.bmd|0x0085A0": "「ガルベルス……隙がないわね……！」", "Battle/Dat/Battle/Message/107.bmd|0x0085D7": "「ガンエデン、あんたなんかに……！」", "Battle/Dat/Battle/Message/107.bmd|0x00860E": "「このぐらいなら、あたしだって！」", "Battle/Dat/Battle/Message/107.bmd|0x008642": "「スピードはこっちの方が上ね！」", "Battle/Dat/Battle/Message/107.bmd|0x008673": "「あたしを狙ったって！」", "Battle/Dat/Battle/Message/107.bmd|0x008698": "「見え見えなのよ！」", "Battle/Dat/Battle/Message/107.bmd|0x0086B7": "「この子を狙っても無駄なんだから！」", "Battle/Dat/Battle/Message/107.bmd|0x0086EE": "「そんなもの、この子には！」", "Battle/Dat/Battle/Message/107.bmd|0x008719": "「どこを狙ってるの！」", "Battle/Dat/Battle/Message/107.bmd|0x00873B": "「狙いが甘いわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x00875A": "（あ、当たっちゃう～！）", "Battle/Dat/Battle/Message/107.bmd|0x00877F": "「当たらないわ！」", "Battle/Dat/Battle/Message/107.bmd|0x00879B": "（きゃあっ！）", "Battle/Dat/Battle/Message/107.bmd|0x0087B1": "「大丈夫、かわしたわ！」", "Battle/Dat/Battle/Message/107.bmd|0x0087D6": "「あいつの攻撃が見える……！？」", "Battle/Dat/Battle/Message/107.bmd|0x008807": "「あいつの手がわかる……どうして……！？」", "Battle/Dat/Battle/Message/107.bmd|0x008847": "（あ、あの人、いったい……！？）", "Battle/Dat/Battle/Message/107.bmd|0x008878": "「それに、この感覚は……！」", "Battle/Dat/Battle/Message/107.bmd|0x0088A3": "（リアナ、ウェントスは……！）", "Battle/Dat/Battle/Message/107.bmd|0x0088D1": "「意識しちゃ駄目よ！」", "Battle/Dat/Battle/Message/107.bmd|0x0088F3": "「やっぱり、ウェントスとは違う……！」", "Battle/Dat/Battle/Message/107.bmd|0x00892D": "「シュンパティアにノイズが……！」", "Battle/Dat/Battle/Message/107.bmd|0x008961": "「メリオルエッセも大したことないわね！」", "Battle/Dat/Battle/Message/107.bmd|0x00899E": "「あんたの炎は届かないわ！」", "Battle/Dat/Battle/Message/107.bmd|0x0089C9": "「イグニス、あんたなんかに！」", "Battle/Dat/Battle/Message/107.bmd|0x0089F7": "「甘いわよ、アクイラ！」", "Battle/Dat/Battle/Message/107.bmd|0x008A1C": "「その手には乗らないわよ、コンターギオ！」", "Battle/Dat/Battle/Message/107.bmd|0x008A5C": "「無駄よ、コンターギオ！」", "Battle/Dat/Battle/Message/107.bmd|0x008A84": "「あたしはここよ、ウンブラ！」", "Battle/Dat/Battle/Message/107.bmd|0x008AB2": "「ウンブラ、/　あんたの思い通りにはならないわ！」", "Battle/Dat/Battle/Message/107.bmd|0x008AFC": "「当たらないわ、ドゥバン！」", "Battle/Dat/Battle/Message/107.bmd|0x008B27": "「アレス・ガイストより、/　こっちの方が速いんだから！」", "Battle/Dat/Battle/Message/107.bmd|0x008B7A": "「ガイアセイバーズなんかに！」", "Battle/Dat/Battle/Message/107.bmd|0x008BA8": "「甘いわよ、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/107.bmd|0x008BD9": "「当たらないわよ、エグレッタ！」", "Battle/Dat/Battle/Message/107.bmd|0x008C0A": "「エグレッタ、どこを見てるのよ！」", "Battle/Dat/Battle/Message/107.bmd|0x008C3E": "「地球人を甘く見ないでよね！」", "Battle/Dat/Battle/Message/107.bmd|0x008C6C": "「夏喃！　当たらないわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x008C97": "「狙いが甘いわね、泰北！」", "Battle/Dat/Battle/Message/107.bmd|0x008CBF": "「破滅するのは、あんたの方よ！」", "Battle/Dat/Battle/Message/107.bmd|0x008CF0": "「あんたの前世なんて、どうでもいいわよ！」", "Battle/Dat/Battle/Message/107.bmd|0x008D30": "「あんたとの因縁なんて、願い下げよ！」", "Battle/Dat/Battle/Message/107.bmd|0x008D6A": "「ルイーナなんかに！」"}