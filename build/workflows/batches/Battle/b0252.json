{"Battle/Dat/Battle/Message/190.bmd|0x001F82": "「使える武器がねえだと！？」", "Battle/Dat/Battle/Message/190.bmd|0x001FAD": "「いったん離れるニャ！」", "Battle/Dat/Battle/Message/190.bmd|0x001FD2": "「ちっ！　こっからじゃ届かねえ！！」", "Battle/Dat/Battle/Message/190.bmd|0x002009": "「どこ見てんだ！　隙だらけだぜ！！」", "Battle/Dat/Battle/Message/190.bmd|0x002040": "「まだだ！　もう一撃！！」", "Battle/Dat/Battle/Message/190.bmd|0x002068": "「こいつはおまけだ！　とっときなっ！！」", "Battle/Dat/Battle/Message/190.bmd|0x0020A5": "「まとめて片づけてやるぜ！」", "Battle/Dat/Battle/Message/190.bmd|0x0020D0": "「いけぇっ！　カロリックミサイル！！」", "Battle/Dat/Battle/Message/190.bmd|0x00210A": "「いっけぇぇっ！！/　サイフラァァァッシュ！！」", "Battle/Dat/Battle/Message/190.bmd|0x002151": "「いけっ！　ハイファミリア！！」", "Battle/Dat/Battle/Message/190.bmd|0x002182": "「待ってましたニャ！」", "Battle/Dat/Battle/Message/190.bmd|0x0021A4": "「あたし達にまかせて！」", "Battle/Dat/Battle/Message/190.bmd|0x0021C9": "「おいら達にまかせときニャって！」", "Battle/Dat/Battle/Message/190.bmd|0x0021FD": "「行くニャ、シロ！」", "Battle/Dat/Battle/Message/190.bmd|0x00221C": "「あたし達に、おまかせニャ！」", "Battle/Dat/Battle/Message/190.bmd|0x00224A": "「たのんだぜ、クロ、シロ！」", "Battle/Dat/Battle/Message/190.bmd|0x002275": "「ＯＫニャ！」", "Battle/Dat/Battle/Message/190.bmd|0x00228B": "「クロ、シロ！　お前達の出番だぜ！」", "Battle/Dat/Battle/Message/190.bmd|0x0022C2": "「よし、ハイファミリアだ！」", "Battle/Dat/Battle/Message/190.bmd|0x0022ED": "「やってやるぜっ！！」", "Battle/Dat/Battle/Message/190.bmd|0x00230F": "「やるのはあたし達ニャんだケドね……」", "Battle/Dat/Battle/Message/190.bmd|0x002349": "「ニャ～んか最近、/　おいら達の扱いが荒くなってきたニャ……」", "Battle/Dat/Battle/Message/190.bmd|0x0023A5": "「ぶつくさ言わニャいの！」", "Battle/Dat/Battle/Message/190.bmd|0x0023CD": "「任せたぜ！　クロ、シロ！」", "Battle/Dat/Battle/Message/190.bmd|0x0023F8": "「猫使いが荒いニャ～！」", "Battle/Dat/Battle/Message/190.bmd|0x00241D": "「そんニャこと言ってる場合じゃ/　ニャいでしょ！」", "Battle/Dat/Battle/Message/190.bmd|0x002467": "「ディスカッター、霞斬り！」", "Battle/Dat/Battle/Message/190.bmd|0x002492": "「おらおらおらおらっ！！」", "Battle/Dat/Battle/Message/190.bmd|0x0024BA": "「行くぞ！　ディスカッター、霞斬りぃっ！」", "Battle/Dat/Battle/Message/190.bmd|0x0024FA": "「ディスカッターでぶった斬ってやる！」", "Battle/Dat/Battle/Message/190.bmd|0x002534": "「魔法剣エーテルちゃぶ台返し！」", "Battle/Dat/Battle/Message/190.bmd|0x002565": "「そんな技、ニャいニャ」", "Battle/Dat/Battle/Message/190.bmd|0x00258A": "「くらえっ！！」", "Battle/Dat/Battle/Message/190.bmd|0x0025A3": "「アァァカシックバスタァァァァァッ！！」", "Battle/Dat/Battle/Message/190.bmd|0x0025E0": "「いっけぇぇっ！！」", "Battle/Dat/Battle/Message/190.bmd|0x0025FF": "「アカシック・バスターッ！！」", "Battle/Dat/Battle/Message/190.bmd|0x00262D": "「でえええいっ！！」", "Battle/Dat/Battle/Message/190.bmd|0x00264C": "「おりゃあああっ！！」", "Battle/Dat/Battle/Message/190.bmd|0x00266E": "「こいつでとどめだ！！」", "Battle/Dat/Battle/Message/190.bmd|0x002693": "「コスモノヴァ！！」", "Battle/Dat/Battle/Message/191.bmd|0x00142E": "「当たれっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x001447": "「もらったぜ！」", "Battle/Dat/Battle/Message/191.bmd|0x001460": "「やるかよっ！」", "Battle/Dat/Battle/Message/191.bmd|0x001479": "「させるかよっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x001498": "「気に入らねえんだよっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x0014C3": "「この野郎！！」", "Battle/Dat/Battle/Message/191.bmd|0x0014DC": "「さっさとやられちまいなっ！」", "Battle/Dat/Battle/Message/191.bmd|0x00150A": "「やらせるかよっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x00152C": "「行くぜ、サイバスター！」", "Battle/Dat/Battle/Message/191.bmd|0x001554": "「風の魔装機神の力を見せてやる！」", "Battle/Dat/Battle/Message/191.bmd|0x001588": "「マサキ、敵が来るニャ！」", "Battle/Dat/Battle/Message/191.bmd|0x0015B0": "「ああ、わかったぜ！」", "Battle/Dat/Battle/Message/191.bmd|0x0015D2": "「マサキ、正面ニャ！」", "Battle/Dat/Battle/Message/191.bmd|0x0015F4": "「よし、行くぜ！」", "Battle/Dat/Battle/Message/191.bmd|0x001610": "「ヘッ、おいでなすったな！　行くぜ！」", "Battle/Dat/Battle/Message/191.bmd|0x00164A": "「マサキ、ちゃんと狙ってニャ！」", "Battle/Dat/Battle/Message/191.bmd|0x00167B": "「クロ、しっかり掴まってろよ！」", "Battle/Dat/Battle/Message/191.bmd|0x0016AC": "「わかったニャ！」", "Battle/Dat/Battle/Message/191.bmd|0x0016C8": "「マサキ、こっちに気づいたニャ！」", "Battle/Dat/Battle/Message/191.bmd|0x0016FC": "「させるかよっ！」", "Battle/Dat/Battle/Message/191.bmd|0x001718": "「マサキ、しっかり頼むニャ！」", "Battle/Dat/Battle/Message/191.bmd|0x001746": "「やりやがったなっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x00176B": "「お返しだぜっ！」", "Battle/Dat/Battle/Message/191.bmd|0x001787": "「こいつはおつりだっ！　とっときなっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x0017C7": "「受けた分は、きっちり返すぜっ！」", "Battle/Dat/Battle/Message/191.bmd|0x0017FB": "「さあて、反撃開始と行くかっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x00182F": "「まだまだ！　これからだぜっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x001863": "「ここから本領発揮だぜっ！」", "Battle/Dat/Battle/Message/191.bmd|0x00188E": "「次はこっちの番だっ！」", "Battle/Dat/Battle/Message/191.bmd|0x0018B3": "「ちっ！！/　オレもヤキがまわったもんだぜ！！」", "Battle/Dat/Battle/Message/191.bmd|0x0018FA": "「ちきしょう！/　このままじゃやられちまうぜっ！」", "Battle/Dat/Battle/Message/191.bmd|0x001944": "「何ぃっ！？　こいつ、/　これ程のパワーがあったのか！？」", "Battle/Dat/Battle/Message/191.bmd|0x00199A": "「くっそおっ！！/　こんな事でやられてたまるかっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x0019EA": "「うあぁっ！！/　ちっ、まずい事になってきやがった……！」", "Battle/Dat/Battle/Message/191.bmd|0x001A40": "「どうした、サイバスター！/　お前の力はそんなもんじゃねえだろ！？」", "Battle/Dat/Battle/Message/191.bmd|0x001AA5": "「ちっ！！　やるじゃねえかっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x001AD9": "「くっ、このっ！/　サイバスターをなめるなっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x001B23": "「くっ！　てめえなんぞにっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x001B54": "「つっ……！　なんの、まだっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x001B88": "「いってぇ……！/　やりやがったな、こんちきしょう！！」", "Battle/Dat/Battle/Message/191.bmd|0x001BDB": "「ヘッ、こっちのスピードに/　追いつきやがったか！」", "Battle/Dat/Battle/Message/191.bmd|0x001C28": "「へん、その程度かよ！」", "Battle/Dat/Battle/Message/191.bmd|0x001C4D": "「ヘヘン！　効いてないぜ！」", "Battle/Dat/Battle/Message/191.bmd|0x001C78": "「何だよ、そんなんで/　この俺に向かって来るってのか？」", "Battle/Dat/Battle/Message/191.bmd|0x001CCB": "「なんでえ、そんなもんかよ！」", "Battle/Dat/Battle/Message/191.bmd|0x001CF9": "「狙いが甘いぜ！！」", "Battle/Dat/Battle/Message/191.bmd|0x001D18": "「へたくそっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x001D34": "「当たるかよっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x001D53": "「風の魔装機神は、ダテじゃねえんだよっ！」", "Battle/Dat/Battle/Message/191.bmd|0x001D93": "「おおっと！　ハズレだぜ」", "Battle/Dat/Battle/Message/191.bmd|0x001DBB": "「ヘッ、当たらねえな！」", "Battle/Dat/Battle/Message/191.bmd|0x001DE0": "「ヘッ、俺を相手にするのはやめときな！」", "Battle/Dat/Battle/Message/191.bmd|0x001E1D": "「バーカ、もっとよく狙いな！」", "Battle/Dat/Battle/Message/191.bmd|0x001E4B": "「笑わせんな！/　そんな腕で勝負するつもりかよ？」", "Battle/Dat/Battle/Message/191.bmd|0x001E95": "「それじゃ、サイバスターに/　触れることは出来ねえぜ！」", "Battle/Dat/Battle/Message/191.bmd|0x001EE8": "「………」", "Battle/Dat/Battle/Message/191.bmd|0x001EF8": "「フン、効かねえぜ！」", "Battle/Dat/Battle/Message/191.bmd|0x001F1A": "「そんなもんが効くかよっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x001F48": "「くそっ！　弾切れになっちまった！！」", "Battle/Dat/Battle/Message/191.bmd|0x001F82": "「使える武器がねえだと！？」", "Battle/Dat/Battle/Message/191.bmd|0x001FAD": "「いったん離れるニャ！」", "Battle/Dat/Battle/Message/191.bmd|0x001FD2": "「ちっ！　こっからじゃ届かねえ！！」", "Battle/Dat/Battle/Message/191.bmd|0x002009": "「どこ見てんだ！　隙だらけだぜ！！」", "Battle/Dat/Battle/Message/191.bmd|0x002040": "「まだだ！　もう一撃！！」", "Battle/Dat/Battle/Message/191.bmd|0x002068": "「こいつはおまけだ！　とっときなっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x0020A5": "「まとめて片づけてやるぜ！」", "Battle/Dat/Battle/Message/191.bmd|0x0020D0": "「いけぇっ！　カロリックミサイル！！」", "Battle/Dat/Battle/Message/191.bmd|0x00210A": "「いっけぇぇっ！！/　サイフラァァァッシュ！！」", "Battle/Dat/Battle/Message/191.bmd|0x002151": "「いけっ！　ハイファミリア！！」", "Battle/Dat/Battle/Message/191.bmd|0x002182": "「待ってましたニャ！」", "Battle/Dat/Battle/Message/191.bmd|0x0021A4": "「あたし達にまかせて！」", "Battle/Dat/Battle/Message/191.bmd|0x0021C9": "「おいら達にまかせときニャって！」", "Battle/Dat/Battle/Message/191.bmd|0x0021FD": "「行くニャ、シロ！」", "Battle/Dat/Battle/Message/191.bmd|0x00221C": "「あたし達に、おまかせニャ！」", "Battle/Dat/Battle/Message/191.bmd|0x00224A": "「たのんだぜ、クロ、シロ！」", "Battle/Dat/Battle/Message/191.bmd|0x002275": "「ＯＫニャ！」", "Battle/Dat/Battle/Message/191.bmd|0x00228B": "「クロ、シロ！　お前達の出番だぜ！」", "Battle/Dat/Battle/Message/191.bmd|0x0022C2": "「よし、ハイファミリアだ！」", "Battle/Dat/Battle/Message/191.bmd|0x0022ED": "「やってやるぜっ！！」", "Battle/Dat/Battle/Message/191.bmd|0x00230F": "「やるのはあたし達ニャんだケドね……」"}