{"Battle/Dat/Battle/Message/100.bmd|0x00304D": "「セティ……目をかけてやった恩も忘れたか」", "Battle/Dat/Battle/Message/100.bmd|0x00308D": "「貴様もか、ゼブ」", "Battle/Dat/Battle/Message/100.bmd|0x0030A9": "「魔装機神、あれを手に入れれば……！」", "Battle/Dat/Battle/Message/100.bmd|0x0030E3": "「魔装機神、その技術は素晴らしいが……」", "Battle/Dat/Battle/Message/100.bmd|0x003120": "「その機体は、/　貴様らの危険性を証明している……！」", "Battle/Dat/Battle/Message/100.bmd|0x003170": "「短時間でそこまで昇華させるとはな……」", "Battle/Dat/Battle/Message/100.bmd|0x0031AD": "「蒔いた種を刈り取るとしよう」", "Battle/Dat/Battle/Message/100.bmd|0x0031DB": "「あの連中の痕跡は、消しておかねばな」", "Battle/Dat/Battle/Message/100.bmd|0x003215": "「その機体は、貴様らには過ぎた代物だ」", "Battle/Dat/Battle/Message/100.bmd|0x00324F": "「猿共には相応しくない兵器だな」", "Battle/Dat/Battle/Message/100.bmd|0x003280": "「貴様らの技術応用力……そこは評価に値する」", "Battle/Dat/Battle/Message/100.bmd|0x0032C3": "「下等な猿が、檻から出ようなどと……！」", "Battle/Dat/Battle/Message/100.bmd|0x003300": "「我らの領域に踏み込むことは許さん」", "Battle/Dat/Battle/Message/100.bmd|0x003337": "「その力……/　それを生み出した技術を手にすれば、/　私は……」", "Battle/Dat/Battle/Message/100.bmd|0x003394": "「あのような代物を、/　猿共の手に委ねておくわけにはいかん」", "Battle/Dat/Battle/Message/100.bmd|0x0033ED": "「その機体、それを作りだした技術……/　危険だな」", "Battle/Dat/Battle/Message/100.bmd|0x003437": "「下等生物共が……図に乗るな」", "Battle/Dat/Battle/Message/100.bmd|0x003465": "「猿共め、身の程を知れ！」", "Battle/Dat/Battle/Message/100.bmd|0x00348D": "「逃がさん！」", "Battle/Dat/Battle/Message/100.bmd|0x0034A3": "「調子に乗るな！」", "Battle/Dat/Battle/Message/100.bmd|0x0034BF": "「思い上がるな、下等生物共め」", "Battle/Dat/Battle/Message/100.bmd|0x0034ED": "「勘違いするな。/　追い込まれたのは、貴様らの方だ」", "Battle/Dat/Battle/Message/100.bmd|0x00353A": "「ぬううっ！　ここまでか！！」", "Battle/Dat/Battle/Message/100.bmd|0x003568": "「ええい、覚えておれよ！！」", "Battle/Dat/Battle/Message/100.bmd|0x003593": "「こ、こ、この私が、地球の猿などにぃぃ！！」", "Battle/Dat/Battle/Message/100.bmd|0x0035D6": "「くっ！　よくもやりおったな！」", "Battle/Dat/Battle/Message/100.bmd|0x003607": "「うおおっ！　許さん、許さんぞ！」", "Battle/Dat/Battle/Message/100.bmd|0x00363B": "「な、何だと！？」", "Battle/Dat/Battle/Message/100.bmd|0x003657": "「おのれ……下等な猿共が！」", "Battle/Dat/Battle/Message/100.bmd|0x003682": "「地球人め、これ以上はやらせんぞ！」", "Battle/Dat/Battle/Message/100.bmd|0x0036B9": "「うっ！　貴様ら……生かしては帰さんぞ！」", "Battle/Dat/Battle/Message/100.bmd|0x0036F9": "「この力……やはり、貴様らは危険な動物だ！」", "Battle/Dat/Battle/Message/100.bmd|0x00373C": "「馬鹿な、バラン＝シュナイルが/　パワー負けしているだと！？」", "Battle/Dat/Battle/Message/100.bmd|0x003798": "「奴め、力を出し惜しみしていたのか！」", "Battle/Dat/Battle/Message/100.bmd|0x0037D2": "「おのれ、シュウ・シラカワ！」", "Battle/Dat/Battle/Message/100.bmd|0x003800": "「ええい、裏切り者めが！」", "Battle/Dat/Battle/Message/100.bmd|0x003828": "「裏切り者共が、よくも！！」", "Battle/Dat/Battle/Message/100.bmd|0x003853": "「おのれ、サイバスターめ！」", "Battle/Dat/Battle/Message/100.bmd|0x00387E": "「ぬうっ、魔装機神め、厄介な……！」", "Battle/Dat/Battle/Message/100.bmd|0x0038B5": "「こ、この力……/　ヒュッケバインを超えている！？」", "Battle/Dat/Battle/Message/100.bmd|0x003902": "「猿共め、好きなだけあがくがいい」", "Battle/Dat/Battle/Message/100.bmd|0x003936": "「何の真似だ、それは？」", "Battle/Dat/Battle/Message/100.bmd|0x00395B": "「フッ、悪あがきを……」", "Battle/Dat/Battle/Message/100.bmd|0x003980": "「どうした？　それで終わりなのか？」", "Battle/Dat/Battle/Message/100.bmd|0x0039B7": "「さすがだと言っておこうか」", "Battle/Dat/Battle/Message/100.bmd|0x0039E2": "「ふん、諦めの悪い連中だな」", "Battle/Dat/Battle/Message/100.bmd|0x003A0D": "「私に逆らった罪、万死に値する！」", "Battle/Dat/Battle/Message/100.bmd|0x003A41": "「バラン＝シュナイル……よく保つ」", "Battle/Dat/Battle/Message/100.bmd|0x003A75": "「勢いだけで、/　このバラン＝シュナイルは倒せんぞ」", "Battle/Dat/Battle/Message/100.bmd|0x003AC2": "「バラン＝シュナイルは/　我が軍最強の兵器……/　貴様らもそのことを知っているはずだ」", "Battle/Dat/Battle/Message/100.bmd|0x003B40": "「大口を叩くだけか、シュウ・シラカワ」", "Battle/Dat/Battle/Message/100.bmd|0x003B7A": "「サイバスター……買い被り過ぎたか」", "Battle/Dat/Battle/Message/100.bmd|0x003BB1": "「それが魔装機神の力か？」", "Battle/Dat/Battle/Message/100.bmd|0x003BD9": "「それでヒュッケバインの後継機などと……」", "Battle/Dat/Battle/Message/100.bmd|0x003C19": "「貴様らの力など、所詮その程度よ」", "Battle/Dat/Battle/Message/100.bmd|0x003C4D": "「ふん、大人しく投降した方が身のためだぞ」", "Battle/Dat/Battle/Message/100.bmd|0x003C8D": "「無駄だ、無駄だ！」", "Battle/Dat/Battle/Message/100.bmd|0x003CAC": "「いちいち回避するまでもない」", "Battle/Dat/Battle/Message/100.bmd|0x003CDA": "「貴様など、相手にならん」", "Battle/Dat/Battle/Message/100.bmd|0x003D02": "「思っていた程ではないな」", "Battle/Dat/Battle/Message/100.bmd|0x003D2A": "「ふっ、意気込みだけではな」", "Battle/Dat/Battle/Message/100.bmd|0x003D55": "「ふん、バラン＝シュナイルを甘く見たな」", "Battle/Dat/Battle/Message/100.bmd|0x003D92": "「グランゾンの力は、その程度か？」", "Battle/Dat/Battle/Message/100.bmd|0x003DC6": "「ふん、裏切り者めが」", "Battle/Dat/Battle/Message/100.bmd|0x003DE8": "「私に刃向かった罪……許し難い」", "Battle/Dat/Battle/Message/100.bmd|0x003E19": "「サイバスター……素早いだけか」", "Battle/Dat/Battle/Message/100.bmd|0x003E4A": "「魔装機神……非力だな」", "Battle/Dat/Battle/Message/100.bmd|0x003E6F": "「ヒュッケバインの方が優秀だな」", "Battle/Dat/Battle/Message/100.bmd|0x003EA0": "「大仰な得物だが、大したことはないな」", "Battle/Dat/Battle/Message/100.bmd|0x003EDA": "「無能な……」", "Battle/Dat/Battle/Message/100.bmd|0x003EF0": "「当たりはせんよ」", "Battle/Dat/Battle/Message/100.bmd|0x003F0C": "「猿とじゃれ合う気はない」", "Battle/Dat/Battle/Message/100.bmd|0x003F34": "「どこを見ているのだ？」", "Battle/Dat/Battle/Message/100.bmd|0x003F59": "「ふん、時間の無駄だな」", "Battle/Dat/Battle/Message/100.bmd|0x003F7E": "「貴様など、私の敵ではない！」", "Battle/Dat/Battle/Message/100.bmd|0x003FAC": "「下らん攻撃だ」", "Battle/Dat/Battle/Message/100.bmd|0x003FC5": "「ふん……」", "Battle/Dat/Battle/Message/100.bmd|0x003FD8": "「無駄なことを……所詮は猿か」", "Battle/Dat/Battle/Message/100.bmd|0x004006": "「効かんな、そんなものは」", "Battle/Dat/Battle/Message/100.bmd|0x00402E": "「無意味だったな」", "Battle/Dat/Battle/Message/100.bmd|0x00404A": "「………」", "Battle/Dat/Battle/Message/100.bmd|0x00405A": "「ちっ、リロードが間に合わんとは……！」", "Battle/Dat/Battle/Message/100.bmd|0x004097": "「反撃できんとは……！」", "Battle/Dat/Battle/Message/100.bmd|0x0040BC": "「まあいい、奴だけに構ってはいられん」", "Battle/Dat/Battle/Message/100.bmd|0x0040F6": "「むっ、これは！」", "Battle/Dat/Battle/Message/100.bmd|0x004112": "「小癪な猿めが……！」", "Battle/Dat/Battle/Message/100.bmd|0x004134": "「奴め、どこへ行った……！？」", "Battle/Dat/Battle/Message/100.bmd|0x004162": "「くっ、死角に入られたか……」", "Battle/Dat/Battle/Message/100.bmd|0x004190": "「さあ、観念するがいい……！」", "Battle/Dat/Battle/Message/100.bmd|0x0041BE": "「貴様らの好きにはやらせん！」", "Battle/Dat/Battle/Message/100.bmd|0x0041EC": "「観念するのだな」", "Battle/Dat/Battle/Message/100.bmd|0x004208": "「フッ、まだそんな所にいたか」", "Battle/Dat/Battle/Message/100.bmd|0x004236": "「このバラン＝シュナイルから/　逃げられると思うな」", "Battle/Dat/Battle/Message/100.bmd|0x004283": "「私の前から消え失せろ！！」", "Battle/Dat/Battle/Message/100.bmd|0x0042AE": "「目障りなのだよ！」", "Battle/Dat/Battle/Message/100.bmd|0x0042CD": "「そこか！」", "Battle/Dat/Battle/Message/100.bmd|0x0042E0": "「消え去れ！」", "Battle/Dat/Battle/Message/100.bmd|0x0042F6": "「砲撃開始！」", "Battle/Dat/Battle/Message/100.bmd|0x00430C": "「前方の敵を排除せよ！」", "Battle/Dat/Battle/Message/100.bmd|0x004331": "「敵機を蹴散らすのだ！」", "Battle/Dat/Battle/Message/100.bmd|0x004356": "「目標を一掃せよ！」", "Battle/Dat/Battle/Message/100.bmd|0x004375": "「主砲！　撃てい！」", "Battle/Dat/Battle/Message/100.bmd|0x004394": "「主砲を発射せよ！」", "Battle/Dat/Battle/Message/100.bmd|0x0043B3": "「ここで死ね！」", "Battle/Dat/Battle/Message/100.bmd|0x0043CC": "「受けよ！」", "Battle/Dat/Battle/Message/100.bmd|0x0043DF": "「容赦はせん！」", "Battle/Dat/Battle/Message/100.bmd|0x0043F8": "「狙いはついた……！」", "Battle/Dat/Battle/Message/100.bmd|0x00441A": "「ギガブラスター、発射！」", "Battle/Dat/Battle/Message/100.bmd|0x004442": "「もう逃げられんぞ！」", "Battle/Dat/Battle/Message/100.bmd|0x004464": "「ギガブラスター！！」", "Battle/Dat/Battle/Message/100.bmd|0x004486": "「バラン＝シュナイルの力、/　思い知るがいい！！」", "Battle/Dat/Battle/Message/100.bmd|0x0044D0": "「我が怒り、受けてみよ！！」", "Battle/Dat/Battle/Message/100.bmd|0x0044FB": "「我がバラン＝シュナイルは、/　１機で広範囲戦域の制圧を/　可能とする……！」", "Battle/Dat/Battle/Message/100.bmd|0x00456D": "「メガグラビトンウェーブ！」", "Battle/Dat/Battle/Message/100.bmd|0x004598": "「このバラン＝シュナイルは、/　貴様らのような敵との戦闘を想定して/　開発された……！」", "Battle/Dat/Battle/Message/100.bmd|0x004619": "「くらえい！」", "Battle/Dat/Battle/Message/100.bmd|0x00462F": "「フフフ……/　よく見えるぞ、貴様らのあがく様が」", "Battle/Dat/Battle/Message/100.bmd|0x004679": "「そして、無様に死に行く姿を見せよ！！」", "Battle/Dat/Battle/Message/100.bmd|0x0046B6": "「その檻からは逃げられん」", "Battle/Dat/Battle/Message/100.bmd|0x0046DE": "「撃ち抜いてやる！！」"}