{"Battle/Dat/Battle/Message/075.bmd|0x006614": "「アイビスさんに続くぞ！　連携プレーだ！」", "Battle/Dat/Battle/Message/075.bmd|0x006654": "「アイビスさん、俺も行く！」", "Battle/Dat/Battle/Message/075.bmd|0x00667F": "「手伝うぞ、コウタ！」", "Battle/Dat/Battle/Message/075.bmd|0x0066A1": "「ユウキさん、手伝います！」", "Battle/Dat/Battle/Message/075.bmd|0x0066CC": "「カーラさん、後は任せて下さい！」", "Battle/Dat/Battle/Message/075.bmd|0x006700": "「アクセルさん、続いて行きます！」", "Battle/Dat/Battle/Message/075.bmd|0x006734": "「ジョッシュ、後は俺達に任せろ！」", "Battle/Dat/Battle/Message/075.bmd|0x006768": "「リム、後は任せて！」", "Battle/Dat/Battle/Message/075.bmd|0x00678A": "「ヒューゴ少尉、援護します！」", "Battle/Dat/Battle/Message/075.bmd|0x0067B8": "「アクア少尉、援護します！」", "Battle/Dat/Battle/Message/075.bmd|0x0067E3": "「イング！　後は俺達に任せろ！」", "Battle/Dat/Battle/Message/075.bmd|0x006814": "「援護するぞ、トウマ！」", "Battle/Dat/Battle/Message/075.bmd|0x006839": "「そっちの思い通りにやらせるかよ！」", "Battle/Dat/Battle/Message/075.bmd|0x006870": "「エクサランスを盾にすればっ！」", "Battle/Dat/Battle/Message/075.bmd|0x0068A1": "「このフレームなら、/　頑丈にできているからな！」", "Battle/Dat/Battle/Message/075.bmd|0x0068EB": "「危ないっ！」", "Battle/Dat/Battle/Message/075.bmd|0x006901": "「こういう時もエクサランスの出番！」", "Battle/Dat/Battle/Message/075.bmd|0x006938": "「アラド！　もっと周りを見るんだ！」", "Battle/Dat/Battle/Message/075.bmd|0x00696F": "「ゼオラ！　今の内に逃げるんだ！」", "Battle/Dat/Battle/Message/075.bmd|0x0069A3": "「逃げろ、ラトゥーニ！」", "Battle/Dat/Battle/Message/075.bmd|0x0069C8": "「レーツェルさん、ここは俺が！」", "Battle/Dat/Battle/Message/075.bmd|0x0069F9": "「ゼンガー少佐、下がってください！」", "Battle/Dat/Battle/Message/075.bmd|0x006A30": "「下がってください！　ギリアム少佐！」", "Battle/Dat/Battle/Message/075.bmd|0x006A6A": "「逃げて下さい！　ラミアさん！」", "Battle/Dat/Battle/Message/075.bmd|0x006A9B": "「少尉のカバーに入るっ！」", "Battle/Dat/Battle/Message/075.bmd|0x006AC3": "「大尉、離脱して下さい！」", "Battle/Dat/Battle/Message/075.bmd|0x006AEB": "「アイビスさん、今の内に！」", "Battle/Dat/Battle/Message/075.bmd|0x006B16": "「コウタ、無理をするな！」", "Battle/Dat/Battle/Message/075.bmd|0x006B3E": "「ユウキさん、今の内に離脱を！」", "Battle/Dat/Battle/Message/075.bmd|0x006B6F": "「カーラさん、危ないっ！」", "Battle/Dat/Battle/Message/075.bmd|0x006B97": "「アクセルさん、早く離脱を！」", "Battle/Dat/Battle/Message/075.bmd|0x006BC5": "「ジョッシュ、下がるんだ！」", "Battle/Dat/Battle/Message/075.bmd|0x006BF0": "「リム、早く逃げて！」", "Battle/Dat/Battle/Message/075.bmd|0x006C12": "「ヒューゴ少尉、下がってください！」", "Battle/Dat/Battle/Message/075.bmd|0x006C49": "「アクア少尉、下がってください！」", "Battle/Dat/Battle/Message/075.bmd|0x006C7D": "「イング、下がるんだ！」", "Battle/Dat/Battle/Message/075.bmd|0x006CA2": "「トウマ、そこから離れろ！」", "Battle/Dat/Battle/Message/075.bmd|0x006CCD": "「ラウル、まだ行けるわよ！」", "Battle/Dat/Battle/Message/075.bmd|0x006CF8": "「ああ、押し込む！」", "Battle/Dat/Battle/Message/075.bmd|0x006D17": "「ラウルさん、ロック継続中です」", "Battle/Dat/Battle/Message/075.bmd|0x006D48": "「よし、もう一撃だ！」", "Battle/Dat/Battle/Message/075.bmd|0x006D6A": "「そこだっ！」", "Battle/Dat/Battle/Message/075.bmd|0x006D80": "「もらったぞ！」", "Battle/Dat/Battle/Message/075.bmd|0x006D99": "「当ててみせる！」", "Battle/Dat/Battle/Message/075.bmd|0x006DB5": "「くらえ！」", "Battle/Dat/Battle/Message/075.bmd|0x006DC8": "「落ちてもらう！」", "Battle/Dat/Battle/Message/075.bmd|0x006DE4": "「落ちろ！」", "Battle/Dat/Battle/Message/075.bmd|0x006DF7": "「チャージ完了！　今よ！」", "Battle/Dat/Battle/Message/075.bmd|0x006E1F": "「ウェイスト・スマッシャー、発射！」", "Battle/Dat/Battle/Message/075.bmd|0x006E56": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/075.bmd|0x006E7B": "「ウェイスト・スマッシャー！！」", "Battle/Dat/Battle/Message/075.bmd|0x006EAC": "「外さないでね！」", "Battle/Dat/Battle/Message/075.bmd|0x006EC8": "「ああ！　行けぇぇっ！！」", "Battle/Dat/Battle/Message/075.bmd|0x006EF0": "「突撃するぞ！/　みんな、しっかり掴まっていろ！」", "Battle/Dat/Battle/Message/075.bmd|0x006F3A": "「高速機動モードへ移行します」", "Battle/Dat/Battle/Message/075.bmd|0x006F68": "「みんな、このまま突っ込むぞ！」", "Battle/Dat/Battle/Message/075.bmd|0x006F99": "「フレーム、モード・チェンジ」", "Battle/Dat/Battle/Message/075.bmd|0x006FC7": "「クラッシャー・アーム、フィールド展開！」", "Battle/Dat/Battle/Message/075.bmd|0x007007": "「くらえ！　ギガント・クラッシャー！！」", "Battle/Dat/Battle/Message/075.bmd|0x007044": "「フィールド展開！　いいわよ！」", "Battle/Dat/Battle/Message/075.bmd|0x007075": "「ギガント・クラッシャァァァァッ！！」", "Battle/Dat/Battle/Message/076.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/076.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/076.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/076.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/076.bmd|0x0003FC": "「………？」", "Battle/Dat/Battle/Message/077.bmd|0x0003A4": "「………」", "Battle/Dat/Battle/Message/077.bmd|0x0003B4": "「！？！？！？」", "Battle/Dat/Battle/Message/077.bmd|0x0003CD": "「………！！！」", "Battle/Dat/Battle/Message/077.bmd|0x0003E6": "「………！！」", "Battle/Dat/Battle/Message/077.bmd|0x0003FC": "「………？」", "Battle/Dat/Battle/Message/078.bmd|0x0051C3": "「喧嘩上等！」", "Battle/Dat/Battle/Message/078.bmd|0x0051D9": "「ようし、勝負だ！」", "Battle/Dat/Battle/Message/078.bmd|0x0051F8": "「面倒なのは御免だが……やるしかねえ！」", "Battle/Dat/Battle/Message/078.bmd|0x005235": "「俺が相手をしてやる！」", "Battle/Dat/Battle/Message/078.bmd|0x00525A": "「先手はもらった！」", "Battle/Dat/Battle/Message/078.bmd|0x005279": "「喧嘩は先手必勝！」", "Battle/Dat/Battle/Message/078.bmd|0x005298": "「遠慮なんざしねえぞ！」", "Battle/Dat/Battle/Message/078.bmd|0x0052BD": "「速攻だっ！」", "Battle/Dat/Battle/Message/078.bmd|0x0052D3": "「仕掛けるぜっ！」", "Battle/Dat/Battle/Message/078.bmd|0x0052EF": "「油断するなよ、コウタ」", "Battle/Dat/Battle/Message/078.bmd|0x005314": "「わかってる！」", "Battle/Dat/Battle/Message/078.bmd|0x00532D": "「コウタ、クリスタルに意識を集中させるんだ」", "Battle/Dat/Battle/Message/078.bmd|0x005370": "「ああ！」", "Battle/Dat/Battle/Message/078.bmd|0x005380": "「頼むぞ、コウタ。この世界を守るのだ」", "Battle/Dat/Battle/Message/078.bmd|0x0053BA": "「いちいち言われなくたって！」", "Battle/Dat/Battle/Message/078.bmd|0x0053E8": "「コウタ、前回の戦闘の反省点を生かすんだ」", "Battle/Dat/Battle/Message/078.bmd|0x005428": "「そんなの、もう覚えてねえよ！」", "Battle/Dat/Battle/Message/078.bmd|0x005459": "「来るぞ、コウタ！」", "Battle/Dat/Battle/Message/078.bmd|0x005478": "「よし、行くぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x005494": "「勢いだけでは駄目だ。/　戦いには冷静な心と……」", "Battle/Dat/Battle/Message/078.bmd|0x0054DE": "「うおおっ！　行くぜぇっ！！」", "Battle/Dat/Battle/Message/078.bmd|0x00550C": "「俺とお前、二人の意志と力の結晶……」", "Battle/Dat/Battle/Message/078.bmd|0x005546": "「それがファイター・ロアだ！！」", "Battle/Dat/Battle/Message/078.bmd|0x005577": "「コウタ、慎重に行け」", "Battle/Dat/Battle/Message/078.bmd|0x005599": "「そういうのは性に合わねえんだよ！」", "Battle/Dat/Battle/Message/078.bmd|0x0055D0": "「あの機体、気になる……何故だ？」", "Battle/Dat/Battle/Message/078.bmd|0x005604": "「知らねえよ、そんなこと！」", "Battle/Dat/Battle/Message/078.bmd|0x00562F": "「ヘッ、いかにもライバルロボって感じだな！」", "Battle/Dat/Battle/Message/078.bmd|0x005672": "「あの炎の模様は気に入った！/　だが、それ以外は気にくわねえ！」", "Battle/Dat/Battle/Message/078.bmd|0x0056D1": "「コウタ、迂闊に奴と接触するな。危険だ」", "Battle/Dat/Battle/Message/078.bmd|0x00570E": "「なら、一気にブッ叩いてやる！」", "Battle/Dat/Battle/Message/078.bmd|0x00573F": "「メディウスだかミディアムだか知らねえが！」", "Battle/Dat/Battle/Message/078.bmd|0x005782": "「パワー勝負なら負けねえぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x0057B0": "「腹ン中にヤべえもん抱えやがって！」", "Battle/Dat/Battle/Message/078.bmd|0x0057E7": "「今だ……/　“破滅の王”を止めるのは、今しかない！」", "Battle/Dat/Battle/Message/078.bmd|0x005837": "「ああ、きっちりケリをつけてやるぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x005871": "「奴も次元の門の解放者……！/　何としてもここで食い止めるんだ！」", "Battle/Dat/Battle/Message/078.bmd|0x0058D3": "「ああ、引導を渡してやる！」", "Battle/Dat/Battle/Message/078.bmd|0x0058FE": "「てめえの名前が一番言いにくい！/　ペル公で充分だ！」", "Battle/Dat/Battle/Message/078.bmd|0x00594E": "「行くぜ、チョンマゲ野郎！」", "Battle/Dat/Battle/Message/078.bmd|0x005979": "「面倒くせえ、てめえら略してメッセだ！」", "Battle/Dat/Battle/Message/078.bmd|0x0059B6": "「てめえらの名前は覚えにくいんだよ！」", "Battle/Dat/Battle/Message/078.bmd|0x0059F0": "「てやんでえ、てめえらなんぞにビビるかよ！」", "Battle/Dat/Battle/Message/078.bmd|0x005A33": "「覚悟しやがれ、眉毛侍！」", "Battle/Dat/Battle/Message/078.bmd|0x005A5B": "「ロフ、ガチンコ勝負で行くぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x005A8C": "「ああいう相手はやり易いぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x005ABA": "「ああいう相手はやりにくいぜ！」", "Battle/Dat/Battle/Message/078.bmd|0x005AEB": "「行くぜ、セティ！」", "Battle/Dat/Battle/Message/078.bmd|0x005B0A": "「尸解だか誤解だか知らねえが、/　てめえらの思い通りにいくと思うなよ！」"}