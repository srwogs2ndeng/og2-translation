{"Battle/Dat/Battle/Message/032.bmd|0x0017CE": "「受けてごらん！」", "Battle/Dat/Battle/Message/032.bmd|0x0017EA": "「これでどうっ！」", "Battle/Dat/Battle/Message/032.bmd|0x001806": "「消えなっ！」", "Battle/Dat/Battle/Message/032.bmd|0x00181C": "「容赦はしないから！」", "Battle/Dat/Battle/Message/032.bmd|0x00183E": "「大人しくしてなさいっ！」", "Battle/Dat/Battle/Message/032.bmd|0x001866": "「行くわよ！」", "Battle/Dat/Battle/Message/032.bmd|0x00187C": "「やっ！」", "Battle/Dat/Battle/Message/032.bmd|0x00188C": "「とぅ！」", "Battle/Dat/Battle/Message/032.bmd|0x00189C": "「はっ！」", "Battle/Dat/Battle/Message/032.bmd|0x0018AC": "「えぃっ！」", "Battle/Dat/Battle/Message/032.bmd|0x0018BF": "「ふっ！」", "Battle/Dat/Battle/Message/032.bmd|0x0018CF": "「このっ！」", "Battle/Dat/Battle/Message/033.bmd|0x000C3F": "「少しでも勝つ確率を上げるには、/　先制攻撃が一番効果的です」", "Battle/Dat/Battle/Message/033.bmd|0x000C9B": "「捕捉しました。攻撃を開始します」", "Battle/Dat/Battle/Message/033.bmd|0x000CCF": "「機体の性能差だけで、/　勝てるとは思わないことです」", "Battle/Dat/Battle/Message/033.bmd|0x000D1F": "「前方の敵に仕掛けます」", "Battle/Dat/Battle/Message/033.bmd|0x000D44": "「ソディウム級の火力、お見せしましょう」", "Battle/Dat/Battle/Message/033.bmd|0x000D81": "「ソディウム級で蹴散らします」", "Battle/Dat/Battle/Message/033.bmd|0x000DAF": "「やらせはしません！」", "Battle/Dat/Battle/Message/033.bmd|0x000DD1": "「反撃します！」", "Battle/Dat/Battle/Message/033.bmd|0x000DEA": "「次はこちらの番です！」", "Battle/Dat/Battle/Message/033.bmd|0x000E0F": "「返り討ちにして差し上げましょう！」", "Battle/Dat/Battle/Message/033.bmd|0x000E46": "「では、こちらからも！」", "Battle/Dat/Battle/Message/033.bmd|0x000E6B": "「こ、ここまでですか……！」", "Battle/Dat/Battle/Message/033.bmd|0x000E96": "「ぐううっ！　こ、これ以上は！！」", "Battle/Dat/Battle/Message/033.bmd|0x000ECA": "「な、何ということ……！！」", "Battle/Dat/Battle/Message/033.bmd|0x000EF5": "「ま、まさか、これほどとは……」", "Battle/Dat/Battle/Message/033.bmd|0x000F26": "「こ、ここで終わるわけにはいきませんよ！」", "Battle/Dat/Battle/Message/033.bmd|0x000F66": "「こうも好きにやられるとは……！」", "Battle/Dat/Battle/Message/033.bmd|0x000F9A": "「うぐっ！　ここまで押し込まれるとは！」", "Battle/Dat/Battle/Message/033.bmd|0x000FD7": "「こ、これはまずいですね……！」", "Battle/Dat/Battle/Message/033.bmd|0x001008": "「ち、地上人にここまでやられるとは！」", "Battle/Dat/Battle/Message/033.bmd|0x001042": "「きょ、強敵ですね、あの地上人は……！」", "Battle/Dat/Battle/Message/033.bmd|0x00107F": "「か、覚悟はしていましたが、/　これは予想以上に……！！」", "Battle/Dat/Battle/Message/033.bmd|0x0010D5": "「や、やはり、魔装機神は脅威ですね……！」", "Battle/Dat/Battle/Message/033.bmd|0x001115": "「な、何としても/　サイバスターを食い止めなければ！」", "Battle/Dat/Battle/Message/033.bmd|0x001165": "「うぐっ！/　グランヴェール……やはり、手強い！」", "Battle/Dat/Battle/Message/033.bmd|0x0011AF": "「ガ、ガッデス……！　これはさすがに！」", "Battle/Dat/Battle/Message/033.bmd|0x0011EC": "「くっ、なるほど……油断ならない相手です」", "Battle/Dat/Battle/Message/033.bmd|0x00122C": "「むっ、少し不注意でしたか」", "Battle/Dat/Battle/Message/033.bmd|0x001257": "「つっ、さすがですね……！」", "Battle/Dat/Battle/Message/033.bmd|0x001282": "「やりますね。/　しかし、こちらとてこのまま終わりはしませんよ」", "Battle/Dat/Battle/Message/033.bmd|0x0012E1": "「ま、まだ勝負はついていませんよ……！」", "Battle/Dat/Battle/Message/033.bmd|0x00131E": "「くうっ！　あ、あの地上人は！」", "Battle/Dat/Battle/Message/033.bmd|0x00134F": "「魔装機神、/　やはり侮りがたい相手ですね……！」", "Battle/Dat/Battle/Message/033.bmd|0x001399": "「ぐっ！　サイバスターを近づけるわけには！」", "Battle/Dat/Battle/Message/033.bmd|0x0013DC": "「グ、グランヴェール……この力は……！」", "Battle/Dat/Battle/Message/033.bmd|0x001419": "「ガッデス……これ以上はやらせませんよ！」", "Battle/Dat/Battle/Message/033.bmd|0x001459": "「ふう、思ったより被害は少なかったですね」", "Battle/Dat/Battle/Message/033.bmd|0x001499": "「この程度のダメージは織り込み済みです」", "Battle/Dat/Battle/Message/033.bmd|0x0014D6": "「これぐらいのダメージなら、/　活動に支障はありません」", "Battle/Dat/Battle/Message/033.bmd|0x001529": "「パワー不足ですね」", "Battle/Dat/Battle/Message/033.bmd|0x001548": "「もう少し出来ると思っていましたが……」", "Battle/Dat/Battle/Message/033.bmd|0x001585": "「地上では、/　それで通用していたかも知れませんが……」", "Battle/Dat/Battle/Message/033.bmd|0x0015D8": "「魔装機神の力……/　思っていたほどではありませんね」", "Battle/Dat/Battle/Message/033.bmd|0x001628": "「サイバスター……その程度ですか」", "Battle/Dat/Battle/Message/033.bmd|0x00165C": "「グランヴェールの力が/　そんなものとは思えませんが……」", "Battle/Dat/Battle/Message/033.bmd|0x0016B2": "「魔装機神の中では、一番非力なようですね」", "Battle/Dat/Battle/Message/033.bmd|0x0016F2": "「甘いですね」", "Battle/Dat/Battle/Message/033.bmd|0x001708": "「そうくるのはわかっていました」", "Battle/Dat/Battle/Message/033.bmd|0x001739": "「想定の範囲内です」", "Battle/Dat/Battle/Message/033.bmd|0x001758": "「単調な攻撃ですね」", "Battle/Dat/Battle/Message/033.bmd|0x001777": "「魔装機神を買い被り過ぎていましたか」", "Battle/Dat/Battle/Message/033.bmd|0x0017B1": "「回避成功です」", "Battle/Dat/Battle/Message/033.bmd|0x0017CA": "「………」", "Battle/Dat/Battle/Message/033.bmd|0x0017DA": "「これでは、対処のしようがありませんね」", "Battle/Dat/Battle/Message/033.bmd|0x001817": "「いったん後退するしかありませんか」", "Battle/Dat/Battle/Message/033.bmd|0x00184E": "「む……/　この距離ではどうしようもありませんね」", "Battle/Dat/Battle/Message/033.bmd|0x001898": "「敵を見失うとは……！」", "Battle/Dat/Battle/Message/033.bmd|0x0018BD": "「援護します！」", "Battle/Dat/Battle/Message/033.bmd|0x0018D6": "「こちらからも！」", "Battle/Dat/Battle/Message/033.bmd|0x0018F2": "「隙を見せましたね！」", "Battle/Dat/Battle/Message/033.bmd|0x001914": "「やらせるわけには！」", "Battle/Dat/Battle/Message/033.bmd|0x001936": "「後はこちらで引き受けます！」", "Battle/Dat/Battle/Message/033.bmd|0x001964": "「こちらで受け止めます！」", "Battle/Dat/Battle/Message/033.bmd|0x00198C": "「まだ終わってませんよ！」", "Battle/Dat/Battle/Message/033.bmd|0x0019B4": "「安心するのは早いですよ！」", "Battle/Dat/Battle/Message/033.bmd|0x0019DF": "「今です！　再攻撃を！」", "Battle/Dat/Battle/Message/033.bmd|0x001A04": "「やってみせましょう！」", "Battle/Dat/Battle/Message/033.bmd|0x001A29": "「これならどうです！」", "Battle/Dat/Battle/Message/033.bmd|0x001A4B": "「外しませんよ！」", "Battle/Dat/Battle/Message/033.bmd|0x001A67": "「機銃座、撃ち方始め！」", "Battle/Dat/Battle/Message/033.bmd|0x001A8C": "「対空機銃、撃て！」", "Battle/Dat/Battle/Message/033.bmd|0x001AAB": "「高射砲、発射用意！　撃て！」", "Battle/Dat/Battle/Message/033.bmd|0x001AD9": "「高射砲、１番、２番！　撃て！」", "Battle/Dat/Battle/Message/033.bmd|0x001B0A": "「前部全砲塔、発射用意！　撃て！」", "Battle/Dat/Battle/Message/033.bmd|0x001B3E": "「前部砲塔、一斉射撃！　撃て！」", "Battle/Dat/Battle/Message/033.bmd|0x001B6F": "「バリオン・ビーム砲、発射用意！」", "Battle/Dat/Battle/Message/033.bmd|0x001BA3": "「撃て！」", "Battle/Dat/Battle/Message/033.bmd|0x001BB3": "「主砲、発射用意！」", "Battle/Dat/Battle/Message/034.bmd|0x000E49": "「我が正義に挑むとは愚かなり。/　その身を以て知るがいい」", "Battle/Dat/Battle/Message/034.bmd|0x000E9F": "「私の行動こそが絶対の正義。/　ならば、負ける道理はありません」", "Battle/Dat/Battle/Message/034.bmd|0x000EFE": "「正義は必ず勝つのです。覚えておきなさい」", "Battle/Dat/Battle/Message/034.bmd|0x000F3E": "「いざっ！」", "Battle/Dat/Battle/Message/034.bmd|0x000F51": "「天誅！」", "Battle/Dat/Battle/Message/034.bmd|0x000F61": "「正義は我にありっ！」", "Battle/Dat/Battle/Message/034.bmd|0x000F83": "「勧善懲悪！」", "Battle/Dat/Battle/Message/034.bmd|0x000F99": "「成敗っ！」", "Battle/Dat/Battle/Message/034.bmd|0x000FAC": "「ヴァルシオーネ……/　相手にとって不足はありません」", "Battle/Dat/Battle/Message/034.bmd|0x000FFC": "「貴殿に、正義の有り様を教えて差し上げよう」", "Battle/Dat/Battle/Message/034.bmd|0x00103F": "「地上人よ、我が正義に挑むとは愚かなり」", "Battle/Dat/Battle/Message/034.bmd|0x00107C": "「正義の何たるかを知らぬ地上人などに……！」", "Battle/Dat/Battle/Message/034.bmd|0x0010BF": "「地上人に、我が正義の鉄槌を！」", "Battle/Dat/Battle/Message/034.bmd|0x0010F0": "「地上人よ、大人しく降伏するのであれば、/　命だけは助けてあげましょう」", "Battle/Dat/Battle/Message/034.bmd|0x00115B": "「サイバスターか……！」", "Battle/Dat/Battle/Message/034.bmd|0x001180": "「魔装機神と言えど……！」", "Battle/Dat/Battle/Message/034.bmd|0x0011A8": "「報いを受けていただきましょうか」", "Battle/Dat/Battle/Message/034.bmd|0x0011DC": "「ならば、反撃と参りましょう」", "Battle/Dat/Battle/Message/034.bmd|0x00120A": "「では、私の番ですね」", "Battle/Dat/Battle/Message/034.bmd|0x00122C": "「私に逆らった罪は重い」", "Battle/Dat/Battle/Message/034.bmd|0x001251": "「我が膺懲の一撃、くらいなさい」", "Battle/Dat/Battle/Message/034.bmd|0x001282": "「馬鹿な！？　この私が……負ける！？」", "Battle/Dat/Battle/Message/034.bmd|0x0012BC": "「そ、そんな馬鹿なぁぁっ！？」", "Battle/Dat/Battle/Message/034.bmd|0x0012EA": "「こんな……/　こんなことが……あるはずがないっ！！」", "Battle/Dat/Battle/Message/034.bmd|0x00133A": "「おのれ、おのれぇっ！！」", "Battle/Dat/Battle/Message/034.bmd|0x001362": "「あ、あり得ん！　この私が押されるなど！」", "Battle/Dat/Battle/Message/034.bmd|0x0013A2": "「ぬおおっ！？　な、何故だっ！？/　何故、この様な力が……」", "Battle/Dat/Battle/Message/034.bmd|0x0013FB": "「ぬううっ！　許さん、許さんぞぉぉぉっ！！」", "Battle/Dat/Battle/Message/034.bmd|0x00143E": "「むうっ！　地上人に後れを取るとは！」", "Battle/Dat/Battle/Message/034.bmd|0x001478": "「ぬううっ！　地上人めが！！」"}