{"Battle/Dat/Battle/Message/007.bmd|0x006297": "「何とかあたしが踏ん張ってみせる！」", "Battle/Dat/Battle/Message/007.bmd|0x0062CE": "「ここは任せて！」", "Battle/Dat/Battle/Message/007.bmd|0x0062EA": "「危ないっ！　お兄ちゃんはあたしがっ！」", "Battle/Dat/Battle/Message/007.bmd|0x006327": "「ダメ、テュッティさん！　下がって！」", "Battle/Dat/Battle/Message/007.bmd|0x006361": "「ミオさん、ここはあたしに任せて！」", "Battle/Dat/Battle/Message/007.bmd|0x006398": "「セニア様、あたしが盾になります！」", "Battle/Dat/Battle/Message/007.bmd|0x0063CF": "「くっ……あんたなんて護りたくないけど……」", "Battle/Dat/Battle/Message/007.bmd|0x006412": "「コウタさん、下がって！」", "Battle/Dat/Battle/Message/007.bmd|0x00643A": "「コウタさんに何かあったら、/　ショウコさんが！」", "Battle/Dat/Battle/Message/007.bmd|0x006484": "「ショウコさん、危ないっ！」", "Battle/Dat/Battle/Message/007.bmd|0x0064AF": "「ジョッシュさん、早く逃げて！」", "Battle/Dat/Battle/Message/007.bmd|0x0064E0": "「リムさんを……/　心配させたくないから！」", "Battle/Dat/Battle/Message/007.bmd|0x006521": "「リムさん、ここは任せて！」", "Battle/Dat/Battle/Message/007.bmd|0x00654C": "「いくよっ！！」", "Battle/Dat/Battle/Message/007.bmd|0x006565": "「これだけ撃てばどれか当たるかも」", "Battle/Dat/Battle/Message/007.bmd|0x006599": "「当たって！！」", "Battle/Dat/Battle/Message/007.bmd|0x0065B2": "「プラズマソード！」", "Battle/Dat/Battle/Message/007.bmd|0x0065D1": "「やっ！」", "Battle/Dat/Battle/Message/007.bmd|0x0065E1": "「えいっ！！」", "Battle/Dat/Battle/Message/007.bmd|0x0065F7": "「このっ！」", "Battle/Dat/Battle/Message/007.bmd|0x00660A": "「はっ！」", "Battle/Dat/Battle/Message/007.bmd|0x00661A": "「とうっ！」", "Battle/Dat/Battle/Message/007.bmd|0x00662D": "「たぁっ！」", "Battle/Dat/Battle/Message/007.bmd|0x006640": "「てぃっ！」", "Battle/Dat/Battle/Message/007.bmd|0x006653": "「よーし、当てちゃうよ！」", "Battle/Dat/Battle/Message/007.bmd|0x00667B": "「リニアレールガン！」", "Battle/Dat/Battle/Message/007.bmd|0x00669D": "「さあ、いっくよー！」", "Battle/Dat/Battle/Message/007.bmd|0x0066BF": "「油断してたら痛い目に遭うよ！/　くるみ割り人形！」", "Battle/Dat/Battle/Message/007.bmd|0x00670C": "「そーれっ！」", "Battle/Dat/Battle/Message/007.bmd|0x006722": "「えい！」", "Battle/Dat/Battle/Message/007.bmd|0x006732": "「たぁっ、えいっ、はぁっ！/　あたしだって、上達してるんだからっ！」", "Battle/Dat/Battle/Message/007.bmd|0x006797": "「まだまだいっくよー！」", "Battle/Dat/Battle/Message/007.bmd|0x0067BC": "「えーいっ！」", "Battle/Dat/Battle/Message/007.bmd|0x0067D2": "「たーーっ！」", "Battle/Dat/Battle/Message/007.bmd|0x0067E8": "「ふふっ、まだまだ！」", "Battle/Dat/Battle/Message/007.bmd|0x00680A": "「えーーーいっ！！」", "Battle/Dat/Battle/Message/007.bmd|0x006829": "「これだって、/　ちゃんとした神祇無窮流の応用技よ！」", "Battle/Dat/Battle/Message/007.bmd|0x006879": "「きゃっ！？」", "Battle/Dat/Battle/Message/007.bmd|0x00688F": "「えっ？　うそっ！？」", "Battle/Dat/Battle/Message/007.bmd|0x0068B1": "「ふえ……失敗しちゃった……」", "Battle/Dat/Battle/Message/008.bmd|0x001D48": "「勝てると思うな」", "Battle/Dat/Battle/Message/008.bmd|0x001D64": "「すぐにカタを付ける」", "Battle/Dat/Battle/Message/008.bmd|0x001D86": "「一気に終わらせるぞ」", "Battle/Dat/Battle/Message/008.bmd|0x001DA8": "「手加減はせんぞ」", "Battle/Dat/Battle/Message/008.bmd|0x001DC4": "「負けるつもりなど、さらさらない」", "Battle/Dat/Battle/Message/008.bmd|0x001DF8": "「貴様の相手は、この俺だ！」", "Battle/Dat/Battle/Message/008.bmd|0x001E23": "「ジャオームの力、甘く見るなよ」", "Battle/Dat/Battle/Message/008.bmd|0x001E54": "「カークス将軍！　討ち取らせていただく！」", "Battle/Dat/Battle/Message/008.bmd|0x001E94": "「あなたの野心もここまでです、/　カークス将軍！」", "Battle/Dat/Battle/Message/008.bmd|0x001EDE": "「む……女か。だが、手は抜かん」", "Battle/Dat/Battle/Message/008.bmd|0x001F0F": "「ほう、気の強い女だ。だが、それもまた……」", "Battle/Dat/Battle/Message/008.bmd|0x001F52": "「また貴様か、ルオゾール……/　しつこい男だ」", "Battle/Dat/Battle/Message/008.bmd|0x001F96": "「怪しげな呪い師が……/　どうせろくでもないことを/　企んでいるのだろう」", "Battle/Dat/Battle/Message/008.bmd|0x002002": "「サフィーネか……/　その腐った性根、叩き直してくれるわ！」", "Battle/Dat/Battle/Message/008.bmd|0x00205B": "「軟弱者めが！　性根を入れ替えろ！」", "Battle/Dat/Battle/Message/008.bmd|0x002092": "「相も変わらず、不真面目な奴め……/　貴様の道楽などに付き合っていられるか！」", "Battle/Dat/Battle/Message/008.bmd|0x002106": "「む……こやつ、出来るな」", "Battle/Dat/Battle/Message/008.bmd|0x00212E": "「なるほど……手強そうな相手だ」", "Battle/Dat/Battle/Message/008.bmd|0x00215F": "「ほう、いい反応だ。/　気を引き締めてかからんとな」", "Battle/Dat/Battle/Message/008.bmd|0x0021AC": "「むう……何という威圧感だ。/　破壊神と呼ばれるだけはあるな」", "Battle/Dat/Battle/Message/008.bmd|0x002208": "「醜き化け物め……退治してくれる」", "Battle/Dat/Battle/Message/008.bmd|0x00223C": "「こちらの番だな！」", "Battle/Dat/Battle/Message/008.bmd|0x00225B": "「では、こちらもいくぞ！」", "Battle/Dat/Battle/Message/008.bmd|0x002283": "「ただでは帰さん！」", "Battle/Dat/Battle/Message/008.bmd|0x0022A2": "「反撃開始だ！」", "Battle/Dat/Battle/Message/008.bmd|0x0022BB": "「好きにはさせん！」", "Battle/Dat/Battle/Message/008.bmd|0x0022DA": "「なめるなっ！」", "Battle/Dat/Battle/Message/008.bmd|0x0022F3": "「む……やられた」", "Battle/Dat/Battle/Message/008.bmd|0x00230F": "「む……すまん、撤退する」", "Battle/Dat/Battle/Message/008.bmd|0x002337": "「むん！？　いかん！」", "Battle/Dat/Battle/Message/008.bmd|0x002359": "「うぬっ！　まずい……」", "Battle/Dat/Battle/Message/008.bmd|0x00237E": "「つっ……まずいな」", "Battle/Dat/Battle/Message/008.bmd|0x00239D": "「ぐっ……このままでは……」", "Battle/Dat/Battle/Message/008.bmd|0x0023C8": "「むうぅっ！　押されているか……」", "Battle/Dat/Battle/Message/008.bmd|0x0023FC": "「ジャオーム、まだ落ちるな！」", "Battle/Dat/Battle/Message/008.bmd|0x00242A": "「ぐあぁっ！！　ま、まだだ……/　まだやられてはおりませんぞ、/　カークス将軍！」", "Battle/Dat/Battle/Message/008.bmd|0x0024A2": "「ぬううっ！！　グランゾン……恐るべし」", "Battle/Dat/Battle/Message/008.bmd|0x0024DF": "「俺をここまで追い詰めるとは……/　やるな、サフィーネ！」", "Battle/Dat/Battle/Message/008.bmd|0x002535": "「こ、これがデュラクシールの力かっ！」", "Battle/Dat/Battle/Message/008.bmd|0x00256F": "「ぬうっ！！/　な、何という力だ……/　恐るべし、ヴォルクルス……」", "Battle/Dat/Battle/Message/008.bmd|0x0025D2": "「うぬっ！　やる！！」", "Battle/Dat/Battle/Message/008.bmd|0x0025F4": "「む……いい攻撃だ」", "Battle/Dat/Battle/Message/008.bmd|0x002613": "「くっ、なかなか……」", "Battle/Dat/Battle/Message/008.bmd|0x002635": "「ぐっ！　今のは効いたぞ」", "Battle/Dat/Battle/Message/008.bmd|0x00265D": "「避け損ねたか！」", "Battle/Dat/Battle/Message/008.bmd|0x002679": "「ほう、やるな」", "Battle/Dat/Battle/Message/008.bmd|0x002692": "「む、さすがはカークス将軍。やるものですな」", "Battle/Dat/Battle/Message/008.bmd|0x0026D5": "「ほう、なかなかの腕だな……」", "Battle/Dat/Battle/Message/008.bmd|0x002703": "「ちっ、貴様と遊んでいるヒマはない！/　さっさと立ち去れ、ルオゾール」", "Battle/Dat/Battle/Message/008.bmd|0x00276B": "「む……シュウ・シラカワ…………/　やはり、ただ者ではない」", "Battle/Dat/Battle/Message/008.bmd|0x0027C4": "「ぬ、甘く見すぎていたか。/　やるな、サフィーネ」", "Battle/Dat/Battle/Message/008.bmd|0x00280E": "「ええい、/　この程度の攻撃を避け損なうとは……」", "Battle/Dat/Battle/Message/008.bmd|0x002858": "「くっ……デュラクシール……/　さすがにパワーがある」", "Battle/Dat/Battle/Message/008.bmd|0x0028A8": "「むうっ！　ブローウェルに/　これほどのパワーがあるとは……」", "Battle/Dat/Battle/Message/008.bmd|0x002904": "「ぬっ！　なるほど、破壊神と呼ばれるのは/　伊達ではないということか」", "Battle/Dat/Battle/Message/008.bmd|0x00296C": "「効くかっ！」", "Battle/Dat/Battle/Message/008.bmd|0x002982": "「効かんな」", "Battle/Dat/Battle/Message/008.bmd|0x002995": "「そんなものか」", "Battle/Dat/Battle/Message/008.bmd|0x0029AE": "「弱い、弱いぞ」", "Battle/Dat/Battle/Message/008.bmd|0x0029C7": "「鍛え方が足りん！」", "Battle/Dat/Battle/Message/008.bmd|0x0029E6": "「その程度か！」", "Battle/Dat/Battle/Message/008.bmd|0x0029FF": "「ふん、当たっただけだ」", "Battle/Dat/Battle/Message/008.bmd|0x002A24": "「効きはしませんよ、カークス将軍」", "Battle/Dat/Battle/Message/008.bmd|0x002A58": "「ふっ……やはり、その程度か」", "Battle/Dat/Battle/Message/008.bmd|0x002A86": "「ふっ……甘く見たな、ルオゾール」", "Battle/Dat/Battle/Message/008.bmd|0x002ABA": "「どうした、シュウ。/　貴様の力、その程度ではあるまい」", "Battle/Dat/Battle/Message/008.bmd|0x002B0D": "「心根が軟弱だから、/　その程度なのだ、サフィーネ！」", "Battle/Dat/Battle/Message/008.bmd|0x002B5D": "「その程度か……見込み違いだったな」", "Battle/Dat/Battle/Message/008.bmd|0x002B94": "「ふん……存外大したことはないな」", "Battle/Dat/Battle/Message/008.bmd|0x002BC8": "「外れだ！」", "Battle/Dat/Battle/Message/008.bmd|0x002BDB": "「当たらん！」", "Battle/Dat/Battle/Message/008.bmd|0x002BF1": "「かすりもせんな」", "Battle/Dat/Battle/Message/008.bmd|0x002C0D": "「遅いな」", "Battle/Dat/Battle/Message/008.bmd|0x002C1D": "「無駄だ」", "Battle/Dat/Battle/Message/008.bmd|0x002C2D": "「見切った！」", "Battle/Dat/Battle/Message/008.bmd|0x002C43": "「当たりませんよ、将軍」", "Battle/Dat/Battle/Message/008.bmd|0x002C68": "「見くびってもらっては困るな」", "Battle/Dat/Battle/Message/008.bmd|0x002C96": "「貴様の相手などしていられるか！」", "Battle/Dat/Battle/Message/008.bmd|0x002CCA": "「相変わらず恐ろしい力だ。/　だが、かわしてしまえば！」", "Battle/Dat/Battle/Message/008.bmd|0x002D1D": "「ふっ……ふざけているからそうなる」"}