{"Battle/Dat/Battle/Message/060.bmd|0x00DA54": "「何が出るかは見てのお楽しみ！」", "Battle/Dat/Battle/Message/060.bmd|0x00DA85": "「はい！　ツインランチャー！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DAB6": "「こいつで終わりだっ！」", "Battle/Dat/Battle/Message/060.bmd|0x00DADB": "「頼むぜぇ、当たってくれよっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DB0F": "「狙いはバッチシ！」", "Battle/Dat/Battle/Message/060.bmd|0x00DB2E": "「ぶちかませぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DB50": "「でえいっ！」", "Battle/Dat/Battle/Message/060.bmd|0x00DB66": "「突っ込むのはお手のモンだぜ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DB9A": "「仕上げはブーストキックだぁっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DBD1": "「ズィガーンと行くぜっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DBFC": "「ソニック！　アクセラレーション！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DC36": "「ステーク、セットアップ！」", "Battle/Dat/Battle/Message/060.bmd|0x00DC61": "「ゲシュペンナッコォッ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DC8C": "「ギャラク……/　もとい！　ジェット・マグナム！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DCD9": "「ファング・スラッシャー！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DD07": "「切り裂け！　ファング・スラッシャー！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DD47": "「ファング・スラッシャー！　シュートッ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DD8A": "「リープ・ミサイル、いっけぇ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DDBE": "「行くぜ！　Ｇインパクト・キャノン！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DDFB": "「アイソリッド・レーザー！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DE29": "「ドリル・ブーストナックル！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DE5A": "「ドリル・アタァァァック！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DE88": "「スパイラル・アタァァァック！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DEBC": "「くらえっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DED5": "「オメガ・ブラスター！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DEFD": "「くらえっ！」", "Battle/Dat/Battle/Message/060.bmd|0x00DF13": "「突撃だっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DF2C": "「コールドメタルッ！」", "Battle/Dat/Battle/Message/060.bmd|0x00DF4E": "「コールドメタルソード！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DF79": "「ソォォォドッ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00DF98": "「クラッシャー、セットア