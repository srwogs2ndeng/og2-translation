d|0x00E4B6": "「わかってるわ！」", "Battle/Dat/Battle/Message/060.bmd|0x00E4D2": "「ビルガー、高機動モード！」", "Battle/Dat/Battle/Message/060.bmd|0x00E4FD": "「突っ込むぜぇぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E522": "「アインス！」", "Battle/Dat/Battle/Message/060.bmd|0x00E538": "「ツヴァイ！」", "Battle/Dat/Battle/Message/060.bmd|0x00E54E": "「ドライッ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E567": "「決めてやるっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E586": "「行っけぇぇぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E5A8": "「ツイン・バード！」", "Battle/Dat/Battle/Message/060.bmd|0x00E5C7": "「ストラァァァァイクッ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E5F2": "「もう！　世話が焼けるんだからっ！」", "Battle/Dat/Battle/Message/060.bmd|0x00E629": "「ゼオラッ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E642": "「アラド、そっちに！」", "Battle/Dat/Battle/Message/060.bmd|0x00E664": "「おりゃあっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E680": "「ロックオン！　行けぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E6AE": "「狙いはびっちりばっちり！」", "Battle/Dat/Battle/Message/060.bmd|0x00E6D9": "「撃ち抜け！　オクスたん！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E707": "「それ行け！　オクスたん！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E735": "「モードセレクト、おれ好み！」", "Battle/Dat/Battle/Message/060.bmd|0x00E763": "「ファルケンだろうが、突っ込んで撃つ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E7A3": "「突っ込むぞ、ファルケン！」", "Battle/Dat/Battle/Message/060.bmd|0x00E7CE": "「撃って撃って撃ちまくるっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E7FF": "「頼むぜ、オクスたん！」", "Battle/Dat/Battle/Message/060.bmd|0x00E824": "「行くぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00E837": "「ソニック・ブレイカー！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E862": "「まとめてブチかますっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E88D": "「アンカーユニット、セットアップ！」", "Battle/Dat/Battle/Message/060.bmd|0x00E8C4": "「ガンドロ必殺！/　ジガンテ・アンギャーーッ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E90E": "「ハルバート・ランチャー！」", "Battle/Dat/Battle/Message/060.bmd|0x00E939": "「しっかり頼むぜ、ソードブレイカー！」", "Battle/Dat/Battle/Message/060.bmd|0x00E973": "「数撃ちゃ当たるんだ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E99B": "「Ｇ・インパクトステーク！　貫けぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00E9DB": "「こいつでブチ抜いてやるっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EA0C": "「ステークで風穴を開けてやるぜっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EA46": "「リボルビ……もとい、/　Ｇ・インパクトステーク！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EA96": "「まさにおれ向きの武器だぜ！」", "Battle/Dat/Battle/Message/060.bmd|0x00EAC4": "「ブーストハンマー！　ブッ飛べぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EB01": "「ハンマーだ！　当たると痛てえぞ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EB3B": "「こいつは漢の武器だぜ！/　ブーストハンマー！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EB85": "「シシオウブレード！　叩き斬ってやるっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EBC8": "「必殺剣！　シシオウブレードだっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EC02": "「必殺！　獅子王剣っ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EC2A": "「当たるかどうかはお前次第だ！」", "Battle/Dat/Battle/Message/060.bmd|0x00EC5B": "「頼むぜ、スラッシュ・リッパー！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EC92": "「行け！　リープ・スラッシャー！！」", "Battle/Dat/Battle/Message/060.bmd|0x00ECC9": "「全速で突っ込む！」", "Battle/Dat/Battle/Message/060.bmd|0x00ECE8": "「リボルビング・バンカー！」", "Battle/Dat/Battle/Message/060.bmd|0x00ED13": "「くらえ！　くらえ！　くらえぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00ED4D": "「ブースト・オン！」", "Battle/Dat/Battle/Message/060.bmd|0x00ED6C": "「おりゃああっ！」", "Battle/Dat/Battle/Message/060.bmd|0x00ED88": "「こいつもくらえ！」", "Battle/Dat/Battle/Message/060.bmd|0x00EDA7": "「弾ァ使い切ってやるぜぇぇぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EDDE": "「プラズマ・ステーク、セット！」", "Battle/Dat/Battle/Message/060.bmd|0x00EE0F": "「ジェット・マグナム！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EE37": "「スプリットミサイル！」", "Battle/Dat/Battle/Message/060.bmd|0x00EE5C": "「２ＷＡＹライフル、Ｌモード！」", "Battle/Dat/Battle/Message/060.bmd|0x00EE8D": "「行っけぇぇっ！！」", "Battle/Dat/Battle/Message/060.bmd|0x00EEAC": "「おりゃあああっ！」"}