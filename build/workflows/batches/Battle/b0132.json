{"Battle/Dat/Battle/Message/065.bmd|0x007D3A": "「ブーストッ！」", "Battle/Dat/Battle/Message/065.bmd|0x007D53": "「そこだ！　クレイモア！」", "Battle/Dat/Battle/Message/065.bmd|0x007D7B": "「はあっ！」", "Battle/Dat/Battle/Message/065.bmd|0x007D8E": "「まだまだ！！」", "Battle/Dat/Battle/Message/065.bmd|0x007DA7": "「とどめのリボルビング・バンカーだ！！」", "Battle/Dat/Battle/Message/065.bmd|0x007DE4": "「トンファー、セット！」", "Battle/Dat/Battle/Message/065.bmd|0x007E09": "「クロス・レンジに飛び込む！」", "Battle/Dat/Battle/Message/065.bmd|0x007E37": "「この連打をかわせるか！」", "Battle/Dat/Battle/Message/065.bmd|0x007E5F": "「ブレード・サイ、アクティブ！」", "Battle/Dat/Battle/Message/065.bmd|0x007E90": "「レディ！」", "Battle/Dat/Battle/Message/065.bmd|0x007EA3": "「ゴーッ！！」", "Battle/Dat/Battle/Message/065.bmd|0x007EB9": "「勝利への道は見えた！」", "Battle/Dat/Battle/Message/065.bmd|0x007EDE": "「はああああっ！！」", "Battle/Dat/Battle/Message/065.bmd|0x007EFD": "「見ろ、ラプターのスピードを！」", "Battle/Dat/Battle/Message/065.bmd|0x007F2E": "「遅いぞ！」", "Battle/Dat/Battle/Message/065.bmd|0x007F41": "「フル・シュートッ！！」", "Battle/Dat/Battle/Message/065.bmd|0x007F66": "「プラズマ・ステーク、セット！」", "Battle/Dat/Battle/Message/065.bmd|0x007F97": "「ジェット・マグナム！！」", "Battle/Dat/Battle/Message/065.bmd|0x007FBF": "「逃がすものかっ！」", "Battle/Dat/Battle/Message/065.bmd|0x007FDE": "「ロングレンジ・モード！」", "Battle/Dat/Battle/Message/065.bmd|0x008006": "「ファイヤッ！！」", "Battle/Dat/Battle/Message/065.bmd|0x008022": "「抵抗しても無駄だ！」", "Battle/Dat/Battle/Message/065.bmd|0x008044": "「せえいっ！！」", "Battle/Dat/Battle/Message/065.bmd|0x00805D": "「メガ・ブラスターキャノン！！」", "Battle/Dat/Battle/Message/065.bmd|0x00808E": "「必殺のコンビネーションだ！」", "Battle/Dat/Battle/Message/065.bmd|0x0080BC": "「この連打、かわせまい！」", "Battle/Dat/Battle/Message/065.bmd|0x0080E4": "「まだまだ！」", "Battle/Dat/Battle/Message/065.bmd|0x0080FA": "「フィニッシュブローだ！」", "Battle/Dat/Battle/Message/065.bmd|0x008122": "「ジェット・ファントム！！」", "Battle/Dat/Battle/Message/065.bmd|0x00814D": "「受けろ、ダーク・ロック！」", "Battle/Dat/Battle/Message/065.bmd|0x008178": "「続いていくぞ！」", "Battle/Dat/Battle/Message/065.bmd|0x008194": "「ハイパー・ブーストナックル、セット！」", "Battle/Dat/Battle/Message/065.bmd|0x0081D1": "「そこだっ！！」", "Battle/Dat/Battle/Message/065.bmd|0x0081EA": "「照準セット！　エネルギー集束！」", "Battle/Dat/Battle/Message/065.bmd|0x00821E": "「アルティメット・ビーム！！」", "Battle/Dat/Battle/Message/065.bmd|0x00824C": "「グルンガスト、その力を見せろ！」", "Battle/Dat/Battle/Message/065.bmd|0x008280": "「計都羅¶剣！！」", "Battle/Dat/Battle/Message/065.bmd|0x00829B": "「暗剣殺！！」", "Battle/Dat/Battle/Message/065.bmd|0x0082B1": "「たああああああっ！！」", "Battle/Dat/Battle/Message/065.bmd|0x0082D6": "「フィニッシュ……！」", "Battle/Dat/Battle/Message/065.bmd|0x0082F8": "「彗星が凶星を導く……！」", "Battle/Dat/Battle/Message/065.bmd|0x008320": "「五！」", "Battle/Dat/Battle/Message/065.bmd|0x00832D": "「黄！」", "Battle/Dat/Battle/Message/065.bmd|0x00833A": "「殺っ！！」", "Battle/Dat/Battle/Message/065.bmd|0x00834D": "「はあああーーっ！！」", "Battle/Dat/Battle/Message/065.bmd|0x00836F": "「終わりだ……！」", "Battle/Dat/Battle/Message/065.bmd|0x00838B": "「私の趣味に合う戦法だ！」", "Battle/Dat/Battle/Message/065.bmd|0x0083B3": "「スパイラル・ブレイカー！」", "Battle/Dat/Battle/Message/065.bmd|0x0083DE": "「くらうがいい！」", "Battle/Dat/Battle/Message/065.bmd|0x0083FA": "「全砲火を集中させる！」", "Battle/Dat/Battle/Message/065.bmd|0x00841F": "「行くぞ、フル・ブースト！！」", "Battle/Dat/Battle/Message/065.bmd|0x00844D": "「天地のコンビネーション、かわせるか！」", "Battle/Dat/Battle/Message/065.bmd|0x00848A": "「ドリルで貫くっ！！」", "Battle/Dat/Battle/Message/065.bmd|0x0084AC": "「一撃必殺か……面白い！」", "Battle/Dat/Battle/Message/065.bmd|0x0084D4": "「獅子王刀、歳破！！」", "Battle/Dat/Battle/Message/065.bmd|0x0084F6": "「その動き、見切った！」", "Battle/Dat/Battle/Message/065.bmd|0x00851B": "「ＭＴＤ誘導弾、ファイヤ！」", "Battle/Dat/Battle/Message/065.bmd|0x008546": "「テスラ・ドライブのミサイルだ、/　どこまでも追い詰める！」", "Battle/Dat/Battle/Message/065.bmd|0x00859F": "「イルミネーター・リンク！」", "Battle/Dat/Battle/Message/065.bmd|0x0085CA": "「受けろ！　天からの一撃を！」", "Battle/Dat/Battle/Message/066.bmd|0x004E71": "「ゆくぞ！」", "Battle/Dat/Battle/Message/066.bmd|0x004E84": "「いざ参るっ！！」", "Battle/Dat/Battle/Message/066.bmd|0x004EA0": "「真っ向勝負！」", "Battle/Dat/Battle/Message/066.bmd|0x004EB9": "「立ち塞がる者は/　何人であろうとも、倒す！」", "Battle/Dat/Battle/Message/066.bmd|0x004EFD": "「打と意地を以て、貴様を倒す！」", "Battle/Dat/Battle/Message/066.bmd|0x004F2E": "「我が一撃を受けよ！」", "Battle/Dat/Battle/Message/066.bmd|0x004F50": "「眼前の敵は、全て打ち砕くのみ！」", "Battle/Dat/Battle/Message/066.bmd|0x004F84": "「覚悟はいいかっ！！」", "Battle/Dat/Battle/Message/066.bmd|0x004FA6": "「踏み込むっ！！」", "Battle/Dat/Battle/Message/066.bmd|0x004FC2": "「突撃あるのみ！」", "Battle/Dat/Battle/Message/066.bmd|0x004FDE": "「行く手を阻む者は、打ち砕く！！」", "Battle/Dat/Battle/Message/066.bmd|0x005012": "「グルンガスト零式、見参！」", "Battle/Dat/Battle/Message/066.bmd|0x00503D": "「零式の力、その身でとくと味わえ！」", "Battle/Dat/Battle/Message/066.bmd|0x005074": "「グルンガスト参式、見参！！」", "Battle/Dat/Battle/Message/066.bmd|0x0050A2": "「参式の力、その身でとくと味わえ！！」", "Battle/Dat/Battle/Message/066.bmd|0x0050DC": "「この参式で、貴様に勝負を挑む！！」", "Battle/Dat/Battle/Message/066.bmd|0x005113": "「壱式、見参！」", "Battle/Dat/Battle/Message/066.bmd|0x00512C": "「超闘士の力、その身で受け止めよ！！」", "Battle/Dat/Battle/Message/066.bmd|0x005166": "「弐式、見参！！」", "Battle/Dat/Battle/Message/066.bmd|0x005182": "「ゆくぞ、弐式！！」", "Battle/Dat/Battle/Message/066.bmd|0x0051A1": "「ダイゼンガー、見参！」", "Battle/Dat/Battle/Message/066.bmd|0x0051C6": "「武神装攻ダイゼンガー、見参！」", "Battle/Dat/Battle/Message/066.bmd|0x0051F7": "「武神装攻、見参！」", "Battle/Dat/Battle/Message/066.bmd|0x005216": "「ゆくぞ、ダイゼンガー！」", "Battle/Dat/Battle/Message/066.bmd|0x00523E": "「武神装攻の力、その身でとくと味わえ！！」", "Battle/Dat/Battle/Message/066.bmd|0x00527E": "「その巨腕ごと断ち切る！」", "Battle/Dat/Battle/Message/066.bmd|0x0052A6": "「ドゥバン・オーグ！　いざ勝負！」", "Battle/Dat/Battle/Message/066.bmd|0x0052DA": "「魔道に墜ちたか、ドゥバン・オーグ！」", "Battle/Dat/Battle/Message/066.bmd|0x005314": "「アルテウル……/　貴様の目論みは、我が剣で打ち砕く！」", "Battle/Dat/Battle/Message/066.bmd|0x005367": "「小物が神を騙るなどと！」", "Battle/Dat/Battle/Message/066.bmd|0x00538F": "「妖の術を使う者などに！」", "Battle/Dat/Battle/Message/066.bmd|0x0053B7": "「己が道に殉ずるか……/　ならば、もはや問答無用！」", "Battle/Dat/Battle/Message/066.bmd|0x005404": "「不退転の決意、しかと受け止めた！」", "Battle/Dat/Battle/Message/066.bmd|0x00543B": "「イグニス！/　その炎、我が剣にて振り払ってくれる！」", "Battle/Dat/Battle/Message/066.bmd|0x00548B": "「炎のメリオルエッセ……/　相手にとって不足なし！」", "Battle/Dat/Battle/Message/066.bmd|0x0054D8": "「破滅の使者よ……/　本懐が果たせるか否か、我が剣に問うてみよ！」", "Battle/Dat/Battle/Message/066.bmd|0x00553A": "「メリオルエッセよ……/　我が剣にて、畏怖の意味を知れ！」", "Battle/Dat/Battle/Message/066.bmd|0x005590": "「専心一閃、恐念を断つ！」", "Battle/Dat/Battle/Message/066.bmd|0x0055B8": "「コンターギオ！　貴様などに情けは無用！」", "Battle/Dat/Battle/Message/066.bmd|0x0055F8": "「その邪笑ごと斬り捨てる！」", "Battle/Dat/Battle/Message/066.bmd|0x005623": "「行くぞ、影のメリオルエッセよ！」", "Battle/Dat/Battle/Message/066.bmd|0x005657": "「アクイラ！　いざ尋常に勝負！」", "Battle/Dat/Battle/Message/066.bmd|0x005688": "「我が剣にて、氷を破摧する！」", "Battle/Dat/Battle/Message/066.bmd|0x0056B6": "「ペルフェクティオ……/　その称号通り、破滅すべし！」", "Battle/Dat/Battle/Message/066.bmd|0x005706": "「“破滅の王”よ！　我が剣にて湮滅せよ！」", "Battle/Dat/Battle/Message/066.bmd|0x005746": "「ロフ、いざ尋常に勝負！」", "Battle/Dat/Battle/Message/066.bmd|0x00576E": "「武人としての勝負、受けて立つ！」", "Battle/Dat/Battle/Message/066.bmd|0x0057A2": "「ヴィガジらと同じく、/　力に物を言わせるのであれば！」", "Battle/Dat/Battle/Message/066.bmd|0x0057F5": "「貴様らに申し置く！/　地球圏への干渉は無用！」", "Battle/Dat/Battle/Message/066.bmd|0x00583C": "「その口調は我らを謀るためか……？」", "Battle/Dat/Battle/Message/066.bmd|0x005873": "「行くぞ、セティ！」", "Battle/Dat/Battle/Message/066.bmd|0x005892": "「ゼゼーナン！/　貴様の野望は、我が剣にて潰える！」", "Battle/Dat/Battle/Message/066.bmd|0x0058DF": "「器に釣り合わぬ野望は、/　身を滅ぼすことになる！」", "Battle/Dat/Battle/Message/066.bmd|0x00592C": "「貴様らがいう尸解は、人にとって死と同義！」", "Battle/Dat/Battle/Message/066.bmd|0x00596F": "「仙界ではなく、冥界への案内仕る！」", "Battle/Dat/Battle/Message/066.bmd|0x0059A6": "「夏喃、仙道への導きなど無用！」", "Battle/Dat/Battle/Message/066.bmd|0x0059D7": "「押し通るぞ、泰北！」", "Battle/Dat/Battle/Message/066.bmd|0x0059F9": "「光龍！　打と意地を以て、貴様を討つ！」", "Battle/Dat/Battle/Message/066.bmd|0x005A36": "「応龍皇、その逆鱗を打ち砕く！」", "Battle/Dat/Battle/Message/066.bmd|0x005A67": "「ククルよ、人外の理など俺には通用せんぞ！」"}