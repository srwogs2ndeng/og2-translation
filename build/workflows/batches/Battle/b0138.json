{"Battle/Dat/Battle/Message/067.bmd|0x007EA8": "「アリエイル、後は任せたまえ」", "Battle/Dat/Battle/Message/067.bmd|0x007ED6": "「イング、私が力を貸そう」", "Battle/Dat/Battle/Message/067.bmd|0x007EFE": "「ヤンロン、後は任せてもらおう」", "Battle/Dat/Battle/Message/067.bmd|0x007F2F": "「テュッティ、後は私が引き受ける」", "Battle/Dat/Battle/Message/067.bmd|0x007F63": "「ミオ、後は任せたまえ」", "Battle/Dat/Battle/Message/067.bmd|0x007F88": "「クルト艦長、援護する」", "Battle/Dat/Battle/Message/067.bmd|0x007FAD": "「スレイ、加勢するぞ」", "Battle/Dat/Battle/Message/067.bmd|0x007FCF": "「これよりハガネを援護する！」", "Battle/Dat/Battle/Message/067.bmd|0x007FFD": "「ヒリュウに続き、本艦も砲撃開始！」", "Battle/Dat/Battle/Message/067.bmd|0x008034": "「続けて本艦も攻撃開始！」", "Battle/Dat/Battle/Message/067.bmd|0x00805C": "「こちらアイアン３！　射線上から離脱せよ！」", "Battle/Dat/Battle/Message/067.bmd|0x00809F": "「針路このまま！　前進！」", "Battle/Dat/Battle/Message/067.bmd|0x0080C7": "「トロンベを盾にする！」", "Battle/Dat/Battle/Message/067.bmd|0x0080EC": "「これもまた、私の役目！」", "Battle/Dat/Battle/Message/067.bmd|0x008114": "「ここは任せて、態勢を立て直すのだ！」", "Battle/Dat/Battle/Message/067.bmd|0x00814E": "「我が友よ、この場は任せてもらおう！」", "Battle/Dat/Battle/Message/067.bmd|0x008188": "「友よ、あの敵は私が引き受けよう！」", "Battle/Dat/Battle/Message/067.bmd|0x0081BF": "「ライ、いったん下がるのだ！」", "Battle/Dat/Battle/Message/067.bmd|0x0081ED": "「ここは退け、ヴィレッタ大尉！」", "Battle/Dat/Battle/Message/067.bmd|0x00821E": "「少佐、すぐに離脱を！」", "Battle/Dat/Battle/Message/067.bmd|0x008243": "「お前らしくないな、ギリアム」", "Battle/Dat/Battle/Message/067.bmd|0x008271": "「コウタ、無理をするな！」", "Battle/Dat/Battle/Message/067.bmd|0x008299": "「下がれ、ジョッシュ！」", "Battle/Dat/Battle/Message/067.bmd|0x0082BE": "「リム、下がりたまえ！」", "Battle/Dat/Battle/Message/067.bmd|0x0082E3": "「ヒューゴ、離脱するのだ！」", "Battle/Dat/Battle/Message/067.bmd|0x00830E": "「アクア、下がりたまえ！」", "Battle/Dat/Battle/Message/067.bmd|0x008336": "「アリエイル、ここは退け！」", "Battle/Dat/Battle/Message/067.bmd|0x008361": "「退くのだ、イング！」", "Battle/Dat/Battle/Message/067.bmd|0x008383": "「ヤンロン、ここは私に任せたまえ！」", "Battle/Dat/Battle/Message/067.bmd|0x0083BA": "「テュッティ、下がりたまえ！」", "Battle/Dat/Battle/Message/067.bmd|0x0083E8": "「ミオ、退くのだ！」", "Battle/Dat/Battle/Message/067.bmd|0x008407": "「クロガネに手出しはさせん！」", "Battle/Dat/Battle/Message/067.bmd|0x008435": "「下がれ、ユウキ！」", "Battle/Dat/Battle/Message/067.bmd|0x008454": "「油断するな、カーラ！」", "Battle/Dat/Battle/Message/067.bmd|0x008479": "「ラウル、後退したまえ！」", "Battle/Dat/Battle/Message/067.bmd|0x0084A1": "「スレイ、ここは退け！」", "Battle/Dat/Battle/Message/067.bmd|0x0084C6": "「ハガネのカバーに入れ！」", "Battle/Dat/Battle/Message/067.bmd|0x0084EE": "「ヒリュウを防御しろ！」", "Battle/Dat/Battle/Message/067.bmd|0x008513": "「このまま艦を前進させるのだ！」", "Battle/Dat/Battle/Message/067.bmd|0x008544": "「クロガネ、前進！　割り込め！」", "Battle/Dat/Battle/Message/067.bmd|0x008575": "「直ちに艦の後ろへ！」", "Battle/Dat/Battle/Message/067.bmd|0x008597": "「このクロガネで相手をする！」", "Battle/Dat/Battle/Message/067.bmd|0x0085C5": "「その陣形なら、単騎で充分！」", "Battle/Dat/Battle/Message/067.bmd|0x0085F3": "「それでは回避行動が取れまい！」", "Battle/Dat/Battle/Message/067.bmd|0x008624": "「一所に固まっていたのが、/　運の尽きだったな！」", "Battle/Dat/Battle/Message/067.bmd|0x00866E": "「再び疾れ、トロンベよ！」", "Battle/Dat/Battle/Message/067.bmd|0x008696": "「我が照星は、お前を捉え続けている！」", "Battle/Dat/Battle/Message/067.bmd|0x0086D0": "「受けていただく！」", "Battle/Dat/Battle/Message/067.bmd|0x0086EF": "「沈め！」", "Battle/Dat/Battle/Message/067.bmd|0x0086FF": "「いただく！」", "Battle/Dat/Battle/Message/067.bmd|0x008715": "「砕け散れ、照星の彼方で……！」", "Battle/Dat/Battle/Message/067.bmd|0x008746": "「ハイ・ツインランチャー、発射！」", "Battle/Dat/Battle/Message/067.bmd|0x00877A": "「撃て、トロンベよ！」", "Battle/Dat/Battle/Message/067.bmd|0x00879C": "「ターゲット・インサイト……いただく！」", "Battle/Dat/Battle/Message/067.bmd|0x0087D9": "「機銃群、攻撃開始！」", "Battle/Dat/Battle/Message/067.bmd|0x0087FB": "「対空機銃、射撃開始！」", "Battle/Dat/Battle/Message/067.bmd|0x008820": "「ＶＬＳミサイルランチャー、一斉射撃！」", "Battle/Dat/Battle/Message/067.bmd|0x00885D": "「上部両舷ホーミングミサイルランチャー、/　発射！」", "Battle/Dat/Battle/Message/067.bmd|0x0088AA": "「ＳＴＦ魚雷、撃て！」", "Battle/Dat/Battle/Message/067.bmd|0x0088CC": "「総員、雷撃戦用意！」", "Battle/Dat/Battle/Message/067.bmd|0x0088EE": "「魚雷、１番から４番、発射！」", "Battle/Dat/Battle/Message/067.bmd|0x00891C": "「１番から５番、撃て！」", "Battle/Dat/Battle/Message/067.bmd|0x008941": "「１番から３番副砲、撃て！」", "Battle/Dat/Battle/Message/067.bmd|0x00896C": "「標的へ一斉砲撃！」", "Battle/Dat/Battle/Message/067.bmd|0x00898B": "「クロガネの実力……思い知っていただく！」", "Battle/Dat/Battle/Message/067.bmd|0x0089CB": "「両舷副砲、砲撃始め！」", "Battle/Dat/Battle/Message/067.bmd|0x0089F0": "「副砲、１番から４番、砲撃始め！」", "Battle/Dat/Battle/Message/067.bmd|0x008A24": "「前部衝撃砲、一斉射撃！」", "Battle/Dat/Battle/Message/067.bmd|0x008A4C": "「３番、５番主砲！　砲撃始め！」", "Battle/Dat/Battle/Message/067.bmd|0x008A7D": "「前部衝撃砲、撃て！」", "Battle/Dat/Battle/Message/067.bmd|0x008A9F": "「クロガネより各機へ！/　これより主砲を発射する！」", "Battle/Dat/Battle/Message/067.bmd|0x008AEC": "「前部主砲、一斉射！」", "Battle/Dat/Battle/Message/067.bmd|0x008B0E": "「前方の敵機を薙ぎ払え！」", "Battle/Dat/Battle/Message/067.bmd|0x008B36": "「これより艦前方へ一斉砲撃！/　その後、艦首超大型回転衝角を使用する！」", "Battle/Dat/Battle/Message/067.bmd|0x008BA1": "「了解！　前部各砲塔、発射準備！」", "Battle/Dat/Battle/Message/067.bmd|0x008BD5": "「目標との相対距離確認、仰角、誤差修正！」", "Battle/Dat/Battle/Message/067.bmd|0x008C15": "「超大型回転衝角、始動！」", "Battle/Dat/Battle/Message/067.bmd|0x008C3D": "「了解！　回転衝角、始動！」", "Battle/Dat/Battle/Message/067.bmd|0x008C68": "「機関、最大戦速！」", "Battle/Dat/Battle/Message/067.bmd|0x008C87": "「各砲塔、攻撃始め！」", "Battle/Dat/Battle/Message/067.bmd|0x008CA9": "「総員、衝撃に備えよ！」", "Battle/Dat/Battle/Message/067.bmd|0x008CCE": "「全速前進！　クロガネ、突撃ぃぃっ！！」", "Battle/Dat/Battle/Message/067.bmd|0x008D0B": "「行け、シュルター・プラッテ！」", "Battle/Dat/Battle/Message/067.bmd|0x008D3C": "「受けよ！　シュルター・プラッテ！」", "Battle/Dat/Battle/Message/067.bmd|0x008D73": "「切り裂け！　シュルター・プラッテ！」", "Battle/Dat/Battle/Message/067.bmd|0x008DAD": "「ランツェ・カノーネ！」", "Battle/Dat/Battle/Message/067.bmd|0x008DD2": "「撃ち抜く！」", "Battle/Dat/Battle/Message/067.bmd|0x008DE8": "「我が一撃！」", "Battle/Dat/Battle/Message/067.bmd|0x008DFE": "「受けていただこう！」", "Battle/Dat/Battle/Message/067.bmd|0x008E20": "「ターゲット・インサイト！」", "Battle/Dat/Battle/Message/067.bmd|0x008E4B": "「フェルゼ・ラート！」", "Battle/Dat/Battle/Message/067.bmd|0x008E6D": "「駆けろ！　そして、撃て！　トロンベよ！」", "Battle/Dat/Battle/Message/067.bmd|0x008EAD": "「砕け散れ、照星の彼方で！」", "Battle/Dat/Battle/Message/067.bmd|0x008ED8": "「ラート、アクティブ！」", "Battle/Dat/Battle/Message/067.bmd|0x008EFD": "「トロンベよ、阻むもの全てを撃ち抜け！」", "Battle/Dat/Battle/Message/067.bmd|0x008F3A": "「これで終わりにさせていただく！」", "Battle/Dat/Battle/Message/067.bmd|0x008F6E": "「照星がお前の運命を導く……！」", "Battle/Dat/Battle/Message/067.bmd|0x008F9F": "「まずはこちらだ！」", "Battle/Dat/Battle/Message/067.bmd|0x008FBE": "「私に出会った不幸を呪え……！」", "Battle/Dat/Battle/Message/067.bmd|0x008FEF": "「受けよ！」", "Battle/Dat/Battle/Message/067.bmd|0x009002": "「撃ち抜く！！」", "Battle/Dat/Battle/Message/067.bmd|0x00901B": "「我を阻むものなし……！」", "Battle/Dat/Battle/Message/067.bmd|0x009043": "「トロンベよ、その名の如く竜巻となれ！」", "Battle/Dat/Battle/Message/067.bmd|0x009080": "「貫く！！」", "Battle/Dat/Battle/Message/067.bmd|0x009093": "「友よ、今こそ我らの力を見せる時！」", "Battle/Dat/Battle/Message/067.bmd|0x0090CA": "「承知！！」", "Battle/Dat/Battle/Message/067.bmd|0x0090DD": "「はあっ！」", "Battle/Dat/Battle/Message/067.bmd|0x0090F0": "「友よ、今が駆け抜ける時！」", "Battle/Dat/Battle/Message/067.bmd|0x00911B": "「応！！」", "Battle/Dat/Battle/Message/067.bmd|0x00912B": "「刃・馬・一・体！」", "Battle/Dat/Battle/Message/067.bmd|0x00914A": "「参るッ！！」", "Battle/Dat/Battle/Message/067.bmd|0x009160": "「吠えろ、ダイゼンガー！/　武神のごとく！！」", "Battle/Dat/Battle/Message/067.bmd|0x0091A4": "「駆けろ、トロンベ！　その名の如く！」", "Battle/Dat/Battle/Message/067.bmd|0x0091DE": "「刃馬！　一体ッ！！」", "Battle/Dat/Battle/Message/067.bmd|0x009200": "「刮目せよッ！！」", "Battle/Dat/Battle/Message/067.bmd|0x00921C": "「これぞ我らの！！」", "Battle/Dat/Battle/Message/067.bmd|0x00923B": "「乾坤一擲の一撃なり！」", "Battle/Dat/Battle/Message/067.bmd|0x009260": "「でえええいっ！！」", "Battle/Dat/Battle/Message/067.bmd|0x00927F": "「はあああああっ！！」", "Battle/Dat/Battle/Message/067.bmd|0x0092A1": "「ぬおおおおお！！」"}