{"Battle/Dat/Battle/Message/127.bmd|0x0029C1": "「これで終わらせる！」", "Battle/Dat/Battle/Message/127.bmd|0x0029E3": "「トロニウム・レヴ、フルドライブ！」", "Battle/Dat/Battle/Message/127.bmd|0x002A1A": "「テヒル・デレット！」", "Battle/Dat/Battle/Message/127.bmd|0x002A3C": "「ゲマトリア修正！」", "Battle/Dat/Battle/Message/127.bmd|0x002A5B": "「アキシオン・アッシャー！」", "Battle/Dat/Battle/Message/127.bmd|0x002A86": "「さあ、砕け散れぇぇ！！」", "Battle/Dat/Battle/Message/127.bmd|0x002AAE": "「デッド・エンド・スラァァッシュ！！」", "Battle/Dat/Battle/Message/127.bmd|0x002AE8": "「どこへ行く気だ？」", "Battle/Dat/Battle/Message/127.bmd|0x002B07": "「何だ？　逃げる気か？」", "Battle/Dat/Battle/Message/127.bmd|0x002B2C": "「追い詰める！」", "Battle/Dat/Battle/Message/127.bmd|0x002B45": "「容赦はしない！」", "Battle/Dat/Battle/Message/127.bmd|0x002B61": "「奴を逃がすな、ガリルナガン！」", "Battle/Dat/Battle/Message/127.bmd|0x002B92": "「チッ、ここが潮時か！」", "Battle/Dat/Battle/Message/127.bmd|0x002BB7": "「この私を退かせるとは……！！」", "Battle/Dat/Battle/Message/127.bmd|0x002BE8": "「ここまでとはな……！！」", "Battle/Dat/Battle/Message/127.bmd|0x002C10": "「わ、私のガリルナガンが！！」", "Battle/Dat/Battle/Message/127.bmd|0x002C3E": "「そ、そんな！　アルテウル様！！」", "Battle/Dat/Battle/Message/127.bmd|0x002C72": "「余程死にたいようだな！/　その願い、叶えてやる！」", "Battle/Dat/Battle/Message/127.bmd|0x002CBF": "「うぐっ！/　トロニウム・レヴさえ無事ならば！」", "Battle/Dat/Battle/Message/127.bmd|0x002D06": "「小物が！　いい気になるな！」", "Battle/Dat/Battle/Message/127.bmd|0x002D34": "「お前は……お前は私を怒らせた！」", "Battle/Dat/Battle/Message/127.bmd|0x002D68": "「ええい、鬱陶しい奴め！」", "Battle/Dat/Battle/Message/127.bmd|0x002D90": "「私のプライドに傷を付けた罪！/　その命で贖ってもらうぞ！」", "Battle/Dat/Battle/Message/127.bmd|0x002DE9": "「ガリルナガンをここまで追い込むとは……！」", "Battle/Dat/Battle/Message/127.bmd|0x002E2C": "「ぐっ！　ガリルナガンが対応しきれんとは！」", "Battle/Dat/Battle/Message/127.bmd|0x002E6F": "「おのれ、アリエイル！」", "Battle/Dat/Battle/Message/127.bmd|0x002E94": "「ううっ！/　リュウセイ・ダテ……お前などに！」", "Battle/Dat/Battle/Message/127.bmd|0x002EDB": "「用済みの駒ごときが、調子に乗るな！」", "Battle/Dat/Battle/Message/127.bmd|0x002F15": "「くうっ！/　あの女の力が私を上回るわけが……！！」", "Battle/Dat/Battle/Message/127.bmd|0x002F62": "「イングめ、よくも！」", "Battle/Dat/Battle/Message/127.bmd|0x002F84": "「許さん、許さんぞ！　イング！！」", "Battle/Dat/Battle/Message/127.bmd|0x002FB8": "「ぐうっ！　イングめ、予想外の力を……！！」", "Battle/Dat/Battle/Message/127.bmd|0x002FFB": "「馬鹿な、あの機体にあんな力が……！！」", "Battle/Dat/Battle/Message/127.bmd|0x003038": "「うぐっ！/　消え去るべきはその機体だ、私ではない！」", "Battle/Dat/Battle/Message/127.bmd|0x003088": "「くっ！/　凶鳥に狩られるなど、あってはならない！」", "Battle/Dat/Battle/Message/127.bmd|0x0030D5": "「くうっ！　欠陥機にここまで押されるとは！」", "Battle/Dat/Battle/Message/127.bmd|0x003118": "「中途半端な攻撃など、するだけ無駄だ！」", "Battle/Dat/Battle/Message/127.bmd|0x003155": "「少しはやるようだが、詰めが甘いな」", "Battle/Dat/Battle/Message/127.bmd|0x00318C": "「ふん、奴を甘く見過ぎたか」", "Battle/Dat/Battle/Message/127.bmd|0x0031B7": "「フフフ……狩り甲斐のある獲物だ」", "Battle/Dat/Battle/Message/127.bmd|0x0031EB": "「ハッ、勢いだけではな！」", "Battle/Dat/Battle/Message/127.bmd|0x003213": "「くらったか。/　だが、トロニウム・レヴに異常はない」", "Battle/Dat/Battle/Message/127.bmd|0x003263": "「ふん、活きのいい獲物だな」", "Battle/Dat/Battle/Message/127.bmd|0x00328E": "「チッ、迂闊だったな」", "Battle/Dat/Battle/Message/127.bmd|0x0032B0": "「ふん、裏切り者の分際で……」", "Battle/Dat/Battle/Message/127.bmd|0x0032DE": "「リュウセイ・ダテ……お前は目障りだ」", "Battle/Dat/Battle/Message/127.bmd|0x003318": "「以前ほどの力はないようだな」", "Battle/Dat/Battle/Message/127.bmd|0x003346": "「ヴィレッタ、/　お前は己の過ちに気づいていない」", "Battle/Dat/Battle/Message/127.bmd|0x003390": "「詰めが甘いぞ、イング」", "Battle/Dat/Battle/Message/127.bmd|0x0033B5": "「イング……お前だけは！」", "Battle/Dat/Battle/Message/127.bmd|0x0033DD": "「くっ！　やるな、イング！」", "Battle/Dat/Battle/Message/127.bmd|0x003408": "「寄せ集めで作った機体と言えど、/　そこそこのパワーはあるようだな」", "Battle/Dat/Battle/Message/127.bmd|0x00346D": "「トロニウムから得た力を/　完全に引き出せていないようだな」", "Battle/Dat/Battle/Message/127.bmd|0x0034C6": "「この程度、いちいちかわすまでもない」", "Battle/Dat/Battle/Message/127.bmd|0x003500": "「それで終わりか」", "Battle/Dat/Battle/Message/127.bmd|0x00351C": "「次はどうするつもりだ？」", "Battle/Dat/Battle/Message/127.bmd|0x003544": "「私に挑んでくるとは、いい度胸だ」", "Battle/Dat/Battle/Message/127.bmd|0x003578": "「どうした？　当てるだけで精一杯か？」", "Battle/Dat/Battle/Message/127.bmd|0x0035B2": "「押しが足りんな」", "Battle/Dat/Battle/Message/127.bmd|0x0035CE": "「ふん、アルテウル様が/　目を付けられただけのことはあるな」", "Battle/Dat/Battle/Message/127.bmd|0x003627": "「ガリルナガンを捉えるとは……/　褒めておいてやる」", "Battle/Dat/Battle/Message/127.bmd|0x003674": "「遠慮でもしているつもりか、アリエイル？」", "Battle/Dat/Battle/Message/127.bmd|0x0036B4": "「非力だな、ＳＲＸチーム」", "Battle/Dat/Battle/Message/127.bmd|0x0036DC": "「用済みの駒が何をしようと……」", "Battle/Dat/Battle/Message/127.bmd|0x00370D": "「パターンを読んだか、ヴィレッタ」", "Battle/Dat/Battle/Message/127.bmd|0x003741": "「非力だな、イング」", "Battle/Dat/Battle/Message/127.bmd|0x003760": "「チッ！　調子に乗るな、イング！」", "Battle/Dat/Battle/Message/127.bmd|0x003794": "「イング、それがお前の力か？」", "Battle/Dat/Battle/Message/127.bmd|0x0037C2": "「所詮は寄せ集めの機体か」", "Battle/Dat/Battle/Message/127.bmd|0x0037EA": "「全身に付けたそのパーツは、ただの飾りか？」", "Battle/Dat/Battle/Message/127.bmd|0x00382D": "「不完全なトロニウム・エンジンでは、/　その程度か」", "Battle/Dat/Battle/Message/127.bmd|0x00387A": "「動きに無駄が多いぞ！」", "Battle/Dat/Battle/Message/127.bmd|0x00389F": "「ハッ！　馬鹿が！」", "Battle/Dat/Battle/Message/127.bmd|0x0038BE": "「お前の動きは、手に取るようにわかる」", "Battle/Dat/Battle/Message/127.bmd|0x0038F8": "「遅いな」", "Battle/Dat/Battle/Message/127.bmd|0x003908": "「ガリルナガンには追いつけん！」", "Battle/Dat/Battle/Message/127.bmd|0x003939": "「そんなガラクタで何が出来る？」", "Battle/Dat/Battle/Message/127.bmd|0x00396A": "「そうだ、イング……/　所詮、お前はその程度だよ！」", "Battle/Dat/Battle/Message/127.bmd|0x0039B7": "「単調な攻撃だな」", "Battle/Dat/Battle/Message/127.bmd|0x0039D3": "「お前の動きは読めている」", "Battle/Dat/Battle/Message/127.bmd|0x0039FB": "「甘いな、アリエイル」", "Battle/Dat/Battle/Message/127.bmd|0x003A1D": "「相手にならんな、ＳＲＸチーム」", "Battle/Dat/Battle/Message/127.bmd|0x003A4E": "「ヴィレッタ、お前では無理だ」", "Battle/Dat/Battle/Message/127.bmd|0x003A7C": "「無駄だ、イング！」", "Battle/Dat/Battle/Message/127.bmd|0x003A9B": "「ハッ！　それがお前の力か、イング！」", "Battle/Dat/Battle/Message/127.bmd|0x003AD5": "「そんなものか、凶鳥の末裔は」", "Battle/Dat/Battle/Message/127.bmd|0x003B03": "「ハッ！　何だ、それは！」", "Battle/Dat/Battle/Message/127.bmd|0x003B2B": "「読みが甘かったな」", "Battle/Dat/Battle/Message/127.bmd|0x003B4A": "「つまらん手だ」", "Battle/Dat/Battle/Message/127.bmd|0x003B63": "「無駄だ！」", "Battle/Dat/Battle/Message/127.bmd|0x003B76": "「………」", "Battle/Dat/Battle/Message/127.bmd|0x003B86": "「ふん、お前は運がいい……」", "Battle/Dat/Battle/Message/127.bmd|0x003BB1": "「まあいい、ここは見逃してやる」", "Battle/Dat/Battle/Message/127.bmd|0x003BE2": "「恐ろしいのか、この私が」", "Battle/Dat/Battle/Message/127.bmd|0x003C0A": "「闇雲に攻撃をしているわけではないようだな」", "Battle/Dat/Battle/Message/127.bmd|0x003C4D": "「ふん、どこへ行こうと無駄だ」", "Battle/Dat/Battle/Message/127.bmd|0x003C7B": "「私に気づくのが遅かったな！」", "Battle/Dat/Battle/Message/127.bmd|0x003CA9": "「奴は私が狩る！」", "Battle/Dat/Battle/Message/127.bmd|0x003CC5": "「そこをどけ！」", "Battle/Dat/Battle/Message/127.bmd|0x003CDE": "「アルテウル様、後は私が！」", "Battle/Dat/Battle/Message/127.bmd|0x003D09": "「手緩いな、エグレッタ」", "Battle/Dat/Battle/Message/127.bmd|0x003D2E": "「下がれ、ドゥバン！」", "Battle/Dat/Battle/Message/127.bmd|0x003D50": "「お前の相手は私だ！」", "Battle/Dat/Battle/Message/127.bmd|0x003D72": "「好きにはやらせん！」", "Battle/Dat/Battle/Message/127.bmd|0x003D94": "「運が尽きたな！」", "Battle/Dat/Battle/Message/127.bmd|0x003DB0": "「もう逃げ場はないぞ！」", "Battle/Dat/Battle/Message/127.bmd|0x003DD5": "「トライ・スラッシャー！」", "Battle/Dat/Battle/Message/127.bmd|0x003DFD": "「行け！」", "Battle/Dat/Battle/Message/127.bmd|0x003E0D": "「スラッシャー、ロック・オフ！」", "Battle/Dat/Battle/Message/127.bmd|0x003E3E": "「回れ！　切り裂け！」", "Battle/Dat/Battle/Message/127.bmd|0x003E60": "「潰してやる！」", "Battle/Dat/Battle/Message/127.bmd|0x003E79": "「くらえ！」", "Battle/Dat/Battle/Message/127.bmd|0x003E8C": "「もらったぞ！」", "Battle/Dat/Battle/Message/127.bmd|0x003EA5": "「吹き飛べ！」", "Battle/Dat/Battle/Message/127.bmd|0x003EBB": "「逃がしはしない！」", "Battle/Dat/Battle/Message/127.bmd|0x003EDA": "「バスタックス・ガン！」", "Battle/Dat/Battle/Message/127.bmd|0x003EFF": "「シュート！」", "Battle/Dat/Battle/Message/127.bmd|0x003F15": "「ターゲット・ロック！」", "Battle/Dat/Battle/Message/127.bmd|0x003F3A": "「消滅しろ！」", "Battle/Dat/Battle/Message/127.bmd|0x003F50": "「バスタックス・シーケンス！」"}