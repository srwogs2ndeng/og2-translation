{"Battle/Dat/Battle/Message/106.bmd|0x00737C": "「そう思い通りに！」", "Battle/Dat/Battle/Message/106.bmd|0x00739B": "「その手に乗るかよ！」", "Battle/Dat/Battle/Message/106.bmd|0x0073BD": "「狙い所がわかればさ！」", "Battle/Dat/Battle/Message/106.bmd|0x0073E2": "「俺を狙ったところで！」", "Battle/Dat/Battle/Message/106.bmd|0x007407": "「エール・シュヴァリアーに/　追いつけるものか！」", "Battle/Dat/Battle/Message/106.bmd|0x007451": "「このエール・シュヴァリアーなら！」", "Battle/Dat/Battle/Message/106.bmd|0x007488": "「でかいからって、的になる気はない！」", "Battle/Dat/Battle/Message/106.bmd|0x0074C2": "「見かけほど動きは鈍くないのさ！」", "Battle/Dat/Battle/Message/106.bmd|0x0074F6": "「さすがね、アニキ！」", "Battle/Dat/Battle/Message/106.bmd|0x007518": "「次も回避してみせるさ」", "Battle/Dat/Battle/Message/106.bmd|0x00753D": "「次もこの調子でお願い！」", "Battle/Dat/Battle/Message/106.bmd|0x007565": "「ああ、そのつもりだ」", "Battle/Dat/Battle/Message/106.bmd|0x007587": "「アニキ、今のは……」", "Battle/Dat/Battle/Message/106.bmd|0x0075A9": "「……ちょっと危なかったな」", "Battle/Dat/Battle/Message/106.bmd|0x0075D4": "（うぅ～、やっぱり）", "Battle/Dat/Battle/Message/106.bmd|0x0075F3": "「無駄だ、イグニス！」", "Battle/Dat/Battle/Message/106.bmd|0x007615": "「させるか、イグニス！」", "Battle/Dat/Battle/Message/106.bmd|0x00763A": "「遅いぞ、コンターギオ！」", "Battle/Dat/Battle/Message/106.bmd|0x007662": "「無駄だ、アクイラ！」", "Battle/Dat/Battle/Message/106.bmd|0x007684": "「甘いぞ、ウンブラ！」", "Battle/Dat/Battle/Message/106.bmd|0x0076A6": "「無駄だ、夏喃！」", "Battle/Dat/Battle/Message/106.bmd|0x0076C2": "「遅いぞ、泰北！」", "Battle/Dat/Battle/Message/106.bmd|0x0076DE": "「ガイアセイバーズの好きにやらせるか！」", "Battle/Dat/Battle/Message/106.bmd|0x00771B": "「ガイアセイバーズ、お前達などに！」", "Battle/Dat/Battle/Message/106.bmd|0x007752": "「ルイーナなどに！」", "Battle/Dat/Battle/Message/106.bmd|0x007771": "「ルイーナに捕まってたまるか！」", "Battle/Dat/Battle/Message/106.bmd|0x0077A2": "「ルイーナの標的にはならない！」", "Battle/Dat/Battle/Message/106.bmd|0x0077D3": "「メディウスに捕まるわけには！」", "Battle/Dat/Battle/Message/106.bmd|0x007804": "「あの斧をくらうわけには！」", "Battle/Dat/Battle/Message/106.bmd|0x00782F": "「ゲストに捕まるものか！」", "Battle/Dat/Battle/Message/106.bmd|0x007857": "「異星人などに！」", "Battle/Dat/Battle/Message/106.bmd|0x007873": "「妖機人などに！」", "Battle/Dat/Battle/Message/106.bmd|0x00788F": "「その動きには惑わされない！」", "Battle/Dat/Battle/Message/106.bmd|0x0078BD": "「これなら、次も予測できる！」", "Battle/Dat/Battle/Message/106.bmd|0x0078EB": "「狙いだけが良くてもな！」", "Battle/Dat/Battle/Message/106.bmd|0x007913": "「あいつに気を取られ過ぎると……！」", "Battle/Dat/Battle/Message/106.bmd|0x00794A": "「くっ、この感覚は……！」", "Battle/Dat/Battle/Message/106.bmd|0x007972": "「ウェントス、あいつは……！」", "Battle/Dat/Battle/Message/106.bmd|0x0079A0": "「かわしたぞ、コンターギオ！」", "Battle/Dat/Battle/Message/106.bmd|0x0079CE": "「かわしたぞ、ドゥバン！」", "Battle/Dat/Battle/Message/106.bmd|0x0079F6": "「甘いぞ、ゼブ！」", "Battle/Dat/Battle/Message/106.bmd|0x007A12": "「かわしたぞ、ロフ！」", "Battle/Dat/Battle/Message/106.bmd|0x007A34": "「無駄だ、ゼゼーナン！」", "Battle/Dat/Battle/Message/106.bmd|0x007A59": "「よく狙え、光龍！」", "Battle/Dat/Battle/Message/106.bmd|0x007A78": "「未来と希望……それを信じる想いがあれば！」", "Battle/Dat/Battle/Message/106.bmd|0x007ABB": "「押し戻してみせるさ、“破滅”の力を！」", "Battle/Dat/Battle/Message/106.bmd|0x007AF8": "「あのサイズで……速いな」", "Battle/Dat/Battle/Message/106.bmd|0x007B20": "「よし、ジンライを振り切った！」", "Battle/Dat/Battle/Message/106.bmd|0x007B51": "「動きを見切れば、/　あのスピードでもかわせる！」", "Battle/Dat/Battle/Message/106.bmd|0x007B9B": "「超機人と言えど、この程度なら！」", "Battle/Dat/Battle/Message/106.bmd|0x007BCF": "「動きをよく見れば、四凶と言えど！」", "Battle/Dat/Battle/Message/106.bmd|0x007C06": "「お前の邪念は届かない！」", "Battle/Dat/Battle/Message/106.bmd|0x007C2E": "「ガンエデン、お前の加護など必要ない！」", "Battle/Dat/Battle/Message/106.bmd|0x007C6B": "「ユーゼス、お前が創り出す世界など！」", "Battle/Dat/Battle/Message/106.bmd|0x007CA5": "「ユーゼス、抹消されるべきはお前だ！」", "Battle/Dat/Battle/Message/106.bmd|0x007CDF": "「こいつにそんな攻撃、効きはしない！」", "Battle/Dat/Battle/Message/106.bmd|0x007D19": "「その程度の攻撃でさ！」", "Battle/Dat/Battle/Message/106.bmd|0x007D3E": "「防いでみせる！」", "Battle/Dat/Battle/Message/106.bmd|0x007D5A": "「そんなもの！」", "Battle/Dat/Battle/Message/106.bmd|0x007D73": "「俺を狙っても無駄だ！」", "Battle/Dat/Battle/Message/106.bmd|0x007D98": "「その手は通用しない！」", "Battle/Dat/Battle/Message/106.bmd|0x007DBD": "「………」", "Battle/Dat/Battle/Message/106.bmd|0x007DCD": "「これ以上の攻撃は無理か……！」", "Battle/Dat/Battle/Message/106.bmd|0x007DFE": "「攻撃不可能だと……！？」", "Battle/Dat/Battle/Message/106.bmd|0x007E26": "「くっ、これでは！」", "Battle/Dat/Battle/Message/106.bmd|0x007E45": "「ロストしたか……！」", "Battle/Dat/Battle/Message/106.bmd|0x007E67": "「奴を見失うとは……！」", "Battle/Dat/Battle/Message/106.bmd|0x007E8C": "「仕切り直しということか……！？」", "Battle/Dat/Battle/Message/106.bmd|0x007EC0": "「このタイミングなら！」", "Battle/Dat/Battle/Message/106.bmd|0x007EE5": "「援護する！」", "Battle/Dat/Battle/Message/106.bmd|0x007EFB": "「チャンスは逃がさない！」", "Battle/Dat/Battle/Message/106.bmd|0x007F23": "「続く者がいると思わなかったのか！」", "Battle/Dat/Battle/Message/106.bmd|0x007F5A": "「リム、後は俺が！」", "Battle/Dat/Battle/Message/106.bmd|0x007F79": "「前に出過ぎるな、リム！」", "Battle/Dat/Battle/Message/106.bmd|0x007FA1": "「リム、奴は任せろ！」", "Battle/Dat/Battle/Message/106.bmd|0x007FC3": "「いいタイミングだ、ラキ」", "Battle/Dat/Battle/Message/106.bmd|0x007FEB": "「俺とお前で力を合わせれば……！」", "Battle/Dat/Battle/Message/106.bmd|0x00801F": "「下がってくれ、ラキ。後は俺がやる」", "Battle/Dat/Battle/Message/106.bmd|0x008056": "「手を貸すぞ、ウェントス」", "Battle/Dat/Battle/Message/106.bmd|0x00807E": "「ウェントス、後は任せろ！」", "Battle/Dat/Battle/Message/106.bmd|0x0080A9": "「キョウスケ中尉、援護します！」", "Battle/Dat/Battle/Message/106.bmd|0x0080DA": "「中尉の賭けに付き合ってみるか……！」", "Battle/Dat/Battle/Message/106.bmd|0x008114": "「少尉、後は俺が！」", "Battle/Dat/Battle/Message/106.bmd|0x008133": "「中尉、援護します！」", "Battle/Dat/Battle/Message/106.bmd|0x008155": "「大尉、こちらも続きます！」", "Battle/Dat/Battle/Message/106.bmd|0x008180": "「少佐、後は俺が！」", "Battle/Dat/Battle/Message/106.bmd|0x00819F": "「カイ少佐、後は任せて下さい！」", "Battle/Dat/Battle/Message/106.bmd|0x0081D0": "「アラド、迂闊に飛び込むな！」", "Battle/Dat/Battle/Message/106.bmd|0x0081FE": "「ゼオラ、援護する！」", "Battle/Dat/Battle/Message/106.bmd|0x008220": "「ラトゥーニ、後は任せろ！」", "Battle/Dat/Battle/Message/106.bmd|0x00824B": "「ラミア少尉、援護する！」", "Battle/Dat/Battle/Message/106.bmd|0x008273": "「ヒューゴ少尉、後は俺が！」", "Battle/Dat/Battle/Message/106.bmd|0x00829E": "「アクア少尉、後は俺が！」", "Battle/Dat/Battle/Message/106.bmd|0x0082C6": "「リュウセイ、後は任せろ！」", "Battle/Dat/Battle/Message/106.bmd|0x0082F1": "「さすがに速いな、マサキ！」", "Battle/Dat/Battle/Message/106.bmd|0x00831C": "「イング、援護する！」", "Battle/Dat/Battle/Message/106.bmd|0x00833E": "「アリエイル、後は俺が！」", "Battle/Dat/Battle/Message/106.bmd|0x008366": "「コウタ、奴は俺に任せろ！」", "Battle/Dat/Battle/Message/106.bmd|0x008391": "「続くぞ、ラウル！」", "Battle/Dat/Battle/Message/106.bmd|0x0083B0": "「やらせるものか！」", "Battle/Dat/Battle/Message/106.bmd|0x0083CF": "「間に合えっ！」", "Battle/Dat/Battle/Message/106.bmd|0x0083E8": "「食い止めてみせる！」", "Battle/Dat/Battle/Message/106.bmd|0x00840A": "「突っ込むぞ、エール・シュヴァリアー！」", "Battle/Dat/Battle/Message/106.bmd|0x008447": "「割り込め、ジェアン・シュヴァリアー！」", "Battle/Dat/Battle/Message/106.bmd|0x008484": "「このフォルテギガスならば！」", "Battle/Dat/Battle/Message/106.bmd|0x0084B2": "「離脱しろ、リム！」", "Battle/Dat/Battle/Message/106.bmd|0x0084D1": "「お前は俺が守る！」", "Battle/Dat/Battle/Message/106.bmd|0x0084F0": "「下がれ、リム！」", "Battle/Dat/Battle/Message/106.bmd|0x00850C": "「妹をやらせはしない！」", "Battle/Dat/Battle/Message/106.bmd|0x008531": "「ラキ、無茶をするな！」", "Battle/Dat/Battle/Message/106.bmd|0x008556": "「後退するんだ、ラキ！」", "Battle/Dat/Battle/Message/106.bmd|0x00857B": "「下がれ、ウェントス！」", "Battle/Dat/Battle/Message/106.bmd|0x0085A0": "「カイ少佐、後退を！」", "Battle/Dat/Battle/Message/106.bmd|0x0085C2": "「アラド、何をしている！」", "Battle/Dat/Battle/Message/106.bmd|0x0085EA": "「ゼオラ、今の内に離脱を！」", "Battle/Dat/Battle/Message/106.bmd|0x008615": "「下がるんだ、ラトゥーニ！」", "Battle/Dat/Battle/Message/106.bmd|0x008640": "「ラミア少尉、後退を！」", "Battle/Dat/Battle/Message/106.bmd|0x008665": "「ヒューゴ少尉、ここは俺が！」", "Battle/Dat/Battle/Message/106.bmd|0x008693": "「アクア少尉、離脱を！」", "Battle/Dat/Battle/Message/106.bmd|0x0086B8": "「離脱するんだ、イング！」"}