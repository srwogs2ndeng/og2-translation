{"Battle/Dat/Battle/Message/040.bmd|0x00B00B": "「ロフ、狙いが甘いぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B030": "「無駄だ、セティ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B04F": "「ゼゼーナン！　てめえなんぞにやられるか！」", "Battle/Dat/Battle/Message/040.bmd|0x00B092": "「口だけか、イグニス！」", "Battle/Dat/Battle/Message/040.bmd|0x00B0B7": "「メリオルエッセってのは、そんなもんか！」", "Battle/Dat/Battle/Message/040.bmd|0x00B0F7": "「どこ見てんだ、コンターギオ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B128": "「しっかり狙え、アクイラ！」　", "Battle/Dat/Battle/Message/040.bmd|0x00B156": "「無駄だぜ、夏喃！」", "Battle/Dat/Battle/Message/040.bmd|0x00B175": "「てめえの念には引きずられねえ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B1A9": "「いくら念が強くても、当たらなきゃな！」", "Battle/Dat/Battle/Message/040.bmd|0x00B1E6": "「届かねえぜ、ペルフェクティオ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B21A": "「甘いぜ、アーマラ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B23C": "「この感じ、どこかで……！」", "Battle/Dat/Battle/Message/040.bmd|0x00B267": "「俺を狩れると思うなよ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B28F": "「デュラクシール……当たりさえしなければ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B2D2": "「魔装機には負けねえ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B2F7": "「ゴーレムなんぞにやられるか！」", "Battle/Dat/Battle/Message/040.bmd|0x00B328": "「妖怪退散、てな！」", "Battle/Dat/Battle/Message/040.bmd|0x00B347": "「化け物に抱きつかれても、/　嬉しかねえんだよ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B391": "「てめえの妄想に俺達を巻き込むんじゃねえ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B3D4": "「てめえの加護なんざ、必要ねえ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B408": "「ユーゼス！　その手は食わねえぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B43F": "「ユーゼス、てめえが俺に何を見せようと！」", "Battle/Dat/Battle/Message/040.bmd|0x00B47F": "「お前の攻撃は既に見切った！」", "Battle/Dat/Battle/Message/040.bmd|0x00B4AD": "「この程度なら、ライだってよけられるぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B4ED": "「顔を洗って出直してきやがれ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00B521": "「回避成功！　よっしゃあ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00B54F": "「ライ、今の見たか！？/　……って、見てねえか」", "Battle/Dat/Battle/Message/040.bmd|0x00B596": "「回避完了！　次の相手はどいつだ！？」", "Battle/Dat/Battle/Message/040.bmd|0x00B5D0": "「よし！　これも/　ヴィレッタ隊長の特訓の成果だぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B620": "「よし！　よくやったぞ、アルブレード！」", "Battle/Dat/Battle/Message/040.bmd|0x00B65D": "「回避パターンに無駄が多いぞ」", "Battle/Dat/Battle/Message/040.bmd|0x00B68B": "「結果オーライってことにしといてくれ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B6C8": "「今のパターンは駄目だ。次は当てられるぞ」", "Battle/Dat/Battle/Message/040.bmd|0x00B708": "「き、厳しいのね……」", "Battle/Dat/Battle/Message/040.bmd|0x00B72A": "「ライ！　今のパターンはどうだ？」", "Battle/Dat/Battle/Message/040.bmd|0x00B75E": "「ギリギリ及第点……いや、それ以下だな」", "Battle/Dat/Battle/Message/040.bmd|0x00B79B": "「ホントに厳しいのね……」", "Battle/Dat/Battle/Message/040.bmd|0x00B7C3": "「くっ……！/　今の回避パターンは６０点ぐらいか！？」", "Battle/Dat/Battle/Message/040.bmd|0x00B813": "「７５点……頑張った方だな」", "Battle/Dat/Battle/Message/040.bmd|0x00B83E": "「そうか……。ん？　今の、褒めてくれたの？」", "Battle/Dat/Battle/Message/040.bmd|0x00B881": "「ドゥバン、俺はここだ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B8A9": "「当たらねえぜ、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B8E0": "「甘いぜ、ガイアセイバーズ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B90E": "「ガイアセイバーズ、/　てめえらにはやられねえ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B958": "「どうした、それでもダブルＧか！」", "Battle/Dat/Battle/Message/040.bmd|0x00B98C": "「邪神ってのは、その程度かよ！」", "Battle/Dat/Battle/Message/040.bmd|0x00B9BD": "「学習してねえようだな、ゲスト！」", "Battle/Dat/Battle/Message/040.bmd|0x00B9F1": "「ハッ、龍虎王の方が強いぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BA1F": "「四凶の超機人つっても、大したことねえな！」", "Battle/Dat/Battle/Message/040.bmd|0x00BA62": "「前の戦いで、化け物とは戦い慣れてんだよ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BAA5": "「ヘヘッ、残念だったな！」", "Battle/Dat/Battle/Message/040.bmd|0x00BACD": "「無駄無駄！　千年早いんだよ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00BB01": "「俺を守れ！　念動フィールド！！」", "Battle/Dat/Battle/Message/040.bmd|0x00BB35": "「ミサイルなんて意味ねえぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BB63": "「………」", "Battle/Dat/Battle/Message/040.bmd|0x00BB73": "「しまった！　メーター見るの忘れてた！」", "Battle/Dat/Battle/Message/040.bmd|0x00BBB0": "「卑怯だぞ！　そんな所にいちゃ届かねえよ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BBF3": "「しまった！」", "Battle/Dat/Battle/Message/040.bmd|0x00BC09": "「オラオラ！　続けて行くぞ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00BC3A": "「今度は俺の番だぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BC5C": "「続けて行くぞ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00BC7B": "「こっちの攻撃はまだ終わってねえ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BCB2": "「ここでもういっちょブチかましてやる！」", "Battle/Dat/Battle/Message/040.bmd|0x00BCEF": "「よっしゃ！　俺も手を貸すぜ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00BD23": "「こちらリュウセイ！　援護するぜ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00BD5D": "「援護するぜ、ライ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BD7F": "「ライ、コンビネーション・アタックだ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BDBC": "「ライ！　フォーメーションＤだ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BDF0": "「アヤ、後は任せろ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BE12": "「フォーメーションＤで行くぜ、アヤ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BE4C": "「アヤ、俺がとどめを刺す！」", "Battle/Dat/Battle/Message/040.bmd|0x00BE77": "「隊長、援護するぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BE99": "「さすが隊長……！　俺も負けてられねえ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BED9": "「マイ、後は俺が引き受けるぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BF0A": "「マイ、コンビネーションでいくぞ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BF41": "「頑張ってんな、マイ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BF66": "「よし！　後は任せろ、ラトゥーニ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BF9D": "「援護するぜ、ラトゥーニ！」", "Battle/Dat/Battle/Message/040.bmd|0x00BFC8": "「ラトゥーニ、お前は先に行け！」", "Battle/Dat/Battle/Message/040.bmd|0x00BFF9": "「ブリット！　後は任せろ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C024": "「いい位置だぜ、クスハ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C04C": "「クスハ、後は任せろ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C071": "「イルム中尉、援護するぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C09C": "「マサキ、後は任せろ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C0C1": "「手伝うぜ、リョウト！」", "Battle/Dat/Battle/Message/040.bmd|0x00C0E6": "「援護するぞ、リオ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C108": "「タスク！　どこへ行くんだ！？」", "Battle/Dat/Battle/Message/040.bmd|0x00C139": "「レオナ、援護するぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C15E": "「ユウ、後は引き受けたぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C189": "「カーラ、こっちからも行くぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C1BA": "「手を貸すぜ、アラド！」", "Battle/Dat/Battle/Message/040.bmd|0x00C1DF": "「こっちからも行くぜ、キョウスケ中尉！」　", "Battle/Dat/Battle/Message/040.bmd|0x00C21F": "「キョウスケ中尉、後は引き受けた！」", "Battle/Dat/Battle/Message/040.bmd|0x00C256": "「エクセレン少尉、援護するぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C287": "「援護するぜ、コウタ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C2AC": "「援護するぜ、アリエイル！」", "Battle/Dat/Battle/Message/040.bmd|0x00C2D7": "「ヒューゴ少尉、後は任せてくれ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C30B": "「手を貸すぜ、アクア少尉！」", "Battle/Dat/Battle/Message/040.bmd|0x00C336": "「ジョッシュ、後は俺がやる！」", "Battle/Dat/Battle/Message/040.bmd|0x00C364": "「援護するぜ、リム！」", "Battle/Dat/Battle/Message/040.bmd|0x00C386": "「トウマ、後は任せろ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C3AB": "「イング、援護するぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C3D0": "「ミチル、後は任せな！」", "Battle/Dat/Battle/Message/040.bmd|0x00C3F5": "「ミオ、こっちからも行くぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C423": "「ここは俺に任せてくれ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C44B": "「割り込んでやる！」", "Battle/Dat/Battle/Message/040.bmd|0x00C46A": "「俺が身代わりになる！　早く逃げてくれ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C4AA": "「チョット待った！/　へへ、ここは俺が引き受けるぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C4FA": "「これぐらいのことはやらせてくれ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C531": "「下がれ、ライ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C54D": "「ライ、貸しにしとくぜ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C575": "「アヤ、ここは俺が引き受ける！」", "Battle/Dat/Battle/Message/040.bmd|0x00C5A6": "「アヤ、早く逃げろ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C5C8": "「隊長！　危ねえっ！！」", "Battle/Dat/Battle/Message/040.bmd|0x00C5ED": "「ヴィレッタ隊長、早くこっちの後ろに！」", "Battle/Dat/Battle/Message/040.bmd|0x00C62A": "「マイ、下がれ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C646": "「マイ、無理すんな！」", "Battle/Dat/Battle/Message/040.bmd|0x00C668": "「ラトゥーニ！　今の内に逃げろ！」", "Battle/Dat/Battle/Message/040.bmd|0x00C69C": "「ラトゥーニ！　あいつは俺に任せろ！」"}