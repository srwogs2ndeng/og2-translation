{"Battle/Dat/Battle/Message/036.bmd|0x007B20": "「所詮はそんなものか、ドゥバン」", "Battle/Dat/Battle/Message/036.bmd|0x007B51": "「メリオルエッセなどと……/　名ばかりは大層だがな」", "Battle/Dat/Battle/Message/036.bmd|0x007B9E": "「お前の御託はもういい」", "Battle/Dat/Battle/Message/036.bmd|0x007BC3": "「題目はそこまでにしてもらおうか」", "Battle/Dat/Battle/Message/036.bmd|0x007BF7": "「インスペクターと大差ないようだな」", "Battle/Dat/Battle/Message/036.bmd|0x007C2E": "「結局、言うこととやることは/　インスペクターと同じか」", "Battle/Dat/Battle/Message/036.bmd|0x007C81": "「破滅するのはお前の方だ」", "Battle/Dat/Battle/Message/036.bmd|0x007CA9": "「超機人……見た目だけか」", "Battle/Dat/Battle/Message/036.bmd|0x007CD1": "「超機人の力はその程度か？」", "Battle/Dat/Battle/Message/036.bmd|0x007CFC": "「お前と溶け合う気などない」", "Battle/Dat/Battle/Message/036.bmd|0x007D27": "「今回の賭けは俺の勝ちだ……！」", "Battle/Dat/Battle/Message/036.bmd|0x007D58": "「む、かすめたか……？」", "Battle/Dat/Battle/Message/036.bmd|0x007D7D": "「気の抜けた攻撃だな」", "Battle/Dat/Battle/Message/036.bmd|0x007D9F": "「なるほど……/　慣れれば使える機体だな、こいつは」", "Battle/Dat/Battle/Message/036.bmd|0x007DEC": "「仙人だけあって、酔狂な手だな」", "Battle/Dat/Battle/Message/036.bmd|0x007E1D": "「ガイアセイバーズ……/　お前達のショーに付き合う気はない」", "Battle/Dat/Battle/Message/036.bmd|0x007E76": "「その手には乗らんぞ、ガイアセイバーズ」", "Battle/Dat/Battle/Message/036.bmd|0x007EB3": "「ガイアセイバーズ……/　目論み通りに行くと思うなよ」", "Battle/Dat/Battle/Message/036.bmd|0x007F03": "「確かに、/　ヒュッケバイン以上の運動性だが……」", "Battle/Dat/Battle/Message/036.bmd|0x007F4D": "「ダイゼンガーほどの切れはないようだな」", "Battle/Dat/Battle/Message/036.bmd|0x007F8A": "「神を名乗っておいて、それか？」", "Battle/Dat/Battle/Message/036.bmd|0x007FBB": "「ユーゼス、/　お前の計画にほころびが見えているぞ」", "Battle/Dat/Battle/Message/036.bmd|0x008008": "「面白い芸だった」", "Battle/Dat/Battle/Message/036.bmd|0x008024": "「ブラフ混じりの手などに……！」", "Battle/Dat/Battle/Message/036.bmd|0x008055": "「うっ！？　……バリアか？/　目がチカチカするぜ……」", "Battle/Dat/Battle/Message/036.bmd|0x0080A5": "「サマ臭いが……バリアの世話になるか」", "Battle/Dat/Battle/Message/036.bmd|0x0080DF": "「バリアか……それなりに頼りになるな」", "Battle/Dat/Battle/Message/036.bmd|0x008119": "「これを抜いても装甲がある。/　食ってはやれん」", "Battle/Dat/Battle/Message/036.bmd|0x008160": "「……イカサマじゃない」", "Battle/Dat/Battle/Message/036.bmd|0x008185": "「ジャマーか……それなりに頼りになるな」", "Battle/Dat/Battle/Message/036.bmd|0x0081C2": "「………」", "Battle/Dat/Battle/Message/036.bmd|0x0081D2": "「……ちっ、序盤で無駄が多かったか……！」", "Battle/Dat/Battle/Message/036.bmd|0x008212": "「……ちっ、実弾は扱いやすいが、弾数がな」", "Battle/Dat/Battle/Message/036.bmd|0x008252": "「寄らなければ話にならんか……」", "Battle/Dat/Battle/Message/036.bmd|0x008283": "「ちっ……！」", "Battle/Dat/Battle/Message/036.bmd|0x008299": "「この距離ならば……援護する！」", "Battle/Dat/Battle/Message/036.bmd|0x0082CA": "「いける！　こいつもとっておけっ！」", "Battle/Dat/Battle/Message/036.bmd|0x008301": "「悪いな、邪魔をする……！」", "Battle/Dat/Battle/Message/036.bmd|0x00832C": "「アルト、ここで決めるぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x008357": "「何をやっている。/　おれがとどめを撃つぞ、エクセレン」", "Battle/Dat/Battle/Message/036.bmd|0x0083AA": "「下がれ、エクセレン！　おれも仕掛ける！」", "Battle/Dat/Battle/Message/036.bmd|0x0083EA": "「エクセレン、援護するぞ……！」", "Battle/Dat/Battle/Message/036.bmd|0x00841B": "「ブリット、援護に入る。……下がれ！」", "Battle/Dat/Battle/Message/036.bmd|0x008455": "「カチーナ中尉、援護に入るぞ……！」", "Battle/Dat/Battle/Message/036.bmd|0x00848C": "「タスク！　おれが行く！」", "Battle/Dat/Battle/Message/036.bmd|0x0084B4": "「リュウセイ、後は任せろ」", "Battle/Dat/Battle/Message/036.bmd|0x0084DC": "「ラミア、援護するぞ……！」", "Battle/Dat/Battle/Message/036.bmd|0x008507": "「ラミア、お前は先に行け」", "Battle/Dat/Battle/Message/036.bmd|0x00852F": "「クスハ、後はおれに任せろ」", "Battle/Dat/Battle/Message/036.bmd|0x00855A": "「マサキ、援護に入るぞ……！」", "Battle/Dat/Battle/Message/036.bmd|0x008588": "「アラド、目の前に集中しろ」", "Battle/Dat/Battle/Message/036.bmd|0x0085B3": "「少佐、援護に入ります」", "Battle/Dat/Battle/Message/036.bmd|0x0085D8": "「コウタ、援護するぞ」", "Battle/Dat/Battle/Message/036.bmd|0x0085FA": "「ラウル、後は任せろ」", "Battle/Dat/Battle/Message/036.bmd|0x00861C": "「フィオナ、先に行け」", "Battle/Dat/Battle/Message/036.bmd|0x00863E": "「アクセル、ここはおれが行く！」", "Battle/Dat/Battle/Message/036.bmd|0x00866F": "「アクセル、奴のとどめはおれが刺す……！」", "Battle/Dat/Battle/Message/036.bmd|0x0086AF": "「後は任せろ、アリエイル」", "Battle/Dat/Battle/Message/036.bmd|0x0086D7": "「援護するぞ、アリエイル」", "Battle/Dat/Battle/Message/036.bmd|0x0086FF": "「ヒューゴ、後は引き受ける」", "Battle/Dat/Battle/Message/036.bmd|0x00872A": "「奴はおれに任せろ、ヒューゴ」", "Battle/Dat/Battle/Message/036.bmd|0x008758": "「アクア、援護する」", "Battle/Dat/Battle/Message/036.bmd|0x008777": "「下がれ、アクア。後はおれがやる」", "Battle/Dat/Battle/Message/036.bmd|0x0087AB": "「ジョッシュ、後は任せろ」", "Battle/Dat/Battle/Message/036.bmd|0x0087D3": "「分の悪い賭けではないがな……！」", "Battle/Dat/Battle/Message/036.bmd|0x008807": "「援護に入るぞ、ジョッシュ」", "Battle/Dat/Battle/Message/036.bmd|0x008832": "「リム、後はおれが引き受ける」", "Battle/Dat/Battle/Message/036.bmd|0x008860": "「トウマ、援護する」", "Battle/Dat/Battle/Message/036.bmd|0x00887F": "「イング、ここは任せろ」", "Battle/Dat/Battle/Message/036.bmd|0x0088A4": "「少し無理させてもらうぞ……！」", "Battle/Dat/Battle/Message/036.bmd|0x0088D5": "「危ないっ……！　出力全開……！」", "Battle/Dat/Battle/Message/036.bmd|0x008909": "「フォローに入る！　アルト向きの相手だ！」", "Battle/Dat/Battle/Message/036.bmd|0x008949": "「鈍い分、装甲は厚いんでな！」", "Battle/Dat/Battle/Message/036.bmd|0x008977": "「下がれ、エクセレン！」", "Battle/Dat/Battle/Message/036.bmd|0x00899C": "「エクセレン、ここはおれに任せろ」", "Battle/Dat/Battle/Message/036.bmd|0x0089D0": "「迂闊だぞ、ブリット！」", "Battle/Dat/Battle/Message/036.bmd|0x0089F5": "「リュウセイ、気を抜くな！」", "Battle/Dat/Battle/Message/036.bmd|0x008A20": "「下がれ、ラミア！」", "Battle/Dat/Battle/Message/036.bmd|0x008A3F": "「下がれ、コウタ！」", "Battle/Dat/Battle/Message/036.bmd|0x008A5E": "「迂闊だぞ、ラウル！」", "Battle/Dat/Battle/Message/036.bmd|0x008A80": "「フィオナ、下がれ！」", "Battle/Dat/Battle/Message/036.bmd|0x008AA2": "「アクセル、ここはおれが引き受ける！」", "Battle/Dat/Battle/Message/036.bmd|0x008ADC": "「後退しろ、アリエイル！」", "Battle/Dat/Battle/Message/036.bmd|0x008B04": "「下がれ、ヒューゴ！」", "Battle/Dat/Battle/Message/036.bmd|0x008B26": "「アクア、気を抜くな！」", "Battle/Dat/Battle/Message/036.bmd|0x008B4B": "「ここは退け、ジョッシュ！」", "Battle/Dat/Battle/Message/036.bmd|0x008B76": "「その賭けは分が悪いぞ……！」", "Battle/Dat/Battle/Message/036.bmd|0x008BA4": "「リム、下がれ！」", "Battle/Dat/Battle/Message/036.bmd|0x008BC0": "「トウマ、後退しろ！」", "Battle/Dat/Battle/Message/036.bmd|0x008BE2": "「イング、下がれ！」", "Battle/Dat/Battle/Message/036.bmd|0x008C01": "「いい位置だ……もらうぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x008C2C": "「総取りでいかせてもらう！」", "Battle/Dat/Battle/Message/036.bmd|0x008C57": "「降りられると思うな……！」", "Battle/Dat/Battle/Message/036.bmd|0x008C82": "「こちらにはまだ手札が残っている……！」", "Battle/Dat/Battle/Message/036.bmd|0x008CBF": "「ツキはおれの方にある……！」", "Battle/Dat/Battle/Message/036.bmd|0x008CED": "「射程に入った……！　行けっ！」", "Battle/Dat/Battle/Message/036.bmd|0x008D1E": "「とったぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x008D34": "「いつもとはパターン変えていきましょっか！」", "Battle/Dat/Battle/Message/036.bmd|0x008D77": "「いいだろう……行くぞ！」", "Battle/Dat/Battle/Message/036.bmd|0x008D9F": "「さーて、/　暴れまくり幽霊ちゃん、行ってみましょっか！」", "Battle/Dat/Battle/Message/036.bmd|0x008DF5": "「こちらの手は読ません。パターンを変える」", "Battle/Dat/Battle/Message/036.bmd|0x008E35": "「後ろ、とったわよ！　と思わせといて！」", "Battle/Dat/Battle/Message/036.bmd|0x008E72": "「こちらが仕掛ける！」", "Battle/Dat/Battle/Message/036.bmd|0x008E94": "「行くわよ、キョウスケ！」", "Battle/Dat/Battle/Message/036.bmd|0x008EBC": "「いい位置だ！」", "Battle/Dat/Battle/Message/036.bmd|0x008ED5": "「続けてキャッチ＆リリース！」", "Battle/Dat/Battle/Message/036.bmd|0x008F03": "「ちょいなっ！！」", "Battle/Dat/Battle/Message/036.bmd|0x008F1F": "「クレイモア！」", "Battle/Dat/Battle/Message/036.bmd|0x008F38": "「バンカー！」", "Battle/Dat/Battle/Message/036.bmd|0x008F4E": "「これがおれ達の！」", "Battle/Dat/Battle/Message/036.bmd|0x008F6D": "「切り札よん！」", "Battle/Dat/Battle/Message/036.bmd|0x008F86": "「行けぇぇっ！！」", "Battle/Dat/Battle/Message/036.bmd|0x008FA2": "「……お前にしては、真面目な締めだったな」", "Battle/Dat/Battle/Message/036.bmd|0x008FE2": "「あらん、そうだったっけ？」", "Battle/Dat/Battle/Message/036.bmd|0x00900D": "「はぁーい！　こっちこっち！」", "Battle/Dat/Battle/Message/036.bmd|0x00903B": "「気を取られたな！」", "Battle/Dat/Battle/Message/036.bmd|0x00905A": "「キャッチボール、スタート！」", "Battle/Dat/Battle/Message/036.bmd|0x009088": "「戻すぞ、エクセレン！」", "Battle/Dat/Battle/Message/036.bmd|0x0090AD": "「返すわよ、キョウスケ！」", "Battle/Dat/Battle/Message/036.bmd|0x0090D5": "「カッキーン！！」"}