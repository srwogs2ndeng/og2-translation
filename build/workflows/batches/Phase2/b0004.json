{"u00160": "ゼオラ", "u00161": "「つ、次は…絶対にっ！！」", "u00162": "セティ", "u00163": "「こ、これ以上は無理ね……！」", "u00164": "セニア", "u00165": "「あいたたた……参った、計算ミスだわ」", "u00166": "ゼブ", "u00167": "「あ～りゃま、やぁられちまったい！」", "u00168": "ゼンガー", "u00169": "「う…ぬっ！　ここまでか…！」", "u00170": "タスク", "u00171": "「くそっ！　情けねえ…！！」", "u00172": "テツヤ", "u00173": "「くっ！　総員、直ちに退艦しろ！！」", "u00174": "テュッティ", "u00175": "「ごめんなさい、後はお願い」", "u00176": "トウマ", "u00177": "「くそっ！　俺の力はここまでか…！」", "u00178": "トールス", "u00179": "「これ以上は戦闘不能！　撤退します！」", "u00180": "ヒューゴ", "u00181": "「うわあああああっ！！」", "u00182": "フェイル", "u00183": "「くっ……さすがだな」", "u00184": "ブリット", "u00185": "「こんな所でやられるなんて…@　未熟だ…！」", "u00186": "プレシア", "u00187": "「ダメ、これ以上は無理！　撤退します！」", "u00188": "マイ", "u00189": "「こ、ここで…終わり…！？」", "u00190": "マサキ", "u00191": "「すまねえ！@　抜けさせてもらうぜ…！」", "u00192": "ミオ", "u00193": "「ごめん、後はお願い！」", "u00194": "ミチル", "u00195": "「あ、あかん！　ここまでや！！」", "u00196": "メキボス", "u00197": "「やれやれ、ここまでか」", "u00198": "モニカ", "u00199": "「これ以上は無理ですわね。お暇させて頂きます」"}