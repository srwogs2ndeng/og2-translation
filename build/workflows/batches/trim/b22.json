 },
 "Battle/Dat/Battle/Message/288.bmd.json|0x001349": {
  "jp": "「艦前方に弾幕を展開しろ！」",
  "en": "「Throw up a barrage ahead of the ship!」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/295.bmd.json|0x005EF1": {
  "jp": "「抵抗は無意味です」",
  "en": "「Resistance is meaningless.」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/296.bmd.json|0x00272C": {
  "jp": "「この程度なの？」",
  "en": "「Is that all you've got?」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/298.bmd.json|0x002950": {
  "jp": "「苦界の底で蠢く輩が！」",
  "en": "「You who writhe in the depths of woe!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/298.bmd.json|0x002F25": {
