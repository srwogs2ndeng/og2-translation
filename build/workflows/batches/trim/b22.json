 },
 "Battle/Dat/Battle/Message/270.bmd.json|0x002BE7": {
  "jp": "「玄天大聖、後玄武避万鬼」",
  "en": "「Genten Taisei, Genbu wards off all demons」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/270.bmd.json|0x002C25": {
  "jp": "「上元天都東北方振動！」",
  "en": "「The heavenly capital's northeast quakes!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/270.bmd.json|0x002C4A": {
  "jp": "「天門忽開！」",
  "en": "「Heaven's gate opens!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/274.bmd.json|0x00117B": {
  "jp": "「そこか！」",
  "en": "「There you are!」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/274.bmd.json|0x0011D2": {
  "jp": "「撃破あるのみ！」",
  "en": "「Nothing but destruction!」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/274.bmd.json|0x00132B": {
  "jp": "「ああ、任せろ」",
  "en": "「Yeah, leave it to me.」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/274.bmd.json|0x001394": {
  "jp": "「借りは返す！」",
  "en": "「I'll repay this debt!」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/274.bmd.json|0x001783": {
  "jp": "「まだ浅い！」",
  "en": "「Still too shallow!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/274.bmd.json|0x001ADD": {
  "jp": "「動きがわかり易すぎる」",
  "en": "「Your moves are too easy to read.」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/274.bmd.json|0x001BD3": {
  "jp": "「所詮は素人か」",
  "en": "「An amateur after all.」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/274.bmd.json|0x001C6E": {
  "jp": "「こういう手もある！」",
  "en": "「I've got moves like this too!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/274.bmd.json|0x001EA2": {
  "jp": "「その陣形が命取りだ！」",
  "en": "「That formation is your undoing!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/281.bmd.json|0x00096B": {
  "jp": "「反撃開始だ」",
  "en": "「Counterattack begins!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x00375C": {
  "jp": "「我こそが新たな人類の祖……新人祖なり」",
  "en": "「I am the forefather of a new humanity...the New Progenitor」",
  "max_bytes": 60
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x003905": {
  "jp": "「時空が交差する門を通じ、/　我が数多の世界の規範となる」",
  "en": "「Through the gate where space-time crosses,/ I become the law of countless worlds」",
  "max_bytes": 85
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x00395B": {
  "jp": "「新人祖の誕生を讃えつつ、消散せよ」",
  "en": "「Praise the birth of the New Progenitor, and vanish」",
  "max_bytes": 54
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x0039DF": {
  "jp": "「新人祖の産声を聞き届け、隠滅せよ」",
  "en": "「Hear the New Progenitor's first cry, and be erased」",
  "max_bytes": 54
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x004453": {
  "jp": "「下らぬ手だ」",
  "en": "「A worthless move」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x00456B": {
  "jp": "「己の力を過信し、新人祖たる我に挑むか」",
  "en": "「Overtrusting your power, you challenge the New Progenitor?」",
  "max_bytes": 60
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x0045D3": {
  "jp": "「認めよ……古き世界の死を」",
  "en": "「Accept it...the death of the old world」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x004AA2": {
  "jp": "「手を止め、新人祖の誕生を祝福せよ」",
  "en": "「Stay your hand and bless the New Progenitor's birth」",
  "max_bytes": 54
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x004E71": {
  "jp": "「己の無力さを知れ」",
  "en": "「Know your own powerlessness」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x004F8A": {
  "jp": "「お前に逃げ場はない」",
  "en": "「There is nowhere left to run」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x004FFC": {
  "jp": "「我が掌中で踊れ」",
  "en": "「Dance in the palm of my hand」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x005364": {
  "jp": "「これは黒き天使」",
  "en": "「This is the black angel」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x005380": {
  "jp": "「これは黒き銃神」",
  "en": "「This is the black gun-god」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/284.bmd.json|0x00539C": {
  "jp": "「これは古き人祖達」",
  "en": "「These are the old progenitors」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/285.bmd.json|0x00183B": {
  "jp": "「参る！」",
  "en": "「Here I come!」",
  "max_bytes": 15
 },
 "Battle/Dat/Battle/Message/285.bmd.json|0x0024B5": {
  "jp": "「逃がさん！」",
  "en": "「You won't get away!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/285.bmd.json|0x002A2C": {
  "jp": "「意外にやるな」",
  "en": "「Unexpectedly capable」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/285.bmd.json|0x002E60": {
  "jp": "「効かんな」",
  "en": "「It won't work」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/285.bmd.json|0x002E73": {
  "jp": "「そんなものかね」",
  "en": "「Is that all you've got」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/285.bmd.json|0x00329A": {
  "jp": "「当たらん！」",
  "en": "「You won't hit me!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/285.bmd.json|0x003532": {
  "jp": "「見切った！」",
  "en": "「I see through it!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/286.bmd.json|0x0074B7": {
  "jp": "「撃ち抜く！」",
  "en": "「I'll shoot you through!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/286.bmd.json|0x00815D": {
  "jp": "「黄！」",
  "en": "「Yellow!」",
  "max_bytes": 12
 },
 "Battle/Dat/Battle/Message/288.bmd.json|0x000BBA": {
  "jp": "「攻撃開始！」",
  "en": "「Begin the attack!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/288.bmd.json|0x00107F": {
