{
 "Battle/Dat/Battle/Message/092.bmd.json|0x00180E": {
  "jp": "「各員、冷静に対処せよ」",
  "en": "「All hands, stay calm and respond.」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/092.bmd.json|0x00184F": {
  "jp": "「各砲座、敵の接近を許すな」",
  "en": "「All guns, don't let the enemy close in.」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/092.bmd.json|0x001B0D": {
  "jp": "「ふん、死角に入ったか」",
  "en": "「Hmph, in the blind spot, are you?」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/092.bmd.json|0x001BB4": {
  "jp": "「本艦で受け止める！」",
  "en": "「We'll take it with this ship!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/092.bmd.json|0x001E4D": {
  "jp": "「突入コース確認！」",
  "en": "「Assault course confirmed!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/093.bmd.json|0x001D73": {
  "jp": "「行くぞ、鋼龍戦隊！」",
  "en": "「Here we go, Steel Dragon Battle Group!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/093.bmd.json|0x001DCF": {
  "jp": "「連邦の力の象徴……鋼龍戦隊を討つ！」",
  "en": "「Symbol of Federation power...I'll cut down the Steel Dragon Battle Group!」",
  "max_bytes": 57
 },
 "Battle/Dat/Battle/Message/093.bmd.json|0x002017": {
  "jp": "「奴さえ仕留めれば、鋼龍戦隊は！」",
  "en": "「Take him down, and the Hagane Squad's finished!」",
  "max_bytes": 51
 },
 "Battle/Dat/Battle/Message/093.bmd.json|0x0021A9": {
  "jp": "「逃がすかよ！」",
  "en": "「You're not getting away!」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/093.bmd.json|0x003173": {
  "jp": "「出直して来い！」",
  "en": "「Come back when you're ready!」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/093.bmd.json|0x00318F": {
  "jp": "「フッ、笑わせる」",
  "en": "「Hah, don't make me laugh.」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/093.bmd.json|0x003308": {
  "jp": "「フッ、油断したな！」",
  "en": "「Hah, you let your guard down!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/094.bmd.json|0x0030A3": {
  "jp": "「鋼龍戦隊の特機か。望む所だ」",
  "en": "「The Squadron's special unit? Bring it on.」",
  "max_bytes": 45
 },
 "Battle/Dat/Battle/Message/094.bmd.json|0x00362C": {
  "jp": "「逃がさん」",
  "en": "「You won't escape.」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/094.bmd.json|0x00497D": {
  "jp": "「次に期待するしかないか」",
  "en": "「I'll just have to hope for next time.」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/094.bmd.json|0x004B3B": {
  "jp": "「所詮は欠陥機ということか」",
  "en": "「So it's just a flawed machine after all.」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/094.bmd.json|0x005236": {
  "jp": "「効かんよ」",
  "en": "「It won't work.」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/094.bmd.json|0x005278": {
  "jp": "「手が出せんとはな」",
  "en": "「So you can't lay a hand on me.」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/095.bmd.json|0x001D42": {
  "jp": "「これも任務だ」",
  "en": "「This too is my mission.」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/095.bmd.json|0x002310": {
  "jp": "「力と力の勝負、望む所だ！」",
  "en": "「Strength against strength, just as I like it!」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/095.bmd.json|0x002561": {
  "jp": "「逃がさん！」",
  "en": "「You won't escape!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/095.bmd.json|0x002577": {
  "jp": "「離脱などさせん！」",
  "en": "「I won't let you break away!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/095.bmd.json|0x003208": {
  "jp": "「その大刀は飾りか？」",
  "en": "「Is that great blade just for show?」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/095.bmd.json|0x003267": {
  "jp": "「ふん、見かけ倒しだな」",
  "en": "「Hmph, all show and no substance.」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/095.bmd.json|0x0036EE": {
  "jp": "「好きにはやらせん！」",
  "en": "「I won't let you have your way!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/095.bmd.json|0x0037BA": {
  "jp": "「死に急ぐか！」",
  "en": "「Rushing to your death!?」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/095.bmd.json|0x003885": {
  "jp": "「当てる！」",
  "en": "「I'll hit you!」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/095.bmd.json|0x003898": {
  "jp": "「直撃を！」",
  "en": "「A direct hit!」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/095.bmd.json|0x0038AB": {
  "jp": "「仕留める！」",
  "en": "「I'll finish you!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/095.bmd.json|0x003914": {
  "jp": "「撃ち抜く！」",
  "en": "「I'll blast through you!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/096.bmd.json|0x002EF5": {
  "jp": "「色は派手なんだけどねぇ」",
  "en": "「The colors sure are flashy, though」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/096.bmd.json|0x002FBC": {
  "jp": "「ひょ～いっとな」",
  "en": "「And a little hop like so」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/096.bmd.json|0x003364": {
  "jp": "「点数稼いどくか」",
  "en": "「Guess I'll rack up some points」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/096.bmd.json|0x00346C": {
  "jp": "「ま、上官を守るのも仕事の内」",
  "en": "「Well, guarding the boss is part of the job」",
  "max_bytes": 45
 },
 "Battle/Dat/Battle/Message/097.bmd.json|0x0028C2": {
  "jp": "「鋼龍戦隊は、特機の見本市ね」",
  "en": "「The Steel Dragons are a super-robot showcase」",
  "max_bytes": 45
 },
 "Battle/Dat/Battle/Message/097.bmd.json|0x00298A": {
  "jp": "「どこへ行く気かしら？」",
  "en": "「Where do you think you're going?」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/097.bmd.json|0x0032A9": {
  "jp": "「計算通り」",
  "en": "「Just as calculated.」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/097.bmd.json|0x0033FC": {
  "jp": "「迂闊だったわね」",
  "en": "「That was careless of me.」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/097.bmd.json|0x003569": {
  "jp": "「ロフ、後は任せて」",
  "en": "「Rof, leave the rest to me.」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/098.bmd.json|0x0023C1": {
  "jp": "「まあ、ここまではな」",
  "en": "「Well, this is as far as it goes.」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/098.bmd.json|0x0026FD": {
  "jp": "「甘く見るなよ！」",
  "en": "「Don't underestimate me!」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/098.bmd.json|0x002A91": {
  "jp": "「他愛のねえ奴だぜ」",
  "en": "「What a harmless little fool.」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/100.bmd.json|0x002BB7": {
  "jp": "「私自らが手を下す」",
  "en": "「I will deal with this myself.」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/100.bmd.json|0x002DD5": {
  "jp": "「枷なき力は、危険なのだ」",
  "en": "「Power without restraint is dangerous.」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/100.bmd.json|0x00348D": {
  "jp": "「逃がさん！」",
  "en": "「You won't escape!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/100.bmd.json|0x0034BF": {
  "jp": "「思い上がるな、下等生物共め」",
  "en": "「Don't flatter yourselves, lowly creatures.」",
  "max_bytes": 45
 },
 "Battle/Dat/Battle/Message/100.bmd.json|0x0042CD": {
  "jp": "「そこか！」",
  "en": "「There you are!」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x006814": {
  "jp": "「来たな！　照準！」",
  "en": "「Here it comes! Taking aim!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x006972": {
  "jp": "「このまま行くぞ！」",
  "en": "「We're pushing straight through!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x006D0F": {
  "jp": "「行くぞ、妖機人！」",
  "en": "「Here I come, Fairy Machine!」",
  "max_bytes": 30
 }
}