{
 "Battle/Dat/Battle/Message/002.bmd.json|0x005211": {
  "jp": "「マサキ、正面ニャ！」",
  "en": "「Masaki, straight ahead, nya!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/002.bmd.json|0x0071A2": {
  "jp": "「好きにさせるかっ！」",
  "en": "「I won't let you do as you please!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/002.bmd.json|0x00AFB6": {
  "jp": "「リム、後は任せな！」",
  "en": "「Cliana, leave the rest to me!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/002.bmd.json|0x00BAE8": {
  "jp": "「猫使いが荒いニャ～！」",
  "en": "「He works us cats too hard, nya!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/002.bmd.json|0x00BB8C": {
  "jp": "「任せるニャ！」",
  "en": "「Leave it to us, nya!」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/003.bmd.json|0x004040": {
  "jp": "「ロフ！　この勝負、受けてもらうよ！」",
  "en": "「Lof! You're taking me on, whether you like it or not!」",
  "max_bytes": 57
 },
 "Battle/Dat/Battle/Message/003.bmd.json|0x004AFC": {
  "jp": "「妖機人……近寄られる前に倒す！」",
  "en": "「Youkijin...I'll take them down before they close in!」",
  "max_bytes": 51
 },
 "Battle/Dat/Battle/Message/003.bmd.json|0x004B92": {
  "jp": "「やられたら、やり返すっ！！」",
  "en": "「Hit me and I'll hit back twice as hard!!」",
  "max_bytes": 45
 },
 "Battle/Dat/Battle/Message/003.bmd.json|0x006040": {
  "jp": "「見切ったよ！」",
  "en": "「I've got your moves down!」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/003.bmd.json|0x006059": {
  "jp": "「出直してきなっ！」",
  "en": "「Come back when you're better!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/003.bmd.json|0x00699F": {
  "jp": "「チャンス！」",
  "en": "「Now's my chance!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/004.bmd.json|0x003D64": {
  "jp": "「強敵です。ご油断なきよう」",
  "en": "「A strong foe. Do not let your guard down.」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/004.bmd.json|0x004049": {
  "jp": "「まず、その繰り糸を断つ！」",
  "en": "「First, I'll sever those puppet strings!」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/004.bmd.json|0x0042D0": {
  "jp": "「人心を惑わす偽神を討つ！」",
  "en": "「I'll strike down the false god who deludes men!」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/004.bmd.json|0x004575": {
  "jp": "「好きにはさせんぞ！」",
  "en": "「I won't let you have your way!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/004.bmd.json|0x005427": {
  "jp": "「効かんな」",
  "en": "「It won't work」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/004.bmd.json|0x00581C": {
  "jp": "「効かんぞ、光龍！」",
  "en": "「It won't work, Yang Long!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/004.bmd.json|0x00593E": {
  "jp": "「当たらんよ！」",
  "en": "「You won't land a hit!」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/004.bmd.json|0x0059AA": {
  "jp": "「見切った！」",
  "en": "「I saw through it!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/004.bmd.json|0x0059DF": {
  "jp": "「間合いが甘いっ！」",
  "en": "「Your reach is too shallow!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/004.bmd.json|0x0059FE": {
  "jp": "「無駄だ！」",
  "en": "「It's useless!」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/004.bmd.json|0x005E6A": {
  "jp": "「動きが単調だな！」",
  "en": "「Your moves are so simple!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/004.bmd.json|0x006909": {
  "jp": "「臨兵闘者皆陣列前……行！！」",
  "en": "「Rin pyo to sha kai jin retsu zai zen...go!!」",
  "max_bytes": 45
 },
 "Battle/Dat/Battle/Message/004.bmd.json|0x00694A": {
  "jp": "「刮目して見よ！」",
  "en": "「Open your eyes and watch!」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/005.bmd.json|0x003D3F": {
  "jp": "「炎には水……このガッデスなら！」",
  "en": "「Water quenches fire...this Gaddess will do it!」",
  "max_bytes": 51
 },
 "Battle/Dat/Battle/Message/005.bmd.json|0x003D73": {
  "jp": "「その炎……水で掻き消す！」",
  "en": "「Those flames...I'll wash them out with water!」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/005.bmd.json|0x0056C7": {
  "jp": "「うっ……少し油断したわ」",
  "en": "「Ugh...I let my guard down a little」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/005.bmd.json|0x0057DC": {
  "jp": "「そんなもの！」",
  "en": "「Something like that!」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/005.bmd.json|0x006BFD": {
  "jp": "「ミオ、油断しないで！」",
  "en": "「Mio, don't let your guard down!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/005.bmd.json|0x006F72": {
  "jp": "「存分に振るいましょう！」",
  "en": "「Let's swing away to our heart's content!」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/006.bmd.json|0x00653B": {
  "jp": "「何よ、こんなの！」",
  "en": "「What's this? It's nothing!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/006.bmd.json|0x006868": {
  "jp": "「大して効かないんだってば」",
  "en": "「That barely does anything, I told you.」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/006.bmd.json|0x006ABC": {
  "jp": "「なんの！」",
  "en": "「Not a chance!」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/006.bmd.json|0x006CF5": {
  "jp": "「攻撃に迷いが出てるよ」",
  "en": "「Your attacks are full of hesitation.」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/006.bmd.json|0x007309": {
  "jp": "「倍率ドン！　更に倍っ！」",
  "en": "「Double the odds! And double again!」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/006.bmd.json|0x00782F": {
  "jp": "「超振動拳！！」",
  "en": "「Super Vibration Fist!!」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/007.bmd.json|0x00322C": {
  "jp": "「やってみる！」",
  "en": "「I'll give it a shot!」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/007.bmd.json|0x005CDE": {
  "jp": "「回避成功！」",
  "en": "「Evasion success!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/007.bmd.json|0x006797": {
  "jp": "「まだまだいっくよー！」",
  "en": "「There's more where that came from!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/008.bmd.json|0x001D48": {
  "jp": "「勝てると思うな」",
  "en": "「Don't think you can win.」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/008.bmd.json|0x001D86": {
  "jp": "「一気に終わらせるぞ」",
  "en": "「I'll end this in one stroke.」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/008.bmd.json|0x002283": {
  "jp": "「ただでは帰さん！」",
  "en": "「I won't let you leave unscathed!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/008.bmd.json|0x0022BB": {
  "jp": "「好きにはさせん！」",
  "en": "「I won't let you do as you please!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/008.bmd.json|0x00296C": {
  "jp": "「効くかっ！」",
  "en": "「Think that works!?」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/008.bmd.json|0x0029E6": {
  "jp": "「その程度か！」",
  "en": "「That's all you've got!」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/008.bmd.json|0x002C2D": {
  "jp": "「見切った！」",
  "en": "「I saw through it!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/008.bmd.json|0x002DC8": {
  "jp": "「狙いが甘いな」",
  "en": "「Your aim is sloppy.」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/009.bmd.json|0x00224C": {
  "jp": "「反撃開始だ」",
  "en": "「Time to strike back.」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/010.bmd.json|0x004A42": {
  "jp": "「リオ、早く逃げて！」",
  "en": "「Rio, hurry, get out of there!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/011.bmd.json|0x001313": {
  "jp": "「いざ、尋常に勝負……ですわ」",
  "en": "「Now then, a fair and square duel...it is.」",
  "max_bytes": 45
 }
