{
 "Battle/Dat/Battle/Message/101.bmd.json|0x006D2E": {
  "jp": "「妖機人が来るわ！」",
  "en": "「A Fairy Machine's coming!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x007273": {
  "jp": "「頭を潰す！」",
  "en": "「I'll crush its head!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x007289": {
  "jp": "「お前達が何度地球圏へ現れようと！」",
  "en": "「No matter how often you show up in Earth's sphere!」",
  "max_bytes": 54
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x007890": {
  "jp": "「ああ、先手を取る！」",
  "en": "「Yeah, we'll take the first move!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x0078B2": {
  "jp": "「量産型などに！」",
  "en": "「To a mere mass-production unit!」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x00795E": {
  "jp": "「言われなくても！」",
  "en": "「You don't have to tell me!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x007A45": {
  "jp": "「任せろ！」",
  "en": "「Leave it to me!」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x0096C1": {
  "jp": "「これぐらいで！」",
  "en": "「This much won't do it!」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x00A543": {
  "jp": "「妖機人にやられるか！」",
  "en": "「Beaten by a Machine Beast? Never!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x00ACA9": {
  "jp": "「化け物に食われる趣味はない！」",
  "en": "「I've no taste for being eaten by a monster!」",
  "max_bytes": 48
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x00ACDA": {
  "jp": "「四凶の超機人はその程度か！」",
  "en": "「Is that all a Four Fiend Machine Beast can do!」",
  "max_bytes": 45
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x00AF3B": {
  "jp": "「こういう芸当もできる！」",
  "en": "「I can pull off tricks like this too!」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/101.bmd.json|0x00B2D2": {
  "jp": "「少佐、後は自分が！」",
  "en": "「Major, leave the rest to me!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/102.bmd.json|0x0044F2": {
  "jp": "「任せる！」",
  "en": "「Leave it to me!」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/102.bmd.json|0x006430": {
  "jp": "「大丈夫か！？」",
  "en": "「Are you all right!?」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/102.bmd.json|0x0064A8": {
  "jp": "「ホント、後が怖いわよ？」",
  "en": "「You'll pay for that later, you know?」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/102.bmd.json|0x0069A6": {
  "jp": "「予測通りの攻撃ね！」",
  "en": "「An attack just as I predicted!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/102.bmd.json|0x0070A6": {
  "jp": "「油断するな、次が来るぞ！」",
  "en": "「Don't relax, here comes the next one!」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/102.bmd.json|0x0077F6": {
  "jp": "「少佐、後は私が！」",
  "en": "「Major, leave the rest to me!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/102.bmd.json|0x0079F1": {
  "jp": "「キョウスケ中尉、後は私が！」",
  "en": "「Lieutenant Kyosuke, leave the rest to me!」",
  "max_bytes": 45
 },
 "Battle/Dat/Battle/Message/103.bmd.json|0x0026A4": {
  "jp": "「そこか！」",
  "en": "「There you are!」",
  "max_bytes": 18
 },
 "Battle/Dat/Battle/Message/103.bmd.json|0x0026FB": {
  "jp": "「撃破あるのみ！」",
  "en": "「Nothing but destruction!」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/103.bmd.json|0x0028A7": {
  "jp": "「ああ、任せろ」",
  "en": "「Yeah, leave it to me.」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/103.bmd.json|0x002FE4": {
  "jp": "「借りは返す！」",
  "en": "「I'll repay the debt!」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/103.bmd.json|0x003091": {
  "jp": "「アルベロ、反撃可能です」",
  "en": "「Albero, counterattack is possible.」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/103.bmd.json|0x004599": {
  "jp": "「当たらん！」",
  "en": "「You'll never hit me!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/103.bmd.json|0x004944": {
  "jp": "「所詮は素人か」",
  "en": "「An amateur after all.」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/103.bmd.json|0x004CD8": {
  "jp": "「その陣形が命取りだ！」",
  "en": "「That formation is your undoing!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/103.bmd.json|0x004D60": {
  "jp": "「全機、集中攻撃！」",
  "en": "「All units, concentrate fire!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/103.bmd.json|0x004DC4": {
  "jp": "「仕留める！」",
  "en": "「I'll finish you!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/105.bmd.json|0x001E78": {
  "jp": "「やはり、彼らは最適な学習対象ね」",
  "en": "「As I thought, they're the perfect study subjects.」",
  "max_bytes": 51
 },
 "Battle/Dat/Battle/Message/105.bmd.json|0x002201": {
  "jp": "「逃げ足が速いわね」",
  "en": "「Quick to flee, aren't you?」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/106.bmd.json|0x005B7A": {
  "jp": "「四神の超機人か……！」",
  "en": "「A Choukijin of the Four Gods...!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/106.bmd.json|0x0072CC": {
  "jp": "「そんな攻撃で！」",
  "en": "「With an attack like that!」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/106.bmd.json|0x007C06": {
  "jp": "「お前の邪念は届かない！」",
  "en": "「Your evil thoughts won't reach me!」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/106.bmd.json|0x007D5A": {
  "jp": "「そんなもの！」",
  "en": "「Something like that!」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/106.bmd.json|0x007EE5": {
  "jp": "「援護する！」",
  "en": "「I'll back you up!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/106.bmd.json|0x008114": {
  "jp": "「少尉、後は俺が！」",
  "en": "「Second Lt., I've got the rest!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/106.bmd.json|0x008133": {
  "jp": "「中尉、援護します！」",
  "en": "「Lieutenant, providing support!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/106.bmd.json|0x008180": {
  "jp": "「少佐、後は俺が！」",
  "en": "「Major, I've got the rest!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/106.bmd.json|0x00850C": {
  "jp": "「妹をやらせはしない！」",
  "en": "「I won't let you touch my sister!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/106.bmd.json|0x008DF6": {
  "jp": "「逃がさん！」",
  "en": "「You won't escape!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/107.bmd.json|0x00525A": {
  "jp": "「大丈夫、任せて！」",
  "en": "「It's fine, leave it to me!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/107.bmd.json|0x0052CC": {
  "jp": "（うぅ～、来た、来たよ！）",
  "en": "（Uu~, here it comes, here it comes!）",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/107.bmd.json|0x005387": {
  "jp": "（前、前から来る！）",
  "en": "（Ahead, coming from ahead!）",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/107.bmd.json|0x006236": {
  "jp": "「もう捕捉したわ！」",
  "en": "「Already got them locked on!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/107.bmd.json|0x006C0E": {
  "jp": "「超機人相手でも、怯まない！」",
  "en": "「Even against a Chokijin, I won't flinch!」",
  "max_bytes": 45
 },
 "Battle/Dat/Battle/Message/107.bmd.json|0x006FE7": {
  "jp": "「どこへ行くつもり！？」",
  "en": "「Where do you think you're going!?」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/107.bmd.json|0x007800": {
  "jp": "「これが四凶の力……！」",
  "en": "「So this is the power of the Four Fiends...!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/107.bmd.json|0x00793E": {
  "jp": "「ＡＤＣで何とか凌ぐ……！」",
  "en": "「I'll pull through somehow with the ADC...!」",
  "max_bytes": 42
 }
