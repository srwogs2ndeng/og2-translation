 "Battle/Dat/Battle/Message/269.bmd.json|0x002F85": {
  "jp": "「全ては、大千世界のためなのさ」",
  "en": "「It is all for the sake of the great cosmos.」",
  "max_bytes": 48
 },
 "Battle/Dat/Battle/Message/269.bmd.json|0x00370D": {
  "jp": "「返礼しよう」",
  "en": "「Allow me to repay you.」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/269.bmd.json|0x003C97": {
  "jp": "「人界に染まり過ぎたな、青龍」",
  "en": "「Too steeped in the mortal world, Seiryuu.」",
  "max_bytes": 45
 },
 "Battle/Dat/Battle/Message/269.bmd.json|0x003CC5": {
  "jp": "「神に逆らう超機人は、百邪も同然……」",
  "en": "「A Chokijin that defies the gods is no better than a demon...」",
  "max_bytes": 57
 },
 "Battle/Dat/Battle/Message/269.bmd.json|0x00467D": {
  "jp": "「君の念は届かない」",
  "en": "「Your will can't reach me.」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/269.bmd.json|0x004794": {
  "jp": "「遊びが過ぎたか」",
  "en": "「I played around too much.」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/269.bmd.json|0x00488E": {
  "jp": "「邪魔するよ」",
  "en": "「Allow me to intrude.」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/269.bmd.json|0x004AE4": {
  "jp": "「朱羽箭！　貫け！」",
  "en": "「Shuu Sen! Pierce through!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/269.bmd.json|0x004C4D": {
  "jp": "「縮地呑天！」",
  "en": "「Shukuchi Donten!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/269.bmd.json|0x004CA7": {
  "jp": "「焔天大聖前朱雀避口舌」",
  "en": "「Enten Taisei Zen Suzaku Hizekkou」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/269.bmd.json|0x004D13": {
  "jp": "「黒蛇よ、空を裂き、地を疾れ！」",
  "en": "「Black serpent, split the sky, race the earth!」",
  "max_bytes": 48
 },
 "Battle/Dat/Battle/Message/269.bmd.json|0x004D44": {
  "jp": "「雀武王が最終奥義！」",
  "en": "「Jakubuou's ultimate technique!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/270.bmd.json|0x001AAD": {
  "jp": "「いかなる意志も事象も、太極の内」",
  "en": "「All will and all things lie within the Taikyoku.」",
  "max_bytes": 51
 },
 "Battle/Dat/Battle/Message/270.bmd.json|0x001B37": {
  "jp": "「仙道に沿わぬか。それも善哉」",
  "en": "「Not on the sage's path? That too is good.」",
  "max_bytes": 45
 },
 "Battle/Dat/Battle/Message/270.bmd.json|0x001D09": {
  "jp": "「偽魂が人道を往く……それも善哉」",
  "en": "「A false soul walks man's path...that too is good」",
  "max_bytes": 51
 },
 "Battle/Dat/Battle/Message/270.bmd.json|0x001D3D": {
  "jp": "「偽魂も道を究めれば、真魂となろう」",
  "en": "「A false soul mastering the path becomes a true one」",
  "max_bytes": 54
 },
 "Battle/Dat/Battle/Message/270.bmd.json|0x001E16": {
  "jp": "「魚心あれば水心」",
  "en": "「Give and you shall receive」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/270.bmd.json|0x001E57": {
  "jp": "「返すぞ、武雀王」",
  "en": "「Send it back, Bujakuou!」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/270.bmd.json|0x00227F": {
  "jp": "「事に従うも肝要じゃ」",
  "en": "「Yielding to circumstance matters too」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/270.bmd.json|0x002651": {
  "jp": "「仙道に従うも良し、従わぬも良し」",
  "en": "「Follow the immortal path or not, either is good」",
  "max_bytes": 51
 },
 "Battle/Dat/Battle/Message/270.bmd.json|0x002799": {
  "jp": "「精進が足りぬな」",
  "en": "「Your training is lacking」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/270.bmd.json|0x0027F0": {
  "jp": "「神獣の盾じゃ」",
