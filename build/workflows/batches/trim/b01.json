{
 "Battle/Dat/Battle/Message/011.bmd.json|0x0021B0": {
  "jp": "「ふう……紙一重でしたわ」",
  "en": "「Phew...that was by a hair's breadth.」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/013.bmd.json|0x003A23": {
