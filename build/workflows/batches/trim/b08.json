  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/063.bmd.json|0x00EC4E": {
  "jp": "「後は任せて！！」",
  "en": "「Leave the rest to me!!」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/063.bmd.json|0x00FA28": {
  "jp": "「リム、早く逃げて！」",
  "en": "「Rim, get out of there, quick!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/063.bmd.json|0x010237": {
  "jp": "「接近戦に持ち込む！」",
  "en": "「I'll bring it to close range!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/063.bmd.json|0x01033C": {
  "jp": "「相対速度、距離算出！」",
  "en": "「Rel. velocity, range calculated!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/063.bmd.json|0x0106E5": {
  "jp": "「全て叩き込む！」",
  "en": "「I'll pour everything in!」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/065.bmd.json|0x00682D": {
  "jp": "「それで地球の守護者だと？　笑わせるな！」",
  "en": "「And you call yourselves Earth's guardians? Don't make me laugh!」",
  "max_bytes": 63
 },
 "Battle/Dat/Battle/Message/065.bmd.json|0x00749F": {
  "jp": "「風穴を空けてやる……」",
  "en": "「I'll blow a hole through you...」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/065.bmd.json|0x0076A9": {
  "jp": "「撃ち抜く！」",
  "en": "「Punch right through!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/065.bmd.json|0x00832D": {
  "jp": "「黄！」",
  "en": "「Yellow!」",
  "max_bytes": 12
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x005590": {
  "jp": "「専心一閃、恐念を断つ！」",
  "en": "「One focused flash, cutting away fear!」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x00596F": {
  "jp": "「仙界ではなく、冥界への案内仕る！」",
  "en": "「Not to the immortal realm-I'll guide you to hell!」",
  "max_bytes": 54
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x0059A6": {
  "jp": "「夏喃、仙道への導きなど無用！」",
  "en": "「Kanan, I need no guiding to the sage's path!」",
  "max_bytes": 48
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x0059D7": {
  "jp": "「押し通るぞ、泰北！」",
  "en": "「I'll break through, Taihoku!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x005B12": {
  "jp": "「汚名は我が剣で振り払う！」",
  "en": "「My blade shall wash away this disgrace!」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x005C38": {
  "jp": "「悪逆無道の剣、許すまじ！」",
  "en": "「A blade of pure evil - I won't allow it!」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x005CBC": {
  "jp": "「怒濤の剣にて迅雷を制す！」",
  "en": "「My raging blade subdues the thunderbolt!」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x005D24": {
  "jp": "「魂宿らぬ機忍など！」",
  "en": "「A soulless machine ninja is nothing!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x005EDE": {
  "jp": "「その銃斧ごと打ち砕く！」",
  "en": "「I'll shatter that gun-axe and all!」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x005FCD": {
  "jp": "「魔装機に後れは取らん！」",
  "en": "「I won't fall behind a Masou Kishin!」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x00633D": {
  "jp": "「妖怪変化は散滅すべし！」",
  "en": "「Monsters and ghouls must be scattered!」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x006447": {
  "jp": "「斬艦刀と黒蛇刀の勝負、いざ！」",
  "en": "「Zankantou versus black serpent blade, come!」",
  "max_bytes": 48
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x0064A0": {
  "jp": "「己を取り戻せ、虎王機よ！」",
  "en": "「Reclaim yourself, King Tiger machine!」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x006533": {
  "jp": "「我が剣にて、四凶を討つ！」",
  "en": "「My blade shall smite the Four Fiends!」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x00655E": {
  "jp": "「寇を斬り、凶を滅す！」",
  "en": "「Cut down the foe, destroy the evil!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x0065D0": {
  "jp": "「邪王よ、いざ勝負！」",
  "en": "「Evil King, let's settle this!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x007145": {
  "jp": "「こ、これが四霊の実力か！」",
  "en": "「S-so this is the Four Spirits' power!」",
  "max_bytes": 42
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x007C03": {
  "jp": "「あの得物、油断ならんな」",
  "en": "「That weapon, not to be taken lightly」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x007CC4": {
  "jp": "「地上の兵器と遜色ないようだな」",
  "en": "「No different from surface weapons, it seems」",
  "max_bytes": 48
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x007ECC": {
  "jp": "「見切った！」",
  "en": "「I see through it!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x007F51": {
  "jp": "「話にならん！」",
  "en": "「Out of the question!」",
  "max_bytes": 24
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x00805D": {
  "jp": "「ゲストなどに！」",
  "en": "「To the likes of the Guest!」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x008151": {
  "jp": "「力なき者は去れ！」",
  "en": "「The powerless must leave!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x008170": {
  "jp": "「修行が足りん！！」",
  "en": "「Your training's lacking!!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x00818F": {
  "jp": "「出直してこい！！」",
  "en": "「Come back when you're ready!!」",
  "max_bytes": 30
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x0081C4": {
  "jp": "「妖の舞には惑わされん！」",
  "en": "「Your bewitching dance won't fool me!」",
  "max_bytes": 39
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x008267": {
  "jp": "「迅雷、我に届かず！」",
  "en": "「Your lightning won't reach me!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x008289": {
  "jp": "「それでもダブルＧか！」",
  "en": "「And you call this the Double G?!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x0082AE": {
  "jp": "「機忍に後れは取らん！」",
  "en": "「I won't fall behind a machine ninja!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x0082FE": {
  "jp": "「それが四神の力か！」",
  "en": "「So that's the power of the Four Gods!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x008DDE": {
  "jp": "「勝機は逃さん！」",
  "en": "「I won't miss my chance!」",
  "max_bytes": 27
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x0092F6": {
  "jp": "「一撃粉砕！」",
  "en": "「Smashed in one blow!」",
  "max_bytes": 21
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x009A0D": {
  "jp": "「断てぬものなし……！」",
  "en": "「there's nothing we can't cut...!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x009CCE": {
  "jp": "「凶星の煌めきを見よ！」",
  "en": "「Behold the gleam of the sinister star!」",
  "max_bytes": 36
 },
 "Battle/Dat/Battle/Message/066.bmd.json|0x009D6E": {
  "jp": "「黄！」",
  "en": "「Yellow!」",
  "max_bytes": 12
 }
