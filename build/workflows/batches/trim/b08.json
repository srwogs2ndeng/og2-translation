 },
 "Battle/Dat/Battle/Message/063.bmd.json|0x00966E": {
  "jp": "「先手は取らせない！」",
  "en": "「I won't let them strike first!」",
  "max_bytes": 33
 },
 "Battle/Dat/Battle/Message/063.bmd.json|0x00D749": {
  "jp": "「見切った！」",
