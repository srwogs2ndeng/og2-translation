{"Logic/Dat/logic/talk/ls000.bin|0x000AC3": "「くっ！　ここまでとはな…！」", "Logic/Dat/logic/talk/ls000.bin|0x000AF1": "カチーナ", "Logic/Dat/logic/talk/ls000.bin|0x000AFE": "「こんな所でしくじるかよ…！@　面白くねえ…」", "Logic/Dat/logic/talk/ls000.bin|0x000B42": "キョウスケ", "Logic/Dat/logic/talk/ls000.bin|0x000B52": "「しくじった…！@　降りるしかないか…」", "Logic/Dat/logic/talk/ls000.bin|0x000B8D": "ギリアム", "Logic/Dat/logic/talk/ls000.bin|0x000B9A": "「くっ！　脱出する！」", "Logic/Dat/logic/talk/ls000.bin|0x000BBC": "ククル", "Logic/Dat/logic/talk/ls000.bin|0x000BC6": "「くうっ！　退くしかないか！！」", "Logic/Dat/logic/talk/ls000.bin|0x000BF7": "クスハ", "Logic/Dat/logic/talk/ls000.bin|0x000C01": "「ご、ごめんなさい…っ！」", "Logic/Dat/logic/talk/ls000.bin|0x000C29": "グラキエース", "Logic/Dat/logic/talk/ls000.bin|0x000C3C": "「ここまでか……！」", "Logic/Dat/logic/talk/ls000.bin|0x000C5B": "クルト", "Logic/Dat/logic/talk/ls000.bin|0x000C65": "「くっ……！　総員退艦せよ！」", "Logic/Dat/logic/talk/ls000.bin|0x000C93": "ゲンナジー", "Logic/Dat/logic/talk/ls000.bin|0x000CA3": "「ここまでか……後は頼む」", "Logic/Dat/logic/talk/ls000.bin|0x000CCB": "コウタ", "Logic/Dat/logic/talk/ls000.bin|0x000CD5": "「ちきしょう…！@　ここまでか！」", "Logic/Dat/logic/talk/ls000.bin|0x000D07": "ゴルド", "Logic/Dat/logic/talk/ls000.bin|0x000D11": "「ぬうっ！　後れを取ったか……」", "Logic/Dat/logic/talk/ls000.bin|0x000D42": "ザッシュ", "Logic/Dat/logic/talk/ls000.bin|0x000D4F": "「ダメだ、やられすぎた……撤退します！」", "Logic/Dat/logic/talk/ls000.bin|0x000D8C": "サフィーネ", "Logic/Dat/logic/talk/ls000.bin|0x000D9C": "「参ったわね。後の事はお願いね」", "Logic/Dat/logic/talk/ls000.bin|0x000DCD": "シャイン", "Logic/Dat/logic/talk/ls000.bin|0x000DDA": "「きゃあっ、あとはお願いいたしますわ！」", "Logic/Dat/logic/talk/ls000.bin|0x000E17": "シュウ", "Logic/Dat/logic/talk/ls000.bin|0x000E21": "「グランゾンが…落とされるとは…」", "Logic/Dat/logic/talk/ls000.bin|0x000E55": "ショウコ", "Logic/Dat/logic/talk/ls000.bin|0x000E62": "「お兄ちゃん…エミィ…ごめん！！」", "Logic/Dat/logic/talk/ls000.bin|0x000E96": "ジョッシュ", "Logic/Dat/logic/talk/ls000.bin|0x000EA6": "「げ、限界か！！」", "Logic/Dat/logic/talk/ls000.bin|0x000EC2": "スレイ", "Logic/Dat/logic/talk/ls000.bin|0x000ECC": "「くっ……私が流星になるとは……脱出する！」", "Logic/Dat/logic/talk/ls000.bin|0x000F0F": "ゼオラ", "Logic/Dat/logic/talk/ls000.bin|0x000F19": "「つ、次は…絶対にっ！！」", "Logic/Dat/logic/talk/ls000.bin|0x000F41": "セティ", "Logic/Dat/logic/talk/ls000.bin|0x000F4B": "「こ、これ以上は無理ね……！」", "Logic/Dat/logic/talk/ls000.bin|0x000F79": "セニア", "Logic/Dat/logic/talk/ls000.bin|0x000F83": "「あいたたた……参った、計算ミスだわ」", "Logic/Dat/logic/talk/ls000.bin|0x000FBD": "ゼブ", "Logic/Dat/logic/talk/ls000.bin|0x000FC4": "「あ～りゃま、やぁられちまったい！」", "Logic/Dat/logic/talk/ls000.bin|0x000FFB": "ゼンガー", "Logic/Dat/logic/talk/ls000.bin|0x001008": "「う…ぬっ！　ここまでか…！」", "Logic/Dat/logic/talk/ls000.bin|0x001036": "タスク", "Logic/Dat/logic/talk/ls000.bin|0x001040": "「くそっ！　情けねえ…！！」", "Logic/Dat/logic/talk/ls000.bin|0x00106B": "テツヤ", "Logic/Dat/logic/talk/ls000.bin|0x001075": "「くっ！　総員、直ちに退艦しろ！！」", "Logic/Dat/logic/talk/ls000.bin|0x0010AC": "テュッティ", "Logic/Dat/logic/talk/ls000.bin|0x0010BC": "「ごめんなさい、後はお願い」", "Logic/Dat/logic/talk/ls000.bin|0x0010E7": "トウマ", "Logic/Dat/logic/talk/ls000.bin|0x0010F1": "「くそっ！　俺の力はここまでか…！」", "Logic/Dat/logic/talk/ls000.bin|0x001128": "トールス", "Logic/Dat/logic/talk/ls000.bin|0x001135": "「これ以上は戦闘不能！　撤退します！」", "Logic/Dat/logic/talk/ls000.bin|0x00116F": "ヒューゴ", "Logic/Dat/logic/talk/ls000.bin|0x00117C": "「うわあああああっ！！」", "Logic/Dat/logic/talk/ls000.bin|0x0011A1": "フェイル", "Logic/Dat/logic/talk/ls000.bin|0x0011AE": "「くっ……さすがだな」", "Logic/Dat/logic/talk/ls000.bin|0x0011D0": "ブリット", "Logic/Dat/logic/talk/ls000.bin|0x0011DD": "「こんな所でやられるなんて…@　未熟だ…！」", "Logic/Dat/logic/talk/ls000.bin|0x00121E": "プレシア", "Logic/Dat/logic/talk/ls000.bin|0x00122B": "「ダメ、これ以上は無理！　撤退します！」", "Logic/Dat/logic/talk/ls000.bin|0x001268": "マイ", "Logic/Dat/logic/talk/ls000.bin|0x00126F": "「こ、ここで…終わり…！？」", "Logic/Dat/logic/talk/ls000.bin|0x00129A": "マサキ", "Logic/Dat/logic/talk/ls000.bin|0x0012A4": "「すまねえ！@　抜けさせてもらうぜ…！」", "Logic/Dat/logic/talk/ls000.bin|0x0012DF": "ミオ", "Logic/Dat/logic/talk/ls000.bin|0x0012E6": "「ごめん、後はお願い！」", "Logic/Dat/logic/talk/ls000.bin|0x00130B": "ミチル", "Logic/Dat/logic/talk/ls000.bin|0x001315": "「あ、あかん！　ここまでや！！」", "Logic/Dat/logic/talk/ls000.bin|0x001346": "メキボス", "Logic/Dat/logic/talk/ls000.bin|0x001353": "「やれやれ、ここまでか」", "Logic/Dat/logic/talk/ls000.bin|0x001378": "モニカ", "Logic/Dat/logic/talk/ls000.bin|0x001382": "「これ以上は無理ですわね。お暇させて頂きます」", "Logic/Dat/logic/talk/ls000.bin|0x0013C8": "ヤンロン", "Logic/Dat/logic/talk/ls000.bin|0x0013D5": "「無念だ……下がらせてもらう」", "Logic/Dat/logic/talk/ls000.bin|0x001403": "ユウキ", "Logic/Dat/logic/talk/ls000.bin|0x00140D": "「迂闊だったか…@　ここは引かせてもらう…！」", "Logic/Dat/logic/talk/ls000.bin|0x001451": "ラーダ", "Logic/Dat/logic/talk/ls000.bin|0x00145B": "「こ、こんな所で……っ！」", "Logic/Dat/logic/talk/ls000.bin|0x001483": "ライ", "Logic/Dat/logic/talk/ls000.bin|0x00148A": "「チッ…！　さすがに保たんか…！」", "Logic/Dat/logic/talk/ls000.bin|0x0014BE": "ラウル", "Logic/Dat/logic/talk/ls000.bin|0x0014C8": "「こんな…こんなはずは…っ！」", "Logic/Dat/logic/talk/ls000.bin|0x0014F6": "ラッセル", "Logic/Dat/logic/talk/ls000.bin|0x001503": "「すみません！　脱出します！」", "Logic/Dat/logic/talk/ls000.bin|0x001531": "ラトゥーニ", "Logic/Dat/logic/talk/ls000.bin|0x001541": "「ここで…終わりね……！」", "Logic/Dat/logic/talk/ls000.bin|0x001569": "ラミア", "Logic/Dat/logic/talk/ls000.bin|0x001573": "「脱出しますです…@　く…！　格好もつかんか…」", "Logic/Dat/logic/talk/ls000.bin|0x0015BA": "リオ", "Logic/Dat/logic/talk/ls000.bin|0x0015C1": "「つ、次は負けないわよっ！！」", "Logic/Dat/logic/talk/ls000.bin|0x0015EF": "リシュウ", "Logic/Dat/logic/talk/ls000.bin|0x0015FC": "「ぬうっ！　しくじったか…！」", "Logic/Dat/logic/talk/ls000.bin|0x00162A": "リム", "Logic/Dat/logic/talk/ls000.bin|0x001631": "「くううっ！　こんな所で！！」", "Logic/Dat/logic/talk/ls000.bin|0x00165F": "リュウセイ", "Logic/Dat/logic/talk/ls000.bin|0x00166F": "「く、くそっ！@　やられちまった！」", "Logic/Dat/logic/talk/ls000.bin|0x0016A4": "リューネ", "Logic/Dat/logic/talk/ls000.bin|0x0016B1": "「ごめん！　ヴァルシオーネ…！」", "Logic/Dat/logic/talk/ls000.bin|0x0016E2": "リョウト", "Logic/Dat/logic/talk/ls000.bin|0x0016EF": "「くっ…！　脱出しなきゃ…！」", "Logic/Dat/logic/talk/ls000.bin|0x00171D": "ルザック州軍兵士Ａ", "Logic/Dat/logic/talk/ls000.bin|0x001739": "「や、やられた！」", "Logic/Dat/logic/talk/ls000.bin|0x001755": "ルザック州軍兵士Ｂ", "Logic/Dat/logic/talk/ls000.bin|0x001771": "「ここまでかっ！！」", "Logic/Dat/logic/talk/ls000.bin|0x001790": "レーツェル", "Logic/Dat/logic/talk/ls000.bin|0x0017A0": "「私も未熟ということか…！」", "Logic/Dat/logic/talk/ls000.bin|0x0017CB": "レオナ", "Logic/Dat/logic/talk/ls000.bin|0x0017D5": "「屈辱…ね……！」", "Logic/Dat/logic/talk/ls000.bin|0x0017F1": "レフィーナ", "Logic/Dat/logic/talk/ls000.bin|0x001801": "「そ、総員！@　退艦を最優先…！！」", "Logic/Dat/logic/talk/ls000.bin|0x001836": "ロドニー", "Logic/Dat/logic/talk/ls000.bin|0x001843": "「あかん、やられてもたがな」", "Logic/Dat/logic/talk/ls000.bin|0x00186E": "ロフ", "Logic/Dat/logic/talk/ls000.bin|0x001875": "「後退するしかないか……！」", "Logic/Dat/logic/talk/ls000.bin|0x0018A0": "「顔をデフォルトに戻す」", "Logic/Dat/logic/talk/ls000.bin|0x001963": "（……左肩部バーニア・スラスター、破損。@　左足首のダンパー・スタビライザーもぎこちない）", "Logic/Dat/logic/talk/ls000.bin|0x0019E9": "（推力は３０％まで低下……。@　ＯＳの最適化まで、あと４０秒……）"}